-- keybind
-- ────────────────────────────────────────────────────────────────────────────

function library:keybind(props)
    props = props or {}
    local cfg = {
        name = props.name or "keybind",
        desc = props.desc,
        icon = props.icon,
        default = props.default or Enum.KeyCode.Unknown,
        flag = props.flag or props.name or "keybind_" .. tostring(math.random(1, 100000)),
        callback = props.callback or function() end,
        binding = false,
        key = Enum.KeyCode.Unknown,
    }

    local el = make_element(self, { name = cfg.name, desc = cfg.desc, icon = cfg.icon }, { right_width = 120 })

    local chip = new("TextButton", {
        Name = "bind", Parent = el.controls, Size = UDim2.new(0, 0, 0, 28), AutomaticSize = Enum.AutomaticSize.X,
        BackgroundColor3 = "@outline", BackgroundTransparency = 0.9, BorderSizePixel = 0, AutoButtonColor = false,
        Text = "none", TextColor3 = "@text", TextSize = 13, Weight = "Medium",
    })
    corner(chip, 8)
    stroke(chip, 0.88)
    pad(chip, 0, 0, 12, 12)
    new("UISizeConstraint", { Parent = chip, MinSize = Vector2.new(56, 28), MaxSize = Vector2.new(120, 28) })

    local conn
    function cfg.set(key)
        key = parse_key(key)
        cfg.key = key
        chip.Text = key_name(key)
        library.flags[cfg.flag] = key_name(key)
        if conn then conn:Disconnect() conn = nil end
        if key ~= Enum.KeyCode.Unknown then
            conn = uis.InputBegan:Connect(function(input, gpe)
                if gpe or cfg.binding then return end
                local pressed = (key.EnumType == Enum.KeyCode and input.KeyCode == key)
                    or (key.EnumType == Enum.UserInputType and input.UserInputType == key)
                if pressed and type(cfg.callback) == "function" then cfg.callback() end
            end)
            table.insert(library.connections, conn)
        end
    end
    function cfg.get() return cfg.key end

    library:connection(chip.MouseButton1Click, function()
        if cfg.binding then return end
        chip.Text = "..."
        cfg.binding = true
        local listener
        listener = uis.InputBegan:Connect(function(input)
            if not cfg.binding then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                cfg.binding = false
                if input.KeyCode == Enum.KeyCode.Escape then cfg.set(Enum.KeyCode.Unknown) else cfg.set(input.KeyCode) end
            elseif input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.MouseButton2
                or input.UserInputType == Enum.UserInputType.MouseButton3 then
                cfg.binding = false
                cfg.set(input.UserInputType)
            else
                return
            end
            listener:Disconnect()
        end)
    end)

    cfg.set(cfg.default)
    library.config_flags[cfg.flag] = cfg.set

    finish(self, cfg, el)
    return cfg
end

