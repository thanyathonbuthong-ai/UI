function library:change_theme(theme_data)
    for k, color in pairs(theme_data) do
        local key = theme_alias[k]
        if key == nil then key = k end
        if key and typeof(color) == "Color3" and library.themes.preset[key] ~= nil then
            library.themes.preset[key] = color
            local bucket = library.theme_elements[key]
            if bucket then
                for _, d in ipairs(bucket) do
                    if d.inst and d.inst.Parent then
                        tween(d.inst, { [d.prop] = color }, 0.5)
                    end
                end
            end
        end
    end
    for _, fn in ipairs(library.on_theme) do
        task.spawn(fn)
    end
end

function library:change_accent(color)
    library:change_theme({ accent = color })
end

function library:change_background(color)
    library:change_theme({ background = color })
end

function library:connection(signal, callback)
    local conn = signal:Connect(callback)
    table.insert(library.connections, conn)
    return conn
end

function library:unload()
    for _, conn in next, library.connections do
        if conn.Connected then conn:Disconnect() end
    end
    library.connections = {}
    if library.gui then library.gui:Destroy() end
    library.gui = nil
    getgenv().library = nil
end

