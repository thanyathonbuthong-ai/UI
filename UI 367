function library:toggle(props)
    props = props or {}
    local cfg = {
        name = props.name or "toggle",
        desc = props.desc,
        icon = props.icon,
        default = props.default or false,
        flag = props.flag or props.name or "toggle_" .. tostring(math.random(1, 100000)),
        callback = props.callback or function() end,
        keybind_enabled = props.keybind or (props.options and props.options.keybind) or false,
        default_key = props.default_key or Enum.KeyCode.Unknown,
        default_mode = props.default_mode or "toggle",
        value = false,
    }

    local has_bind = cfg.keybind_enabled
    local el = make_element(self, { name = cfg.name, desc = cfg.desc, icon = cfg.icon }, { right_width = has_bind and 92 or 58 })

    local gear
    if has_bind then
        gear = new("ImageButton", {
            Name = "settings_btn", Parent = el.controls, LayoutOrder = 1, Size = UDim2.fromOffset(20, 20),
            BackgroundTransparency = 1, Image = library:get_icon("settings"), ImageColor3 = "@icon",
        })
    end

    local switch = new("Frame", {
        Name = "switch", Parent = el.controls, LayoutOrder = 2, Size = UDim2.fromOffset(44, 24),
        BackgroundColor3 = library.themes.preset.outline, BackgroundTransparency = 0.86, BorderSizePixel = 0,
    })
    corner(switch, 999)
    local knob = new("Frame", {
        Name = "knob", Parent = switch, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0),
        Size = UDim2.fromOffset(18, 18), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0,
    })
    corner(knob, 999)
    local check = new("ImageLabel", {
        Name = "check", Parent = knob, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.fromOffset(12, 12), BackgroundTransparency = 1, Image = library:get_icon("check"),
        ImageColor3 = Color3.fromRGB(16, 16, 16), ImageTransparency = 1,
    })

    local function apply(animated)
        local P = library.themes.preset
        local t = animated and 0.25 or 0
        local on = cfg.value
        tween(switch, { BackgroundColor3 = on and P.accent or P.outline, BackgroundTransparency = on and 0 or 0.86 }, t)
        tween(knob, { Position = on and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) }, t)
        tween(check, { ImageTransparency = on and 0 or 1 }, t)
    end
    table.insert(library.on_theme, function() apply(true) end)

    function cfg.set(val)
        cfg.value = val and true or false
        library.flags[cfg.flag] = cfg.value
        apply(true)
        if type(cfg.callback) == "function" then cfg.callback(cfg.value) end
    end
    function cfg.get() return cfg.value end

    if has_bind then
        attach_bind(cfg, gear, {
            modes = true,
            on_trigger = function(state)
                if state == nil then cfg.set(not cfg.value) else cfg.set(state) end
            end,
        })
    end

    library:connection(el.root.MouseButton1Click, function() cfg.set(not cfg.value) end)

    cfg.value = cfg.default and true or false
    library.flags[cfg.flag] = cfg.value
    apply(false)
    if type(cfg.callback) == "function" then cfg.callback(cfg.value) end
    library.config_flags[cfg.flag] = cfg.set

    finish(self, cfg, el)
    return cfg
end

