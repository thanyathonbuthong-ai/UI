function library:notification(props)
    props = props or {}
    local holder = library.notif_holder
    if not holder then return end

    local cfg = {
        title = props.title,
        content = props.content,
        duration = props.duration or 4,
        icon = props.icon,
    }
    if props.text then
        if cfg.title == nil then cfg.title = props.text else cfg.content = cfg.content or props.text end
    end
    if cfg.title == nil and cfg.content == nil then cfg.title = "notification" end

    library.notif_order += 1

    local wrapper = new("Frame", {
        Name = "notif",
        Parent = holder,
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1,
        LayoutOrder = library.notif_order,
    })

    local card = new("Frame", {
        Name = "card",
        Parent = wrapper,
        Position = UDim2.new(0, 360, 0, 0),
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = "@dialog",
        BorderSizePixel = 0,
        ClipsDescendants = true,
    })
    corner(card, 16)
    stroke(card, 0.88)

    local inner = new("Frame", {
        Parent = card,
        Size = UDim2.new(1, 0, 0, 0),
