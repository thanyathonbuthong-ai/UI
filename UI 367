            Parent = inner, Position = UDim2.new(0, 0, 0, 1), Size = UDim2.fromOffset(20, 20),
            BackgroundTransparency = 1, Image = library:get_icon(cfg.icon), ImageColor3 = "@text",
        })
        text_left = 30
    end

    local stack = new("Frame", {
        Parent = inner, Position = UDim2.new(0, text_left, 0, 0),
        Size = UDim2.new(1, -(text_left + 22), 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
    })
    list(stack, 3)

    if cfg.title then
        new("TextLabel", {
            Parent = stack, LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1, Text = cfg.title, TextColor3 = "@text", TextSize = 15, Weight = "SemiBold",
            TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
        })
    end
    if cfg.content then
        new("TextLabel", {
            Parent = stack, LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1, Text = cfg.content, TextColor3 = "@text", TextTransparency = 0.4,
            TextSize = 13, Weight = "Regular", TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
        })
    end

    local close_btn = new("ImageButton", {
        Parent = inner, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 2),
        Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1,
        Image = library:get_icon("x"), ImageColor3 = "@icon",
    })

    local bar = new("Frame", {
        Parent = card, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = "@accent", BorderSizePixel = 0,
    })

    local dismissed = false
    local function dismiss()
        if dismissed then return end
        dismissed = true
        tween(card, { Position = UDim2.new(0, 360, 0, 0) }, 0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        task.delay(0.3, function()
            if wrapper and wrapper.Parent then
                tween(wrapper, { Size = UDim2.new(1, 0, 0, 0) }, 0.25)
            end
        end)
        task.delay(0.6, function()
            if wrapper then wrapper:Destroy() end
        end)
    end
    close_btn.MouseButton1Click:Connect(dismiss)

    task.spawn(function()
        local n = 0
        while card.AbsoluteSize.Y <= 0 and n < 30 do
            run_service.Heartbeat:Wait()
            n += 1
        end
        if dismissed or not wrapper.Parent then return end
        tween(wrapper, { Size = UDim2.new(1, 0, 0, card.AbsoluteSize.Y) }, 0.3)
        tween(card, { Position = UDim2.new(0, 0, 0, 0) }, 0.5)
        tween(bar, { Size = UDim2.new(0, 0, 0, 2) }, cfg.duration, Enum.EasingStyle.Linear)
        task.wait(cfg.duration)
        dismiss()
    end)

    return cfg
end

