    corner(track, 999)
    local fill = new("Frame", {
        Name = "fill", Parent = track, Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = "@accent", BorderSizePixel = 0,
    })
    corner(fill, 999)
    local knob = new("Frame", {
        Name = "knob", Parent = track, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(16, 16), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0, ZIndex = 2,
    })
    corner(knob, 999)
    stroke(knob, 0.7, Color3.fromRGB(0, 0, 0))

    local box = new("TextBox", {
        Name = "value", Parent = el.controls, LayoutOrder = 2, Size = UDim2.fromOffset(46, 28),
        BackgroundColor3 = "@outline", BackgroundTransparency = 0.93, BorderSizePixel = 0, Text = "",
        TextColor3 = "@text", TextSize = 13, Weight = "Medium", ClearTextOnFocus = false,
    })
    corner(box, 8)
    stroke(box, 0.9)

    local function round_val(v)
        if cfg.step and cfg.step > 0 then
            v = math.floor((v - cfg.min) / cfg.step + 0.5) * cfg.step + cfg.min
        else
            local range = cfg.max - cfg.min
            if range <= 1 then
                v = math.floor(v * 100 + 0.5) / 100
            elseif range <= 10 then
                v = math.floor(v * 10 + 0.5) / 10
            else
                v = math.floor(v + 0.5)
            end
        end
        v = tonumber(string.format("%.4f", v))
        return math.clamp(v, cfg.min, cfg.max)
    end

    function cfg.set(val)
        val = round_val(tonumber(val) or cfg.min)
        cfg.value = val
        library.flags[cfg.flag] = val
        box.Text = tostring(val)

        local percent = (cfg.max == cfg.min) and 0 or (val - cfg.min) / (cfg.max - cfg.min)
        tween(fill, { Size = UDim2.new(percent, 0, 1, 0) }, 0.12, Enum.EasingStyle.Quad)
        tween(knob, { Position = UDim2.new(percent, 0, 0.5, 0) }, 0.12, Enum.EasingStyle.Quad)

        if type(cfg.callback) == "function" then cfg.callback(val) end
    end
    function cfg.get() return cfg.value end

    -- only follow the pointer that started on this slider (keeps touch drags from sticking)
    local active_input = nil
    local function from_x(x)
        local width = track.AbsoluteSize.X
        if width <= 0 then return end
        local percent = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
        cfg.set(cfg.min + (cfg.max - cfg.min) * percent)
    end

    library:connection(hit.InputBegan, function(input)
        if is_press(input) then
            active_input = input
            cfg.dragging = true
            tween(knob, { Size = UDim2.fromOffset(19, 19) }, 0.15)
            from_x(input.Position.X)
        end
    end)
    library:connection(uis.InputChanged, function(input)
        if not cfg.dragging then return end
        if active_input and active_input.UserInputType == Enum.UserInputType.Touch then
            if input == active_input then from_x(input.Position.X) end
        elseif input.UserInputType == Enum.UserInputType.MouseMovement then
            from_x(input.Position.X)
        end
    end)
    library:connection(uis.InputEnded, function(input)
        if cfg.dragging and (input == active_input
            or (active_input and active_input.UserInputType == Enum.UserInputType.MouseButton1
                and input.UserInputType == Enum.UserInputType.MouseButton1)) then
            cfg.dragging = false
            active_input = nil
            tween(knob, { Size = UDim2.fromOffset(16, 16) }, 0.15)
        end
    end)
    library:connection(box.FocusLost, function()
        cfg.set(tonumber(box.Text) or cfg.value)
    end)

    cfg.set(cfg.default)
    library.config_flags[cfg.flag] = cfg.set

    finish(self, cfg, el)
    return cfg
end

-- ────────────────────────────────────────────────────────────────────────────
-- dropdown (floating menu, optional search, multi select)
-- ────────────────────────────────────────────────────────────────────────────

function library:dropdown(props)
    props = props or {}
    local function opt_name(o)
        if type(o) == "table" then return o.name end
        return o
    end

    local cfg = {
        name = props.name or "dropdown",
        desc = props.desc,
        icon = props.icon,
        options = props.options or {},
        flag = props.flag or props.name or "dropdown_" .. tostring(math.random(1, 100000)),
        callback = props.callback or function() end,
        open = false,
        multiple = props.multiple or false,
    }
    cfg.default = props.default
    if cfg.default == nil and not cfg.multiple and cfg.options[1] ~= nil then
        cfg.default = opt_name(cfg.options[1])
    end

    local el = make_element(self, { name = cfg.name, desc = cfg.desc, icon = cfg.icon }, { right_width = 156 })

    local box = new("TextButton", {
        Name = "select", Parent = el.controls, Size = UDim2.fromOffset(146, 30), BackgroundColor3 = "@outline",
        BackgroundTransparency = 0.93, BorderSizePixel = 0, AutoButtonColor = false, Text = "",
    })
    corner(box, 9)
    stroke(box, 0.9)
    local val_label = new("TextLabel", {
        Name = "val", Parent = box, Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -34, 1, 0), BackgroundTransparency = 1,
        Text = "...", TextColor3 = "@text", TextSize = 13, Weight = "Medium",
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
    })
    local chevron = new("ImageLabel", {
        Name = "icon", Parent = box, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1, Image = library:get_icon("down"), ImageColor3 = "@icon",
    })

    -- menu
    local MENU_W = 200
    local menu = make_popup(MENU_W, 100)
    pad(menu, 6, 6, 6, 6)

    local search_frame = new("Frame", {
        Name = "search", Parent = menu, Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = "@outline",
        BackgroundTransparency = 0.93, BorderSizePixel = 0, Visible = false,
    })
    corner(search_frame, 8)
    stroke(search_frame, 0.92)
    local search_input = new("TextBox", {
        Parent = search_frame, Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -20, 1, 0), BackgroundTransparency = 1,
        Text = "", PlaceholderText = "search", PlaceholderColor3 = "@placeholder", TextColor3 = "@text",
        TextSize = 13, Weight = "Regular", ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left,
    })

    local scroll = new("ScrollingFrame", {
        Name = "list", Parent = menu, Position = UDim2.new(0, 0, 0, 0), Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = "@text",
        ScrollBarImageTransparency = 0.8, CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
    })
    list(scroll, 2)

    local records = {}

    local function is_selected(name)
        if cfg.multiple then
            return type(cfg.value) == "table" and table.find(cfg.value, name) ~= nil
        end
        return cfg.value == name
    end

    local function layout_menu()
        local visible = 0
        for _, rec in ipairs(records) do
            if rec.btn.Visible then visible += 1 end
        end
        local show_search = props.search == true or (props.search ~= false and #cfg.options > 7)
        search_frame.Visible = show_search
        local sh = show_search and 38 or 0
        scroll.Position = UDim2.new(0, 0, 0, sh)
        scroll.Size = UDim2.new(1, 0, 1, -sh)
        local content = visible * 32 + math.max(0, visible - 1) * 2
        local list_h = math.clamp(math.max(content, 32), 32, 210)
        menu.Size = UDim2.fromOffset(MENU_W, 12 + sh + list_h)
    end

    local function update_text()
        if cfg.multiple then
            val_label.Text = (type(cfg.value) == "table" and #cfg.value > 0) and table.concat(cfg.value, ", ") or "..."
        else
            val_label.Text = (cfg.value ~= nil) and tostring(cfg.value) or "..."
        end
    end

    function cfg:update_visuals()
        for _, rec in ipairs(records) do
            local sel = is_selected(rec.name)
            tween(rec.btn, { BackgroundTransparency = sel and 0.91 or 1 }, 0.2)
            tween(rec.check, { ImageTransparency = sel and 0 or 1 }, 0.2)
        end
    end

    function cfg.set(val)
        if cfg.multiple then
            if type(val) == "table" then
                cfg.value = val
            elseif type(val) == "string" and val ~= "" then
                cfg.value = { val }
            else
                cfg.value = {}
            end
        else
            if type(val) == "table" then val = val[1] end
            cfg.value = val
        end
        library.flags[cfg.flag] = cfg.value
        update_text()
        cfg:update_visuals()
        if type(cfg.callback) == "function" then cfg.callback(cfg.value) end
    end
    function cfg.get() return cfg.value end

    function cfg:refresh(opts)
        cfg.options = opts or {}
        for _, rec in ipairs(records) do rec.btn:Destroy() end
        records = {}

        for i, opt in ipairs(cfg.options) do
            local name = opt_name(opt)
            local icon = type(opt) == "table" and opt.icon or nil

            local btn = new("TextButton", {
                Name = tostring(name), Parent = scroll, LayoutOrder = i, Size = UDim2.new(1, 0, 0, 32),
                BackgroundColor3 = "@outline", BackgroundTransparency = 1, BorderSizePixel = 0, Text = "", AutoButtonColor = false,
            })
            corner(btn, 8)

            local x = 10
            if icon then
                new("ImageLabel", {
                    Name = "s_icon", Parent = btn, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0),
                    Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1, Image = library:get_icon(icon), ImageColor3 = "@icon",
                })
                x = 34
            end
            new("TextLabel", {
                Name = "val", Parent = btn, Position = UDim2.new(0, x, 0, 0), Size = UDim2.new(1, -(x + 30), 1, 0),
                BackgroundTransparency = 1, Text = tostring(name), TextColor3 = "@text", TextSize = 14, Weight = "Medium",
                TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
            })
            local check = new("ImageLabel", {
                Name = "check", Parent = btn, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0),
                Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1, Image = library:get_icon("check"),
                ImageColor3 = "@text", ImageTransparency = 1,
            })

            btn.MouseEnter:Connect(function()
                if not is_selected(name) then tween(btn, { BackgroundTransparency = 0.95 }, 0.15) end
            end)
            btn.MouseLeave:Connect(function()
                if not is_selected(name) then tween(btn, { BackgroundTransparency = 1 }, 0.15) end
            end)
            btn.MouseButton1Click:Connect(function()
                if cfg.multiple then
                    if type(cfg.value) ~= "table" then cfg.value = {} end
                    local idx = table.find(cfg.value, name)
                    if idx then table.remove(cfg.value, idx) else table.insert(cfg.value, name) end
                    library.flags[cfg.flag] = cfg.value
                    update_text()
                    cfg:update_visuals()
                    if type(cfg.callback) == "function" then cfg.callback(cfg.value) end
                else
                    cfg.set(name)
                    library:close_popups()
                end
            end)

            table.insert(records, { btn = btn, name = name, check = check })
        end

        layout_menu()
        cfg:update_visuals()
    end

    library:connection(search_input:GetPropertyChangedSignal("Text"), function()
        local q = string.lower(search_input.Text)
        for _, rec in ipairs(records) do
            rec.btn.Visible = q == "" or string.find(string.lower(tostring(rec.name)), q, 1, true) ~= nil
        end
        layout_menu()
    end)

    library:connection(box.MouseButton1Click, function()
        if cfg.open then
            library:close_popups()
            return
        end
        search_input.Text = ""
        layout_menu()
        cfg.open = true
        library:open_popup(menu, box, {
            size = Vector2.new(MENU_W, menu.Size.Y.Offset),
            on_close = function()
                cfg.open = false
                tween(chevron, { Rotation = 0 }, 0.25)
            end,
        })
        tween(chevron, { Rotation = 180 }, 0.25)
    end)

    if cfg.multiple then
        if type(cfg.default) == "table" then
            cfg.value = cfg.default
        elseif type(cfg.default) == "string" and cfg.default ~= "" then
            cfg.value = { cfg.default }
        else
            cfg.value = {}
        end
    else
        cfg.value = cfg.default
    end

    cfg:refresh(cfg.options)
    if cfg.multiple then
        cfg.set(cfg.value)
    elseif cfg.default ~= nil then
        cfg.set(cfg.default)
    else
        update_text()
    end

    library.config_flags[cfg.flag] = function(val) cfg.set(val) end

    finish(self, cfg, el)
    return cfg
end

-- ────────────────────────────────────────────────────────────────────────────
-- textbox (input)
-- ────────────────────────────────────────────────────────────────────────────

function library:textbox(props)
    props = props or {}
    local cfg = {
        name = props.name,
        desc = props.desc,
        icon = props.icon,
        placeholder = props.placeholder or "enter text...",
        default = props.default or "",
        flag = props.flag or props.name or "textbox_" .. tostring(math.random(1, 100000)),
        callback = props.callback or function() end,
        clear_on_focus = props.clear_on_focus or false,
        multiline = props.multiline or false,
        numeric = props.numeric or false,
    }

    local el = make_element(self, { name = cfg.name, desc = cfg.desc, icon = cfg.icon }, { right_width = 0, hover = false, stack_padding = 8 })

    local input = new("TextBox", {
        Name = "textbox", Parent = el.stack, LayoutOrder = 3,
        Size = UDim2.new(1, 0, 0, cfg.multiline and 84 or 34), BackgroundColor3 = "@outline", BackgroundTransparency = 0.93,
        BorderSizePixel = 0, Text = "", PlaceholderText = cfg.placeholder, PlaceholderColor3 = "@placeholder",
        TextColor3 = "@text", TextSize = 14, Weight = "Regular", ClearTextOnFocus = cfg.clear_on_focus,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = cfg.multiline and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
        MultiLine = cfg.multiline, TextWrapped = cfg.multiline, ClipsDescendants = true,
    })
    corner(input, 9)
    local input_stroke = stroke(input, 0.9)
    pad(input, cfg.multiline and 8 or 0, cfg.multiline and 8 or 0, 10, 10)

    cfg.instance = input

    library:connection(input.Focused, function() tween(input_stroke, { Transparency = 0.6 }, 0.2) end)
    library:connection(input.FocusLost, function(enter)
        tween(input_stroke, { Transparency = 0.9 }, 0.2)
        if cfg.numeric then
            input.Text = string.gsub(input.Text, "[^%d%.%-]", "")
        end
        library.flags[cfg.flag] = input.Text
        if type(cfg.callback) == "function" then cfg.callback(input.Text, enter) end
    end)

    function cfg.set(val)
        if type(val) == "string" or type(val) == "number" then
            input.Text = tostring(val)
            library.flags[cfg.flag] = input.Text
            if type(cfg.callback) == "function" then cfg.callback(input.Text, false) end
        end
    end
    function cfg.get() return input.Text end

    if cfg.default ~= "" then
        input.Text = cfg.default
        library.flags[cfg.flag] = cfg.default
    end
    library.config_flags[cfg.flag] = cfg.set

    finish(self, cfg, el)
    return cfg
end

-- ────────────────────────────────────────────────────────────────────────────
-- colour picker
-- ────────────────────────────────────────────────────────────────────────────

function library:colorpicker(props)
    props = props or {}
    local cfg = {
        name = props.name or "colorpicker",
        desc = props.desc,
        icon = props.icon,
        default = props.default or Color3.fromRGB(255, 255, 255),
        flag = props.flag or props.name or "colorpicker_" .. tostring(math.random(1, 100000)),
        callback = props.callback or function() end,
    }

    local el = make_element(self, { name = cfg.name, desc = cfg.desc, icon = cfg.icon }, { right_width = 52 })

    local swatch = new("TextButton", {
        Name = "box", Parent = el.controls, Size = UDim2.fromOffset(38, 26), BackgroundColor3 = cfg.default,
        BorderSizePixel = 0, Text = "", AutoButtonColor = false,
    })
    corner(swatch, 8)
    stroke(swatch, 0.75)

    local popup = make_popup(232, 224)
    pad(popup, 10, 10, 10, 10)

    local h, s, v = Color3.toHSV(cfg.default)
    h = (h == 0) and 0.001 or h

    local sv_box = new("TextButton", {
        Name = "sv", Parent = popup, Size = UDim2.new(1, 0, 0, 140), Text = "", BorderSizePixel = 0,
        BackgroundColor3 = Color3.fromHSV(h, 1, 1), AutoButtonColor = false,
    })
    corner(sv_box, 8)

    local white_frame = new("Frame", { Parent = sv_box, Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 })
    corner(white_frame, 8)
    new("UIGradient", {
        Parent = white_frame,
        Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
    })
    local black_frame = new("Frame", { Parent = sv_box, Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 })
    corner(black_frame, 8)
    new("UIGradient", {
        Parent = black_frame,
        Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }),
        Rotation = 90,
    })

    local sv_cursor = new("Frame", {
        Parent = sv_box, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(14, 14),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0,
    })
    corner(sv_cursor, 999)
    stroke(sv_cursor, 0.2, Color3.fromRGB(0, 0, 0))

    local hue_bar = new("TextButton", {
        Name = "hue", Parent = popup, Position = UDim2.new(0, 0, 0, 150), Size = UDim2.new(1, 0, 0, 14),
        Text = "", BorderSizePixel = 0, BackgroundColor3 = Color3.new(1, 1, 1), AutoButtonColor = false,
    })
    corner(hue_bar, 999)
    new("UIGradient", {
        Parent = hue_bar,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
            ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
            ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
            ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
            ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
        }),
    })
    local hue_cursor = new("Frame", {
        Parent = hue_bar, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(8, 20),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0,
    })
    corner(hue_cursor, 999)
    stroke(hue_cursor, 0.3, Color3.fromRGB(0, 0, 0))

    local hex_box = new("TextBox", {
        Name = "hex", Parent = popup, Position = UDim2.new(0, 0, 0, 174), Size = UDim2.new(1, -40, 0, 30),
        BackgroundColor3 = "@outline", BackgroundTransparency = 0.93, BorderSizePixel = 0, Text = "#FFFFFF",
        TextColor3 = "@text", TextSize = 13, Weight = "Medium", ClearTextOnFocus = false,
    })
    corner(hex_box, 8)
    stroke(hex_box, 0.9)
    local preview = new("Frame", {
        Name = "preview", Parent = popup, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 174),
        Size = UDim2.fromOffset(30, 30), BackgroundColor3 = cfg.default, BorderSizePixel = 0,
    })
    corner(preview, 8)
    stroke(preview, 0.75)

    local function update_color()
        local color = Color3.fromHSV(h, s, v)
        swatch.BackgroundColor3 = color
        preview.BackgroundColor3 = color
        sv_box.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        sv_cursor.Position = UDim2.new(s, 0, 1 - v, 0)
        hue_cursor.Position = UDim2.new(h, 0, 0.5, 0)
        local r = math.floor(color.R * 255 + 0.5)
        local g = math.floor(color.G * 255 + 0.5)
        local b = math.floor(color.B * 255 + 0.5)
        hex_box.Text = string.format("#%02X%02X%02X", r, g, b)
        library.flags[cfg.flag] = { R = r, G = g, B = b }
        cfg.value = color
        if type(cfg.callback) == "function" then cfg.callback(color) end
    end

    function cfg.set(color)
        if type(color) == "table" then
            color = Color3.fromRGB(color.R or color[1] or 255, color.G or color[2] or 255, color.B or color[3] or 255)
        end
        if typeof(color) ~= "Color3" then return end
        h, s, v = Color3.toHSV(color)
        h = (h == 0) and 0.001 or h
        update_color()
    end
    function cfg.get() return cfg.value end

    local dragging_sv, dragging_hue = false, false
    local function from_sv(pos)
        s = math.clamp((pos.X - sv_box.AbsolutePosition.X) / sv_box.AbsoluteSize.X, 0, 1)
        v = 1 - math.clamp((pos.Y - sv_box.AbsolutePosition.Y) / sv_box.AbsoluteSize.Y, 0, 1)
        update_color()
    end
    local function from_hue(pos)
        h = math.clamp((pos.X - hue_bar.AbsolutePosition.X) / hue_bar.AbsoluteSize.X, 0.001, 1)
        update_color()
    end

    library:connection(sv_box.InputBegan, function(input)
        if is_press(input) then
            dragging_sv = true
            from_sv(input.Position)
        end
    end)
    library:connection(hue_bar.InputBegan, function(input)
        if is_press(input) then
            dragging_hue = true
            from_hue(input.Position)
        end
    end)
    library:connection(uis.InputEnded, function(input)
        if is_press(input) then
            dragging_sv = false
            dragging_hue = false
        end
    end)
    library:connection(uis.InputChanged, function(input)
        if is_move(input) then
            if dragging_sv then
                from_sv(input.Position)
            elseif dragging_hue then
                from_hue(input.Position)
            end
        end
    end)

    library:connection(hex_box.FocusLost, function()
        local color = hex_to_color(hex_box.Text)
        if color then cfg.set(color) else update_color() end
    end)

    library:connection(swatch.MouseButton1Click, function()
        library:open_popup(popup, swatch, { size = Vector2.new(232, 224) })
    end)

    update_color()
    library.config_flags[cfg.flag] = cfg.set

    finish(self, cfg, el)
    return cfg
end

