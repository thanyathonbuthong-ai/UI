    }

    local root = new("Frame", {
        Name = cfg.name, Parent = self.holder, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
    })
    list(root, 6)

    local header = new("TextButton", {
        Name = "header", Parent = root, LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 30),
        BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
    })
    local text_x = 2
    if cfg.icon then
        new("ImageLabel", {
            Parent = header, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 2, 0.5, 0),
            Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 1,
            Image = library:get_icon(cfg.icon), ImageColor3 = "@text",
        })
        text_x = 28
    end
    new("TextLabel", {
        Name = "title", Parent = header, Position = UDim2.new(0, text_x, 0, 0), Size = UDim2.new(1, -(text_x + 28), 1, 0),
        BackgroundTransparency = 1, Text = cfg.name, TextColor3 = "@text", TextSize = 16, Weight = "SemiBold",
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
    })
    local chevron = new("ImageLabel", {
        Name = "chevron", Parent = header, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -4, 0.5, 0),
        Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1,
        Image = library:get_icon("down"), ImageColor3 = "@icon", Rotation = cfg.expanded and 0 or -90,
    })

    local holder = new("Frame", {
        Name = "elements", Parent = root, LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, Visible = cfg.expanded,
    })
    local holder_layout = list(holder, 6)

    cfg.holder = holder
    cfg.frame = root

    local token = 0
    library:connection(header.MouseButton1Click, function()
        cfg.expanded = not cfg.expanded
        token += 1
        local my = token
        tween(chevron, { Rotation = cfg.expanded and 0 or -90 }, 0.25)
        holder.ClipsDescendants = true
        if cfg.expanded then
            holder.Visible = true
            holder.AutomaticSize = Enum.AutomaticSize.None
            holder.Size = UDim2.new(1, 0, 0, 0)
            local tw = tween(holder, { Size = UDim2.new(1, 0, 0, holder_layout.AbsoluteContentSize.Y) }, 0.3, Enum.EasingStyle.Quart)
            tw.Completed:Connect(function()
                if my == token then
                    holder.AutomaticSize = Enum.AutomaticSize.Y
                    holder.ClipsDescendants = false
                end
            end)
        else
            holder.AutomaticSize = Enum.AutomaticSize.None
            holder.Size = UDim2.new(1, 0, 0, holder.AbsoluteSize.Y)
            local tw = tween(holder, { Size = UDim2.new(1, 0, 0, 0) }, 0.3, Enum.EasingStyle.Quart)
            tw.Completed:Connect(function()
                if my == token then
                    holder.Visible = false
                    holder.ClipsDescendants = false
                end
            end)
        end
    end)

    if tab then table.insert(tab.sections, cfg) end
    return setmetatable(cfg, { __index = self })
end

-- ────────────────────────────────────────────────────────────────────────────
-- element foundation (card with title + description + right side controls)
-- ────────────────────────────────────────────────────────────────────────────

local function register(self, name, frame)
    local tab = rawget(self, "is_tab") and self or rawget(self, "tab_ref")
    if not tab then return end
    table.insert(tab.items, {
        name = name or "",
        frame = frame,
        section = rawget(self, "is_section") and self or nil,
    })
end

local function make_element(self, props, opts)
    opts = opts or {}
    local fill = opts.fill

    local root = new("TextButton", {
        Name = props.name or "element",
        Parent = self.holder,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = fill or "@outline",
        BackgroundTransparency = fill and 0 or 0.93,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = "",
        ClipsDescendants = true,
    })
    corner(root, 12)
    stroke(root, fill and 1 or 0.94)
    pad(root, 12, 12, 14, 14)

    local text_left = 0
    local icon_img
    if props.icon then
        icon_img = new("ImageLabel", {
            Name = "icon", Parent = root, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1,
            Image = library:get_icon(props.icon), ImageColor3 = opts.text_color or "@text",
        })
        text_left = 30
    end

    local stack = new("Frame", {
        Name = "stack", Parent = root, Position = UDim2.new(0, text_left, 0, 0),
        Size = UDim2.new(1, -(text_left + (opts.right_width or 0)), 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
    })
    list(stack, opts.stack_padding or 3)

    local title, desc
    if props.name and props.name ~= "" then
        title = new("TextLabel", {
            Name = "title", Parent = stack, LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1, Text = props.name, TextColor3 = opts.text_color or "@text", TextSize = 15, Weight = "Medium",
            TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
        })
    end
    if props.desc and props.desc ~= "" then
        desc = new("TextLabel", {
            Name = "desc", Parent = stack, LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1, Text = props.desc, TextColor3 = opts.text_color or "@text",
            TextTransparency = fill and 0.25 or 0.5, TextSize = 13, Weight = "Regular",
            TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
        })
    end

    local controls = new("Frame", {
        Name = "controls", Parent = root, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.new(0, 0, 0, 28), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1,
    })
    list(controls, 8, true, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)

    if opts.hover ~= false and not fill then
        root.MouseEnter:Connect(function() tween(root, { BackgroundTransparency = 0.9 }, 0.2) end)
        root.MouseLeave:Connect(function() tween(root, { BackgroundTransparency = 0.93 }, 0.2) end)
    end

    return { root = root, title = title, desc = desc, stack = stack, controls = controls, icon = icon_img }
end

local function finish(self, cfg, el)
    cfg.frame = el.root
    function cfg:set_title(t) if el.title then el.title.Text = t end end
    function cfg:set_desc(t) if el.desc then el.desc.Text = t end end
    function cfg:set_visible(v) el.root.Visible = v end
    function cfg:destroy() el.root:Destroy() end
    register(self, cfg.name, el.root)
end

-- keybind editor popup shared by toggles and buttons (gear icon)
local function attach_bind(cfg, gear, opts)
    opts = opts or {}
    local height = opts.modes and 92 or 52
    local popup = make_popup(220, height)
    popup.Active = true
    pad(popup, 10, 10, 12, 12)
    list(popup, 8)

    local function row(label_text, order)
        local r = new("Frame", { Parent = popup, LayoutOrder = order, Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1 })
        new("TextLabel", {
            Parent = r, Size = UDim2.new(0.4, 0, 1, 0), BackgroundTransparency = 1, Text = label_text,
            TextColor3 = "@text", TextTransparency = 0.35, TextSize = 13, Weight = "Medium", TextXAlignment = Enum.TextXAlignment.Left,
        })
        return r
    end

    local key_row = row("keybind", 1)
    local chip = new("TextButton", {
        Parent = key_row, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(92, 28),
        BackgroundColor3 = "@outline", BackgroundTransparency = 0.92, BorderSizePixel = 0, AutoButtonColor = false,
        Text = "none", TextColor3 = "@text", TextSize = 13, Weight = "Medium",
    })
    corner(chip, 8)
    stroke(chip, 0.9)
    local clear_btn = new("ImageButton", {
        Parent = key_row, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -100, 0.5, 0), Size = UDim2.fromOffset(14, 14),
        BackgroundTransparency = 1, Image = library:get_icon("x"), ImageColor3 = "@icon",
    })

    local pill, mode_buttons
    if opts.modes then
        local mode_row = row("mode", 2)
        local seg = new("Frame", {
            Parent = mode_row, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(120, 28),
            BackgroundColor3 = "@outline", BackgroundTransparency = 0.93, BorderSizePixel = 0,
        })
        corner(seg, 8)
        stroke(seg, 0.9)
        pill = new("Frame", {
            Parent = seg, Position = UDim2.new(0, 2, 0, 2), Size = UDim2.new(0.5, -4, 1, -4),
            BackgroundColor3 = "@accent", BorderSizePixel = 0,
        })
        corner(pill, 6)
        mode_buttons = {}
        for i, m in ipairs({ "toggle", "hold" }) do
            local b = new("TextButton", {
                Parent = seg, Position = UDim2.new((i - 1) * 0.5, 0, 0, 0), Size = UDim2.new(0.5, 0, 1, 0),
                BackgroundTransparency = 1, Text = m, TextSize = 12, Weight = "Medium", AutoButtonColor = false,
                TextColor3 = library.themes.preset.icon,
            })
            mode_buttons[m] = b
            b.MouseButton1Click:Connect(function() cfg.set_mode(m) end)
        end
    end

    local bind_conn, hold_conn

    local function matches(input)
        if cfg.key == nil or cfg.key == Enum.KeyCode.Unknown then return false end
        if cfg.key.EnumType == Enum.KeyCode then return input.KeyCode == cfg.key end
        return input.UserInputType == cfg.key
    end

    local function reconnect()
        if bind_conn then bind_conn:Disconnect() bind_conn = nil end
        if hold_conn then hold_conn:Disconnect() hold_conn = nil end
        if cfg.key == nil or cfg.key == Enum.KeyCode.Unknown then return end
        bind_conn = uis.InputBegan:Connect(function(input, gpe)
            if gpe or cfg.binding then return end
            if matches(input) then
                if cfg.mode == "hold" then opts.on_trigger(true) else opts.on_trigger(nil) end
            end
        end)
        hold_conn = uis.InputEnded:Connect(function(input)
            if cfg.mode == "hold" and matches(input) then opts.on_trigger(false) end
        end)
        table.insert(library.connections, bind_conn)
        table.insert(library.connections, hold_conn)
    end

    function cfg.set_key(key)
        key = parse_key(key)
        cfg.key = key
        chip.Text = key_name(key)
        library.flags[cfg.flag .. "_key"] = key_name(key)
        reconnect()
    end

    local function paint_mode(animated)
        if not opts.modes then return end
        local sel = cfg.mode == "hold" and 2 or 1
        tween(pill, { Position = UDim2.new((sel - 1) * 0.5, 2, 0, 2) }, animated and 0.25 or 0)
        for m, b in pairs(mode_buttons) do
            b.TextColor3 = (m == cfg.mode) and contrast(library.themes.preset.accent) or library.themes.preset.icon
        end
    end

    function cfg.set_mode(m)
        if m ~= "toggle" and m ~= "hold" then m = "toggle" end
        cfg.mode = m
        library.flags[cfg.flag .. "_mode"] = m
        paint_mode(true)
        reconnect()
    end
    table.insert(library.on_theme, function() paint_mode(false) end)

    library:connection(clear_btn.MouseButton1Click, function() cfg.set_key(Enum.KeyCode.Unknown) end)

    library:connection(chip.MouseButton1Click, function()
        if cfg.binding then return end
        chip.Text = "..."
        cfg.binding = true
        local conn
        conn = uis.InputBegan:Connect(function(input)
            if not cfg.binding then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                if input.KeyCode == Enum.KeyCode.Escape then
                    cfg.set_key(Enum.KeyCode.Unknown)
                else
                    cfg.set_key(input.KeyCode)
                end
            elseif input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.MouseButton2
                or input.UserInputType == Enum.UserInputType.MouseButton3 then
                cfg.set_key(input.UserInputType)
            else
                return
            end
            cfg.binding = false
            conn:Disconnect()
        end)
    end)

    library:connection(gear.MouseButton1Click, function()
        library:open_popup(popup, gear, { size = Vector2.new(220, height) })
        tween(gear, { Rotation = gear.Rotation + 90 }, 0.4)
    end)

    cfg.set_key(cfg.default_key)
    cfg.mode = cfg.default_mode
    cfg.set_mode(cfg.default_mode)

    library.config_flags[cfg.flag .. "_key"] = cfg.set_key
    library.config_flags[cfg.flag .. "_mode"] = cfg.set_mode
end

