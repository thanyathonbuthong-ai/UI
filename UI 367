    local cfg = {
        name = props.name or props.title,
        desc = props.desc,
        icon = props.icon,
        code = props.code or props.text or "",
    }
    local el = make_element(self, { name = cfg.name, desc = cfg.desc, icon = cfg.icon }, { right_width = 0, hover = false, stack_padding = 8 })

    local block = new("Frame", {
        Name = "code", Parent = el.stack, LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
