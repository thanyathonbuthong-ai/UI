        })
        corner(overlay, 16)

        local bye = new("TextLabel", {
            Name = "goodbye", Parent = overlay, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = main_frame.Size, BackgroundTransparency = 1, Text = "", TextColor3 = "@text",
