        })

        local expand = tween(overlay, { Size = UDim2.new(1, 0, 1, 0) }, 0.6, Enum.EasingStyle.Quart)
        expand.Completed:Wait()

        local function rng(char)
            local base = math.random() * 0.15 + 0.03
            if char == "," or char == "." or char == " " then base += math.random() * 0.12 end
            return tonumber(string.format("%.3f", base))
        end

        local full_text = "goodbye, " .. player.DisplayName
        for i = 1, #full_text do
            bye.Text = string.sub(full_text, 1, i)
            task.wait(rng(string.sub(full_text, i, i)))
        end

        for _, child in ipairs(gui:GetChildren()) do
            if child ~= main_frame then child:Destroy() end
        end
        for _, child in ipairs(main_frame:GetChildren()) do
            if child ~= overlay then child:Destroy() end
        end

        task.wait(1.53)

        local shrink = tween(overlay, { Size = UDim2.new(0, 0, 0, 0) }, 0.6, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        main_frame.BackgroundTransparency = 1
        tween(bye, { TextTransparency = 1 }, 0.4)
        shrink.Completed:Wait()

