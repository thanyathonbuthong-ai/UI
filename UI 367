function library:dialog(props)
    props = props or {}
    local cfg = {
        title = props.title or "dialog",
        content = props.content or props.text or "",
        icon = props.icon,
        buttons = props.buttons or { { name = "ok", style = "primary" } },
    }

    local main = library.gui and library.gui:FindFirstChild("main")
    if not main then return nil end

    local overlay = new("TextButton", {
        Name = "dialog_overlay",
        Parent = main,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 60,
    })
    corner(overlay, 16)
    tween(overlay, { BackgroundTransparency = 0.5 }, 0.25)

    local box = new("Frame", {
        Name = "box",
        Parent = overlay,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, 340, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = "@dialog",
        BorderSizePixel = 0,
    })
    corner(box, 16)
    stroke(box, 0.88)
    pad(box, 18, 18, 18, 18)
    list(box, 10)
    local box_scale = new("UIScale", { Parent = box, Scale = 0.92 })
    tween(box_scale, { Scale = 1 }, 0.3)

    local head = new("Frame", { Parent = box, Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, LayoutOrder = 1 })
    list(head, 8, true, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
    if cfg.icon then
        new("ImageLabel", {
            Parent = head, LayoutOrder = 1, Size = UDim2.fromOffset(22, 22), BackgroundTransparency = 1,
            Image = library:get_icon(cfg.icon), ImageColor3 = "@text",
        })
    end
    new("TextLabel", {
        Parent = head, LayoutOrder = 2, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        Text = cfg.title, TextColor3 = "@text", TextSize = 18, Weight = "SemiBold",
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
    })

    if cfg.content ~= "" then
        new("TextLabel", {
            Parent = box, LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1, Text = cfg.content, TextColor3 = "@text", TextTransparency = 0.35,
            TextSize = 14, Weight = "Regular", TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
        })
    end

    local row = new("Frame", { Parent = box, LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1 })
    list(row, 8, true, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)

    local closed = false
    function cfg:close()
        if closed then return end
        closed = true
        tween(overlay, { BackgroundTransparency = 1 }, 0.2)
        tween(box_scale, { Scale = 0.92 }, 0.2)
        task.delay(0.22, function()
            if overlay then overlay:Destroy() end
        end)
    end

    for i, b in ipairs(cfg.buttons) do
        local style = b.style or (i == #cfg.buttons and "primary" or "default")
        local btn = new("TextButton", {
            Parent = row, LayoutOrder = i, Size = UDim2.new(0, 0, 0, 34), AutomaticSize = Enum.AutomaticSize.X,
            BackgroundColor3 = "@outline", BackgroundTransparency = 0.9, BorderSizePixel = 0,
            Text = b.name or "ok", AutoButtonColor = false, TextColor3 = "@text", TextSize = 14, Weight = "Medium",
        })
        corner(btn, 10)
        pad(btn, 0, 0, 16, 16)
        if style == "primary" then
            library:bind_theme(btn, "BackgroundColor3", "accent")
            btn.BackgroundTransparency = 0
            btn.TextColor3 = contrast(library.themes.preset.accent)
        elseif style == "danger" then
            btn.BackgroundColor3 = Color3.fromRGB(239, 68, 68)
            btn.BackgroundTransparency = 0
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        end
        btn.InputBegan:Connect(function(input)
            if is_press(input) then ripple(btn, input.Position.X, input.Position.Y) end
        end)
        btn.ClipsDescendants = true
        btn.MouseButton1Click:Connect(function()
            cfg:close()
            if b.callback then task.spawn(b.callback) end
        end)
    end

    return cfg
end

