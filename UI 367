function library:loading_screen(props)
    props = props or {}
    local cfg = {
        text = props.text or "loading...",
        duration = props.duration or 2,
        icon = props.icon or "loader",
    }

    library.is_loading = true

    if not library.gui or not library.gui:FindFirstChild("main") then return end

    local main_frame = library.gui.main
    main_frame.Visible = true
    library.shown = true
    if library.open_btn then library.open_btn.Visible = false end

    local screen = new("Frame", {
        Name = "loader",
        Parent = main_frame,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = "@background",
        BorderSizePixel = 0,
        ZIndex = 9999,
    })
    corner(screen, 16)

    local logo = new("ImageLabel", {
        Name = "logo",
        Parent = screen,
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, -40),
        Size = UDim2.fromOffset(96, 96),
        Image = library:get_icon(cfg.icon),
        ImageColor3 = "@text",
        ZIndex = 10000,
    })

    local text_label = new("TextLabel", {
        Name = "text",
        Parent = screen,
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 40),
        Size = UDim2.fromOffset(240, 20),
        Text = cfg.text,
        TextColor3 = "@text",
        TextSize = 15,
        Weight = "SemiBold",
        ZIndex = 10000,
    })

    local track = new("Frame", {
        Name = "track",
        Parent = screen,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 70),
        Size = UDim2.fromOffset(160, 4),
        BackgroundColor3 = "@outline",
        BackgroundTransparency = 0.9,
        BorderSizePixel = 0,
        ZIndex = 10000,
    })
    corner(track, 999)
    local fill = new("Frame", {
        Parent = track,
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = "@accent",
        BorderSizePixel = 0,
        ZIndex = 10001,
    })
    corner(fill, 999)
    tween(fill, { Size = UDim2.new(1, 0, 1, 0) }, cfg.duration, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)

    local spin_tween = tween(logo, { Rotation = 360 }, 1.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    local spin_conn
    spin_conn = spin_tween.Completed:Connect(function()
        if logo and logo.Parent then
            logo.Rotation = 0
            spin_tween:Play()
        elseif spin_conn then
            spin_conn:Disconnect()
        end
    end)

    task.delay(cfg.duration, function()
        if spin_conn then spin_conn:Disconnect() end
        if spin_tween then spin_tween:Pause() end

        tween(screen, { BackgroundTransparency = 1 }, 0.8, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        tween(logo, { ImageTransparency = 1 }, 0.8, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        tween(text_label, { TextTransparency = 1 }, 0.8, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        tween(track, { BackgroundTransparency = 1 }, 0.8)
        tween(fill, { BackgroundTransparency = 1 }, 0.8)

        task.delay(0.8, function()
            library.is_loading = false
            if screen then screen:Destroy() end
        end)
    end)
end

