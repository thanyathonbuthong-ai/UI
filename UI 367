function library:button(props)
    props = props or {}
    local cfg = {
        name = props.name or "button",
        desc = props.desc,
        icon = props.icon,
        callback = props.callback or function() end,
        keybind_enabled = props.keybind or false,
        default_key = props.default_key or Enum.KeyCode.Unknown,
        flag = props.flag or props.name or "button_" .. tostring(math.random(1, 100000)),
        style = props.style or "default",
        color = props.color,
    }

    local filled = cfg.color ~= nil or cfg.style == "primary" or cfg.style == "danger"
    local fill, text_color
    if filled then
        if cfg.color then
            fill = cfg.color
        elseif cfg.style == "danger" then
            fill = Color3.fromRGB(239, 68, 68)
        else
            fill = "@accent"
        end
        text_color = contrast(typeof(fill) == "Color3" and fill or library.themes.preset.accent)
    end

    local has_bind = cfg.keybind_enabled
    local el = make_element(self, { name = cfg.name, desc = cfg.desc, icon = cfg.icon }, {
        right_width = has_bind and 64 or 32, fill = fill, text_color = text_color,
    })

    local gear
    if has_bind then
        gear = new("ImageButton", {
            Name = "settings_btn", Parent = el.controls, LayoutOrder = 1, Size = UDim2.fromOffset(20, 20),
            BackgroundTransparency = 1, Image = library:get_icon("settings"), ImageColor3 = text_color or "@icon",
        })
    end
    new("ImageLabel", {
        Name = "arrow", Parent = el.controls, LayoutOrder = 2, Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 1,
        Image = library:get_icon("down"), ImageColor3 = text_color or "@icon", Rotation = -90,
    })

    if filled then
        el.root.MouseEnter:Connect(function() tween(el.root, { BackgroundTransparency = 0.12 }, 0.2) end)
        el.root.MouseLeave:Connect(function() tween(el.root, { BackgroundTransparency = 0 }, 0.2) end)
    end

    if has_bind then
        attach_bind(cfg, gear, {
            modes = false,
            on_trigger = function(state)
                if state ~= false and type(cfg.callback) == "function" then cfg.callback() end
            end,
        })
    end

    library:connection(el.root.InputBegan, function(input)
        if is_press(input) then ripple(el.root, input.Position.X, input.Position.Y) end
    end)
    library:connection(el.root.MouseButton1Click, function()
        if type(cfg.callback) == "function" then cfg.callback() end
    end)

    finish(self, cfg, el)
    return cfg
end

