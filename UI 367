local function tween(inst, props, t, style, dir)
    local tw = tween_service:Create(inst, TweenInfo.new(t or 0.2, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

function library:create(class, props)
    local inst = Instance.new(class)
    local parent
    for prop, val in next, props do
        if prop == "Parent" then
            parent = val
        elseif prop == "Weight" then
            apply_font(inst, val)
        elseif type(val) == "string" and string.sub(val, 1, 1) == "@" and string.find(prop, "Color", 1, true) then
            local key = string.sub(val, 2)
            inst[prop] = library.themes.preset[key]
            local bucket = library.theme_elements[key]
            if not bucket then
                bucket = {}
                library.theme_elements[key] = bucket
            end
            table.insert(bucket, { inst = inst, prop = prop })
        else
            inst[prop] = val
        end
    end
    if parent then inst.Parent = parent end
    return inst
end

local function new(class, props) return library:create(class, props) end

-- bind an already existing property to a theme token
function library:bind_theme(inst, prop, key)
    local bucket = library.theme_elements[key]
    if not bucket then
        bucket = {}
        library.theme_elements[key] = bucket
    end
    inst[prop] = library.themes.preset[key]
    table.insert(bucket, { inst = inst, prop = prop })
end

local function corner(parent, r)
    return new("UICorner", { Parent = parent, CornerRadius = UDim.new(0, r) })
end

local function stroke(parent, transparency, color)
    return new("UIStroke", {
        Parent = parent,
        Color = color or "@outline",
        Thickness = 1,
        Transparency = transparency or 0.9,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })
end

local function pad(parent, t, b, l, r)
    return new("UIPadding", {
        Parent = parent,
        PaddingTop = UDim.new(0, t or 0),
        PaddingBottom = UDim.new(0, b or 0),
        PaddingLeft = UDim.new(0, l or 0),
        PaddingRight = UDim.new(0, r or 0),
    })
end

local function list(parent, padding, horizontal, halign, valign)
    return new("UIListLayout", {
        Parent = parent,
        Padding = UDim.new(0, padding or 0),
        SortOrder = Enum.SortOrder.LayoutOrder,
        FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
        HorizontalAlignment = halign or Enum.HorizontalAlignment.Left,
        VerticalAlignment = valign or Enum.VerticalAlignment.Top,
    })
end

local function ripple(target, x, y)
    local rel = Vector2.new(x, y) - target.AbsolutePosition
    local size = math.max(target.AbsoluteSize.X, target.AbsoluteSize.Y) * 1.8
    local r = new("Frame", {
        Name = "ripple",
        Parent = target,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset(rel.X, rel.Y),
        Size = UDim2.fromOffset(0, 0),
        BackgroundColor3 = library.themes.preset.outline,
        BackgroundTransparency = 0.88,
        BorderSizePixel = 0,
    })
    corner(r, 999)
    tween(r, { Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 }, 0.55)
    task.delay(0.55, function()
        if r then r:Destroy() end
    end)
end

