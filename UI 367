function library:tab(props)
    props = props or {}
    local cfg = {
        name = props.name or "tab",
        icon = props.icon or "down",
        hidden = props.hidden or false,
        is_tab = true,
        is_section = false,
        sections = {},
        items = {},
    }
    cfg.group = rawget(self, "is_group") and self or nil

    local order = props.hidden_order
    if not order then
        library.tab_order += 1
        order = library.tab_order
    end
    local parent = rawget(self, "tab_parent") or library.tab_list

    local button = new("TextButton", {
        Name = cfg.name, Parent = parent, Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = "@outline",
        BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = order, BorderSizePixel = 0,
        Visible = not cfg.hidden,
    })
    corner(button, 10)
    local btn_stroke = stroke(button, 1)

    local icon_label = new("ImageLabel", {
        Name = "icon", Parent = button, BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 14, 0.5, 0), Size = UDim2.fromOffset(18, 18),
        Image = library:get_icon(cfg.icon), ImageColor3 = library.themes.preset.icon,
    })
    local text_label = new("TextLabel", {
        Name = "text", Parent = button, BackgroundTransparency = 1, Position = UDim2.new(0, 44, 0, 0),
        Size = UDim2.new(1, -52, 1, 0), Text = cfg.name, TextColor3 = library.themes.preset.icon,
        TextSize = 14, Weight = "Medium", TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
    })
    table.insert(library.sidebar_fade.text, text_label)

    local page = new("ScrollingFrame", {
        Name = cfg.name .. "_page", Parent = library.tab_content, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = "@text", ScrollBarImageTransparency = 0.8,
        CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y, Visible = false,
    })
    list(page, 8)
    pad(page, 14, 16, 14, 16)

    local function visual(selected, animated)
        local P = library.themes.preset
        local t = animated and 0.25 or 0
        tween(button, { BackgroundTransparency = selected and 0.91 or 1 }, t)
        tween(btn_stroke, { Transparency = selected and 0.9 or 1 }, t)
        tween(text_label, { TextColor3 = selected and P.text or P.icon }, t)
        tween(icon_label, { ImageColor3 = selected and P.text or P.icon }, t)
    end

    cfg.button = button
    cfg.tab_button = button
    cfg.page = page
    cfg.frame = page
    cfg.holder = page
    cfg.text_label = text_label
    cfg.icon_label = icon_label
    cfg._visual = visual
    if cfg.group then table.insert(cfg.group.tabs, cfg) end
    table.insert(library.tabs, cfg)
    table.insert(library.on_theme, function()
        visual(library.current_tab == cfg, true)
    end)

    button.MouseEnter:Connect(function()
        if library.current_tab ~= cfg then tween(button, { BackgroundTransparency = 0.95 }, 0.15) end
    end)
    button.MouseLeave:Connect(function()
        if library.current_tab ~= cfg then tween(button, { BackgroundTransparency = 1 }, 0.15) end
    end)

    function cfg:select()
        if library.current_tab == cfg then return end
        library:close_popups()
        local old = library.current_tab
        if old then
            old.page.Visible = false
            old._visual(false, true)
        end
        library.current_tab = cfg
        visual(true, true)
        page.Position = UDim2.new(0, 0, 0, 16)
        page.Visible = true
        tween(page, { Position = UDim2.new(0, 0, 0, 0) }, 0.4)
    end

    library:connection(button.MouseButton1Click, function() cfg:select() end)

    return setmetatable(cfg, { __index = self })
end

-- collapsible group of elements inside a tab
function library:section(props)
    props = props or {}
    local tab = rawget(self, "is_tab") and self or rawget(self, "tab_ref")
    local cfg = {
        name = props.name or "section",
