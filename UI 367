    local function apply_search(q)
        q = string.lower(q or "")
        for _, tab in ipairs(library.tabs) do
            if not tab.hidden then
                local tab_match = q == "" or string.find(string.lower(tab.name), q, 1, true) ~= nil
                local any = tab_match
                for _, item in ipairs(tab.items) do
                    local sec = item.section
                    local m = tab_match
                        or (item.name ~= "" and string.find(string.lower(item.name), q, 1, true) ~= nil)
                        or (sec ~= nil and string.find(string.lower(sec.name), q, 1, true) ~= nil)
                    item.frame.Visible = m
                    if m then any = true end
                end
                for _, sec in ipairs(tab.sections) do
                    local vis = tab_match or string.find(string.lower(sec.name), q, 1, true) ~= nil
                    if not vis then
                        for _, item in ipairs(tab.items) do
                            if item.section == sec and item.name ~= "" and item.frame.Visible then
                                vis = true
                                break
                            end
                        end
                    end
                    sec.frame.Visible = vis
                end
                tab.button.Visible = any
            end
        end
        for _, group in ipairs(library.groups) do
            local vis = q == ""
            for _, t in ipairs(group.tabs) do
                if t.button.Visible then vis = true break end
            end
            group.frame.Visible = vis
        end
        if q ~= "" and library.current_tab and not library.current_tab.button.Visible then
            for _, tab in ipairs(library.tabs) do
                if not tab.hidden and tab.button.Visible then
                    tab:select()
                    break
                end
            end
        end
    end
