    function library:set_visible(v)
        library.shown = v
        library.vis_token = (library.vis_token or 0) + 1
        local token = library.vis_token
        if v then
            main_frame.Visible = true
            main_scale.Scale = 0.94
            tween(main_scale, { Scale = 1 }, 0.3)
            open_btn.Visible = false
        else
            library:close_popups()
            tween(main_scale, { Scale = 0.94 }, 0.2)
            task.delay(0.2, function()
                if library.vis_token == token and main_frame.Visible then main_frame.Visible = false end
            end)
            open_btn.Visible = cfg.open_button
        end
    end
    function library:toggle_window()
        library:set_visible(not library.shown)
    end

    do
        local drag, start, spos, moved
        library:connection(open_btn.InputBegan, function(input)
            if is_press(input) then
                drag, start, spos, moved = true, input.Position, open_btn.Position, false
            end
        end)
        library:connection(uis.InputChanged, function(input)
            if drag and is_move(input) then
                local d = input.Position - start
                if d.Magnitude > 6 then moved = true end
                if moved then
                    open_btn.Position = UDim2.new(spos.X.Scale, spos.X.Offset + d.X, spos.Y.Scale, spos.Y.Offset + d.Y)
                end
            end
        end)
        library:connection(uis.InputEnded, function(input)
            if drag and is_press(input) then
                drag = false
                if not moved then library:set_visible(true) end
            end
        end)
    end

    -- ── dragging + resizing ──────────────────────────────────────────────────
    local fullscreen = false
    local dragging, drag_start, start_pos
    library:connection(topbar.InputBegan, function(input)
        if is_press(input) and not fullscreen then
            dragging = true
            drag_start = input.Position
            start_pos = main_frame.Position
        end
    end)
    library:connection(topbar.InputEnded, function(input)
        if is_press(input) then dragging = false end
    end)
    library:connection(uis.InputChanged, function(input)
        if is_move(input) then
            if dragging then
                local delta = input.Position - drag_start
                local target_pos = UDim2.new(start_pos.X.Scale, start_pos.X.Offset + delta.X, start_pos.Y.Scale, start_pos.Y.Offset + delta.Y)
                if library.drag_speed > 0 then
                    tween(main_frame, { Position = target_pos }, library.drag_speed, Enum.EasingStyle.Quad)
                else
                    main_frame.Position = target_pos
                end
            end
        elseif input.UserInputType == Enum.UserInputType.MouseWheel then
            library:close_popups()
        end
    end)

    local resize_handle = new("TextButton", {
        Name = "resize", Parent = main_frame, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, 0, 1, 0),
        Size = UDim2.fromOffset(22, 22), BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
        ZIndex = 20, Visible = cfg.resizable,
    })
    local resizing, r_start, r_size, r_pos
    library:connection(resize_handle.InputBegan, function(input)
        if is_press(input) and not fullscreen then
            resizing, r_start, r_size, r_pos = true, input.Position, main_frame.AbsoluteSize, main_frame.Position
        end
    end)
    library:connection(uis.InputChanged, function(input)
        if resizing and is_move(input) then
            local cam = workspace_service.CurrentCamera
            local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
            local d = input.Position - r_start
