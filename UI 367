    stroke(block, 0.92)
    pad(block, 10, 10, 12, 66)
    local label = new("TextLabel", {
        Parent = block, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
        Text = cfg.code, TextColor3 = "@text", TextTransparency = 0.15, TextSize = 13, Font = Enum.Font.Code,
        TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
    })
    local copy = new("TextButton", {
        Parent = block, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 58, 0, -4), Size = UDim2.fromOffset(52, 24),
        BackgroundColor3 = "@outline", BackgroundTransparency = 0.9, BorderSizePixel = 0, AutoButtonColor = false,
        Text = "copy", TextColor3 = "@text", TextSize = 12, Weight = "Medium",
    })
    corner(copy, 7)
    library:connection(copy.MouseButton1Click, function()
        setclipboard(cfg.code)
        copy.Text = "copied"
        task.delay(1.2, function()
            if copy and copy.Parent then copy.Text = "copy" end
        end)
    end)

    function cfg:set_code(text)
        cfg.code = text
        label.Text = text
    end

    finish(self, cfg, el)
    return cfg
end

function library:divider()
    local parent = self.holder or rawget(self, "tab_parent") or library.tab_list
    local sidebar_level = self.holder == nil

    local order = 0
    if sidebar_level then
        library.tab_order += 1
        order = library.tab_order
    end

    local frame = new("Frame", {
        Name = "divider", Parent = parent, Size = UDim2.new(1, 0, 0, 9), BackgroundTransparency = 1, LayoutOrder = order,
    })
    new("Frame", {
        Parent = frame, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(1, 0, 0, 1),
        BackgroundColor3 = "@outline", BackgroundTransparency = 0.93, BorderSizePixel = 0,
    })
    if not sidebar_level then register(self, "", frame) end
    return frame
end

-- read-only "name ........ value" row, returns the value label so you can update it
function library:info_row(name, val)
    local el = make_element(self, { name = name }, { right_width = 200, hover = false })
    local val_label = new("TextLabel", {
        Name = "val", Parent = el.controls, Size = UDim2.new(0, 190, 1, 0), BackgroundTransparency = 1,
        Text = tostring(val), TextColor3 = "@text", TextTransparency = 0.3, TextSize = 14, Weight = "Medium",
        TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd,
    })
    register(self, name, el.root)
    return val_label
end
library.add_info_row = library.info_row

getgenv().library = library
return library
