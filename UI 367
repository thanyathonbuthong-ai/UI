function library:close_popups(except)
    for i = #library.active_popups, 1, -1 do
        local rec = library.active_popups[i]
        if rec.frame ~= except then
            rec.frame.Visible = false
            table.remove(library.active_popups, i)
            if rec.on_close then task.spawn(rec.on_close) end
        end
    end
    if library.popup_layer then
        library.popup_layer.Visible = #library.active_popups > 0
    end
end

function library:open_popup(popup, anchor, opts)
    opts = opts or {}
    library:close_popups(popup)

    for i = #library.active_popups, 1, -1 do
        if library.active_popups[i].frame == popup then table.remove(library.active_popups, i) end
    end

    local layer = library.popup_layer
    local size = opts.size or Vector2.new(popup.Size.X.Offset, popup.Size.Y.Offset)
    local a_pos = anchor.AbsolutePosition - layer.AbsolutePosition
    local a_size = anchor.AbsoluteSize
    local screen = layer.AbsoluteSize

    local x = (opts.align == "left") and a_pos.X or (a_pos.X + a_size.X - size.X)
    local y = a_pos.Y + a_size.Y + 6
    if y + size.Y > screen.Y - 8 then
        y = a_pos.Y - size.Y - 6
    end
    x = math.clamp(x, 8, math.max(8, screen.X - size.X - 8))
    y = math.clamp(y, 8, math.max(8, screen.Y - size.Y - 8))

    layer.Visible = true
    popup.Position = UDim2.fromOffset(x, y)
    popup.Visible = true

    local scale = popup:FindFirstChild("scale")
    if scale then
        scale.Scale = 0.94
        tween(scale, { Scale = 1 }, 0.2)
    end

    table.insert(library.active_popups, { frame = popup, on_close = opts.on_close })
end

local function make_popup(width, height)
    local popup = new("Frame", {
        Name = "popup",
        Parent = library.popup_layer,
        Visible = false,
        Size = UDim2.fromOffset(width, height),
        BackgroundColor3 = "@dialog",
        BorderSizePixel = 0,
        ZIndex = 2,
        Active = true,
    })
    corner(popup, 14)
    stroke(popup, 0.88)
    new("UIScale", { Name = "scale", Parent = popup, Scale = 1 })
    return popup
end

