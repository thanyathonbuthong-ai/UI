local function hex_to_color(hex)
    if type(hex) ~= "string" then return nil end
    if string.sub(hex, 1, 1) ~= "#" then hex = "#" .. hex end

    if Color3.fromHex then
        local ok, color = pcall(Color3.fromHex, hex)
        if ok and color then return color end
    end

    local clean_hex = string.gsub(hex, "#", "")
    if #clean_hex == 6 then
        local r = tonumber(string.sub(clean_hex, 1, 2), 16)
        local g = tonumber(string.sub(clean_hex, 3, 4), 16)
        local b = tonumber(string.sub(clean_hex, 5, 6), 16)
        if r and g and b then return Color3.fromRGB(r, g, b) end
    elseif #clean_hex == 3 then
        local r = tonumber(string.sub(clean_hex, 1, 1), 16)
        local g = tonumber(string.sub(clean_hex, 2, 2), 16)
        local b = tonumber(string.sub(clean_hex, 3, 3), 16)
        if r and g and b then return Color3.fromRGB(r * 17, g * 17, b * 17) end
    end
    return nil
end

local key_lookup
local function parse_key(k)
    if typeof(k) == "EnumItem" then return k end
    if type(k) ~= "string" or k == "" or k == "none" or k == "None" then return Enum.KeyCode.Unknown end
    if not key_lookup then
        key_lookup = {}
        for _, e in ipairs(Enum.UserInputType:GetEnumItems()) do key_lookup[e.Name] = e end
        for _, e in ipairs(Enum.KeyCode:GetEnumItems()) do key_lookup[e.Name] = e end
    end
    return key_lookup[k] or Enum.KeyCode.Unknown
end

local function key_name(k)
    if k == nil or k == Enum.KeyCode.Unknown then return "none" end
    return k.Name
end

local function contrast(c)
    local l = 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
    return l > 0.62 and Color3.fromRGB(16, 16, 16) or Color3.fromRGB(255, 255, 255)
end

local function is_press(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function is_move(input)
    return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
end

-- inter (same family windui uses) with gotham fallback
local INTER = "rbxassetid://12187365364"
local font_cache = {}
local font_ok = pcall(function() return Font.new(INTER, Enum.FontWeight.Regular) end)
local fallback_fonts = {
    Regular = Enum.Font.Gotham,
    Medium = Enum.Font.GothamMedium,
    SemiBold = Enum.Font.GothamBold,
    Bold = Enum.Font.GothamBold,
}

local function apply_font(inst, weight)
    weight = weight or "Regular"
    if font_ok then
        local f = font_cache[weight]
        if not f then
            local ok, res = pcall(function()
                return Font.new(INTER, Enum.FontWeight[weight], Enum.FontStyle.Normal)
            end)
            if ok then
                f = res
                font_cache[weight] = f
            end
        end
        if f then
            inst.FontFace = f
            return
        end
    end
    inst.Font = fallback_fonts[weight] or Enum.Font.Gotham
end

