			function ElementHandler:ProgressBar(a)
				local opts = type(a) == "table" and a or {Title = a}
				local desc = opts.Desc
				local v = type(opts.Value) == "table" and opts.Value or {}
				local min = v.Min or opts.Min or 0
				local max = v.Max or opts.Max or 100
				if max <= min then
					max = min + 1
				end
				local value = math.clamp(v.Default or opts.Default or (type(opts.Value) == "number" and opts.Value) or min, min, max)
				local fmt = opts.Format

				local H = desc and 58 or 44
				local Row = MakeRow(Container, "Frame", H)
				Row.Name = "ProgressBar"
				HoverRow(Row)
				local T, D = RowTitle(Row, opts.Title or "Progress", desc, 70)
				T.Position = UDim2.new(0, 14, 0, 6)
				T.Size = UDim2.new(1, -84, 0, 18)

				local Pct = Instance.new("TextLabel")
				Pct.Name = "Percent"
				Pct.Parent = Row
				Pct.AnchorPoint = Vector2.new(1, 0)
				Pct.BackgroundTransparency = 1
				Pct.Position = UDim2.new(1, -14, 0, 6)
				Pct.Size = UDim2.new(0, 60, 0, 18)
				Pct.Font = Enum.Font.Gotham
				Pct.TextColor3 = Theme.Muted
				Pct.TextSize = 13
				Pct.TextXAlignment = Enum.TextXAlignment.Right

				local Track = Instance.new("Frame")
				Track.Name = "ProgressTrack"
				Track.Parent = Row
				Track.BackgroundColor3 = Theme.Off
				Track.BorderSizePixel = 0
				Track.Position = UDim2.new(0, 14, 0, H - 14)
				Track.Size = UDim2.new(1, -28, 0, 6)
				Corner(Track, 3)

				local Fill = Instance.new("Frame")
				Fill.Name = "ProgressFill"
				Fill.Parent = Track
				Fill.BackgroundColor3 = Theme.Accent
				Fill.BorderSizePixel = 0
				Fill.Size = UDim2.new(0, 0, 1, 0)
				Corner(Fill, 3)

				local function Render(animate)
					local s = (value - min) / (max - min)
					Tween(Fill, {Size = UDim2.new(s, 0, 1, 0)}, animate and 0.25 or 0)
					if fmt then
						local ok, txt = pcall(fmt, value, s)
						Pct.Text = ok and tostring(txt) or ""
					else
						Pct.Text = tostring(math.floor(s * 100 + 0.5)) .. "%"
					end
				end
				Render(false)

				local obj = {Type = "ProgressBar"}
				function obj:Set(x)
					value = math.clamp(tonumber(x) or value, min, max)
					Render(true)
				end
				function obj:Get()
					return value
				end
				function obj:SetMax(m)
					max = tonumber(m) or max
					if max <= min then
						max = min + 1
					end
					value = math.clamp(value, min, max)
					Render(true)
				end
				function obj:SetTitle(t)
					SetLocText(T, "Text", t)
				end
				function obj:SetDesc(t)
					if D then
						SetLocText(D, "Text", t)
					end
				end
				return obj
			end

			-- ===================== Viewport (ดูโมเดล 3D) =====================
			function ElementHandler:Viewport(a)
				local opts = type(a) == "table" and a or {Object = a}
				local height = tonumber(opts.Height) or 160
				local interactive = opts.Interactive ~= false
				local autoRotate = opts.AutoRotate ~= false

				local Row = MakeRow(Container, "Frame", height)
				Row.Name = "Viewport"
				Row.ClipsDescendants = true

				local VF = Instance.new("ViewportFrame")
				VF.Name = "ViewportFrame"
				VF.Parent = Row
				VF.BackgroundColor3 = Theme.Field
				VF.BorderSizePixel = 0
				VF.Position = UDim2.new(0, 6, 0, 6)
				VF.Size = UDim2.new(1, -12, 1, -12)
				Corner(VF, 4)

				local Cam = Instance.new("Camera")
				Cam.Parent = VF
				VF.CurrentCamera = Cam

				local current = nil
				local yaw, pitch, dist = 0.6, 0.25, 8
				local center = Vector3.new(0, 0, 0)

				local function UpdateCamera()
					local cf = CFrame.new(center) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(-pitch, 0, 0) * CFrame.new(0, 0, dist)
					Cam.CFrame = CFrame.lookAt(cf.Position, center)
				end

				local function SetObject(o)
					if current then
						current:Destroy()
						current = nil
					end
					if typeof(o) ~= "Instance" then
						return
					end
					local ok, clone = pcall(function()
						return o:Clone()
					end)
					if not ok or not clone then
						return
					end
					clone.Parent = VF
					current = clone
					local cf, size
					if clone:IsA("Model") then
						cf, size = clone:GetBoundingBox()
					elseif clone:IsA("BasePart") then
						cf, size = clone.CFrame, clone.Size
					end
					if cf then
						center = cf.Position
						local radius = size.Magnitude / 2
						dist = math.max(radius / math.sin(math.rad(Cam.FieldOfView / 2)), 2) * 1.05
					end
					UpdateCamera()
				end
				SetObject(opts.Object or opts.Model)
				UpdateCamera()

				local dragging, dragInput, lastPos = false, nil, nil
				VF.InputBegan:Connect(function(input)
					if not interactive then
						return
					end
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						dragging = true
						dragInput = input
						lastPos = input.Position
						InputLock = true
						NewPages.ScrollingEnabled = false
					end
				end)
				UserInputService.InputChanged:Connect(function(input)
					if not dragging then
						return
					end
					if (input.UserInputType == Enum.UserInputType.MouseMovement and dragInput.UserInputType == Enum.UserInputType.MouseButton1)
						or (input.UserInputType == Enum.UserInputType.Touch and input == dragInput) then
						local d = input.Position - lastPos
						lastPos = input.Position
						yaw = yaw - d.X * 0.012
						pitch = math.clamp(pitch + d.Y * 0.008, -1.2, 1.2)
						UpdateCamera()
					end
				end)
				UserInputService.InputEnded:Connect(function(input)
					if dragging and (input == dragInput
						or (input.UserInputType == Enum.UserInputType.MouseButton1 and dragInput.UserInputType == Enum.UserInputType.MouseButton1)) then
						dragging = false
						dragInput = nil
						InputLock = false
						NewPages.ScrollingEnabled = true
					end
				end)

				local hb
				hb = RunService.Heartbeat:Connect(function(dt)
					if not Row:IsDescendantOf(game) then
						hb:Disconnect()
						return
					end
					if autoRotate and not dragging and current and VF.AbsoluteSize.Y > 0 then
						yaw = yaw + dt * 0.6
						UpdateCamera()
					end
				end)

				local obj = {Type = "Viewport"}
				function obj:SetObject(o)
					SetObject(o)
				end
				function obj:SetInteractive(b)
					interactive = b ~= false
				end
				function obj:SetAutoRotate(b)
