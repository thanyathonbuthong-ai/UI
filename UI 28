-- ------------------------------------------------------------
--  Icons  (WindowTable:AddIcons("pack", {name = id | {Image=,ImageRectSize=,ImageRectPosition=}}))
--  ใช้ได้: rbxassetid / ตัวเลข / "pack:name"
-- ------------------------------------------------------------
local IconPacks = {}

local function ResolveIcon(v)
	if v == nil or v == "" then
		return nil
	end
	if type(v) == "number" then
		return "rbxassetid://" .. tostring(v)
	end
	if type(v) == "table" then
		local img = v.Image
		if type(img) == "number" then
			img = "rbxassetid://" .. tostring(img)
		end
		return img, v.ImageRectSize, v.ImageRectPosition
	end
	if type(v) == "string" then
		local pack, name = v:match("^([%w_%-]+):(.+)$")
		if pack and IconPacks[pack] and IconPacks[pack][name] then
			local d = IconPacks[pack][name]
			return d.Image, d.ImageRectSize, d.ImageRectPosition
		end
		if v:find("rbxasset") or v:find("http") then
			return v
		end
		if tonumber(v) then
			return "rbxassetid://" .. v
		end
		for _, p in pairs(IconPacks) do
			if p[v] then
				return p[v].Image, p[v].ImageRectSize, p[v].ImageRectPosition
			end
		end
	end
	return nil
end

local function ApplyIcon(img, v)
	local image, size, pos = ResolveIcon(v)
	if not image then
		return false
	end
	img.Image = image
	img.ImageRectSize = size or Vector2.new(0, 0)
	img.ImageRectOffset = pos or Vector2.new(0, 0)
	return true
end

-- ------------------------------------------------------------
--  Localization  (ใส่ "loc:KEY" ในข้อความใดก็ได้)
-- ------------------------------------------------------------
local Loc = {
	Enabled = false,
	Lang = "en",
	Default = "en",
	Translations = {},
	Objects = setmetatable({}, {__mode = "k"})
}

local function Translate(s)
	if type(s) ~= "string" or not Loc.Enabled then
		return s
	end
	local key = s:match("^loc:(.+)$")
	if not key then
		return s
	end
	local tr = Loc.Translations[Loc.Lang]
	if tr and tr[key] ~= nil then
		return tr[key]
	end
	local def = Loc.Translations[Loc.Default]
	if def and def[key] ~= nil then
		return def[key]
	end
	return key
end

local function LocRegister(inst, prop)
	local raw = inst[prop]
	if type(raw) == "string" and raw:sub(1, 4) == "loc:" then
		local map = Loc.Objects[inst]
		if not map then
			map = {}
			Loc.Objects[inst] = map
		end
		map[prop] = raw
		inst[prop] = Translate(raw)
	end
end

local function LocScan(root)
	local function one(i)
		if i:IsA("TextLabel") or i:IsA("TextButton") then
			LocRegister(i, "Text")
		elseif i:IsA("TextBox") then
			LocRegister(i, "PlaceholderText")
		end
	end
	one(root)
	for _, d in ipairs(root:GetDescendants()) do
		one(d)
	end
end

local function SetLocText(inst, prop, text)
	if Loc.Objects[inst] then
		Loc.Objects[inst][prop] = nil
	end
	inst[prop] = tostring(text)
	LocRegister(inst, prop)
end

local function LocRefresh()
	for inst, props in pairs(Loc.Objects) do
		if inst.Parent then
			for prop, raw in pairs(props) do
				pcall(function()
					inst[prop] = Translate(raw)
				end)
			end
		end
	end
end

