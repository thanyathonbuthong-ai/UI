-- ============================================================
--  Icons   WindowTable:AddIcons("mypack", {home = 123456, star = {Image = 1, ImageRectSize = Vector2.new(48,48), ImageRectPosition = Vector2.new(0,0)}})
--  แล้วใช้ Icon = "mypack:home" ที่ Tab / Topbar / Image / Popup
-- ============================================================
function WindowTable:AddIcons(pack, data)
	if type(pack) ~= "string" or type(data) ~= "table" then
		return false
	end
	local p = IconPacks[pack] or {}
	IconPacks[pack] = p
	for name, v in pairs(data) do
		if type(v) == "number" then
			p[name] = {Image = "rbxassetid://" .. tostring(v)}
		elseif type(v) == "string" then
			p[name] = {Image = v:find("^%d+$") and ("rbxassetid://" .. v) or v}
		elseif type(v) == "table" then
			local img = v.Image
			if type(img) == "number" then
				img = "rbxassetid://" .. tostring(img)
			end
			p[name] = {Image = img, ImageRectSize = v.ImageRectSize, ImageRectPosition = v.ImageRectPosition}
		end
	end
	return true
end

