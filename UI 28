			return
		end
		uitoggled = false
		if LeftFrame.Size == UDim2.new(0, 144, 0, 331) then
			TweenService:Create(LeftFrame, TweenInfo.new(.0, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(0, 41, 0, 331)}):Play()
