local ThemeSkipNames = {CurrentColor = true, ColorSelection = true, HueSelection = true}

local function Remap(c, map, pal)
	local role = map[ColorKey(c)]
	if role then
		return pal[role]
	end
	return nil
end

local function RethemeInstance(i, map, pal)
	if ThemeSkipNames[i.Name] then
		return
	end
	if i.Name == "Color" and i.Parent and i.Parent.Name == "ColorpickerFrame" then
		return
	end
	if i:IsA("GuiObject") then
		local n = Remap(i.BackgroundColor3, map, pal)
		if n then
			i.BackgroundColor3 = n
		end
		if i:IsA("TextLabel") or i:IsA("TextButton") or i:IsA("TextBox") then
			local t = Remap(i.TextColor3, map, pal)
			if t then
				i.TextColor3 = t
			end
			if i:IsA("TextBox") then
				local p = Remap(i.PlaceholderColor3, map, pal)
				if p then
					i.PlaceholderColor3 = p
				end
			end
		elseif i:IsA("ImageLabel") or i:IsA("ImageButton") then
			local m = Remap(i.ImageColor3, map, pal)
			if m then
				i.ImageColor3 = m
			end
		elseif i:IsA("ScrollingFrame") then
			local s = Remap(i.ScrollBarImageColor3, map, pal)
			if s then
				i.ScrollBarImageColor3 = s
			end
		end
	elseif i:IsA("UIStroke") then
		local s = Remap(i.Color, map, pal)
		if s then
			i.Color = s
		end
	elseif i:IsA("UIGradient") then
		local pts, changed = {}, false
		for _, kp in ipairs(i.Color.Keypoints) do
			local n = Remap(kp.Value, map, pal)
			if n then
				changed = true
			end
			table.insert(pts, ColorSequenceKeypoint.new(kp.Time, n or kp.Value))
		end
		if changed then
			i.Color = ColorSequence.new(pts)
		end
	end
end

