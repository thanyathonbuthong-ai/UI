-- ============================================================
--  Config Manager  (ตามแบบ WindUI ConfigManager)
--    local CM  = WindowTable:ConfigManager({Folder = "MyHub"})
--    local cfg = CM:CreateConfig("default")
--    cfg:Register("MyFlag", element)   -- (ไม่บังคับ — Element ที่ตั้ง Flag จะถูกเก็บให้อัตโนมัติ)
--    cfg:Save() / cfg:Load() / cfg:Delete()
--    CM:AllConfigs() / CM:SetAutoLoad("default") / CM:LoadAutoConfig()
-- ============================================================
local function SafeFileName(name)
	return (tostring(name):gsub('[\\/:%*%?"<>|]', "_"))
end

local function EnsureFolder(path)
	if makefolder and isfolder and not isfolder(path) then
		pcall(makefolder, path)
	end
end

local function EncodeValue(obj)
	local ok, v = pcall(function()
		return obj:Get()
	end)
	if not ok or v == nil then
		return nil
	end
	if obj.Type == "Colorpicker" and typeof(v) == "Color3" then
		return {r = v.R, g = v.G, b = v.B}
	end
	return v
end

local function DecodeValue(obj, v)
	if obj.Type == "Colorpicker" and type(v) == "table" then
		return Color3.new(v.r or 0, v.g or 0, v.b or 0)
	end
	return v
end

function WindowTable:ConfigManager(opts)
	if type(opts) == "string" then
		opts = {Folder = opts}
	end
	opts = opts or {}
	local folder = tostring(opts.Folder or "UIConfigs")
	local useFlags = opts.UseFlags ~= false
	local manager = {Folder = folder, Configs = {}, Current = nil}
	local autoPath = folder .. "/_autoload.json"

	local function PathOf(name)
		return folder .. "/" .. SafeFileName(name) .. ".json"
	end

	function manager:CreateConfig(name)
		name = tostring(name or "default")
		if manager.Configs[name] then
			return manager.Configs[name]
		end
		local cfg = {Name = name, Elements = {}}

		function cfg:Register(flag, obj)
			self.Elements[flag] = obj
			return obj
		end

		local function Gather()
			local pool = {}
			if useFlags then
				for f, o in pairs(Flags) do
					pool[f] = o
				end
			end
			for f, o in pairs(cfg.Elements) do
				pool[f] = o
			end
			return pool
		end

		function cfg:GetData()
			local data = {}
			for flag, obj in pairs(Gather()) do
				local v = EncodeValue(obj)
				if v ~= nil then
					data[flag] = v
				end
			end
			return data
		end

		function cfg:Exists()
			return isfile ~= nil and isfile(PathOf(name)) == true
		end

		function cfg:Save()
			if not writefile then
				return false
			end
			EnsureFolder(folder)
			local ok = pcall(function()
				writefile(PathOf(name), HttpService:JSONEncode(cfg:GetData()))
			end)
			return ok
		end

		function cfg:Load()
			if not (readfile and isfile) or not isfile(PathOf(name)) then
				return false
			end
			local ok, data = pcall(function()
				return HttpService:JSONDecode(readfile(PathOf(name)))
			end)
			if not ok or type(data) ~= "table" then
				return false
			end
			local pool = Gather()
			for flag, v in pairs(data) do
				local obj = pool[flag]
				if obj then
					pcall(function()
						obj:Set(DecodeValue(obj, v))
					end)
				end
			end
			manager.Current = name
			return true
		end

		function cfg:Delete()
			if delfile and isfile and isfile(PathOf(name)) then
				pcall(delfile, PathOf(name))
				manager.Configs[name] = nil
				return true
			end
			return false
		end

		function cfg:SetAsCurrent()
			manager.Current = name
		end

		manager.Configs[name] = cfg
		return cfg
	end

	function manager:GetConfig(name)
		return manager.Configs[tostring(name)]
	end

	function manager:AllConfigs()
		local out = {}
		if listfiles and isfolder and isfolder(folder) then
			local ok, files = pcall(listfiles, folder)
			if ok then
				for _, f in ipairs(files) do
					local n = tostring(f):match("([^/\\]+)%.json$")
					if n and n ~= "_autoload" then
						table.insert(out, n)
					end
				end
			end
		end
		table.sort(out)
		return out
	end

	function manager:DeleteConfig(name)
		return manager:CreateConfig(name):Delete()
	end

	function manager:SetAutoLoad(name)
		if not writefile then
			return false
		end
		EnsureFolder(folder)
		return pcall(function()
			writefile(autoPath, HttpService:JSONEncode({name = name}))
		end)
	end

	function manager:GetAutoLoad()
		if not (readfile and isfile) or not isfile(autoPath) then
			return nil
		end
		local ok, data = pcall(function()
			return HttpService:JSONDecode(readfile(autoPath))
		end)
		return ok and type(data) == "table" and data.name or nil
	end

	function manager:LoadAutoConfig()
		local n = manager:GetAutoLoad()
		if n then
			return manager:CreateConfig(n):Load()
		end
		return false
	end

	return manager
end

-- ============================================================
--  Config: บันทึก/โหลดค่าของ Element ที่ตั้ง Flag ไว้
--  WindowTable:SaveConfig("ชื่อ")  /  WindowTable:LoadConfig("ชื่อ")
-- ============================================================
function WindowTable:GetFlag(flag)
	return Flags[flag]
end

function WindowTable:SaveConfig(name)
	if not writefile then
		return false
	end
	local data = {}
	for flag, obj in pairs(Flags) do
		local ok, v = pcall(function()
			return obj:Get()
		end)
		if ok and v ~= nil then
			if obj.Type == "Colorpicker" then
				v = {r = v.R, g = v.G, b = v.B}
			end
			data[flag] = v
		end
	end
	if makefolder and isfolder and not isfolder("UIConfigs") then
		makefolder("UIConfigs")
	end
	local ok = pcall(function()
		writefile("UIConfigs/" .. tostring(name or "default") .. ".json", HttpService:JSONEncode(data))
	end)
	return ok
end

function WindowTable:LoadConfig(name)
	if not (readfile and isfile) then
		return false
	end
	local path = "UIConfigs/" .. tostring(name or "default") .. ".json"
	if not isfile(path) then
		return false
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(path))
	end)
	if not ok or type(data) ~= "table" then
		return false
	end
	for flag, v in pairs(data) do
		local obj = Flags[flag]
		if obj then
			if obj.Type == "Colorpicker" and type(v) == "table" then
				v = Color3.new(v.r or 0, v.g or 0, v.b or 0)
			end
			pcall(function()
				obj:Set(v)
			end)
		end
	end
	return true
end

return WindowTable
