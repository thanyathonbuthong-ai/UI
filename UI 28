	do
		local pressing, moved, pressInput, startPos, startOffset = false, false, nil, nil, nil
		OpenBtn.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				pressing = true
				moved = false
				pressInput = input
				startPos = input.Position
				startOffset = OpenBtn.Position
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if not pressing then
				return
			end
			if (input.UserInputType == Enum.UserInputType.MouseMovement and pressInput.UserInputType == Enum.UserInputType.MouseButton1)
				or (input.UserInputType == Enum.UserInputType.Touch and input == pressInput) then
				local d = input.Position - startPos
				if d.Magnitude > 6 then
					moved = true
				end
				if moved and OpenDraggable then
					OpenBtn.Position = UDim2.new(startOffset.X.Scale, startOffset.X.Offset + d.X, startOffset.Y.Scale, startOffset.Y.Offset + d.Y)
				end
			end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if pressing and (input == pressInput or (input.UserInputType == Enum.UserInputType.MouseButton1 and pressInput.UserInputType == Enum.UserInputType.MouseButton1)) then
				pressing = false
				if not moved then
					WinShow()
				end
			end
		end)
	end

