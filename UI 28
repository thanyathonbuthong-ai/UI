			-- ===================== Group / HStack / VStack =====================
			local function MakeStack(horizontal, a)
				local opts = type(a) == "table" and a or {}
				local gap = tonumber(opts.Gap) or (horizontal and 6 or 2)

				local Frame = Instance.new("Frame")
				Frame.Name = horizontal and "Group" or "VStack"
				Frame.Parent = Container
				Frame.BackgroundTransparency = 1
				Frame.BorderSizePixel = 0
				Frame.Size = UDim2.new(0, 375, 0, 0)
				Frame.AutomaticSize = Enum.AutomaticSize.Y

				local SL = Instance.new("UIListLayout")
				SL.Parent = Frame
				SL.SortOrder = Enum.SortOrder.LayoutOrder
				SL.Padding = UDim.new(0, gap)
				if horizontal then
					SL.FillDirection = Enum.FillDirection.Horizontal
					SL.VerticalAlignment = Enum.VerticalAlignment.Top
				else
					SL.HorizontalAlignment = Enum.HorizontalAlignment.Center
				end

				local function Refit()
					local kids = {}
					for _, c in ipairs(Frame:GetChildren()) do
						if c:IsA("GuiObject") then
							table.insert(kids, c)
						end
					end
					local n = #kids
					if n == 0 then
						return
					end
					local w = math.floor((375 - gap * (n - 1)) / n)
					for i, c in ipairs(kids) do
						c.LayoutOrder = i
						c.Size = UDim2.new(0, w, 0, c.Size.Y.Offset)
					end
				end

				return MakeElements(Frame, horizontal and Refit or nil)
			end

			function ElementHandler:Group(a)
				return MakeStack(true, a)
			end
			function ElementHandler:HStack(a)
				return MakeStack(true, a)
			end
			function ElementHandler:VStack(a)
				return MakeStack(false, a)
			end

			-- ===================== ระบบกลาง: เพิ่ม method ให้ทุก Element =====================
			-- (Destroy / Show / Hide / Lock / Unlock / Highlight / SetTitle / SetDesc / Instance)
			local function Decorate(obj, made, kind)
				if type(obj) ~= "table" then
					obj = {}
				end
				if obj.Type == nil then
					obj.Type = kind
				end
				local first = made[1]
				if not first then
					return obj
				end
				if obj.Instance == nil then
					obj.Instance = first
					obj.ElementFrame = first
				end
				for _, inst in ipairs(made) do
					LocScan(inst)
				end

				if not obj.Destroy then
					function obj:Destroy()
						for k, v in pairs(Flags) do
							if v == obj then
								Flags[k] = nil
							end
						end
						for _, inst in ipairs(made) do
							inst:Destroy()
						end
					end
				end
				if not obj.SetVisible then
					function obj:SetVisible(v)
						if first:IsA("GuiObject") then
							first.Visible = v ~= false
						end
					end
				end
				if not obj.Show then
					function obj:Show()
						obj:SetVisible(true)
					end
				end
				if not obj.Hide then
					function obj:Hide()
						obj:SetVisible(false)
					end
				end
				if not obj.Lock then
					local Block = nil
					function obj:Lock()
						if Block or not first.Parent then
							return
						end
						Block = Instance.new("TextButton")
						Block.Name = "LockOverlay"
						Block.Parent = first
						Block.AutoButtonColor = false
						Block.Text = ""
						Block.BackgroundColor3 = Theme.Window
						Block.BackgroundTransparency = 0.45
						Block.BorderSizePixel = 0
						Block.Size = UDim2.new(1, 0, 1, 0)
						Block.ZIndex = 30
					end
					function obj:Unlock()
						if Block then
							Block:Destroy()
							Block = nil
						end
					end
				end
				if not obj.Highlight then
					function obj:Highlight()
						if first:IsA("GuiObject") and first.BackgroundTransparency < 1 then
							local orig = first.BackgroundColor3
							Tween(first, {BackgroundColor3 = Theme.Accent}, .15)
							task.delay(.25, function()
								if first.Parent then
									Tween(first, {BackgroundColor3 = orig}, .3)
								end
							end)
						end
					end
				end
				if not obj.SetTitle then
					function obj:SetTitle(t)
						local lbl = first
						if not first:IsA("TextLabel") then
							lbl = nil
							for _, d in ipairs(first:GetDescendants()) do
								if d:IsA("TextLabel") then
									lbl = d
									break
								end
							end
						end
						if lbl then
							SetLocText(lbl, "Text", t)
						end
					end
				end
				if not obj.SetDesc then
					function obj:SetDesc(t)
						local d = first:FindFirstChild("Desc", true)
						if d and d:IsA("TextLabel") then
							SetLocText(d, "Text", t)
						end
					end
				end
				return obj
			end

			local ElementNames = {
				"Button", "Toggle", "Slider", "Divider", "Space", "Label", "Dropdown", "Input", "Keybind",
				"Paragraph", "Code", "Section", "Colorpicker", "Image", "ProgressBar", "Viewport",
				"Group", "HStack", "VStack"
			}
			for _, name in ipairs(ElementNames) do
				local original = ElementHandler[name]
				if original then
					ElementHandler[name] = function(self, ...)
						local before = {}
						for _, c in ipairs(Container:GetChildren()) do
							before[c] = true
						end
						local result = original(self, ...)
						local made = {}
						for _, c in ipairs(Container:GetChildren()) do
							if not before[c] then
								table.insert(made, c)
							end
						end
						result = Decorate(result, made, name)
						if OnAdd then
							OnAdd()
						end
						return result
					end
				end
			end

			return ElementHandler
		end

