			-- ===================== Slider (เมาส์ + สัมผัส) =====================
			function ElementHandler:Slider(a, b, c, d, e)
				local title, desc, min, max, default, step, cb, locked, flag
				if type(a) == "table" then
					local v = type(a.Value) == "table" and a.Value or {}
					title = a.Title
					desc = a.Desc
					min = v.Min or a.Min or 0
					max = v.Max or a.Max or 100
					default = v.Default or a.Default or (type(a.Value) == "number" and a.Value) or min
					step = a.Step or 1
					cb = a.Callback
					locked = a.Locked == true
					flag = a.Flag
				else
					title = a
					min = b or 0
					max = c or 100
					default = d or min
					step = 1
					cb = e
					locked = false
				end
				cb = cb or function() end
				if max <= min then
					max = min + 1
				end
				if step <= 0 then
					step = 1
				end

				local H = desc and 65 or 51
				local Row = MakeRow(Container, "Frame", H)
				Row.Name = "Slider"
				HoverRow(Row)
				local T, D = RowTitle(Row, title or "", desc, 80)
				T.Position = UDim2.new(0, 14, 0, 6)
				T.Size = UDim2.new(1, -94, 0, 18)
				SetLockedVisual(T, D, locked)

				local ValueBox = Instance.new("TextBox")
				ValueBox.Name = "Value"
				ValueBox.Parent = Row
				ValueBox.AnchorPoint = Vector2.new(1, 0)
				ValueBox.BackgroundColor3 = Theme.Off
				ValueBox.BorderSizePixel = 0
				ValueBox.Position = UDim2.new(1, -12, 0, 5)
				ValueBox.Size = UDim2.new(0, 56, 0, 20)
				ValueBox.Font = Enum.Font.Gotham
				ValueBox.TextColor3 = Theme.Text
				ValueBox.TextSize = 13
				ValueBox.ClearTextOnFocus = false
				ValueBox.TextEditable = not locked
				Corner(ValueBox, 4)

				local Track = Instance.new("Frame")
				Track.Name = "SlideFrame"
				Track.Parent = Row
				Track.BackgroundColor3 = Theme.Off
				Track.BorderSizePixel = 0
				Track.Position = UDim2.new(0, 14, 0, H - 12)
				Track.Size = UDim2.new(1, -28, 0, 3)
				Corner(Track, 2)

				local Fill = Instance.new("Frame")
				Fill.Name = "CurrentValueFrame"
				Fill.Parent = Track
				Fill.BackgroundColor3 = Theme.Text
				Fill.BorderSizePixel = 0
				Fill.Size = UDim2.new(0, 0, 1, 0)
				Corner(Fill, 2)

				local Knob = Instance.new("Frame")
				Knob.Name = "SlideCircle"
				Knob.Parent = Track
				Knob.AnchorPoint = Vector2.new(0.5, 0.5)
				Knob.BackgroundColor3 = Theme.Text
				Knob.BorderSizePixel = 0
				Knob.Position = UDim2.new(0, 0, 0.5, 0)
				Knob.Size = UDim2.new(0, 10, 0, 10)
				Corner(Knob, 5)

				-- พื้นที่สัมผัสโปร่งใส (นิ้วแตะง่าย)
				local Hit = Instance.new("TextButton")
				Hit.Name = "SliderHit"
				Hit.Parent = Row
				Hit.BackgroundTransparency = 1
				Hit.BorderSizePixel = 0
				Hit.Position = UDim2.new(0, 0, 0, H - 26)
				Hit.Size = UDim2.new(1, 0, 0, 26)
				Hit.ZIndex = 2
				Hit.AutoButtonColor = false
				Hit.Text = ""

				local function Snap(v)
					v = math.clamp(v, min, max)
					v = min + math.floor((v - min) / step + 0.5) * step
					v = math.clamp(v, min, max)
					return math.floor(v * 1000 + 0.5) / 1000
				end

				local value = Snap(default)

				local function Visual()
					local s = (value - min) / (max - min)
					Fill.Size = UDim2.new(s, 0, 1, 0)
					Knob.Position = UDim2.new(s, 0, 0.5, 0)
					ValueBox.Text = tostring(value)
				end
				Visual()

				local function Apply(v, fire, onlyIfChanged)
					v = Snap(v)
					local changed = v ~= value
					value = v
					Visual()
					if fire and (changed or not onlyIfChanged) then
						task.spawn(cb, value)
					end
				end

				local function Move(input)
					local s = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
					Apply(min + s * (max - min), true, true)
				end

				local dragging = false
				local dragInput = nil

				Hit.InputBegan:Connect(function(input)
					if locked then
						return
					end
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						dragging = true
						dragInput = input
						InputLock = true
						NewPages.ScrollingEnabled = false
						Move(input)
					end
				end)

				UserInputService.InputChanged:Connect(function(input)
					if not dragging then
						return
					end
					if (input.UserInputType == Enum.UserInputType.MouseMovement and dragInput.UserInputType == Enum.UserInputType.MouseButton1)
						or (input.UserInputType == Enum.UserInputType.Touch and input == dragInput) then
						Move(input)
					end
				end)

				UserInputService.InputEnded:Connect(function(input)
					if dragging and (input == dragInput
						or (input.UserInputType == Enum.UserInputType.MouseButton1 and dragInput.UserInputType == Enum.UserInputType.MouseButton1)) then
						dragging = false
						dragInput = nil
						InputLock = false
						NewPages.ScrollingEnabled = true
					end
				end)

				ValueBox.FocusLost:Connect(function()
					local n = tonumber(ValueBox.Text)
					if n then
						Apply(n, true)
					else
						Visual()
					end
				end)

				local obj = {Type = "Slider"}
				function obj:Set(v, silent)
					Apply(tonumber(v) or value, not silent)
				end
				function obj:Change(v) -- ชื่อเดิมของ Library (ยังใช้ได้)
					Apply(tonumber(v) or value, true)
				end
				function obj:Get()
					return value
				end
				function obj:Lock()
					locked = true
					ValueBox.TextEditable = false
					SetLockedVisual(T, D, true)
				end
				function obj:Unlock()
					locked = false
					ValueBox.TextEditable = true
					SetLockedVisual(T, D, false)
				end
				return RegisterFlag(flag, obj)
			end

