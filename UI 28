	end)()

	return {Close = dismiss}
end

-- ============================================================
--  Theme API   WindowTable:SetTheme("Midnight")
--  Themes: Dark (เดิม) / Midnight / Rose / Emerald / Amber / Mono  + AddTheme
-- ============================================================
function WindowTable:AddTheme(name, def)
	if type(name) ~= "string" or type(def) ~= "table" then
		return false
	end
	Themes[name] = BuildPalette(def, Themes.Dark)
	return true
end

function WindowTable:GetThemes()
	local list = {}
	for n in pairs(Themes) do
		table.insert(list, n)
	end
	table.sort(list)
	return list
end

function WindowTable:GetCurrentTheme()
	return CurrentTheme
end

function WindowTable:OnThemeChange(fn)
	table.insert(ThemeListeners, fn)
	return {
		Disconnect = function()
			for i, f in ipairs(ThemeListeners) do
				if f == fn then
					table.remove(ThemeListeners, i)
					break
				end
			end
		end
	}
end

function WindowTable:SetTheme(name)
	local pal = Themes[name]
	if not pal then
		return false
	end
	local map = {}
	for _, role in ipairs(ThemeRoles) do
		map[ColorKey(Theme[role])] = role
	end
	for gui in pairs(ThemeRoots) do
		if gui.Parent then
			for _, d in ipairs(gui:GetDescendants()) do
				RethemeInstance(d, map, pal)
			end
		else
			ThemeRoots[gui] = nil
		end
	end
	for _, role in ipairs(ThemeRoles) do
		Theme[role] = pal[role]
	end
	Theme.Muted = pal.On
	NotifyColors.Info = pal.Accent
	CurrentTheme = name
	for _, fn in ipairs(ThemeListeners) do
		task.spawn(fn, name, pal)
	end
	return true
end

