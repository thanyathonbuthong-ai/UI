local function ToColor(v)
	if typeof(v) == "Color3" then
		return v
	end
	if type(v) == "string" then
		local ok, c = pcall(Color3.fromHex, v)
		if ok then
			return c
		end
	end
	if type(v) == "table" then
		return Color3.fromRGB(v[1] or v.R or 0, v[2] or v.G or 0, v[3] or v.B or 0)
	end
	return nil
end

local function ColorKey(c)
	return math.floor(c.R * 255 + 0.5) * 65536 + math.floor(c.G * 255 + 0.5) * 256 + math.floor(c.B * 255 + 0.5)
end

local function KeyToColor(n)
	local r = math.floor(n / 65536)
	local g = math.floor((n - r * 65536) / 256)
	local b = n - r * 65536 - g * 256
	return Color3.fromRGB(r, g, b)
end

local function BuildPalette(def, base)
	local pal = {}
	local used = {[ColorKey(Color3.new(1, 1, 1))] = true, [0] = true}
	for _, role in ipairs(ThemeRoles) do
		local c = ToColor(def and def[role])
		if not c and role == "Glow" and pal.Window then
			c = Color3.fromRGB(
				math.floor(pal.Window.R * 255 + 0.5),
				math.min(255, math.floor(pal.Window.G * 255 + 0.5) + 2),
				math.floor(pal.Window.B * 255 + 0.5)
			)
		end
		c = c or (base and base[role]) or (Themes.Dark and Themes.Dark[role]) or Color3.fromRGB(128, 128, 128)
		local k = ColorKey(c)
		local guard = 0
		while used[k] and guard < 1000 do
			k = (k + 1) % 16777216
			guard = guard + 1
		end
		used[k] = true
		pal[role] = KeyToColor(k)
	end
	return pal
end

local function RGB(r, g, b)
	return Color3.fromRGB(r, g, b)
end

