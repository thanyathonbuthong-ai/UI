		make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }, box)

		make("TextLabel", {
			LayoutOrder = 1,
			Size = UDim2.new(1, 0, 0, 20),
			BackgroundTransparency = 1,
			Text = tostring(opts.Title or "Dialog"),
			TextSize = 15,
			TextColor3 = "text",
			TextXAlignment = Enum.TextXAlignment.Left,
			FontFace = FONT_BOLD,
		}, box)
		if opts.Content and opts.Content ~= "" then
			make("TextLabel", {
				LayoutOrder = 2,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				Text = tostring(opts.Content),
				TextSize = 12,
				TextColor3 = "muted",
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				FontFace = FONT,
			}, box)
		end

		local btnRow = make("Frame", {
			LayoutOrder = 3,
			Size = UDim2.new(1, 0, 0, 34),
			BackgroundTransparency = 1,
		}, box)
		make("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
		}, btnRow)

		local closed = false
		local handle = {}
		function handle:Close()
			if closed then
				return
			end
			closed = true
			tween(overlay, 0.2, { BackgroundTransparency = 1 })
			tween(box, 0.2, { GroupTransparency = 1, Position = UDim2.new(0.5, 0, 0.5, 10) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			tween(boxScale, 0.2, { Scale = 0.94 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			task.delay(0.22, function()
				overlay:Destroy()
			end)
		end

		local buttons = opts.Buttons
		if not buttons or #buttons == 0 then
			buttons = { { Title = "OK", Style = "Primary" } }
		end
		for i, b in ipairs(buttons) do
			local style = tostring(b.Style or (i == #buttons and "Primary" or "Default")):lower()
			local bg = style == "primary" and "accent" or (style == "danger" and "error" or "input")
			local fg = (style == "primary" or style == "danger") and Color3.fromRGB(255, 255, 255) or C.text
			local btn = make("TextButton", {
				LayoutOrder = i,
				AutomaticSize = Enum.AutomaticSize.X,
				Size = UDim2.new(0, 0, 0, 32),
				BackgroundColor3 = bg,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = tostring(b.Title or ("Button " .. i)),
				TextSize = 12,
				TextColor3 = fg,
				FontFace = FONT_BOLD,
			}, btnRow)
			make("UIPadding", { PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16) }, btn)
			round(btn, 8, style == "default" and "stroke" or nil)
			btn.MouseEnter:Connect(function()
				tween(btn, 0.12, { BackgroundTransparency = 0.12 })
			end)
			btn.MouseLeave:Connect(function()
				tween(btn, 0.12, { BackgroundTransparency = 0 })
			end)
			btn.MouseButton1Click:Connect(function()
				if b.Callback then
					task.spawn(b.Callback)
				end
				if not b.KeepOpen then
					handle:Close()
				end
			end)
		end

		overlay.MouseButton1Click:Connect(function()
			if opts.Dismissable ~= false and #buttons <= 1 then
				handle:Close()
			end
		end)

		tween(overlay, 0.25, { BackgroundTransparency = 0.45 })
		tween(box, 0.3, { GroupTransparency = 0, Position = UDim2.new(0.5, 0, 0.5, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		tween(boxScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		return handle
	end

	-- ===== Tooltip (ข้อความลอยตอนเมาส์ชี้) =====
	-- ใช้ผ่านตัวเลือก Tooltip = "ข้อความ" ในองค์ประกอบไหนก็ได้ หรือ api:SetTooltip("...")
	local tipEntries = {}
	do
		local tipLabel = make("TextLabel", {
			Name = "Tooltip",
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 0, 0, 24),
			BackgroundColor3 = "card",
			BorderSizePixel = 0,
			Text = "",
			TextSize = 11,
			TextColor3 = "text",
			Visible = false,
			ZIndex = 300,
			FontFace = FONT,
		}, main)
		make("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, tipLabel)
		round(tipLabel, 6, "stroke")

		local hovered, token, lastPos = nil, 0, Vector2.new()
		local function fullyShown(gui)
			local p = gui
			while p and p ~= main do
				if p:IsA("GuiObject") and not p.Visible then
					return false
				end
				p = p.Parent
			end
			return p == main and main.Visible
		end
		local function place()
			local s = math.max(uiScale.Scale, 0.01)
			local rel = (lastPos - main.AbsolutePosition) / s
			local w = tipLabel.AbsoluteSize.X / s
			local maxX = main.AbsoluteSize.X / s - w - 6
			tipLabel.Position = UDim2.new(0, math.clamp(rel.X + 14, 6, math.max(maxX, 6)), 0, rel.Y + 18)
		end
		UserInputService.InputChanged:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseMovement then
				return
			end
			lastPos = Vector2.new(input.Position.X, input.Position.Y)
			local found
			for card in pairs(tipEntries) do
				if card.Parent == nil then
					tipEntries[card] = nil
				elseif fullyShown(card) then
					local p, s = card.AbsolutePosition, card.AbsoluteSize
					if lastPos.X >= p.X and lastPos.X <= p.X + s.X and lastPos.Y >= p.Y and lastPos.Y <= p.Y + s.Y then
						found = card
						break
					end
				end
			end
			if found ~= hovered then
				hovered = found
				token += 1
				tipLabel.Visible = false
				if found then
					local mine = token
					task.delay(0.4, function()
						if mine == token and hovered == found and tipEntries[found] then
							tipLabel.Text = tostring(tipEntries[found]())
							place()
							tipLabel.Visible = true
						end
					end)
				end
			elseif tipLabel.Visible then
				place()
			end
		end)
	end
	function Window._tip(card, getter)
		tipEntries[card] = getter
	end

