				r:Destroy()
			end)
		end

		tween(minimizeIconBar, 0.3, { Rotation = v and 90 or 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

		local targetH = v and HEADER_H or FINAL_H

