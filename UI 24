		-- ----- RadioGroup: เลือกได้ 1 ตัวจากหลายตัว (แสดงเป็นรายการวงกลม) -----
		function Tab:AddRadioGroup(opts)
			opts = opts or {}
			local options = opts.Options or {}
			local value = opts.Default
			local titleH = (opts.Title and opts.Title ~= "") and 26 or 6
			local rowH = 28
			local card = row(titleH + #options * rowH + 6)
			if titleH > 6 then
				local t = text(card, tostring(opts.Title), 14, 6, 300, 16, 13, "text")
				t.FontFace = FONT_BOLD
			end

			local items = {}
			local api = {}
			local function render(animate)
				for name, it in pairs(items) do
					local on = name == value
					setRole(it.ring, "BackgroundColor3", on and "accent" or "input")
					if animate then
						tween(it.ring, 0.15, { BackgroundColor3 = on and C.accent or C.input })
						tween(it.dot, 0.2, { Size = on and UDim2.new(0, 8, 0, 8) or UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
					else
						it.dot.Size = on and UDim2.new(0, 8, 0, 8) or UDim2.new(0, 0, 0, 0)
					end
				end
			end

			for i, name in ipairs(options) do
				name = tostring(name)
				local y = titleH + (i - 1) * rowH
				local line = make("TextButton", {
					Position = UDim2.new(0, 0, 0, y),
					Size = UDim2.new(1, 0, 0, rowH),
					BackgroundTransparency = 1,
					Text = "",
					AutoButtonColor = false,
				}, card)
				local ringF = make("Frame", {
					AnchorPoint = Vector2.new(0, 0.5),
					Position = UDim2.new(0, 14, 0.5, 0),
					Size = UDim2.new(0, 18, 0, 18),
					BackgroundColor3 = "input",
					BorderSizePixel = 0,
				}, line)
				make("UICorner", { CornerRadius = UDim.new(1, 0) }, ringF)
				make("UIStroke", { Thickness = 1, Color = "stroke", ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, ringF)
				local dot = make("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.new(0.5, 0, 0.5, 0),
					Size = UDim2.new(0, 0, 0, 0),
					BackgroundColor3 = Color3.fromRGB(255, 255, 255),
					BorderSizePixel = 0,
				}, ringF)
				make("UICorner", { CornerRadius = UDim.new(1, 0) }, dot)
				text(line, name, 40, 0, 300, rowH, 12, "text")
				items[name] = { ring = ringF, dot = dot }
				line.MouseButton1Click:Connect(function()
					api:Set(name)
				end)
			end

			function api:Set(v, silent)
				v = tostring(v)
				if not items[v] then
					return
				end
				value = v
				render(true)
				if not silent and opts.Callback then
					task.spawn(opts.Callback, value)
				end
			end
			function api:Get()
				return value
			end
			render(false)
			registerFlag(opts, api)
			return api
		end

		-- ----- Segmented: แถบสลับตัวเลือกแบบแท็บ (pill เลื่อนตามตัวที่เลือก) -----
		function Tab:AddSegmented(opts)
			opts = opts or {}
			local options = opts.Options or {}
			local count = math.max(#options, 1)
			local hasTitle = opts.Title and opts.Title ~= ""
			local card = row(hasTitle and 66 or 46)
			if hasTitle then
				text(card, tostring(opts.Title), 14, 8, 300, 14, 11, "muted")
			end
			local track = make("Frame", {
				Position = UDim2.new(0, 14, 0, hasTitle and 26 or 8),
				Size = UDim2.new(1, -28, 0, 30),
				BackgroundColor3 = "input",
				BorderSizePixel = 0,
			}, card)
			round(track, 8, "stroke")
			local pill = make("Frame", {
				Position = UDim2.new(0, 3, 0, 3),
				Size = UDim2.new(1 / count, -6, 1, -6),
				BackgroundColor3 = "accent",
				BorderSizePixel = 0,
			}, track)
			round(pill, 6)

			local value = opts.Default or options[1]
			local labels = {}
			local api = {}
			local function indexOf(v)
				for i, o in ipairs(options) do
					if tostring(o) == tostring(v) then
						return i
					end
				end
				return 1
			end
			local function render(animate)
				local idx = indexOf(value)
				local pos = UDim2.new((idx - 1) / count, 3, 0, 3)
				if animate then
					tween(pill, 0.25, { Position = pos }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
				else
					pill.Position = pos
				end
				for i, lbl in ipairs(labels) do
					local on = i == idx
					if animate then
						tween(lbl, 0.2, { TextColor3 = on and Color3.fromRGB(255, 255, 255) or C.muted })
					else
						lbl.TextColor3 = on and Color3.fromRGB(255, 255, 255) or C.muted
					end
				end
			end
			for i, o in ipairs(options) do
				local b = make("TextButton", {
					Position = UDim2.new((i - 1) / count, 0, 0, 0),
					Size = UDim2.new(1 / count, 0, 1, 0),
					BackgroundTransparency = 1,
					Text = tostring(o),
					TextSize = 12,
					TextColor3 = C.muted,
					FontFace = FONT,
					AutoButtonColor = false,
					ZIndex = 3,
				}, track)
				labels[i] = b
				b.MouseButton1Click:Connect(function()
					api:Set(o)
				end)
			end
			function api:Set(v, silent)
				value = options[indexOf(v)]
				render(true)
				if not silent and opts.Callback then
					task.spawn(opts.Callback, value)
				end
			end
			function api:Get()
				return value
			end
			render(false)
			registerFlag(opts, api)
			return api
		end

		-- ----- Stepper: ตัวเลข +/- (กดค้างเพื่อเพิ่มเร็ว) -----
		function Tab:AddStepper(opts)
			opts = opts or {}
			local min = tonumber(opts.Min) or -math.huge
			local max = tonumber(opts.Max) or math.huge
			local step = tonumber(opts.Step) or 1
			local value = math.clamp(tonumber(opts.Default) or (min ~= -math.huge and min or 0), min, max)
			local card = row(38)
			text(card, tostring(opts.Title or "Stepper"), 14, 0, 200, 38, 13, "text")

			local function stepBtn(label, xOff)
				local b = make("TextButton", {
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, xOff, 0.5, 0),
					Size = UDim2.new(0, 26, 0, 26),
					BackgroundColor3 = "input",
					BorderSizePixel = 0,
					AutoButtonColor = false,
					Text = label,
					TextSize = 16,
					TextColor3 = C.text,
					FontFace = FONT_BOLD,
				}, card)
				round(b, 7, "stroke")
				b.MouseEnter:Connect(function()
					tween(b, 0.12, { BackgroundColor3 = C.accent })
				end)
				b.MouseLeave:Connect(function()
					tween(b, 0.12, { BackgroundColor3 = C.input })
				end)
				return b
			end
			local plus = stepBtn("+", -12)
			local valueBox = make("TextBox", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -42, 0.5, 0),
				Size = UDim2.new(0, 56, 0, 26),
				BackgroundTransparency = 1,
				Text = tostring(value),
				TextSize = 13,
				TextColor3 = C.text,
				ClearTextOnFocus = false,
				FontFace = FONT,
			}, card)
			local minus = stepBtn("-", -102)

			local api = {}
			local function fmt(v)
				return tostring(math.floor(v * 1000 + 0.5) / 1000)
			end
			function api:Set(v, silent)
				v = tonumber(v)
				if not v then
					valueBox.Text = fmt(value)
					return
				end
				value = math.clamp(v, min, max)
				valueBox.Text = fmt(value)
				if not silent and opts.Callback then
					task.spawn(opts.Callback, value)
				end
			end
			function api:Get()
				return value
			end
			local function holdRepeat(btn, dir)
				btn.MouseButton1Down:Connect(function()
					api:Set(value + step * dir)
					local held = true
					local upConn
					upConn = btn.MouseButton1Up:Connect(function()
						held = false
						upConn:Disconnect()
					end)
					btn.MouseLeave:Once(function()
						held = false
					end)
					task.delay(0.4, function()
						while held do
							api:Set(value + step * dir)
							task.wait(0.06)
						end
					end)
				end)
			end
			holdRepeat(plus, 1)
			holdRepeat(minus, -1)
			valueBox.FocusLost:Connect(function()
				api:Set(valueBox.Text)
			end)
			registerFlag(opts, api)
			return api
		end

