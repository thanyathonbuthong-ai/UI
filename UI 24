	local themeOptLabels = {}
	local function colorLuminance(c)
		return 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
	end
	-- nudges a theme's accent color away from the list's current background
	-- so pale/dark accents never blend into the (equally pale/dark) bg
	local function legibleAccent(color, bgLum)
		local diff = math.abs(colorLuminance(color) - bgLum)
		local MIN_DIFF = 0.4
		if diff >= MIN_DIFF then
			return color
		end
		local target = (bgLum < 0.5) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(0, 0, 0)
		local t = math.clamp((MIN_DIFF - diff) / MIN_DIFF, 0, 1) * 0.85
		return color:Lerp(target, t)
	end
	local function refreshThemeHighlight()
		local bgLum = colorLuminance(C.card)
		for _, entry in ipairs(themeOptLabels) do
			local selected = entry.name == THEME_ORDER[themeIndex]
			local shown = legibleAccent(entry.accent, bgLum)
			entry.label.TextColor3 = shown
			entry.label.TextTransparency = 0
			entry.dot.BackgroundColor3 = shown
			entry.dot.BackgroundTransparency = 0
			entry.dot.Size = selected and UDim2.new(0, 9, 0, 9) or UDim2.new(0, 7, 0, 7)
			entry.opt.BackgroundColor3 = shown
			entry.opt.BackgroundTransparency = selected and 0.88 or 1
		end
	end

	for i, themeName in ipairs(THEME_ORDER) do
		local themeAccent = (THEMES[themeName] and THEMES[themeName].accent) or C.accent
		local opt = make("TextButton", {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 28),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 1002,
		}, themeList)
		local optDot = make("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 10, 0.5, 0),
			Size = UDim2.new(0, 7, 0, 7),
			BackgroundColor3 = themeAccent,
			BorderSizePixel = 0,
			ZIndex = 1003,
		}, opt)
		make("UICorner", { CornerRadius = UDim.new(1, 0) }, optDot)
		-- name is shown in that theme's own accent color (auto-adjusted for
		-- contrast against the list's current background), regardless of
		-- which theme is currently active, so the list previews each color
		local optLabel = text(opt, themeName, 26, 0, 104, 28, 12, "text")
		optLabel.ZIndex = 1003
		optLabel.TextColor3 = themeAccent
		unbind(optLabel, "TextColor3")
		opt.MouseEnter:Connect(function()
			tween(opt, 0.1, { BackgroundTransparency = 0.6, BackgroundColor3 = C.btn2 })
		end)
		opt.MouseLeave:Connect(function()
			local selected = THEME_ORDER[themeIndex] == themeName
			local resting = selected and 0.88 or 1
			local restingColor = selected and optDot.BackgroundColor3 or C.btn2
			tween(opt, 0.1, { BackgroundTransparency = resting, BackgroundColor3 = restingColor })
		end)
		opt.MouseButton1Click:Connect(function()
			setThemeOpen(false)
			if THEME_ORDER[themeIndex] ~= themeName then
				applyTheme(themeName, THEME_ANIM_TIME)
				updateThemeGemColors(THEME_ANIM_TIME)
				themeIndex = table.find(THEME_ORDER, themeName) or themeIndex
				task.delay(THEME_ANIM_TIME + 0.05, function()
					notifs.notify("Theme: " .. themeName, "Theme applied.", "info", "moon")
				end)
			end
			refreshThemeHighlight()
		end)
		themeOptLabels[#themeOptLabels + 1] = { label = optLabel, dot = optDot, opt = opt, accent = themeAccent, name = themeName }
	end
	refreshThemeHighlight()

	local themeIconRotation = 0
