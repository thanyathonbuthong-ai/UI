		-- ปุ่ม Primary ที่โชว์วงหมุน (spinner) ระหว่างรอ Callback ทำงาน กันผู้ใช้กดซ้ำ
		-- เหมาะกับงานที่ใช้เวลา เช่น เรียก HttpGet/ยิง request ก่อนได้ผลลัพธ์
		-- Variant เหมือน AddFilledButton: "Primary" | "Danger" | "Success" | "Warning"
		function Tab:AddLoadingButton(opts)
			opts = opts or {}
			local roleMap = { Primary = "accent", Danger = "error", Success = "success", Warning = "warn" }
			local role = roleMap[opts.Variant] or "accent"

			local card = row(38)
			setRole(card, "BackgroundColor3", role)

			local titleLabel = text(card, tostring(opts.Title or "Button"), 14, 0, 260, 38, 13, "text")
			titleLabel.FontFace = FONT_BOLD
			unbind(titleLabel, "TextColor3")
			titleLabel.TextColor3 = WHITE

			local spinner, spinnerStroke = ring(card, 16, 2, "text", 0.25)
			spinner.Visible = false
			comet(spinnerStroke)

			local function lighten(c, amt)
				return Color3.new(math.min(c.R + amt, 1), math.min(c.G + amt, 1), math.min(c.B + amt, 1))
			end

			local running = false
			local spinConn
			local btnHit = make("TextButton", {
				Size = UDim2.new(1, 0, 1, 0),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = "",
			}, card)
			btnHit.MouseEnter:Connect(function()
				if not running then
					tween(card, 0.15, { BackgroundColor3 = lighten(C[role], 0.08) })
				end
			end)
			btnHit.MouseLeave:Connect(function()
				if not running then
					tween(card, 0.15, { BackgroundColor3 = C[role] })
				end
			end)
			pressFeel(btnHit, card)
			btnHit.MouseButton1Click:Connect(function()
				if running or not opts.Callback then
					return
				end
				running = true
				titleLabel.Visible = false
				spinner.Visible = true
				spinConn = RunService.Heartbeat:Connect(function(dt)
					spinner.Rotation = (spinner.Rotation + dt * 360) % 360
				end)
				task.spawn(function()
					local ok, err = pcall(opts.Callback)
					if not ok then
						warn("[Ophyn] AddLoadingButton callback error: " .. tostring(err))
					end
					running = false
					if spinConn then
						spinConn:Disconnect()
						spinConn = nil
					end
					spinner.Visible = false
					titleLabel.Visible = true
				end)
			end)
			return { Instance = card }
		end

		-- ปุ่มคัดลอก (Copy) กดแล้ว copy ข้อความ/ลิงก์เข้าคลิปบอร์ด ไอคอนขวาสลับเป็นติ๊กถูกชั่วคราว
		-- opts.Title (ป้ายอธิบาย), opts.Value (ข้อความที่จะ copy, หรือ function() return text end)
		-- opts.Icon (ไอคอนซ้าย, ถ้าไม่ใส่จะไม่โชว์), opts.Callback(text, success)
		function Tab:AddCopyButton(opts)
			opts = opts or {}
			local card = row(38)
			card.BackgroundTransparency = 0

			if opts.Title then
				text(card, tostring(opts.Title), 14, 0, 220, 38, 13, "text")
			end

			local iconBtn = make("Frame", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -8, 0.5, 0),
				Size = UDim2.new(0, 28, 0, 28),
				BackgroundColor3 = "btn2",
				BorderSizePixel = 0,
			}, card)
			round(iconBtn, 7, "stroke")

			local normalIcon
			if opts.Icon then
				normalIcon = make("ImageLabel", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.new(0.5, 0, 0.5, 0),
					Size = UDim2.new(0, 16, 0, 16),
					BackgroundTransparency = 1,
					Image = assetId(opts.Icon),
					ImageColor3 = "text",
				}, iconBtn)
			end
			-- "✓" ไว้โชว์ตอน copy สำเร็จ แทนไอคอนปกติชั่วคราว
			local check = text(iconBtn, "\226\156\147", 0, 0, 0, 0, 14, "success", Enum.TextXAlignment.Center)
			check.Size = UDim2.new(1, 0, 1, 0)
			check.FontFace = FONT_BOLD
			check.Visible = false

			local hit = make("TextButton", {
				Size = UDim2.new(1, 0, 1, 0),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = "",
			}, iconBtn)
			hit.MouseEnter:Connect(function()
				tween(iconBtn, 0.15, { BackgroundColor3 = C.btn2Hover })
			end)
			hit.MouseLeave:Connect(function()
				tween(iconBtn, 0.15, { BackgroundColor3 = C.btn2 })
			end)
			pressFeel(hit, iconBtn)

			local busy = false
			hit.MouseButton1Click:Connect(function()
				if busy then
					return
				end
				local raw = opts.Value or opts.Text or ""
				local str = tostring(type(raw) == "function" and raw() or raw)
				local ok = pcall(function()
					if setclipboard then
						setclipboard(str)
					elseif toclipboard then
						toclipboard(str)
					end
				end)

				busy = true
				if normalIcon then
					normalIcon.Visible = false
				end
				check.Visible = true
				task.delay(1, function()
					check.Visible = false
					if normalIcon then
						normalIcon.Visible = true
					end
					busy = false
				end)

				if Window.Notify then
					Window:Notify({ Title = ok and "Copied" or "Copy Failed", Content = str, Type = ok and "success" or "error" })
				end
				if opts.Callback then
					task.spawn(opts.Callback, str, ok)
				end
			end)
			return { Instance = card }
		end

		-- ปุ่มต้องกดค้าง (Hold to Confirm) ไว้กัน action อันตรายที่กดโดนโดยไม่ตั้งใจ
		-- opts.Title, opts.HoldTime (วินาที, ค่าเริ่มต้น 0.6), opts.Variant = "Danger"(ค่าเริ่มต้น)|"Primary"|"Success"|"Warning"
		function Tab:AddConfirmButton(opts)
			opts = opts or {}
			local roleMap = { Primary = "accent", Danger = "error", Success = "success", Warning = "warn" }
			local role = roleMap[opts.Variant] or "error"
			local holdTime = tonumber(opts.HoldTime) or 0.6

			local card = row(38)
			card.BackgroundTransparency = 0

			local fill = make("Frame", {
				Size = UDim2.new(0, 0, 1, 0),
				BackgroundColor3 = role,
				BackgroundTransparency = 0.3,
				BorderSizePixel = 0,
				ZIndex = 1,
			}, card)
			round(fill, 8)

			local titleLabel = text(card, tostring(opts.Title or "Hold to confirm"), 14, 0, 260, 38, 13, "text")
			titleLabel.FontFace = FONT_BOLD
			titleLabel.ZIndex = 2

			local hit = make("TextButton", {
				Size = UDim2.new(1, 0, 1, 0),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = "",
				ZIndex = 3,
			}, card)
			pressFeel(hit, card)

			local holding = false
			local conn
			local function cancel()
				if not holding then
					return
				end
				holding = false
				if conn then
					conn:Disconnect()
					conn = nil
				end
				tween(fill, 0.15, { Size = UDim2.new(0, 0, 1, 0) })
			end

			hit.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					holding = true
					local startT = tick()
					conn = RunService.Heartbeat:Connect(function()
						if not holding then
							return
						end
						local a = math.clamp((tick() - startT) / holdTime, 0, 1)
						fill.Size = UDim2.new(a, 0, 1, 0)
						if a >= 1 then
							holding = false
							if conn then
								conn:Disconnect()
								conn = nil
							end
							fill.Size = UDim2.new(0, 0, 1, 0)
							if opts.Callback then
								task.spawn(opts.Callback)
							end
						end
					end)
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					cancel()
				end
			end)
			return { Instance = card }
		end

