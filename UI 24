				TextColor3 = "text",
				TextSize = 12,
				FontFace = FONT,
				ClearTextOnFocus = false,
				ZIndex = 1003,
			}, hexHolder)

			local function refresh()
				color = Color3.fromHSV(hue, sat, val)
				swatchBtn.BackgroundColor3 = color
				svBox.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
				svCursor.Position = UDim2.new(sat, 0, 1 - val, 0)
				hueCursor.Position = UDim2.new(hue, 0, 0.5, 0)
				hexInput.Text = color3ToHex(color)
			end

			local function fire()
				if opts.Callback then
					task.spawn(opts.Callback, color)
				end
			end

			local draggingSV, draggingHue = false, false
			local function setFromSV(pos)
				local abs, size = svBox.AbsolutePosition, svBox.AbsoluteSize
				sat = math.clamp((pos.X - abs.X) / math.max(size.X, 1), 0, 1)
				val = 1 - math.clamp((pos.Y - abs.Y) / math.max(size.Y, 1), 0, 1)
				refresh()
				fire()
			end
			local function setFromHue(pos)
				local abs, size = hueBar.AbsolutePosition, hueBar.AbsoluteSize
				hue = math.clamp((pos.X - abs.X) / math.max(size.X, 1), 0, 1)
				refresh()
				fire()
			end

			svBox.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					draggingSV = true
					setFromSV(input.Position)
				end
			end)
			hueBar.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					draggingHue = true
					setFromHue(input.Position)
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
					if draggingSV then
						setFromSV(input.Position)
					elseif draggingHue then
						setFromHue(input.Position)
					end
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					draggingSV = false
					draggingHue = false
				end
			end)
			hexInput.FocusLost:Connect(function()
				local c = hexToColor3(hexInput.Text)
				if c then
					hue, sat, val = Color3.toHSV(c)
					refresh()
					fire()
				else
					hexInput.Text = color3ToHex(color)
				end
			end)

			local open = false
			local heartbeatConn = nil
			local function isSwatchVisibleInPage()
				local pagePos, pageSize = page.AbsolutePosition, page.AbsoluteSize
				local btnPos, btnSize = swatchBtn.AbsolutePosition, swatchBtn.AbsoluteSize
				local cy = btnPos.Y + btnSize.Y / 2
				return cy >= pagePos.Y and cy <= (pagePos.Y + pageSize.Y)
			end
			local function positionPanel()
				local scale = uiScale.Scale
				if not scale or scale <= 0 then
					scale = 1
				end
				local basePos = dropdownOverlay.AbsolutePosition
				local btnPos, btnSize = swatchBtn.AbsolutePosition, swatchBtn.AbsoluteSize
				local x = (btnPos.X - basePos.X) / scale
				local y = (btnPos.Y - basePos.Y) / scale
				local h = btnSize.Y / scale
				x = x - (PANEL_W - btnSize.X / scale)
				panel.Position = UDim2.new(0, x, 0, y + h + 4)
			end
			local function setOpen(v)
				open = v
				panel.Visible = v
				if v then
					positionPanel()
					if heartbeatConn then
						heartbeatConn:Disconnect()
					end
					heartbeatConn = RunService.Heartbeat:Connect(function()
						if not open then
							return
						end
						if not page.Visible or not isSwatchVisibleInPage() then
							setOpen(false)
							return
						end
						positionPanel()
					end)
				elseif heartbeatConn then
					heartbeatConn:Disconnect()
					heartbeatConn = nil
				end
			end
			openDropdowns[#openDropdowns + 1] = function()
				setOpen(false)
			end
			swatchBtn.MouseButton1Click:Connect(function()
				setOpen(not open)
			end)

			local api = {}
			function api:Set(c, silent)
				hue, sat, val = Color3.toHSV(c)
				refresh()
				if not silent then
					fire()
				end
			end
			function api:Get()
				return color
			end
			if opts.Flag then
				-- Color3 can't be JSON-encoded for configs, so store/restore it as a hex string
				Window._registry[opts.Flag] = {
					get = function()
						return color3ToHex(color)
					end,
					set = function(hex)
						local c = hexToColor3(hex)
						if c then
							api:Set(c, true)
						end
					end,
				}
				Window.Flags[opts.Flag] = api
			end
			return api
		end

