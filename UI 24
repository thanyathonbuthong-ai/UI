		-- ปุ่มรีเจอยน/สลับเซิร์ฟเวอร์ (Rejoin/Server-Hop) ใช้ TeleportService มาตรฐานของ Roblox
		-- ถ้าใส่ opts.Callback มาเอง จะเรียก Callback แทนพฤติกรรม default ทั้งหมด (ไว้ให้ custom logic เอง)
		-- opts.Title, opts.Mode = "rejoin"(ค่าเริ่มต้น, เข้าเซิร์ฟเดิม) | "hop" (หาเซิร์ฟเวอร์อื่นแบบสุ่ม), opts.Variant, opts.Callback
		function Tab:AddRejoinButton(opts)
			opts = opts or {}
			local roleMap = { Primary = "accent", Danger = "error", Success = "success", Warning = "warn" }
			local role = roleMap[opts.Variant] or "warn"
			local mode = (opts.Mode == "hop") and "hop" or "rejoin"

			local card = row(38)
			setRole(card, "BackgroundColor3", role)

			local titleLabel =
				text(card, tostring(opts.Title or (mode == "hop" and "Server Hop" or "Rejoin")), 14, 0, 260, 38, 13, "text")
			titleLabel.FontFace = FONT_BOLD
			unbind(titleLabel, "TextColor3")
			titleLabel.TextColor3 = WHITE

			local function lighten(c, amt)
				return Color3.new(math.min(c.R + amt, 1), math.min(c.G + amt, 1), math.min(c.B + amt, 1))
			end

			-- default: กลับเซิร์ฟเดิม
			local function doRejoin()
				pcall(function()
					game:GetService("TeleportService"):Teleport(game.PlaceId, player)
				end)
			end

			-- default: สุ่มเซิร์ฟเวอร์อื่นที่ไม่ใช่เซิร์ฟปัจจุบัน ผ่าน public server list API ของ Roblox
			local function doServerHop()
				local TeleportService = game:GetService("TeleportService")
				local target
				local ok, body = pcall(function()
					return HttpService:GetAsync(
						("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(game.PlaceId)
					)
				end)
				if ok then
					local decodeOk, data = pcall(function()
						return HttpService:JSONDecode(body)
					end)
					if decodeOk and data and data.data then
						local candidates = {}
						for _, srv in ipairs(data.data) do
							if srv.id ~= game.JobId and (srv.playing or 0) < (srv.maxPlayers or math.huge) then
								candidates[#candidates + 1] = srv.id
							end
						end
						if #candidates > 0 then
							target = candidates[math.random(1, #candidates)]
						end
					end
				end
				local teleOk = pcall(function()
					if target then
						TeleportService:TeleportToPlaceInstance(game.PlaceId, target, player)
					else
						TeleportService:Teleport(game.PlaceId, player)
					end
				end)
				if not teleOk and Window.Notify then
					Window:Notify({ Title = "Server Hop Failed", Content = "ลองใหม่อีกครั้ง", Type = "error" })
				end
			end

			local hit = make("TextButton", {
				Size = UDim2.new(1, 0, 1, 0),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = "",
			}, card)
			hit.MouseEnter:Connect(function()
				tween(card, 0.15, { BackgroundColor3 = lighten(C[role], 0.08) })
			end)
			hit.MouseLeave:Connect(function()
				tween(card, 0.15, { BackgroundColor3 = C[role] })
			end)
			pressFeel(hit, card)
			hit.MouseButton1Click:Connect(function()
				if opts.Callback then
					task.spawn(opts.Callback)
				elseif mode == "hop" then
					task.spawn(doServerHop)
				else
					task.spawn(doRejoin)
				end
			end)
			return { Instance = card }
		end

