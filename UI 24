		-- ----- DatePicker: ปฏิทินเลือกวันที่ (Default = "YYYY-MM-DD") -----
		function Tab:AddDatePicker(opts)
			opts = opts or {}
			local MONTHS = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" }
			local DAYS = { "Su", "Mo", "Tu", "We", "Th", "Fr", "Sa" }
			local function isLeap(y)
				return (y % 4 == 0 and y % 100 ~= 0) or y % 400 == 0
			end
			local function daysIn(y, m)
				return ({ 31, isLeap(y) and 29 or 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 })[m]
			end
			local function dow(y, m, d)
				local t = { 0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4 }
				if m < 3 then
					y -= 1
				end
				return (y + y // 4 - y // 100 + y // 400 + t[m] + d) % 7
			end
			local today = { year = 2025, month = 1, day = 1 }
			pcall(function()
				local t = os.date("*t")
				today = { year = t.year, month = t.month, day = t.day }
			end)
			local function parse(v)
				if type(v) == "string" then
					local y, m, d = v:match("^(%d+)-(%d+)-(%d+)$")
					if y then
						return { year = tonumber(y), month = math.clamp(tonumber(m), 1, 12), day = tonumber(d) }
					end
				elseif type(v) == "table" then
					return { year = tonumber(v[1]) or today.year, month = math.clamp(tonumber(v[2]) or 1, 1, 12), day = tonumber(v[3]) or 1 }
				end
			end
			local sel = parse(opts.Default) or { year = today.year, month = today.month, day = today.day }
			sel.day = math.clamp(sel.day, 1, daysIn(sel.year, sel.month))
			local vy, vm = sel.year, sel.month

			local card = row(258)
			text(card, tostring(opts.Title or "Date"), 14, 8, 200, 14, 11, "muted")
			local selLabel = text(card, "", 0, 8, 120, 14, 11, "accent", Enum.TextXAlignment.Right)
			selLabel.Position = UDim2.new(1, -134, 0, 8)

			local function navBtn(label, xScaleAnchor)
				local b = make("TextButton", {
					AnchorPoint = Vector2.new(xScaleAnchor, 0),
					Position = UDim2.new(xScaleAnchor, xScaleAnchor == 0 and 14 or -14, 0, 28),
					Size = UDim2.new(0, 28, 0, 26),
					BackgroundColor3 = "input",
					BorderSizePixel = 0,
					AutoButtonColor = false,
					Text = label,
					TextSize = 16,
					TextColor3 = C.text,
					FontFace = FONT_BOLD,
				}, card)
				round(b, 7, "stroke")
				return b
			end
			local prev, nextB = navBtn("‹", 0), navBtn("›", 1)
			local monthLbl = text(card, "", 0, 28, 0, 26, 13, "text", Enum.TextXAlignment.Center)
			monthLbl.Position = UDim2.new(0, 48, 0, 28)
			monthLbl.Size = UDim2.new(1, -96, 0, 26)
			monthLbl.FontFace = FONT_BOLD

			local head = make("Frame", {
				Position = UDim2.new(0, 14, 0, 60),
				Size = UDim2.new(1, -28, 0, 18),
				BackgroundTransparency = 1,
			}, card)
			for i, d in ipairs(DAYS) do
				local l = text(head, d, 0, 0, 0, 18, 11, "muted", Enum.TextXAlignment.Center)
				l.Position = UDim2.new((i - 1) / 7, 0, 0, 0)
				l.Size = UDim2.new(1 / 7, 0, 1, 0)
			end
			local grid = make("Frame", {
				Position = UDim2.new(0, 14, 0, 80),
				Size = UDim2.new(1, -28, 0, 168),
				BackgroundTransparency = 1,
			}, card)
			local cells = {}
			local api = {}
			local function fire()
				if opts.Callback then
					task.spawn(opts.Callback, sel.year, sel.month, sel.day, api:Get())
				end
			end
			for i = 1, 42 do
				local r, c = (i - 1) // 7, (i - 1) % 7
				local b = make("TextButton", {
					Position = UDim2.new(c / 7, 1, 0, r * 28 + 1),
					Size = UDim2.new(1 / 7, -2, 0, 26),
					BackgroundColor3 = "accent",
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					AutoButtonColor = false,
					Text = "",
					TextSize = 12,
					TextColor3 = C.text,
					FontFace = FONT,
				}, grid)
				round(b, 6)
				local stroke = make("UIStroke", { Thickness = 1, Color = "accent", Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, b)
				cells[i] = { btn = b, stroke = stroke, day = nil }
				b.MouseButton1Click:Connect(function()
					local cell = cells[i]
					if cell.day then
						sel = { year = vy, month = vm, day = cell.day }
						api:_render()
						fire()
					end
				end)
			end
			function api:_render()
				monthLbl.Text = MONTHS[vm] .. " " .. vy
				selLabel.Text = api:Get()
				local first = dow(vy, vm, 1)
				local total = daysIn(vy, vm)
				for i, cell in ipairs(cells) do
					local d = i - first
					if d >= 1 and d <= total then
						cell.day = d
						cell.btn.Text = tostring(d)
						cell.btn.Visible = true
						local isSel = sel.year == vy and sel.month == vm and sel.day == d
						local isToday = today.year == vy and today.month == vm and today.day == d
						cell.btn.BackgroundTransparency = isSel and 0 or 1
						cell.btn.TextColor3 = isSel and Color3.fromRGB(255, 255, 255) or C.text
						cell.stroke.Transparency = (isToday and not isSel) and 0.2 or 1
					else
						cell.day = nil
						cell.btn.Text = ""
						cell.btn.Visible = false
					end
				end
			end
			prev.MouseButton1Click:Connect(function()
				vm -= 1
				if vm < 1 then
					vm, vy = 12, vy - 1
				end
				api:_render()
			end)
			nextB.MouseButton1Click:Connect(function()
				vm += 1
				if vm > 12 then
					vm, vy = 1, vy + 1
				end
				api:_render()
			end)
			function api:Get()
				return string.format("%04d-%02d-%02d", sel.year, sel.month, sel.day)
			end
			function api:Set(v, silent)
				local p = parse(v)
				if p then
					p.day = math.clamp(p.day, 1, daysIn(p.year, p.month))
					sel = p
					vy, vm = p.year, p.month
					api:_render()
					if not silent then
						fire()
					end
				end
			end
			api:_render()
			registerFlag(opts, api)
			return api
		end

		-- ----- Pagination: ตัวเลือกหน้า ‹ 1 2 3 … 10 › -----
		function Tab:AddPagination(opts)
			opts = opts or {}
			local total = math.max(math.floor(tonumber(opts.Pages or opts.Total) or 5), 1)
			local current = math.clamp(math.floor(tonumber(opts.Default) or 1), 1, total)
			local card = row(44)
			local holder = make("Frame", {
				Size = UDim2.new(1, 0, 1, 0),
				BackgroundTransparency = 1,
			}, card)
			make("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 6),
			}, holder)
			local api = {}
			local function pageBtn(label, order, on, enabled, onClick)
				local b = make("TextButton", {
					LayoutOrder = order,
					Size = UDim2.new(0, 28, 0, 28),
					BackgroundColor3 = on and "accent" or "input",
					BorderSizePixel = 0,
					AutoButtonColor = false,
					Text = label,
					TextSize = 12,
					TextColor3 = on and Color3.fromRGB(255, 255, 255) or (enabled and C.text or C.muted),
					TextTransparency = enabled and 0 or 0.5,
					FontFace = on and FONT_BOLD or FONT,
				}, holder)
				round(b, 7, on and nil or "stroke")
				if enabled and onClick then
					b.MouseButton1Click:Connect(onClick)
				end
			end
			local function render()
				for _, c in ipairs(holder:GetChildren()) do
					if c:IsA("TextButton") or c:IsA("TextLabel") then
						c:Destroy()
					end
				end
				local order = 0
				local function nxt()
					order += 1
					return order
				end
				pageBtn("‹", nxt(), false, current > 1, function()
					api:Set(current - 1)
				end)
				local seq = {}
				if total <= 7 then
					for i = 1, total do
						seq[#seq + 1] = i
					end
				else
					local a, b = math.max(2, current - 1), math.min(total - 1, current + 1)
					seq[#seq + 1] = 1
					if a > 2 then
						seq[#seq + 1] = "…"
					end
					for i = a, b do
						seq[#seq + 1] = i
					end
					if b < total - 1 then
						seq[#seq + 1] = "…"
					end
					seq[#seq + 1] = total
				end
				for _, p in ipairs(seq) do
					if p == "…" then
						make("TextLabel", {
							LayoutOrder = nxt(),
							Size = UDim2.new(0, 16, 0, 28),
							BackgroundTransparency = 1,
							Text = "…",
							TextSize = 12,
							TextColor3 = "muted",
							FontFace = FONT,
						}, holder)
					else
						pageBtn(tostring(p), nxt(), p == current, true, function()
							api:Set(p)
						end)
					end
				end
				pageBtn("›", nxt(), false, current < total, function()
					api:Set(current + 1)
				end)
			end
			function api:Set(v, silent)
				current = math.clamp(math.floor(tonumber(v) or current), 1, total)
				render()
				if not silent and opts.Callback then
					task.spawn(opts.Callback, current)
				end
			end
			function api:Get()
				return current
			end
			function api:SetPages(n)
				total = math.max(math.floor(tonumber(n) or total), 1)
				current = math.clamp(current, 1, total)
				render()
			end
			render()
			registerFlag(opts, api)
			return api
		end

