		-- ----- CircleProgress: วงกลมแสดงเปอร์เซ็นต์ -----
		function Tab:AddCircleProgress(opts)
			opts = opts or {}
			local min = tonumber(opts.Min) or 0
			local max = tonumber(opts.Max) or 100
			local value = math.clamp(tonumber(opts.Default) or min, min, max)
			local hasDesc = opts.Description and opts.Description ~= ""
			local card = row(84)
			local ringHolder = make("Frame", {
				Position = UDim2.new(0, 16, 0, 12),
				Size = UDim2.new(0, 60, 0, 60),
				BackgroundTransparency = 1,
			}, card)
			local N, R = 48, 26
			local segs, lit = {}, {}
			for i = 1, N do
				local ang = (i - 1) / N * 2 * math.pi
				local s = make("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.new(0.5, math.sin(ang) * R, 0.5, -math.cos(ang) * R),
					Size = UDim2.new(0, 4, 0, 9),
					Rotation = math.deg(ang),
					BackgroundColor3 = "input",
					BorderSizePixel = 0,
				}, ringHolder)
				round(s, 2)
				segs[i] = s
				lit[i] = false
			end
			local center = text(ringHolder, "", 0, 0, 60, 60, 13, "text", Enum.TextXAlignment.Center)
			center.FontFace = FONT_BOLD
			local title = text(card, tostring(opts.Title or "Progress"), 92, hasDesc and 22 or 0, 260, hasDesc and 18 or 84, 13, "text")
			title.FontFace = FONT_BOLD
			local desc
			if hasDesc then
				desc = text(card, tostring(opts.Description), 92, 42, 260, 16, 11, "muted")
			end
			local api = {}
			local function render()
				local f = math.clamp((value - min) / math.max(max - min, 1e-6), 0, 1)
				local k = math.floor(f * N + 0.5)
				for i = 1, N do
					local on = i <= k
					if lit[i] ~= on then
						lit[i] = on
						setRole(segs[i], "BackgroundColor3", on and "accent" or "input")
					end
				end
				center.Text = opts.Suffix and (tostring(value) .. tostring(opts.Suffix)) or (math.floor(f * 100 + 0.5) .. "%")
			end
			function api:Set(v)
				value = math.clamp(tonumber(v) or value, min, max)
				render()
			end
			function api:Get()
				return value
			end
			function api:SetDescription(v)
				if desc then
					desc.Text = tostring(v)
				end
			end
			render()
			registerFlag(opts, api)
			return api
		end

		-- ----- Skeleton: โครงกำลังโหลด (แถบสีเทามีแสงวิ่ง) -----
		function Tab:AddSkeleton(opts)
			opts = opts or {}
			local lines = math.max(math.floor(tonumber(opts.Lines) or 3), 1)
			local card = autoCard(12, 12, 8)
			local tweens = {}
			local function bar(w, h, parent, order)
				local b = make("Frame", {
					LayoutOrder = order,
					Size = UDim2.new(w, 0, 0, h),
					BackgroundColor3 = "input",
					BorderSizePixel = 0,
				}, parent)
				make("UICorner", { CornerRadius = UDim.new(0, 5) }, b)
				local g = make("UIGradient", {
					Transparency = NumberSequence.new({
						NumberSequenceKeypoint.new(0, 0.55),
						NumberSequenceKeypoint.new(0.5, 0),
						NumberSequenceKeypoint.new(1, 0.55),
					}),
					Offset = Vector2.new(-1, 0),
				}, b)
				local t = TweenService:Create(g, TweenInfo.new(1.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1), { Offset = Vector2.new(1, 0) })
				t:Play()
				tweens[#tweens + 1] = t
				return b
			end
			if opts.Avatar then
				local topRow = make("Frame", { LayoutOrder = 0, Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1 }, card)
				local av = bar(0, 40, topRow, 0)
				av.Size = UDim2.new(0, 40, 0, 40)
				make("UICorner", { CornerRadius = UDim.new(1, 0) }, av)
				local l1 = bar(0.5, 12, topRow, 0)
				l1.Position = UDim2.new(0, 52, 0, 6)
				local l2 = bar(0.3, 10, topRow, 0)
				l2.Position = UDim2.new(0, 52, 0, 24)
			end
			for i = 1, lines do
				bar(i == lines and 0.6 or 1, 12, card, i)
			end
			local api = {}
			function api:Stop()
				for _, t in ipairs(tweens) do
					t:Cancel()
				end
				card.Visible = false
			end
			return api
		end

		-- =====================================================================
		-- ===== ตัวห่อกลาง: ทุก Add... ได้ SetLocked / SetVisible / SetTooltip / Destroy =====
		-- และรองรับตัวเลือก  Locked = true  /  Tooltip = "ข้อความ"  ในทุกองค์ประกอบ
		-- =====================================================================
		do
			local names = {}
			for name, fn in pairs(Tab) do
				if type(name) == "string" and name:sub(1, 3) == "Add" and type(fn) == "function" then
					names[#names + 1] = name
				end
			end
			for _, name in ipairs(names) do
				local fn = Tab[name]
				Tab[name] = function(self, ...)
					local opts = ...
					local before = Tab._order
					local api = fn(self, ...)
					if type(api) ~= "table" then
						return api
					end
					local card
					for _, c in ipairs(page:GetChildren()) do
						if c:IsA("GuiObject") and c.LayoutOrder > before and c.LayoutOrder <= Tab._order then
							if not card or c.LayoutOrder < card.LayoutOrder then
								card = c
							end
						end
					end
					if not card then
						return api
					end

					local locked, overlay, tag = false, nil, nil
					local tipText = type(opts) == "table" and opts.Tooltip or nil
					if rawget(api, "Instance") == nil then
						rawset(api, "Instance", card)
					end
					if rawget(api, "SetLocked") == nil then
						function api:SetLocked(v)
							locked = v ~= false
							if not overlay then
								overlay = make("TextButton", {
									Name = "LockOverlay",
									Size = UDim2.new(1, 0, 1, 0),
									BackgroundColor3 = "bg",
									BackgroundTransparency = 1,
									BorderSizePixel = 0,
									AutoButtonColor = false,
									Text = "",
									Visible = false,
									ZIndex = 80,
								}, card)
								make("UICorner", { CornerRadius = UDim.new(0, 8) }, overlay)
								tag = make("TextLabel", {
									AnchorPoint = Vector2.new(1, 0.5),
									Position = UDim2.new(1, -12, 0.5, 0),
									Size = UDim2.new(0, 0, 0, 18),
									AutomaticSize = Enum.AutomaticSize.X,
									BackgroundTransparency = 1,
									Text = "LOCKED",
									TextSize = 10,
									TextColor3 = "muted",
									TextTransparency = 1,
									FontFace = FONT_BOLD,
									ZIndex = 81,
								}, overlay)
							end
							if locked then
								overlay.Visible = true
								tween(overlay, 0.2, { BackgroundTransparency = 0.35 })
								tween(tag, 0.2, { TextTransparency = 0 })
							else
								tween(overlay, 0.2, { BackgroundTransparency = 1 })
								tween(tag, 0.2, { TextTransparency = 1 })
								task.delay(0.22, function()
									if not locked and overlay then
										overlay.Visible = false
									end
								end)
							end
						end
						function api:IsLocked()
							return locked
						end
					end
					if rawget(api, "SetVisible") == nil then
						function api:SetVisible(v)
							card.Visible = v ~= false
						end
					end
					if rawget(api, "SetTooltip") == nil then
						function api:SetTooltip(t)
							tipText = t
							Window._tip(card, t and function()
								return tipText
							end or nil)
						end
					end
					if rawget(api, "Destroy") == nil then
						function api:Destroy()
							Window._tip(card, nil)
							card:Destroy()
						end
					end
					if tipText then
						api:SetTooltip(tipText)
					end
					if type(opts) == "table" and opts.Locked == true then
						api:SetLocked(true)
					end
					return api
				end
			end
		end

		return Tab
	end

	-- ===== Profile footer =====
	-- เชื่อมติดเป็นเนื้อเดียวกับก้นแถบแท็บ (sidebar) ไปเลย ไม่มีปุ่มพับ/กางลอยแยกอีกต่อไป
	-- แสดงเต็มตลอดเวลา แค่มีเส้นคั่นบางๆ ด้านบนกั้นจากรายการแท็บ (สไตล์เดียวกับเส้นคั่น header/sidebar ที่มีอยู่แล้ว)
	local FOOTER_H = PROFILE_FOOTER_H
	local LABEL_X = 54
	local RIGHT_GUTTER = 10 -- เอาปุ่มซ่อนชื่อออกแล้ว เลยลดระยะขอบขวาลงให้ชื่อมีที่แสดงเต็มมากขึ้น
	local LABEL_W = SIDEBAR_W - LABEL_X - RIGHT_GUTTER
	local BIG_THUMB = 40

	make("Frame", {
		Name = "ProfileFooterDivider",
		Position = UDim2.new(0, 0, 1, -(FOOTER_H + 1)),
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = "stroke",
		BorderSizePixel = 0,
	}, sidebar)

	local panel = make("Frame", {
		Name = "ProfileFooter",
		Position = UDim2.new(0, 0, 1, -FOOTER_H),
		Size = UDim2.new(1, 0, 0, FOOTER_H),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}, sidebar)

	local avatarHolder = make("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.new(0, 40, 0, 40),
		BackgroundColor3 = "input",
		BorderSizePixel = 0,
		ZIndex = 21,
	}, panel)
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, avatarHolder)
	make("UIStroke", { Thickness = 1.5, Color = "accent", Transparency = 0.25 }, avatarHolder)
	local avatarImage = make("ImageLabel", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		ScaleType = Enum.ScaleType.Crop,
		ZIndex = 22,
	}, avatarHolder)
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, avatarImage)
	task.spawn(function()
		local ok, thumb = pcall(function()
			return Players:GetUserThumbnailAsync(
				player.UserId,
				Enum.ThumbnailType.HeadShot,
				Enum.ThumbnailSize.Size100x100
			)
		end)
		if ok and thumb then
			avatarImage.Image = thumb
		end
	end)

	-- ===== โหมดโปรไฟล์ =====
	-- ปุ่มซ่อนชื่อถูกเอาออกแล้ว เลยให้ป้ายชื่อใช้เต็มความกว้างที่เหลือ (LABEL_W) ได้เลย
	-- ใช้ TextScaled + UITextSizeConstraint แทน TextTruncate เพื่อให้ตัวอักษรย่อพอดีกล่องแทนการตัด "..."
	local nameLabel = text(panel, player.DisplayName, LABEL_X, 10, LABEL_W, 18, 13, "text")
	nameLabel.FontFace = FONT_BOLD
	nameLabel.TextScaled = true
	nameLabel.ZIndex = 21
	make("UITextSizeConstraint", { MaxTextSize = 13, MinTextSize = 8 }, nameLabel)
	local userLabel = text(panel, "@" .. player.Name, LABEL_X, 27, LABEL_W, 14, 11, "muted")
	userLabel.TextScaled = true
	userLabel.ZIndex = 21
	make("UITextSizeConstraint", { MaxTextSize = 11, MinTextSize = 7 }, userLabel)

	-- ===== โหมดแมพ =====
	local mapThumb = make("ImageLabel", {
		Position = UDim2.new(0, 10, 0, 10),
		Size = UDim2.new(0, BIG_THUMB, 0, BIG_THUMB),
		BackgroundColor3 = "input",
		BorderSizePixel = 0,
		ScaleType = Enum.ScaleType.Crop,
		Visible = false,
		ZIndex = 21,
	}, panel)
	make("UICorner", { CornerRadius = UDim.new(0, 8) }, mapThumb)

	-- ตัวอักษรสำรอง เผื่อโหลดไอคอนแมพไม่สำเร็จ (เช่นตอน assetdelivery ของ Roblox
	-- ดึงข้อมูลไม่ได้ชั่วคราว) จะได้ไม่เจอเป็นกล่องดำว่าง ๆ เฉย ๆ
	local mapThumbFallback = text(mapThumb, "?", 0, 0, BIG_THUMB, BIG_THUMB, 16, "muted", Enum.TextXAlignment.Center)
	mapThumbFallback.FontFace = FONT_BOLD
	mapThumbFallback.ZIndex = 21
	mapThumbFallback.Visible = false

	-- โหลดไอคอนแมพ พร้อม retry ถ้า Roblox content delivery ดึงไม่สำเร็จชั่วคราว
	-- (เจอบ่อยเวลาเน็ตกระตุกหรือ executor บางตัวพร็อกซี assetdelivery ไม่เสถียร —
	-- ปกติจะเห็นเป็น error "MeshContentProvider failed to process ... could not fetch"
	-- ใน Developer Console พร้อม ๆ กับที่ไอคอนแมพนี้ก็ดึงไม่ขึ้นเหมือนกัน)
	local function loadMapIcon(attempt)
		attempt = attempt or 1
		local iconUri = "rbxthumb://type=GameIcon&id=" .. tostring(game.GameId) .. "&w=150&h=150"
		local setOk = pcall(function()
			mapThumb.Image = iconUri
		end)
		if not setOk then
			mapThumbFallback.Visible = true
			return
		end
		task.spawn(function()
			local status
			pcall(function()
				game:GetService("ContentProvider"):PreloadAsync({ mapThumb }, function(_, s)
					status = s
				end)
			end)
			if status == Enum.AssetFetchStatus.Success then
				mapThumbFallback.Visible = false
			elseif attempt < 4 then
				task.wait(1.2 * attempt)
				loadMapIcon(attempt + 1)
			else
				-- พยายามครบแล้วแต่ยังไม่สำเร็จ โชว์ตัวอักษรแทนดีกว่าปล่อยว่าง
				mapThumbFallback.Visible = true
			end
		end)
	end
	loadMapIcon()

	local mapLabel = text(panel, "กำลังโหลด...", LABEL_X, 10, LABEL_W, 18, 13, "text")
	mapLabel.TextScaled = true
	mapLabel.Visible = false
	mapLabel.ZIndex = 21
	make("UITextSizeConstraint", { MaxTextSize = 13, MinTextSize = 8 }, mapLabel)
	local mapSub = text(panel, "กำลังเล่นอยู่", LABEL_X, 27, LABEL_W, 14, 11, "muted")
	mapSub.Visible = false
	mapSub.ZIndex = 21

	task.spawn(function()
		local ok, info = pcall(function()
			return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
		end)
		local name = (ok and info and info.Name) or game.Name
		mapLabel.Text = tostring(name)
		local initial = tostring(name):sub(1, 1):upper()
		if initial ~= "" then
			mapThumbFallback.Text = initial
		end
	end)

	-- ===== สวิตช์โหมดแบบ pill มี highlight เลื่อนได้ =====
	local viewMode = "profile"
	local SEG_H = 20

	local track = make("Frame", {
		Name = "ModeTrack",
		Position = UDim2.new(0, LABEL_X, 0, FOOTER_H - SEG_H - 6),
		Size = UDim2.new(0, LABEL_W, 0, SEG_H),
		BackgroundColor3 = "input",
		BorderSizePixel = 0,
		ZIndex = 21,
	}, panel)
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, track)
	make("UIStroke", { Thickness = 1, Color = "stroke" }, track)

	local indicator = make("Frame", {
		Name = "Indicator",
		Position = UDim2.new(0, 2, 0, 2),
		Size = UDim2.new(0.5, -3, 1, -4),
		BackgroundColor3 = "accent",
		BorderSizePixel = 0,
		ZIndex = 22,
	}, track)
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, indicator)

	local function segButton(label, xScale, mode)
		local b = make("TextButton", {
			Position = UDim2.new(xScale, 0, 0, 0),
			Size = UDim2.new(0.5, 0, 1, 0),
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 23,
		}, track)
		local t = text(b, label, 0, 0, 0, 0, 10, "muted", Enum.TextXAlignment.Center)
		t.Size = UDim2.new(1, 0, 1, 0)
		t.ZIndex = 24
		-- ให้ตัวอักษรย่อขนาดลงเองถ้าช่องแคบ จะได้ไม่ล้นออกนอกปุ่ม
		t.TextScaled = true
		make("UITextSizeConstraint", { MaxTextSize = 10, MinTextSize = 7 }, t)
		b.MouseButton1Click:Connect(function()
			Window:SetDrawerMode(mode)
		end)
		return t
	end
	local profileTxt = segButton("Profile", 0, "profile")
	local mapTxt = segButton("Map", 0.5, "map")

	local function applyMode()
		local isProfile = viewMode == "profile"
		avatarHolder.Visible = isProfile
		nameLabel.Visible = isProfile
		userLabel.Visible = isProfile
		mapThumb.Visible = not isProfile
		mapLabel.Visible = not isProfile
		mapSub.Visible = not isProfile

		tween(
			indicator,
			0.4,
			{ Position = isProfile and UDim2.new(0, 2, 0, 2) or UDim2.new(0.5, 1, 0, 2) },
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out
		)
		tween(profileTxt, 0.25, { TextColor3 = isProfile and C.submitText or C.muted })
		tween(mapTxt, 0.25, { TextColor3 = (not isProfile) and C.submitText or C.muted })

		if not isProfile then
			mapThumb.Position = UDim2.new(0, 10, 0, 10)
			mapThumb.Size = UDim2.new(0, BIG_THUMB, 0, BIG_THUMB)
			mapLabel.Position = UDim2.new(0, LABEL_X, 0, 10)
			mapLabel.Size = UDim2.new(0, LABEL_W, 0, 18)
			mapLabel.FontFace = FONT_BOLD
			mapLabel.TextSize = 13
		end
	end

	function Window:SetDrawerMode(m)
		if m == "profile" or m == "map" then
			viewMode = m
			applyMode()
		end
	end
	applyMode()

	-- เปลี่ยนไอคอนได้ตอนรันแล้ว (ใส่ id ตัวเลข หรือ rbxassetid://... ; ใส่ nil เพื่อคืนค่าเดิม / ใส่ "" เพื่อซ่อน แล้วชื่อจะเลื่อนมาแทนที่)
	function Window:SetHeaderIcon(id)
		local img
		if id == nil then
			img = HEADER_ICON -- คืนค่าเดิม (อาจเป็น nil = ซ่อน)
		else
			img = assetId(id) -- "" / false => nil = ซ่อน
		end
		local titleX = PAD + (img and 40 or 0)
		local titleW = 260 + (img and 0 or 40)
		if img then
			headerLogo.Image = img
			headerLogo.Visible = true
		else
			headerLogo.Visible = false
		end
		hubTitle.Position = UDim2.new(0, titleX, 0, 8)
		hubTitle.Size = UDim2.new(0, titleW, 0, 20)
		hubSubtitle.Position = UDim2.new(0, titleX, 0, 28)
		hubSubtitle.Size = UDim2.new(0, titleW, 0, 14)
	end
	function Window:SetToggleIcon(id)
		if bubble then
			local icon = bubble:FindFirstChild("Icon")
			if icon then
				local img
				if id == nil then
					img = TOGGLE_ICON -- คืนค่าเดิม (อาจเป็น nil = ซ่อน)
				else
					img = assetId(id) -- "" / false => nil = ซ่อน
				end
				if img then
					icon.Image = img
					icon.Visible = true
				else
					icon.Visible = false
				end
			end
		end
	end



	root.Parent = (gethui and gethui()) or game:GetService("CoreGui")

	-- intro grow animation
	task.spawn(function()
		main.Size = UDim2.new(0, INTRO_SIZE - 20, 0, INTRO_SIZE - 20)
		tween(main, 0.6, { Size = UDim2.new(0, INTRO_SIZE, 0, INTRO_SIZE) }, Enum.EasingStyle.Quint)
		tween(canvas, 0.5, { BackgroundTransparency = 0 })
		tween(decorGroup, 0.5, { GroupTransparency = 0 })
		tween(borderStroke, 0.5, { Transparency = 0.55 })
		tween(shadow, 0.5, { ImageTransparency = 0.6 })
		task.wait(0.5)

		tween(borderStroke, 0.7, { Transparency = 1 })
		tween(main, 0.85, { Size = UDim2.new(0, FINAL_W, 0, FINAL_H) }, Enum.EasingStyle.Quint)
		task.wait(0.55)

		content.Visible = true
		local items = prep(content)
		fade(items, 0)
		fade(items, 1, 0.4)
	end)

	return Window
end

return Library
