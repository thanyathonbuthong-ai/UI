	-- ===== Config save / load =====
	local function configPath(name)
		return FOLDER .. "/" .. tostring(name or "config") .. ".json"
	end

	function Window:SaveConfig(name)
		local data = {}
		for flag, entry in pairs(Window._registry) do
			local ok, value = pcall(entry.get)
			if ok then
				data[flag] = value
			end
		end
		local ok, encoded = pcall(function()
			return HttpService:JSONEncode(data)
		end)
		if ok then
			return safeWriteFile(configPath(name), encoded)
		end
		return false
	end

	function Window:LoadConfig(name)
		local path = configPath(name)
		if not safeIsFile(path) then
			return false
		end
		local raw = safeReadFile(path)
		if not raw then
			return false
		end
		local ok, data = pcall(function()
			return HttpService:JSONDecode(raw)
		end)
		if not ok or type(data) ~= "table" then
			return false
		end
		for flag, value in pairs(data) do
			local entry = Window._registry[flag]
			if entry then
				pcall(entry.set, value)
			end
		end
		return true
	end

	-- ===== Tab / control factory =====
	local tabOrder = 0

	function Window:AddTab(name, iconImage)
		tabOrder += 1

