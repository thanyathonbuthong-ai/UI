		-- ----- Tabs: แท็บย่อยในหน้า (สลับเนื้อหาด้วยแถบ pill) -----
		-- local t = tab:AddTabs({ Tabs = {"A","B"} }); t:Tab("A"):AddToggle({...})
		function Tab:AddTabs(opts)
			opts = opts or {}
			local names = opts.Tabs or {}
			local count = math.max(#names, 1)
			Tab._order += 1
			local holder = make("Frame", {
				LayoutOrder = Tab._order,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
			}, page)
			make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }, holder)

			local track = make("Frame", {
				LayoutOrder = 0,
				Size = UDim2.new(1, 0, 0, 32),
				BackgroundColor3 = "input",
				BorderSizePixel = 0,
			}, holder)
			round(track, 8, "stroke")
			local pill = make("Frame", {
				Position = UDim2.new(0, 3, 0, 3),
				Size = UDim2.new(1 / count, -6, 1, -6),
				BackgroundColor3 = "accent",
				BorderSizePixel = 0,
			}, track)
			round(pill, 6)

			local bodies, proxies, labels = {}, {}, {}
			local current = opts.Default or names[1]
			local api = {}
			local function indexOf(n)
				for i, v in ipairs(names) do
					if tostring(v) == tostring(n) then
						return i
					end
				end
				return 1
			end
			local function render(animate)
				local idx = indexOf(current)
				local pos = UDim2.new((idx - 1) / count, 3, 0, 3)
				if animate then
					tween(pill, 0.25, { Position = pos }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
				else
					pill.Position = pos
				end
				for i, name in ipairs(names) do
					bodies[tostring(name)].Visible = i == idx
					local col = i == idx and Color3.fromRGB(255, 255, 255) or C.muted
					if animate then
						tween(labels[i], 0.2, { TextColor3 = col })
					else
						labels[i].TextColor3 = col
					end
				end
			end
			for i, name in ipairs(names) do
				name = tostring(name)
				local b = make("TextButton", {
					Position = UDim2.new((i - 1) / count, 0, 0, 0),
					Size = UDim2.new(1 / count, 0, 1, 0),
					BackgroundTransparency = 1,
					Text = name,
					TextSize = 12,
					TextColor3 = C.muted,
					AutoButtonColor = false,
					FontFace = FONT,
					ZIndex = 3,
				}, track)
				labels[i] = b
				local body = make("Frame", {
					LayoutOrder = i,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					BackgroundTransparency = 1,
					Visible = false,
				}, holder)
				make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }, body)
				bodies[name] = body
				proxies[name] = makeProxy(body)
				b.MouseButton1Click:Connect(function()
					api:Select(name)
				end)
			end
			function api:Tab(name)
				return proxies[tostring(name)]
			end
			function api:Select(name, silent)
				current = names[indexOf(name)]
				render(true)
				if not silent and opts.Callback then
					task.spawn(opts.Callback, current)
				end
			end
			function api:Get()
				return current
			end
			api.Instance = holder
			render(false)
			return api
		end

		-- ----- TimePicker: เลือกเวลา HH:MM (ปุ่ม +/- หรือพิมพ์ตัวเลขเอง) -----
		function Tab:AddTimePicker(opts)
			opts = opts or {}
			local hour, minute = 12, 0
			local function parse(v)
				if type(v) == "string" then
					local a, b = v:match("^(%d+):(%d+)$")
					if a then
						return tonumber(a) % 24, tonumber(b) % 60
					end
				elseif type(v) == "table" then
					return (tonumber(v[1]) or 0) % 24, (tonumber(v[2]) or 0) % 60
				end
			end
			local ph, pm = parse(opts.Default)
			if ph then
				hour, minute = ph, pm
			end
			local minuteStep = math.max(math.floor(tonumber(opts.MinuteStep) or 1), 1)

			local card = row(40)
			text(card, tostring(opts.Title or "Time"), 14, 0, 180, 40, 13, "text")
			local function spinUnit(rightOff)
				local function btn(label, off)
					local b = make("TextButton", {
						AnchorPoint = Vector2.new(1, 0.5),
						Position = UDim2.new(1, off, 0.5, 0),
						Size = UDim2.new(0, 20, 0, 24),
						BackgroundColor3 = "input",
						BorderSizePixel = 0,
						AutoButtonColor = false,
						Text = label,
						TextSize = 14,
						TextColor3 = C.text,
						FontFace = FONT_BOLD,
					}, card)
					round(b, 6, "stroke")
					return b
				end
				local plus = btn("+", rightOff)
				local box = make("TextBox", {
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, rightOff - 22, 0.5, 0),
					Size = UDim2.new(0, 34, 0, 24),
					BackgroundColor3 = "input",
					BorderSizePixel = 0,
					Text = "",
					TextSize = 13,
					TextColor3 = C.text,
					ClearTextOnFocus = false,
					FontFace = FONT,
				}, card)
				round(box, 6, "stroke")
				local minus = btn("-", rightOff - 58)
				return plus, box, minus
			end
			local hPlus, hBox, hMinus = spinUnit(-104)
			local mPlus, mBox, mMinus = spinUnit(-12)
			local colon = text(card, ":", 0, 0, 14, 40, 15, "muted", Enum.TextXAlignment.Center)
			colon.AnchorPoint = Vector2.new(1, 0)
			colon.Position = UDim2.new(1, -12 - 78, 0, 0)

			local api = {}
			local function fmt()
				return string.format("%02d:%02d", hour, minute)
			end
			local function render()
				hBox.Text = string.format("%02d", hour)
				mBox.Text = string.format("%02d", minute)
			end
			local function fire()
				if opts.Callback then
					task.spawn(opts.Callback, hour, minute, fmt())
				end
			end
