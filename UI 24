		-- ----- RangeSlider: สไลเดอร์ 2 หัว เลือกช่วงต่ำสุด-สูงสุด -----
		function Tab:AddRangeSlider(opts)
			opts = opts or {}
			local min = tonumber(opts.Min) or 0
			local max = tonumber(opts.Max) or 100
			local step = tonumber(opts.Step) or 1
			local d = opts.Default or { min, max }
			local lo = math.clamp(tonumber(d[1]) or min, min, max)
			local hi = math.clamp(tonumber(d[2]) or max, min, max)
			if lo > hi then
				lo, hi = hi, lo
			end

			local card = row(54)
			text(card, tostring(opts.Title or "Range"), 14, 6, 200, 16, 13, "text")
			local valueLabel = text(card, "", 0, 6, 110, 16, 12, "muted", Enum.TextXAlignment.Right)
			valueLabel.Position = UDim2.new(1, -124, 0, 6)
			local track = frame(card, 14, 35, 0, 4, "input", 0)
			track.Size = UDim2.new(1, -28, 0, 4)
			round(track, 2)
			local fill = make("Frame", {
				BackgroundColor3 = "accent",
				BorderSizePixel = 0,
				Size = UDim2.new(0, 0, 1, 0),
			}, track)
			local function makeThumb()
				local t = make("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Size = UDim2.new(0, 14, 0, 14),
					BackgroundColor3 = Color3.fromRGB(255, 255, 255),
					BorderSizePixel = 0,
					ZIndex = 3,
				}, track)
				round(t, 7)
				make("UIStroke", {
					Thickness = 1,
					Color = Color3.fromRGB(0, 0, 0),
					Transparency = 0.8,
					ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
				}, t)
				return t
			end
			local thumbLo, thumbHi = makeThumb(), makeThumb()

			local function frac(v)
				return (v - min) / math.max(max - min, 1e-6)
			end
			local function snap(v)
				return math.clamp(math.floor(v / step + 0.5) * step, min, max)
			end
			local function render()
				local fl, fh = frac(lo), frac(hi)
				fill.Position = UDim2.new(fl, 0, 0, 0)
				fill.Size = UDim2.new(fh - fl, 0, 1, 0)
				thumbLo.Position = UDim2.new(fl, 0, 0.5, 0)
				thumbHi.Position = UDim2.new(fh, 0, 0.5, 0)
				valueLabel.Text = tostring(lo) .. " - " .. tostring(hi)
			end
			render()

			local function fire()
				if opts.Callback then
					task.spawn(opts.Callback, lo, hi)
				end
			end
			local active = nil
			local hit = make("TextButton", {
				Position = UDim2.new(0, 14, 0, 26),
				Size = UDim2.new(1, -28, 0, 20),
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
			}, card)
			local function valueAt(x)
				local f = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
				return min + (max - min) * f
			end
			local function update(x)
				local v = snap(valueAt(x))
				if active == "lo" then
					lo = math.min(v, hi)
				elseif active == "hi" then
					hi = math.max(v, lo)
				end
				render()
				fire()
			end
			hit.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					local v = valueAt(input.Position.X)
					if math.abs(v - lo) < math.abs(v - hi) or (v <= lo) then
						active = "lo"
					else
						active = "hi"
					end
					update(input.Position.X)
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if active and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					update(input.Position.X)
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					active = nil
				end
			end)

			local api = {}
			function api:Set(v, silent)
				if type(v) ~= "table" then
					return
				end
				local a = math.clamp(snap(tonumber(v[1]) or lo), min, max)
				local b = math.clamp(snap(tonumber(v[2]) or hi), min, max)
				lo, hi = math.min(a, b), math.max(a, b)
				render()
				if not silent then
					fire()
				end
			end
			function api:Get()
				return { lo, hi }
			end
			registerFlag(opts, api)
			return api
		end

