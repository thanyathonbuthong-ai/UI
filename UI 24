		}, pageHolder)
		make("UIPadding", {
			PaddingLeft = UDim.new(0, PAD),
			PaddingRight = UDim.new(0, PAD),
			PaddingTop = UDim.new(0, PAD),
			PaddingBottom = UDim.new(0, PAD),
		}, page)
		make("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
		}, page)

		local Tab = {}
		Tab._order = 0
		Tab.Page = page

		local function select()
			if activeTab == Tab then
				return
			end
			closeAllDropdowns()
			for _, t in ipairs(tabButtons) do
				t.page.Visible = false
				tween(t.btn, 0.15, { BackgroundTransparency = 1 })
				tween(t.indicator, 0.2, { Size = UDim2.new(0, 3, 0, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				tween(t.indicatorGlow, 0.15, { ImageTransparency = 1, Size = UDim2.new(0, 4, 0, 0) })
				if t.label then
					tween(t.label, 0.15, { TextColor3 = C.muted })
				end
				if t.iconImg then
					tween(t.iconImg, 0.15, { ImageColor3 = iconRole(C.muted) })
				end
				if t.iconGlowImg then
					tween(t.iconGlowImg, 0.15, { ImageTransparency = 0.9 })
				end
			end
			page.Visible = true
			tween(btn, 0.15, { BackgroundTransparency = 0.4, BackgroundColor3 = C.card })
			btn.BackgroundColor3 = C.card
			-- accent pill glides/pops in with a little overshoot, and its
			-- glow blooms outward alongside it — the "this is where you are" cue
			tween(indicator, 0.3, { Size = UDim2.new(0, 3, 0, 18) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			tween(indicatorGlow, 0.3, { ImageTransparency = 0.45, Size = UDim2.new(0, 18, 0, 26) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			if label then
				tween(label, 0.15, { TextColor3 = C.accent })
			end
			if iconImg then
				tween(iconImg, 0.15, { ImageColor3 = iconRole(C.accent) })
			end
			if iconGlowImg then
				tween(iconGlowImg, 0.2, { ImageTransparency = 0.6 })
			end
			activeTab = Tab
		end
		btn.MouseButton1Click:Connect(select)
		btn.MouseEnter:Connect(function()
			if activeTab ~= Tab then
				tween(btn, 0.15, { BackgroundTransparency = 0.7 })
			end
		end)
		btn.MouseLeave:Connect(function()
			if activeTab ~= Tab then
				tween(btn, 0.15, { BackgroundTransparency = 1 })
			end
		end)

		tabButtons[#tabButtons + 1] = {
			btn = btn,
			page = page,
			label = label,
			indicator = indicator,
			indicatorGlow = indicatorGlow,
			iconImg = iconImg,
			iconGlowImg = iconGlowImg,
			select = select,
		}
		Window._tabs[#Window._tabs + 1] = Tab

		if not activeTab then
			select()
		end

