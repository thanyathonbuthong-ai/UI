		-- ตัวช่วยสร้าง "ตัวแทน Tab" ที่เอาองค์ประกอบไปวางในกล่องอื่นได้
		-- (ทุกฟังก์ชัน Add... ใช้ได้เหมือน Tab ปกติ แค่การ์ดจะถูกย้ายเข้าไปอยู่ในกล่อง)
		local function makeProxy(body, cols)
			local proxy = { Instance = body }
			local count = 0
			return setmetatable(proxy, {
				__index = function(_, name)
					local fn = Tab[name]
					if type(name) ~= "string" or name:sub(1, 3) ~= "Add" or type(fn) ~= "function" then
						return nil
					end
					return function(_, ...)
						local before = Tab._order
						local api = fn(Tab, ...)
						local moved = {}
						for _, c in ipairs(page:GetChildren()) do
							if c:IsA("GuiObject") and c.LayoutOrder > before and c.LayoutOrder <= Tab._order then
								moved[#moved + 1] = c
							end
						end
						table.sort(moved, function(a, b)
							return a.LayoutOrder < b.LayoutOrder
						end)
						for _, c in ipairs(moved) do
							count += 1
							c.LayoutOrder = count
							c.Parent = body
							if cols and cols > 1 then
								local y = c.Size.Y
								c.Size = UDim2.new(1 / cols, -(8 * (cols - 1)) / cols - 1, y.Scale, y.Offset)
							end
						end
						return api
					end
				end,
			})
		end

		-- ----- Collapsible: กล่องพับได้ ข้างในใส่องค์ประกอบอะไรก็ได้ -----
		-- local box = tab:AddCollapsible({ Title = "ตั้งค่า", Open = true })
		-- box:AddToggle({...}); box:AddSlider({...})
		function Tab:AddCollapsible(opts)
			opts = opts or {}
			local open = opts.Open ~= false
			local collapsible = opts.Collapsible ~= false
			Tab._order += 1
			local box = make("Frame", {
				LayoutOrder = Tab._order,
				Size = UDim2.new(1, 0, 0, 38),
				BackgroundColor3 = "card",
				BorderSizePixel = 0,
				ClipsDescendants = true,
			}, page)
			round(box, 8, "stroke")
			local title = text(box, tostring(opts.Title or "Group"), 14, 0, 300, 38, 13, "text")
			title.FontFace = FONT_BOLD
			local arrow = make("TextLabel", {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -14, 0, 0),
				Size = UDim2.new(0, 16, 0, 38),
				BackgroundTransparency = 1,
				Text = "›",
				TextSize = 20,
				TextColor3 = "muted",
				Rotation = open and 90 or 0,
				Visible = collapsible,
				FontFace = FONT_BOLD,
			}, box)
			local body = make("Frame", {
				Position = UDim2.new(0, 0, 0, 38),
				Size = UDim2.new(1, 0, 0, 0),
				BackgroundTransparency = 1,
			}, box)
			make("UIPadding", {
				PaddingLeft = UDim.new(0, 10),
				PaddingRight = UDim.new(0, 10),
				PaddingTop = UDim.new(0, 2),
			}, body)
			local list = make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }, body)

			local function target()
				local s = math.max(uiScale.Scale, 0.01)
				return 38 + (open and (list.AbsoluteContentSize.Y / s + 14) or 0)
			end
			list:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
				if open then
					box.Size = UDim2.new(1, 0, 0, target())
				end
			end)

			local proxy = makeProxy(body)
			function proxy:Set(v)
				open = v == true
				tween(arrow, 0.25, { Rotation = open and 90 or 0 }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
				tween(box, 0.3, { Size = UDim2.new(1, 0, 0, target()) }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
			end
			function proxy:Get()
				return open
			end
			function proxy:SetTitle(v)
				title.Text = tostring(v)
			end
			if collapsible then
				local hit = make("TextButton", {
					Size = UDim2.new(1, 0, 0, 38),
					BackgroundTransparency = 1,
					Text = "",
					AutoButtonColor = false,
					ZIndex = 5,
				}, box)
				hit.MouseButton1Click:Connect(function()
					proxy:Set(not open)
				end)
			end
			task.defer(function()
				if not open then
					box.Size = UDim2.new(1, 0, 0, 38)
				end
			end)
			proxy.Instance = box
			return proxy
		end
