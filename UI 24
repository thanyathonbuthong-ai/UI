		UserInputService.InputChanged:Connect(function(input)
			if
				dragging
				and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch)
			then
				local delta = input.Position - dragStart
				local newX = startPos.X.Offset + delta.X
				local newY = startPos.Y.Offset + delta.Y

				-- กันลากหลุดจอ (คิดตาม scale ปัจจุบันของ UIScale)
				local screen = root.AbsoluteSize
				local halfW = (FINAL_W * uiScale.Scale) / 2
				local halfH = (FINAL_H * uiScale.Scale) / 2
				newX = math.clamp(newX, halfW - screen.X * startPos.X.Scale, screen.X * (1 - startPos.X.Scale) - halfW)
				newY = math.clamp(newY, halfH - screen.Y * startPos.Y.Scale, screen.Y * (1 - startPos.Y.Scale) - halfH)

				main.Position = UDim2.new(startPos.X.Scale, newX, startPos.Y.Scale, newY)
			end
		end)
	end

