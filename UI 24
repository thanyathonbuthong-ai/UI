		-- opts.Buttons = { { Title = "...", Callback = function() end }, ... }
		function Tab:AddButtonGroup(opts)
			opts = opts or {}
			local buttons = opts.Buttons or {}
			local count = math.max(#buttons, 1)
			local gap = 8

			local card = row(38)
			card.BackgroundTransparency = 1

			make("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, gap),
				SortOrder = Enum.SortOrder.LayoutOrder,
				VerticalAlignment = Enum.VerticalAlignment.Center,
			}, card)

			for i, b in ipairs(buttons) do
				local seg = make("Frame", {
					LayoutOrder = i,
					Size = UDim2.new(1 / count, -gap * (count - 1) / count, 1, 0),
					BackgroundColor3 = "card",
					BorderSizePixel = 0,
				}, card)
				round(seg, 8, "stroke")
				local lbl = text(seg, tostring(b.Title or ("Button " .. i)), 0, 0, 0, 38, 13, "text", Enum.TextXAlignment.Center)
				lbl.Size = UDim2.new(1, 0, 1, 0)
				local hit = make("TextButton", {
					Size = UDim2.new(1, 0, 1, 0),
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					AutoButtonColor = false,
					Text = "",
				}, seg)
				hit.MouseEnter:Connect(function()
					tween(seg, 0.15, { BackgroundColor3 = C.btn2Hover })
				end)
				hit.MouseLeave:Connect(function()
					tween(seg, 0.15, { BackgroundColor3 = C.card })
				end)
				pressFeel(hit, seg)
				hit.MouseButton1Click:Connect(function()
					if b.Callback then
						task.spawn(b.Callback)
					end
				end)
			end
			return { Instance = card }
