		-- ----- Steps: ตัวแสดงขั้นตอน (1 → 2 → 3) ใช้ :Set(n) เลื่อนขั้น -----
		function Tab:AddSteps(opts)
			opts = opts or {}
			local steps = opts.Steps or { "Step 1", "Step 2", "Step 3" }
			local n = math.max(#steps, 1)
			local current = math.clamp(tonumber(opts.Current or opts.Default) or 1, 1, n)
			local hasTitle = opts.Title and opts.Title ~= ""
			local top = hasTitle and 28 or 10
			local card = row(top + 44)
			if hasTitle then
				text(card, tostring(opts.Title), 14, 8, 240, 14, 11, "muted")
			end
			local holder = make("Frame", {
				Position = UDim2.new(0, 14, 0, top),
				Size = UDim2.new(1, -28, 0, 40),
				BackgroundTransparency = 1,
			}, card)
			local nodes, lines = {}, {}
			for i, label in ipairs(steps) do
				if i < n then
					lines[i] = make("Frame", {
						Position = UDim2.new((i - 0.5) / n, 14, 0, 9),
						Size = UDim2.new(1 / n, -28, 0, 2),
						BackgroundColor3 = "input",
						BorderSizePixel = 0,
					}, holder)
				end
			end
			for i, label in ipairs(steps) do
				local circle = make("TextLabel", {
					AnchorPoint = Vector2.new(0.5, 0),
					Position = UDim2.new((i - 0.5) / n, 0, 0, 0),
					Size = UDim2.new(0, 20, 0, 20),
					BackgroundColor3 = "input",
					Text = tostring(i),
					TextSize = 11,
					TextColor3 = C.muted,
					FontFace = FONT_BOLD,
					BorderSizePixel = 0,
					ZIndex = 2,
				}, holder)
				make("UICorner", { CornerRadius = UDim.new(1, 0) }, circle)
				local stroke = make("UIStroke", { Thickness = 1.5, Color = "stroke", ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, circle)
				local lbl = make("TextLabel", {
					AnchorPoint = Vector2.new(0.5, 0),
					Position = UDim2.new((i - 0.5) / n, 0, 0, 24),
					Size = UDim2.new(1 / n, -4, 0, 14),
					BackgroundTransparency = 1,
					Text = tostring(label),
					TextSize = 11,
					TextColor3 = C.muted,
					TextTruncate = Enum.TextTruncate.AtEnd,
					FontFace = FONT,
				}, holder)
				nodes[i] = { circle = circle, stroke = stroke, lbl = lbl }
			end
			local function render()
				for i, nd in ipairs(nodes) do
					local done, cur = i < current, i == current
					tween(nd.circle, 0.2, { BackgroundColor3 = (done or cur) and C.accent or C.input })
					nd.circle.Text = done and "✓" or tostring(i)
					tween(nd.circle, 0.2, { TextColor3 = (done or cur) and Color3.fromRGB(255, 255, 255) or C.muted })
					tween(nd.lbl, 0.2, { TextColor3 = cur and C.text or C.muted })
					if lines[i] then
						tween(lines[i], 0.25, { BackgroundColor3 = done and C.accent or C.input })
					end
				end
			end
			render()
			local api = {}
			function api:Set(v)
				current = math.clamp(math.floor(tonumber(v) or current), 1, n)
				render()
			end
			function api:Next()
				api:Set(current + 1)
			end
			function api:Prev()
				api:Set(current - 1)
			end
			function api:Get()
				return current
			end
			return api
		end

		-- ----- Table: ตารางข้อมูล (Columns + Rows) -----
		function Tab:AddTable(opts)
			opts = opts or {}
			local cols = opts.Columns or {}
			local ncol = math.max(#cols, 1)
			Tab._order += 1
			local card = make("Frame", {
				LayoutOrder = Tab._order,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundColor3 = "card",
				BorderSizePixel = 0,
				ClipsDescendants = true,
			}, page)
			round(card, 8, "stroke")
			make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, card)

			local function makeRow(order, values, isHeader, stripe)
				local r = make("Frame", {
					LayoutOrder = order,
					Size = UDim2.new(1, 0, 0, isHeader and 28 or 30),
					BackgroundColor3 = isHeader and "input" or "input",
					BackgroundTransparency = isHeader and 0 or (stripe and 0.6 or 1),
					BorderSizePixel = 0,
				}, card)
				for i = 1, ncol do
					local cell = make("TextLabel", {
						Position = UDim2.new((i - 1) / ncol, 0, 0, 0),
						Size = UDim2.new(1 / ncol, 0, 1, 0),
						BackgroundTransparency = 1,
						Text = tostring(values[i] ~= nil and values[i] or ""),
						TextSize = isHeader and 11 or 12,
						TextColor3 = isHeader and "muted" or "text",
						TextXAlignment = Enum.TextXAlignment.Left,
						TextTruncate = Enum.TextTruncate.AtEnd,
						FontFace = isHeader and FONT_BOLD or FONT,
					}, r)
					make("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 6) }, cell)
				end
				return r
			end
			makeRow(0, cols, true)
			local count = 0
			local api = {}
			function api:AddRow(values)
				count += 1
				makeRow(count, values, false, count % 2 == 0)
			end
			function api:Clear()
				for _, c in ipairs(card:GetChildren()) do
					if c:IsA("Frame") and c.LayoutOrder > 0 then
						c:Destroy()
					end
				end
				count = 0
			end
			function api:SetRows(rows)
				api:Clear()
				for _, v in ipairs(rows or {}) do
					api:AddRow(v)
				end
			end
			api:SetRows(opts.Rows)
			return api
		end

