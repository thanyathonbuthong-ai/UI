					end
					setRole(checkBox, "BackgroundColor3", selected[v] and "accent" or "input")
					tween(checkBox, 0.12, { BackgroundColor3 = selected[v] and C.accent or C.input })
					updateLabel()
					fire()
				end)
				optionChips[v] = checkBox
			end

			selectedBtn.MouseButton1Click:Connect(function()
				setOpen(not open)
			end)

			local api = {}
			function api:Set(list_, silent)
				selected = {}
				for _, v in ipairs(list_ or {}) do
					selected[v] = true
				end
				for v, chip in pairs(optionChips) do
					setRole(chip, "BackgroundColor3", selected[v] and "accent" or "input")
					chip.BackgroundColor3 = selected[v] and C.accent or C.input
				end
				updateLabel()
				fire(silent)
			end
			function api:Get()
				local out = {}
				for _, v in ipairs(values) do
					if selected[v] then
						out[#out + 1] = v
					end
				end
				return out
			end
			if opts.Flag then
				Window._registry[opts.Flag] = { get = api.Get, set = function(v)
					api:Set(v, true)
				end }
				Window.Flags[opts.Flag] = api
			end
			return api
		end

