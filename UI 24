		-- ----- Rating: ให้ดาว 1-N -----
		function Tab:AddRating(opts)
			opts = opts or {}
			local maxStars = math.clamp(tonumber(opts.Max) or 5, 1, 10)
			local value = math.clamp(tonumber(opts.Default) or 0, 0, maxStars)
			local card = row(38)
			text(card, tostring(opts.Title or "Rating"), 14, 0, 160, 38, 13, "text")
			local stars = {}
			local api = {}
			local function render()
				for i, s in ipairs(stars) do
					local on = i <= value
					tween(s, 0.15, { TextColor3 = on and C.warn or C.muted, TextTransparency = on and 0 or 0.5 })
				end
			end
			for i = 1, maxStars do
				local s = make("TextButton", {
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -12 - (maxStars - i) * 22, 0.5, 0),
					Size = UDim2.new(0, 20, 0, 24),
					BackgroundTransparency = 1,
					Text = "★",
					TextSize = 18,
					TextColor3 = C.muted,
					TextTransparency = 0.5,
					AutoButtonColor = false,
					FontFace = FONT,
				}, card)
				stars[i] = s
				s.MouseButton1Click:Connect(function()
					api:Set(value == i and 0 or i)
				end)
			end
			function api:Set(v, silent)
				value = math.clamp(math.floor(tonumber(v) or 0), 0, maxStars)
				render()
				if not silent and opts.Callback then
					task.spawn(opts.Callback, value)
				end
			end
			function api:Get()
				return value
			end
			render()
			registerFlag(opts, api)
			return api
		end

