		function Tab:AddTextarea(opts)
			opts = opts or {}
			local h = tonumber(opts.Height) or 90
			local maxLen = tonumber(opts.MaxLength)
			local card = row(h + 36)
			text(card, tostring(opts.Title or "Textarea"), 14, 8, 240, 14, 11, "muted")
			local counter = text(card, "", 0, 8, 70, 14, 11, "muted", Enum.TextXAlignment.Right)
			counter.Position = UDim2.new(1, -84, 0, 8)
			local shell = inputShell(card, 26, h)
			local box = make("TextBox", {
				Position = UDim2.new(0, 10, 0, 8),
				Size = UDim2.new(1, -20, 1, -16),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Text = tostring(opts.Default or ""),
				PlaceholderText = tostring(opts.Placeholder or ""),
				PlaceholderColor3 = C.muted,
				TextColor3 = C.text,
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextWrapped = true,
				MultiLine = true,
				ClearTextOnFocus = false,
				FontFace = FONT,
			}, shell)
			local function updateCounter()
				if maxLen then
					if #box.Text > maxLen then
						box.Text = box.Text:sub(1, maxLen)
						return
					end
					counter.Text = #box.Text .. "/" .. maxLen
				end
			end
			box:GetPropertyChangedSignal("Text"):Connect(updateCounter)
			updateCounter()
			box.FocusLost:Connect(function(enter)
				if opts.Callback then
					task.spawn(opts.Callback, box.Text, enter)
				end
			end)
			local api = {}
			function api:Set(v)
				box.Text = tostring(v)
			end
			function api:Get()
				return box.Text
			end
			registerFlag(opts, api)
			return api
		end

