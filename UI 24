			make("UICorner", { CornerRadius = UDim.new(1, 0) }, ringF)
			local stroke = make("UIStroke", { Thickness = 3, Color = "accent", ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, ringF)
			local grad = make("UIGradient", {
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0),
					NumberSequenceKeypoint.new(0.4, 0.15),
					NumberSequenceKeypoint.new(0.41, 1),
					NumberSequenceKeypoint.new(1, 1),
				}),
			}, stroke)
			local title = text(card, tostring(opts.Title or "Loading..."), 48, hasDesc and 8 or 0, 300, hasDesc and 18 or 42, 13, "text")
			local desc
			if hasDesc then
				desc = text(card, tostring(opts.Description), 48, 27, 300, 16, 11, "muted")
			end
			local spin
			local api = {}
			function api:Start()
				if spin then
					return
				end
				ringF.Visible = true
				grad.Rotation = 0
				spin = TweenService:Create(grad, TweenInfo.new(0.9, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1), { Rotation = 360 })
				spin:Play()
			end
			function api:Stop()
				if spin then
					spin:Cancel()
					spin = nil
				end
				ringF.Visible = false
			end
			function api:SetText(t, d)
				title.Text = tostring(t)
				if desc and d then
					desc.Text = tostring(d)
				end
			end
			if opts.AutoStart ~= false then
				api:Start()
			else
				ringF.Visible = false
			end
			return api
		end

		-- ----- Timer: นาฬิกานับขึ้น/นับถอยหลัง + ปุ่ม Start/Pause/Reset -----
		function Tab:AddTimer(opts)
			opts = opts or {}
			local down = tostring(opts.Mode or (opts.Duration and "down" or "up")):lower() == "down"
			local duration = tonumber(opts.Duration) or 0
			local card = row(42)
			text(card, tostring(opts.Title or "Timer"), 14, 0, 130, 42, 13, "text")
			local timeLbl = text(card, "", 0, 0, 86, 42, 15, "accent", Enum.TextXAlignment.Right)
			timeLbl.Position = UDim2.new(1, -196, 0, 0)
			timeLbl.FontFace = FONT_BOLD

			local function miniBtn(label, xOff)
				local b = make("TextButton", {
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, xOff, 0.5, 0),
					Size = UDim2.new(0, 50, 0, 26),
					BackgroundColor3 = "input",
					BorderSizePixel = 0,
					AutoButtonColor = false,
					Text = label,
					TextSize = 11,
					TextColor3 = C.text,
					FontFace = FONT,
				}, card)
				round(b, 7, "stroke")
				return b
			end
			local startBtn = miniBtn("Start", -68)
			local resetBtn = miniBtn("Reset", -12)

			local seconds = down and duration or 0
			local running = false
			local token = 0
			local function fmt(s)
				s = math.max(0, math.floor(s + 0.0001))
				local h, m, sec = s // 3600, (s % 3600) // 60, s % 60
				if h > 0 then
					return string.format("%d:%02d:%02d", h, m, sec)
				end
				return string.format("%02d:%02d", m, sec)
			end
			timeLbl.Text = fmt(seconds)

			local api = {}
			function api:Pause()
				running = false
				token += 1
				startBtn.Text = "Start"
			end
			function api:Start()
				if running then
					return
				end
				if down and seconds <= 0 then
					seconds = duration
				end
				running = true
				startBtn.Text = "Pause"
				token += 1
				local mine = token
				task.spawn(function()
					local last = os.clock()
					while running and mine == token do
						task.wait(0.1)
						local now = os.clock()
						local dt = now - last
						last = now
						seconds += down and -dt or dt
						if down and seconds <= 0 then
							seconds = 0
							timeLbl.Text = fmt(0)
							api:Pause()
							if opts.Callback then
								task.spawn(opts.Callback)
							end
							break
						end
						timeLbl.Text = fmt(seconds)
					end
				end)
			end
			function api:Reset()
				api:Pause()
				seconds = down and duration or 0
				timeLbl.Text = fmt(seconds)
			end
			function api:Set(v)
				seconds = math.max(0, tonumber(v) or 0)
				timeLbl.Text = fmt(seconds)
			end
			function api:Get()
				return seconds
			end
			startBtn.MouseButton1Click:Connect(function()
				if running then
					api:Pause()
				else
					api:Start()
				end
			end)
			resetBtn.MouseButton1Click:Connect(function()
				api:Reset()
			end)
			return api
		end

