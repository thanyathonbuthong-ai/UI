		-- ปุ่มเดียวสลับ 2 สถานะ (เช่น Start/Stop) เปลี่ยนทั้งสีพื้นและข้อความเองตามสถานะปัจจุบัน
		-- ต่างจาก Toggle ปกติตรงที่นี่คือ "ปุ่ม" ไม่ใช่สวิตช์ ไว้ใช้กับ action ที่ต้องกดเริ่ม/กดหยุด
		-- opts.Default (bool), opts.TextOn/TextOff (ข้อความตอน true/false), opts.OnVariant/opts.OffVariant
		-- ("Primary"|"Danger"|"Success"|"Warning", ค่าเริ่มต้น On=Danger/Off=Success), opts.Callback(value), opts.Flag
		function Tab:AddToggleButton(opts)
			opts = opts or {}
			local roleMap = { Primary = "accent", Danger = "error", Success = "success", Warning = "warn" }
			local value = opts.Default == true
			local onRole = roleMap[opts.OnVariant] or "error"
			local offRole = roleMap[opts.OffVariant] or "success"
			local onText = tostring(opts.TextOn or "Stop")
			local offText = tostring(opts.TextOff or "Start")

			local card = row(38)
			setRole(card, "BackgroundColor3", value and onRole or offRole)

			local titleLabel = text(card, value and onText or offText, 14, 0, 260, 38, 13, "text")
			titleLabel.FontFace = FONT_BOLD

			local function refresh()
				local role = value and onRole or offRole
				setRole(card, "BackgroundColor3", role)
				titleLabel.Text = value and onText or offText
				unbind(titleLabel, "TextColor3")
				titleLabel.TextColor3 = WHITE -- พื้นเป็นสีสดเสมอ (success/error/...) ตัวหนังสือขาวคงที่อ่านง่ายกว่า
			end
			refresh()

			local hit = make("TextButton", {
				Size = UDim2.new(1, 0, 1, 0),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = "",
			}, card)
			pressFeel(hit, card)

			local api = { Instance = card }
			function api:Set(v, silent)
				value = v == true
				tween(card, 0.15, { BackgroundColor3 = C[value and onRole or offRole] })
				refresh()
				if not silent and opts.Callback then
					task.spawn(opts.Callback, value)
				end
			end
			function api:Get()
				return value
			end
			hit.MouseButton1Click:Connect(function()
				api:Set(not value)
			end)

			if opts.Flag then
				Window._registry[opts.Flag] = {
					get = api.Get,
					set = function(v)
						api:Set(v, true)
					end,
				}
				Window.Flags[opts.Flag] = api
			end
			return api
		end

		-- ปุ่มมีตัวเลขแจ้งเตือน (Badge) มุมขวา ไว้บอกจำนวนของใหม่/แจ้งเตือนค้าง
		-- opts.Title, opts.Icon, opts.Badge (ตัวเลข/ข้อความ), opts.HideWhenZero, opts.Callback
