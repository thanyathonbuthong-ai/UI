			end)
		else
			-- spring the window open first, then fade the body back in using
			-- the snapshot taken before it was hidden
			tween(main, 0.45, { Size = UDim2.new(0, FINAL_W, 0, targetH) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			tween(content, 0.45, { Size = UDim2.new(0, FINAL_W, 0, targetH) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			task.delay(0.22, function()
				if savedBodyItems then
					fade(savedBodyItems, 1, 0.3)
					savedBodyItems = nil
				end
			end)
		end
	end
