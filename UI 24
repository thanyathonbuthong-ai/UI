		function Tab:AddSlider(opts)
			opts = opts or {}
			local min = tonumber(opts.Min) or 0
			local max = tonumber(opts.Max) or 100
			local step = tonumber(opts.Step) or 1
			local value = math.clamp(tonumber(opts.Default) or min, min, max)

			local card = row(48)
			text(card, tostring(opts.Title or "Slider"), 14, 6, 200, 16, 13, "text")
			local valueLabel = text(card, tostring(value), -60, 6, 46, 16, 12, "muted", Enum.TextXAlignment.Right)
			valueLabel.Position = UDim2.new(1, -60, 0, 6)

			local trackBg = frame(card, 14, 32, 0, 4, "input", 0)
			trackBg.Size = UDim2.new(1, -28, 0, 4)
			round(trackBg, 2)
			local fillFrame = frame(card, 14, 32, 0, 4, "accent", 0)
			round(fillFrame, 2)

			local function setFraction(fraction, silent)
				fraction = math.clamp(fraction, 0, 1)
				local raw = min + (max - min) * fraction
				raw = math.floor(raw / step + 0.5) * step
				raw = math.clamp(raw, min, max)
				value = raw
				valueLabel.Text = tostring(value)
				fillFrame.Size = UDim2.new(fraction, -28 * fraction, 0, 4)
				if not silent and opts.Callback then
					task.spawn(opts.Callback, value)
				end
			end
			setFraction((value - min) / math.max(max - min, 1e-6), true)

			local dragging = false
			local hit = make("TextButton", {
				Position = UDim2.new(0, 14, 0, 26),
				Size = UDim2.new(1, -28, 0, 16),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = "",
			}, card)
			local function update(inputPos)
				local abs = trackBg.AbsolutePosition.X
				local width = trackBg.AbsoluteSize.X
				setFraction((inputPos.X - abs) / math.max(width, 1))
			end
			hit.InputBegan:Connect(function(input)
				if
					input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch
				then
					dragging = true
					update(input.Position)
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if
					dragging
					and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch)
				then
					update(input.Position)
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = false
				end
			end)

			local api = {}
			function api:Set(v, silent)
				setFraction((math.clamp(v, min, max) - min) / math.max(max - min, 1e-6), silent)
			end
			function api:Get()
				return value
			end

			if opts.Flag then
				Window._registry[opts.Flag] = { get = api.Get, set = function(v)
					api:Set(v, true)
				end }
				Window.Flags[opts.Flag] = api
			end
			return api
		end

