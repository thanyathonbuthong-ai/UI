		-- ===== ProgressBar: display-only bar with a live :Set(value), e.g. HP / Distance =====
		function Tab:AddProgressBar(opts)
			opts = opts or {}
			local min = tonumber(opts.Min) or 0
			local max = tonumber(opts.Max) or 100
			local value = math.clamp(tonumber(opts.Default) or min, min, max)

			local card = row(46)
			text(card, tostring(opts.Title or "Progress"), 14, 6, 200, 16, 13, "text")
			local valueLabel = text(card, "", 0, 6, 60, 16, 12, "muted", Enum.TextXAlignment.Right)
			valueLabel.Position = UDim2.new(1, -74, 0, 6)
			valueLabel.Size = UDim2.new(0, 60, 0, 16)

			local trackBg = frame(card, 14, 30, 0, 8, "input", 0)
			trackBg.Size = UDim2.new(1, -28, 0, 8)
			round(trackBg, 4)
			local fillFrame = frame(card, 14, 30, 0, 8, "accent", 0)
			round(fillFrame, 4)

			local function colorForFraction(fraction)
				if fraction < 0.34 then
					return "error"
				elseif fraction < 0.67 then
					return "warn"
				else
					return "success"
				end
			end

			local function render()
				local fraction = math.clamp((value - min) / math.max(max - min, 1e-6), 0, 1)
				fillFrame.Size = UDim2.new(fraction, -28 * fraction, 0, 8)
				if opts.Suffix then
					valueLabel.Text = tostring(value) .. tostring(opts.Suffix)
				else
					valueLabel.Text = tostring(value) .. "/" .. tostring(max)
				end
				if opts.ColorByValue then
					local role = colorForFraction(fraction)
					setRole(fillFrame, "BackgroundColor3", role)
					fillFrame.BackgroundColor3 = C[role]
				end
			end
			render()

			local api = {}
			function api:Set(v)
				value = math.clamp(tonumber(v) or value, min, max)
				render()
			end
			function api:Get()
				return value
			end
			if opts.Flag then
				Window._registry[opts.Flag] = { get = api.Get, set = api.Set }
				Window.Flags[opts.Flag] = api
			end
			return api
		end

