				make("UIGradient", { Rotation = 90, Color = ColorSequence.new(preset[1], preset[2]) }, card)
			else
				setRole(card, "BackgroundColor3", "accent")
				-- เงาวาวโปร่งแสง (shine) พาดทแยง แทนที่จะไล่สีตรง ๆ จะได้เข้ากับทุกธีมอัตโนมัติ
				make("UIGradient", {
					Rotation = 90,
					Color = ColorSequence.new(WHITE, WHITE),
					Transparency = NumberSequence.new({
