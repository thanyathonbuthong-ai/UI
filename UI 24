	-- ===== filter: hides non-matching rows across every tab as the query changes =====
	local function rowMatchesQuery(row, query)
		for _, d in ipairs(row:GetDescendants()) do
			if (d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox")) and d.Text and d.Text ~= "" then
				if tostring(d.Text):lower():find(query, 1, true) then
					return true
				end
			end
		end
		return false
	end

	local function applySearchFilter(query)
		query = tostring(query or ""):lower()
		local activeHasMatch = true
		local firstMatchEntry = nil
		for _, t in ipairs(tabButtons) do
			local isActivePage = t.page.Visible
			local tabHasMatch = false
			for _, row in ipairs(t.page:GetChildren()) do
				if row:IsA("Frame") then
					local visible = query == "" or rowMatchesQuery(row, query)
					row.Visible = visible
					if visible then
						tabHasMatch = true
					end
				end
			end
			if isActivePage then
				activeHasMatch = (query == "") or tabHasMatch
			end
			if query ~= "" and tabHasMatch and not firstMatchEntry then
				firstMatchEntry = t
			end
		end
		if query ~= "" and not activeHasMatch and firstMatchEntry and firstMatchEntry.select then
			firstMatchEntry.select()
		end
	end

	searchBox:GetPropertyChangedSignal("Text"):Connect(function()
		local q = searchBox.Text
		searchClearBtn.Visible = q ~= ""
		applySearchFilter(q)
	end)
	searchClearBtn.MouseButton1Click:Connect(function()
