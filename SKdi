    State.isStealing = true
    local startTime = tick()
    stealStartTime = startTime  -- exposed so the inline progress bar in the Combat tab can read it

    task.spawn(function()
        for _, f in ipairs(data.hold) do pcall(f) end
        while tick() - startTime < Steal.StealDuration do
            local elapsed = tick() - startTime
            local p = math.clamp(elapsed / Steal.StealDuration, 0, 1)
            if progressFill then progressFill.Size = UDim2.new(p, 0, 1, 0) end
            if progressPct then progressPct.Text = math.floor(p * 100) .. "%" end
            task.wait()
        end
