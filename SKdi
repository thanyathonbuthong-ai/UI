local _savedCfg = nil
local function loadConfigKeys()
	local has = false
	pcall(function() has = _isfile(CONFIG_FILE) end)
	if not has then return end
	local raw; pcall(function() raw = _readfile(CONFIG_FILE) end)
	if not raw then return end
	local ok,cfg=pcall(function() return HS:JSONDecode(raw) end)
	if not ok or not cfg then return end
	_savedCfg=cfg
	local function lk(e,d) if type(d)~="table" then return end;if d.kb and Enum.KeyCode[d.kb] then e.kb=Enum.KeyCode[d.kb] end;if d.gp and Enum.KeyCode[d.gp] then e.gp=Enum.KeyCode[d.gp] end end
	lk(KB.DropBrainrot,cfg.dropBrainrotKey);lk(KB.AutoLeft,cfg.autoLeftKey);lk(KB.AutoRight,cfg.autoRightKey)
	lk(KB.AutoBat,cfg.autoBatKey);lk(KB.LaggerToggle,cfg.laggerToggleKey)
	lk(KB.TPFloor,cfg.tpFloorKey);lk(KB.InstaReset,cfg.instaResetKey);lk(KB.GuiHide,cfg.guiHideKey);lk(KB.SpeedToggle,cfg.speedToggleKey)
	if cfg.normalSpeed then NS=cfg.normalSpeed end
	if cfg.carrySpeed then CS=cfg.carrySpeed end
	if cfg.grabRadius and type(cfg.grabRadius)=="number" then Steal.StealRadius=cfg.grabRadius else Steal.StealRadius=60 end
	if cfg.stealDuration and type(cfg.stealDuration)=="number" then Steal.StealDuration=cfg.stealDuration else Steal.StealDuration=1.4 end
	if cfg.laggerSpeed and type(cfg.laggerSpeed)=="number" then LAGGER_SPEED=cfg.laggerSpeed end
	if cfg.laggerCarrySpeed and type(cfg.laggerCarrySpeed)=="number" then LAGGER_CARRY_SPEED=cfg.laggerCarrySpeed end
	if cfg.autoTPHeight and type(cfg.autoTPHeight)=="number" then autoTPHeight=cfg.autoTPHeight end
	if cfg.uiScale and type(cfg.uiScale)=="number" then
		-- Rescue the user on startup if their saved UI scale is huge (> 1.3)
		blessedUiScale = (cfg.uiScale > 1.3) and 1.0 or math.clamp(cfg.uiScale, 0.5, 1.25)
	end
	if cfg.autoSwing~=nil then autoSwingEnabled=cfg.autoSwing==true end
	-- Restore the actual boolean state vars BEFORE buildGui() runs, so each
	-- mkToggle/mkCycle row renders pre-flipped to the saved state (the
	-- previous `default` parameter was reading hard-coded `false`). The
	-- side-effecting starts (startESP, startAutoTP, etc.) still happen in
	-- loadConfigState after buildGui finishes, because they need the visual
	-- setters to exist.
	if cfg.antiRagdoll        ~= nil then antiRagdollEnabled    = cfg.antiRagdoll        == true end
	if cfg.autoStealEnabled   ~= nil then Steal.AutoStealEnabled = cfg.autoStealEnabled  == true end
	if cfg.infiniteJump       ~= nil then infJumpEnabled        = cfg.infiniteJump       == true end
	if cfg.infJumpMode == "Hold" or cfg.infJumpMode == "Tap" then infJumpMode = cfg.infJumpMode end
	if cfg.medusaCounter      ~= nil then medusaCounterEnabled  = cfg.medusaCounter      == true end
	if cfg.batCounter         ~= nil then batCounterEnabled     = cfg.batCounter         == true end
	if cfg.laggerMode         ~= nil then
		laggerToggled = cfg.laggerMode == true
		laggerPhase   = laggerToggled and 1 or 0
	end
	if cfg.autoTPEnabled      ~= nil then autoTPEnabled         = cfg.autoTPEnabled      == true end
	if cfg.autoBat            ~= nil then autoBatEnabled        = cfg.autoBat            == true end
	if cfg.unwalkEnabled      ~= nil then unwalkEnabled         = cfg.unwalkEnabled      == true end
	if cfg.antiLag            ~= nil then antiLagEnabled        = cfg.antiLag            == true end
	if cfg.stretchRez         ~= nil then stretchRezEnabled     = cfg.stretchRez         == true end
	if cfg.highlightESP       ~= nil then highlightESPEnabled   = cfg.highlightESP       == true end
	if cfg.boxESP             ~= nil then playerESPBoxEnabled   = cfg.boxESP             == true end
	if cfg.autoPlayWaypointESP~= nil then autoPlayWaypointESP   = cfg.autoPlayWaypointESP== true end
	if cfg.autoResetOnMedusa ~= nil then Flower.autoResetOnMedusa   = cfg.autoResetOnMedusa == true end
	if cfg.ragdollTimer      ~= nil then Flower.ragdollTimerEnabled = cfg.ragdollTimer      == true end
	if cfg.guiLocked ~= nil then guiLocked = cfg.guiLocked == true
	elseif cfg.lockGui ~= nil then guiLocked = cfg.lockGui == true
	elseif cfg.lock_gui ~= nil then guiLocked = cfg.lock_gui == true
	elseif cfg.guiLock ~= nil then guiLocked = cfg.guiLock == true
	elseif cfg.lockGUI ~= nil then guiLocked = cfg.lockGUI == true
	end
	if cfg.autoPlayMode == "Full" or cfg.autoPlayMode == "Half" or cfg.autoPlayMode == "Semi" then
		autoPlayMode = cfg.autoPlayMode
	end
	if cfg.autoPlaySide == "Auto" or cfg.autoPlaySide == "Left" or cfg.autoPlaySide == "Right" then
		autoPlaySide = cfg.autoPlaySide
	end
	if cfg.autoPlayAutoToggle ~= nil then autoPlayAutoToggle    = cfg.autoPlayAutoToggle == true end
	-- AutoPlay offsets + cooldown (need to be applied before buildGui so the
	-- side Settings rows render with the saved values already in them).
	if type(cfg.autoPlayOffsets) == "table" and AP.offsets then
		for _,name in ipairs({"Point1","Point2","Point3","Point4","Point5"}) do
			local o = cfg.autoPlayOffsets[name]
			if type(o) == "table" then
				AP.offsets[name] = AP.offsets[name] or {x=0,z=0}
				if type(o.x) == "number" then AP.offsets[name].x = o.x end
				if type(o.z) == "number" then AP.offsets[name].z = o.z end
			end
		end
	end
	if type(cfg.autoPlayCooldown) == "number" and AP.cooldownRef then
		AP.cooldownRef.set(cfg.autoPlayCooldown)
	end
	-- Remember saved positions so saveConfig() can keep echoing them even
	-- before buildGui() wires up the live frame refs, and so loadConfigState()
	-- can apply them after the frames exist.
	if type(cfg.positions) == "table" then UI.savedPositions = cfg.positions end
end
local function loadConfigState()
	local cfg=_savedCfg;if not cfg then return end
	if refreshSpeedCustomizerPanel then pcall(refreshSpeedCustomizerPanel) end
	if normalBox then normalBox.Text=tostring(NS) end
	if carryBox then carryBox.Text=tostring(CS) end
	if radInput then radInput.Text=tostring(Steal.StealRadius) end
	if progressRadLbl then progressRadLbl.Text=string.format("Radius: %.2g",Steal.StealRadius) end
	if laggerBox then laggerBox.Text=tostring(LAGGER_SPEED) end
	if laggerCarryBox then laggerCarryBox.Text=tostring(LAGGER_CARRY_SPEED) end
	if autoTPHeightBox then autoTPHeightBox.Text=tostring(autoTPHeight) end

	-- Sync all toggle VISUALS immediately so what the user sees matches
	-- what's actually enabled (loadConfigKeys already flipped the booleans
	-- before buildGui ran). Each in its own pcall so one missing setter
	-- can't kill the rest of the restore.
	local function sync(setter, val) if setter then pcall(setter, val, true) end end
	sync(setAntiRagVisual,       antiRagdollEnabled)
	sync(setInstaGrab,           Steal.AutoStealEnabled)
	sync(setInfJumpVisual,       infJumpEnabled)
	sync(setMedusaVisual,        medusaCounterEnabled)
	sync(setBatCounterVisual,    batCounterEnabled)
	sync(setAutoTPVisual,        autoTPEnabled)
	sync(setAutoSwingVisual,     autoSwingEnabled)
	sync(autoBatSetVisual,       autoBatEnabled)
	sync(setUnwalkVisual,        unwalkEnabled)
	sync(setAntiLagVisual,       antiLagEnabled)
	sync(setStretchRezVisual,    stretchRezEnabled)
	sync(setHighlightESPVisual,  highlightESPEnabled)
	sync(setBoxESPVisual,        playerESPBoxEnabled)
	sync(setWaypointESPVisual,   autoPlayWaypointESP)
	sync(updateLockVisuals,      guiLocked)
	if refreshSpeedModeLabel then pcall(refreshSpeedModeLabel) end

	-- Restore window / panel positions synchronously (no deferred spawn);
	-- frame refs exist by now because buildGui ran before loadConfigState.
	if type(UI.savedPositions) == "table" then
		pcall(function() _applyPos(UI.mainFrame,     UI.savedPositions.main)         end)
		pcall(function() _applyPos(UI.miniBtn,       UI.savedPositions.mini)         end)
		pcall(function() _applyPos(UI.mbPanel,       UI.savedPositions.mbPanel)      end)
		pcall(function() _applyPos(UI.speedPanel,    UI.savedPositions.speed)        end)
		pcall(function() _applyPos(UI.settingsPanel, UI.savedPositions.settings)     end)
		pcall(function() _applyPos(UI.ragdollTimer,  UI.savedPositions.ragdollTimer) end)
	end

	-- Side-effecting starts (run engines that the toggles control). Each in
	-- its own pcall so a missing function on this executor doesn't kill the
	-- whole restore chain.
	task.spawn(function()
		task.wait(0.15)
		if antiRagdollEnabled    then pcall(startAntiRagdoll) end
		if Steal.AutoStealEnabled then pcall(startAutoSteal)   end
		if medusaCounterEnabled or Flower.autoResetOnMedusa then pcall(setupMedusa, LP.Character) end
		if batCounterEnabled     then pcall(startBatCounter)   end
		if autoTPEnabled         then pcall(startAutoTP)       end
		if autoBatEnabled        then pcall(queueAutoBatStart) end
		if unwalkEnabled         then task.spawn(function() task.wait(0.5); pcall(startUnwalk) end) end
		if antiLagEnabled        then pcall(enableAntiLag)     end
		if stretchRezEnabled     then pcall(enableStretchRez)  end
		if cfg.currentSkyMode    then pcall(CandyApplyCustomSky, cfg.currentSkyMode); _G._CandyHubSkyMode=cfg.currentSkyMode end
		if highlightESPEnabled   then pcall(startESP)          end
		if playerESPBoxEnabled   then pcall(startESPBox)       end
		if autoPlayWaypointESP and updateWaypointESP then pcall(updateWaypointESP) end
		-- Note: autoPlayEnabled is intentionally NOT auto-resumed on load
		-- because routes assume the player just spawned at a plot start.
	end)
end

