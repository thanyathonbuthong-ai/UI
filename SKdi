local function getActiveMoveSpeed(hum)
	-- Blessed Hub speed logic with safer carry detection:
	-- Normal/Lagger is selected manually; Carry speed only applies when brainrot/carry markers exist
	-- or when the game lowers WalkSpeed below 25 to something other than default 16.
	local char = LP.Character
	local carrying = false
	if char and hum then
		local function hasCarryMarker(obj)
			local n = tostring(obj and obj.Name or ""):lower()
			return n:find("brainrot") or n:find("brain") or n:find("animal") or n:find("carry") or n:find("stolen") or n:find("held") or n:find("steal")
		end
		for _, obj in ipairs(char:GetChildren()) do
			if hasCarryMarker(obj) then carrying = true; break end
		end
		for _, attr in ipairs({"Carrying","Carry","Stealing","IsStealing","HasBrainrot"}) do
			if char:GetAttribute(attr) == true or hum:GetAttribute(attr) == true then carrying = true end
		end
		local ws = tonumber(hum.WalkSpeed) or 16
		if ws > 0 and ws < 25 and math.abs(ws - 16) > 0.05 then carrying = true end
	end
	if laggerToggled then
		return carrying and LAGGER_CARRY_SPEED or LAGGER_SPEED
	end
	return carrying and CS or NS
end
local function getAutoPathSpeed()
	return laggerToggled and LAGGER_SPEED or NS
end
