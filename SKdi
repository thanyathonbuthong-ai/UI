    local function makeBlessedBtn(label, col, row, wCols)
        -- Polished quick button: deeper dark base when idle, bright pink
        -- fill + glow stroke + drop shadow when active or hovered. Uses
        -- a vertical UIGradient for a subtle top-light effect.
        wCols = wCols or 1
        local w = wCols * MB_W + (wCols - 1) * MB_PAD
        local x = MB_PAD + col * (MB_W + MB_PAD)
        local y = MB_PAD + row * (MB_H + MB_PAD)

        local btn = Instance.new("TextButton", mbPanel)
        btn.Size = UDim2.new(0, w, 0, MB_H)
        btn.Position = UDim2.new(0, x, 0, y)
        btn.BackgroundColor3 = Color3.fromRGB(12, 60, 185)   -- reversed: button idle is Royal Blue
        btn.BackgroundTransparency = 0
        btn.BorderSizePixel = 0
        btn.Text = label
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)       -- crisp white text
        btn.TextStrokeTransparency = 1
        btn.Font = Enum.Font.GothamBlack
        btn.TextSize = 10
        btn.TextWrapped = true
        btn.ZIndex = 151
        btn.AutoButtonColor = false
        mkCorner(btn, 10)

        local st = mkStroke(btn, Color3.fromRGB(100, 150, 255), 1.5, 0.2)

        local shadow = Instance.new("ImageLabel", btn)
        shadow.Name = "Shadow"
        shadow.AnchorPoint = Vector2.new(0.5, 0.5)
        shadow.Size = UDim2.new(1, 14, 1, 14)
        shadow.Position = UDim2.new(0.5, 0, 0.5, 2)
        shadow.BackgroundTransparency = 1
        shadow.Image = "rbxasset://textures/ui/Controls/DropShadow.png"
        shadow.ImageColor3 = Color3.fromRGB(0, 0, 0)
        shadow.ImageTransparency = 0.65
        shadow.ScaleType = Enum.ScaleType.Slice
        shadow.SliceCenter = Rect.new(12, 12, 244, 244)
        shadow.ZIndex = 150

        local active = false
        local function setActive(on)
            active = on
            if on then
                tw(btn, {
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255),  -- reversed: active is White
                    TextColor3 = Color3.fromRGB(12, 60, 185),          -- royal blue text
                }, 0.16)
                st.Color = Color3.fromRGB(12, 60, 185)
                st.Transparency = 0
                st.Thickness = 2
                shadow.ImageColor3 = Color3.fromRGB(12, 60, 185)
                shadow.ImageTransparency = 0.45
            else
                tw(btn, {
                    BackgroundColor3 = Color3.fromRGB(12, 60, 185),
                    TextColor3 = Color3.fromRGB(255, 255, 255),
                }, 0.16)
                st.Color = Color3.fromRGB(100, 150, 255)
                st.Transparency = 0.2
                st.Thickness = 1.5
                shadow.ImageColor3 = Color3.fromRGB(0, 0, 0)
                shadow.ImageTransparency = 0.65
            end
        end

        btn.MouseEnter:Connect(function()
            if active then return end
            tw(btn, {BackgroundColor3 = Color3.fromRGB(20, 80, 220)}, 0.1)
            st.Transparency = 0.1
        end)
        btn.MouseLeave:Connect(function()
            if active then return end
            tw(btn, {BackgroundColor3 = Color3.fromRGB(12, 60, 185)}, 0.1)
            st.Transparency = 0.2
        end)
        btn.MouseButton1Down:Connect(function()
            tw(btn, {Size = UDim2.new(0, w-2, 0, MB_H-2)}, 0.06)
        end)
        btn.MouseButton1Up:Connect(function()
            tw(btn, {Size = UDim2.new(0, w, 0, MB_H)}, 0.08)
        end)

        return {frame = btn, clk = btn, setActive = setActive, getActive = function() return active end}
    end

