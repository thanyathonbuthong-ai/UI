-- RAGDOLL TIMER ENGINE (Blessed Hub port)
-- Wrapped in an IIFE so its 3 helpers (startRagdollTimer, the connection
-- list, attachRagdollTimerHook) don't share the top-level 200-register
-- budget. Only attachRagdollTimerHook is exposed via a forward upvalue.
-- ============================================================
local attachRagdollTimerHook
;(function()
local _ragdollTimerTask = nil
local function startRagdollTimer(hum)
	if not Flower.ragdollTimerEnabled then return end
	if Flower.ragdollTimerActive then return end
	if not (Flower.ragdollTimerFrame and Flower.ragdollTimerLabel) then return end
	Flower.ragdollTimerActive = true
	_ragdollTimerTask = task.spawn(function()
		local countdown = 3
		Flower.ragdollTimerFrame.Visible = true
		Flower.ragdollTimerLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
		while countdown > 0 do
			if not (hum and hum.Parent and hum.Health > 0) then break end
			local st = hum:GetState()
			if st ~= Enum.HumanoidStateType.Physics
			and st ~= Enum.HumanoidStateType.Ragdoll
			and st ~= Enum.HumanoidStateType.FallingDown
			and not hum.PlatformStand then
				break
			end

			Flower.ragdollTimerLabel.Text = "WAIT: " .. tostring(countdown)
			task.wait(1)
			countdown = countdown - 1
			if countdown == 1 and Steal.AutoStealEnabled then
				task.spawn(function()
					local p = findNearestPrompt and findNearestPrompt()
					if p and executeSteal then pcall(executeSteal, p) end
				end)
			end
		end
		if countdown == 0 and hum and hum.Parent and hum.Health > 0 then
			Flower.ragdollTimerLabel.Text = "GRAB!"
			Flower.ragdollTimerLabel.TextColor3 = Color3.fromRGB(80, 255, 120)
			task.wait(0.5)
		end
		Flower.ragdollTimerFrame.Visible = false
		if Flower.ragdollTimerEnabled then Flower.ragdollTimerLabel.Text = "" end
		Flower.ragdollTimerActive = false
		_ragdollTimerTask = nil
	end)
end
local _ragdollStateConns = {}
attachRagdollTimerHook = function(char)
	for _,c in ipairs(_ragdollStateConns) do pcall(function() c:Disconnect() end) end
	_ragdollStateConns = {}
	if not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	local debounce = false
	table.insert(_ragdollStateConns, hum.StateChanged:Connect(function(_,newState)
		if debounce then return end
		if newState == Enum.HumanoidStateType.Physics
		or newState == Enum.HumanoidStateType.Ragdoll
		or newState == Enum.HumanoidStateType.FallingDown then
			debounce = true
			task.spawn(function()
				task.wait(0.15)
				if hum and hum.Parent and hum.Health > 0 then
					local st = hum:GetState()
					if st == Enum.HumanoidStateType.Physics
					or st == Enum.HumanoidStateType.Ragdoll
					or st == Enum.HumanoidStateType.FallingDown
					or hum.PlatformStand then
						startRagdollTimer(hum)
					end
				end
				task.wait(0.5)
				debounce = false
			end)
		end
	end))
end
end)()

