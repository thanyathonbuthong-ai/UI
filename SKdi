local quickBtnImgAsset = ""
local function initQuickBtnAsset()
    local b64 = ""
    local fname = "Blessed_QuickBtnBg.jpeg"
    local _isfile = isfile or (syn and syn.isfile) or function() return false end
    local _writefile = writefile or (syn and syn.writefile) or function() end
    local _getcustomasset = getcustomasset or getsynasset
    if _getcustomasset then
        if not _isfile(fname) then
            local function dec(data)
                local b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
                data = string.gsub(data, '[^'..b..'=]', '')
                return (data:gsub('.', function(x)
                    if x == '=' then return '' end
                    local r,f = '', (b:find(x)-1)
                    for i=6,1,-1 do r=r..(f%2^i-f%2^(i-1)>0 and '1' or '0') end
                    return r;
                end):gsub('%d%d%d?%d?%d?%d?%d?%d?', function(x)
                    if (#x ~= 8) then return '' end
                    local c=0
                    for i=1,8 do c=c+(x:sub(i,i)=='1' and 2^(8-i) or 0) end
                    return string.char(c)
                end))
            end
            local decoded = nil
            if base64_decode then pcall(function() decoded = base64_decode(b64) end) end
            if not decoded and crypt and crypt.base64decode then pcall(function() decoded = crypt.base64decode(b64) end) end
            if not decoded and crypt and crypt.base64 and crypt.base64.decode then pcall(function() decoded = crypt.base64.decode(b64) end) end
            if not decoded and syn and syn.crypt and syn.crypt.base64 and syn.crypt.base64.decode then pcall(function() decoded = syn.crypt.base64.decode(b64) end) end
            if not decoded then pcall(function() decoded = dec(b64) end) end
            if decoded then _writefile(fname, decoded) end
        end
        pcall(function() quickBtnImgAsset = _getcustomasset(fname) end)
    end
end
