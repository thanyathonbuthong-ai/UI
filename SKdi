-- Helpers used by all three "queue" starts to enforce mutual exclusivity
-- with Auto Play, Auto L/R, and Auto Bat. These three (_cancelAutoPlay,
-- queueAutoLeftStart, queueAutoRightStart) were lost when the Auto Bat
-- block got wholesale-replaced with Envy's port; restoring them here so
-- the Combat-tab Auto Bat toggle, the Move-tab Auto L/R toggles, the
-- keybinds, and the right-side quick buttons all stop hitting nil
-- globals when clicked.
local function _cancelAutoPlay()
    if autoPlayEnabled then
        autoPlayEnabled = false
        if stopAutoPlay then pcall(stopAutoPlay) end
        if setAutoPlayVisual then setAutoPlayVisual(false, true) end
    end
end
local function queueAutoLeftStart()
    autoLeftEnabled = true
    _cancelAutoPlay()
    if autoRightEnabled then autoRightEnabled=false; if autoRightSetVisual then autoRightSetVisual(false) end; if stopAutoRight then stopAutoRight() end end
    if autoBatEnabled then disableAutoBat(); if autoBatSetVisual then autoBatSetVisual(false) end end
    if startAutoLeft then startAutoLeft() end
end
local function queueAutoRightStart()
    autoRightEnabled = true
    _cancelAutoPlay()
    if autoLeftEnabled then autoLeftEnabled=false; if autoLeftSetVisual then autoLeftSetVisual(false) end; if stopAutoLeft then stopAutoLeft() end end
    if autoBatEnabled then disableAutoBat(); if autoBatSetVisual then autoBatSetVisual(false) end end
    if startAutoRight then startAutoRight() end
end
queueAutoBatStart = function()
    _cancelAutoPlay()
    if autoLeftEnabled then autoLeftEnabled=false; if autoLeftSetVisual then autoLeftSetVisual(false) end; if stopAutoLeft then stopAutoLeft() end end
    if autoRightEnabled then autoRightEnabled=false; if autoRightSetVisual then autoRightSetVisual(false) end; if stopAutoRight then stopAutoRight() end end
