AP.capture = function(pointName)
    local char = LP.Character; if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart"); if not root then return false end
    if not AutoPlayState.detectedSpawn then
        updateSpawnFromPlot()
        if not AutoPlayState.detectedSpawn then return false end
    end
    local baseRoute = (AutoPlayState.detectedSpawn == 1) and routes.START_B or routes.START_A
    local invertZ = (AutoPlayState.detectedSpawn == 1)
    local original
