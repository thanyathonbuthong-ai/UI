    local dx = root.Position.X - original.X
    local dz = root.Position.Z - original.Z
    if invertZ then dz = -dz end
    AutoPlayState.offsets[pointName] = AutoPlayState.offsets[pointName] or {x=0,z=0}
    AutoPlayState.offsets[pointName].x = dx
    AutoPlayState.offsets[pointName].z = dz
    return true
end

