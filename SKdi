    if myRouteId ~= AutoPlayState.currentRouteId then return end
    moveToPoint(route.Route[2], getFastSpeed)
    if myRouteId ~= AutoPlayState.currentRouteId then return end
    moveToPoint(route.Route[3], getFastSpeed)
    if myRouteId ~= AutoPlayState.currentRouteId then return end

    local mode = State.autoPlayMode or "Full"
    if mode == "Semi" then
        clearAutoWalkParts()
        AutoPlayState.routeRunning = false
        blockMovement(false)
        if State.autoPlayAutoToggle ~= false then
            State.autoPlayEnabled = false
            if setAutoPlayFloat then setAutoPlayFloat(false) end
            if toggleRefs and toggleRefs.autoPlay then toggleRefs.autoPlay(false) end
        end
        return
    end

    if AutoPlayState.cooldown > 0 then task.wait(AutoPlayState.cooldown) end
    if myRouteId ~= AutoPlayState.currentRouteId then return end

    if mode == "Half" then
        moveToPoint(route.Route[2], getStealSpeed)
        if myRouteId ~= AutoPlayState.currentRouteId then return end
        clearAutoWalkParts()
        AutoPlayState.routeRunning = false
        blockMovement(false)
        if State.autoPlayAutoToggle ~= false then
            State.autoPlayEnabled = false
            if setAutoPlayFloat then setAutoPlayFloat(false) end
            if toggleRefs and toggleRefs.autoPlay then toggleRefs.autoPlay(false) end
        end
        return
    end

    moveToPoint(route.Route[2], getStealSpeed)
    if myRouteId ~= AutoPlayState.currentRouteId then return end
    moveToPoint(route.Route[1], getStealSpeed)
    if myRouteId ~= AutoPlayState.currentRouteId then return end

    if route.Route[4] then
        moveToPoint(route.Route[4], getStealSpeed)
    end
    if myRouteId ~= AutoPlayState.currentRouteId then return end

    moveToPoint(route.StartPoint, getStealSpeed)
    clearAutoWalkParts()
    AutoPlayState.routeRunning = false
    blockMovement(false)
    if State.autoPlayAutoToggle ~= false then
        State.autoPlayEnabled = false
        if setAutoPlayFloat then setAutoPlayFloat(false) end
        if toggleRefs and toggleRefs.autoPlay then toggleRefs.autoPlay(false) end
    end
end

local function buildRouteFromTextboxes(originalRoute)
    local newRoute = { Route = {}, StartPoint = nil }
    local invertZ = (AutoPlayState.detectedSpawn == 1)
    for i = 1, 4 do
        local original = originalRoute.Route[i]
        local offsetX = AutoPlayState.offsets["Point"..i].x
        local offsetZ = AutoPlayState.offsets["Point"..i].z
        if invertZ then offsetZ = -offsetZ end
        table.insert(newRoute.Route, Vector3.new(
            original.X + offsetX,
            original.Y,
            original.Z + offsetZ
        ))
    end
    local baseStart = originalRoute.StartPoint
    local offsetX = AutoPlayState.offsets.Point5.x
    local offsetZ = AutoPlayState.offsets.Point5.z
    if invertZ then offsetZ = -offsetZ end
    newRoute.StartPoint = Vector3.new(
        baseStart.X + offsetX,
        baseStart.Y,
        baseStart.Z + offsetZ
    )
    return newRoute
end

playAutoPlaySequence = function()
    if AutoPlayState.routeRunning then
        AutoPlayState.routeRunning = false
        AutoPlayState.currentRouteId = AutoPlayState.currentRouteId + 1
        clearAutoWalkParts()
        blockMovement(false)
        return false
    end
    if not AutoPlayState.detectedSpawn then
        updateSpawnFromPlot()
        if not AutoPlayState.detectedSpawn then
            return false
        end
    end
    local route
    if AutoPlayState.detectedSpawn == 1 then
        route = routes.START_B
    elseif AutoPlayState.detectedSpawn == 2 then
        route = routes.START_A
    else
        return false
    end
    AutoPlayState.currentRouteId = AutoPlayState.currentRouteId + 1
    AutoPlayState.routeRunning = true

    local customRoute = buildRouteFromTextboxes(route)
    drawRoute(customRoute)
    task.spawn(function()
        walkRoute(customRoute)
        if AutoPlayState.routeRunning then
            AutoPlayState.routeRunning = false
        end
    end)
    return true
end

startAutoPlayTracking = function()
    task.spawn(function()
        while State.autoPlayEnabled do
            task.wait(2)
            updateSpawnFromPlot()
            if AutoPlayState.detectedSpawn and State.autoPlayWaypointESP then
                updateWaypointESP()
            end
        end
    end)
end

stopAutoPlay = function()
    clearWaypointSpheres()
    clearAutoWalkParts()
    if AutoPlayState.routeRunning then
        AutoPlayState.routeRunning = false
        AutoPlayState.currentRouteId = AutoPlayState.currentRouteId + 1
