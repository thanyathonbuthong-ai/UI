	if preset.clouds and terrain then
		candyInstance("Clouds",terrain,{
			Cover=preset.clouds.cover or 0.5,
			Density=preset.clouds.dens or 0.5,
			Color=candyColor(preset.clouds.color)
		})
	end

	_G._CandyHubSkyMode=mode
