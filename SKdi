local function _charBox(char, cam)
    local hrpP = char:FindFirstChild("HumanoidRootPart"); if not hrpP then return nil end
    local rootPos = hrpP.Position
    local topPos    = rootPos + Vector3.new(0,3.5,0)
    local bottomPos = rootPos - Vector3.new(0,3.0,0)
    local topScreen,    visTop    = cam:WorldToViewportPoint(topPos)
    local bottomScreen, visBottom = cam:WorldToViewportPoint(bottomPos)
