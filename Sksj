		subLabel.Text = t
		badge.Visible = t ~= ""
	end
	function Window:SetUser(t)
		userLabel.Text = string.upper(t)
	end
	function Window:SetToggleKey(k)
		Window.ToggleKey = k
	end
	function Window:SelectTab(tab)
		if type(tab) == "string" then
			for _, t in ipairs(Window.Tabs) do
				if t.Name == tab then
					tab = t
					break
				end
			end
		end
		if type(tab) ~= "table" then
			return
		end
		for _, t in ipairs(Window.Tabs) do
			local active = t == tab
			t.Page.Visible = active
			Tween(t.Button, 0.15, { BackgroundColor3 = active and Theme.TabActive or Theme.Tab })
			Tween(t.Bar, 0.15, { BackgroundTransparency = active and 0 or 1 })
			t.NameLabel.TextColor3 = active and Theme.Accent or Theme.SubText
			t.IconLabel.TextColor3 = active and Theme.Accent or Theme.SubText
		end
		Window.ActiveTab = tab
	end

	closeBtn.MouseButton1Click:Connect(function()
		Window:Destroy()
	end)
	minBtn.MouseButton1Click:Connect(function()
		Window:Minimize()
	end)

	-- AddTab
	function Window:AddTab(t)
		if type(t) == "string" then
			t = { Name = t }
		end
		local Tab = { Name = t.Name or "Tab", Window = Window, _n = 0 }

		local btn = Create("TextButton", {
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = Theme.Tab,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 36),
			LayoutOrder = #Window.Tabs + 1,
			Parent = tabList,
		})
		local bar = Create("Frame", {
			BackgroundColor3 = Theme.Accent,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.new(0, 2, 0, 22),
			Parent = btn,
		})
		local iconLabel
		local icon = t.Icon
		if type(icon) == "string" and (icon:find("rbxassetid://") or icon:find("^rbxasset")) then
			local img = Create("ImageLabel", {
				BackgroundTransparency = 1,
				Image = icon,
				ImageColor3 = Theme.SubText,
				Position = UDim2.new(0, 12, 0.5, -8),
				Size = UDim2.new(0, 16, 0, 16),
				Parent = btn,
			})
			-- ให้ใช้ .TextColor3 ได้เหมือนกัน
			iconLabel = setmetatable({}, {
				__newindex = function(_, k, v)
					if k == "TextColor3" then
						img.ImageColor3 = v
					end
				end,
			})
		else
			local ic = BuildIcon(btn, string.lower(tostring(icon or "dot")), Theme.SubText, 16)
			ic.Frame.Position = UDim2.new(0, 12, 0.5, -8)
			iconLabel = setmetatable({}, {
				__newindex = function(_, k, v)
					if k == "TextColor3" then
						ic.SetColor(v)
					end
				end,
			})
		end
		local nameLabel = Text(btn, {
			Text = Tab.Name,
			TextSize = 12,
			TextColor3 = Theme.SubText,
			Position = UDim2.new(0, 40, 0, 0),
			Size = UDim2.new(1, -46, 1, 0),
			TextTruncate = Enum.TextTruncate.AtEnd,
		})

		local page = Create("ScrollingFrame", {
			Name = Tab.Name,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 1, 0),
			CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 2,
			ScrollBarImageColor3 = Color3.fromRGB(200, 200, 200),
			ScrollingDirection = Enum.ScrollingDirection.Y,
			Visible = false,
			Parent = content,
		})
		ListLayout(page, 6)
		Pad(page, 8, 12, 12, 14)
		local pageTitle = Text(page, {
			Text = Tab.Name,
			Font = Enum.Font.GothamBold,
			TextSize = 20,
			Size = UDim2.new(1, 0, 0, 34),
		})
		pageTitle.LayoutOrder = 0

		Tab.Button = btn
		Tab.Bar = bar
		Tab.IconLabel = iconLabel
		Tab.NameLabel = nameLabel
		Tab.Page = page
		Tab.Container = page
		Mixin(Tab)

		btn.MouseEnter:Connect(function()
			if Window.ActiveTab ~= Tab then
				Tween(btn, 0.12, { BackgroundColor3 = Color3.fromRGB(24, 24, 24) })
			end
		end)
		btn.MouseLeave:Connect(function()
			if Window.ActiveTab ~= Tab then
				Tween(btn, 0.12, { BackgroundColor3 = Theme.Tab })
			end
		end)
		btn.MouseButton1Click:Connect(function()
			Window:SelectTab(Tab)
		end)

		-- Section (กรอบจัดกลุ่ม พับได้)
		function Tab:AddSection(s)
			if type(s) == "string" then
				s = { Name = s }
			end
			local Section = { Window = Window, _n = 0 }
			local open = s.Open ~= false

			local outer = Create("Frame", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Parent = page,
			})
			ListLayout(outer, 6)
			NextOrder(Tab, outer)

			local header = Create("TextButton", {
				Text = "",
				AutoButtonColor = false,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 26),
				LayoutOrder = 1,
				Parent = outer,
			})
			Create("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 4),
				Parent = header,
			})
			local headerLabel = Text(header, {
				Text = s.Name or "Section",
				Font = Enum.Font.Gotham,
				TextSize = 12,
				TextColor3 = Theme.SubText,
				AutomaticSize = Enum.AutomaticSize.X,
				Size = UDim2.new(0, 0, 1, 0),
				LayoutOrder = 1,
			})
			local arrow = BuildIcon(header, "chevron_down", Theme.SubText, 11)
			arrow.Frame.LayoutOrder = 2
			local container = Create("Frame", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Visible = open,
				LayoutOrder = 2,
				Parent = outer,
			})
			ListLayout(container, 6)

			local function renderHeader()
				Tween(arrow.Frame, 0.15, { Rotation = container.Visible and 0 or -90 })
			end
			header.MouseButton1Click:Connect(function()
				container.Visible = not container.Visible
				renderHeader()
			end)
			renderHeader()

			Section.Container = container
			function Section:SetOpen(v)
				container.Visible = v
				renderHeader()
			end
			Mixin(Section)
			return Section
		end

		table.insert(Window.Tabs, Tab)
		if #Window.Tabs == 1 then
			Window:SelectTab(Tab)
		end
		return Tab
	end

	table.insert(Library.Windows, Window)
	return Window
end

function Library:Unload()
	for _, w in ipairs(Library.Windows) do
		pcall(function()
			w:Destroy()
		end)
	end
	table.clear(Library.Windows)
	if toastGui then
		toastGui:Destroy()
	end
end

return Library
