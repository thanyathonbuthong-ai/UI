-- สร้างไอคอน: คืน { Frame = ..., SetColor = function(color) }
local function BuildIcon(parent, name, color, px)
	local prims = Icons[name] or Icons.dot
	px = px or 16
	color = color or Theme.SubText
	local k = px / 16
	local T = math.max(1.5, 1.5 * k)
	local holder = Create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(px, px),
		Parent = parent,
	})
	local parts = {}
	for _, p in ipairs(prims) do
		local kind = p[1]
		if kind == "L" then
			local x1, y1, x2, y2 = p[2] * k, p[3] * k, p[4] * k, p[5] * k
			local dx, dy = x2 - x1, y2 - y1
			local f = Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2),
				Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy) + T * 0.5, T),
				Rotation = math.deg(math.atan2(dy, dx)),
				BackgroundColor3 = color,
				BorderSizePixel = 0,
				Parent = holder,
			})
			table.insert(parts, { f, "bg" })
		elseif kind == "D" then
			local r = p[4] * k
			local f = Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(p[2] * k, p[3] * k),
				Size = UDim2.fromOffset(r * 2, r * 2),
				BackgroundColor3 = color,
				BorderSizePixel = 0,
				Parent = holder,
			})
			Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = f })
			table.insert(parts, { f, "bg" })
		elseif kind == "C" then
			local r = math.max(p[4] * k - T / 2, 0.5)
			local f = Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(p[2] * k, p[3] * k),
				Size = UDim2.fromOffset(r * 2, r * 2),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Parent = holder,
			})
			Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = f })
			local st = Create("UIStroke", { Color = color, Thickness = T, Parent = f })
			table.insert(parts, { st, "stroke" })
		elseif kind == "R" then
			local f = Create("Frame", {
				Position = UDim2.fromOffset(p[2] * k + T / 2, p[3] * k + T / 2),
				Size = UDim2.fromOffset(math.max(p[4] * k - T, 1), math.max(p[5] * k - T, 1)),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Parent = holder,
			})
			if (p[6] or 0) > 0 then
				Create("UICorner", { CornerRadius = UDim.new(0, p[6] * k), Parent = f })
			end
			local st = Create("UIStroke", { Color = color, Thickness = T, Parent = f })
			table.insert(parts, { st, "stroke" })
		end
	end
	local function SetColor(c)
		for _, pr in ipairs(parts) do
			if pr[2] == "bg" then
				pr[1].BackgroundColor3 = c
			else
				pr[1].Color = c
			end
		end
	end
	return { Frame = holder, SetColor = SetColor }
end
Library.BuildIcon = BuildIcon

-- แถวมาตรฐาน (มีแถบด้านซ้าย + เส้น underline ตอน hover เหมือนในภาพ)
local function MakeRow(parent, height)
	local row = Create("Frame", {
		BackgroundColor3 = Theme.Row,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, height or 34),
		Parent = parent,
	})
	Create("Frame", {
		Name = "Edge",
		BackgroundColor3 = Theme.Edge,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 2, 1, 0),
		Parent = row,
	})
	local underline = Create("Frame", {
		Name = "Underline",
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(0, 0, 0, 1),
		ZIndex = 3,
		Parent = row,
	})
	local hit = Create("TextButton", {
		Name = "Hit",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		ZIndex = 1,
		Parent = row,
	})
	hit.MouseEnter:Connect(function()
		Tween(row, 0.15, { BackgroundColor3 = Theme.RowHover })
		Tween(underline, 0.3, { Size = UDim2.new(0.44, 0, 0, 1) })
	end)
	hit.MouseLeave:Connect(function()
		Tween(row, 0.15, { BackgroundColor3 = Theme.Row })
		Tween(underline, 0.2, { Size = UDim2.new(0, 0, 0, 1) })
	end)
	return row, hit
end

local function GetParent()
	if Library.Parent then
		return Library.Parent
	end
	return Players.LocalPlayer:WaitForChild("PlayerGui")
end

