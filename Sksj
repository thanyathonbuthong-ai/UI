		ClearTextOnFocus = o.ClearOnFocus == true,
		Font = Enum.Font.Code,
		TextSize = 11,
		TextColor3 = Theme.Text,
		Size = UDim2.new(1, -16, 1, 0),
		Position = UDim2.new(0, 8, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 3,
		Parent = box,
	})
	local stroke = Create("UIStroke", {
		Color = Color3.fromRGB(60, 60, 60),
		Thickness = 1,
		Transparency = 1,
		Parent = box,
	})
	input.Focused:Connect(function()
		Tween(stroke, 0.15, { Transparency = 0 })
	end)
	input.FocusLost:Connect(function(enter)
		Tween(stroke, 0.15, { Transparency = 1 })
		local v = input.Text
		if o.Numeric then
			local n = tonumber(v)
			if n == nil then
				input.Text = Textbox.Value
				return
			end
			v = tostring(n)
			input.Text = v
		end
		Textbox.Value = v
		SetFlag(o, o.Numeric and tonumber(v) or v)
		SafeCall(o.Callback, o.Numeric and tonumber(v) or v, enter)
	end)
	function Textbox:Set(v)
		input.Text = tostring(v)
		Textbox.Value = tostring(v)
		SetFlag(o, o.Numeric and tonumber(v) or tostring(v))
	end
	function Textbox:Get()
		return o.Numeric and tonumber(Textbox.Value) or Textbox.Value
	end
	SetFlag(o, Textbox:Get())
	return Textbox
end

-- Keybind
function Controls:AddKeybind(o)
	o = o or {}
	local Keybind = { Value = o.Default }
	local window = self.Window
	local listening = false

	local row, hit = MakeRow(self.Container, 34)
	NextOrder(self, row)
	Text(row, {
		Text = o.Name or "Keybind",
		Position = UDim2.new(0, 22, 0, 0),
		Size = UDim2.new(1, -130, 1, 0),
		ZIndex = 2,
	})
	local box = Create("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Input,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.new(0, 86, 0, 22),
		Font = Enum.Font.Code,
		TextSize = 11,
		TextColor3 = Theme.Text,
		Text = "",
		ZIndex = 3,
		Parent = row,
	})

	local function render()
		box.Text = listening and "..." or (Keybind.Value and Keybind.Value.Name or "None")
	end

	function Keybind:Set(key, silent)
		Keybind.Value = key
		SetFlag(o, key)
		if o.UIToggle and window then
			window.ToggleKey = key
		end
		render()
		if not silent then
			SafeCall(o.ChangedCallback, key)
		end
	end
	function Keybind:Get()
		return Keybind.Value
	end

	local function startListen()
		listening = true
		render()
	end
	box.MouseButton1Click:Connect(startListen)
	hit.MouseButton1Click:Connect(startListen)

	local conn = UserInputService.InputBegan:Connect(function(input, gp)
		if listening then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				listening = false
				if input.KeyCode == Enum.KeyCode.Escape then
					Keybind:Set(nil)
				else
					Keybind:Set(input.KeyCode)
				end
			end
			return
		end
		if gp or o.UIToggle then
			return
		end
		if Keybind.Value and input.KeyCode == Keybind.Value then
			SafeCall(o.Callback, Keybind.Value)
		end
	end)
	if window then
		table.insert(window._conns, conn)
	end

	if o.UIToggle and window and o.Default then
		window.ToggleKey = o.Default
	end
	SetFlag(o, Keybind.Value)
	render()
	return Keybind
end

local function Mixin(obj)
	for k, v in pairs(Controls) do
		obj[k] = v
	end
end

