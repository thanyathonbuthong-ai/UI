local HttpService = game:GetService("HttpService")

BlvckUI.Flags = {}
BlvckUI.ConfigFolder = "BlvckUI"

-- Flag: елемент з options.Flag потрапляє в BlvckUI.Flags[Flag] і зберігається в конфіг
local function registerFlag(flag, obj)
    if flag ~= nil then
        BlvckUI.Flags[flag] = obj
    end
    return obj
end

local function contrastText(c)
    local lum = 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
    return lum > 0.6 and Color3.fromRGB(16, 17, 20) or Color3.new(1, 1, 1)
end

local function lineH()
    return M.Text + 7
end

-- Блок "заголовок + опис". minH — мінімальна висота, текст центрується по вертикалі.
local function textBlock(parent, title, desc, reserve, minH, align)
    align = align or Enum.TextXAlignment.Left
    local block = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -(reserve or 0), 0, minH or 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Parent = parent,
    }, {
        new("UIListLayout", {
            Padding = UDim.new(0, 1), SortOrder = Enum.SortOrder.LayoutOrder,
            VerticalAlignment = Enum.VerticalAlignment.Center,
        }),
    })

    local titleLabel, descLabel
    if title and title ~= "" then
        titleLabel = new("TextLabel", {
            BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, lineH()), Text = tostring(title),
            Font = Theme.Font, TextSize = M.Text, TextColor3 = Theme.Text, TextXAlignment = align,
            TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 1, Parent = block,
        })
    end
    if desc and desc ~= "" then
        descLabel = new("TextLabel", {
            BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            Text = tostring(desc), Font = Theme.Font, TextSize = M.RowDesc, TextColor3 = Theme.SubText,
            TextWrapped = true, TextXAlignment = align, TextYAlignment = Enum.TextYAlignment.Top,
            LayoutOrder = 2, Parent = block,
        })
    end
    return block, titleLabel, descLabel
end

local function newRow(parent)
    return new("Frame", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = parent,
    })
end

-- Повертає (inner, outer): children кладемо в inner (там UIListLayout), а lock/Instance/група працюють з outer
local function newStack(parent, gap)
    local outer = new("Frame", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = parent,
    })
    local inner = new("Frame", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = outer,
    }, { new("UIListLayout", { Padding = UDim.new(0, gap or 4), SortOrder = Enum.SortOrder.LayoutOrder }) })
    return inner, outer
end

-- Locked: напівпрозоре "скло" поверх елемента, тап показує повідомлення (LockedTitle)
local function attachLock(host, options)
    local locked = options.Locked == true
    local overlay = new("TextButton", {
        Text = "", AutoButtonColor = false, BackgroundColor3 = Theme.Background, BackgroundTransparency = 0.35,
        Size = UDim2.new(1, 0, 1, 0), ZIndex = 30, Visible = locked, Parent = host,
    }, { corner(UDim.new(0, M.RowCorner)) })
    local lockIcon = makeIcon("lock", M.SelCheck, Theme.SubText)
    lockIcon.AnchorPoint = Vector2.new(1, 0.5)
    lockIcon.Position = UDim2.new(1, -8, 0.5, 0)
    lockIcon.ZIndex = 31
    lockIcon.Parent = overlay
    overlay.Activated:Connect(function()
        BlvckUI:Notify({
            Title = options.LockedTitle or "Locked", Text = "This element is locked", Type = "Warning", Duration = 2.5,
        })
    end)
    return function(state)
        locked = state and true or false
        overlay.Visible = locked
    end, function() return locked end
end

local function hoverFx(window, btn, normal, hover)
    window:_track(btn.MouseEnter:Connect(function() tween(btn, EASE, { BackgroundColor3 = hover }) end))
    window:_track(btn.MouseLeave:Connect(function() tween(btn, EASE, { BackgroundColor3 = normal }) end))
end

--------------------------------------------------------------- Button
function Module:AddButton(options)
    options = options or {}
    local window = self._window
    local title = options.Text or options.Title or "Button"
    if title == "" then title = " " end
    local custom = options.Color

    local baseColor = custom or Theme.SurfaceLight
    local hoverColor = custom and custom:Lerp(Color3.new(1, 1, 1), 0.12) or Theme.SurfaceHover
    local pressColor = baseColor:Lerp(Color3.new(0, 0, 0), 0.18)
    local baseStroke = custom and custom:Lerp(Color3.new(0, 0, 0), 0.25) or Theme.Stroke
    local textColor = custom and contrastText(custom) or Theme.Text

    local btnStroke = stroke(baseStroke)
    local btn = new("TextButton", {
        BackgroundColor3 = baseColor, Size = UDim2.new(1, 0, 0, M.BtnH), AutomaticSize = Enum.AutomaticSize.Y,
        Text = "", AutoButtonColor = false, Parent = self.SettingsFrame,
    }, { corner(UDim.new(0, M.RowCorner)), btnStroke })

    local iconName = options.Icon
    local hasIcon = type(iconName) == "string" and iconName ~= ""
    local iconRight = options.IconAlign == "Right"
    local isz = M.BtnIcon
    local pad = M.CardPad
    local padL = pad + ((hasIcon and not iconRight) and (isz + 6) or 0)
    local padR = pad + ((hasIcon and iconRight) and (isz + 6) or 0)

    local icon
    if hasIcon then
        icon = makeIcon(iconName, isz, textColor)
        icon.AnchorPoint = Vector2.new(iconRight and 1 or 0, 0.5)
        icon.Position = iconRight and UDim2.new(1, -pad, 0.5, 0) or UDim2.new(0, pad, 0.5, 0)
        icon.Parent = btn
    end

    local justify = options.Justify or "Left"
    local align = justify == "Center" and Enum.TextXAlignment.Center
        or (justify == "Right" and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left)

    local block, titleLabel, descLabel = textBlock(btn, title, options.Desc, padL + padR, M.BtnH, align)
    block.Position = UDim2.new(0, padL, 0, 0)
    titleLabel.Font = Theme.FontBold
    titleLabel.TextColor3 = textColor
    if descLabel then descLabel.TextColor3 = custom and textColor or Theme.SubText end

    local setLocked, isLocked = attachLock(btn, options)

    hoverFx(window, btn, baseColor, hoverColor)
    window:_track(btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            tween(btn, TweenInfo.new(0.08), { BackgroundColor3 = pressColor })
        end
    end))
    window:_track(btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            tween(btn, EASE, { BackgroundColor3 = baseColor })
        end
    end))
    window:_track(btn.Activated:Connect(function()
        if isLocked() then return end
        if options.Callback then task.spawn(options.Callback) end
    end))

    local obj = {}
    obj.Instance = btn
    obj.Highlight = function()
        tween(btnStroke, TweenInfo.new(0.15), { Color = Theme.Accent })
        tween(btn, TweenInfo.new(0.15), { BackgroundColor3 = hoverColor })
        task.delay(0.4, function()
            if btn.Parent then
                tween(btnStroke, EASE, { Color = baseStroke })
                tween(btn, EASE, { BackgroundColor3 = baseColor })
            end
        end)
    end
    obj.SetText = function(_, text) titleLabel.Text = tostring(text) end
    obj.SetDesc = function(_, text) if descLabel then descLabel.Text = tostring(text) end end
    obj.SetCallback = function(_, fn) options.Callback = fn end
    obj.SetLocked = function(_, state) setLocked(state) end
    obj.Destroy = function() btn:Destroy() end
    return obj
end

--------------------------------------------------------------- Toggle (Switch / Checkbox)
function Module:AddToggle(options)
    options = options or {}
    local window = self._window
    local isCheckbox = (options.Type == "Checkbox")

    local state = options.Default
    if state == nil then state = options.Value end
    state = state and true or false

    local row = newRow(self.SettingsFrame)
    local controlW = isCheckbox and M.Box or M.SwitchW
    local minH = isCheckbox and M.CheckRowH or (M.SwitchH + 10)
    textBlock(row, options.Text or options.Title, options.Desc, controlW + 12, minH)

    local ctrl, ctrlStroke, checkIcon, knob
    local knobInset = (M.SwitchH - M.Knob) / 2
    local knobOn = UDim2.new(1, -(M.Knob + knobInset), 0.5, -M.Knob / 2)
    local knobOff = UDim2.new(0, knobInset, 0.5, -M.Knob / 2)

    if isCheckbox then
        ctrlStroke = stroke(state and Theme.Accent or Theme.Stroke)
        ctrl = new("Frame", {
            BackgroundColor3 = state and Theme.Accent or Theme.Surface,
            Position = UDim2.new(1, -M.Box, 0.5, -M.Box / 2), Size = UDim2.new(0, M.Box, 0, M.Box), Parent = row,
        }, { corner(UDim.new(0, 5)), ctrlStroke })
        checkIcon = makeIcon("check", M.BoxIcon, Color3.new(1, 1, 1))
        checkIcon.AnchorPoint = Vector2.new(0.5, 0.5)
        checkIcon.Position = UDim2.new(0.5, 0, 0.5, 0)
        checkIcon.Visible = state
        checkIcon.Parent = ctrl
    else
        ctrl = new("Frame", {
            BackgroundColor3 = state and Theme.Accent or Theme.SurfaceLight,
            Position = UDim2.new(1, -M.SwitchW, 0.5, -M.SwitchH / 2), Size = UDim2.new(0, M.SwitchW, 0, M.SwitchH), Parent = row,
        }, { corner(UDim.new(1, 0)), stroke() })
        knob = new("Frame", {
            BackgroundColor3 = Color3.new(1, 1, 1), Position = state and knobOn or knobOff,
            Size = UDim2.new(0, M.Knob, 0, M.Knob), Parent = ctrl,
        }, { corner(UDim.new(1, 0)) })
    end

    local function apply(v, fire)
        state = v and true or false
        if isCheckbox then
            checkIcon.Visible = state
            ctrlStroke.Color = state and Theme.Accent or Theme.Stroke
            tween(ctrl, EASE, { BackgroundColor3 = state and Theme.Accent or Theme.Surface })
        else
            tween(ctrl, EASE, { BackgroundColor3 = state and Theme.Accent or Theme.SurfaceLight })
            tween(knob, EASE, { Position = state and knobOn or knobOff })
        end
        if fire and options.Callback then task.spawn(options.Callback, state) end
    end

    -- весь рядок клікабельний (на пальці так значно зручніше)
    local hit = new("TextButton", {
        BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 1, 0), ZIndex = 2, Parent = row,
    })
    local setLocked, isLocked = attachLock(row, options)
    window:_track(hit.Activated:Connect(function()
        if isLocked() then return end
        apply(not state, true)
    end))

    local obj = {
        Instance = row,
        Get = function() return state end,
        Set = function(_, v, fire) apply(v, fire) end,
        SetLocked = function(_, v) setLocked(v) end,
    }
    obj._save = function() return state end
    obj._load = function(v) apply(v == true, true) end
    return registerFlag(options.Flag, obj)
end

-- Старий API: чекбокс = Toggle з Type = "Checkbox"
function Module:AddCheckbox(options)
