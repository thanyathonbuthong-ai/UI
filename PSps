function BlvckUI:Popup(options)
    options = options or {}
    local overlay = new("TextButton", {
        Text = "", AutoButtonColor = false, BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0), ZIndex = 80, Parent = BlvckUI.ScreenGui,
    })
    local cardW = math.min(M.PopupW, getViewport().X - 24)
    local card = new("Frame", {
        BackgroundColor3 = Theme.Surface, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 12),
        Size = UDim2.new(0, cardW, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = overlay,
    }, {
        corner(UDim.new(0, M.Radius)), stroke(), padding(M.CardPad + 4),
        new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
    })

    local closed = false
    local function close()
        if closed then return end
        closed = true
        tween(overlay, EASE, { BackgroundTransparency = 1 })
        local t = tween(card, EASE, { Position = UDim2.new(0.5, 0, 0.5, 12) })
        t.Completed:Once(function() overlay:Destroy() end)
    end

    local head = newRow(card)
    head.LayoutOrder = 1
    local hasIcon = type(options.Icon) == "string" and options.Icon ~= ""
    local badge = M.ToastBadge
    local padL = hasIcon and (badge + 8) or 0
    if hasIcon then
        local badgeFrame = new("Frame", {
            BackgroundColor3 = Theme.Accent, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.new(0, badge, 0, badge), Parent = head,
        }, { corner(UDim.new(0, 6)) })
        local ic = makeIcon(options.Icon, M.ToastIcon, contrastText(Theme.Accent))
        ic.AnchorPoint = Vector2.new(0.5, 0.5)
        ic.Position = UDim2.new(0.5, 0, 0.5, 0)
        ic.Parent = badgeFrame
    end
    local block, titleLabel = textBlock(head, options.Title or "Notice", nil, padL, badge)
    block.Position = UDim2.new(0, padL, 0, 0)
    if titleLabel then titleLabel.Font = Theme.FontBold end

    local content = options.Content or options.Text
    if content and content ~= "" then
        new("TextLabel", {
            BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            Text = tostring(content), Font = Theme.Font, TextSize = M.Text, TextColor3 = Theme.SubText,
            TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
            LayoutOrder = 2, Parent = card,
        })
    end

    local buttons = options.Buttons
    if type(buttons) ~= "table" or #buttons == 0 then
        buttons = { { Title = "OK", Variant = "Primary" } }
    end
    local n = #buttons
    local gap = 6
    local btnRow = new("Frame", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, M.BtnH), LayoutOrder = 3, Parent = card,
    }, { new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, gap), SortOrder = Enum.SortOrder.LayoutOrder,
    }) })

    for i, b in ipairs(buttons) do
        local variant = b.Variant or (i == n and "Primary" or "Secondary")
        local bg = variant == "Primary" and Theme.Accent or (variant == "Tertiary" and Theme.Surface or Theme.SurfaceLight)
        local fg = variant == "Primary" and contrastText(Theme.Accent) or Theme.Text
        local btn = new("TextButton", {
            BackgroundColor3 = bg, BackgroundTransparency = variant == "Tertiary" and 1 or 0,
            Size = UDim2.new(1 / n, -(gap * (n - 1)) / n, 1, 0), Text = tostring(b.Title or "Button"),
            AutoButtonColor = false, Font = Theme.FontBold, TextSize = M.Text, TextColor3 = fg,
            TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = i, Parent = btnRow,
        }, { corner(UDim.new(0, M.RowCorner)), variant == "Secondary" and stroke() or nil })
        btn.Activated:Connect(function()
            close()
            if b.Callback then task.spawn(b.Callback) end
        end)
    end

    if options.CloseOnOutside then
        overlay.Activated:Connect(close)
    end

    tween(overlay, EASE, { BackgroundTransparency = 0.5 })
    tween(card, EASE, { Position = UDim2.new(0.5, 0, 0.5, 0) })

    return { Close = close, Instance = overlay }
end

