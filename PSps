        BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, M.SelListY), Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, Parent = holder,
    }, { new("UIListLayout", { Padding = UDim.new(0, M.SelGap), SortOrder = Enum.SortOrder.LayoutOrder }) })

    local rows = {}
    local function refreshVisual()
        for _, r in ipairs(rows) do
            local isSel = (r.item == selected)
            r.label.TextColor3 = isSel and Theme.Text or Theme.SubText
            r.check.Visible = isSel
        end
    end

    for _, item in ipairs(items) do
        local row = new("TextButton", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, M.SelRowH), Text = "", AutoButtonColor = false, Parent = list })
        local label = new("TextLabel", {
            BackgroundTransparency = 1, Size = UDim2.new(1, -M.SelReserve, 1, 0), Text = tostring(item),
            Font = Theme.Font, TextSize = M.Text, TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd, Parent = row,
        })
        local check = makeIcon("check", M.SelCheck, Theme.Accent)
        check.Position = UDim2.new(1, -(M.SelCheck + 4), 0.5, -M.SelCheck / 2)
        check.Visible = false
        check.Parent = row

        self._window:_track(row.Activated:Connect(function()
            selected = item
            refreshVisual()
            if options.Callback then task.spawn(options.Callback, item) end
        end))

        table.insert(rows, { item = item, label = label, check = check })
    end

    refreshVisual()
    local obj = {
        Get = function() return selected end,
        Set = function(_, v, fire)
            selected = v
            refreshVisual()
            if fire and options.Callback then task.spawn(options.Callback, v) end
        end,
    }
    obj._save = function() return selected end
    obj._load = function(v) obj:Set(v, true) end
    return registerFlag(options.Flag, obj)
end

function Module:AddCheckList(options)
    options = options or {}
    local items = options.Items or {}
    local checked = {}
    for _, item in ipairs(options.Default or {}) do checked[item] = true end

    local holder = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = self.SettingsFrame })
    new("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, M.SelTitleH), Text = options.Text or "List",
        Font = Theme.Font, TextSize = M.Text, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd, Parent = holder,
    })
    local list = new("Frame", {
        BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, M.SelListY), Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, Parent = holder,
    }, { new("UIListLayout", { Padding = UDim.new(0, M.SelGap), SortOrder = Enum.SortOrder.LayoutOrder }) })

    local rowRefs = {}
    for _, item in ipairs(items) do
        local row = new("TextButton", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, M.SelRowH), Text = "", AutoButtonColor = false, Parent = list })
        local isChecked = checked[item] == true
        local label = new("TextLabel", {
            BackgroundTransparency = 1, Size = UDim2.new(1, -M.SelReserve, 1, 0), Text = tostring(item),
            Font = Theme.Font, TextSize = M.Text, TextColor3 = isChecked and Theme.Text or Theme.SubText,
            TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row,
        })
        local check = makeIcon("check", M.SelCheck, Theme.Accent)
        check.Position = UDim2.new(1, -(M.SelCheck + 4), 0.5, -M.SelCheck / 2)
        check.Visible = isChecked
        check.Parent = row
        rowRefs[item] = { label = label, check = check }

        self._window:_track(row.Activated:Connect(function()
            local newState = not (checked[item] == true)
            checked[item] = newState
            label.TextColor3 = newState and Theme.Text or Theme.SubText
            check.Visible = newState
            if options.Callback then task.spawn(options.Callback, item, newState) end
        end))
    end

    local function getChecked()
        local out = {}
        for _, item in ipairs(items) do if checked[item] then table.insert(out, item) end end
        return out
    end

    local obj = {
        IsChecked = function(_, item) return checked[item] == true end,
        GetChecked = getChecked,
        Get = getChecked,
        Set = function(_, list, fire)
            local want = {}
            for _, item in ipairs(list or {}) do want[item] = true end
            for _, item in ipairs(items) do
                local newState = want[item] == true
                if (checked[item] == true) ~= newState then
                    checked[item] = newState
                    local r = rowRefs[item]
                    if r then
                        r.label.TextColor3 = newState and Theme.Text or Theme.SubText
                        r.check.Visible = newState
                    end
                    if fire and options.Callback then task.spawn(options.Callback, item, newState) end
                end
            end
        end,
    }
    obj._save = getChecked
    obj._load = function(v) obj:Set(v, true) end
    return registerFlag(options.Flag, obj)
end

