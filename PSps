        Type = "Checkbox", Text = options.Text or "Option", Desc = options.Desc, Default = options.Default,
        Callback = options.Callback, Flag = options.Flag, Locked = options.Locked, LockedTitle = options.LockedTitle,
    })
end

--------------------------------------------------------------- Keybind
function Module:AddKeybind(options)
    options = options or {}
    local window = self._window

    local function toKey(v)
        if typeof(v) == "EnumItem" then return v end
        if type(v) == "string" and v ~= "" and v ~= "None" then
            local ok, k = pcall(function() return Enum.KeyCode[v] end)
            if ok then return k end
        end
        return nil
    end

    local key = toKey(options.Value or options.Default)
    local listening = false
    local token = 0

    local row = newRow(self.SettingsFrame)
    local pillW = M.KeyW
    textBlock(row, options.Text or options.Title or "Keybind", options.Desc, pillW + 12, M.FieldH)

    local pillStroke = stroke()
    local pill = new("TextButton", {
        BackgroundColor3 = Theme.Surface, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.new(0, pillW, 0, M.FieldH - 6), Text = key and key.Name or "None", AutoButtonColor = false,
        Font = Theme.FontBold, TextSize = M.Text - 1, TextColor3 = Theme.Text, TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = row,
    }, { corner(UDim.new(0, 6)), pillStroke })

    local setLocked, isLocked = attachLock(row, options)

    local function refreshText()
        pill.Text = listening and "..." or (key and key.Name or "None")
        pill.TextColor3 = listening and Theme.Accent or Theme.Text
        pillStroke.Color = listening and Theme.Accent or Theme.Stroke
    end

    local function finishListening()
        listening = false
        window._listeningKey = false
        refreshText()
    end

    local function setKey(kc, fire)
        key = kc
        refreshText()
        if fire and options.Callback then task.spawn(options.Callback, kc and kc.Name or "None") end
    end

    window:_track(pill.Activated:Connect(function()
        if isLocked() then return end
        if listening then finishListening() return end
        listening = true
        window._listeningKey = true
        token += 1
        local myToken = token
        refreshText()
        task.delay(6, function() -- на телефоні клавіатури немає: не висимо в режимі очікування
            if listening and token == myToken then finishListening() end
        end)
    end))

    window:_track(UserInputService.InputBegan:Connect(function(input, processed)
        if listening then
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            local kc = input.KeyCode
            finishListening()
            if kc == Enum.KeyCode.Escape then return end
            if kc == Enum.KeyCode.Backspace then setKey(nil, true) else setKey(kc, true) end
            return
        end
        if processed or window._listeningKey then return end
        if key and input.KeyCode == key and options.OnPress then
            task.spawn(options.OnPress, key.Name)
        end
    end))

    local obj = {
        Instance = row,
        Get = function() return key and key.Name or "None" end,
        Set = function(_, v, fire) setKey(toKey(v), fire) end,
        SetLocked = function(_, v) setLocked(v) end,
    }
    obj._save = function() return key and key.Name or "None" end
    obj._load = function(v) setKey(toKey(v), true) end
    return registerFlag(options.Flag, obj)
end

--------------------------------------------------------------- Input / Textarea
function Module:AddInput(options)
    options = options or {}
    local window = self._window
    local isArea = (options.Type == "Textarea")
    local value = tostring(options.Value or options.Default or "")

    local holder, outer = newStack(self.SettingsFrame, 4)
    local title, desc = options.Text or options.Title, options.Desc
    if (title and title ~= "") or (desc and desc ~= "") then
        local block = textBlock(holder, title, desc, 0, 0)
        block.LayoutOrder = 1
    end

    local fieldStroke = stroke()
    local field = new("Frame", {
        BackgroundColor3 = Theme.Surface, Size = UDim2.new(1, 0, 0, isArea and M.AreaH or M.FieldH),
        LayoutOrder = 2, Parent = holder,
    }, { corner(UDim.new(0, M.RowCorner - 2)), fieldStroke })

    local iconName = options.InputIcon or options.Icon
    local padL = M.PillPad
    if type(iconName) == "string" and iconName ~= "" then
        local ic = makeIcon(iconName, M.SelCheck, Theme.SubText)
        ic.AnchorPoint = Vector2.new(0, isArea and 0 or 0.5)
        ic.Position = UDim2.new(0, M.PillPad, isArea and 0 or 0.5, isArea and 8 or 0)
        ic.Parent = field
        padL = M.PillPad + M.SelCheck + 6
    end

    local box = new("TextBox", {
        BackgroundTransparency = 1, Text = value,
        Position = UDim2.new(0, padL, 0, isArea and 6 or 0),
        Size = UDim2.new(1, -(padL + M.PillPad), 1, isArea and -12 or 0),
        PlaceholderText = options.Placeholder or "Enter text...", PlaceholderColor3 = Theme.SubText,
        TextColor3 = Theme.Text, Font = Theme.Font, TextSize = M.Text, TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = isArea and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
        ClearTextOnFocus = options.ClearTextOnFocus == true, MultiLine = isArea, TextWrapped = isArea,
        Parent = field,
    })

    local setLocked, isLocked = attachLock(outer, options)

    if options.Numeric then
        window:_track(box:GetPropertyChangedSignal("Text"):Connect(function()
            local cleaned = (box.Text:gsub("[^%d%.%-]", ""))
            if cleaned ~= box.Text then box.Text = cleaned end
        end))
    end
    window:_track(box.Focused:Connect(function()
        fieldStroke.Color = Theme.Accent
    end))
    window:_track(box.FocusLost:Connect(function(enterPressed)
        fieldStroke.Color = Theme.Stroke
        if isLocked() then box.Text = value return end
        value = box.Text
        if options.Callback then task.spawn(options.Callback, value, enterPressed) end
    end))

    local obj = {
        Instance = outer,
        Get = function() return value end,
        Set = function(_, v, fire)
            value = tostring(v or "")
            box.Text = value
            if fire and options.Callback then task.spawn(options.Callback, value, false) end
        end,
        SetLocked = function(_, v) setLocked(v) end,
    }
    obj._save = function() return value end
    obj._load = function(v) obj:Set(v, true) end
    return registerFlag(options.Flag, obj)
end

--------------------------------------------------------------- Dropdown (single / multi, search, icons, descriptions, dividers)
function Module:AddDropdown(options)
    options = options or {}
    local window = self._window
    local multi = options.Multi == true
    local allowNone = options.AllowNone == true

    local entries, selected, rowRefs = {}, {}, {}
    local open = false

    local function normalize(values)
        entries = {}
        for _, v in ipairs(values or {}) do
            if type(v) == "table" then
                if v.Type == "Divider" then
                    table.insert(entries, { divider = true })
                else
                    local t = tostring(v.Title or v.Name or "")
                    table.insert(entries, {
                        key = t, title = t, desc = v.Desc, icon = v.Icon, callback = v.Callback,
                        locked = v.Locked, raw = v,
                    })
                end
            else
                table.insert(entries, { key = tostring(v), title = tostring(v), raw = v })
            end
        end
    end

    local function nthEntry(i)
        local n = 0
        for _, e in ipairs(entries) do
            if not e.divider then
                n += 1
                if n == i then return e end
            end
        end
        return nil
    end

    local function setSelection(v)
        selected = {}
        if v == nil then return end
        local function add(x)
            if type(x) == "number" then
                local e = nthEntry(x)
                if e then selected[e.key] = true end
            elseif type(x) == "table" then
                if x.Title or x.Name then selected[tostring(x.Title or x.Name)] = true end
            else
                selected[tostring(x)] = true
            end
        end
        if type(v) == "table" and v.Title == nil and v.Name == nil then
            for _, x in ipairs(v) do add(x) end
        else
            add(v)
        end
        if not multi then
            local keep
            for _, e in ipairs(entries) do
                if not e.divider and selected[e.key] then
                    keep = e.key
                    break
                end
            end
            selected = keep and { [keep] = true } or {}
        end
    end

    normalize(options.Values or options.Items)
    local init = options.Value
    if init == nil then init = options.Default end
    setSelection(init)
    if not multi and init == nil and not allowNone then
        local first = nthEntry(1)
        if first then selected = { [first.key] = true } end
    end

    ---------------- UI
    local holder, outer = newStack(self.SettingsFrame, 4)
    local title, desc = options.Text or options.Title, options.Desc
    if (title and title ~= "") or (desc and desc ~= "") then
        local block = textBlock(holder, title, desc, 0, 0)
        block.LayoutOrder = 1
    end

    local pillStroke = stroke()
    local pill = new("TextButton", {
        BackgroundColor3 = Theme.Surface, Size = UDim2.new(1, 0, 0, M.FieldH), Text = "", AutoButtonColor = false,
        LayoutOrder = 2, Parent = holder,
    }, { corner(UDim.new(0, M.RowCorner - 2)), pillStroke })
    local pillLabel = new("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.new(0, M.PillPad, 0, 0),
        Size = UDim2.new(1, -(M.PillPad * 2 + M.SelCheck + 4), 1, 0), Text = "", Font = Theme.Font, TextSize = M.Text,
        TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = pill,
    })
    local chevron = makeIcon("chevron-down", M.SelCheck, Theme.SubText)
    chevron.AnchorPoint = Vector2.new(0.5, 0.5)
    chevron.Position = UDim2.new(1, -(M.PillPad + M.SelCheck / 2), 0.5, 0)
    chevron.Parent = pill

    local panel = new("Frame", {
        BackgroundColor3 = Theme.Surface, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        Visible = false, LayoutOrder = 3, Parent = holder,
    }, {
        corner(UDim.new(0, M.RowCorner - 2)), stroke(), padding(4),
        new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
    })

    local search
    if options.SearchBar then
        search = new("TextBox", {
            BackgroundColor3 = Theme.SurfaceLight, Size = UDim2.new(1, 0, 0, M.FieldH - 6), Text = "",
            PlaceholderText = "Search...", PlaceholderColor3 = Theme.SubText, TextColor3 = Theme.Text,
            Font = Theme.Font, TextSize = M.Text, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
            LayoutOrder = 1, Parent = panel,
        }, { corner(UDim.new(0, 6)), padding(0, { Left = 8, Right = 8 }) })
    end

    local list = new("ScrollingFrame", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = M.ScrollW, ScrollBarImageColor3 = Theme.Accent,
        BorderSizePixel = 0, ScrollingDirection = Enum.ScrollingDirection.Y, LayoutOrder = 2, Parent = panel,
    })
    local listLayout = new("UIListLayout", { Padding = UDim.new(0, M.SelGap), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
    local function updateHeight()
        list.Size = UDim2.new(1, 0, 0, math.min(listLayout.AbsoluteContentSize.Y, M.DropMaxH))
    end
    window:_track(listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateHeight))

    local setLocked, isLocked = attachLock(outer, options)

    ---------------- логіка
    local function displayText()
        local titles = {}
        for _, e in ipairs(entries) do
            if not e.divider and selected[e.key] then table.insert(titles, e.title) end
        end
        if #titles == 0 then return options.Placeholder or "Select...", false end
        return table.concat(titles, ", "), true
    end

    local function result()
        if multi then
            local out = {}
            for _, e in ipairs(entries) do
                if not e.divider and selected[e.key] then table.insert(out, e.raw) end
            end
            return out
        end
        for _, e in ipairs(entries) do
            if not e.divider and selected[e.key] then return e.raw end
        end
        return nil
    end

    local function fireCallback()
        if options.Callback then task.spawn(options.Callback, result()) end
    end

    local function refresh()
        for _, r in ipairs(rowRefs) do
            local on = selected[r.entry.key] == true
            r.title.TextColor3 = on and Theme.Text or Theme.SubText
            r.check.Visible = on
            tween(r.row, EASE, { BackgroundTransparency = on and 0.55 or 1 })
            if r.icon then setIconColor(r.icon, on and Theme.Accent or Theme.SubText) end
        end
        local text, has = displayText()
        pillLabel.Text = text
        pillLabel.TextColor3 = has and Theme.Text or Theme.SubText
    end

    local setOpen
    setOpen = function(v)
        open = v
        panel.Visible = v
        tween(chevron, EASE, { Rotation = v and 180 or 0 })
        pillStroke.Color = v and Theme.Accent or Theme.Stroke
        if v then
            if search then search.Text = "" end
            updateHeight()
        end
    end

    local function onPick(e)
        if e.locked then
            BlvckUI:Notify({ Title = "Locked", Text = e.title, Type = "Warning", Duration = 2 })
            return
        end
        if multi then
            selected[e.key] = (not selected[e.key]) or nil
        else
            if selected[e.key] then
                if allowNone then selected = {} end
            else
                selected = { [e.key] = true }
            end
        end
        refresh()
        if e.callback then task.spawn(e.callback, e.raw) end
        fireCallback()
        if not multi then setOpen(false) end
    end

    local function build()
        for _, child in ipairs(list:GetChildren()) do
            if child:IsA("GuiObject") then child:Destroy() end
        end
        rowRefs = {}
        for i, e in ipairs(entries) do
            if e.divider then
                new("Frame", {
                    BackgroundColor3 = Theme.Stroke, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 1),
                    LayoutOrder = i, Parent = list,
                })
            else
                local rowH = M.SelRowH + 6
                local isz = M.SelCheck
                local hasIcon = type(e.icon) == "string" and e.icon ~= ""
                local padL = 8 + (hasIcon and (isz + 6) or 0)
                local row = new("TextButton", {
                    BackgroundColor3 = Theme.SurfaceHover, BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, rowH), AutomaticSize = Enum.AutomaticSize.Y,
                    Text = "", AutoButtonColor = false, LayoutOrder = i, Parent = list,
                }, { corner(UDim.new(0, 6)) })
                local ic
                if hasIcon then
                    ic = makeIcon(e.icon, isz, Theme.SubText)
                    ic.AnchorPoint = Vector2.new(0, 0.5)
                    ic.Position = UDim2.new(0, 8, 0.5, 0)
                    ic.Parent = row
                end
                local block, titleLabel = textBlock(row, e.title, e.desc, padL + isz + 12, rowH)
                block.Position = UDim2.new(0, padL, 0, 0)
                if e.locked then titleLabel.TextTransparency = 0.5 end
                local check = makeIcon("check", isz, Theme.Accent)
                check.AnchorPoint = Vector2.new(1, 0.5)
                check.Position = UDim2.new(1, -8, 0.5, 0)
                check.Visible = false
                check.Parent = row
                window:_track(row.Activated:Connect(function() onPick(e) end))
                table.insert(rowRefs, { entry = e, row = row, title = titleLabel, icon = ic, check = check })
            end
        end
        refresh()
        updateHeight()
    end

    if search then
        window:_track(search:GetPropertyChangedSignal("Text"):Connect(function()
            local q = string.lower(search.Text)
            for _, r in ipairs(rowRefs) do
                r.row.Visible = (q == "") or (string.find(string.lower(r.entry.title), q, 1, true) ~= nil)
            end
        end))
    end

    window:_track(pill.Activated:Connect(function()
        if isLocked() then return end
        setOpen(not open)
    end))

    build()

    local obj = {
        Instance = outer,
        Get = function() return result() end,
        Set = function(_, v, fire)
            setSelection(v)
            refresh()
            if fire then fireCallback() end
        end,
        Select = function(self2, v, fire) self2:Set(v, fire) end,
        Refresh = function(_, newValues)
            local keep = {}
            for k in pairs(selected) do keep[k] = true end
            normalize(newValues)
            selected = {}
            for _, e in ipairs(entries) do
                if not e.divider and keep[e.key] then selected[e.key] = true end
            end
            build()
        end,
        Open = function() setOpen(true) end,
        Close = function() setOpen(false) end,
        SetLocked = function(_, v) setLocked(v) end,
    }
    obj._save = function()
        local out = {}
        for _, e in ipairs(entries) do
            if not e.divider and selected[e.key] then table.insert(out, e.key) end
        end
        if multi then return out end
        return out[1]
    end
    obj._load = function(v) obj:Set(v, true) end
    return registerFlag(options.Flag, obj)
end

--------------------------------------------------------------- Paragraph
function Module:AddParagraph(options)
    options = options or {}
    local card = new("Frame", {
        BackgroundColor3 = Theme.Surface, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        Parent = self.SettingsFrame,
