function BlvckUI:CreateWindow(options)
    options = options or {}
    if options.Compact ~= nil then
        BlvckUI:SetCompact(options.Compact)
    end

    -- розмір вікна: не більший за екран (важливо для телефонів)
    local vp = getViewport()
    local baseW = options.Size and options.Size.X.Offset or M.WinW
    local baseH = options.Size and options.Size.Y.Offset or M.WinH
    local winW = math.floor(math.min(baseW, math.max(260, vp.X - M.Margin * 2)))
    local winH = math.floor(math.min(baseH, math.max(180, vp.Y - M.Margin * 2)))
    local size = UDim2.new(0, winW, 0, winH)
    local listWidth = M.ListWidth or math.floor(winW * M.ListFrac + 0.5)

    local self = setmetatable({}, Window)
    self._categories = {}
    self._size = size
    self.ListWidth = listWidth
    self._janitor = newJanitor()

    self.Main = self._janitor:add(new("Frame", {
        BackgroundColor3 = Theme.Background,
        Size = UDim2.new(size.X.Scale, 0, size.Y.Scale, 0),
        Position = UDim2.new(0.5, -winW / 2, 0.5, -winH / 2),
        ClipsDescendants = true,
        Parent = BlvckUI.ScreenGui,
    }, { corner(UDim.new(0, M.Radius)), stroke() }))

    tween(self.Main, EASE_OPEN, { Size = size })

    ------------------------------------------------ Header
    local Header = new("Frame", { BackgroundColor3 = Theme.Surface, Size = UDim2.new(1, 0, 0, M.HeaderH), Parent = self.Main },
        { corner(UDim.new(0, M.Radius)) })
    new("Frame", { -- маска нижніх кутів (тільки верх заокруглений)
        BackgroundColor3 = Theme.Surface, Position = UDim2.new(0, 0, 1, -M.Radius),
        Size = UDim2.new(1, 0, 0, M.Radius), BorderSizePixel = 0, Parent = Header,
    })

    local iconBox = new("Frame", {
        BackgroundColor3 = Theme.Accent, Position = UDim2.new(0, M.HeaderPad, 0.5, -M.HeaderIconBox / 2),
        Size = UDim2.new(0, M.HeaderIconBox, 0, M.HeaderIconBox), Parent = Header,
    }, { corner(UDim.new(0, M.HeaderIconCorner)) })
    local headerIcon = makeIcon(options.Icon or "sparkles", M.HeaderIcon, Color3.new(1, 1, 1))
    headerIcon.AnchorPoint = Vector2.new(0.5, 0.5)
    headerIcon.Position = UDim2.new(0.5, 0, 0.5, 0)
    headerIcon.Parent = iconBox

    local titleX = M.HeaderPad + M.HeaderIconBox + (M == COMPACT and 8 or 12)
    local titleHolder = new("Frame", {
        BackgroundTransparency = 1, Position = UDim2.new(0, titleX, 0.5, -M.TitleHolderH / 2),
        Size = UDim2.new(0, M.TitleHolderW, 0, M.TitleHolderH), Parent = Header,
    })
    self.TitleLabel = new("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, M.TitleH), Text = options.Title or "BlvckUI",
        Font = Theme.FontBold, TextSize = M.TitleSize, TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = titleHolder,
    })
    if options.Badge then
        new("TextLabel", {
            BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, M.BadgeY), Size = UDim2.new(1, 0, 0, M.BadgeH),
            Text = "◆ " .. options.Badge, Font = Theme.Font, TextSize = M.BadgeSize, TextColor3 = Theme.SubText,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = titleHolder,
        })
    end

    local user = options.User or {}
