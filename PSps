--------------------------------------------------------------- Image (rbxassetid / число)
function Module:AddImage(options)
    options = options or {}
    local window = self._window
    local ratio = 16 / 9
    if type(options.AspectRatio) == "number" then
        ratio = options.AspectRatio
    elseif type(options.AspectRatio) == "string" then
        local a, b = options.AspectRatio:match("^(%d+%.?%d*):(%d+%.?%d*)$")
        if a and b and tonumber(b) ~= 0 then ratio = tonumber(a) / tonumber(b) end
    end

    local image = options.Image
    if type(image) == "number" then image = "rbxassetid://" .. image end

    local img = new("ImageLabel", {
        BackgroundColor3 = Theme.Surface, Image = image or "", ScaleType = Enum.ScaleType.Crop,
        Size = UDim2.new(1, 0, 0, options.Height or 100), Parent = self.SettingsFrame,
    }, { corner(UDim.new(0, options.Radius or M.RowCorner)), stroke() })

    if not options.Height then
        window:_track(img:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            local w = img.AbsoluteSize.X
            if w <= 0 then return end
            local h = math.floor(w / ratio + 0.5)
            if math.abs(img.AbsoluteSize.Y - h) > 1 then
                img.Size = UDim2.new(1, 0, 0, h)
            end
        end))
    end

    return { Instance = img, SetImage = function(_, i) img.Image = type(i) == "number" and ("rbxassetid://" .. i) or tostring(i) end }
end

--------------------------------------------------------------- Slider (Step, Textbox, Tooltip, Icons, Desc, Locked, Flag)
function Module:AddSlider(options)
    options = options or {}
    local window = self._window

    local vopt = type(options.Value) == "table" and options.Value or {}
    local min = vopt.Min or options.Min or 0
    local max = vopt.Max or options.Max or 100
    if max <= min then max = min + 1 end
    local default = vopt.Default or options.Default or min
    local step = options.Step or 1
    if step <= 0 then step = 1 end
    local suffix = options.Suffix or ""

    local decimals = 0
    do
        local s = tostring(step)
        local dot = s:find("%.")
        if dot then decimals = #s - dot end
    end
    local fmt = "%." .. decimals .. "f"

    local function snap(raw)
        local v = math.floor((raw - min) / step + 0.5) * step + min
        v = math.clamp(v, min, max)
        return tonumber(string.format(fmt, v))
    end
    local function show(v) return string.format(fmt, v) .. suffix end

    local value = snap(default)
    local useTextbox = options.IsTextbox == true
    local useTooltip = options.IsTooltip == true or options.Tooltip == true

    local holder, outer = newStack(self.SettingsFrame, 0)

    local headerRow = newRow(holder)
    headerRow.LayoutOrder = 1
    local valueW = M.SliderValW
    textBlock(headerRow, options.Text or options.Title, options.Desc, valueW + 8, M.SliderLabelH)

    local valueObj
    if useTextbox then
        valueObj = new("TextBox", {
            BackgroundColor3 = Theme.Surface, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
            Size = UDim2.new(0, valueW, 0, M.SliderLabelH + 4), Text = show(value), ClearTextOnFocus = true,
            Font = Theme.Font, TextSize = M.SliderValText, TextColor3 = Theme.Text, Parent = headerRow,
        }, { corner(UDim.new(0, 5)), stroke() })
    else
        valueObj = new("TextLabel", {
            BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
            Size = UDim2.new(0, valueW, 0, M.SliderLabelH), Text = show(value), Font = Theme.Font,
            TextSize = M.SliderValText, TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Right,
            Parent = headerRow,
        })
    end

    local areaH = math.max(M.SliderH - M.SliderLabelH, M.SliderKnob + 8)
    local area = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, areaH), LayoutOrder = 2, Parent = holder })

    local iconFrom = options.Icons and options.Icons.From
    local iconTo = options.Icons and options.Icons.To
    local isz = M.SelCheck
    local leftPad = (iconFrom and iconFrom ~= "") and (isz + 8) or 0
    local rightPad = (iconTo and iconTo ~= "") and (isz + 8) or 0
    if leftPad > 0 then
        local ic = makeIcon(iconFrom, isz, Theme.SubText)
        ic.AnchorPoint = Vector2.new(0, 0.5)
        ic.Position = UDim2.new(0, 0, 0.5, 0)
        ic.Parent = area
    end
    if rightPad > 0 then
        local ic = makeIcon(iconTo, isz, Theme.SubText)
        ic.AnchorPoint = Vector2.new(1, 0.5)
        ic.Position = UDim2.new(1, 0, 0.5, 0)
        ic.Parent = area
    end

    local track = new("Frame", {
        BackgroundColor3 = Theme.Surface, Position = UDim2.new(0, leftPad, 0.5, -M.TrackH / 2),
        Size = UDim2.new(1, -(leftPad + rightPad), 0, M.TrackH), Parent = area,
    }, { corner(UDim.new(1, 0)) })
    local rel0 = (value - min) / (max - min)
    local fill = new("Frame", { BackgroundColor3 = Theme.Accent, Size = UDim2.new(rel0, 0, 1, 0), Parent = track },
        { corner(UDim.new(1, 0)) })
    local knob = new("Frame", {
        BackgroundColor3 = Color3.new(1, 1, 1), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(rel0, 0, 0.5, 0), Size = UDim2.new(0, M.SliderKnob, 0, M.SliderKnob), ZIndex = 2, Parent = track,
    }, { corner(UDim.new(1, 0)) })

    local tip
    if useTooltip then
        tip = new("TextLabel", {
            BackgroundColor3 = Theme.Accent, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0, -6),
            Size = UDim2.new(0, 0, 0, M.SliderLabelH + 2), AutomaticSize = Enum.AutomaticSize.X, Text = show(value),
            Font = Theme.FontBold, TextSize = M.SliderValText, TextColor3 = contrastText(Theme.Accent), Visible = false,
            ZIndex = 5, Parent = knob,
        }, { corner(UDim.new(0, 5)), padding(0, { Left = 6, Right = 6 }) })
    end

    -- Більша зона торкання над доріжкою (пальцем у тонку смужку не влучити)
    local hit = new("TextButton", {
        BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 3,
        Position = UDim2.new(0, leftPad, 0.5, -M.SliderHit / 2), Size = UDim2.new(1, -(leftPad + rightPad), 0, M.SliderHit),
        Parent = area,
    })

    local setLocked, isLocked = attachLock(outer, options)

    local function render()
        local rel = (value - min) / (max - min)
        tween(fill, TweenInfo.new(0.08), { Size = UDim2.new(rel, 0, 1, 0) })
        tween(knob, TweenInfo.new(0.08), { Position = UDim2.new(rel, 0, 0.5, 0) })
        if not (useTextbox and valueObj:IsFocused()) then valueObj.Text = show(value) end
        if tip then tip.Text = show(value) end
    end

    local function setValue(v, fire)
        local nv = snap(v)
        local changed = (nv ~= value)
        value = nv
        render()
        if fire and changed and options.Callback then task.spawn(options.Callback, value) end
    end

    local function fromInput(input)
        local w = track.AbsoluteSize.X
        if w <= 0 then return end
        local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / w, 0, 1)
        setValue(min + (max - min) * rel, true)
    end

    local dragging = false
    local scroll = self._scroll
    window:_track(hit.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if isLocked() then return end
        dragging = true
        if scroll then scroll.ScrollingEnabled = false end -- щоб панель не скролилась поки тягнемо повзунок пальцем
        if tip then tip.Visible = true end
        fromInput(input)
    end))
    window:_track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                if scroll then scroll.ScrollingEnabled = true end
                if tip then tip.Visible = false end
            end
        end
    end))
    window:_track(UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
        fromInput(input)
    end))

    if useTextbox then
        window:_track(valueObj.FocusLost:Connect(function()
            local n = tonumber(valueObj.Text:match("-?%d+%.?%d*"))
            if n and not isLocked() then setValue(n, true) else valueObj.Text = show(value) end
        end))
    end

    local obj = {
        Instance = outer,
        Get = function() return value end,
        Set = function(_, v, fire) setValue(tonumber(v) or value, fire) end,
        SetLocked = function(_, v) setLocked(v) end,
    }
    obj._save = function() return value end
    obj._load = function(v) obj:Set(v, true) end
    return registerFlag(options.Flag, obj)
end

--------------------------------------------------------------- Конфіги (Flag -> JSON)
local function cfgPath(name)
    return (BlvckUI.ConfigFolder or "BlvckUI") .. "/" .. tostring(name) .. ".json"
end

function BlvckUI:SetConfigFolder(folder)
    BlvckUI.ConfigFolder = folder
end

function BlvckUI:SaveConfig(name)
    if not (writefile and makefolder) then
        warn("[BlvckUI] writefile/makefolder недоступні в цьому середовищі")
        return false
    end
    local data = {}
    for flag, obj in pairs(BlvckUI.Flags) do
        if obj._save then
            local ok, val = pcall(obj._save)
            if ok then data[flag] = val end
        end
    end
    local folder = BlvckUI.ConfigFolder or "BlvckUI"
    if isfolder and not isfolder(folder) then pcall(makefolder, folder) end
    local ok, err = pcall(function() writefile(cfgPath(name), HttpService:JSONEncode(data)) end)
    if not ok then warn("[BlvckUI] SaveConfig: " .. tostring(err)) end
    return ok
end

function BlvckUI:LoadConfig(name)
    if not (readfile and isfile) then return false end
    local path = cfgPath(name)
    if not isfile(path) then return false end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if not ok or type(data) ~= "table" then return false end
    for flag, val in pairs(data) do
        local obj = BlvckUI.Flags[flag]
        if obj and obj._load then pcall(obj._load, val) end
    end
    return true
end

function BlvckUI:ListConfigs()
    local out = {}
    if not (listfiles and isfolder) then return out end
    local folder = BlvckUI.ConfigFolder or "BlvckUI"
    if not isfolder(folder) then return out end
    for _, path in ipairs(listfiles(folder)) do
        local name = tostring(path):match("([^/\\]+)%.json$")
        if name then table.insert(out, name) end
    end
    return out
end

function BlvckUI:DeleteConfig(name)
    if not (delfile and isfile) then return false end
    local path = cfgPath(name)
    if isfile(path) then delfile(path) return true end
    return false
end

