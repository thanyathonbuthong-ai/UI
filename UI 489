function Window:AddBottomTabBar(tabNames)
	local bar = Utils.New("Frame", {
		Name = "BottomTabBar", BackgroundTransparency = 0.6,
		BackgroundColor3 = Color3.fromRGB(15, 12, 30),
		Size = UDim2.new(1, -40, 0, 56), Position = UDim2.new(0.5, 0, 1, -16),
		AnchorPoint = Vector2.new(0.5, 1), ClipsDescendants = true,
		Parent = self.ScreenGui, ZIndex = 120,
	}, { Utils.Corner(28), Utils.Stroke(self.Palette.Accent, 1.2, 0.5) })
	local glow = Utils.MakeGlow(bar, self.Palette, 30, 0.55)
	glow.ZIndex = 119
	Utils.New("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 6), Parent = bar,
	})
	local buttons = {}
	for i, name in ipairs(tabNames) do
		local b = Utils.New("TextButton", {
			AutoButtonColor = false, Text = "", Size = UDim2.new(1 / #tabNames, -8, 1, -12),
			BackgroundTransparency = 1, LayoutOrder = i, Parent = bar, ZIndex = 121,
		}, { Utils.Corner(20) })
		local lbl = Utils.New("TextLabel", {
			BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Font = CONFIG.FontHeader,
			Text = name, TextSize = 12, TextColor3 = Color3.fromRGB(160, 155, 190),
			Parent = b, ZIndex = 122,
		})
		b.MouseEnter:Connect(function()
			Utils.Tween(b, CONFIG.TweenFast, { BackgroundTransparency = 0.8, BackgroundColor3 = self.Palette.Accent })
		end)
		b.MouseLeave:Connect(function()
			if i ~= self._bottomActive then
				Utils.Tween(b, CONFIG.TweenFast, { BackgroundTransparency = 1 })
			end
		end)
		b.MouseButton1Click:Connect(function()
			self._bottomActive = i
			for j, ob in ipairs(buttons) do
				Utils.Tween(ob, CONFIG.TweenFast, { BackgroundTransparency = j == i and 0.7 or 1 })
				Utils.Tween(ob:FindFirstChildWhichIsA("TextLabel"), CONFIG.TweenFast, {
					TextColor3 = j == i and Color3.fromRGB(255,255,255) or Color3.fromRGB(160,155,190),
				})
			end
			self:SelectTab(name)
		end)
		table.insert(buttons, b)
	end
	return { Object = bar, Buttons = buttons }
end

--================================================================================
--// SECTION 45 — DESIGN PRINCIPLES (why Aurora looks the way it does)
--================================================================================
--[[
	Aurora UI follows six design principles that define its distinct identity
	(separate from WindUI and other flat libraries):

	1. DEPTH THROUGH LAYERING
	   Every surface is at least 3 layers: base translucent fill, top-edge
	   highlight (1px white at 15% opacity), and outer soft glow. This creates
	   the "floating glass" illusion without real backdrop blur.

	2. GRADIENT AS A FIRST-CLASS CITIZEN
	   Accents are never flat colors. Every primary surface carries a 2-stop
	   gradient with slow rotational drift (±25°), giving the UI a living,
	   aurora-like quality. 10 curated palettes cover the full hue range.

	3. CONTRAST HIERARCHY
	   Title = GothamBlack 16pt white, header = GothamBold 14pt, body =
	   GothamMedium 13pt light gray, hint = 11pt muted purple. Four levels
	   max — never more, so the eye always knows what to read first.

	4. MOTION WITH MEANING
	   Hover = scale 1.045 + glow transparency 0.6→0.35. Press = squash 0.96
	   + spring back. Page switch = 5% vertical slide-in. Every animation
	   communicates state; none is purely decorative.

	5. MOBILE AS EQUAL CITIZEN
	   Touch targets ≥44px. Sidebar collapses to 64px icon rail. UIScale
	   auto-fits. Drag/resize/slider all accept Touch input. No hover-only
	   interactions.

	6. THE DARK CANVAS
	   Base background is #0C0A1A (deep violet-navy), never pure black.
	   Aurora blobs (violet/blue/pink/gold/green) drift behind glass at
	   55% transparency, so the UI feels like it's floating in nebula space.

	If you fork this library, preserve these six principles and it will still
	feel like Aurora. Change them and you'll have a different (but still
	valid) design language.
]]

