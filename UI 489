local Hotkeys = {}
Hotkeys._binds = {}
Hotkeys._conn = nil

function Aurora:BindHotkey(keyCode, callback)
	if not Hotkeys._conn then
		Hotkeys._conn = UserInputService.InputBegan:Connect(function(input, gp)
			if gp then return end
			for _, bind in ipairs(Hotkeys._binds) do
				if bind.Key == input.KeyCode then bind.Callback() end
			end
		end)
	end
	table.insert(Hotkeys._binds, { Key = keyCode, Callback = callback })
end

function Aurora:UnbindHotkey(keyCode)
	for i, b in ipairs(Hotkeys._binds) do
		if b.Key == keyCode then table.remove(Hotkeys._binds, i) end
	end
end

