--- Drag the window by titlebar (mouse + touch).
function Window:_SetupDrag(handle)
	local dragging, dragStart, startPos = false, nil, nil
	local function begin(input)
		dragging = true
		dragStart = input.Position
		startPos = self.Window.Position
		self.Window.ClipsDescendants = false
	end
	local function move(input)
		if not dragging then return end
		local delta = input.Position - dragStart
		local newPos = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
		-- clamp to screen
		local vp = Utils.Viewport()
		local s = self.UIScale.Scale
		local winW = self.Window.AbsoluteSize.X * s
		local winH = self.Window.AbsoluteSize.Y * s
		local x = Utils.Clamp(newPos.X.Offset, -vp.X/2 + 40, vp.X/2 - 40)
		local y = Utils.Clamp(newPos.Y.Offset, -vp.Y/2 + 30, vp.Y/2 - 30)
		self.Window.Position = UDim2.new(0.5, x, 0.5, y)
	end
	local function finish()
		dragging = false
		self.Window.ClipsDescendants = true
	end
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			begin(input)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
			move(input)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			finish()
		end
	end)
end

--- Resize handle bottom-right.
function Window:_SetupResize()
	local grip = Utils.New("TextButton", {
		Name = "ResizeGrip", BackgroundTransparency = 1, Text = "",
		Size = UDim2.fromOffset(22, 22), Position = UDim2.new(1, -2, 1, -2),
		AnchorPoint = Vector2.new(1, 1), AutoButtonColor = false,
		Parent = self.Window, ZIndex = 50,
	})
	Utils.New("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.fromScale(1,1), Text = "⤡",
		Font = CONFIG.FontBody, TextSize = 12, TextColor3 = Color3.fromRGB(180,175,210),
		Parent = grip, ZIndex = 51,
	})
	local resizing, startInput, startSize = false, nil, nil
	grip.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			resizing = true
			startInput = input.Position
			startSize = self.Window.Size
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not resizing then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement
		and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local delta = input.Position - startInput
		local s = self.UIScale.Scale
		local newW = Utils.Clamp(startSize.X.Offset + delta.X / s, CONFIG.MinWindowWidth, 1200)
		local newH = Utils.Clamp(startSize.Y.Offset + delta.Y / s, CONFIG.MinWindowHeight, 900)
		Utils.Tween(self.Window, TweenInfo.new(0.05), { Size = UDim2.fromOffset(newW, newH) })
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			resizing = false
		end
	end)
end

