--================================================================================
--// SECTION 29 — UTILITY EXTENSIONS (color, string, table helpers)
--================================================================================

--- Convert Color3 to hex string.
function Utils.ColorToHex(c)
	return string.format("#%02X%02X%02X", c.R * 255, c.G * 255, c.B * 255)
end

--- Convert hex string to Color3.
function Utils.HexToColor(hex)
	hex = hex:gsub("#", "")
	local r = tonumber(hex:sub(1, 2), 16) / 255
	local g = tonumber(hex:sub(3, 4), 16) / 255
	local b = tonumber(hex:sub(5, 6), 16) / 255
	return Color3.new(r, g, b)
end

--- Lighten a color by amount (0..1).
function Utils.Lighten(c, amount)
	return Color3.new(
		Utils.Clamp(c.R + amount, 0, 1),
		Utils.Clamp(c.G + amount, 0, 1),
		Utils.Clamp(c.B + amount, 0, 1)
	)
end

--- Darken a color by amount (0..1).
function Utils.Darken(c, amount)
	return Color3.new(
		Utils.Clamp(c.R - amount, 0, 1),
		Utils.Clamp(c.G - amount, 0, 1),
		Utils.Clamp(c.B - amount, 0, 1)
	)
end

--- String truncation with ellipsis.
function Utils.Truncate(str, maxLen)
	if #str <= maxLen then return str end
	return str:sub(1, maxLen - 3) .. "..."
end

--- Table deep copy.
function Utils.DeepCopy(orig)
	local copy
	if type(orig) == "table" then
		copy = {}
		for k, v in next, orig, nil do
			copy[Utils.DeepCopy(k)] = Utils.DeepCopy(v)
		end
		setmetatable(copy, Utils.DeepCopy(getmetatable(orig)))
	else
		copy = orig
	end
	return copy
end

--- Count array length.
function Utils.Count(tbl)
	local n = 0
	for _ in pairs(tbl) do n = n + 1 end
	return n
end

--- Safe call wrapper.
function Utils.SafeCall(fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[AuroraUI] Error:", err)
	end
	return ok, err
end

--- Throttle a function (max once per interval).
function Utils.Throttle(fn, interval)
	local last = 0
	return function(...)
		local now = tick()
		if now - last >= interval then
			last = now
			return fn(...)
		end
	end
end

--- Create a gradient between two hex colors.
function Utils.GradientFromHex(hex1, hex2, rotation)
	return Utils.New("UIGradient", {
		Color = ColorSequence.new(Utils.HexToColor(hex1), Utils.HexToColor(hex2)),
		Rotation = rotation or 90,
	})
end

--- Make a frame draggable (generic, for custom elements).
function Utils.MakeDraggable(frame, handle)
	handle = handle or frame
	local dragging, startInput, startPos = false, nil, nil
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			startInput = input.Position
			startPos = frame.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement
		and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local delta = input.Position - startInput
		frame.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y
		)
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

--================================================================================
--// SECTION 30 — PERFORMANCE & CLEANUP GUARANTEES
--   Auto-cleanup on PlayerRemoving / CharacterRemoving to prevent leaks.
--================================================================================

local _openWindows = setmetatable({}, { __mode = "v" })
local _origCreate = Aurora.CreateWindow
function Aurora:CreateWindow(options)
	local win = _origCreate(self, options)
	table.insert(_openWindows, win)
	return win
end

Players.PlayerRemoving:Connect(function(player)
	if player == LocalPlayer then
		for _, w in ipairs(_openWindows) do
			if w and w.Destroy then w:Destroy() end
		end
		Anim.Cleanup()
	end
end)

-- Heartbeat memory: cap active animation connections at 200; if exceeded,
-- warn and stop oldest non-essential drift animations.
local _connCount = 0
local _origDrift = Anim.DriftGradient
function Anim.DriftGradient(...)
	_connCount = _connCount + 1
	if _connCount > 200 then
		warn("[AuroraUI] High animation count (>200); consider reducing gradient drift.")
	end
	return _origDrift(...)
end

