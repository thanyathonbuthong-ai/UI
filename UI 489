		VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 12), Parent = row,
	})

	local function makeOne(iconName, cb, palIdx)
		local p = PALETTES[palIdx or 1]
		local wrap = Utils.New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(48, 48), Parent = row, ZIndex = 10 })
		local glow = Utils.New("ImageLabel", {
