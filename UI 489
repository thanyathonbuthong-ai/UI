--================================================================================
--// SECTION 26 — ANIMATION PRESET LIBRARY (shake, fade, slide, bounce, pulse)
--   Call these on any GuiObject for instant juice.
--================================================================================

local PresetAnim = {}

--- Shake a frame (e.g. on error).
function PresetAnim.Shake(frame, intensity, duration)
	intensity = intensity or 8
	duration = duration or 0.4
	local base = frame.Position
	local start = tick()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local t = tick() - start
		if t > duration then
			conn:Disconnect()
			frame.Position = base
			return
		end
		local decay = 1 - (t / duration)
		frame.Position = UDim2.new(
			base.X.Scale, base.X.Offset + math.random(-intensity, intensity) * decay,
			base.Y.Scale, base.Y.Offset + math.random(-intensity, intensity) * decay
		)
	end)
end

--- Fade in/out a gui.
function PresetAnim.Fade(gui, targetTransparency, duration)
	duration = duration or 0.3
	local function apply(obj)
		if obj:IsA("Frame") or obj:IsA("TextButton") or obj:IsA("TextBox") or obj:IsA("ImageLabel") then
			Utils.Tween(obj, TweenInfo.new(duration, Enum.EasingStyle.Quad), {
				BackgroundTransparency = targetTransparency,
			})
		end
		if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
			Utils.Tween(obj, TweenInfo.new(duration, Enum.EasingStyle.Quad), {
				TextTransparency = targetTransparency,
			})
		end
		if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
			Utils.Tween(obj, TweenInfo.new(duration, Enum.EasingStyle.Quad), {
				ImageTransparency = targetTransparency,
			})
		end
		for _, child in ipairs(obj:GetChildren()) do apply(child) end
	end
	apply(gui)
end

--- Slide a gui from an offset to its position.
function PresetAnim.SlideIn(gui, fromOffset, duration)
	duration = duration or 0.4
	local target = gui.Position
	gui.Position = UDim2.new(target.X.Scale, target.X.Offset + fromOffset.X,
		target.Y.Scale, target.Y.Offset + fromOffset.Y)
	Utils.Tween(gui, TweenInfo.new(duration, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Position = target,
	})
end

--- Bounce a gui (scale pop).
function PresetAnim.Bounce(gui, scale, duration)
	scale = scale or 1.15
	duration = duration or 0.5
	local base = gui.Size
	Utils.Tween(gui, TweenInfo.new(duration / 2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = UDim2.new(base.X.Scale * scale, base.X.Offset * scale,
		                 base.Y.Scale * scale, base.Y.Offset * scale),
	})
	task.delay(duration / 2, function()
		Utils.Tween(gui, TweenInfo.new(duration / 2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = base,
		})
	end)
end

--- Continuous pulse (returns connection; call :Disconnect() to stop).
function PresetAnim.Pulse(gui, minScale, maxScale, speed)
	minScale = minScale or 0.95
	maxScale = maxScale or 1.05
	speed = speed or 2
	local base = gui.Size
	return RunService.RenderStepped:Connect(function()
		local t = (math.sin(tick() * speed) + 1) / 2
		local s = minScale + (maxScale - minScale) * t
		gui.Size = UDim2.new(base.X.Scale * s, base.X.Offset * s,
		                     base.Y.Scale * s, base.Y.Offset * s)
	end)
end

--- Rainbow-tint a UIStroke over time.
function PresetAnim.RainbowStroke(stroke, speed)
	speed = speed or 0.5
	return RunService.RenderStepped:Connect(function()
		local h = (tick() * speed) % 1
		stroke.Color = Color3.fromHSV(h, 0.7, 1)
	end)
end

Aurora.AnimPresets = PresetAnim

--================================================================================
--// SECTION 27 — THEME ENGINE (per-component style overrides)
--   Allows deep customization without editing library internals.
--================================================================================

local ThemeEngine = {}
ThemeEngine._overrides = {}

--- Register a style override for a component type.
--  componentType: "PrimaryButton", "Card", "Toggle", "Slider", etc.
--  overrides: table of properties to apply (Color, Transparency, Radius, ...)
function ThemeEngine.Override(componentType, overrides)
	ThemeEngine._overrides[componentType] = overrides
end

--- Get effective style for a component type (merged with defaults).
function ThemeEngine.Get(componentType)
	local defaults = {
		PrimaryButton = { Radius = 12, Glow = true, Font = CONFIG.FontHeader, TextSize = 14 },
		Card          = { Radius = 18, Transparency = 0.78, StrokeTrans = 0.82 },
		Toggle        = { Width = 52, Height = 28, Radius = 14 },
		Slider        = { Height = 10, KnobSize = 20, Rainbow = true },
		Window        = { Radius = 20, Transparency = 0.72, TitlebarHeight = 46 },
		Sidebar       = { Width = 180, MobileWidth = 64 },
		Notification  = { Width = 320, Height = 64, Duration = 4 },
		Modal         = { Width = 380, Height = 220, Radius = 20 },
	}
	local base = defaults[componentType] or {}
	local ov = ThemeEngine._overrides[componentType] or {}
	return Utils.Merge(base, ov)
end

--- Reset all overrides.
function ThemeEngine.Reset()
	ThemeEngine._overrides = {}
end

--- Apply a named "skin" preset.
function ThemeEngine.ApplySkin(skinName)
	local skins = {
		Minimal = {
			Window = { Transparency = 0.85, Radius = 12 },
			Card = { Transparency = 0.9, Radius = 10 },
			PrimaryButton = { Glow = false, Radius = 8 },
		},
		Neon = {
			Card = { Transparency = 0.6, StrokeTrans = 0.3 },
			PrimaryButton = { Glow = true },
		},
		Flat = {
			Window = { Transparency = 0.5, Radius = 4 },
			Card = { Transparency = 0.5, Radius = 4 },
			PrimaryButton = { Glow = false, Radius = 4 },
		},
	}
	local skin = skins[skinName]
	if not skin then return false end
	for comp, ov in pairs(skin) do
		ThemeEngine.Override(comp, ov)
	end
	return true
end

Aurora.Theme = ThemeEngine

--================================================================================
--// SECTION 28 — DECLARATIVE UI BUILDER (build from a table spec)
--   Aurora:Build(window, spec) — generates a full tab tree from data.
--================================================================================

function Aurora:Build(window, spec)
	for _, tabSpec in ipairs(spec.Tabs or {}) do
		local tab = window:AddTab({ Name = tabSpec.Name, Icon = tabSpec.Icon })
		for _, comp in ipairs(tabSpec.Components or {}) do
			local t = comp.Type
			if t == "Section" then tab:AddSection(comp.Props)
			elseif t == "PrimaryButton" then tab:AddPrimaryButton(comp.Props)
			elseif t == "OutlineButton" then tab:AddOutlineButton(comp.Props)
			elseif t == "GlassButton" then tab:AddGlassButton(comp.Props)
			elseif t == "Toggle" then tab:AddToggle(comp.Props)
			elseif t == "Slider" then tab:AddSlider(comp.Props)
