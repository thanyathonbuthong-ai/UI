			Utils.Tween(btn, CONFIG.TweenFast, { BackgroundTransparency = 1 })
			Utils.Tween(label, CONFIG.TweenFast, { TextColor3 = Color3.fromRGB(190, 185, 220) })
		end
	end)

	btn.MouseButton1Click:Connect(function()
		Anim.PressFeedback(btn)
		self:SelectTab(tab.Name)
	end)

	table.insert(self.Tabs, tab)
	if tab.Index == 1 then self:SelectTab(tab.Name) end
	return tab
end

function Window:SelectTab(name)
	for _, t in ipairs(self.Tabs) do
		local active = (t.Name == name)
		t.Page.Visible = active
		t.Indicator.Visible = active
		Utils.Tween(t.SideButton, CONFIG.TweenFast, {
			BackgroundTransparency = active and 0.82 or 1,
			BackgroundColor3 = active and self.Palette.Accent or Color3.fromRGB(255,255,255),
		})
		Utils.Tween(t.Label, CONFIG.TweenFast, {
			TextColor3 = active and Color3.fromRGB(255,255,255) or Color3.fromRGB(190,185,220),
		})
		Utils.Tween(t.IconImg, CONFIG.TweenFast, {
			ImageTransparency = active and 0 or 0.3,
		})
		if active then
			-- page entrance animation
			t.Page.Position = UDim2.fromScale(0, 0.05)
			Utils.Tween(t.Page, CONFIG.TweenNormal, { Position = UDim2.fromScale(0, 0) })
			self._activeTab = t
		end
	end
end

