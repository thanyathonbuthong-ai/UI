	local track = Utils.New("TextButton", {
		Name = "Track", AutoButtonColor = false, Text = "",
		Size = UDim2.fromOffset(52, 28), Position = UDim2.new(1, -6, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5), BackgroundColor3 = Color3.fromRGB(60, 55, 85),
		BackgroundTransparency = 0.3, Parent = row, ZIndex = 11,
	}, { Utils.Corner(14) })
	Utils.New("UIStroke", { Color = Color3.fromRGB(255,255,255), Transparency = 0.8, Thickness = 1, Parent = track })

	local trackGrad = Utils.Gradient(palette, 0)
	trackGrad.Parent = track
	track.BackgroundTransparency = state and 0.15 or 0.7

	-- Knob
	local knob = Utils.New("Frame", {
		Name = "Knob", Size = UDim2.fromOffset(22, 22),
		Position = state and UDim2.new(1, -25, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = Color3.fromRGB(255,255,255),
		Parent = track, ZIndex = 12,
	}, { Utils.Corner(11) })
	Utils.New("UIStroke", { Color = palette.Accent, Transparency = 0.3, Thickness = 1, Parent = knob })

	local function applyState(s, animate)
		state = s
		local info = animate and CONFIG.TweenSpring or TweenInfo.new(0)
		Utils.Tween(knob, info, {
			Position = s and UDim2.new(1, -25, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
			BackgroundColor3 = s and palette.TextOn or Color3.fromRGB(255,255,255),
		})
		Utils.Tween(track, info, { BackgroundTransparency = s and 0.15 or 0.7 })
		if options.Callback then options.Callback(s) end
	end

	track.MouseButton1Click:Connect(function()
		applyState(not state, true)
	end)

	return {
		Object = track, Knob = knob,
		GetState = function() return state end,
		SetState = function(_, s) applyState(s, true) end,
	}
end

