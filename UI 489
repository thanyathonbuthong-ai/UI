		Font = CONFIG.FontTitle, Text = options.Title or "Confirm", TextColor3 = Color3.fromRGB(245, 243, 255),
		TextSize = 18, Parent = modal, ZIndex = 302,
	})
	local desc = Utils.New("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(24, 56), Size = UDim2.new(1, -48, 0, 60),
		Font = CONFIG.FontBody, Text = options.Description or "", TextColor3 = Color3.fromRGB(190, 185, 215),
		TextSize = 13, TextWrapped = true, Parent = modal, ZIndex = 302,
	})

	-- entrance
	modal.Size = UDim2.fromOffset(0, 0)
	Utils.Tween(modal, CONFIG.TweenSpring, {
		Size = UDim2.fromOffset(options.Width or 380, options.Height or 220),
	})

	local api = { Object = modal, Backdrop = backdrop }
	local function close()
		Utils.Tween(modal, CONFIG.TweenNormal, { Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1 })
		Utils.Tween(backdrop, CONFIG.TweenFast, { BackgroundTransparency = 1 })
		task.delay(0.35, function() backdrop:Destroy() end)
	end
	api.Close = close

	-- buttons
	local btnY = (options.Height or 220) - 56
	local function mkModalBtn(text, xScale, cb, primary)
		local b = Utils.New("TextButton", {
			AutoButtonColor = false, Text = "", Size = UDim2.fromOffset(130, 38),
			Position = UDim2.new(xScale, 0, 0, btnY), AnchorPoint = Vector2.new(0.5, 0),
			BackgroundColor3 = Color3.fromRGB(255,255,255), BackgroundTransparency = primary and 0 or 0.85,
			Parent = modal, ZIndex = 303,
		}, { Utils.Corner(12) })
		if primary then
			local g = Utils.Gradient(palette, 75)
			g.Parent = b
			Anim.DriftGradient(g, 0.2, 15)
		else
			b.BackgroundColor3 = Color3.fromRGB(40, 35, 65)
		end
		Utils.New("UIStroke", { Color = primary and Color3.fromRGB(255,255,255) or palette.Accent,
			Transparency = primary and 0.5 or 0.5, Thickness = 1, Parent = b })
		Utils.New("TextLabel", {
			BackgroundTransparency = 1, Size = UDim2.fromScale(1,1), Font = CONFIG.FontHeader,
			Text = text, TextColor3 = primary and palette.TextOn or Color3.fromRGB(220, 215, 245),
			TextSize = 13, Parent = b, ZIndex = 304,
		})
		b.MouseButton1Click:Connect(function()
			Anim.PressFeedback(b)
			if cb then cb() end
			close()
		end)
		return b
	end
	if options.Buttons then
		local n = #options.Buttons
		for i, bcfg in ipairs(options.Buttons) do
			local x = 0.5 + (i - (n+1)/2) * 0.32
			mkModalBtn(bcfg.Text, x, bcfg.Callback, bcfg.Primary)
		end
	else
		mkModalBtn("Cancel", 0.32, options.OnCancel, false)
		mkModalBtn("Confirm", 0.68, options.OnConfirm, true)
	end

	backdrop.MouseButton1Click:Connect(function()
		if options.DismissOnBackdrop ~= false then close() end
	end)
	return api
end

