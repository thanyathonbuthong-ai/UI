function Tab:AddColorPicker(options)
	options = options or {}
	local card = self:AddCard({ Title = options.Text or "Color", Height = 150 })
	local palette = self.Window.Palette
	local color = options.Default or Color3.fromRGB(139, 92, 246)

	local preview = Utils.New("Frame", {
		Name = "Preview", Size = UDim2.fromOffset(40, 40), Position = UDim2.fromOffset(0, 0),
		BackgroundColor3 = color, Parent = card.Content, ZIndex = 12,
	}, { Utils.Corner(10), Utils.Stroke(Color3.fromRGB(255,255,255), 1, 0.6) })

	local hexLbl = Utils.New("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(52, 0), Size = UDim2.new(1, -52, 0, 18),
		Font = CONFIG.FontMono, Text = string.format("#%02X%02X%02X", color.R*255, color.G*255, color.B*255),
		TextColor3 = Color3.fromRGB(230, 228, 250), TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card.Content, ZIndex = 12,
	})

	local sliders = {}
	local channels = { "R", "G", "B" }
	for i, ch in ipairs(channels) do
		local y = 46 + (i - 1) * 28
		local track = Utils.New("Frame", {
			Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, 14),
			BackgroundColor3 = Color3.fromRGB(50, 45, 75), BackgroundTransparency = 0.4,
			Parent = card.Content, ZIndex = 12,
		}, { Utils.Corner(7) })
		local fill = Utils.New("Frame", {
			BackgroundTransparency = 0, Size = UDim2.new(color[ch:lower()], 0, 1, 0),
			BackgroundColor3 = Color3.fromRGB(255,255,255), Parent = track, ZIndex = 13,
		}, { Utils.Corner(7) })
		local g = Utils.New("UIGradient", {
			Color = ColorSequence.new(Color3.fromRGB(0,0,0),
				ch == "R" and Color3.fromRGB(255,0,0) or ch == "G" and Color3.fromRGB(0,255,0) or Color3.fromRGB(0,0,255)),
			Parent = fill,
		})
		local btn = Utils.New("TextButton", {
			AutoButtonColor = false, Text = "", BackgroundTransparency = 1,
			Size = UDim2.fromScale(1,1), Parent = track, ZIndex = 14,
		})
		sliders[ch] = { Track = track, Fill = fill, Btn = btn }
		local dragging = false
		btn.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
			end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if not dragging then return end
			if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
			local ratio = Utils.Clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
			fill.Size = UDim2.new(ratio, 0, 1, 0)
			local r = sliders.R.Fill.Size.X.Scale
			local gv = sliders.G.Fill.Size.X.Scale
			local b = sliders.B.Fill.Size.X.Scale
			color = Color3.new(r, gv, b)
			preview.BackgroundColor3 = color
			hexLbl.Text = string.format("#%02X%02X%02X", r*255, gv*255, b*255)
			if options.Callback then options.Callback(color) end
		end)
	end

	return { Object = card.Object, GetColor = function() return color end }
end

