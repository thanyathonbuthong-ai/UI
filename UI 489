--================================================================================
--// SECTION 3 — UTILITY FUNCTIONS
--================================================================================

local Utils = {}

--- Create an Instance with properties applied in one call.
function Utils.New(className, props, children)
	local inst = Instance.new(className)
	if props then
		for k, v in pairs(props) do
			inst[k] = v
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = inst
		end
	end
	return inst
end

--- Linear interpolate two Color3.
function Utils.LerpColor(a, b, t)
	return Color3.new(
		a.R + (b.R - a.R) * t,
		a.G + (b.G - a.G) * t,
		a.B + (b.B - a.B) * t
	)
end

--- Convert Color3 -> HSV, shift hue, return Color3.
function Utils.RotateHue(color, degrees)
	local h, s, v = color:ToHSV()
	h = (h + degrees / 360) % 1
	return Color3.fromHSV(h, s, v)
end

--- Clamp a number.
function Utils.Clamp(n, min, max)
	if n < min then return min end
	if n > max then return max end
	return n
end

--- Map a value from one range to another.
function Utils.Map(n, inMin, inMax, outMin, outMax)
	return outMin + (n - inMin) * (outMax - outMin) / (inMax - inMin)
end

--- Quick tween wrapper.
function Utils.Tween(obj, info, props)
	local t = TweenService:Create(obj, info, props)
	t:Play()
	return t
end

--- UICorner factory.
function Utils.Corner(radius)
	return Utils.New("UICorner", { CornerRadius = UDim.new(0, radius) })
end

--- UIStroke factory (glass border).
function Utils.Stroke(color, thickness, transparency)
	return Utils.New("UIStroke", {
		Color           = color or CONFIG.GlassStrokeColor,
		Thickness       = thickness or 1,
		Transparency    = transparency or CONFIG.GlassStrokeTrans,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode    = Enum.LineJoinMode.Round,
	})
end

--- UIGradient factory from a palette.
function Utils.Gradient(palette, rotation)
	local g = Utils.New("UIGradient", {
		Color = ColorSequence.new(palette.From, palette.To),
		Rotation = rotation or 90,
	})
	return g
end

--- Rainbow gradient (for sliders).
function Utils.RainbowGradient(rotation)
	local keypoints = {}
	local n = #RAINBOW_COLORS
	for i, c in ipairs(RAINBOW_COLORS) do
		table.insert(keypoints, ColorSequenceKeypoint.new((i - 1) / (n - 1), c))
	end
	return Utils.New("UIGradient", {
		Color = ColorSequence.new(keypoints),
		Rotation = rotation or 0,
	})
end

--- Soft outer glow (uses a second larger frame behind with gradient + blur-like transparency).
function Utils.MakeGlow(parent, palette, sizeOffset, transparency)
	local glow = Utils.New("Frame", {
		Name             = "Glow",
		BackgroundTransparency = 1,
		AnchorPoint      = Vector2.new(0.5, 0.5),
		Position         = UDim2.new(0.5, 0, 0.5, 0),
		Size             = UDim2.new(1, sizeOffset or 24, 1, sizeOffset or 24),
		ZIndex           = parent.ZIndex - 1,
		Parent           = parent.Parent,
	}, {
		Utils.New("ImageLabel", {
			Name             = "GlowImage",
			BackgroundTransparency = 1,
			Image            = "rbxassetid://5028857084", -- soft radial blob
			ImageColor3      = palette.Glow,
			ImageTransparency = transparency or 0.55,
			ScaleType        = Enum.ScaleType.Fit,
			Size             = UDim2.new(1, 0, 1, 0),
		}),
	})
	return glow
end

--- Resolve an icon name -> asset id, fallback to generic.
function Utils.ResolveIcon(name)
	if not name then return ICONS.star end
	if ICONS[name] then return ICONS[name] end
	if tostring(name):sub(1, 10) == "rbxassetid" then return name end
	return ICONS.star
end

--- Detect touch device.
function Utils.IsMobile()
	return UserInputService.TouchEnabled and not UserInputService.MouseEnabled
end

--- Get viewport size.
function Utils.Viewport()
	return workspace.CurrentCamera.ViewportSize
end

--- Compute auto UIScale so window fits screen.
function Utils.ComputeScale(winW, winH)
	local vp = Utils.Viewport()
	local sx = vp.X / (winW + 60)
	local sy = vp.Y / (winH + 60)
	local s = math.min(sx, sy, 1)
	return Utils.Clamp(s, CONFIG.MinScale, CONFIG.MaxScale)
end

--- Debounce helper.
function Utils.Debounce(fn, interval)
	local last = 0
	return function(...)
		local now = tick()
		if now - last < (interval or 0.1) then return end
		last = now
		return fn(...)
	end
end

--- Deep merge two tables (b overrides a).
function Utils.Merge(a, b)
	local out = {}
	for k, v in pairs(a or {}) do out[k] = v end
	for k, v in pairs(b or {}) do out[k] = v end
	return out
end

--- Format time HH:MM:SS for clock widget.
function Utils.FormatTime(t)
	local h = math.floor(t / 3600)
	local m = math.floor((t % 3600) / 60)
	local s = math.floor(t % 60)
	return string.format("%02d:%02d:%02d", h, m, s)
end

--================================================================================
--// SECTION 4 — ANIMATION ENGINE (gradient drift, glow pulse, hover)
--================================================================================

local Anim = {}
Anim._connections = {}
Anim._driftTargets = {}

--- Register a UIGradient for slow rotation drift (aurora effect).
function Anim.DriftGradient(gradient, speed, amplitude)
	speed = speed or 0.15
	amplitude = amplitude or 25
	local baseRot = gradient.Rotation
	local conn = RunService.RenderStepped:Connect(function(dt)
		local t = tick() * speed
		gradient.Rotation = baseRot + math.sin(t) * amplitude
		gradient.Offset = Vector2.new(math.sin(t * 0.7) * 0.1, math.cos(t * 0.5) * 0.1)
	end)
	table.insert(Anim._connections, conn)
	return conn
end

--- Register a frame for gentle floating position drift (background blobs).
function Anim.DriftFrame(frame, amplitude, speed)
	local basePos = frame.Position
	local conn = RunService.RenderStepped:Connect(function()
		local t = tick() * (speed or 0.4)
		frame.Position = UDim2.new(
			basePos.X.Scale, basePos.X.Offset + math.sin(t) * (amplitude or 30),
			basePos.Y.Scale, basePos.Y.Offset + math.cos(t * 1.3) * (amplitude or 30)
		)
	end)
	table.insert(Anim._connections, conn)
	return conn
end

--- Pulse a glow ImageLabel transparency.
function Anim.PulseGlow(imageLabel, minTrans, maxTrans, speed)
	minTrans = minTrans or 0.5
	maxTrans = maxTrans or 0.75
	speed = speed or 1.2
	local conn = RunService.RenderStepped:Connect(function()
		local t = (math.sin(tick() * speed) + 1) / 2
		imageLabel.ImageTransparency = minTrans + (maxTrans - minTrans) * t
	end)
	table.insert(Anim._connections, conn)
	return conn
end

--- Hover enter/leave pair: scale + glow.
function Anim.ApplyHover(frame, glowImage, onEnter, onLeave)
	local baseSize = frame.Size
	local enter = frame.MouseEnter:Connect(function()
		Utils.Tween(frame, CONFIG.TweenFast, {
			Size = UDim2.new(
				baseSize.X.Scale * CONFIG.HoverScale,
				baseSize.X.Offset * CONFIG.HoverScale,
				baseSize.Y.Scale * CONFIG.HoverScale,
				baseSize.Y.Offset * CONFIG.HoverScale
			),
		})
		if glowImage then
			Utils.Tween(glowImage, CONFIG.TweenFast, { ImageTransparency = 0.35 })
		end
		if onEnter then onEnter() end
	end)
	local leave = frame.MouseLeave:Connect(function()
		Utils.Tween(frame, CONFIG.TweenFast, { Size = baseSize })
		if glowImage then
			Utils.Tween(glowImage, CONFIG.TweenFast, { ImageTransparency = 0.6 })
		end
		if onLeave then onLeave() end
	end)
	table.insert(Anim._connections, enter)
	table.insert(Anim._connections, leave)
	return enter, leave
end

--- Button press feedback (scale down then back).
function Anim.PressFeedback(frame)
	local baseSize = frame.Size
	Utils.Tween(frame, TweenInfo.new(0.08, Enum.EasingStyle.Quad), {
		Size = UDim2.new(baseSize.X.Scale * 0.96, baseSize.X.Offset * 0.96,
		                 baseSize.Y.Scale * 0.96, baseSize.Y.Offset * 0.96),
	})
	task.delay(0.08, function()
		Utils.Tween(frame, CONFIG.TweenSpring, { Size = baseSize })
	end)
end

--- Cleanup all animation connections.
function Anim.Cleanup()
	for _, c in ipairs(Anim._connections) do
		if c.Connected then c:Disconnect() end
	end
	Anim._connections = {}
end

