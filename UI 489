local Presets = {}
Presets._store = {}
Presets._key = "AuroraUI_Settings"

function Presets.Save(key, data)
	local ok, err = pcall(function()
		-- Roblox LocalStorage not always available; fall back to in-memory + _G
		local ls = game:GetService("DataStoreService"):GetDataStore(Presets._key)
		-- async save skipped by default to avoid throttling; use memory
	end)
	Presets._store[key] = data
	if _G then
		_G.AuroraUIPresets = _G.AuroraUIPresets or {}
		_G.AuroraUIPresets[key] = data
	end
	return true
end

function Presets.Load(key)
	if Presets._store[key] then return Presets._store[key] end
	if _G and _G.AuroraUIPresets and _G.AuroraUIPresets[key] then
		return _G.AuroraUIPresets[key]
	end
	return nil
end

function Presets.List()
	local out = {}
	for k in pairs(Presets._store) do table.insert(out, k) end
	if _G and _G.AuroraUIPresets then
		for k in pairs(_G.AuroraUIPresets) do
			if not Presets._store[k] then table.insert(out, k) end
		end
	end
	return out
end

Aurora.Presets = Presets

--- Built-in settings panel: auto-generates a tab from a config table.
function Window:AddSettingsTab(configTable, onSave)
	local tab = self:AddTab({ Name = "Config", Icon = "settings" })
	local controls = {}
	for key, cfg in pairs(configTable) do
		if cfg.Type == "toggle" then
			local t = tab:AddToggle({ Text = cfg.Label or key, Default = cfg.Default == true,
				Callback = function(s) configTable[key].Value = s end })
			controls[key] = t
		elseif cfg.Type == "slider" then
