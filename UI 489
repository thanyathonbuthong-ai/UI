function Aurora:RegisterFocusable(guiObject)
	table.insert(Focus._order, guiObject)
end

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then return end
	if input.KeyCode == Enum.KeyCode.Tab then
		if #Focus._order == 0 then return end
		Focus._index = (Focus._index % #Focus._order) + 1
		local target = Focus._order[Focus._index]
		if target and target.Parent then
			local ring = Focus._ensureRing(target:FindFirstAncestorWhichIsA("ScreenGui"))
			ring.Visible = true
			ring.Position = UDim2.fromOffset(target.AbsolutePosition.X - 4, target.AbsolutePosition.Y - 4)
			ring.Size = UDim2.fromOffset(target.AbsoluteSize.X + 8, target.AbsoluteSize.Y + 8)
		end
	end
