function Tab:AddSlider(options)
	options = options or {}
	local min, max = options.Min or 0, options.Max or 100
	local default = Utils.Clamp(options.Default or min, min, max)
	local row = makeRow(self, 56)
	local palette = self.Window.Palette

	local header = Utils.New("Frame", {
		Name = "SliderHeader", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22), Parent = row, ZIndex = 11,
	})
	local lbl = Utils.New("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.new(0.7, 0, 1, 0), Font = CONFIG.FontBody,
		Text = options.Text or "Slider", TextColor3 = Color3.fromRGB(230, 228, 250), TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = header, ZIndex = 11,
	})
	local valLbl = Utils.New("TextLabel", {
		Name = "Value", BackgroundTransparency = 1, Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0.3, 0, 1, 0), Font = CONFIG.FontHeader,
		Text = tostring(math.floor(default)), TextColor3 = palette.Accent, TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Right, Parent = header, ZIndex = 11,
	})

	-- Track
	local track = Utils.New("TextButton", {
		Name = "Track", AutoButtonColor = false, Text = "",
		Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 0, 10),
		BackgroundColor3 = Color3.fromRGB(50, 45, 75), BackgroundTransparency = 0.4,
		Parent = row, ZIndex = 11,
	}, { Utils.Corner(5) })
	Utils.New("UIStroke", { Color = Color3.fromRGB(255,255,255), Transparency = 0.85, Thickness = 1, Parent = track })

	-- Rainbow fill
	local fill = Utils.New("Frame", {
		Name = "Fill", BackgroundTransparency = 0, Size = UDim2.new(Utils.Map(default, min, max, 0, 1), 0, 1, 0),
		BackgroundColor3 = Color3.fromRGB(255,255,255), Parent = track, ZIndex = 12, ClipsDescendants = true,
	}, { Utils.Corner(5) })
	local rg = Utils.RainbowGradient(0)
	rg.Parent = fill
	Anim.DriftGradient(rg, 0.4, 10)

	-- Knob
	local knob = Utils.New("Frame", {
		Name = "Knob", Size = UDim2.fromOffset(20, 20),
		Position = UDim2.new(Utils.Map(default, min, max, 0, 1), 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(255,255,255),
		Parent = track, ZIndex = 13,
	}, { Utils.Corner(10) })
	Utils.New("UIStroke", { Color = palette.Accent, Transparency = 0.2, Thickness = 2, Parent = knob })
	local knobGlow = Utils.New("ImageLabel", {
		BackgroundTransparency = 1, Image = "rbxassetid://5028857084", ScaleType = Enum.ScaleType.Fit,
		ImageColor3 = palette.Glow, ImageTransparency = 0.5, Size = UDim2.fromOffset(34, 34),
		Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Parent = knob, ZIndex = 12,
	})

	local value = default
	local dragging = false
	local function updateFromInput(input)
		local absX = track.AbsolutePosition.X
		local absW = track.AbsoluteSize.X
		local ratio = Utils.Clamp((input.Position.X - absX) / absW, 0, 1)
		value = min + ratio * (max - min)
		if options.Rounded ~= false then value = math.floor(value + 0.5) end
		local r = Utils.Map(value, min, max, 0, 1)
		fill.Size = UDim2.new(r, 0, 1, 0)
		knob.Position = UDim2.new(r, 0, 0.5, 0)
		valLbl.Text = options.Format and options.Format(value) or tostring(value)
		if options.Callback then options.Callback(value) end
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			updateFromInput(input)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
			updateFromInput(input)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	return {
		Object = track, Fill = fill, Knob = knob,
		GetValue = function() return value end,
		SetValue = function(_, v)
			value = Utils.Clamp(v, min, max)
			local r = Utils.Map(value, min, max, 0, 1)
			Utils.Tween(fill, CONFIG.TweenNormal, { Size = UDim2.new(r, 0, 1, 0) })
			Utils.Tween(knob, CONFIG.TweenNormal, { Position = UDim2.new(r, 0, 0.5, 0) })
