			Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Parent = wrap, ZIndex = 9,
		})
		local btn = Utils.New("TextButton", {
			AutoButtonColor = false, Text = "", Size = UDim2.fromOffset(44, 44),
			Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Color3.fromRGB(255,255,255), Parent = wrap, ZIndex = 10,
		}, { Utils.Corner(22) })
		local g = Utils.Gradient(p, 45)
		g.Parent = btn
		Anim.DriftGradient(g, 0.25, 20)
		Utils.New("UIStroke", { Color = Color3.fromRGB(255,255,255), Transparency = 0.6, Thickness = 1, Parent = btn })
		local ic = Utils.New("ImageLabel", {
			BackgroundTransparency = 1, Image = Utils.ResolveIcon(iconName), ScaleType = Enum.ScaleType.Fit,
			Size = UDim2.fromOffset(22, 22), Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5), ImageColor3 = p.TextOn, Parent = btn, ZIndex = 11,
		})
		btn.MouseEnter:Connect(function()
			Utils.Tween(btn, CONFIG.TweenFast, { Size = UDim2.fromOffset(48, 48) })
			Utils.Tween(glow, CONFIG.TweenFast, { ImageTransparency = 0.4 })
		end)
		btn.MouseLeave:Connect(function()
			Utils.Tween(btn, CONFIG.TweenFast, { Size = UDim2.fromOffset(44, 44) })
			Utils.Tween(glow, CONFIG.TweenFast, { ImageTransparency = 0.65 })
		end)
		btn.MouseButton1Click:Connect(function()
			Anim.PressFeedback(btn)
			if cb then cb() end
		end)
		return btn
	end

	local api = {
		Object = row,
		Add = function(_, iconName, cb, palIdx)
			return makeOne(iconName, cb, palIdx or ((#row:GetChildren() % 5) + 1))
		end,
	}
	-- pre-add the requested icon
	if options.Icon then api:Add(options.Icon, options.Callback, paletteIndex) end
	return api
end

