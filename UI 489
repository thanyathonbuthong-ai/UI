--- Animated number counter (tweens from 0 to target).
function Tab:AddCounter(options)
	options = options or {}
	local palette = PALETTES[options.Palette or 1]
	local row = makeRow(self, 56)
	local card = Utils.New("Frame", {
		BackgroundTransparency = 0.75, BackgroundColor3 = Color3.fromRGB(28, 23, 50),
		Size = UDim2.fromScale(1, 1), Parent = row, ZIndex = 10, ClipsDescendants = true,
	}, { Utils.Corner(14), Utils.Stroke(palette.Accent, 1, 0.5) })
	local label = Utils.New("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 6), Size = UDim2.new(1, -28, 0, 16),
		Font = CONFIG.FontBody, Text = options.Label or "Counter", TextColor3 = Color3.fromRGB(170, 165, 195),
		TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, Parent = card, ZIndex = 11,
	})
	local value = Utils.New("TextLabel", {
		BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 22), Size = UDim2.new(1, -28, 0, 28),
		Font = CONFIG.FontTitle, Text = "0", TextColor3 = palette.Accent, TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Left, Parent = card, ZIndex = 11,
	})
	local target = options.Target or 1000
	task.spawn(function()
		local start = tick()
		local dur = options.Duration or 1.5
		while tick() - start < dur do
			local t = Utils.Clamp((tick() - start) / dur, 0, 1)
			local eased = 1 - (1 - t) ^ 3
			local v = math.floor(target * eased)
			value.Text = options.Prefix .. Utils.FormatNumber and Utils.FormatNumber(v) or tostring(v)
			task.wait()
		end
		value.Text = tostring(target)
	end)
	return { Object = row, Label = value, SetTarget = function(_, t) target = t end }
end

--- Format number with commas (e.g. 1234567 -> 1,234,567).
function Utils.FormatNumber(n)
	local s = tostring(math.floor(n))
	local out = ""
	local len = #s
	for i = 1, len do
		out = out .. s:sub(i, i)
		if (len - i) % 3 == 0 and i ~= len then out = out .. "," end
	end
	return out
end

