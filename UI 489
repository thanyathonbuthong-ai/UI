function Window:AddWatermark(options)
	options = options or {}
	local palette = self.Palette
	local wm = Utils.New("Frame", {
		Name = "Watermark", BackgroundTransparency = 0.6,
		BackgroundColor3 = Color3.fromRGB(15, 12, 30),
		Size = UDim2.fromOffset(220, 34),
		Position = options.Position or UDim2.new(0, 12, 0, 12),
		ClipsDescendants = true, Parent = self.ScreenGui, ZIndex = 90,
	}, { Utils.Corner(10), Utils.Stroke(palette.Accent, 1, 0.5) })
	local glow = Utils.MakeGlow(wm, palette, 20, 0.6)
	glow.ZIndex = 89
	local txt = Utils.New("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(10, 0), Font = CONFIG.FontHeader,
		Text = options.Text or "Aurora UI", TextSize = 13,
		TextColor3 = Color3.fromRGB(255, 255, 255), TextXAlignment = Enum.TextXAlignment.Left,
		Parent = wm, ZIndex = 91,
	})
	local tg = Utils.Gradient(palette, 15)
	tg.Parent = txt
	Anim.DriftGradient(tg, 0.3, 20)
	local fps = Utils.New("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.new(0, 60, 1, 0), Position = UDim2.new(1, -8, 0, 0),
		AnchorPoint = Vector2.new(1, 0), Font = CONFIG.FontMono, Text = "60 FPS",
		TextSize = 11, TextColor3 = Color3.fromRGB(150, 255, 180),
		TextXAlignment = Enum.TextXAlignment.Right, Parent = wm, ZIndex = 91,
	})
	local frames = 0
	RunService.RenderStepped:Connect(function() frames = frames + 1 end)
	task.spawn(function()
		while wm.Parent do
			task.wait(1)
			fps.Text = frames .. " FPS"
			fps.TextColor3 = frames >= 50 and Color3.fromRGB(150, 255, 180)
				or frames >= 30 and Color3.fromRGB(255, 220, 100)
				or Color3.fromRGB(255, 120, 120)
			frames = 0
		end
	end)
	return { Object = wm, SetText = function(_, t) txt.Text = t end }
end

--================================================================================
--// SECTION 40 — PERFORMANCE TUNING GUIDE
--================================================================================
--[[
	When running Aurora UI in heavy games, use these tips to keep FPS high:

	1. LIMIT GRADIENT DRIFT
	   Each Anim.DriftGradient() uses a RenderStepped connection. If you have
	   50+ animated gradients, consider disabling drift on secondary elements:
	     - Don't call Anim.DriftGradient on every button; keep it for accents.
	     - Set CONFIG.AutoScaleEnabled = false if your layout is fixed.

	2. RECYCLE NOTIFICATIONS
	   If you fire >10 notifications/sec, reuse toast frames instead of
	   creating new ones. The built-in system auto-destroys after Duration.

	3. PAUSE WHEN HIDDEN
	   When win:Toggle() hides the window, consider disconnecting your own
	   RenderStepped loops and reconnecting on show. Aurora's internal loops
	   are cheap but your game logic isn't.

	4. TEXT SIZES
	   Use TextScaled = false (default) — TextScaled causes re-layout cost.

	5. CLIPSDESCENDANTS
	   Enabled on the main window and cards; this overdraws less. Keep it on.

	6. IMAGE LABELS
	   The glow blobs use a single shared radial asset (rbxassetid://5028857084).
	   Roblox caches it, so 50 glows = 1 texture upload. Fine.

	7. WHEN IN DOUBT, PROFILE
	   Use the built-in StatsWidget (tab:AddStatsWidget()) to watch FPS live.
]]

