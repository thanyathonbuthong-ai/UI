--================================================================================
--[[
================================================================================
	AURORA UI — COMPLETE API REFERENCE
================================================================================

--------------------------------------------------------------------------------
1. INSTALLATION
--------------------------------------------------------------------------------
	1. In Roblox Studio, create a ModuleScript inside ReplicatedStorage.
	2. Name it "AuroraUI" and paste this entire file into it.
	3. Create a LocalScript inside StarterPlayerScripts (or StarterGui).
	4. In the LocalScript:
		local Aurora = require(game.ReplicatedStorage:WaitForChild("AuroraUI"))
		Aurora:Demo()   -- or build your own window (see below)

--------------------------------------------------------------------------------
2. CORE API
--------------------------------------------------------------------------------
	Aurora:CreateWindow(options) -> Window
		options:
			Title        (string)   window title, default "Aurora UI"
			Subtitle     (string)   small text under title
			Palette      (number)   1..5 — starting gradient theme, default 1
			ToggleKey    (KeyCode)  key to hide/show the window (optional)
			DisplayOrder (number)   ScreenGui display order, default 100
			ShowBackground (bool)   show full-screen aurora backdrop, default false

	Window methods:
		:AddTab(options) -> Tab
			options: { Name = string, Icon = iconName }
		:SelectTab(name)              switch active tab by name
		:SetPalette(index)            1..5, live-recolors all accents
		:Notify(options)              push a toast notification
			options: { Title, Description, Icon, Duration(sec) }
		:Modal(options)               open centered dialog
			options: { Title, Description, Buttons = {{Text, Primary, Callback}},
			           DismissOnBackdrop, Width, Height }
		:ContextMenu(options)         right-click style popup
			options: { Position = UDim2, Items = {{Text, Callback}} }
		:AddFloatingButton(options)   gold FAB bottom-right
			options: { Text = "+", Callback }
		:Minimize()                   collapse to titlebar only
		:Toggle()                     hide/show window
		:Destroy()                    remove everything

--------------------------------------------------------------------------------
3. TAB / COMPONENT API (all return an object with getter/setter methods)
--------------------------------------------------------------------------------
	-- BUTTONS (the 7 required types)
	Tab:AddPrimaryButton({ Text, Icon?, Callback })     -- 1. full gradient + glow
	Tab:AddOutlineButton({ Text, Callback })            -- 2. gradient border only
	Tab:AddGlassButton({ Text, Callback })              -- 3. translucent glass
	Tab:AddSegmented({ Items = {}, Default, Callback }) -- 4. pill tab selector
	Tab:AddIconButton({}) -> row, then :Add(icon, cb, paletteIdx)  -- 5. circular icons
	Window:AddFloatingButton(...)                       -- 6. gold FAB
	Tab:AddToggle({ Text, Description?, Default, Callback })  -- 7. switch

	-- LAYOUT / TEXT
	Tab:AddSection({ Text })                gradient-bar section header
	Tab:AddCard({ Title, Height }) -> { Content }   glass card, parent custom UI
	Tab:AddLabel({ Text, TextSize?, Color?, Align? })
	Tab:AddDivider()
	Tab:AddAccordion({ Title, BodyHeight }) -> { Body, Toggle }

	-- INPUTS
	Tab:AddSlider({ Text, Min, Max, Default, Rounded, Format, Callback })
	Tab:AddProgressBar({ Text, Default }) -> :SetProgress(0..1)
	Tab:AddDropdown({ Items = {}, Default, Callback }) -> :SetItems({})
	Tab:AddTextbox({ Placeholder, Callback })   (fires on Enter)
	Tab:AddSearchBar({ Placeholder, OnChange })
	Tab:AddKeybind({ Text, Default })
	Tab:AddStepper({ Text, Min, Max, Step, Default, Callback })
	Tab:AddRadioGroup({ Title, Items = {}, Default, Callback })
	Tab:AddColorPicker({ Text, Default }) -> :GetColor()
	Tab:AddRating({ Default }) -> :GetValue()
	Tab:AddBadges({ Items = {} })

	-- WIDGETS
	Tab:AddPaletteSwitcher()              5 swatches to live-change theme
	Tab:AddStatsWidget()                  FPS / Ping / Uptime live card
	Tab:AddClock()                        live clock + date card

--------------------------------------------------------------------------------
4. LIBRARY-LEVEL HELPERS
--------------------------------------------------------------------------------
	Aurora:Demo()                          build the full showcase window
	Aurora:BindHotkey(KeyCode, fn)         global hotkey
	Aurora:UnbindHotkey(KeyCode)
	Aurora:AttachTooltip(guiObject, text)  hover tooltip
	Aurora:AddRipple(button, palette?)     click ripple burst
	Aurora.Sound.Enabled = bool            toggle click sounds
	Aurora.Sound.Volume = 0..1

--------------------------------------------------------------------------------
5. ICON NAMES (built-in set)
--------------------------------------------------------------------------------
	star, home, settings, user, chart, gamepad, shield, palette, bell,
	search, plus, close, minimize, menu, check, lock, globe, heart, zap, cube
	You may also pass any "rbxassetid://..." directly.

--------------------------------------------------------------------------------
6. THE FIVE GRADIENT PALETTES
--------------------------------------------------------------------------------
	1. Aurora  — violet (#8B5CF6) -> blue (#3B82F6)      [default]
	2. Sunset  — pink (#F472B6)   -> amber/gold (#FBBF24)
	3. Mint    — emerald (#34D399)-> sky (#38BDF8)
	4. Royal   — blue (#2563EB)   -> light violet (#C4B5FD)
	5. Magenta — deep pink (#DB2777) -> light violet (#C4B5FD)
	Each palette carries { From, To, Accent, Glow, TextOn }.
	Edit the PALETTES table at the top of this file to add your own.

--------------------------------------------------------------------------------
7. MOBILE SUPPORT
--------------------------------------------------------------------------------
	* Auto-detected via TouchEnabled + viewport width < 600px.
	* Sidebar collapses to a 64px icon-only rail.
	* UIScale auto-fits the window to the screen (clamped 0.6..1.15).
	* Touch drag of titlebar and touch resize both work.
	* Sliders, dropdowns, toggles all respond to touch input.
	* Notifications stack from top-right; safe-area aware via IgnoreGuiInset.
	* To force mobile layout: set CONFIG.MobileBreakpoint higher (e.g. 900).

--------------------------------------------------------------------------------
8. ANIMATION SYSTEM
--------------------------------------------------------------------------------
	* Anim.DriftGradient(gradient, speed, amplitude) — slow rotation/offset drift
	* Anim.DriftFrame(frame, amplitude, speed)       — floating position
	* Anim.PulseGlow(imageLabel, minT, maxT, speed)  — breathing transparency
	* Anim.ApplyHover(frame, glowImage)              — scale-up + glow on hover
	* Anim.PressFeedback(frame)                      — 0.96x squash + spring back
	All connections are cleaned up on Window:Destroy().

--------------------------------------------------------------------------------
9. CUSTOMIZATION CHEATSHEET
--------------------------------------------------------------------------------
	Want rounder corners?  CONFIG.CornerRadius = 28
	Want more opaque glass? CONFIG.GlassTransparency = 0.55
	Want faster hover?     CONFIG.TweenFast = TweenInfo.new(0.12, ...)
	Want bigger hover?     CONFIG.HoverScale = 1.08
	Add a palette:         insert a 6th entry into PALETTES table.
	Add an icon:           add "name = rbxassetid://..." to ICONS table.

--------------------------------------------------------------------------------
10. TROUBLESHOOTING
--------------------------------------------------------------------------------
	Q: Window is tiny / huge on my screen.
	A: Auto-scale computes from viewport. Set CONFIG.AutoScaleEnabled = false
	   and control UIScale.Scale yourself, or adjust MinScale/MaxScale.

	Q: Buttons don't show images / icons are blank.
	A: Some asset ids may be moderated. Replace ICONS entries with your own
	   uploaded 1:1 transparent PNGs. Icons are decorative; text still works.

	Q: I want real backdrop blur.
	A: Roblox does not expose backdrop blur for 2D UI. The glass look here is
	   faked with translucency + layered gradients + highlight + glow, which is
	   the standard technique used by every top Roblox UI library.

	Q: Notifications overlap my other GUI.
	A: Raise options.DisplayOrder when creating the window.

	Q: Performance drops with many windows.
	A: Call :Destroy() on windows you no longer need; Anim.Cleanup() disconnects
	   all RenderStepped loops.

================================================================================
	END OF API REFERENCE
================================================================================
]]

