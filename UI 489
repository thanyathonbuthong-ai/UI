				Callback = function(v) configTable[key].Value = v end })
			controls[key] = d
		end
	end
	tab:AddPrimaryButton({
		Text = "Save Configuration",
		Callback = function()
			local snapshot = {}
			for k, v in pairs(configTable) do snapshot[k] = v.Value end
