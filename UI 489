--- Responsive: re-layout on resize / mobile toggle.
function Window:_SetupResponsive()
	local function reflow()
		local vp = Utils.Viewport()
		local isMobile = Utils.IsMobile() or vp.X < CONFIG.MobileBreakpoint
		self.Mobile = isMobile
		local sidebarW = isMobile and CONFIG.MobileSidebarW or CONFIG.SidebarWidth
		Utils.Tween(self.Sidebar, CONFIG.TweenNormal, { Size = UDim2.new(0, sidebarW, 1, -CONFIG.TitlebarHeight) })
		Utils.Tween(self.Content, CONFIG.TweenNormal, {
			Position = UDim2.new(0, sidebarW, 0, CONFIG.TitlebarHeight),
			Size = UDim2.new(1, -sidebarW, 1, -CONFIG.TitlebarHeight),
		})
		-- hide footer text on tiny screens
		if self.SideFooter then
			self.SideFooter.Visible = not isMobile or vp.X > 420
		end
		-- rescale
		if CONFIG.AutoScaleEnabled then
			Utils.Tween(self.UIScale, CONFIG.TweenNormal, {
				Scale = Utils.ComputeScale(self.Window.AbsoluteSize.X, self.Window.AbsoluteSize.Y),
			})
		end
	end
	UserInputService.WindowFocused:Connect(reflow)
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(reflow)
end

--- Minimize to titlebar only.
function Window:Minimize()
	if self._minimized then
		Utils.Tween(self.Window, CONFIG.TweenSpring, { Size = self._restoreSize or UDim2.fromOffset(CONFIG.WindowWidth, CONFIG.WindowHeight) })
		self.Content.Visible = true
		self.Sidebar.Visible = true
		self._minimized = false
	else
		self._restoreSize = self.Window.Size
		Utils.Tween(self.Window, CONFIG.TweenNormal, { Size = UDim2.new(self._restoreSize.X.Scale, self._restoreSize.X.Offset, 0, CONFIG.TitlebarHeight + 6) })
		self.Content.Visible = false
		self.Sidebar.Visible = false
		self._minimized = true
	end
end

--- Toggle window visibility.
function Window:Toggle()
	self.Open = not self.Open
	Utils.Tween(self.Window, CONFIG.TweenNormal, {
		Size = self.Open and self._restoreSize or UDim2.fromOffset(0, 0),
		BackgroundTransparency = self.Open and CONFIG.GlassTransparency or 1,
	})
	self.Window.Visible = self.Open
end

--- Switch active palette (1-5).
function Window:SetPalette(index)
	local p = PALETTES[index]
	if not p then return end
	self.Palette = p
	self.PaletteIndex = index
	-- re-tint all gradient accents
	for _, comp in ipairs(self.Components) do
		if comp.ReapplyTheme then comp:ReapplyTheme(p) end
	end
	-- window glow
	if self.WindowGlow then
		Utils.Tween(self.WindowGlow.GlowImage, CONFIG.TweenNormal, { ImageColor3 = p.Glow })
	end
end

--- Destroy window completely.
function Window:Destroy()
	Anim.Cleanup()
	if self.ScreenGui then self.ScreenGui:Destroy() end
end

