--- Grid helper: returns a frame with UIGridLayout; add cells into .Content.
function Tab:AddGrid(options)
	options = options or {}
	local cellSize = options.CellSize or Vector2.new(140, 90)
	local cellPadding = options.CellPadding or Vector2.new(10, 10)
	local cols = options.Columns or 2
	local row = Utils.New("Frame", {
		Name = "Grid", BackgroundTransparency = 1,
		Size = UDim2.new(1, -8, 0, options.Height or 200),
		LayoutOrder = #self.Components + 1, Parent = self.Page, ZIndex = 10,
	})
	table.insert(self.Components, row)
	local grid = Utils.New("Frame", {
		Name = "GridContent", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
		Parent = row, ZIndex = 11,
	})
	Utils.New("UIGridLayout", {
		CellSize = UDim2.fromOffset(cellSize.X, cellSize.Y),
		CellPadding = UDim2.fromOffset(cellPadding.X, cellPadding.Y),
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	return { Object = row, Content = grid }
end

--- Make a glass tile (use inside a grid cell).
function Aurora:MakeTile(parent, options)
	options = options or {}
	local palette = PALETTES[options.Palette or 1]
	local tile = Utils.New("Frame", {
		Name = options.Title or "Tile", BackgroundTransparency = 0.75,
		BackgroundColor3 = Color3.fromRGB(28, 23, 50), ClipsDescendants = true,
		Size = UDim2.fromScale(1, 1), Parent = parent, ZIndex = 12,
	}, { Utils.Corner(14), Utils.Stroke(Color3.fromRGB(255,255,255), 1, 0.82) })
	-- gradient top accent
	local accent = Utils.New("Frame", {
		Size = UDim2.new(1, 0, 0, 3), BackgroundColor3 = Color3.fromRGB(255,255,255),
		Parent = tile, ZIndex = 13,
	})
	local ag = Utils.Gradient(palette, 0)
	ag.Parent = accent
	Anim.DriftGradient(ag, 0.25, 20)
	if options.Title then
		Utils.New("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 10),
			Size = UDim2.new(1, -20, 0, 18), Font = CONFIG.FontHeader,
			Text = options.Title, TextColor3 = Color3.fromRGB(240, 238, 255),
			TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = tile, ZIndex = 13,
		})
	end
	if options.Value then
		Utils.New("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 30),
			Size = UDim2.new(1, -20, 0, 26), Font = CONFIG.FontTitle,
			Text = tostring(options.Value), TextColor3 = palette.Accent, TextSize = 22,
			TextXAlignment = Enum.TextXAlignment.Left, Parent = tile, ZIndex = 13,
		})
	end
	if options.Subtitle then
		Utils.New("TextLabel", {
			BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 58),
			Size = UDim2.new(1, -20, 0, 14), Font = CONFIG.FontBody,
			Text = options.Subtitle, TextColor3 = Color3.fromRGB(160, 155, 190),
			TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left, Parent = tile, ZIndex = 13,
		})
	end
	-- hover lift
	local btn = Utils.New("TextButton", {
		BackgroundTransparency = 1, Text = "", Size = UDim2.fromScale(1,1), Parent = tile, ZIndex = 14,
	})
	btn.MouseEnter:Connect(function()
		Utils.Tween(tile, CONFIG.TweenFast, { BackgroundTransparency = 0.6 })
	end)
	btn.MouseLeave:Connect(function()
		Utils.Tween(tile, CONFIG.TweenFast, { BackgroundTransparency = 0.75 })
	end)
	if options.Callback then
		btn.MouseButton1Click:Connect(function() options.Callback() end)
	end
	return tile
end

