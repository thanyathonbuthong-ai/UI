--// 4. TAB BUTTON (segmented control) — long pill, group selection, color shift when active
function Tab:AddSegmented(options)
	options = options or {}
	local items = options.Items or { "Option A", "Option B", "Option C" }
	local row = makeRow(self, 44)
	local palette = self.Window.Palette

	local container = Utils.New("Frame", {
		Name = "Segmented", BackgroundTransparency = 0.85, BackgroundColor3 = Color3.fromRGB(25, 20, 45),
		Size = UDim2.fromScale(1, 1), Parent = row, ZIndex = 10,
	}, { Utils.Corner(CONFIG.PillRadius), Utils.Stroke(Color3.fromRGB(255,255,255), 1, 0.85) })
	Utils.New("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 4),
		SortOrder = Enum.SortOrder.LayoutOrder, Parent = container,
	})
	Utils.New("UIPadding", { PaddingTop = UDim.new(0,4), PaddingBottom = UDim.new(0,4),
		PaddingLeft = UDim.new(0,4), PaddingRight = UDim.new(0,4), Parent = container })

	local segButtons = {}
	local selected = options.Default or 1
	local function selectSeg(idx)
		for i, sb in ipairs(segButtons) do
			local active = i == idx
			Utils.Tween(sb, CONFIG.TweenFast, { BackgroundTransparency = active and 0 or 0.95 })
			Utils.Tween(sb.Label, CONFIG.TweenFast, {
				TextColor3 = active and palette.TextOn or Color3.fromRGB(190, 185, 220),
				Font = active and CONFIG.FontHeader or CONFIG.FontBody,
			})
		end
		selected = idx
		if options.Callback then options.Callback(items[idx], idx) end
	end

	for i, item in ipairs(items) do
		local sb = Utils.New("TextButton", {
			Name = "Seg_" .. i, AutoButtonColor = false, Text = "",
			Size = UDim2.new(1 / #items, -8, 1, 0), LayoutOrder = i,
			BackgroundColor3 = Color3.fromRGB(255,255,255), BackgroundTransparency = 0.95,
			Parent = container, ZIndex = 11,
		}, { Utils.Corner(CONFIG.PillRadius) })
		local sg = Utils.Gradient(palette, 75)
		sg.Parent = sb
		sb.BackgroundTransparency = 0.95
		local lbl = Utils.New("TextLabel", {
			BackgroundTransparency = 1, Size = UDim2.fromScale(1,1), Font = CONFIG.FontBody,
			Text = tostring(item), TextColor3 = Color3.fromRGB(190,185,220), TextSize = 13,
			Parent = sb, ZIndex = 12,
		})
		sb.Label = lbl
		sb.MouseEnter:Connect(function()
			if i ~= selected then Utils.Tween(sb, CONFIG.TweenFast, { BackgroundTransparency = 0.85 }) end
		end)
		sb.MouseLeave:Connect(function()
			if i ~= selected then Utils.Tween(sb, CONFIG.TweenFast, { BackgroundTransparency = 0.95 }) end
		end)
		sb.MouseButton1Click:Connect(function()
			Anim.PressFeedback(sb)
			selectSeg(i)
		end)
		table.insert(segButtons, sb)
	end
	selectSeg(selected)

	return {
		Object = container, Buttons = segButtons,
		GetSelected = function() return items[selected], selected end,
		SetSelected = function(_, idx) selectSeg(idx) end,
	}
end

