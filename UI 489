--- Live player list (auto-refreshes).
function Tab:AddPlayerList()
	local card = self:AddCard({ Title = "Players", Height = 180 })
	local scroll = Utils.New("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1),
		ScrollBarThickness = 2, AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(), Parent = card.Content, ZIndex = 13,
	})
	Utils.New("UIListLayout", { Padding = UDim.new(0, 6), Parent = scroll })
	local function refresh()
		for _, c in ipairs(scroll:GetChildren()) do
			if c:IsA("Frame") then c:Destroy() end
		end
		for _, p in ipairs(Players:GetPlayers()) do
			local row = Utils.New("Frame", {
				BackgroundTransparency = 0.85, BackgroundColor3 = Color3.fromRGB(40, 35, 65),
				Size = UDim2.new(1, 0, 0, 30), Parent = scroll, ZIndex = 14,
			}, { Utils.Corner(8) })
			local av = Utils.New("ImageLabel", {
				BackgroundTransparency = 1, Size = UDim2.fromOffset(22, 22), Position = UDim2.fromOffset(4, 4),
				Image = Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150),
				Parent = row, ZIndex = 15,
			}, { Utils.Corner(11) })
			Utils.New("TextLabel", {
				BackgroundTransparency = 1, Position = UDim2.fromOffset(32, 0), Size = UDim2.new(1, -40, 1, 0),
				Font = CONFIG.FontBody, Text = p.Name, TextColor3 = Color3.fromRGB(215, 210, 240),
				TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = row, ZIndex = 15,
			})
		end
	end
	refresh()
	Players.PlayerAdded:Connect(refresh)
	Players.PlayerRemoving:Connect(refresh)
	return { Object = card.Object, Refresh = refresh }
end

