-- content: string, or { { Text = "...", Accent = true }, { Text = "..." } }
function Library:Notify(content, opts)
	if self.Unloaded then return end
	self:_init()
	opts = opts or {}
	local color = opts.Color or self.Theme.Accent
	local rich = ""
	if type(content) == "string" then
		rich = esc(content)
	else
		for _, seg in ipairs(content) do
			local t = esc(seg.Text)
			if seg.Accent then t = string.format('<font color="#%s">%s</font>', color:ToHex(), t) end
			rich ..= t
		end
	end
	self._count += 1
	local n = new("CanvasGroup", {
		Size = UDim2.new(0, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.XY, BorderSizePixel = 0, GroupTransparency = 1,
		LayoutOrder = self._count, Parent = self._notifyHolder,
	}, {
		new("UICorner", { CornerRadius = UDim.new(0, 5) }),
		new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) }),
	})
	self:_bind(n, "BackgroundColor3", "ElementBackground")
	self:_stroke(n)
	new("Frame", { Size = UDim2.new(0, 2, 1, 0), Position = UDim2.fromOffset(-12, 0), BorderSizePixel = 0, BackgroundColor3 = color, Parent = n })
	local l = new("TextLabel", {
		Size = UDim2.new(0, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.XY, BackgroundTransparency = 1, RichText = true,
		Font = Enum.Font.Inconsolata, TextSize = 15, Text = rich, TextXAlignment = Enum.TextXAlignment.Left, Parent = n,
	})
	self:_bind(l, "TextColor3", "TextColor")
	tween(n, { GroupTransparency = 0 }, TweenInfo.new(0.2))
	task.delay(opts.Lifetime or 5, function()
		if not n.Parent then return end
		tween(n, { GroupTransparency = 1 }, TweenInfo.new(0.25))
		task.delay(0.3, function() n:Destroy() end)
	end)
end

function Library:SetWatermark(text, enabled)
	self:_init()
	if self._wm then self._wm:Destroy() self._wm = nil end
	if enabled == false then return end
	local f = new("Frame", {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 16), Size = UDim2.new(0, 0, 0, 24),
		AutomaticSize = Enum.AutomaticSize.X, BorderSizePixel = 0, ZIndex = 90, Parent = self.Gui,
	}, { new("UICorner", { CornerRadius = UDim.new(0, 5) }), new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }) })
	self:_bind(f, "BackgroundColor3", "ElementBackground")
	self:_stroke(f)
	local l = new("TextLabel", {
		Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, FontFace = FONT,
		TextSize = 12, Text = text, Parent = f,
	})
	self:_bind(l, "TextColor3", "TextColor")
	local frames, last = 0, os.clock()
	self:_conn(RunService.Heartbeat, function()
		frames += 1
		if os.clock() - last >= 0.5 then
			l.Text = string.format("%s  |  %d fps", text, math.round(frames / (os.clock() - last)))
			frames, last = 0, os.clock()
		end
	end)
	self._wm = f
end

--------------------------------------------------------------------------
--  Config (flags) save / load
--------------------------------------------------------------------------
local function serialize(el)
	local v = el.Value
	if el.Type == "ColorPicker" then return "#" .. v:ToHex() end
	if el.Type == "Keybind" then return { Key = v.Key and v.Key.Name, KeyType = v.Key and tostring(v.Key.EnumType), Mode = v.Mode } end
	return v
end
local function deserialize(el, v)
	if el.Type == "ColorPicker" then return Color3.fromHex(v) end
	if el.Type == "Keybind" then
		local key
		if v.Key then pcall(function() key = Enum[v.KeyType:gsub("^Enum%.", "")][v.Key] end) end
		return { Key = key, Mode = v.Mode }
	end
	return v
end

function Library:ExportConfig()
	local out = {}
	for flag, el in pairs(self.Elements) do out[flag] = serialize(el) end
	return HttpService:JSONEncode(out)
end

function Library:ImportConfig(json)
	local ok, data = pcall(HttpService.JSONDecode, HttpService, json)
	if not ok then return false end
	for flag, v in pairs(data) do
		local el = self.Elements[flag]
		if el then pcall(function() el:Set(deserialize(el, v)) end) end
	end
	return true
end

function Library:SaveConfig(name)
	if not writefile then return false end
	pcall(function() if not isfolder("KiciaUI") then makefolder("KiciaUI") end end)
	writefile("KiciaUI/" .. name .. ".json", self:ExportConfig())
	return true
end

function Library:LoadConfig(name)
	if not (isfile and readfile) or not isfile("KiciaUI/" .. name .. ".json") then return false end
	return self:ImportConfig(readfile("KiciaUI/" .. name .. ".json"))
end

function Library:ListConfigs()
	local out = {}
	if listfiles and isfolder and isfolder("KiciaUI") then
		for _, p in ipairs(listfiles("KiciaUI")) do
			local n = p:match("([^/\\]+)%.json$")
			if n then table.insert(out, n) end
		end
	end
	return out
end

--------------------------------------------------------------------------
--  Unload
--------------------------------------------------------------------------
function Library:Unload()
	if self.Unloaded then return end
	self.Unloaded = true
	for _, c in ipairs(self._conns) do pcall(function() c:Disconnect() end) end
	if self.Gui then self.Gui:Destroy() end
	self.Flags, self.Elements = {}, {}
	pcall(function() if getgenv().KiciaUILib == self then getgenv().KiciaUILib = nil end end)
end

pcall(function()
	local g = getgenv()
	if g.KiciaUILib and g.KiciaUILib.Unload then pcall(g.KiciaUILib.Unload, g.KiciaUILib) end
	g.KiciaUILib = Library
end)

return Library
