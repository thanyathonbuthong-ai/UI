function Tab:Select() self._window:SelectTab(self) end

local Window = {}
Window.__index = Window

function Window:AddTab(opts)
	opts = type(opts) == "string" and { Label = opts } or opts or {}
	local lib = self._lib

	local btn = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 30), Text = "", AutoButtonColor = false, BorderSizePixel = 0,
		BackgroundTransparency = 1, LayoutOrder = #self.Tabs + 1, Parent = self._tabList,
	}, { new("UICorner", { CornerRadius = UDim.new(0, 5) }) })
	lib:_bind(btn, "BackgroundColor3", "TabButtonSelected")
	local indicator = new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(2, 0), BorderSizePixel = 0, Parent = btn,
	}, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
	lib:_bind(indicator, "BackgroundColor3", "Accent")
	local textX = 12
	if opts.Icon then
		new("ImageLabel", {
			Size = UDim2.fromOffset(16, 16), Position = UDim2.new(0, 10, 0.5, -8), BackgroundTransparency = 1,
			Image = opts.Icon, Parent = btn,
		})
		textX = 32
	end
	local label = lib:_label(btn, opts.Label or "Tab", { Size = UDim2.new(1, -textX, 1, 0), Position = UDim2.fromOffset(textX, 0), Color = "Unselected" })

	local page = new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false, Parent = self._pages,
	})
	lib:_bind(page, "ScrollBarImageColor3", "Accent")
	new("UIPadding", { PaddingRight = UDim.new(0, 8), Parent = page })
	local holder = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = page,
	}, { new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10) }) })
	local function column(order)
		return new("Frame", {
			Size = UDim2.new(0.5, -5, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = order, Parent = holder,
		}, { new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }) })
	end

	local tab = setmetatable({
		_lib = lib, _window = self, _button = btn, _label = label, _indicator = indicator, Page = page,
		Left = column(1), Right = column(2), _autoSide = 0, _secOrder = 0,
	}, Tab)
	table.insert(self.Tabs, tab)
	btn.MouseButton1Click:Connect(function() self:SelectTab(tab) end)
	btn.MouseEnter:Connect(function() if self.Current ~= tab then tween(label, { TextColor3 = lib.Theme.TextColor }) end end)
	btn.MouseLeave:Connect(function() if self.Current ~= tab then tween(label, { TextColor3 = lib.Theme.Unselected }) end end)
	if not self.Current then self:SelectTab(tab) end
	return tab
end

function Window:SelectTab(tab)
	local lib = self._lib
	lib:_closePopup()
	for _, t in ipairs(self.Tabs) do
		local on = t == tab
		t.Page.Visible = on
		tween(t._button, { BackgroundTransparency = on and 0.55 or 1 })
		tween(t._label, { TextColor3 = on and lib.Theme.Accent or lib.Theme.Unselected })
		tween(t._indicator, { Size = UDim2.fromOffset(2, on and 14 or 0) })
	end
	self.Current = tab
end

function Window:SetVisible(v)
	self.Visible = v
	self._lib:_closePopup()
	self.Frame.Visible = v
end
function Window:Toggle() self:SetVisible(not self.Visible) end
function Window:SetTitle(t) self._title.Text = t end

function Library:CreateWindow(opts)
	opts = opts or {}
	self:_init()
	local lib = self
	local size = opts.Size or UDim2.fromOffset(720, 460)

	local frame = new("Frame", {
		Name = "Window", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = size,
		BorderSizePixel = 0, ClipsDescendants = true, Parent = self.Gui,
	}, { new("UICorner", { CornerRadius = UDim.new(0, 8) }) })
	new("UISizeConstraint", { MinSize = Vector2.new(560, 340), Parent = frame })
	self:_bind(frame, "BackgroundColor3", "Background")
	self:_stroke(frame)

	-- left rail
	local rail = new("Frame", { Size = UDim2.new(0, 156, 1, 0), BorderSizePixel = 0, Parent = frame })
	self:_bind(rail, "BackgroundColor3", "ElementBackground")
	local railGrad = new("UIGradient", { Rotation = 90, Parent = rail })
	self:_bindGradient(railGrad, "GradientTop", "GradientDeep")
	local divider = new("Frame", { Position = UDim2.new(1, -1, 0, 0), Size = UDim2.new(0, 1, 1, 0), BorderSizePixel = 0, Parent = rail })
	self:_bind(divider, "BackgroundColor3", "Outline")

	local titleBar = new("Frame", { Size = UDim2.new(1, 0, 0, 52), BackgroundTransparency = 1, Parent = rail })
	local titleX = 14
	if opts.Logo then
		new("ImageLabel", { Position = UDim2.fromOffset(12, 12), Size = UDim2.fromOffset(28, 28), BackgroundTransparency = 1, Image = opts.Logo, Parent = titleBar })
		titleX = 48
	end
	local title = self:_label(titleBar, opts.Title or "Kicia", {
		Position = UDim2.fromOffset(titleX, 0), Size = UDim2.new(1, -titleX - 8, 1, 0), Color = "Accent", Bold = true, TextSize = 16,
	})

	local tabList = new("Frame", {
		Position = UDim2.fromOffset(0, 56), Size = UDim2.new(1, 0, 1, -84), BackgroundTransparency = 1, Parent = rail,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }),
		new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 12) }),
	})
	self:_label(rail, opts.Footer or "", {
		Position = UDim2.new(0, 14, 1, -26), Size = UDim2.new(1, -28, 0, 20), Color = "Unselected", TextSize = 11,
	})

	local pages = new("Frame", {
		Position = UDim2.fromOffset(168, 12), Size = UDim2.new(1, -180, 1, -24), BackgroundTransparency = 1, Parent = frame,
	})

	local win = setmetatable({
		_lib = self, _tabList = tabList, _pages = pages, _title = title, Frame = frame, Tabs = {}, Visible = true,
		ToggleKey = opts.ToggleKey or Enum.KeyCode.RightShift,
	}, Window)

	-- drag by the rail header
	local dragOffset
	titleBar.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragOffset = mouse() - frame.AbsolutePosition - frame.AbsoluteSize * frame.AnchorPoint
		end
	end)
	self:_conn(UIS.InputChanged, function(i)
		if dragOffset and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local vp = workspace.CurrentCamera.ViewportSize
			local m = mouse() - dragOffset
			frame.Position = UDim2.fromOffset(
				math.clamp(m.X, 0, vp.X - frame.AbsoluteSize.X) + frame.AbsoluteSize.X * frame.AnchorPoint.X,
				math.clamp(m.Y, 0, vp.Y - frame.AbsoluteSize.Y) + frame.AbsoluteSize.Y * frame.AnchorPoint.Y
			)
		end
	end)
	self:_conn(UIS.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragOffset = nil end
	end)

	-- menu toggle key
	self:_conn(UIS.InputBegan, function(i, gp)
		if gp or UIS:GetFocusedTextBox() then return end
		if win.ToggleKey and i.KeyCode == win.ToggleKey then win:Toggle() end
	end)

	self.Window = win
	return win
end

