local function getViewport()
	local ok, cam = pcall(function() return workspace.CurrentCamera end)
	if ok and cam then
		local ok2, vp = pcall(function() return cam.ViewportSize end)
		if ok2 and vp then return vp end
	end
	return Vector2.new(1920, 1080)
end


function Nebula:CreateWindow(cfg)
	cfg = cfg or {}
	local themeName = (cfg.Theme and THEMES[cfg.Theme]) and cfg.Theme or "Cyberpunk"

	loadTheme(THEMES[themeName])

	local self = setmetatable({}, Nebula)
	self._cfg = cfg
	self._title = cfg.Title or "Nebula"
	self._subtitle = cfg.Subtitle or ""
	self._folder = cfg.Folder or "NebulaUI"
	self._toggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift
	self._notifStyle = cfg.NotifStyle or "stripe"
	self._tabs = {}
	self._activeTab = nil
	self._flags = {}
	self._config = {}
	self._keybinds = {}
	self._uiOpen = true
	self._collapsed = false
	self._compact = false
	self._unloaded = false
	self._connections = {}
	self._notifCount = 0
	self._themeIndex = (function()
		for i, n in ipairs(THEME_ORDER) do if n == themeName then return i end end
		return 1
	end)()

	-- โฟลเดอร์เก็บ config
	pcall(function()
		if not isfolder(self._folder) then makefolder(self._folder) end
		if not isfolder(self._folder .. "/configs") then makefolder(self._folder .. "/configs") end
	end)
	self._configPath = self._folder .. "/configs/" .. tostring(game.GameId) .. ".json"
	self._togglePath = self._folder .. "/toggle.json"

	-- ===== Root ScreenGui =====
	local parent = (gethui and gethui()) or CoreGui
	local old = parent:FindFirstChild("NebulaUI")
	if old then Debris:AddItem(old, 0) end
	local gui = make("ScreenGui", {
		Name = "NebulaUI", ResetOnSpawn = false, IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = parent,
	})
	if syn and syn.protect_gui then pcall(function() syn.protect_gui(gui) end) end
	self._gui = gui

	-- ===== UIScale (auto scale บนมือถือ) =====
	local function computeScale()
		if not IS_MOBILE then return 1 end
		local vp = getViewport()
		local s = math.min((vp.X * 0.92) / WINDOW_W, (vp.Y * 0.92) / WINDOW_H, 1.3)
		return math.clamp(s, 0.55, 1.3)
	end
	local uiScale = make("UIScale", { Scale = computeScale() }, gui)
	self._uiScale = uiScale
	local vpConn
	pcall(function()
		vpConn = workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			task.defer(function() uiScale.Scale = computeScale() end)
		end)
	end)
	self._connections[#self._connections+1] = vpConn

	-- ===== Container (หน้าต่างหลัก) =====
	local container = make("Frame", {
		Name = "Window",
		BackgroundColor3 = "bg",
		BackgroundTransparency = 0.08,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0, WINDOW_W, 0, WINDOW_H),
		BorderSizePixel = 0,
		ClipsDescendants = false,
		Active = true,
		Parent = gui,
	})
	round(container, 14)
	self._container = container

	-- Shadow
	local shadow = make("ImageLabel", {
		Size = UDim2.new(1, 60, 1, 60), Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
		Image = Images.SHADOW, ImageColor3 = Color3.fromRGB(0, 0, 0), ImageTransparency = 0.45,
		ScaleType = Enum.ScaleType.Slice, SliceCenter = Rect.new(40, 40, 260, 260),
		ZIndex = 0, Parent = container,
	})

	-- Glow decor 2 มุม (จาก Ophyn)
	glowDecor(container, 320, 320, 0, 0, 0.82, 45)
	glowDecor(container, 280, 280, WINDOW_W, WINDOW_H, 0.86, -135)

	-- ===== Animated comet border (กรอบสีไล่หมุน) =====
	local borderFrame = make("Frame", {
		Size = UDim2.new(1, 4, 1, 4), Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
		ZIndex = 1, Parent = container,
	})
	round(borderFrame, 16)
	local borderStroke = make("UIStroke", {
		Thickness = 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Transparency = 0.3, Color = "accent",
	}, borderFrame)
	local comet = cometGradient(borderStroke)
	-- หมุน comet gradient ตลอดเวลา
	task.spawn(function()
		local rot = 0
		while self and not self._unloaded and comet.Parent do
			rot = (rot + 0.6) % 360
			comet.Rotation = rot
			task.wait(0.03)
		end
	end)

	-- Inner content clip (ตัด glow decor ไม่ให้ล้นกรอบ)
	local clip = make("Frame", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
		ClipsDescendants = true, ZIndex = 2, Parent = container,
	})
	round(clip, 14)
	self._clip = clip

	-- ===== Topbar =====
	local topbar = make("Frame", {
		Size = UDim2.new(1, 0, 0, TOPBAR_H), BackgroundTransparency = 1,
		ZIndex = 5, Parent = clip,
	})
	self._topbar = topbar
	local topDivider = make("Frame", {
		Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1),
		BackgroundColor3 = "stroke", BorderSizePixel = 0, ZIndex = 6, Parent = topbar,
	})

	-- Logo + Title
	local logo = make("ImageLabel", {
		Size = UDim2.new(0, 24, 0, 24), Position = UDim2.new(0, 14, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5), BackgroundTransparency = 1,
		Image = cfg.Logo or Images.LOGO, ImageColor3 = "accent", ScaleType = Enum.ScaleType.Fit,
		ZIndex = 7, Parent = topbar,
	})
	local titleLbl = make("TextLabel", {
		Position = UDim2.new(0, 46, 0, 0), Size = UDim2.new(0, 200, 0, TOPBAR_H),
		BackgroundTransparency = 1, Text = self._title, TextSize = 16,
		TextColor3 = "text", FontFace = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 7, Parent = topbar,
	})
	if self._subtitle ~= "" then
		local sub = make("TextLabel", {
			Position = UDim2.new(0, 46, 0, 22), Size = UDim2.new(0, 200, 0, 16),
			BackgroundTransparency = 1, Text = self._subtitle, TextSize = 11,
			TextColor3 = "muted", FontFace = FONT, TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 7, Parent = topbar,
		})
		titleLbl.Size = UDim2.new(0, 200, 0, 24)
		titleLbl.Position = UDim2.new(0, 46, 0, 4)
	end

	-- ปุ่มบน topbar (theme cycle / minimize / close)
	local function topBtn(name, rightOff, hoverRole)
		local b = make("TextButton", {
			Name = name, BackgroundColor3 = "btn2", BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -rightOff, 0.5, 0),
			Size = UDim2.new(0, 28, 0, 28), Text = "", AutoButtonColor = false,
			BorderSizePixel = 0, ZIndex = 8, Parent = topbar,
		})
		round(b, 8)
		b.MouseEnter:Connect(function() tween(b, 0.2, { BackgroundTransparency = 0 }) end)
		b.MouseLeave:Connect(function() tween(b, 0.2, { BackgroundTransparency = 1 }) end)
		return b
	end
	local closeBtn = topBtn("_close", 12)
	local minBtn = topBtn("_min", 46)
	local themeBtn = topBtn("_theme", 80)

	-- close icon (X)
	for _, rot in ipairs({45, -45}) do
		make("Frame", {
			BackgroundColor3 = Color3.fromRGB(255,255,255), AnchorPoint = Vector2.new(0.5,0.5),
			Position = UDim2.new(0.5,0,0.5,0), Size = UDim2.new(0,13,0,2), Rotation = rot,
			BorderSizePixel = 0, ZIndex = 9, Parent = closeBtn,
		})
	end
	-- minimize icon (minus) / expand (square)
	local minLine = make("Frame", {
		BackgroundColor3 = Color3.fromRGB(255,255,255), AnchorPoint = Vector2.new(0.5,0.5),
		Position = UDim2.new(0.5,0,0.5,0), Size = UDim2.new(0,13,0,2),
		BorderSizePixel = 0, ZIndex = 9, Parent = minBtn,
	})
	pill(minLine)
	local expandBox = make("Frame", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5,0.5),
		Position = UDim2.new(0.5,0,0.5,0), Size = UDim2.new(0,11,0,11),
		BorderSizePixel = 0, Visible = false, ZIndex = 9, Parent = minBtn,
	})
	round(expandBox, 3)
	make("UIStroke", { Color = Color3.fromRGB(255,255,255), Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, expandBox)
	-- theme button (วงกลมสีไล่)
	local themeDot = make("Frame", {
		AnchorPoint = Vector2.new(0.5,0.5), Position = UDim2.new(0.5,0,0.5,0),
		Size = UDim2.new(0,14,0,14), BackgroundColor3 = "accent", BorderSizePixel = 0, ZIndex = 9, Parent = themeBtn,
	})
	pill(themeDot)
	local themeGrad = make("UIGradient", { Rotation = 90, Color = ColorSequence.new(C.glowFrom, C.glowTo) }, themeDot)
	gradients[#gradients+1] = themeGrad

	-- ===== Sidebar =====
	local sidebar = make("Frame", {
		Position = UDim2.new(0, 0, 0, TOPBAR_H), Size = UDim2.new(0, SIDEBAR_W, 1, -TOPBAR_H),
		BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 4, Parent = clip,
	})
	self._sidebar = sidebar
	local sideDivider = make("Frame", {
		Position = UDim2.new(1, -1, 0, 0), Size = UDim2.new(0, 1, 1, 0),
		BackgroundColor3 = "stroke", BorderSizePixel = 0, ZIndex = 5, Parent = sidebar,
	})

	-- Glowing pin indicator (จาก Kittylol แต่เพิ่ม glow)
	local pin = make("Frame", {
		BackgroundColor3 = "accent", Position = UDim2.new(0, 6, 0, 10),
		Size = UDim2.new(0, 4, 0, 20), BorderSizePixel = 0, ZIndex = 50, Parent = sidebar,
	})
	pill(pin)
	local pinGlow = make("ImageLabel", {
		Size = UDim2.new(0, 24, 0, 36), Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
		Image = Images.GLOW, ImageColor3 = "accent", ImageTransparency = 0.5,
		ZIndex = 49, Parent = pin,
	})
	self._pin = pin

	local tabsScroll = make("Frame", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
		BorderSizePixel = 0, ZIndex = 5, Parent = sidebar,
		ClipsDescendants = true,
	})
	padding(tabsScroll, 8, 8, 8, 8)
	listLayout(tabsScroll, 6)
	self._tabsScroll = tabsScroll

	-- ===== Main content area =====
	local main = make("Frame", {
		Position = UDim2.new(0, SIDEBAR_W, 0, TOPBAR_H),
		Size = UDim2.new(1, -SIDEBAR_W, 1, -TOPBAR_H),
		BackgroundTransparency = 1, ZIndex = 4, Parent = clip,
	})
	self._main = main
	local contentHolder = make("Frame", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, ClipsDescendants = true, Parent = main,
	})
	self._contentHolder = contentHolder

	-- ===== Draggable window (ลากจาก topbar) =====
	local dragging, dragStart, startPos = false, nil, nil
	local function clampWindow(pos)
		local vp = getViewport()
		local s = uiScale.Scale
		local w, h = WINDOW_W * s, (self._collapsed and TOPBAR_H or WINDOW_H) * s
		return Vector2.new(
			math.clamp(pos.X, w/2, vp.X - w/2),
			math.clamp(pos.Y, h/2, vp.Y - h/2)
		)
	end
	topbar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = container.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local delta = input.Position - dragStart
		local newPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		local clamped = clampWindow(Vector2.new(newPos.X.Offset, newPos.Y.Offset))
		container.Position = UDim2.new(0.5, clamped.X - getViewport().X/2, 0.5, clamped.Y - getViewport().Y/2)
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	-- ===== Topbar button actions =====
	closeBtn.MouseButton1Click:Connect(function() self:Unload() end)
	minBtn.MouseButton1Click:Connect(function()
		self._collapsed = not self._collapsed
		minLine.Visible = not self._collapsed
		expandBox.Visible = self._collapsed
		local targetH = self._collapsed and TOPBAR_H or WINDOW_H
		tween(container, 0.45, { Size = UDim2.new(0, WINDOW_W, 0, targetH) }, Enum.EasingStyle.Quint)
		clip.Visible = not self._collapsed
		if self._collapsed then task.delay(0.45, function() if self._collapsed then clip.Visible = false end end) end
	end)
	themeBtn.MouseButton1Click:Connect(function()
		self._themeIndex = self._themeIndex % #THEME_ORDER + 1
		local name = THEME_ORDER[self._themeIndex]
		applyTheme(name, 0.6)
		self:Notify({ Title = "Theme", Content = name, Type = "info", Duration = 2 })
	end)

	-- ===== Intro animation =====
	local fadeItems = prepFade(container)
	doFade(fadeItems, 0, 0)
	container.Size = UDim2.new(0, WINDOW_W * 0.85, 0, WINDOW_H * 0.85)
	tween(container, 0.55, { Size = UDim2.new(0, WINDOW_W, 0, WINDOW_H) }, Enum.EasingStyle.Quint)
	task.delay(0.05, function() doFade(fadeItems, 1, 0.4) end)

	-- ===== Toggle key (เปิด/ปิด UI) =====
	local keyConn = UserInputService.InputBegan:Connect(function(input, gpe)
		if gpe then return end
		if input.KeyCode == self._toggleKey then
			self._uiOpen = not self._uiOpen
			self:SetVisible(self._uiOpen)
		end
	end)
	self._connections[#self._connections+1] = keyConn

	-- โหลด config
	self:_loadConfig()

	-- สร้าง bubble toggle + notification system
	self:_createBubbleToggle()
	self:_createNotificationSystem()

	return self
end

--====================================================================
--  TABS + SECTIONS + COMPONENTS
--====================================================================
function Nebula:AddTab(name)
	local win = self
	local tab = { _name = name, _sections = {}, _order = 0 }

	-- ปุ่ม tab ใน sidebar
	local btn = make("TextButton", {
		Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = "btn2", BackgroundTransparency = 1,
		Text = "", AutoButtonColor = false, BorderSizePixel = 0,
		LayoutOrder = #win._tabs + 1, ZIndex = 6, Parent = win._tabsScroll,
	})
	round(btn, 8)
	if not btn.Parent then warn("[Nebula UI] tab button parent is nil: " .. tostring(name)) end
	local lbl = make("TextLabel", {
		Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -16, 1, 0),
		BackgroundTransparency = 1, Text = name, TextSize = 13,
		TextColor3 = "muted", FontFace = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 7, Parent = btn,
	})
	btn.MouseEnter:Connect(function()
		if win._activeTab ~= tab then tween(btn, 0.2, { BackgroundTransparency = 0.6 }) end
	end)
	btn.MouseLeave:Connect(function()
		if win._activeTab ~= tab then tween(btn, 0.2, { BackgroundTransparency = 1 }) end
	end)

	-- content page ของ tab นี้
	local page = make("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, CanvasSize = UDim2.new(0,0,0,800),
		AutomaticCanvasSize = Enum.AutomaticCanvasSize.None, BorderSizePixel = 0, ScrollBarThickness = 3,
		ScrollBarImageColor3 = "accent", ScrollBarImageTransparency = 0.6,
		Visible = false, Parent = win._contentHolder,
	})
	padding(page, 14, 14, 14, 14)
	listLayout(page, 10)
	-- อัปเดต CanvasSize เอง (ไม่พึ่ง AutomaticCanvasSize เพื่อความเข้ากันได้กับ executor ทุกตัว)
	do
		local lay = page:FindFirstChildOfClass("UIListLayout")
		if lay then
			local function upd()
				pcall(function() page.CanvasSize = UDim2.new(0, 0, 0, lay.AbsoluteContentSize.Y + 28) end)
			end
			upd()
			pcall(function() lay:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(upd) end)
		end
	end
	tab._page = page
	tab._btn = btn
	tab._lbl = lbl

	btn.MouseButton1Click:Connect(function() win:SelectTab(tab) end)

	win._tabs[#win._tabs + 1] = tab
	if not win._activeTab then win:SelectTab(tab) end

	-- ===== Component builders (ผูกกับ tab นี้) =====
	function tab:AddSection(title)
		local sec = make("Frame", {
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1, LayoutOrder = tab._order, Parent = page,
		})
		tab._order = tab._order + 1
		local secLbl = make("TextLabel", {
			Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Text = string.upper(title),
			TextSize = 11, TextColor3 = "accent", FontFace = FONT_BOLD,
			TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 6, Parent = sec,
		})
		local line = make("Frame", {
			Position = UDim2.new(0, 0, 0, 22), Size = UDim2.new(1, 0, 0, 1),
			BackgroundColor3 = "stroke", BorderSizePixel = 0, ZIndex = 6, Parent = sec,
		})
		local body = make("Frame", {
			Position = UDim2.new(0, 0, 0, 28), Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = sec,
		})
		listLayout(body, 8)
		local comp = { _order = 0, _body = body }

		local function row(height)
			local r = make("Frame", {
				Size = UDim2.new(1, 0, 0, height or 34), BackgroundColor3 = "card",
				BackgroundTransparency = 0.3, BorderSizePixel = 0,
				LayoutOrder = comp._order, ZIndex = 6, Parent = body,
			})
			comp._order = comp._order + 1
			round(r, 8, "stroke")
			return r
		end

		function comp:AddButton(o)
			o = o or {}
			local r = row(36)
			local t = make("TextLabel", {
				Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -24, 1, 0),
				BackgroundTransparency = 1, Text = o.Title or "Button", TextSize = 13,
				TextColor3 = "text", FontFace = FONT, TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 7, Parent = r,
			})
			local b = make("TextButton", {
				Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "",
				AutoButtonColor = false, ZIndex = 8, Parent = r,
			})
			b.MouseEnter:Connect(function() tween(r, 0.2, { BackgroundTransparency = 0 }) end)
			b.MouseLeave:Connect(function() tween(r, 0.2, { BackgroundTransparency = 0.3 }) end)
			b.MouseButton1Click:Connect(function()
				tween(r, 0.1, { BackgroundColor3 = C.accent }, Enum.EasingStyle.Quad)
				task.delay(0.1, function() tween(r, 0.3, { BackgroundColor3 = C.card }) end)
				if o.Callback then pcall(o.Callback) end
			end)
			return r
		end

		function comp:AddToggle(o)
			o = o or {}
			local r = row(36)
			local t = make("TextLabel", {
				Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -70, 1, 0),
				BackgroundTransparency = 1, Text = o.Title or "Toggle", TextSize = 13,
				TextColor3 = "text", FontFace = FONT, TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 7, Parent = r,
			})
			-- switch pill
			local sw = make("Frame", {
				AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
				Size = UDim2.new(0, 38, 0, 20), BackgroundColor3 = "btn2",
				BorderSizePixel = 0, ZIndex = 8, Parent = r,
			})
			pill(sw)
			local knob = make("Frame", {
				AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 2, 0.5, 0),
				Size = UDim2.new(0, 16, 0, 16), BackgroundColor3 = Color3.fromRGB(255,255,255),
				BorderSizePixel = 0, ZIndex = 9, Parent = sw,
			})
			pill(knob)
			local knobGlow = make("ImageLabel", {
				Size = UDim2.new(0, 28, 0, 28), Position = UDim2.new(0.5,0,0.5,0),
				AnchorPoint = Vector2.new(0.5,0.5), BackgroundTransparency = 1,
				Image = Images.GLOW, ImageColor3 = "accent", ImageTransparency = 1,
				ZIndex = 8, Parent = knob,
			})
			local state = o.Default == true
			if o.Flag and win._flags[o.Flag] ~= nil then state = win._flags[o.Flag] end
			local function apply(instant)
				local time = instant and 0 or 0.25
				if state then
					tween(sw, time, { BackgroundColor3 = C.accent })
					tween(knob, time, { Position = UDim2.new(1, -18, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5) }, Enum.EasingStyle.Back)
					if not instant then tween(knobGlow, 0.3, { ImageTransparency = 0.4 }) end
				else
					tween(sw, time, { BackgroundColor3 = C.btn2 })
					tween(knob, time, { Position = UDim2.new(0, 2, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5) }, Enum.EasingStyle.Back)
					if not instant then tween(knobGlow, 0.3, { ImageTransparency = 1 }) end
				end
			end
			apply(true)
			local b = make("TextButton", { Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1, Text = "", ZIndex = 10, Parent = r })
			b.MouseButton1Click:Connect(function()
				state = not state
				apply()
				if o.Flag then win._flags[o.Flag] = state; win:_saveConfig() end
				if o.Callback then pcall(o.Callback, state) end
			end)
			local api = {
				Set = function(_, v) state = v; apply() if o.Callback then pcall(o.Callback, state) end end,
				Get = function() return state end,
			}
			return api
		end

		function comp:AddSlider(o)
			o = o or {}
			local r = row(46)
			local minV, maxV = o.Min or 0, o.Max or 100
			local val = o.Default or minV
			if o.Flag and win._flags[o.Flag] ~= nil then val = win._flags[o.Flag] end
			local t = make("TextLabel", {
				Position = UDim2.new(0, 12, 0, 4), Size = UDim2.new(1, -70, 0, 18),
				BackgroundTransparency = 1, Text = o.Title or "Slider", TextSize = 13,
				TextColor3 = "text", FontFace = FONT, TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 7, Parent = r,
			})
			local valLbl = make("TextLabel", {
				AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 4),
				Size = UDim2.new(0, 50, 0, 18), BackgroundTransparency = 1, Text = tostring(math.floor(val)),
				TextSize = 13, TextColor3 = "accent", FontFace = FONT_BOLD,
				TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 7, Parent = r,
			})
			local track = make("Frame", {
				Position = UDim2.new(0, 12, 1, -12), Size = UDim2.new(1, -24, 0, 4),
				BackgroundColor3 = "btn2", BorderSizePixel = 0, ZIndex = 7, Parent = r,
			})
			pill(track)
			local fill = make("Frame", {
				Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = "accent", BorderSizePixel = 0, ZIndex = 8, Parent = track,
			})
			pill(fill)
