-- ===== Color binding system (สำหรับเปลี่ยนธีมด้วย tween) =====
local C = {}                       -- สีปัจจุบัน (resolve จากชื่อ role)
local bindings = {}                -- {inst, prop, roleName}
local gradients = {}               -- UIGradient ที่ใช้ glowFrom→glowTo
local COLOR_PROPS = { BackgroundColor3=true, TextColor3=true, ImageColor3=true, Color=true, PlaceholderColor3=true, ScrollBarImageColor3=true }

local function loadTheme(theme)
	if type(theme) ~= "table" then return end

	for k, v in pairs(theme) do C[k] = v end
	if not C.accent2 then C.accent2 = C.accent end
end

local function make(class, props, parent)
	local inst = Instance.new(class)
	-- เซ็ต Parent ก่อน เพื่อให้แน่ใจว่า instance จะแสดงผลแม้ property อื่นจะผิดพลาด
	if props.Parent ~= nil then
		inst.Parent = props.Parent
	elseif parent ~= nil then
		inst.Parent = parent
	end
	for k, v in pairs(props) do
		if k == "Parent" then
			-- ข้าม เพราะเซ็ตไปแล้วข้างบน
		else
			local ok, err = pcall(function()
				if type(v) == "string" and COLOR_PROPS[k] then
					bindings[#bindings + 1] = { inst, k, v }
					inst[k] = C[v]
				else
					inst[k] = v
				end
			end)
			if not ok then
				warn("[Nebula UI] ไม่สามารถเซ็ต property '" .. tostring(k) .. "' บน " .. class .. ": " .. tostring(err))
			end
		end
	end
	return inst
end

local function setRole(inst, prop, role)
	for _, b in ipairs(bindings) do
		if b[1] == inst and b[2] == prop then b[3] = role; inst[prop] = C[role]; return end
	end
	bindings[#bindings + 1] = { inst, prop, role }
	inst[prop] = C[role]
end

local function tween(inst, time, props, style, dir)
	local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function applyTheme(name, time)
	local theme = THEMES[name]
	if not theme then return end
	local oldFrom, oldTo = C.glowFrom, C.glowTo
	loadTheme(theme)
	time = time or 0.6
	local style, dir = Enum.EasingStyle.Sine, Enum.EasingDirection.InOut
	for i = #bindings, 1, -1 do
		local b = bindings[i]
		if b[1].Parent == nil then table.remove(bindings, i)
		else tween(b[1], time, { [b[2]] = C[b[3]] }, style, dir) end
	end
	local newFrom, newTo = C.glowFrom, C.glowTo
	local driver = Instance.new("NumberValue")
	local conn = driver.Changed:Connect(function(a)
		local seq = ColorSequence.new(oldFrom:Lerp(newFrom, a), oldTo:Lerp(newTo, a))
		for _, g in ipairs(gradients) do if g.Parent then g.Color = seq end end
	end)
	local t = tween(driver, time, { Value = 1 }, style, dir)
	t.Completed:Connect(function()
		conn:Disconnect(); driver:Destroy()
		for _, g in ipairs(gradients) do if g.Parent then g.Color = ColorSequence.new(newFrom, newTo) end end
	end)
end

local function contrastOn(color)
	local lum = 0.299*color.R + 0.587*color.G + 0.114*color.B
	return lum > 0.55 and DARK or WHITE
end

-- ===== Helpers =====
local function round(inst, radius, strokeRole)
	make("UICorner", { CornerRadius = UDim.new(0, radius) }, inst)
	if strokeRole then
		make("UIStroke", { Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Color = strokeRole }, inst)
	end
end
local function pill(inst) make("UICorner", { CornerRadius = UDim.new(1, 0) }, inst) end
local function padding(inst, l, r, t, b)
	make("UIPadding", {
		PaddingLeft = UDim.new(0, l or 0), PaddingRight = UDim.new(0, r or 0),
		PaddingTop = UDim.new(0, t or 0), PaddingBottom = UDim.new(0, b or 0),
	}, inst)
end
local function listLayout(inst, gap, fillDir)
	make("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, gap or 0),
		FillDirection = fillDir or Enum.FillDirection.Vertical,
	}, inst)
end
local function glowDecor(parent, w, h, x, y, transparency, rotation)
	local img = make("ImageLabel", {
		Size = UDim2.new(0, w, 0, h), Position = UDim2.new(0, x, 0, y),
		AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
		Image = Images.GLOW, ImageColor3 = "glowBase", ImageTransparency = transparency,
		ScaleType = Enum.ScaleType.Stretch, ZIndex = 0,
	}, parent)
	local grad = make("UIGradient", { Rotation = rotation or 45, Color = ColorSequence.new(C.glowFrom, C.glowTo) }, img)
	gradients[#gradients + 1] = grad
	return img
end
local function cometGradient(stroke)
	-- gradient แบบหางดาว (ไล่โปร่งแสง) สำหรับ border ที่หมุนได้
	local g = make("UIGradient", {
		Rotation = 0,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.35, 0),
			NumberSequenceKeypoint.new(0.7, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Color = ColorSequence.new(C.glowFrom, C.glowTo),
	}, stroke)
	gradients[#gradients + 1] = g
	return g
end
local function prepFade(container)
	local items = {}
	local function add(inst)
		if inst:IsA("GuiObject") then
			items[#items+1] = { inst, "BackgroundTransparency", inst.BackgroundTransparency }
			if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
				items[#items+1] = { inst, "TextTransparency", inst.TextTransparency }
			elseif inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
				items[#items+1] = { inst, "ImageTransparency", inst.ImageTransparency }
			end
		elseif inst:IsA("UIStroke") then
			items[#items+1] = { inst, "Transparency", inst.Transparency }
		end
	end
	add(container)
	for _, d in ipairs(container:GetDescendants()) do add(d) end
	return items
end
local function doFade(items, alpha, time)
	for _, it in ipairs(items) do
		local inst, prop, orig = it[1], it[2], it[3]
		local target = 1 - (1 - orig) * alpha
		if time and time > 0 then tween(inst, time, { [prop] = target }) else inst[prop] = target end
	end
end

