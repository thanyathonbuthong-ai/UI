function Nebula:_createNotificationSystem()
	local NOTIF_W = 300
	local STYLE_KEY = { stripe="1", pill="2", island="3", ring="4", solid="5" }
	local function kindColor(kind)
		if kind == "success" then return C.success end
		if kind == "warn" or kind == "warning" then return C.warn end
		if kind == "error" then return C.error end
		return C.accent
	end
	-- holder มุมขวาล่าง
	local holder = make("Frame", {
		AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -14, 1, -10),
		Size = UDim2.new(0, NOTIF_W, 1, -20), BackgroundTransparency = 1,
		BorderSizePixel = 0, ZIndex = 500, Parent = self._gui,
	})
	make("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Bottom,
		HorizontalAlignment = Enum.HorizontalAlignment.Right, Padding = UDim.new(0, 6),
	}, holder)
	-- island holder (บนกลาง)
	local islandHolder = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.new(0, 280, 1, -20), BackgroundTransparency = 1,
		BorderSizePixel = 0, ZIndex = 500, Parent = self._gui,
	})
	make("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Top,
		HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 6),
	}, islandHolder)

	-- Blur effect
	local blur = { effect = nil, users = 0 }
	function blur.acquire()
		blur.users = blur.users + 1
		if not blur.effect then
			pcall(function()
				blur.effect = Instance.new("BlurEffect")
				blur.effect.Name = "NebulaBlur"
				blur.effect.Size = 0
				blur.effect.Parent = Lighting
			end)
		end
		if blur.effect then tween(blur.effect, 0.3, { Size = 8 }) end
	end
	function blur.release()
		blur.users = math.max(blur.users - 1, 0)
		if blur.users == 0 and blur.effect then tween(blur.effect, 0.5, { Size = 0 }) end
	end

	local function escapeRich(str)
		return (tostring(str):gsub("&","&amp;"):gsub("<","&lt;"):gsub(">","&gt;"))
	end

	function self:Notify(o)
		o = o or {}
		local title = o.Title or "Notification"
		local content = o.Content or ""
		local color = kindColor(o.Type or "info")
		local duration = o.Duration or 4
		local styleRaw = tostring(o.Style or self._notifStyle or "stripe"):lower():gsub("%s+","")
		local style = STYLE_KEY[styleRaw] or styleRaw or "1"

		self._notifCount = self._notifCount + 1
		local order = self._notifCount
		blur.acquire()

		local wrapper, toast, restPos, startPos, progressFn
		local W, H = NOTIF_W, 58

		if style == "3" then -- Island (บนกลาง)
			H = 52
			wrapper = make("Frame", { LayoutOrder = order, Size = UDim2.new(0, 280, 0, H+8), BackgroundTransparency = 1, Parent = islandHolder })
			toast = make("TextButton", {
				AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, -60),
				Size = UDim2.new(0, H, 0, H), BackgroundColor3 = Color3.fromRGB(8,8,10),
				BackgroundTransparency = 0.05, Text = "", AutoButtonColor = false,
				BorderSizePixel = 0, ClipsDescendants = true, ZIndex = 501, Parent = wrapper,
			})
			round(toast, H/2)
			make("UIStroke", { Thickness = 1, Color = color, Transparency = 0.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, toast)
			local badge = make("Frame", { Position = UDim2.new(0,10,0,10), Size = UDim2.new(0,32,0,32), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 502, Parent = toast })
			pill(badge)
			make("TextLabel", {
				Position = UDim2.new(0,54,0,8), Size = UDim2.new(0,210,0,16), BackgroundTransparency = 1,
				Text = title, TextSize = 13, TextColor3 = Color3.fromRGB(244,244,245), FontFace = FONT_BOLD,
				TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 502, Parent = toast,
			})
			make("TextLabel", {
				Position = UDim2.new(0,54,0,26), Size = UDim2.new(0,210,0,14), BackgroundTransparency = 1,
				Text = content, TextSize = 11, TextColor3 = Color3.fromRGB(154,154,162), FontFace = FONT,
				TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 502, Parent = toast,
			})
			local items = prepFade(toast)
			doFade(items, 0, 0)
			tween(toast, 0.4, { Position = UDim2.new(0.5, 0, 0, 0) }, Enum.EasingStyle.Quint)
			task.delay(0.1, function() tween(toast, 0.5, { Size = UDim2.new(0, 280, 0, H) }, Enum.EasingStyle.Quint) end)
			task.delay(0.05, function() doFade(items, 1, 0.3) end)
		else
			wrapper = make("Frame", { LayoutOrder = order, Size = UDim2.new(0, W, 0, H+8), BackgroundTransparency = 1, Parent = holder })
			toast = make("TextButton", {
				Position = UDim2.new(1, 40, 0, 0), Size = UDim2.new(0, W, 0, H),
				BackgroundColor3 = style == "5" and color or C.card,
				BackgroundTransparency = style == "5" and 0.05 or 0.1,
				Text = "", AutoButtonColor = false, BorderSizePixel = 0,
				ClipsDescendants = true, ZIndex = 501, Parent = wrapper,
			})
			round(toast, 10)
			if style ~= "5" then
				make("UIStroke", { Thickness = 1, Color = "stroke", Transparency = 0.3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, toast)
			end
			local onColor = contrastOn(color)
			local textCol = (style == "5") and onColor or C.text
			local mutedCol = (style == "5") and onColor:Lerp(color, 0.4) or C.muted

			if style == "1" then -- Stripe: แถบสีซ้าย + progress bar ล่าง
				make("Frame", { Position = UDim2.new(0,8,0,10), Size = UDim2.new(0,3,0,H-20), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 502, Parent = toast })
				make("TextLabel", { Position = UDim2.new(0,22,0,9), Size = UDim2.new(0,W-36,0,18), BackgroundTransparency = 1, Text = title, TextSize = 13, TextColor3 = textCol, FontFace = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 502, Parent = toast })
				make("TextLabel", { Position = UDim2.new(0,22,0,28), Size = UDim2.new(0,W-36,0,16), BackgroundTransparency = 1, Text = content, TextSize = 11, TextColor3 = mutedCol, FontFace = FONT, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 502, Parent = toast })
				local trackW = W - 44
				local fill = make("Frame", { Position = UDim2.new(0,22,0,H-9), Size = UDim2.new(0,trackW,0,2), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 502, Parent = toast })
				progressFn = function(frac) tween(fill, 0.08, { Size = UDim2.new(0, trackW*frac, 0, 2) }, Enum.EasingStyle.Linear) end
			elseif style == "2" then -- Pill: badge กลม + rich text
				toast.Size = UDim2.new(0, 0, 0, 0)
				toast.AutomaticSize = Enum.AutomaticSize.XY
				toast.AnchorPoint = Vector2.new(1, 0)
				padding(toast, 6, 14, 6, 6)
				make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }, toast)
				local badge = make("Frame", { LayoutOrder = 1, Size = UDim2.new(0,24,0,24), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 502, Parent = toast })
				pill(badge)
				local rich = "<b>" .. escapeRich(title) .. "</b>"
				if content ~= "" then rich = rich .. '  <font color="#' .. mutedCol:ToHex() .. '">' .. escapeRich(content) .. "</font>" end
				local body = make("TextLabel", {
					LayoutOrder = 2, Size = UDim2.new(0,0,0,0), AutomaticSize = Enum.AutomaticSize.XY,
					BackgroundTransparency = 1, RichText = true, TextWrapped = true, Text = rich,
					TextSize = 13, TextColor3 = textCol, FontFace = FONT,
					TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
					ZIndex = 502, Parent = toast,
				})
				make("UISizeConstraint", { MaxSize = Vector2.new(W - 50, math.huge) }, body)
			elseif style == "4" then -- Ring: วงกลมจุดนับถอยหลัง
				local ringBox = make("Frame", { Position = UDim2.new(0,10,0,10), Size = UDim2.new(0,38,0,38), BackgroundTransparency = 1, ZIndex = 502, Parent = toast })
				local dots = {}
				for i = 0, 27 do
					local ang = (i/28)*math.pi*2 - math.pi/2
					local dot = make("Frame", {
						AnchorPoint = Vector2.new(0.5,0.5),
						Position = UDim2.new(0.5 + math.cos(ang)*0.42, 0, 0.5 + math.sin(ang)*0.42, 0),
						Size = UDim2.new(0,3,0,3), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 503, Parent = ringBox,
					})
					pill(dot)
					dots[#dots+1] = dot
				end
				make("TextLabel", { Position = UDim2.new(0,58,0,10), Size = UDim2.new(0,W-70,0,18), BackgroundTransparency = 1, Text = title, TextSize = 13, TextColor3 = textCol, FontFace = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 502, Parent = toast })
				make("TextLabel", { Position = UDim2.new(0,58,0,30), Size = UDim2.new(0,W-70,0,16), BackgroundTransparency = 1, Text = content, TextSize = 11, TextColor3 = mutedCol, FontFace = FONT, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 502, Parent = toast })
				local lastLit = 28
				progressFn = function(frac)
					local lit = math.ceil(frac * 28)
					if lit >= lastLit then return end
					for i = lit+1, lastLit do tween(dots[i], 0.15, { BackgroundTransparency = 0.85 }) end
					lastLit = lit
				end
			else -- "5" Solid หรือ default: ไอคอน + ข้อความธรรมดา
				local iconBox = make("Frame", { Position = UDim2.new(0,14,0.5,0), AnchorPoint = Vector2.new(0,0.5), Size = UDim2.new(0,22,0,22), BackgroundColor3 = onColor, BackgroundTransparency = 0.85, BorderSizePixel = 0, ZIndex = 502, Parent = toast })
				pill(iconBox)
				make("TextLabel", { Position = UDim2.new(0,48,0,9), Size = UDim2.new(0,W-60,0,18), BackgroundTransparency = 1, Text = title, TextSize = 13, TextColor3 = textCol, FontFace = FONT_BOLD, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 502, Parent = toast })
				make("TextLabel", { Position = UDim2.new(0,48,0,28), Size = UDim2.new(0,W-60,0,16), BackgroundTransparency = 1, Text = content, TextSize = 11, TextColor3 = mutedCol, FontFace = FONT, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 502, Parent = toast })
			end

			-- enter animation (slide จากขวา)
			tween(toast, 0.4, { Position = UDim2.new(1, 0, 0, 0) }, Enum.EasingStyle.Quint)
		end

		-- progress countdown
		task.spawn(function()
			local elapsed = 0
			while elapsed < duration and toast.Parent do
				elapsed = elapsed + 0.1
				if progressFn then progressFn(1 - elapsed/duration) end
				task.wait(0.1)
			end
			-- leave animation
			if toast.Parent then
				if style == "3" then
					local items = prepFade(toast)
					doFade(items, 0, 0.25)
					tween(toast, 0.3, { Size = UDim2.new(0, H, 0, H) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
					task.delay(0.15, function() if toast.Parent then tween(toast, 0.3, { Position = UDim2.new(0.5, 0, 0, -60) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In) end end)
					task.delay(0.5, function() wrapper:Destroy() end)
				else
					tween(toast, 0.3, { Position = UDim2.new(1, 40, 0, 0), BackgroundTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
					task.delay(0.35, function() wrapper:Destroy() end)
				end
				blur.release()
			end
		end)

		-- กดปิดเองได้
		toast.MouseButton1Click:Connect(function()
			duration = 0
		end)
	end
end

--====================================================================
--  CONFIG SAVE/LOAD + VISIBILITY + THEME + UNLOAD
--====================================================================
function Nebula:_saveConfig()
	pcall(function()
		local data = {}
		for k, v in pairs(self._flags) do
			if typeof(v) == "Color3" then
				data[k] = { __color = true, r = v.R, g = v.G, b = v.B }
			elseif typeof(v) == "EnumItem" then
				data[k] = { __enum = true, enum = tostring(v.EnumType), value = v.Value }
			else
				data[k] = v
			end
		end
		writefile(self._configPath, HttpService:JSONEncode(data))
	end)
end

function Nebula:_loadConfig()
	pcall(function()
		if isfile(self._configPath) then
			local data = HttpService:JSONDecode(readfile(self._configPath))
			for k, v in pairs(data) do
				if type(v) == "table" and v.__color then
					self._flags[k] = Color3.new(v.r, v.g, v.b)
				elseif type(v) == "table" and v.__enum then
					local ok, enumVal = pcall(function() return Enum[v.enum]:FromValue(v.value) end)
					if ok then self._flags[k] = enumVal end
				else
					self._flags[k] = v
				end
			end
		end
	end)
end

function Nebula:SetVisible(visible)
	self._uiOpen = visible
	if visible then
		self._container.Visible = true
		local items = prepFade(self._container)
		doFade(items, 0, 0)
		tween(self._container, 0.3, { Size = UDim2.new(0, WINDOW_W, 0, self._collapsed and TOPBAR_H or WINDOW_H) }, Enum.EasingStyle.Quint)
		task.delay(0.03, function() doFade(items, 1, 0.25) end)
		self._bubble.Visible = false
	else
		local items = prepFade(self._container)
		doFade(items, 0, 0.2)
		tween(self._container, 0.25, { Size = UDim2.new(0, WINDOW_W*0.8, 0, WINDOW_H*0.8) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.25, function() self._container.Visible = false end)
		self._bubble.Visible = true
	end
end

function Nebula:SetTheme(name)
	if THEMES[name] then
		applyTheme(name, 0.6)
		for i, n in ipairs(THEME_ORDER) do if n == name then self._themeIndex = i break end end
	end
end

function Nebula:Unload()
	self._unloaded = true
	for _, conn in ipairs(self._connections) do pcall(function() conn:Disconnect() end) end
	if self._gui then self._gui:Destroy() end
end

--====================================================================
--  EXPORT
--====================================================================
Nebula.Themes = THEME_ORDER
return Nebula



