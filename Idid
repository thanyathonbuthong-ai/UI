function Nebula:SelectTab(tab)
	if self._activeTab == tab then return end
	if self._activeTab then
		self._activeTab._page.Visible = false
		tween(self._activeTab._btn, 0.2, { BackgroundTransparency = 1 })
		setRole(self._activeTab._lbl, "TextColor3", "muted")
	end
	self._activeTab = tab
	tab._page.Visible = true
	tween(tab._btn, 0.2, { BackgroundTransparency = 0.4 })
	setRole(tab._lbl, "TextColor3", "text")
	-- เลื่อน pin ไปที่ tab นี้ (smooth tween จาก Kittylol)
	local btn = tab._btn
	task.defer(function()
		if not btn.Parent then return end
		local y = (btn.AbsolutePosition.Y - self._sidebar.AbsolutePosition.Y + btn.AbsoluteSize.Y/2) / self._uiScale.Scale - 10
		tween(self._pin, 0.35, { Position = UDim2.new(0, 6, 0, y) }, Enum.EasingStyle.Quint)
	end)
	-- page enter animation
	local items = prepFade(tab._page)
	doFade(items, 0, 0)
	tab._page.Position = UDim2.new(0, 10, 0, 0)
	tween(tab._page, 0.3, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Quint)
	task.delay(0.03, function() doFade(items, 1, 0.25) end)
end

--====================================================================
--  BUBBLE TOGGLE BUTTON (ลากได้ + บันทึกตำแหน่ง จาก Kittylol)
--====================================================================
function Nebula:_createBubbleToggle()
	local settings = {}
	pcall(function()
		if isfile(self._togglePath) then
			local ok, dec = pcall(function() return HttpService:JSONDecode(readfile(self._togglePath)) end)
			if ok and type(dec) == "table" then settings = dec end
		end
	end)
	local SIZE = 46
	local btn = make("TextButton", {
		Name = "BubbleToggle",
		BackgroundColor3 = "card", BackgroundTransparency = 0.15,
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.new(0, settings.x or 16, 0, settings.y or 60),
		Size = UDim2.new(0, SIZE, 0, SIZE),
		Text = "", AutoButtonColor = false, BorderSizePixel = 0,
		Active = true, ZIndex = 100, Parent = self._gui,
	})
	pill(btn)
	make("UIStroke", { Thickness = 1.5, Color = "accent", Transparency = 0.4, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, btn)
	local icon = make("ImageLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0, 22, 0, 22), BackgroundTransparency = 1,
		Image = self._cfg.Logo or Images.LOGO, ImageColor3 = "accent", ScaleType = Enum.ScaleType.Fit,
		ZIndex = 101, Parent = btn,
	})
	local glow = make("ImageLabel", {
		Size = UDim2.new(0, 70, 0, 70), Position = UDim2.new(0.5,0,0.5,0),
		AnchorPoint = Vector2.new(0.5,0.5), BackgroundTransparency = 1,
		Image = Images.GLOW, ImageColor3 = "accent", ImageTransparency = 0.55,
		ZIndex = 99, Parent = btn,
	})
	local scale = make("UIScale", { Scale = 1 }, btn)

	local dragging, moved, dragInput, dragStart, startPos = false, false, nil, nil, nil
	local function clampPos(pos)
		local vp = getViewport()
		return Vector2.new(math.clamp(pos.X, 0, vp.X - SIZE), math.clamp(pos.Y, 0, vp.Y - SIZE))
	end
	btn.Position = UDim2.new(0, clampPos(Vector2.new(btn.Position.X.Offset, btn.Position.Y.Offset)).X, 0, clampPos(Vector2.new(btn.Position.X.Offset, btn.Position.Y.Offset)).Y)

	btn.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		dragging, moved = true, false
		dragInput = input
		dragStart = input.Position
		startPos = Vector2.new(btn.Position.X.Offset, btn.Position.Y.Offset)
		tween(scale, 0.15, { Scale = 0.88 })
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
		if input.UserInputType == Enum.UserInputType.Touch and input ~= dragInput then return end
		local delta = input.Position - dragStart
		if not moved and delta.Magnitude < 6 then return end
		moved = true
		tween(scale, 0.15, { Scale = 1.1 })
		local np = clampPos(startPos + Vector2.new(delta.X, delta.Y))
		btn.Position = UDim2.new(0, np.X, 0, np.Y)
	end)
	local function endDrag()
		if not dragging then return end
		dragging = false
		tween(scale, 0.2, { Scale = 1 })
		if moved then
			settings.x = btn.Position.X.Offset
			settings.y = btn.Position.Y.Offset
			pcall(function() writefile(self._togglePath, HttpService:JSONEncode(settings)) end)
		else
			self._uiOpen = not self._uiOpen
			self:SetVisible(self._uiOpen)
		end
	end
	UserInputService.InputEnded:Connect(function(input)
		if dragging and (input == dragInput or (dragInput and dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)) then
			endDrag()
		end
	end)
	self._bubble = btn
end

