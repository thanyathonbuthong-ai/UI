				Size = UDim2.new(0, 26, 0, 26), Position = UDim2.new(0.5,0,0.5,0),
				AnchorPoint = Vector2.new(0.5,0.5), BackgroundTransparency = 1,
				Image = Images.GLOW, ImageColor3 = "accent", ImageTransparency = 0.5, ZIndex = 8, Parent = knob,
			})
			local function setVal(v, instant)
				v = math.clamp(v, minV, maxV)
				val = v
				local pct = (v - minV) / (maxV - minV)
				local time = instant and 0 or 0.12
				tween(fill, time, { Size = UDim2.new(pct, 0, 1, 0) })
				tween(knob, time, { Position = UDim2.new(pct, 0, 0.5, 0) })
				valLbl.Text = o.Decimals and tostring(v) or tostring(math.floor(v))
				if o.Flag then win._flags[o.Flag] = v; win:_saveConfig() end
				if o.Callback then pcall(o.Callback, v) end
			end
			setVal(val, true)
			local sliding = false
