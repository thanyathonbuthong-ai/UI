		local bIcon = make("ImageLabel", {
			Name = "Icon",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 0),
			Size = UDim2.new(0, 26, 0, 24),
			BackgroundTransparency = 1,
			Image = LOGO,
			ImageColor3 = logoRole("accent"),
			ImageTransparency = 1,
			ScaleType = Enum.ScaleType.Fit,
			ZIndex = 51,
		}, bubble)

		-- ลากบับเบิลได้ (รองรับนิ้วสัมผัส) พร้อมกันหลุดขอบจอ, แตะเฉย ๆ (ไม่ลาก) = เปิด UI
		local bDragging, bDragStart, bStartPos, bMoved = false, nil, nil, false
		bubble.InputBegan:Connect(function(input)
			if
				input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
			then
				bDragging = true
				bMoved = false
				bDragStart = input.Position
				bStartPos = bubble.Position
				local conn
				conn = input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						bDragging = false
						conn:Disconnect()
					end
				end)
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if
				bDragging
				and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch)
			then
				local delta = input.Position - bDragStart
				if delta.Magnitude > 3 then
					bMoved = true
				end
				local screen = root.AbsoluteSize
				local size = bubble.AbsoluteSize
				-- AnchorPoint คือ (0,0) ดังนั้น offset = ขอบซ้าย/บน - screen*scale
				local offsetMinX = 0 - screen.X * bStartPos.X.Scale
				local offsetMaxX = math.max(screen.X - size.X, 0) - screen.X * bStartPos.X.Scale
				local offsetMinY = 0 - screen.Y * bStartPos.Y.Scale
				local offsetMaxY = math.max(screen.Y - size.Y, 0) - screen.Y * bStartPos.Y.Scale
				local newX = math.clamp(bStartPos.X.Offset + delta.X, offsetMinX, offsetMaxX)
				local newY = math.clamp(bStartPos.Y.Offset + delta.Y, offsetMinY, offsetMaxY)
				bubble.Position = UDim2.new(bStartPos.X.Scale, newX, bStartPos.Y.Scale, newY)
			end
		end)
		bubble.MouseButton1Click:Connect(function()
			if not bMoved then
				Window:Toggle(true)
			end
		end)
	end

	function Window:Toggle(state)
		if state == nil then
			state = not main.Visible
		end
		if state then
			main.Visible = true
			uiScale.Scale = 0
			tween(uiScale, 0.35, { Scale = computeScale() }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			if bubble then
				tween(bubble, 0.15, { BackgroundTransparency = 1 })
				local bIcon = bubble:FindFirstChild("Icon")
				if bIcon then
					tween(bIcon, 0.15, { ImageTransparency = 1 })
				end
				task.delay(0.15, function()
					bubble.Visible = false
				end)
			end
		else
			closeAllDropdowns()
			tween(uiScale, 0.22, { Scale = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.22, function()
				main.Visible = false
			end)
			if bubble then
				bubble.Visible = true
				bubble.BackgroundTransparency = 1
				local bIcon = bubble:FindFirstChild("Icon")
				if bIcon then
					bIcon.ImageTransparency = 1
				end
				tween(bubble, 0.2, { BackgroundTransparency = 0.08 })
				if bIcon then
					tween(bIcon, 0.2, { ImageTransparency = 0 })
				end
			end
		end
	end

