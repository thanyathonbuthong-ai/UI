				local btnSize = selectedBtn.AbsoluteSize
				local btnCenterY = btnPos.Y + btnSize.Y / 2
				return btnCenterY >= pagePos.Y and btnCenterY <= (pagePos.Y + pageSize.Y)
			end

			local function positionList()
				local scale = uiScale.Scale
				if not scale or scale <= 0 then
					scale = 1
				end
				local basePos = dropdownOverlay.AbsolutePosition
				local btnPos = selectedBtn.AbsolutePosition
				local btnSize = selectedBtn.AbsoluteSize
				local x = (btnPos.X - basePos.X) / scale
				local y = (btnPos.Y - basePos.Y) / scale
				local h = btnSize.Y / scale
				list.Position = UDim2.new(0, x, 0, y + h + 4)
			end

			local function setOpen(v)
				open = v
				tween(chevronBox, 0.15, { Rotation = v and 180 or 0 })
				if v then
					positionList()
					list.Visible = true
					if heartbeatConn then
						heartbeatConn:Disconnect()
					end
					-- keep the list glued to the button (handles scrolling the
					-- page while open) and auto-close once the button scrolls
					-- out of the visible page area
					heartbeatConn = RunService.Heartbeat:Connect(function()
						if not open then
							return
						end
						if not page.Visible or not isButtonVisibleInPage() then
							setOpen(false)
							return
						end
						positionList()
					end)
				else
					list.Visible = false
					if heartbeatConn then
						heartbeatConn:Disconnect()
						heartbeatConn = nil
					end
				end
			end

			openDropdowns[#openDropdowns + 1] = function()
				setOpen(false)
			end

			local api = {}
			local function select(v, silent)
				value = v
				selectedLabel.Text = tostring(v)
				setOpen(false)
				if not silent and opts.Callback then
					task.spawn(opts.Callback, value)
				end
			end

			for i, v in ipairs(values) do
				local opt = make("TextButton", {
					LayoutOrder = i,
					Size = UDim2.new(1, 0, 0, 28),
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					AutoButtonColor = false,
					Text = "",
					ZIndex = 11,
				}, list)
				local optLabel = text(opt, tostring(v), 10, 0, 120, 28, 12, "text")
				optLabel.ZIndex = 12
				opt.MouseEnter:Connect(function()
					tween(opt, 0.1, { BackgroundTransparency = 0.6, BackgroundColor3 = C.btn2 })
				end)
				opt.MouseLeave:Connect(function()
					tween(opt, 0.1, { BackgroundTransparency = 1 })
				end)
				opt.MouseButton1Click:Connect(function()
					select(v)
				end)
			end

			selectedBtn.MouseButton1Click:Connect(function()
				setOpen(not open)
			end)

			function api:Set(v, silent)
				select(v, silent)
			end
			function api:Get()
				return value
			end
			if opts.Flag then
				Window._registry[opts.Flag] = { get = api.Get, set = function(v)
					api:Set(v, true)
				end }
				Window.Flags[opts.Flag] = api
			end
			return api
		end

		return Tab
	end

	-- ===== Side profile drawer (อยู่ทางซ้ายของ UI เลื่อนเก็บ/เปิดได้) =====
	local DRAWER_W = 190
	local DRAWER_H = 88
	local HANDLE_W = 26
	local DRAWER_Y = FINAL_H - DRAWER_H - 12
	-- (ตำแหน่งอ้างอิงเป็นขอบขวาของแผง เพราะ AnchorPoint = 1,0)
	-- เปิด: แผงโปรไฟล์โชว์อยู่นอก UI หลักทางซ้าย
	-- ปิด: แผงถูกพับเก็บกลับเข้าไปอยู่หลัง UI หลัก (ซ่อนด้วย canvas)
	local DRAWER_OPEN_X = -(HANDLE_W + 12)
	local DRAWER_CLOSED_X = DRAWER_W

	local drawer = make("CanvasGroup", {
		Name = "ProfileDrawer",
		AnchorPoint = Vector2.new(1, 0),
		GroupTransparency = 0,
		Position = UDim2.new(0, DRAWER_CLOSED_X, 0, DRAWER_Y),
		Size = UDim2.new(0, DRAWER_W, 0, DRAWER_H),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = false,
		-- ZIndex ต่ำกว่า canvas ของหน้าต่างหลัก ทำให้ตอนพับจะซ่อนอยู่หลัง UI
		ZIndex = 0,
	}, main)

	local panel = make("Frame", {
		Name = "Panel",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = "card",
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
		ZIndex = 1,
	}, drawer)
	round(panel, 14, "stroke")

	-- ปุ่มจับอยู่นอกหน้าต่างหลัก (ทางซ้ายของ UI) ไม่ถูกตัดตอนแผงเลื่อนเข้า/ออก
	local handle = make("TextButton", {
		Name = "DrawerHandle",
		Position = UDim2.new(0, -HANDLE_W - 6, 0, DRAWER_Y + (DRAWER_H - 40) / 2),
		Size = UDim2.new(0, HANDLE_W, 0, 40),
		BackgroundColor3 = "accent",
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		Visible = false,
		ZIndex = 30,
	}, main)
	make("UICorner", { CornerRadius = UDim.new(0, 8) }, handle)
	local handleScale = make("UIScale", { Scale = 1 }, handle)

	local handleLabel = make("TextLabel", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "‹",
		TextSize = 20,
		TextColor3 = "submitText",
		FontFace = FONT_BOLD,
		ZIndex = 23,
	}, handle)

	local avatarHolder = make("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.new(0, 40, 0, 40),
		BackgroundColor3 = "input",
		BorderSizePixel = 0,
		ZIndex = 21,
	}, panel)
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, avatarHolder)
	make("UIStroke", { Thickness = 1.5, Color = "accent", Transparency = 0.25 }, avatarHolder)
	local avatarImage = make("ImageLabel", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		ScaleType = Enum.ScaleType.Crop,
		ZIndex = 22,
	}, avatarHolder)
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, avatarImage)
	task.spawn(function()
		local ok, thumb = pcall(function()
			return Players:GetUserThumbnailAsync(
				player.UserId,
				Enum.ThumbnailType.HeadShot,
				Enum.ThumbnailSize.Size100x100
			)
		end)
		if ok and thumb then
			avatarImage.Image = thumb
		end
	end)

	local LABEL_X = 58
	local LABEL_W = DRAWER_W - LABEL_X - HANDLE_W - 6
	local BIG_THUMB = 40

	-- ===== โหมดโปรไฟล์ =====
	local nameLabel = text(panel, player.DisplayName, LABEL_X, 10, LABEL_W, 18, 13, "text")
	nameLabel.FontFace = FONT_BOLD
	nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
	nameLabel.ZIndex = 21
	local userLabel = text(panel, "@" .. player.Name, LABEL_X, 27, LABEL_W, 14, 11, "muted")
	userLabel.TextTruncate = Enum.TextTruncate.AtEnd
	userLabel.ZIndex = 21

	-- ===== โหมดแมพ =====
	local mapThumb = make("ImageLabel", {
		Position = UDim2.new(0, 10, 0, 10),
		Size = UDim2.new(0, BIG_THUMB, 0, BIG_THUMB),
		BackgroundColor3 = "input",
		BorderSizePixel = 0,
		ScaleType = Enum.ScaleType.Crop,
		Visible = false,
		ZIndex = 21,
	}, panel)
	make("UICorner", { CornerRadius = UDim.new(0, 8) }, mapThumb)
	pcall(function()
		mapThumb.Image = "rbxthumb://type=GameIcon&id=" .. tostring(game.GameId) .. "&w=150&h=150"
	end)

	local mapLabel = text(panel, "กำลังโหลด...", LABEL_X, 10, LABEL_W, 18, 13, "text")
	mapLabel.TextTruncate = Enum.TextTruncate.AtEnd
	mapLabel.Visible = false
	mapLabel.ZIndex = 21
	local mapSub = text(panel, "กำลังเล่นอยู่", LABEL_X, 27, LABEL_W, 14, 11, "muted")
	mapSub.Visible = false
	mapSub.ZIndex = 21

	task.spawn(function()
		local ok, info = pcall(function()
			return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
		end)
		local name = (ok and info and info.Name) or game.Name
		mapLabel.Text = tostring(name)
	end)

	-- ===== สวิตช์โหมดแบบ pill มี highlight เลื่อนได้ =====
	local viewMode = "profile"
	local SEG_H = 20

	local track = make("Frame", {
		Name = "ModeTrack",
		Position = UDim2.new(0, LABEL_X, 0, DRAWER_H - SEG_H - 6),
		Size = UDim2.new(0, LABEL_W, 0, SEG_H),
		BackgroundColor3 = "input",
		BorderSizePixel = 0,
		ZIndex = 21,
	}, panel)
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, track)
	make("UIStroke", { Thickness = 1, Color = "stroke" }, track)

	local indicator = make("Frame", {
		Name = "Indicator",
		Position = UDim2.new(0, 2, 0, 2),
		Size = UDim2.new(0.5, -3, 1, -4),
		BackgroundColor3 = "accent",
		BorderSizePixel = 0,
		ZIndex = 22,
	}, track)
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, indicator)

	local function segButton(label, xScale, mode)
		local b = make("TextButton", {
			Position = UDim2.new(xScale, 0, 0, 0),
			Size = UDim2.new(0.5, 0, 1, 0),
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 23,
		}, track)
		local t = text(b, label, 0, 0, 0, 0, 10, "muted", Enum.TextXAlignment.Center)
		t.Size = UDim2.new(1, 0, 1, 0)
		t.ZIndex = 24
		b.MouseButton1Click:Connect(function()
			Window:SetDrawerMode(mode)
		end)
		return t
	end
	local profileTxt = segButton("โปรไฟล์", 0, "profile")
	local mapTxt = segButton("แมพ", 0.5, "map")

	local function applyMode()
		local isProfile = viewMode == "profile"
		avatarHolder.Visible = isProfile
		nameLabel.Visible = isProfile
		userLabel.Visible = isProfile
		mapThumb.Visible = not isProfile
		mapLabel.Visible = not isProfile
		mapSub.Visible = not isProfile

		tween(
			indicator,
			0.4,
			{ Position = isProfile and UDim2.new(0, 2, 0, 2) or UDim2.new(0.5, 1, 0, 2) },
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out
		)
		tween(profileTxt, 0.25, { TextColor3 = isProfile and C.submitText or C.muted })
		tween(mapTxt, 0.25, { TextColor3 = (not isProfile) and C.submitText or C.muted })

		if not isProfile then
			mapThumb.Position = UDim2.new(0, 10, 0, 10)
			mapThumb.Size = UDim2.new(0, BIG_THUMB, 0, BIG_THUMB)
			mapLabel.Position = UDim2.new(0, LABEL_X, 0, 10)
			mapLabel.Size = UDim2.new(0, LABEL_W, 0, 18)
			mapLabel.FontFace = FONT_BOLD
			mapLabel.TextSize = 13
		end
	end

	function Window:SetDrawerMode(m)
		if m == "profile" or m == "map" then
			viewMode = m
			applyMode()
		end
	end
	applyMode()

	local drawerOpen = true
	local function setDrawerOpen(v)
		if v == drawerOpen then
			return
		end
		drawerOpen = v

		do
			local r, rStroke = ring(handle, 30, 2, C.accent, 0.2)
			local rScale = make("UIScale", { Scale = 0.5 }, r)
			tween(rScale, 0.4, { Scale = 1.8 }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			tween(rStroke, 0.4, { Transparency = 1 })
			task.delay(0.42, function()
				r:Destroy()
			end)
		end

		handleLabel.Text = v and "‹" or "›"

		-- เปิด: ให้แผงกลับมาแสดงก่อนเลื่อนออก
		-- พับ: เลื่อนเข้าไปแล้วซ่อนแผงทั้งอันหลังจากเลื่อนเสร็จ
		if v then
			drawer.Visible = true
		else
			task.delay(0.55, function()
				if not drawerOpen then
					drawer.Visible = false
				end
			end)
		end

		tween(
			drawer,
			0.55,
			{ Position = UDim2.new(0, v and DRAWER_OPEN_X or DRAWER_CLOSED_X, 0, DRAWER_Y) },
			Enum.EasingStyle.Back,
			v and Enum.EasingDirection.Out or Enum.EasingDirection.In
		)
		if v then
			avatarHolder.Rotation = -180
			tween(avatarHolder, 0.6, { Rotation = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		end
		tween(nameLabel, 0.2, { TextTransparency = v and 0 or 1 })
		tween(userLabel, 0.2, { TextTransparency = v and 0 or 1 })
	end

	handle.MouseButton1Click:Connect(function()
		setDrawerOpen(not drawerOpen)
	end)
	function Window:SetProfileBadgeExpanded(v)
		setDrawerOpen(v and true or false)
	end
	function Window:SetProfileDrawerOpen(v)
		setDrawerOpen(v and true or false)
	end

	-- ตอนพับ UI: ปุ่มกับโปรไฟล์จะยุบและจางหายไปทั้งหมด
	-- ตอนกางออก: ปุ่มเด้งกลับมา และโปรไฟล์เลื่อนตามสถานะเดิม
	local isFolded = false
	Window._onMinimize = function(folded)
		isFolded = folded
		if folded then
			tween(handleScale, 0.3, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			tween(drawer, 0.35, {
				GroupTransparency = 1,
				Position = UDim2.new(0, DRAWER_CLOSED_X, 0, DRAWER_Y),
			}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.36, function()
				if isFolded then
					drawer.Visible = false
					handle.Visible = false
				end
			end)
		else
			drawer.Visible = true
			handle.Visible = true
			handleScale.Scale = 0
			drawer.GroupTransparency = 1
			drawer.Position = UDim2.new(0, DRAWER_CLOSED_X, 0, DRAWER_Y)
			tween(handleScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			tween(drawer, 0.5, {
				GroupTransparency = 0,
				Position = UDim2.new(0, drawerOpen and DRAWER_OPEN_X or DRAWER_CLOSED_X, 0, DRAWER_Y),
			}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		end
	end

	drawerOpen = false
	task.delay(0.9, function()
		drawer.Visible = true
		handle.Visible = true
		setDrawerOpen(true)
	end)

	root.Parent = (gethui and gethui()) or game:GetService("CoreGui")

	-- intro grow animation
	task.spawn(function()
		main.Size = UDim2.new(0, INTRO_SIZE - 20, 0, INTRO_SIZE - 20)
		tween(main, 0.6, { Size = UDim2.new(0, INTRO_SIZE, 0, INTRO_SIZE) }, Enum.EasingStyle.Quint)
		tween(canvas, 0.5, { BackgroundTransparency = 0 })
		tween(decorGroup, 0.5, { GroupTransparency = 0 })
		tween(borderStroke, 0.5, { Transparency = 0.55 })
		tween(shadow, 0.5, { ImageTransparency = 0.6 })
		task.wait(0.5)

		tween(borderStroke, 0.7, { Transparency = 1 })
		tween(main, 0.85, { Size = UDim2.new(0, FINAL_W, 0, FINAL_H) }, Enum.EasingStyle.Quint)
		task.wait(0.55)

		content.Visible = true
		local items = prep(content)
		fade(items, 0)
		fade(items, 1, 0.4)
	end)

	return Window
end

return Library
