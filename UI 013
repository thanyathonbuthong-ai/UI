	-- keep the gem tinted with the currently active theme's colors.
	-- NOTE: TweenService can't tween UIGradient.Color (ColorSequence), so we
	-- lerp it manually every frame via a driver NumberValue instead.
	local themeGemColors = { accent = C.accent, glowFrom = C.glowFrom, glowTo = C.glowTo }
	local function updateThemeGemColors(time)
		local newAccent, newFrom, newTo = C.accent, C.glowFrom, C.glowTo
		local oldAccent, oldFrom, oldTo = themeGemColors.accent, themeGemColors.glowFrom, themeGemColors.glowTo
		themeGemColors.accent, themeGemColors.glowFrom, themeGemColors.glowTo = newAccent, newFrom, newTo

		if time and time > 0 then
			tween(themeGem, time, { BackgroundColor3 = newAccent })
			local driver = Instance.new("NumberValue")
			local conn = driver.Changed:Connect(function(a)
				themeGemGradient.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, oldAccent:Lerp(newAccent, a)),
					ColorSequenceKeypoint.new(0.5, oldFrom:Lerp(newFrom, a)),
					ColorSequenceKeypoint.new(1, oldTo:Lerp(newTo, a)),
				})
			end)
			local t = tween(driver, time, { Value = 1 })
			t.Completed:Connect(function()
				conn:Disconnect()
				driver:Destroy()
				themeGemGradient.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, newAccent),
					ColorSequenceKeypoint.new(0.5, newFrom),
					ColorSequenceKeypoint.new(1, newTo),
				})
			end)
		else
			themeGem.BackgroundColor3 = newAccent
			themeGemGradient.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, newAccent),
				ColorSequenceKeypoint.new(0.5, newFrom),
				ColorSequenceKeypoint.new(1, newTo),
			})
		end
