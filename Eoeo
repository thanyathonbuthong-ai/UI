local Library = { Flags = {}, Windows = {} }

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local Theme = {
    BG = Color3.fromRGB(5, 5, 7),
    Card = Color3.fromRGB(10, 10, 12),
    CardHover = Color3.fromRGB(18, 18, 22),
    Field = Color3.fromRGB(24, 24, 28),
    Border = Color3.fromRGB(96, 98, 108),
    White = Color3.fromRGB(248, 246, 248),
    Dim = Color3.fromRGB(148, 150, 160),
    TrackOff = Color3.fromRGB(26, 26, 31),
    KnobOff = Color3.fromRGB(205, 205, 212),
    Good = Color3.fromRGB(73, 214, 112),
    Bad = Color3.fromRGB(245, 95, 95),
}
Library.Theme = Theme

local TI = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TI2 = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function tween(obj, info, props)
    TweenService:Create(obj, info, props):Play()
end

local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do
        o[k] = v
    end
    if parent then
        o.Parent = parent
    end
    return o
end

local function corner(parent, r)
    return new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, parent)
end

local function stroke(parent, color, thickness, transparency)
    return new("UIStroke", {
        Color = color or Theme.Border,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, parent)
end

local function label(parent, text, size, color, font)
    return new("TextLabel", {
        BackgroundTransparency = 1,
        Text = text or "",
        TextSize = size or 12,
        TextColor3 = color or Theme.White,
        Font = font or Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, parent)
end

local function protectGui(gui)
    local ok = false
    if type(gethui) == "function" then
        ok = pcall(function() gui.Parent = gethui() end)
    end
    if not ok or not gui.Parent then
        ok = pcall(function() gui.Parent = game:GetService("CoreGui") end)
    end
    if not ok or not gui.Parent then
        gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
    end
end

local function isPress(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

-- Falling dots (snow) effect
local function createSnow(parent, count, zindex)
    local holder = new("Frame", {
        Name = "FallingDots", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        BorderSizePixel = 0, ClipsDescendants = true, Active = false, ZIndex = zindex or 90,
    }, parent)
    local rng = Random.new()
    local alive = true
    holder.Destroying:Connect(function() alive = false end)
    for _ = 1, count do
        task.spawn(function()
            local dot = new("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0, Visible = false, ZIndex = holder.ZIndex + 1,
            }, holder)
            corner(dot, 100)
            task.wait(rng:NextNumber(0, 4.5))
            while alive and holder.Parent do
                if holder.Visible then
                    local s = rng:NextInteger(2, 4)
                    local x = rng:NextNumber(0.03, 0.97)
                    local x2 = math.clamp(x + rng:NextNumber(-0.15, 0.1), 0.02, 0.98)
                    local dur = rng:NextNumber(5.8, 9.2)
                    dot.Size = UDim2.fromOffset(s, s)
                    dot.Position = UDim2.new(x, 0, -0.1, -s)
                    dot.BackgroundTransparency = rng:NextNumber(0.28, 0.58)
                    dot.Visible = true
                    local tw = TweenService:Create(dot, TweenInfo.new(dur, Enum.EasingStyle.Linear), {
                        Position = UDim2.new(x2, 0, 1.06, s),
                        BackgroundTransparency = rng:NextNumber(0.48, 0.76),
                    })
                    tw:Play()
                    tw.Completed:Wait()
                    dot.Visible = false
                else
                    task.wait(0.35)
                end
                task.wait(rng:NextNumber(0.12, 0.45))
            end
            if dot.Parent then dot:Destroy() end
        end)
    end
    return holder
end

------------------------------------------------------------------------
-- Window
------------------------------------------------------------------------
function Library:CreateWindow(opts)
    opts = opts or {}
    local Window = { Tabs = {}, Setters = {}, Flags = Library.Flags, Config = opts.ConfigFile, Elements = {} }
    local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
    local size = opts.Size or Vector2.new(isMobile and 290 or 330, isMobile and 350 or 420)
    local baseScale = opts.Scale or 1
    local headerH = 50
    local tabH = isMobile and 28 or 34

    local gui = new("ScreenGui", {
        Name = opts.Name or ("AceUI_" .. tostring(opts.Title or "Window")),
        ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 9999,
    })
    pcall(function() gui.OnTopOfCoreBlur = true end)
    protectGui(gui)
    Window.Gui = gui

    local win = new("Frame", {
        Name = "Win", Size = UDim2.fromOffset(size.X, size.Y),
        Position = UDim2.new(0.5, -size.X / 2, 0.5, -size.Y / 2),
        BackgroundColor3 = Theme.BG, BorderSizePixel = 0, ClipsDescendants = true,
    }, gui)
    corner(win, 17)
    stroke(win, Theme.White, 1, 0.7)
    local uiScale = new("UIScale", { Scale = baseScale }, win)
    Window.Main = win

    -- background image + shade
    local bg = new("ImageLabel", {
        Name = "Background", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        Image = opts.Background or "", ScaleType = Enum.ScaleType.Crop, ZIndex = 0,
        Visible = opts.Background ~= nil and opts.Background ~= "",
    }, win)
    corner(bg, 17)
    local shade = new("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 0.45, BorderSizePixel = 0, ZIndex = 1,
    }, win)
    corner(shade, 16)
    local snow = createSnow(win, isMobile and 8 or 14, 90)
    snow.Visible = opts.Snow ~= false

    -- header (drag area)
    local header = new("Frame", {
        Size = UDim2.new(1, 0, 0, headerH), BackgroundTransparency = 1, Active = true, ZIndex = 5,
    }, win)
    if opts.Logo then
        new("ImageLabel", {
            Size = UDim2.fromOffset(28, 28), Position = UDim2.fromOffset(16, 11),
            BackgroundTransparency = 1, Image = opts.Logo, ScaleType = Enum.ScaleType.Fit, ZIndex = 6,
        }, header)
    end
    local title = label(header, opts.Title or "UI", isMobile and 14 or 18, Theme.White, Enum.Font.GothamBlack)
    title.Size = UDim2.new(1, -130, 0, 28)
    title.Position = UDim2.fromOffset(opts.Logo and 52 or 17, 11)
    title.TextYAlignment = Enum.TextYAlignment.Center
    title.ZIndex = 6
    new("Frame", {
        Size = UDim2.new(1, -28, 0, 1), Position = UDim2.new(0, 17, 1, -2),
        BackgroundColor3 = Theme.White, BackgroundTransparency = 0.55, BorderSizePixel = 0, ZIndex = 6,
    }, header)

    -- minimize button (+ / - icon)
    local closeBtn = new("TextButton", {
        Size = UDim2.fromOffset(32, 32), Position = UDim2.new(1, -40, 0.5, -16),
        BackgroundColor3 = Theme.Card, BorderSizePixel = 0, Text = "", AutoButtonColor = false, ZIndex = 7,
    }, header)
    corner(closeBtn, 7)
    stroke(closeBtn, Theme.Border, 1)
    local hbar = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(10, 2),
        Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = Theme.White, BorderSizePixel = 0, ZIndex = 8,
    }, closeBtn)
    corner(hbar, 1)
    local vbar = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(2, 0),
        Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = Theme.White, BorderSizePixel = 0, ZIndex = 8,
    }, closeBtn)
    corner(vbar, 1)

    -- tabs
    local tabBar = new("Frame", {
        Name = "TabsBackdrop", Size = UDim2.new(1, 0, 0, tabH), Position = UDim2.new(0, 0, 0, headerH + 4),
        BackgroundColor3 = Color3.fromRGB(6, 6, 12), BorderSizePixel = 0, ClipsDescendants = true, ZIndex = 4,
    }, win)
    local pages = new("Frame", {
        Name = "Pages", Size = UDim2.new(1, 0, 1, -(headerH + tabH + 22)),
        Position = UDim2.new(0, 0, 0, headerH + tabH + 4), BackgroundTransparency = 1, ClipsDescendants = true,
    }, win)
    local footer
    if opts.Footer then
        footer = label(win, opts.Footer, 8, Theme.White, Enum.Font.GothamBold)
        footer.Size = UDim2.new(1, 0, 0, 14)
        footer.Position = UDim2.new(0, 0, 1, -16)
        footer.TextXAlignment = Enum.TextXAlignment.Center
        footer.ZIndex = 4
    end

    -- dragging
    do
        local dragging, startPos, startFrame = false, nil, nil
        header.InputBegan:Connect(function(i)
            if isPress(i) then
                dragging, startPos, startFrame = true, i.Position, win.Position
            end
        end)
        header.InputEnded:Connect(function(i)
            if isPress(i) then dragging = false end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                local d = i.Position - startPos
                win.Position = UDim2.new(startFrame.X.Scale, startFrame.X.Offset + d.X, startFrame.Y.Scale, startFrame.Y.Offset + d.Y)
            end
        end)
    end

    -- minimize
    local minimized, busy = false, false
    closeBtn.MouseButton1Click:Connect(function()
        if busy then return end
        busy = true
        minimized = not minimized
        if minimized then
            pages.Visible, tabBar.Visible = false, false
            if footer then footer.Visible = false end
            tween(vbar, TI2, { Size = UDim2.fromOffset(2, 10) })
            local t = TweenService:Create(win, TI2, { Size = UDim2.fromOffset(size.X, headerH) })
            t:Play()
            t.Completed:Connect(function() busy = false end)
        else
            tween(vbar, TI2, { Size = UDim2.fromOffset(2, 0) })
            local t = TweenService:Create(win, TI2, { Size = UDim2.fromOffset(size.X, size.Y) })
            t:Play()
            t.Completed:Connect(function()
                pages.Visible, tabBar.Visible = true, true
                if footer then footer.Visible = true end
                busy = false
            end)
        end
    end)

    -- config
    local function collect()
        local out = {}
        for k, v in pairs(Library.Flags) do
            local t = typeof(v)
            if t == "boolean" or t == "number" or t == "string" then out[k] = v end
        end
        return out
    end
    function Window:SaveConfig()
        if not self.Config or type(writefile) ~= "function" then return end
        pcall(function() writefile(self.Config, HttpService:JSONEncode(collect())) end)
    end
    function Window:LoadConfig()
        if not self.Config or type(isfile) ~= "function" or not isfile(self.Config) then return end
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(self.Config)) end)
        if not ok or type(data) ~= "table" then return end
        for flag, value in pairs(data) do
            local setter = self.Setters[flag]
            if setter then pcall(setter, value) end
        end
    end
    local function changed(flag, value)
        if flag then
            Library.Flags[flag] = value
            Window:SaveConfig()
        end
    end

    -- misc API
    function Window:SetScale(s)
        baseScale = math.clamp(s, 0.5, 1.5)
        uiScale.Scale = baseScale
    end
    function Window:SetBackground(img)
        bg.Image = img or ""
        bg.Visible = img ~= nil and img ~= ""
    end
    function Window:SetSnow(v) snow.Visible = v and true or false end
    function Window:Toggle(v)
        if v == nil then v = not gui.Enabled end
        gui.Enabled = v
        if v then
            uiScale.Scale = math.max(0.05, baseScale * 0.6)
            tween(uiScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = baseScale })
        end
    end
    function Window:Destroy()
        gui:Destroy()
    end
    function Window:SetToggleKey(keycode)
        if self._toggleConn then self._toggleConn:Disconnect() end
        self._toggleConn = UserInputService.InputBegan:Connect(function(i, gp)
            if not gp and i.KeyCode == keycode then Window:Toggle() end
        end)
    end

    -- notifications
    local current
    function Window:Notify(n)
        n = n or {}
        if current then current:Destroy() current = nil end
        local f = new("Frame", {
            Size = UDim2.fromOffset(isMobile and 270 or 340, 58), AnchorPoint = Vector2.new(0.5, 0),
            Position = UDim2.new(0.5, 0, 0, -80), BackgroundColor3 = Color3.fromRGB(10, 10, 12),
            BorderSizePixel = 0, ZIndex = 100,
        }, gui)
        corner(f, 12)
        stroke(f, Theme.White, 1, 0.7)
        local t = label(f, tostring(n.Title or ""), 12, Theme.White, Enum.Font.GothamBlack)
        t.Size = UDim2.new(1, -24, 0, 18)
        t.Position = UDim2.fromOffset(12, 8)
        t.ZIndex = 101
        local d = label(f, tostring(n.Text or ""), 11, Theme.Dim, Enum.Font.Gotham)
        d.Size = UDim2.new(1, -24, 0, 28)
        d.Position = UDim2.fromOffset(12, 26)
        d.TextWrapped = true
        d.TextYAlignment = Enum.TextYAlignment.Top
        d.ZIndex = 101
        current = f
        tween(f, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, 0, 0, 14) })
        task.delay(n.Duration or 4, function()
            if current ~= f or not f.Parent then return end
            local tw = TweenService:Create(f, TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.new(0.5, 0, 0, -80) })
            tw:Play()
            tw.Completed:Connect(function()
                if current == f then current = nil end
                f:Destroy()
            end)
        end)
    end

    ----------------------------------------------------------------
    -- Tabs
    ----------------------------------------------------------------
    local activeTab
    local function relayoutTabs()
        for i, tab in ipairs(Window.Tabs) do
            tab.Button.Size = UDim2.new(1 / #Window.Tabs, 0, 1, 0)
            tab.Divider.Visible = i > 1
        end
    end
    local function selectTab(tab)
        if activeTab == tab then return end
        for _, t in ipairs(Window.Tabs) do
            local on = t == tab
            t.Page.Visible = on
            tween(t.Button, TI, { BackgroundColor3 = on and Color3.fromRGB(18, 18, 24) or Color3.fromRGB(8, 8, 11) })
            tween(t.Label, TI, { TextColor3 = on and Theme.White or Color3.fromRGB(132, 136, 144) })
        end
        activeTab = tab
    end

    local tabLayout = new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder,
        VerticalAlignment = Enum.VerticalAlignment.Center,
    }, tabBar)

    function Window:AddTab(name)
        local Tab = { Name = name }
        local btn = new("TextButton", {
            Name = name, LayoutOrder = #Window.Tabs + 1, Size = UDim2.new(1, 0, 1, 0),
            BackgroundColor3 = Color3.fromRGB(8, 8, 11), BorderSizePixel = 0, Text = "",
            AutoButtonColor = false, ZIndex = 5,
        }, tabBar)
        local div = new("Frame", {
            Size = UDim2.new(0, 1, 1, -10), Position = UDim2.new(0, 0, 0, 5),
            BackgroundColor3 = Color3.fromRGB(88, 90, 98), BackgroundTransparency = 0.55,
            BorderSizePixel = 0, ZIndex = 6,
        }, btn)
        local lbl = label(btn, name, isMobile and 9 or 10, Color3.fromRGB(132, 136, 144), Enum.Font.GothamBold)
        lbl.Size = UDim2.fromScale(1, 1)
        lbl.TextXAlignment = Enum.TextXAlignment.Center
        lbl.ZIndex = 6

        local page = new("ScrollingFrame", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
            ScrollBarThickness = 3, ScrollBarImageColor3 = Color3.fromRGB(150, 75, 150),
            AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
            ScrollingDirection = Enum.ScrollingDirection.Y, Visible = false,
        }, pages)
        new("UIListLayout", {
            HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 6),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, page)
        new("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, page)

        Tab.Button, Tab.Label, Tab.Page, Tab.Divider = btn, lbl, page, div
        table.insert(Window.Tabs, Tab)
        relayoutTabs()
        btn.MouseButton1Click:Connect(function() selectTab(Tab) end)
        if #Window.Tabs == 1 then selectTab(Tab) end

        local order = 0
        local function card(height)
            order += 1
            local f = new("Frame", {
                Size = UDim2.new(1, -12, 0, height or 40), BackgroundColor3 = Theme.Card,
                BorderSizePixel = 0, LayoutOrder = order,
            }, page)
            corner(f, 10)
            return f
        end

        local function hover(btn2, strokeObj)
            btn2.MouseEnter:Connect(function()
                tween(btn2, TI, { BackgroundColor3 = Theme.CardHover })
                if strokeObj then tween(strokeObj, TI, { Color = Theme.BorderHover or Color3.fromRGB(165, 175, 180) }) end
            end)
            btn2.MouseLeave:Connect(function()
                tween(btn2, TI, { BackgroundColor3 = Theme.Card })
                if strokeObj then tween(strokeObj, TI, { Color = Theme.Border }) end
            end)
        end

        function Tab:AddSection(text)
            order += 1
            local f = new("Frame", {
                Size = UDim2.new(1, -12, 0, 26), BackgroundTransparency = 1, LayoutOrder = order,
            }, page)
            new("Frame", {
                Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 0.5, 0),
                BackgroundColor3 = Theme.Border, BorderSizePixel = 0,
            }, f)
            local tag = new("Frame", {
                Size = UDim2.fromOffset(#text * 7 + 18, 18), Position = UDim2.new(0, 10, 0.5, -9),
                BackgroundColor3 = Theme.BG, BorderSizePixel = 0, ZIndex = 2,
            }, f)
            corner(tag, 6)
            local l = label(tag, text, 10, Theme.Dim, Enum.Font.GothamBold)
            l.Size = UDim2.fromScale(1, 1)
            l.TextXAlignment = Enum.TextXAlignment.Center
            l.ZIndex = 3
            return f
        end

        function Tab:AddLabel(text)
            local f = card(36)
            local l = label(f, text, 11, Theme.Dim, Enum.Font.Gotham)
            l.Size = UDim2.new(1, -24, 1, 0)
            l.Position = UDim2.fromOffset(12, 0)
            l.TextWrapped = true
            return { Set = function(_, t) l.Text = t end }
        end

        function Tab:AddToggle(o)
            local state = o.Default and true or false
            local f = card(42)
            local l = label(f, o.Name or "Toggle", isMobile and 10 or 11)
            l.Size = UDim2.new(1, -78, 1, 0)
            l.Position = UDim2.fromOffset(16, 0)
            l.TextYAlignment = Enum.TextYAlignment.Center
            local track = new("Frame", {
                Size = UDim2.fromOffset(44, 24), Position = UDim2.new(1, -56, 0.5, -12), BorderSizePixel = 0,
            }, f)
            corner(track, 12)
            local knob = new("Frame", { Size = UDim2.fromOffset(18, 18), BorderSizePixel = 0 }, track)
            corner(knob, 9)
            local click = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 4 }, f)

            local obj = {}
            local function render(anim)
                local a = { BackgroundColor3 = state and Theme.White or Theme.TrackOff }
                local b = {
                    Position = state and UDim2.fromOffset(23, 3) or UDim2.fromOffset(3, 3),
                    BackgroundColor3 = state and Theme.BG or Theme.KnobOff,
                }
                if anim then tween(track, TI, a) tween(knob, TI, b)
                else for k, v in pairs(a) do track[k] = v end for k, v in pairs(b) do knob[k] = v end end
            end
            function obj:Set(v, silent)
                state = v and true or false
                render(true)
                changed(o.Flag, state)
                if not silent and o.Callback then task.spawn(o.Callback, state) end
            end
            function obj:Get() return state end
            render(false)
            changed(o.Flag, state)
            if o.Flag then Window.Setters[o.Flag] = function(v) obj:Set(v) end end
            click.MouseButton1Click:Connect(function() obj:Set(not state) end)
            return obj
        end

        function Tab:AddButton(o)
            local f = card(38)
            local b = new("TextButton", {
                Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Card, BorderSizePixel = 0,
                Text = o.Name or "Button", TextSize = isMobile and 10 or 11, TextColor3 = Theme.White,
                Font = Enum.Font.GothamBold, AutoButtonColor = false,
            }, f)
            corner(b, 10)
            local s = stroke(b, Theme.Border, 1, 0.3)
            hover(b, s)
            local sc = new("UIScale", {}, b)
            b.MouseButton1Down:Connect(function() tween(sc, TweenInfo.new(0.07), { Scale = 0.95 }) end)
            b.MouseButton1Up:Connect(function() tween(sc, TweenInfo.new(0.18, Enum.EasingStyle.Back), { Scale = 1 }) end)
            b.MouseButton1Click:Connect(function()
                if o.Callback then task.spawn(o.Callback) end
            end)
            return { SetText = function(_, t) b.Text = t end }
        end

        function Tab:AddSlider(o)
            local min, max, inc = o.Min or 0, o.Max or 100, o.Increment or 1
            local value = math.clamp(o.Default or min, min, max)
            local f = card(58)
            local l = label(f, o.Name or "Slider", isMobile and 10 or 11)
            l.Size = UDim2.new(0.6, 0, 0, 24)
            l.Position = UDim2.fromOffset(16, 3)
            l.TextYAlignment = Enum.TextYAlignment.Center
            local vl = label(f, "", 10, Theme.Dim, Enum.Font.GothamSemibold)
            vl.Size = UDim2.new(0.4, -16, 0, 24)
            vl.Position = UDim2.new(0.6, 0, 0, 3)
            vl.TextXAlignment = Enum.TextXAlignment.Right
            vl.TextYAlignment = Enum.TextYAlignment.Center
            local bar = new("TextButton", {
                Size = UDim2.new(1, -32, 0, 8), Position = UDim2.fromOffset(16, 36),
                BackgroundColor3 = Color3.fromRGB(43, 44, 51), BorderSizePixel = 0, Text = "", AutoButtonColor = false,
            }, f)
            corner(bar, 4)
            local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.White, BorderSizePixel = 0 }, bar)
            corner(fill, 4)
            local knob = new("Frame", {
                Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = Theme.White, BorderSizePixel = 0, ZIndex = 3,
            }, bar)
            corner(knob, 7)

            local obj = {}
            local function render()
                local a = (value - min) / (max - min)
                fill.Size = UDim2.fromScale(a, 1)
                knob.Position = UDim2.new(a, 0, 0.5, 0)
                vl.Text = tostring(value) .. (o.Suffix or "")
            end
            function obj:Set(v, silent)
                v = math.clamp(math.floor(((tonumber(v) or min) - min) / inc + 0.5) * inc + min, min, max)
                v = tonumber(string.format("%.4f", v))
                if v == value and not silent then return end
                value = v
                render()
                changed(o.Flag, value)
                if not silent and o.Callback then task.spawn(o.Callback, value) end
            end
            function obj:Get() return value end
            render()
            changed(o.Flag, value)
            if o.Flag then Window.Setters[o.Flag] = function(v) obj:Set(v) end end

            local dragging = false
            local function update(input)
                local w = bar.AbsoluteSize.X
                if w <= 0 then return end
                obj:Set(min + (max - min) * math.clamp((input.Position.X - bar.AbsolutePosition.X) / w, 0, 1))
            end
            bar.InputBegan:Connect(function(i) if isPress(i) then dragging = true update(i) end end)
            UserInputService.InputChanged:Connect(function(i)
                if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then update(i) end
            end)
            UserInputService.InputEnded:Connect(function(i) if dragging and isPress(i) then dragging = false end end)
            return obj
        end

        function Tab:AddChoice(o)
            local options = o.Options or {}
            local idx = table.find(options, o.Default) or 1
            local f = card(42)
            local l = label(f, o.Name or "Choice", isMobile and 9 or 11)
            l.Size = UDim2.new(1, -(isMobile and 176 or 196), 1, 0)
            l.Position = UDim2.fromOffset(12, 0)
            l.TextYAlignment = Enum.TextYAlignment.Center
            local bw, vw = isMobile and 28 or 32, isMobile and 86 or 96
            local function mk(text, x)
                local b = new("TextButton", {
                    Size = UDim2.fromOffset(bw, 28), Position = x, BackgroundColor3 = Color3.fromRGB(8, 8, 12),
                    BorderSizePixel = 0, Text = text, TextColor3 = Theme.White, TextSize = 12,
                    Font = Enum.Font.GothamSemibold, AutoButtonColor = false,
                }, f)
                corner(b, 6)
                stroke(b, Color3.fromRGB(72, 74, 84), 1, 0.35)
                return b
            end
            local left = mk("<", UDim2.new(1, -(bw * 2 + vw + 20), 0.5, -14))
            local right = mk(">", UDim2.new(1, -(bw + 8), 0.5, -14))
            local holder = new("Frame", {
                Size = UDim2.fromOffset(vw, 28), Position = UDim2.new(1, -(vw + bw + 15), 0.5, -14),
                BackgroundColor3 = Color3.fromRGB(8, 8, 12), BorderSizePixel = 0,
            }, f)
            corner(holder, 6)
            stroke(holder, Color3.fromRGB(72, 74, 84), 1, 0.35)
            local vl = label(holder, "", 9, Theme.White, Enum.Font.GothamSemibold)
            vl.Size = UDim2.fromScale(1, 1)
            vl.TextXAlignment = Enum.TextXAlignment.Center

            local obj = {}
            local function render() vl.Text = tostring(options[idx] or "-") end
            function obj:Set(v, silent)
                local i = type(v) == "number" and v or table.find(options, v)
                if not i then return end
                idx = ((i - 1) % #options) + 1
                render()
                changed(o.Flag, options[idx])
                if not silent and o.Callback then task.spawn(o.Callback, options[idx]) end
            end
            function obj:Get() return options[idx] end
            function obj:SetOptions(list) options = list idx = 1 render() end
            render()
            changed(o.Flag, options[idx])
            if o.Flag then Window.Setters[o.Flag] = function(v) obj:Set(v) end end
            left.MouseButton1Click:Connect(function() obj:Set(idx - 1) end)
            right.MouseButton1Click:Connect(function() obj:Set(idx + 1) end)
            return obj
        end

        function Tab:AddKeybind(o)
            local key = o.Default or ""
            local f = card(42)
            local l = label(f, o.Name or "Keybind", isMobile and 10 or 11)
            l.Size = UDim2.new(1, -110, 1, 0)
            l.Position = UDim2.fromOffset(16, 0)
            l.TextYAlignment = Enum.TextYAlignment.Center
            local b = new("TextButton", {
                Size = UDim2.fromOffset(80, 26), Position = UDim2.new(1, -92, 0.5, -13),
                BackgroundColor3 = Color3.fromRGB(18, 18, 22), BorderSizePixel = 0, Text = "",
                TextSize = 10, TextColor3 = Theme.White, Font = Enum.Font.GothamBold, AutoButtonColor = false,
            }, f)
            corner(b, 7)
            stroke(b, Color3.fromRGB(72, 74, 84), 1, 0)
            local listening = false
            local obj = {}
            local function render()
                b.Text = listening and "..." or (key ~= "" and string.upper(key) or "NONE")
                b.TextColor3 = listening and Theme.Good or Theme.White
            end
            function obj:Set(k) key = k or "" listening = false render() changed(o.Flag, key) end
            function obj:Get() return key end
            render()
            changed(o.Flag, key)
            if o.Flag then Window.Setters[o.Flag] = function(v) obj:Set(v) end end
            b.MouseButton1Click:Connect(function() listening = true render() end)
            UserInputService.InputBegan:Connect(function(i, gp)
                if listening then
                    if i.UserInputType ~= Enum.UserInputType.Keyboard then return end
                    if i.KeyCode == Enum.KeyCode.Escape then listening = false render()
                    elseif i.KeyCode == Enum.KeyCode.Backspace or i.KeyCode == Enum.KeyCode.Delete then obj:Set("")
                    else obj:Set(i.KeyCode.Name) end
                    return
                end
                if gp or key == "" or UserInputService:GetFocusedTextBox() then return end
                if i.KeyCode.Name == key and o.Callback then task.spawn(o.Callback, key) end
            end)
            return obj
        end

        function Tab:AddTextbox(o)
            local f = card(42)
            local l = label(f, o.Name or "Textbox", isMobile and 10 or 11)
            l.Size = UDim2.new(0.4, -10, 1, 0)
            l.Position = UDim2.fromOffset(16, 0)
            l.TextYAlignment = Enum.TextYAlignment.Center
            local tb = new("TextBox", {
                Size = UDim2.new(0.6, -24, 0, 26), Position = UDim2.new(0.4, 4, 0.5, -13),
                BackgroundColor3 = Theme.Field, BorderSizePixel = 0, ClearTextOnFocus = false,
                PlaceholderText = o.Placeholder or "", PlaceholderColor3 = Color3.fromRGB(108, 110, 120),
                Text = o.Default or "", TextColor3 = Theme.White, TextSize = 10, Font = Enum.Font.GothamMedium,
                TextXAlignment = Enum.TextXAlignment.Left,
            }, f)
            corner(tb, 6)
            stroke(tb, Color3.fromRGB(66, 68, 78), 1, 0.25)
            new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 6) }, tb)
            local obj = {}
            function obj:Set(t, silent)
                tb.Text = tostring(t)
                changed(o.Flag, tb.Text)
                if not silent and o.Callback then task.spawn(o.Callback, tb.Text) end
            end
            function obj:Get() return tb.Text end
            changed(o.Flag, tb.Text)
            if o.Flag then Window.Setters[o.Flag] = function(v) obj:Set(v) end end
            tb.FocusLost:Connect(function() obj:Set(tb.Text) end)
            return obj
        end

        return Tab
    end

    -- click "pop" animation on every button (like the original)
    gui.DescendantAdded:Connect(function(d)
        if d:IsA("GuiButton") and not d:FindFirstChildOfClass("UIScale") then
            local sc = new("UIScale", { Name = "ClickScale" }, d)
            d.Activated:Connect(function()
                tween(sc, TweenInfo.new(0.07), { Scale = 0.94 })
                task.delay(0.07, function()
                    if sc.Parent then tween(sc, TweenInfo.new(0.18, Enum.EasingStyle.Back), { Scale = 1 }) end
                end)
            end)
        end
    end)

    -- open animation
    uiScale.Scale = math.max(0.05, baseScale * 0.6)
    tween(uiScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = baseScale })

    table.insert(Library.Windows, Window)
    return Window
end

function Library:Unload()
    for _, w in ipairs(self.Windows) do
        pcall(function() w:Destroy() end)
    end
    self.Windows = {}
end

return Library
