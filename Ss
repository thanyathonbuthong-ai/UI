	size = _clamp(tonumber(size) or TOGGLE_BUTTON_SIZE, 30, 90)

	runtime._toggle_button.Size = _new_udim2(0, size, 0, size)
	runtime._toggle_settings.button_size = size
	runtime:_layout_toggle_icon(runtime._toggle_icon.Image == DEFAULT_TOGGLE_ICON)
	runtime:_clamp_toggle_now()
	runtime._toggle_size_token += 1

