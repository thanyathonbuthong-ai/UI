function library._layout_title(self: runtime_typeof)
	local runtime = resolve_runtime(self)

	if not runtime or not runtime._title_label or not runtime._title_icon then
		return
	end

	local icon = runtime._title_icon
	local label = runtime._title_label
	local name = runtime._ui_name or DEFAULT_UI_NAME
	local size = _clamp(tonumber(runtime._toggle_settings.ui_icon_size) or 22, 14, 34)
	local x = 20

	icon.Size = _new_udim2(0, size, 0, size)

	icon.Position = _new_udim2(0, 20, 0.5, 0)
	label.Visible = true
	label.Text = name
	label.TextXAlignment = Enum.TextXAlignment.Left

	if icon.Visible then
		x += size + 8
	end

	runtime._title_label.Position = _new_udim2(0, x, 0, 0)
	runtime._title_label.Size = _new_udim2(1, -(x + 10), 1, 0)
end

-- ui:set_ui_icon(123456) / ('rbxassetid://123') / ('https://site/img.png') / ('file.png') / (nil = remove)
function library.set_ui_icon(self: runtime_typeof, icon, silent)
	local runtime = resolve_runtime(self)

	if not runtime or not runtime._title_icon then
		return false
	end

	local raw = icon ~= nil and _tostring(icon):gsub('^%s+', ''):gsub('%s+$', '') or ''

	if raw == '' then
		runtime._title_icon.Visible = false
		runtime._title_icon.Image = ''
		runtime._toggle_settings.ui_icon = nil
		runtime:_layout_title()

		if not silent then
			runtime:_save_toggle_settings()
		end

		return true
	end

	local image, reason = resolve_toggle_icon(icon)

	if not image then
		if not silent then
			runtime:notify(`icon: {reason}`)
		end

		return false
	end

	runtime._title_icon.Image = image
	runtime._title_icon.Visible = true
	runtime._toggle_settings.ui_icon = raw
	runtime:_layout_title()

	if not silent then
		runtime:_save_toggle_settings()
	end

	return true
end

function library.set_ui_icon_size(self: runtime_typeof, size)
	local runtime = resolve_runtime(self)

	if not runtime or not runtime._title_icon then
		return
	end

	runtime._toggle_settings.ui_icon_size = _clamp(tonumber(size) or 22, 14, 34)
	runtime:_layout_title()
	runtime._toggle_size_token += 1

	local token = runtime._toggle_size_token

	_delay(0.5, function()
		if runtime._toggle_size_token == token then
			runtime:_save_toggle_settings()
		end
	end)
end

-- ui:set_background(123456, 0.5) / ('rbxassetid://123') / ('https://site/img.png') / ('file.png') / (nil = remove)
function library.set_background(self: runtime_typeof, image, transparency, silent)
	local runtime = resolve_runtime(self)

	if not runtime or not runtime._background then
		return false
	end

	local raw = image ~= nil and _tostring(image):gsub('^%s+', ''):gsub('%s+$', '') or ''

	if raw == '' then
		runtime._background.Visible = false
		runtime._background.Image = ''
		runtime._toggle_settings.background = nil
		runtime:_save_toggle_settings()

		return true
	end

	-- a background image can NOT be set while a theme is active (switch the theme back to 'Dark' first)
	if theme_name ~= 'Dark' then
		if not silent then
			runtime:notify('Set the theme to Dark first to use a background image')
		end

		return false, 'theme active'
	end

	local resolved, reason = resolve_toggle_icon(image)

	if not resolved then
		if not silent then
			runtime:notify(`background: {reason}`)
		end

		return false
	end

	runtime._background.Image = resolved
	runtime._background.Visible = true

	if tonumber(transparency) then
		runtime._background.ImageTransparency = _clamp(tonumber(transparency), 0, 1)
		runtime._toggle_settings.background_transparency = runtime._background.ImageTransparency
	end

	runtime._toggle_settings.background = raw
	runtime:_save_toggle_settings()

	return true
end

function library.set_background_transparency(self: runtime_typeof, transparency)
	local runtime = resolve_runtime(self)

	if not runtime or not runtime._background then
		return false
	end

	runtime._background.ImageTransparency = _clamp(tonumber(transparency) or 0.5, 0, 1)
	runtime._toggle_settings.background_transparency = runtime._background.ImageTransparency
	runtime:_save_toggle_settings()

	return true
end

-- custom gradient background (WindUI style), keeps the colors of the current theme
--   ui:set_gradient({ ['0'] = { Color = Color3.fromHex('#ff0080') }, ['100'] = { Color = Color3.fromHex('#00d4ff') } }, { Rotation = 45, Animate = true, Speed = 30 })
--   ui:set_gradient(ui:gradient({...}, {...}))  /  ui:set_gradient(nil) = remove the gradient
-- refused while a background image is active
function library.set_gradient(self, stops, options)
	if not (self == library or (_type(self) == 'table' and self._tabs ~= nil)) then
		options = stops
		stops = self
		self = nil
	end

	local runtime = resolve_runtime(self)

	if not runtime then
		return false, 'no window'
	end

	local current = theme_registry[theme_name]

	-- remembers the last normal theme so removing the gradient can go back to it
	if theme_name ~= 'Custom Gradient' and theme_name ~= '__preview' and not (current and current.BackgroundGradient) then
		theme_gradient.base = theme_name
	end

	if stops == nil then
		local target = theme_gradient.base

		if not target or not theme_registry[target] or theme_registry[target].BackgroundGradient then
			target = 'Dark'
		end

		return library.set_theme(runtime, target)
	end

	if runtime._toggle_settings and runtime._toggle_settings.background then
		runtime:notify('Remove the background image first to use a gradient')

		return false, 'background active'
	end

	local gradient = (_type(stops) == 'table' and stops._gradient) and stops or library.gradient(stops, options)

	if not gradient or not gradient.stops or #gradient.stops == 0 then
		return false, 'invalid gradient'
	end

	local def = shallow_copy_theme(current)

	def.Name = 'Custom Gradient'
	def.Legacy = false
	def.Hidden = false
	def.Save = true
	def.BackgroundGradient = gradient

	theme_register(def, true)

	return library.set_theme(runtime, 'Custom Gradient')
end

library.SetGradient = library.set_gradient

-- ui:set_ui_name('My Hub') / ui:set_ui_name(nil) to reset
function library.set_ui_name(self: runtime_typeof, name, silent)
	local runtime = resolve_runtime(self)

	if not runtime or not runtime._title_label then
		return false
	end

	local text = _tostring(name or ''):gsub('[\r\n]+', ' '):gsub('^%s+', ''):gsub('%s+$', '')

	text = text:sub(1, MAX_UI_NAME_LENGTH)

	if text == '' then
		text = DEFAULT_UI_NAME
	end

	runtime._title_label.Text = text
	runtime._ui_name = text
	runtime._toggle_settings.ui_name = text ~= DEFAULT_UI_NAME and text or nil
	runtime:_layout_title()

	if not silent then
		runtime:_save_toggle_settings()
	end

	return true
end

function library._find_category(self: runtime_typeof, name: string)
	local runtime = resolve_runtime(self)

	if not runtime then
		return nil
	end

	local matches = runtime._category_registry[normalize_name(name)]

	return matches and matches[1] or nil
end

function library._find_tab(self: runtime_typeof, name: string, category_name: string?)
	local runtime = resolve_runtime(self)

	if not runtime then
		return nil
	end

	local matches = runtime._tab_registry[normalize_name(name)]

	if not matches then
		return nil
	end

	if category_name then
		local normalized_category = normalize_name(category_name)

		for _, tab_manager in matches do
			if normalize_name(tab_manager._category) == normalized_category then
				return tab_manager
			end
		end

		return nil
	end

	return matches[1]
end

function library._find_group(self: runtime_typeof, tab_manager: any, name: string, side: string?)
	if not tab_manager then
		return nil
	end

	local matches = tab_manager._group_registry[normalize_name(name)]

	if not matches then
		return nil
	end

	if side then
		for _, group_manager in matches do
			if group_manager._side == normalize_name(side) then
				return group_manager
			end
		end

		return nil
	end

	if #matches == 1 then
		return matches[1]
	end

	return nil
end

