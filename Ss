	-- shrinks the sidebar (and grows main_content into the freed space) down to icon-only width, and shrinks each tab button to match. the sidebar clips its own contents, so the UI title can never spill into main_content.
	local apply_compact_layout = function(state, instant)
		local layout_info = _new_tween_info(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		local sidebar_width = state and SIDEBAR_COMPACT_WIDTH or SIDEBAR_WIDTH

		if instant then
			sidebar.Size = _new_udim2(0, sidebar_width, 1, 0)
			main_content.Position = _new_udim2(0, sidebar_width, 0, 0)
			main_content.Size = _new_udim2(0, 600 - sidebar_width, 1, 0)
		else
			_create_tween(tween_service, sidebar, layout_info, {
				Size = _new_udim2(0, sidebar_width, 1, 0),
			}):Play()

			_create_tween(tween_service, main_content, layout_info, {
				Position = _new_udim2(0, sidebar_width, 0, 0),
				Size = _new_udim2(0, 600 - sidebar_width, 1, 0),
			}):Play()
		end

		for _, tab_data in self._tabs do
			local tab_label = tab_data._btn:FindFirstChildWhichIsA('TextLabel')
			local rest_transparency = tab_data._enabled and 0 or 0.65
			local button_size = state and _new_udim2(0, TAB_COMPACT_WIDTH, 0, 32) or _new_udim2(1, 0, 0, 32)

			if instant then
				tab_data._btn.Size = button_size
			else
				_create_tween(tween_service, tab_data._btn, layout_info, { Size = button_size }):Play()
			end

			if tab_label then
				if state then
					if instant then
						tab_label.Visible = false
					else
						_create_tween(tween_service, tab_label, layout_info, { TextTransparency = 1 }):Play()

						_delay(0.3, function()
							if self._tabs_compact then
								tab_label.Visible = false
							end
						end)
					end
				else
					tab_label.Visible = true

					if instant then
						tab_label.TextTransparency = rest_transparency
					else
						tab_label.TextTransparency = 1

						_create_tween(tween_service, tab_label, layout_info, {
							TextTransparency = rest_transparency,
						}):Play()
					end
				end
			end
		end

		if self._apply_scale then
			_defer(self._apply_scale)
			_delay(0.35, self._apply_scale)
		end
	end

	function self:set_compact_tabs(state)
