	local tag_icon = create_new('ImageLabel', {
		BackgroundTransparency = 1,
		LayoutOrder = 0,
		Size = _new_udim2(0, 12, 0, 12),
		Image = _tostring(icon_value or ''),
		Visible = icon_value ~= nil and icon_value ~= '',
		ZIndex = 8,
		Parent = tag,
