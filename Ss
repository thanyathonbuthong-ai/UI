				end

				local has_icon = icon_value ~= nil and icon_value ~= ''
				local text_left = has_icon and 32 or 10

				option_height[object] = row_height

				local option_button = create_new('TextButton', {
					BackgroundTransparency = 1,
					LayoutOrder = #dropdown_manager._options * 2,
					Size = _new_udim2(1, 0, 0, row_height),
					Text = '',
					Visible = (not hide_selected_option or object ~= default) and matches_search(object),
					AutoButtonColor = false,
					Parent = options_list,
