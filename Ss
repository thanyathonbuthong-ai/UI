-- registers a cleanup callback that runs when the script is unloaded: ui:on_unload(function() ... end)
function library.on_unload(self: runtime_typeof, callback)
	if _type(callback) == 'function' then
		_insert(lua_unload_hooks, callback)
	end
end

-- shuts everything down: turns every toggle off, runs cleanup hooks, disconnects all
-- connections, cancels threads started by loaded Luas and destroys the whole interface
function library.unload(self: runtime_typeof)
	local runtime = resolve_runtime(self)

	if not runtime or runtime._unloaded then
		return false
	end

	runtime._unloaded = true

	-- stop config writes so switching features off is not saved as the new state
	runtime._save = function()
		return true
	end

	for _, disable in runtime._toggle_disablers do
		_pcall(disable)
	end

	for _, hook in lua_unload_hooks do
		_pcall(hook)
	end

	_clear(lua_unload_hooks)

	if runtime._stop_toggle_step then
		_pcall(runtime._stop_toggle_step)
	end

	for _, connection in tracked_connections do
		_pcall(function()
			connection:Disconnect()
		end)
	end

	_clear(tracked_connections)

	local current_thread = coroutine.running()

	for _, thread in lua_threads do
		if thread ~= current_thread then
			_pcall(task.cancel, thread)
		end
	end

	_clear(lua_threads)

	if runtime._ui then
		runtime._ui:Destroy()
	end

	runtime._active_tab = nil
	runtime._toggle_button = nil

	if library._current == runtime then
		library._current = nil
	end

	return true
end

-- places the title icon at the top-left and pushes the name to the right of it when an icon is set
-- window size in pixels: narrower with icon-only tabs, title-bar high when collapsed
function library._window_size(self: runtime_typeof)
	local runtime = resolve_runtime(self)

	return 600, runtime._collapsed and 48 or 400
