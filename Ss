				TextColor3 = Color3.fromRGB(255, 255, 255),
				TextSize = runtime._label_text_size + 1,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Parent = header,
			})

			local arrow = create_new('ImageLabel', {
				BackgroundTransparency = 1,
				AnchorPoint = _new_vector2(1, 0.5),
				Position = _new_udim2(1, 0, 0.5, 0),
				Size = _new_udim2(0, 14, 0, 14),
				Image = 'rbxassetid://10734899821',
				ImageColor3 = Color3.fromRGB(180, 180, 180),
				Rotation = opened and 0 or -90,
				Parent = header,
			})

			if _values.desc ~= nil and _values.desc ~= '' then
				create_label({
					LayoutOrder = 1,
					Size = _new_udim2(1, 0, 0, runtime._small_text_size + 3),
					AutomaticSize = Enum.AutomaticSize.Y,
					Text = _tostring(_values.desc),
					TextColor3 = Color3.fromRGB(120, 120, 120),
					TextSize = runtime._small_text_size + 1,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextWrapped = true,
					Parent = box,
				})
			end

			local content = create_new('Frame', {
				BackgroundTransparency = 1,
				LayoutOrder = 2,
				AutomaticSize = Enum.AutomaticSize.Y,
				Size = _new_udim2(1, 0, 0, 0),
				Visible = opened,
				Parent = box,
			})

			create_vertical_list(content, 8)

			local box_manager = {}

			function box_manager:set_opened(state)
				opened = state == true
				content.Visible = opened

				_create_tween(tween_service, arrow, _new_tween_info(0.2), {
					Rotation = opened and 0 or -90,
				}):Play()
			end

			function box_manager:is_opened()
				return opened
			end

			header.MouseButton1Click:Connect(function()
				box_manager:set_opened(not opened)
			end)

			if _type(builder) == 'function' then
				local previous_frame = group_frame
				local previous_in_row = group_manager._in_row

				group_frame = content
				group_manager._in_row = false

				local ok, err = _pcall(builder, group_manager)

				group_frame = previous_frame
				group_manager._in_row = previous_in_row

				if not ok then
					warn('create_box_section: ' .. _tostring(err))
				end
			end

			return box_manager
		end

		-- toggle type = 'checkbox' (WindUI: Type = "Checkbox") + desc text under any element
		do
			local original_toggle = group_manager.create_toggle

			function group_manager:create_toggle(flag, _values)
				local values = _type(flag) == 'table' and flag or _values

				if _type(values) == 'table' and _type(values.type) == 'string' and values.type:lower() == 'checkbox' then
					return self:create_checkbox(flag, _values)
				end

				return original_toggle(self, flag, _values)
			end

			local function with_desc(name)
				local original = group_manager[name]

				if _type(original) ~= 'function' then
					return
				end

				group_manager[name] = function(self, flag, _values)
					local order_before = group_manager._order
					local manager = original(self, flag, _values)
					local values = _type(flag) == 'table' and flag or _values

					-- Wind UI locked_title: clicking a locked element shows a small notice
					if _type(values) == 'table' and values.locked_title ~= nil and values.locked_title ~= '' then
						local element = nil

						for _, child in group_frame:GetChildren() do
							if child:IsA('GuiObject') and child.LayoutOrder == order_before + 1 then
								element = child

								break
							end
						end

						if element then
							local is_locked = values.locked == true

							if _type(manager) == 'table' and _type(manager.set_locked) == 'function' then
								local original_set_locked = manager.set_locked

								manager.set_locked = function(target, state)
									is_locked = state == true

									return original_set_locked(target, state)
								end
							end

							element.InputBegan:Connect(function(input)
								if
									is_locked
									and (
										input.UserInputType == Enum.UserInputType.MouseButton1
										or input.UserInputType == Enum.UserInputType.Touch
									)
								then
									runtime:notify({ title = _tostring(values.locked_title), duration = 2 })
								end
							end)
						end
					end

					local text = _type(values) == 'table' and (values.desc or values.description) or nil

					if text == nil or text == '' or group_manager._in_row then
						return manager
					end

					manager = manager or {}

					if _type(manager) ~= 'table' or manager.set_desc then
						return manager
					end

					local desc_label = create_label({
						LayoutOrder = next_row_order(),
						Size = _new_udim2(1, 0, 0, runtime._small_text_size + 3),
						AutomaticSize = Enum.AutomaticSize.Y,
						Text = _tostring(text),
						TextColor3 = Color3.fromRGB(120, 120, 120),
						TextSize = runtime._small_text_size + 1,
						TextXAlignment = Enum.TextXAlignment.Left,
						TextWrapped = true,
						Parent = group_frame,
					})

					function manager:set_desc(value)
						desc_label.Text = _tostring(value or '')
						desc_label.Visible = value ~= nil and value ~= ''
					end

					return manager
				end
			end

			for _, name in { 'create_toggle', 'create_checkbox', 'create_slider', 'create_button', 'create_textbox', 'create_dropdown', 'create_keybind', 'create_colorpicker' } do
				with_desc(name)
			end

			-- Wind UI Element API on every element: destroy / set_visible / lock / unlock / set_title / get / set
			local function with_controls(name)
				local original = group_manager[name]

				if _type(original) ~= 'function' then
					return
				end

				group_manager[name] = function(self, flag, _values)
					local order_before = group_manager._order
					local host = group_frame
					local manager = original(self, flag, _values)

					if _type(manager) ~= 'table' or manager._controls then
						return manager
					end

					local order_after = group_manager._order
					local elements = {}

					for _, child in host:GetChildren() do
						if child:IsA('GuiObject') and child.LayoutOrder > order_before and child.LayoutOrder <= order_after then
							_insert(elements, child)
						end
					end

					if #elements == 0 then
						return manager
					end

					manager._controls = true
					manager._frame = elements[1]
					manager._elements = elements

					if not manager.destroy then
						function manager:destroy()
							for _, element in elements do
								element:Destroy()
							end
						end
					end

					if not manager.set_visible then
						function manager:set_visible(state)
							for _, element in elements do
								element.Visible = state == true
							end
						end
					end

					if not manager.is_visible then
						function manager:is_visible()
							return elements[1].Visible
						end
					end

					-- fallback lock for elements that have no lock of their own (dropdown, input, colorpicker...)
					if not manager.set_locked then
						local lock_cover = nil

						function manager:set_locked(state)
							state = state == true

							if state and not lock_cover then
								lock_cover = create_new('TextButton', {
									Name = '_lock_cover',
									BackgroundColor3 = Color3.fromRGB(18, 18, 18),
									BackgroundTransparency = 0.45,
									Size = _new_udim2(1, 0, 1, 0),
									Text = '',
									AutoButtonColor = false,
									BorderSizePixel = 0,
									ZIndex = 60,
									Parent = elements[1],
								})

								create_round(lock_cover, 6)
							end

							if lock_cover then
								lock_cover.Visible = state
							end
						end
					end

					if not manager.lock then
						function manager:lock()
							self:set_locked(true)
						end
					end

					if not manager.unlock then
						function manager:unlock()
							self:set_locked(false)
						end
					end

					if not manager.set_title then
						function manager:set_title(value)
							for _, descendant in elements[1]:GetDescendants() do
								if
									(descendant:IsA('TextLabel') or descendant:IsA('TextButton'))
									and descendant.Text ~= ''
									and descendant.Name ~= '_lock_cover'
								then
									descendant.Text = _tostring(value or '')

									break
								end
							end
						end
					end

					if not manager.get then
						function manager:get()
							if self.get_value then
								return self:get_value()
							elseif self.get_color then
								return self:get_color()
							end
						end
					end

					if not manager.set then
						function manager:set(...)
							if self.set_value then
								return self:set_value(...)
							elseif self.set_color then
								return self:set_color(...)
							end
						end
					end

					return manager
				end
			end

			for _, name in {
				'create_toggle', 'create_checkbox', 'create_slider', 'create_button', 'create_textbox',
				'create_dropdown', 'create_keybind', 'create_colorpicker', 'create_paragraph', 'create_code',
				'create_image', 'create_tag', 'create_video',
			} do
				with_controls(name)
			end
		end

		_insert(tab_manager._groups, group_manager)

		local group_name = normalize_name(group_values.title)
		tab_manager._group_registry[group_name] = tab_manager._group_registry[group_name] or {}
		_insert(tab_manager._group_registry[group_name], group_manager)

		return group_manager
	end

	local tab_name = normalize_name(title)
	self._tab_registry[tab_name] = self._tab_registry[tab_name] or {}
	_insert(self._tab_registry[tab_name], tab_manager)

	return tab_manager
end

function library.update_keybind_list(self: _runtime)
	if not self._keybind_list_content or not self._keybind_list_frame then
		return
	end

	for _, child in self._keybind_list_content:GetChildren() do
		if child:IsA('Frame') then
			child:Destroy()
		end
	end

	local has_any = false

	for _, entry in self._keybind_entries do
		if entry.key_name and entry.key_name ~= '' then
			has_any = true

			local row = create_new('Frame', {
				BackgroundTransparency = 1,
				Size = _new_udim2(1, 0, 0, 24),
				Parent = self._keybind_list_content,
			})

			local is_enabled = self._flags[entry.flag]
			local display_text = `[ {entry.key_name} ]`
			local text_color = is_enabled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 180)

			local info_width = text_service:GetTextSize(
				display_text,
				14,
				Enum.Font.GothamSemibold,
				_new_vector2(1000, 24)
			).X + 4

			create_label({
				Size = _new_udim2(1, -(info_width + 10), 1, 0),
				Text = entry.title,
				TextColor3 = text_color,
				TextSize = 14,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Parent = row,
			})

			create_label({
				AnchorPoint = _new_vector2(1, 0.5),
				Position = _new_udim2(1, 0, 0.5, 0),
				Size = _new_udim2(0, info_width, 0, 18),
				Text = display_text,
				TextColor3 = text_color,
				TextSize = 14,
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = row,
			})
		end
	end

	if self._keybind_list_visible and has_any then
		self._keybind_list_frame.Visible = true
	else
		self._keybind_list_frame.Visible = false
	end
end

