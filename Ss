		clamp_toggle(current_toggle_position()).Y
	)

	mobile_toggle.InputBegan:Connect(function(input)
		if toggle_dragging then
			return
		end

		if
			input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch
		then
			return
		end

		toggle_dragging = true
		toggle_moved = false
		toggle_input = input
		toggle_start = _new_vector2(input.Position.X, input.Position.Y)
		toggle_origin = current_toggle_position()
		toggle_target = toggle_origin

		press_toggle(0.85)
	end)

	user_input_service.InputChanged:Connect(function(input)
		if not toggle_dragging then
			return
		end

		local input_type = input.UserInputType

		if input_type ~= Enum.UserInputType.MouseMovement and input_type ~= Enum.UserInputType.Touch then
			return
		end

		if input_type == Enum.UserInputType.Touch and input ~= toggle_input then
			return
		end

		local delta = _new_vector2(input.Position.X, input.Position.Y) - toggle_start

		if not toggle_moved then
			if delta.Magnitude < TOGGLE_DRAG_THRESHOLD then
				return
			end

			toggle_moved = true

			press_toggle(1.12)
			start_toggle_step()
		end

		toggle_target = clamp_toggle(toggle_origin + delta)
	end)

	user_input_service.InputEnded:Connect(function(input)
		if not toggle_dragging or not toggle_input then
			return
		end

		if
			input == toggle_input
			or (
				toggle_input.UserInputType == Enum.UserInputType.MouseButton1
				and input.UserInputType == Enum.UserInputType.MouseButton1
			)
		then
			finish_toggle_drag()
		end
	end)

