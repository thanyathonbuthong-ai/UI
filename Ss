		tag_icon.Image = _tostring(value or '')
		tag_icon.Visible = value ~= nil and value ~= ''
	end

	function tag_manager:destroy()
		tag:Destroy()
	end

	return tag_manager
end

-- ===== Wind UI style: dialog / popup =====
function library.dialog(self, _values)
	self = resolve_runtime(self)

	if not self or not self._notification_holder then
		return
	end

	_values = _values or {}

	local gui = self._notification_holder:FindFirstAncestorOfClass('ScreenGui')

	if not gui then
		return
	end

	local overlay = create_new('TextButton', {
		Name = '_dialog',
		BackgroundColor3 = Color3.fromRGB(0, 0, 0),
		BackgroundTransparency = 0.5,
		Size = _new_udim2(1, 0, 1, 0),
		Text = '',
		AutoButtonColor = false,
		BorderSizePixel = 0,
		ZIndex = 300,
		Parent = gui,
	})

	local box = create_new('Frame', {
		BackgroundColor3 = Color3.fromRGB(22, 22, 22),
		AnchorPoint = _new_vector2(0.5, 0.5),
		Position = _new_udim2(0.5, 0, 0.5, 0),
		Size = _new_udim2(0, 280, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BorderSizePixel = 0,
		ZIndex = 301,
		Parent = overlay,
	})

	create_round(box, 8)
	create_outline(box, true)
	create_padding(box, 14, 14, 14, 14)
	create_vertical_list(box, 8)

	create_label({
		LayoutOrder = 0,
		Size = _new_udim2(1, 0, 0, 18),
		Text = _tostring(_values.title or 'Dialog'),
		TextColor3 = Color3.fromRGB(255, 255, 255),
		TextSize = self._label_text_size + 2,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 302,
		Parent = box,
	})

	-- Wind UI Popup Icon: small icon in front of the title
	do
		local dialog_icon = _values.icon

		if _type(dialog_icon) == 'number' then
			dialog_icon = 'rbxassetid://' .. _tostring(_floor(dialog_icon))
		elseif _type(dialog_icon) == 'string' and dialog_icon:match('^%d+$') then
			dialog_icon = 'rbxassetid://' .. dialog_icon
		end

		local dialog_title = box:FindFirstChildWhichIsA('TextLabel')

		if dialog_icon ~= nil and dialog_icon ~= '' and dialog_title then
			create_padding(dialog_title, 0, 0, 24, 0)

			create_new('ImageLabel', {
				BackgroundTransparency = 1,
				AnchorPoint = _new_vector2(0, 0.5),
				Position = _new_udim2(0, -24, 0.5, 0),
				Size = _new_udim2(0, 18, 0, 18),
				Image = _tostring(dialog_icon),
				ZIndex = 302,
				Parent = dialog_title,
			})
		end
	end

	create_label({
		LayoutOrder = 1,
		Size = _new_udim2(1, 0, 0, 14),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text = _tostring(_values.content or _values.desc or ''),
		TextSize = self._label_text_size,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		ZIndex = 302,
		Parent = box,
	})

	local button_row = create_new('Frame', {
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = _new_udim2(1, 0, 0, 0),
		ZIndex = 302,
		Parent = box,
	})

	create_new('UIListLayout', {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = _new_udim(0, 6),
		Parent = button_row,
	})

	local buttons = _values.buttons

	if _type(buttons) ~= 'table' or #buttons == 0 then
		buttons = { { title = 'OK' } }
	end

	for index, button_values in _pairs(buttons) do
		-- variant: primary (white) / secondary (gray) / tertiary (dark + outline)
		local variant = _type(button_values.variant) == 'string' and button_values.variant:lower()
			or (button_values.primary and 'primary' or 'secondary')
		local variant_bg = Color3.fromRGB(45, 45, 45)
		local variant_fg = Color3.fromRGB(220, 220, 220)

		if variant == 'primary' then
			variant_bg = Color3.fromRGB(255, 255, 255)
			variant_fg = Color3.fromRGB(18, 18, 18)
		elseif variant == 'tertiary' then
			variant_bg = Color3.fromRGB(22, 22, 22)
			variant_fg = Color3.fromRGB(190, 190, 190)
		end

		local button = create_new('TextButton', {
			BackgroundColor3 = variant_bg,
			LayoutOrder = index,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = _new_udim2(0, 0, 0, 26),
			FontFace = Font.new(
				'rbxasset://fonts/families/GothamSSm.json',
				Enum.FontWeight.SemiBold,
				Enum.FontStyle.Normal
			),
			Text = _tostring(button_values.title or 'OK'),
			TextColor3 = variant_fg,
			TextSize = self._label_text_size,
			AutoButtonColor = false,
			BorderSizePixel = 0,
			ZIndex = 303,
			Parent = button_row,
		})

		create_round(button, 6)
		create_padding(button, 0, 0, 14, 14)

		if variant == 'tertiary' then
			create_outline(button)
		end

		button.MouseButton1Click:Connect(function()
			overlay:Destroy()

			if button_values.callback then
				button_values.callback()
			end
		end)
	end

	return {
		close = function()
			overlay:Destroy()
		end,
	}
end

local LUA_EMPTY_TEXT = '...'
local LUA_STORE_VERSION = 3
local LUA_CONTROL_METHODS = {
	toggle = 'create_toggle',
	slider = 'create_slider',
	dropdown = 'create_dropdown',
