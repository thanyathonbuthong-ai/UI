					ColorSequenceKeypoint.new(4 / 6, Color3.fromRGB(0, 0, 255)),
					ColorSequenceKeypoint.new(5 / 6, Color3.fromRGB(255, 0, 255)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
				}),
				Parent = hue_bar,
			})

			local hue_cursor = create_new('Frame', {
				BackgroundColor3 = Color3.fromRGB(255, 255, 255),
				AnchorPoint = _new_vector2(0.5, 0.5),
				Position = _new_udim2(h, 0, 0.5, 0),
				Size = _new_udim2(0, 3, 1, 6),
				BorderSizePixel = 0,
				ZIndex = 6,
				Parent = hue_bar,
			})

			create_pill(hue_cursor)
			create_new('UIStroke', {
				Color = Color3.fromRGB(0, 0, 0),
				Thickness = 1.5,
				ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
				Parent = hue_cursor,
			})

			-- optional transparency (alpha) slider
			local alpha_bar = nil
			local alpha_cursor = nil

			if has_transparency then
				alpha_bar = create_new('Frame', {
					BackgroundColor3 = current_color,
					LayoutOrder = 2,
					Size = _new_udim2(1, 0, 0, slider_height),
					BorderSizePixel = 0,
					ClipsDescendants = true,
					Parent = panel,
				})

				create_round(alpha_bar, 4)

				create_new('UIGradient', {
					Transparency = NumberSequence.new({
						NumberSequenceKeypoint.new(0, 1),
						NumberSequenceKeypoint.new(1, 0),
					}),
					Parent = alpha_bar,
				})

				alpha_cursor = create_new('Frame', {
					BackgroundColor3 = Color3.fromRGB(255, 255, 255),
					AnchorPoint = _new_vector2(0.5, 0.5),
					Position = _new_udim2(current_alpha, 0, 0.5, 0),
					Size = _new_udim2(0, 3, 1, 6),
					BorderSizePixel = 0,
					ZIndex = 6,
					Parent = alpha_bar,
				})

				create_pill(alpha_cursor)
				create_new('UIStroke', {
					Color = Color3.fromRGB(0, 0, 0),
					Thickness = 1.5,
					ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
					Parent = alpha_cursor,
				})
			end

			local readout = create_label({
				LayoutOrder = has_transparency and 3 or 2,
				Size = _new_udim2(1, 0, 0, readout_height),
				Text = '',
				TextSize = runtime._small_text_size,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = Color3.fromRGB(180, 180, 180),
				Parent = panel,
			})

			local dragging_sv = false
			local dragging_hue = false
			local dragging_alpha = false

			local save_color = LPH_JIT(function()
				if flag then
					local r, g, b = current_color.R, current_color.G, current_color.B

					if has_transparency then
						runtime._flags[flag] = { r * 255, g * 255, b * 255, current_alpha }
					else
						runtime._flags[flag] = { r * 255, g * 255, b * 255 }
					end

					runtime:_save()
				end

				if _values.callback then
					_values.callback(current_color, current_alpha)
				end
			end)

			local apply_color = LPH_NO_VIRTUALIZE(function(changed)
				current_color = Color3.fromHSV(h, s, v)

				sv_square.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
				sv_cursor.Position = _new_udim2(s, 0, 1 - v, 0)
				hue_cursor.Position = _new_udim2(h, 0, 0.5, 0)
				preview_button.BackgroundColor3 = current_color

				if alpha_bar then
					alpha_bar.BackgroundColor3 = current_color
					alpha_cursor.Position = _new_udim2(current_alpha, 0, 0.5, 0)
				end

				local r = _floor(current_color.R * 255 + 0.5)
				local g = _floor(current_color.G * 255 + 0.5)
				local b = _floor(current_color.B * 255 + 0.5)
				local hex = string.format('#%02X%02X%02X', r, g, b)

				if has_transparency then
					readout.Text = hex
						.. '  RGB(' .. r .. ', ' .. g .. ', ' .. b .. ')'
						.. '  A=' .. round_number(current_alpha, 2)
				else
					readout.Text = hex .. '  RGB(' .. r .. ', ' .. g .. ', ' .. b .. ')'
				end

				if changed and _values.callback then
					_values.callback(current_color, current_alpha)
				end
			end)

			apply_color(false)

			local function pick_sv(position)
				local abs_pos = sv_square.AbsolutePosition
				local abs_size = sv_square.AbsoluteSize
				s = _clamp((position.X - abs_pos.X) / abs_size.X, 0, 1)
				v = 1 - _clamp((position.Y - abs_pos.Y) / abs_size.Y, 0, 1)
				apply_color(true)
			end

			local function pick_hue(position)
				local abs_pos = hue_bar.AbsolutePosition
				local abs_size = hue_bar.AbsoluteSize
				h = _clamp((position.X - abs_pos.X) / abs_size.X, 0, 1)
				apply_color(true)
			end

			local function pick_alpha(position)
				if not alpha_bar then
					return
				end

				local abs_pos = alpha_bar.AbsolutePosition
				local abs_size = alpha_bar.AbsoluteSize
				current_alpha = _clamp((position.X - abs_pos.X) / abs_size.X, 0, 1)
				apply_color(true)
			end

			local function is_pointer(input)
				return input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch
			end

			local function is_move(input)
				return input.UserInputType == Enum.UserInputType.MouseMovement
					or input.UserInputType == Enum.UserInputType.Touch
			end

			sv_square.InputBegan:Connect(function(input)
				if is_pointer(input) then
					dragging_sv = true
					pick_sv(input.Position)
				end
			end)

			hue_bar.InputBegan:Connect(function(input)
				if is_pointer(input) then
					dragging_hue = true
					pick_hue(input.Position)
				end
			end)

			if alpha_bar then
				alpha_bar.InputBegan:Connect(function(input)
					if is_pointer(input) then
						dragging_alpha = true
						pick_alpha(input.Position)
					end
				end)
			end

			user_input_service.InputChanged:Connect(function(input)
				if dragging_sv and is_move(input) then
					pick_sv(input.Position)
				elseif dragging_hue and is_move(input) then
					pick_hue(input.Position)
				elseif dragging_alpha and is_move(input) then
					pick_alpha(input.Position)
				end
			end)

			user_input_service.InputEnded:Connect(function(input)
				if not is_pointer(input) then
					return
				end

				if dragging_sv or dragging_hue or dragging_alpha then
					dragging_sv = false
					dragging_hue = false
					dragging_alpha = false
					save_color()
				end
			end)

			function picker_manager:unfold(force_state)
				local opening = force_state

				if opening == nil then
					opening = not self._state
				end

				if self._locked_open and not opening then
					return
				end

				if opening == self._state then
					return
				end

				if opening then
					for _, dropdown in runtime._active_dropdowns do
						if dropdown ~= self and dropdown._state then
							dropdown:unfold(false)
						end
					end
				end

				self._state = opening

				if self._state then
					panel.Visible = true

					_create_tween(
						tween_service,
						panel,
						_new_tween_info(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
						{ Size = _new_udim2(1, 0, 0, panel_height) }
					):Play()
				else
					_create_tween(
						tween_service,
						panel,
						_new_tween_info(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
						{ Size = _new_udim2(1, 0, 0, 0) }
					):Play()

					_delay(0.35, function()
						if not self._state then
							panel.Visible = false
						end
					end)
				end
			end

			function picker_manager:set_locked_open(state)
				self._locked_open = state == true

				if self._locked_open then
					self:unfold(true)
				end
			end

			function picker_manager:set_color(color, alpha)
				if typeof(color) == 'Color3' then
					h, s, v = Color3.toHSV(color)
					current_color = color
				end

				if has_transparency and alpha ~= nil then
					current_alpha = _clamp(tonumber(alpha) or 1, 0, 1)
				end

				apply_color(false)
				save_color()
			end

			function picker_manager:get_color()
				return current_color
			end

			function picker_manager:get_value()
				return current_color, current_alpha
			end

			function picker_manager:set_visible(state)
				cp_frame.Visible = state == true
			end

			function picker_manager:is_visible()
				return cp_frame.Visible
			end

			preview_button.MouseButton1Click:Connect(function()
				picker_manager:unfold()
			end)

			_insert(runtime._active_dropdowns, picker_manager)

			return picker_manager
		end

		-- ===== Wind UI style: extras (input alias, button row, video, desc on every element, toggle type) =====

		-- WindUI calls the text field "Input": type = 'textarea' gives a multi line box, value = default text
		function group_manager:create_input(flag, _values)
			local values = _type(flag) == 'table' and flag or _values

			if _type(values) == 'table' then
				local kind = _type(values.type) == 'string' and values.type:lower() or ''

				if kind == 'textarea' and values.multi_line == nil then
					values.multi_line = true
					values.height = values.height or 60
				end

				if values.default == nil and values.value ~= nil then
					values.default = values.value
				end
			end

			return self:create_textbox(flag, _values)
		end

		-- a row of equal-width buttons: create_button_row({ { title = 'A', callback = f, icon = id, locked = false }, ... })
		function group_manager:create_button_row(items)
			if _type(items) == 'table' and items.buttons then
				items = items.buttons
			end

			items = _type(items) == 'table' and items or {}

			local count = _max(#items, 1)

			local row = create_new('Frame', {
				BackgroundTransparency = 1,
				LayoutOrder = next_row_order(),
				Size = _new_udim2(1, 0, 0, 26),
				Parent = group_frame,
			})

			create_new('UIListLayout', {
				FillDirection = Enum.FillDirection.Horizontal,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = _new_udim(0, 6),
				Parent = row,
			})

			local managers = {}

			for index, item in ipairs(items) do
				local locked = item.locked == true

				local row_variant = _type(item.variant) == 'string' and item.variant:lower() or 'secondary'
				local row_bg = Color3.fromRGB(40, 40, 40)
				local row_fg = Color3.fromRGB(180, 180, 180)

				if row_variant == 'primary' then
					row_bg = Color3.fromRGB(255, 255, 255)
					row_fg = Color3.fromRGB(18, 18, 18)
				elseif row_variant == 'tertiary' then
					row_bg = Color3.fromRGB(22, 22, 22)
					row_fg = Color3.fromRGB(200, 200, 200)
				end

				local button = create_new('TextButton', {
					BackgroundColor3 = row_bg,
					LayoutOrder = index,
					Size = _new_udim2(1 / count, -(6 * (count - 1)) / count, 1, 0),
					FontFace = Font.new(
						'rbxasset://fonts/families/GothamSSm.json',
						Enum.FontWeight.SemiBold,
						Enum.FontStyle.Normal
					),
					Text = _tostring(item.title or 'Button'),
					TextColor3 = row_fg,
					TextSize = runtime._label_text_size,
					TextTruncate = Enum.TextTruncate.AtEnd,
					AutoButtonColor = false,
					BorderSizePixel = 0,
					Parent = row,
				})

				create_round(button, 6)

				if row_variant == 'tertiary' then
					create_outline(button)
				end

				local icon_value = item.icon

				if _type(icon_value) == 'number' then
					icon_value = 'rbxassetid://' .. _tostring(icon_value)
				end

				if icon_value ~= nil and icon_value ~= '' then
					create_new('ImageLabel', {
						BackgroundTransparency = 1,
						AnchorPoint = item.icon_align == 'right' and _new_vector2(1, 0.5) or _new_vector2(0, 0.5),
						Position = item.icon_align == 'right' and _new_udim2(1, -6, 0.5, 0) or _new_udim2(0, 6, 0.5, 0),
						Size = _new_udim2(0, 14, 0, 14),
						Image = _tostring(icon_value),
						Parent = button,
					})
				end

				local entry = {}

				local function apply_lock()
					button.TextTransparency = locked and 0.55 or 0
				end

				function entry:set_locked(state)
					locked = state == true
					apply_lock()
				end

				function entry:set_title(value)
					button.Text = _tostring(value or '')
				end

				apply_lock()

				button.MouseButton1Click:Connect(function()
					if locked then
						return
					end

					button.BackgroundColor3 = row_bg:Lerp(Color3.fromRGB(128, 128, 128), 0.35)

					_create_tween(tween_service, button, _new_tween_info(0.2), {
						BackgroundColor3 = row_bg,
					}):Play()

					if item.callback then
						item.callback()
					end
				end)

				_insert(managers, entry)
			end

			return managers
		end

		-- video block: create_video({ video = 123456 / 'rbxassetid://123' / 'file.webm', height = 140, looped = true, autoplay = true })
		function group_manager:create_video(_values)
			if _type(_values) ~= 'table' then
				_values = { video = _values }
			end

			local function resolve_video(source)
				if _type(source) == 'number' then
					return 'rbxassetid://' .. _tostring(_floor(source))
				end

				source = _tostring(source or '')

				if source:match('^%d+$') then
					return 'rbxassetid://' .. source
				end

				if source ~= '' and not source:lower():match('^rbxasset') and (getcustomasset or getsynasset) then
					local get_asset = getcustomasset or getsynasset
					local path = isfile(source) and source or (isfile('Kittylol/assets/' .. source) and 'Kittylol/assets/' .. source)

					if path then
						local ok, asset = _pcall(get_asset, path)

						if ok and asset then
							return asset
						end
					end
				end

				return source
			end

			local video = create_new('VideoFrame', {
				BackgroundColor3 = Color3.fromRGB(30, 30, 30),
				LayoutOrder = next_row_order(),
				Size = _new_udim2(1, 0, 0, _clamp(tonumber(_values.height) or 140, 40, 400)),
				Video = resolve_video(_values.video or _values.source),
				Looped = _values.looped ~= false,
				Volume = _clamp(tonumber(_values.volume) or 0.5, 0, 10),
				BorderSizePixel = 0,
				Parent = group_frame,
			})

			create_round(video, 6)

			if _values.autoplay ~= false then
				_pcall(function()
					video.Playing = true
				end)
			end

			local video_manager = {}

			function video_manager:play()
				_pcall(function()
					video:Play()
				end)
			end

			function video_manager:pause()
				_pcall(function()
					video:Pause()
				end)
			end

			function video_manager:set_video(value)
				video.Video = resolve_video(value)
			end

			function video_manager:set_visible(state)
				video.Visible = state == true
			end

			return video_manager
		end

		-- Wind UI "Group": put elements side by side.  group:create_row(function(row) row:create_button(...) row:create_toggle(...) end)
		-- (best for buttons / toggles / checkboxes / colorpickers / keybinds; keep dropdowns and sliders outside a row)
		function group_manager:create_row(builder)
			local gap = 8

			local row = create_new('Frame', {
				BackgroundTransparency = 1,
				LayoutOrder = next_row_order(),
				AutomaticSize = Enum.AutomaticSize.Y,
				Size = _new_udim2(1, 0, 0, 0),
				Parent = group_frame,
			})

			create_new('UIListLayout', {
				FillDirection = Enum.FillDirection.Horizontal,
				SortOrder = Enum.SortOrder.LayoutOrder,
				VerticalAlignment = Enum.VerticalAlignment.Top,
				Padding = _new_udim(0, gap),
				Parent = row,
			})

			local previous_frame = group_frame
			local previous_in_row = group_manager._in_row

			group_frame = row
			group_manager._in_row = true

			local ok, err = _pcall(builder, group_manager)

			group_frame = previous_frame
			group_manager._in_row = previous_in_row

			if not ok then
				warn('create_row: ' .. _tostring(err))
			end

			local children = {}

			for _, child in row:GetChildren() do
				if child:IsA('GuiObject') then
					_insert(children, child)
				end
			end

			local count = _max(#children, 1)

			for _, child in children do
				child.Size = _new_udim2(1 / count, -(gap * (count - 1)) / count, child.Size.Y.Scale, child.Size.Y.Offset)
			end

			return { _frame = row }
		end

		-- Wind UI Section with Box = true, Opened = true: a collapsible box that holds other elements
		-- group:create_box_section({ title = 'Box', desc = '...', opened = true }, function(box) box:create_button(...) end)
		function group_manager:create_box_section(_values, builder)
			if _type(_values) ~= 'table' then
				_values = { title = _values }
			end

			local opened = _values.opened ~= false

			local box = create_new('Frame', {
				BackgroundColor3 = Color3.fromRGB(28, 28, 28),
				LayoutOrder = next_row_order(),
				AutomaticSize = Enum.AutomaticSize.Y,
