		-- ===== Wind UI style: image =====
		function group_manager:create_image(_values)
			if _type(_values) ~= 'table' then
				_values = { image = _values }
			end

			local image_value = _values.image or _values.icon or ''

			if _type(image_value) == 'number' then
				image_value = 'rbxassetid://' .. _tostring(image_value)
			elseif _type(image_value) == 'string' and image_value ~= '' then
				-- links (https://...png) and files (Kittylol/assets/x.png) are resolved too
				local resolved_image = resolve_toggle_icon(image_value)

				if resolved_image then
					image_value = resolved_image
				end
			end

			local image = create_new('ImageLabel', {
				BackgroundColor3 = Color3.fromRGB(30, 30, 30),
				LayoutOrder = next_row_order(),
				Size = _new_udim2(1, 0, 0, _clamp(tonumber(_values.height) or 120, 20, 400)),
				Image = _tostring(image_value),
				ScaleType = _values.fit and Enum.ScaleType.Fit or Enum.ScaleType.Crop,
				BorderSizePixel = 0,
				Parent = group_frame,
			})

			create_round(image, tonumber(_values.radius) or 6)

			-- aspect_ratio = '16:9' (or a number) keeps the height in proportion to the width
			local ratio = nil

			if _type(_values.aspect_ratio) == 'string' then
				local ratio_w, ratio_h = _values.aspect_ratio:match('^(%d+%.?%d*)%s*:%s*(%d+%.?%d*)$')

				if ratio_w and ratio_h and tonumber(ratio_h) ~= 0 then
					ratio = tonumber(ratio_w) / tonumber(ratio_h)
				end
			elseif _type(_values.aspect_ratio) == 'number' and _values.aspect_ratio > 0 then
				ratio = _values.aspect_ratio
			end

			if ratio then
				local fit_ratio = function()
					local width = image.AbsoluteSize.X

					if width > 0 then
						local target = _floor(width / ratio)

						if image.Size.Y.Offset ~= target then
							image.Size = _new_udim2(1, 0, 0, target)
						end
					end
				end

				image:GetPropertyChangedSignal('AbsoluteSize'):Connect(fit_ratio)
				_defer(fit_ratio)
			end

			local image_manager = {}

			function image_manager:set_image(value)
				if _type(value) == 'number' then
					image.Image = 'rbxassetid://' .. _tostring(value)
				elseif _type(value) == 'string' and value ~= '' then
					image.Image = resolve_toggle_icon(value) or value
				else
					image.Image = ''
				end
			end

			return image_manager
		end

