				end

				gradient_state.rotation = value
				refresh_gradient()
			end,
		})

		gradient_controls.transparency = gradient_group:create_slider('theme_gradient_transparency', {
			title = 'Gradient Transparency (%)',
			minimum = 0,
			maximum = 90,
			default = 0,
			callback = function(value)
				if not gradient_ready then
					return
				end

				gradient_state.transparency = value
				refresh_gradient()
			end,
		})

		gradient_controls.animate = gradient_group:create_toggle('theme_gradient_animate', {
			title = 'Animate Gradient',
			default = false,
			callback = function(state)
				if not gradient_ready then
					return
				end

				gradient_state.animate = state == true
				refresh_gradient()
			end,
		})

		gradient_controls.speed = gradient_group:create_slider('theme_gradient_speed', {
			title = 'Animation Speed',
			minimum = 5,
			maximum = 120,
			default = 30,
			callback = function(value)
				if not gradient_ready then
					return
				end

				gradient_state.speed = value
				refresh_gradient()
			end,
		})

		gradient_group:create_button_row({
			{
				title = 'Reverse',
				callback = function()
					for index = 1, GRADIENT_MAX do
						local stop = gradient_state.stops[index]

						stop.position = 100 - stop.position
						gradient_controls.positions[index]:set_value(stop.position)
					end

					refresh_gradient()
				end,
			},
			{
				title = 'Random',
				callback = function()
					local was_loading = loading

					loading = true

					for index = 1, GRADIENT_MAX do
						local color = Color3.fromHSV(math.random(), 0.65, 1)

						gradient_state.stops[index].color = color
						gradient_controls.pickers[index]:set_color(color)
					end

					gradient_state.enabled = true
					gradient_controls.enabled:set_value(true)
					loading = was_loading
					refresh_gradient()
				end,
			},
		})

		-- saves the gradient as the theme 'Custom Gradient' so it loads again next time
		gradient_group:create_button({
			title = 'Apply & Save Gradient',
			variant = 'primary',
			callback = function()
				if not gradient_state.enabled then
					self:notify('Turn on Gradient Background first')

					return
				end

				local preview = build_preview()

				self:set_gradient(preview.BackgroundGradient)
			end,
		})

		gradient_group:create_button({
			title = 'Remove Gradient',
			callback = function()
				self:set_gradient(nil)
			end,
		})

		gradient_ready = true

		theme_group:create_textbox('theme_name_input', {
			title = 'Theme Name',
			placeholder = 'My Theme',
			default = '',
			height = 24,
			compact = true,
			multi_line = false,
			callback = function(value)
				draft_name = _tostring(value or ''):gsub('^%s+', ''):gsub('%s+$', '')
			end,
		})

		theme_group:create_button({
			title = 'Save Theme',
			callback = function()
				if draft_name == '' then
					self:notify('Type a theme name first')

					return
				end

				if theme_registry[draft_name] and theme_registry[draft_name].Legacy then
					self:notify('That name is used by a built-in theme')

					return
				end

				local def = build_preview()

				def.Name = draft_name
				def.Save = true
				theme_register(def, true)
				theme_dropdown:set_options(library.list_themes(), draft_name)
				self:set_theme(draft_name)
				self:notify('Theme saved: ' .. draft_name)
			end,
		})

		theme_group:create_button({
			title = 'Delete Theme',
			callback = function()
				local current = library.get_current_theme()

				if not library.is_saved_theme(self, current) then
					self:notify('Only themes you saved can be deleted')

					return
				end

				library.remove_theme(current)
				theme_dropdown:set_options(library.list_themes(), 'Dark')
				load_draft('Dark')
				self:notify('Theme deleted: ' .. current)
			end,
		})

		theme_group:create_button({
			title = 'Copy Theme Code',
			callback = function()
				local code = library.export_theme(library.get_current_theme())

				if code and setclipboard then
					setclipboard(code)
					self:notify('Theme code copied')
				else
					self:notify('This executor cannot copy to the clipboard')
				end
			end,
		})

		local import_box = theme_group:create_textbox('theme_import_input', {
			title = 'Import Theme (JSON)',
			placeholder = '{"Name":"x","Accent":"#18181b",...}',
			default = '',
			height = 24,
			compact = true,
			multi_line = false,
			callback = function() end,
		})

		theme_group:create_button({
			title = 'Import Theme',
			callback = function()
