function library.export_theme(self, name)
	local def = library.get_theme(theme_arg(self, name))

	if not def then
		return nil
	end

	local lines = { 'ui:add_theme({', `\tName = {string.format('%q', def.Name)},` }

	for _, key in THEME_COLOR_KEYS do
		if key == 'Background' and def.BackgroundGradient then
			local gradient = def.BackgroundGradient

			_insert(lines, '\tBackground = ui:gradient({')

			for _, stop in gradient.stops do
				_insert(
					lines,
					`\t\t['{_floor(stop.Position * 100 + 0.5)}'] = \{ Color = Color3.fromHex('#{stop.Color:ToHex()}'), Transparency = {stop.Transparency} \},`
				)
			end

			_insert(
				lines,
				`\t\}, \{ Rotation = {gradient.rotation}, Animate = {gradient.animate}, Speed = {gradient.speed} \}),`
			)
		elseif def[key] then
			_insert(lines, `\t{key} = Color3.fromHex('#{def[key]:ToHex()}'),`)
		end
	end

	_insert(lines, '})')

	return table.concat(lines, '\n')
end

function library.import_theme(self, source)
	source = theme_arg(self, source)

	local ok, decoded = _pcall(function()
		return http_service:JSONDecode(source)
	end)

	if not ok or _type(decoded) ~= 'table' or _type(decoded.Name) ~= 'string' or decoded.Name == '' then
		return false, 'not a valid theme'
	end

	decoded.Save = nil
	theme_register(decoded, true)

	return true, decoded.Name
end

