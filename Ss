			})

			create_round(box, 6)
			create_outline(box)
			create_padding(box, 8, 8, 10, 10)
			create_vertical_list(box, 8)

			local header = create_new('TextButton', {
				BackgroundTransparency = 1,
				LayoutOrder = 0,
				Size = _new_udim2(1, 0, 0, 20),
				Text = '',
				AutoButtonColor = false,
				Parent = box,
			})

			create_label({
				Size = _new_udim2(1, -24, 1, 0),
