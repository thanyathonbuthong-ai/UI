		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = keybind_list_header,
	})

	create_divider(keybind_list_header, _new_udim2(0, 0, 1, -1), _new_udim2(1, 0, 0, 1))

	local keybind_content = create_new('Frame', {
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = _new_udim2(1, 0, 0, 0),
		Parent = keybind_list,
	})

	create_vertical_list(keybind_content, 2)
	create_padding(keybind_content, 6, 8, 12, 12)

	self._keybind_list_frame = keybind_list
	self._keybind_list_content = keybind_content

	local keybind_dragging = false
	local keybind_drag_start = nil
	local keybind_list_position = nil

	keybind_list.InputBegan:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			keybind_dragging = true

			keybind_drag_start = input.Position
			keybind_list_position = keybind_list.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					keybind_dragging = false
				end
			end)
		end
	end)

	user_input_service.InputChanged:Connect(function(input)
		if not keybind_dragging then
			return
		end

		if
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		then
			local scale = self._ui_scale
			local delta = (input.Position - keybind_drag_start) / scale

			_create_tween(tween_service, keybind_list, _new_tween_info(0.15), {
				Position = _new_udim2(
					keybind_list_position.X.Scale,
					keybind_list_position.X.Offset + delta.X,
					keybind_list_position.Y.Scale,
					keybind_list_position.Y.Offset + delta.Y
				),
			}):Play()
		end
	end)
end

function library.notify(self: runtime_typeof, message)
	self = resolve_runtime(self)

	if not self or not self._notification_holder then
		return
	end

	-- backward compatible: notify("text") still works exactly like before.
	-- new: notify({ title = "...", content = "...", icon = "rbxassetid://..." or id, duration = 3 })
	local options = message

	if _type(options) ~= 'table' then
		options = { content = message }
	end

	local title_text = _tostring(options.title or ''):gsub('[\r\n]+', ' '):gsub('^%s+', ''):gsub('%s+$', '')
	local body_text = _tostring(options.content or options.message or options.text or options.desc or '')
		:gsub('[\r\n]+', ' ')
		:gsub('^%s+', '')
		:gsub('%s+$', '')

	if title_text == '' and body_text == '' then
		return
	end

	local duration = tonumber(options.duration) or 3

	local icon_value = options.icon

	if _type(icon_value) == 'number' then
		icon_value = 'rbxassetid://' .. _tostring(icon_value)
	end

	local has_icon = icon_value ~= nil and icon_value ~= ''
	local has_title = title_text ~= ''
	local icon_width = has_icon and 22 or 0
	local text_left = 10 + icon_width

	local widest_line = has_title and title_text or body_text

	if has_title and body_text ~= '' then
		local title_width =
			text_service:GetTextSize(title_text, self._label_text_size, Enum.Font.GothamSemibold, _new_vector2(1000, 18)).X
		local body_width =
			text_service:GetTextSize(body_text, self._small_text_size + 1, Enum.Font.GothamSemibold, _new_vector2(1000, 16)).X

		widest_line = title_width > body_width and title_text or body_text
	end

	local text_width =
		text_service:GetTextSize(widest_line, self._label_text_size, Enum.Font.GothamSemibold, _new_vector2(1000, 26)).X
	local width = _clamp(text_width + text_left + 14, 72, 540)
	local target_height = (has_title and body_text ~= '') and 42 or 26

	self._notification_order += 1

	local notification = create_new('Frame', {
		Name = '_notification',
		BackgroundColor3 = Color3.fromRGB(22, 22, 22),
		BackgroundTransparency = 1,
		LayoutOrder = self._notification_order,
		Size = _new_udim2(0, width - 12, 0, 0),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 200,
		Parent = self._notification_holder,
	})

	create_round(notification, 6)

	local notification_outline = create_outline(notification)
	notification_outline.Transparency = 1

	local notification_icon = create_new('ImageLabel', {
		BackgroundTransparency = 1,
		AnchorPoint = _new_vector2(0, 0.5),
		Position = _new_udim2(0, 10, 0.5, 0),
		Size = _new_udim2(0, 16, 0, 16),
		Image = _tostring(icon_value or ''),
		ImageTransparency = 1,
		Visible = has_icon,
		ZIndex = 201,
		Parent = notification,
	})

	local title_label, body_label

	if has_title and body_text ~= '' then
		title_label = create_label({
			Position = _new_udim2(0, text_left, 0, 4),
			Size = _new_udim2(1, -(text_left + 10), 0, 16),
			Text = title_text,
			TextColor3 = Color3.fromRGB(255, 255, 255),
			TextSize = self._label_text_size,
			TextTransparency = 1,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 201,
			Parent = notification,
		})

		body_label = create_label({
			Position = _new_udim2(0, text_left, 0, 20),
			Size = _new_udim2(1, -(text_left + 10), 0, 16),
			Text = body_text,
			TextColor3 = Color3.fromRGB(255, 255, 255),
			TextSize = self._small_text_size + 1,
			TextTransparency = 1,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 201,
			Parent = notification,
		})
	else
		body_label = create_label({
			Position = _new_udim2(0, text_left, 0, 0),
			Size = _new_udim2(1, -(text_left + 10), 1, 0),
			Text = has_title and title_text or body_text,
			TextColor3 = Color3.fromRGB(255, 255, 255),
			TextSize = self._label_text_size,
			TextTransparency = 1,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 201,
			Parent = notification,
		})
	end

	_create_tween(
		tween_service,
		notification,
		_new_tween_info(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{
			BackgroundTransparency = 0,
			Size = _new_udim2(0, width, 0, target_height),
		}
	):Play()
	_create_tween(tween_service, notification_outline, _new_tween_info(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Transparency = 0,
	}):Play()

	if notification_icon.Visible then
		_create_tween(tween_service, notification_icon, _new_tween_info(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			ImageTransparency = 0.05,
		}):Play()
	end

	if title_label then
		_create_tween(tween_service, title_label, _new_tween_info(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
			TextTransparency = 0.05,
		}):Play()
	end

	_create_tween(tween_service, body_label, _new_tween_info(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		TextTransparency = title_label and 0.35 or 0.1,
	}):Play()

	local closing = false

	local function close_now()
		if closing or not notification.Parent then
			return
		end

		closing = true

		_create_tween(
			tween_service,
			notification,
			_new_tween_info(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
			{
				BackgroundTransparency = 1,
				Size = _new_udim2(0, width - 12, 0, 0),
			}
		):Play()
		_create_tween(tween_service, body_label, _new_tween_info(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
			TextTransparency = 1,
		}):Play()

		if title_label then
			_create_tween(tween_service, title_label, _new_tween_info(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
				TextTransparency = 1,
			}):Play()
		end

		_create_tween(tween_service, notification_outline, _new_tween_info(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
			Transparency = 1,
		}):Play()

		_delay(0.3, function()
			if notification.Parent then
				notification:Destroy()
			end
		end)
	end

	-- Wind UI Notify: CanClose = true -> tap the notification to dismiss it
	if options.can_close == true or options.closable == true then
		local close_button = create_new('TextButton', {
			BackgroundTransparency = 1,
			Size = _new_udim2(1, 0, 1, 0),
			Text = '',
			AutoButtonColor = false,
			BorderSizePixel = 0,
			ZIndex = 210,
			Parent = notification,
		})

		close_button.MouseButton1Click:Connect(close_now)
	end

	_delay(_max(duration, 0.3), close_now)

	return {
		close = close_now,
	}
end


