		-- ===== Wind UI style: paragraph (title + description + optional buttons) =====
		function group_manager:create_paragraph(_values)
			if _type(_values) ~= 'table' then
				_values = { title = _values }
			end

			local paragraph_frame = create_new('Frame', {
				BackgroundColor3 = typeof(_values.color) == 'Color3' and _values.color or Color3.fromRGB(30, 30, 30),
				LayoutOrder = next_row_order(),
				AutomaticSize = Enum.AutomaticSize.Y,
				Size = _new_udim2(1, 0, 0, 0),
				BorderSizePixel = 0,
				Visible = _values.visible ~= false,
				Parent = group_frame,
			})

			create_round(paragraph_frame, 6)
			create_outline(paragraph_frame)
			create_padding(paragraph_frame, 8, 8, 10, 10)
			create_vertical_list(paragraph_frame, 4)

			local title_label = create_label({
				LayoutOrder = 0,
				Size = _new_udim2(1, 0, 0, 16),
				AutomaticSize = Enum.AutomaticSize.Y,
				Text = _tostring(_values.title or ''),
				TextColor3 = Color3.fromRGB(255, 255, 255),
				TextSize = runtime._label_text_size,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextWrapped = true,
				Visible = (_values.title ~= nil and _values.title ~= ''),
				Parent = paragraph_frame,
			})

			-- Wind UI Paragraph: Image (icon beside the title) and Thumbnail (banner on top)
			local function resolve_image(source)
				if _type(source) == 'number' then
					return 'rbxassetid://' .. _tostring(_floor(source))
				end

				source = _tostring(source or '')

				if source:match('^%d+$') then
					return 'rbxassetid://' .. source
				end

				return source
			end

			local paragraph_image = resolve_image(_values.image)

			if paragraph_image ~= '' then
