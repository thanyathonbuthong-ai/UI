		end
	end

	self._stop_toggle_step = stop_toggle_step

	-- eases the button toward the finger every frame (frame-rate independent, no tween spam)
	local start_toggle_step = function()
		if toggle_step then
			return
		end

		toggle_step = track_signal(run_service.RenderStepped):Connect(function(delta_time)
			if not toggle_target then
				stop_toggle_step()

				return
			end

			local current = current_toggle_position()
			local alpha = 1 - math.exp(-delta_time * 30)
			local next_position = current:Lerp(toggle_target, alpha)

			if (toggle_target - next_position).Magnitude < 0.25 then
				next_position = toggle_target

				if not toggle_dragging then
					stop_toggle_step()
				end
			end

			mobile_toggle.Position = _udim2_from_offset(next_position.X, next_position.Y)
		end)
	end

	local finish_toggle_drag = function()
		if not toggle_dragging then
			return
		end

		toggle_dragging = false
		toggle_input = nil

		press_toggle(1)

		if toggle_moved then
			toggle_settings.x = toggle_target.X
			toggle_settings.y = toggle_target.Y

			self:_save_toggle_settings()
		else
			self._ui_open = not self._ui_open

			self:change_visibility(self._ui_open)
		end
	end

	mobile_toggle.Position = _udim2_from_offset(
