				end

				_insert(dropdown_manager._options, object)

				local meta = option_meta[object]
				local has_desc = meta ~= nil and meta.desc ~= nil and meta.desc ~= ''
				local row_height = has_desc and 38 or 24
				local icon_value = meta and meta.icon

				if _type(icon_value) == 'number' then
