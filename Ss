-- ===== GRADIENT THEME USAGE (WindUI style) =====
-- ui:add_theme({
--     Name = 'Sunset',
--     Accent = '#2a0f1f', Outline = '#ffe4e6', Text = '#ffe4e6', Placeholder = '#b76e79',
--     Button = '#9f1239', Icon = '#fda4af', Primary = '#fb7185',
--     Background = ui:gradient({
--         ['0']   = { Color = Color3.fromHex('#ff0080'), Transparency = 0 },
--         ['50']  = { Color = Color3.fromHex('#7928ca'), Transparency = 0 },
--         ['100'] = { Color = Color3.fromHex('#00d4ff'), Transparency = 0 },
--     }, { Rotation = 45, Animate = true, Speed = 30 }),
-- })
-- ui:set_theme('Sunset')
-- custom gradient on the current theme (no theme needed):
--   ui:set_gradient({ ['0'] = { Color = Color3.fromHex('#ff0080') }, ['100'] = { Color = Color3.fromHex('#00d4ff') } }, { Rotation = 45, Animate = true, Speed = 30 })
--   ui:set_gradient(nil)   -- remove it
--   library._new(nil, { ui_gradient = library.gradient({ ['0'] = { Color = ... }, ['100'] = { Color = ... } }, { Rotation = 90 }) })
-- rule: a theme (anything except 'Dark') and a background image can NOT be active together.
--       set_theme fails while a background exists, set_background fails while a theme is active.

-- ===== THEME SYSTEM (WindUI style: AddTheme / SetTheme / GetThemes / custom themes) =====
-- every color in this UI goes through Color3.fromRGB below, which returns the color of the ACTIVE theme,
-- so the whole window (old and new elements) follows the theme without touching every element.
-- theme keys (same names as WindUI): Name, Accent, Background, Outline, Text, Placeholder, Button, Icon
-- extra keys: Primary (toggle / highlight blue), WindowBackground, ElementBackground, Hover
local THEME_FILE = 'Kittylol/theme.json'
local THEME_COLOR_KEYS = { 'Accent', 'Background', 'Outline', 'Text', 'Placeholder', 'Button', 'Icon', 'Primary' }
local THEME_EXTRA_KEYS = { 'WindowBackground', 'ElementBackground', 'Hover' }
local THEME_SLOT_ORDER = { 255, 220, 200, 190, 180, 128, 120, 110, 50, 45, 40, 35, 30, 28, 22, 18, 14, 'p', 'pd' }

local theme_raw_rgb = Color3.fromRGB
local theme_raw_hex = Color3.fromHex
local theme_raw_create = tween_service.Create

local theme_registry = {}
local theme_order = {}
local theme_saved = { current = nil, custom = {} }
local theme_listeners = {}
local theme_name = 'Dark'
local current_slots = {}
local current_rev = {}
local stale_map = {}

local theme_key = function(color)
	return _floor(color.R * 255 + 0.5) * 65536 + _floor(color.G * 255 + 0.5) * 256 + _floor(color.B * 255 + 0.5)
end

local theme_int_color = function(color)
	return theme_raw_rgb(_floor(color.R * 255 + 0.5), _floor(color.G * 255 + 0.5), _floor(color.B * 255 + 0.5))
end

local theme_luminance = function(color)
	return 0.2126 * color.R + 0.7152 * color.G + 0.0722 * color.B
end

local theme_parse_color = function(value)
	if typeof(value) == 'Color3' then
		return value
	end

	if _type(value) == 'string' then
		local ok, color = _pcall(theme_raw_hex, value)

		if ok and typeof(color) == 'Color3' then
			return color
		end
	end

	-- WindUI:Gradient(...) value: the first stop is used as the flat color
	if _type(value) == 'table' and value._gradient and value.stops and value.stops[1] then
		return value.stops[1].Color
	end

	return nil
end

-- Wind UI: WindUI:Gradient({ ['0'] = { Color = ..., Transparency = 0 }, ['100'] = { ... } }, { Rotation = 0 })
function library.gradient(self, stops, options)
	-- works as ui:gradient(stops, options) and as library.gradient(stops, options)
	if not (self == library or (_type(self) == 'table' and self._tabs ~= nil)) then
		options = stops
		stops = self
	end

	local list = {}

	for position, stop in _pairs(stops or {}) do
		local color = theme_parse_color(stop.Color or stop.color)

		if color then
			_insert(list, {
				Position = (tonumber(position) or 0) / 100,
				Color = color,
				Transparency = stop.Transparency or stop.transparency or 0,
			})
		end
	end

	table.sort(list, function(left, right)
		return left.Position < right.Position
	end)

	return {
		_gradient = true,
		stops = list,
		rotation = (options and (options.Rotation or options.rotation)) or 0,
		animate = (options and (options.Animate or options.animate)) == true,
		speed = tonumber(options and (options.Speed or options.speed)) or 30,
	}
end

-- gradient helpers (kept in one table to save top-level locals)
local theme_gradient = { notify_time = 0, base = 'Dark' }

-- rebuilds a gradient from a WindUI:Gradient value or from its saved / JSON form
function theme_gradient.rebuild(source)
	if _type(source) ~= 'table' then
		return nil
	end

	if source._gradient and source.stops and source.stops[1] then
		return source
	end

	local list = {}

	for _, stop in _pairs(source.stops or source.Stops or {}) do
		if _type(stop) == 'table' then
			local color = theme_parse_color(stop.Color or stop.color)

			if color then
				local position = tonumber(stop.Position or stop.position) or 0

				if position > 1 then
					position = position / 100
				end

				_insert(list, {
					Position = _clamp(position, 0, 1),
					Color = color,
					Transparency = _clamp(tonumber(stop.Transparency or stop.transparency) or 0, 0, 1),
				})
			end
		end
	end

	if #list == 0 then
		return nil
	end

	table.sort(list, function(left, right)
		return left.Position < right.Position
	end)

	return {
		_gradient = true,
		stops = list,
		rotation = tonumber(source.rotation or source.Rotation) or 0,
		animate = (source.animate or source.Animate) == true,
		speed = tonumber(source.speed or source.Speed) or 30,
	}
end

-- gradient -> plain table for JSON (theme file)
function theme_gradient.serialize(gradient)
	local stops = {}

	for _, stop in gradient.stops do
		_insert(stops, { Position = stop.Position, Color = '#' .. stop.Color:ToHex(), Transparency = stop.Transparency })
	end

	return { stops = stops, Rotation = gradient.rotation, Animate = gradient.animate, Speed = gradient.speed }
end

local theme_normalize = function(def)
	local out = {}

	out.Name = _tostring(def.Name or def.name or 'Theme')
	out.Legacy = def.Legacy == true
	out.Hidden = def.Hidden == true

	for _, key in THEME_COLOR_KEYS do
		local color = theme_parse_color(def[key] or def[key:lower()])

		if color then
			out[key] = color
		end
	end

	for _, key in THEME_EXTRA_KEYS do
		local color = theme_parse_color(def[key] or def[key:lower()])

		if color then
			out[key] = color
		end
	end

	local gradient_source = (_type(def.Background) == 'table' and def.Background._gradient) and def.Background
		or def.BackgroundGradient
	local rebuilt_gradient = theme_gradient.rebuild(gradient_source)

	if rebuilt_gradient then
		out.BackgroundGradient = rebuilt_gradient

		-- a plain Background color is kept (it drives the UI shades); otherwise the first stop is used
		if gradient_source == def.Background or out.Background == nil then
			out.Background = rebuilt_gradient.stops[1].Color
		end
	end

	return out
end

local LEGACY_SLOTS = {}

for _, slot in THEME_SLOT_ORDER do
	if _type(slot) == 'number' then
		LEGACY_SLOTS[slot] = theme_raw_rgb(slot, slot, slot)
	end
end

LEGACY_SLOTS.p = theme_raw_rgb(80, 160, 255)
LEGACY_SLOTS.pd = theme_raw_rgb(60, 120, 255)

-- builds every UI color from the theme keys (the built-in Dark theme keeps the original exact colors)
local theme_resolve = function(def)
	if def.Legacy then
		return LEGACY_SLOTS
	end

	local black, white = theme_raw_rgb(0, 0, 0), theme_raw_rgb(255, 255, 255)
	local bg = def.Background or theme_raw_rgb(18, 18, 18)
	local dark = theme_luminance(bg) < 0.5
	local ol = def.Outline or (dark and white or black)
	local tx = def.Text or (dark and white or black)
	local ac = def.Accent or bg:Lerp(ol, 0.06)
	local ic = def.Icon or tx:Lerp(bg, 0.35)
	local ph = def.Placeholder or tx:Lerp(bg, 0.55)
	local bt = def.Button or ac:Lerp(ol, 0.2)
	local boost = dark and 1 or 1.8
	local button_strength = dark and 1 or 0.35

	local slots = {}

	slots[255] = tx
	slots[220] = ic:Lerp(tx, 0.63)
	slots[200] = ic:Lerp(tx, 0.42)
	slots[190] = ic:Lerp(tx, 0.32)
	slots[180] = ic:Lerp(tx, 0.25)
	slots[128] = ph:Lerp(ic, 0.1)
	slots[120] = ph
	slots[110] = ph:Lerp(bg, 0.12)
	slots[50] = ac:Lerp(bt, 0.28 * button_strength)
	slots[45] = def.Hover or ac:Lerp(bt, 0.2 * button_strength)
	slots[40] = ac:Lerp(ol, 0.069 * boost)
	slots[35] = ac:Lerp(ol, 0.048 * boost)
	slots[30] = ac:Lerp(ol, 0.026 * boost)
	slots[28] = def.ElementBackground or ac:Lerp(ol, 0.017 * boost)
	slots[22] = ac
	slots[18] = def.WindowBackground or bg
	slots[14] = bg:Lerp(black, dark and 0.22 or 0.04)
	slots.p = def.Primary or LEGACY_SLOTS.p
	slots.pd = slots.p:Lerp(black, 0.25)

	return slots
end

local theme_build = function(def)
	local slots, reverse, taken = {}, {}, {}

	for _, slot in THEME_SLOT_ORDER do
		local color = theme_int_color(theme_resolve(def)[slot])
		local key = theme_key(color)

		-- two slots must never share a color, or a theme switch could not tell them apart
		while taken[key] do
			local blue = _floor(color.B * 255 + 0.5)
			color = theme_raw_rgb(
				_floor(color.R * 255 + 0.5),
				_floor(color.G * 255 + 0.5),
				blue >= 255 and blue - 1 or blue + 1
			)
			key = theme_key(color)
		end

		taken[key] = true
		slots[slot] = color
		reverse[key] = slot
	end

	return slots, reverse
end

-- the color function every element uses: gray steps and the blue accents follow the active theme
local Color3 = setmetatable({
	fromRGB = function(r, g, b)
		if r == g and g == b then
			local color = current_slots[r]

			if color then
				return color
			end
		elseif r == 80 and g == 160 and b == 255 then
			return current_slots.p
		elseif r == 60 and g == 120 and b == 255 then
			return current_slots.pd
		end

		return theme_raw_rgb(r, g, b)
	end,
}, { __index = Color3 })

-- a color captured in a variable before a theme switch is translated to the new theme when it is used again
local theme_remap = function(value)
	if typeof(value) ~= 'Color3' then
		return value
	end

	local key = theme_key(value)

	if current_rev[key] ~= nil then
		return value
	end

	local slot = stale_map[key]

	if slot ~= nil then
		return current_slots[slot]
	end

	return value
end

_create_tween = function(service, instance, info, goal)
	for property, value in _pairs(goal) do
		if typeof(value) == 'Color3' then
			goal[property] = theme_remap(value)
		end
	end

	return theme_raw_create(service, instance, info, goal)
end

local theme_set_active = function(name)
	local def = theme_registry[name]
	local slots, reverse = theme_build(def)
	local old_rev = current_rev

	for key, slot in _pairs(old_rev) do
		if reverse[key] == nil then
			stale_map[key] = slot
		end
	end

	for key in _pairs(reverse) do
		stale_map[key] = nil
	end

	_clear(current_slots)

	for slot, color in _pairs(slots) do
		current_slots[slot] = color
	end

	current_rev = reverse
	theme_name = name

	return old_rev
end

local theme_recolor_props = {
	{ 'GuiObject', 'BackgroundColor3' },
	{ 'TextLabel', 'TextColor3' },
	{ 'TextButton', 'TextColor3' },
	{ 'TextBox', 'TextColor3' },
	{ 'TextBox', 'PlaceholderColor3' },
	{ 'ImageLabel', 'ImageColor3' },
	{ 'ImageButton', 'ImageColor3' },
	{ 'ScrollingFrame', 'ScrollBarImageColor3' },
	{ 'UIStroke', 'Color' },
}

local theme_recolor = function(root, old_rev)
	if not root then
		return
	end

	local descendants = root:GetDescendants()
	local animate = #descendants < 1500
	local info = _new_tween_info(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	_insert(descendants, root)

	for _, instance in descendants do
		if instance.Name == '_theme_gradient' then
			continue
		end

		for _, pair in theme_recolor_props do
			if instance:IsA(pair[1]) then
				local property = pair[2]
				local value = instance[property]
				local slot = old_rev[theme_key(value)]

				if slot ~= nil then
					local target = current_slots[slot]

					if target ~= value then
						if animate then
							theme_raw_create(tween_service, instance, info, { [property] = target }):Play()
						else
							instance[property] = target
						end
					end
				end
			end
		end
	end
end

local theme_write = function()
	local data = { current = theme_saved.current, custom = {} }

	for name, def in _pairs(theme_saved.custom) do
		local entry = { Name = name }

		for _, key in THEME_COLOR_KEYS do
			if def[key] then
				entry[key] = '#' .. def[key]:ToHex()
			end
		end

		if def.BackgroundGradient then
			entry.BackgroundGradient = theme_gradient.serialize(def.BackgroundGradient)
		end

		_insert(data.custom, entry)
	end

	_pcall(function()
		writefile(THEME_FILE, http_service:JSONEncode(data))
	end)
end

local shallow_copy_theme = function(source)
	local copy = {}

	for key, value in _pairs(source or {}) do
		copy[key] = value
	end

	return copy
end

local theme_arg = function(self, value)
	if value ~= nil then
		return value
	end

	if self == library or (_type(self) == 'table' and self._tabs ~= nil) then
		return nil
	end

	return self
end

local theme_register = function(def, persist)
	local normalized = theme_normalize(def)
	local name = normalized.Name

	if theme_registry[name] == nil then
		_insert(theme_order, name)
	end

	theme_registry[name] = normalized

	if persist then
		theme_saved.custom[name] = normalized
		theme_write()
	end

	return normalized
end

local theme_fire = function()
	for _, listener in theme_listeners do
		_pcall(listener, theme_name)
	end
end

-- stops the animated gradient (if any)
function theme_gradient.stop(runtime)
	if runtime._theme_gradient_conn then
		runtime._theme_gradient_conn:Disconnect()
		runtime._theme_gradient_conn = nil
	end
end

-- shows / hides the WindUI style gradient of the ACTIVE theme on the window
function theme_gradient.apply(runtime)
	if not runtime or not runtime._container then
		return
	end

	local def = theme_registry[theme_name]
	local gradient = def and def.BackgroundGradient
	local frame = runtime._theme_gradient_frame

	theme_gradient.stop(runtime)

	if not gradient then
		if frame then
			frame.Visible = false
		end

		return
	end

	if not frame or not frame.Parent then
		-- raw instances on purpose: the white base color must never be remapped by the theme system
		frame = _new_instance('Frame')
		frame.Name = '_theme_gradient'
		frame.BackgroundColor3 = theme_raw_rgb(255, 255, 255)
		frame.BorderSizePixel = 0
		frame.Size = _new_udim2(1, 0, 1, 0)
		frame.ZIndex = 0

		local corner = _new_instance('UICorner')
		corner.CornerRadius = _new_udim(0, 8)
		corner.Parent = frame

		_new_instance('UIGradient').Parent = frame

		frame.Parent = runtime._container
		runtime._theme_gradient_frame = frame
	end

	local ui_gradient = frame:FindFirstChildOfClass('UIGradient')
	local colors, alphas = {}, {}
	local first, last = gradient.stops[1], gradient.stops[#gradient.stops]
	local previous = -1

	local push = function(position, color, transparency)
		if position <= previous then
			position = previous + 0.001
		end

		if position > 1 then
			return
		end

		previous = position

		_insert(colors, ColorSequenceKeypoint.new(position, color))
		_insert(alphas, NumberSequenceKeypoint.new(position, transparency))
	end

	if first.Position > 0 then
		push(0, first.Color, first.Transparency)
	end

	for _, stop in gradient.stops do
		push(stop.Position, stop.Color, stop.Transparency)
	end

	if previous < 1 then
		previous = -1
		push(1, last.Color, last.Transparency)
	end

	ui_gradient.Color = ColorSequence.new(colors)
	ui_gradient.Transparency = NumberSequence.new(alphas)
	ui_gradient.Rotation = gradient.rotation
	frame.Visible = true

	if gradient.animate then
		local base, speed = gradient.rotation, gradient.speed
		local connection = run_service.Heartbeat:Connect(function()
			ui_gradient.Rotation = (base + os.clock() * speed) % 360
		end)

