		-- ===== Wind UI style: checkbox =====
		function group_manager:create_checkbox(flag, _values)
			if _type(flag) == 'table' then
				_values = flag
				flag = _values.flag
			end

			local state = _values.default or _values.Default or false
			local locked = _values.locked == true

			if flag and runtime._flags[flag] ~= nil then
				state = runtime._flags[flag] == true
			end

			local checkbox_frame = create_new('TextButton', {
				BackgroundTransparency = 1,
				LayoutOrder = next_row_order(),
				Size = _new_udim2(1, 0, 0, 24),
				Text = '',
				AutoButtonColor = false,
				BorderSizePixel = 0,
				Parent = group_frame,
			})

			local checkbox_label = create_label({
				Size = _new_udim2(1, -30, 1, 0),
				Text = _tostring(_values.title or ''),
				TextSize = runtime._label_text_size,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Parent = checkbox_frame,
			})

			local box = create_new('Frame', {
				BackgroundColor3 = Color3.fromRGB(40, 40, 40),
				AnchorPoint = _new_vector2(1, 0.5),
				Position = _new_udim2(1, 0, 0.5, 0),
				Size = _new_udim2(0, 18, 0, 18),
				BorderSizePixel = 0,
				Parent = checkbox_frame,
			})

			create_round(box, 4)

			local tick = create_label({
				Size = _new_udim2(1, 0, 1, 0),
				Text = '✓',
				TextColor3 = Color3.fromRGB(18, 18, 18),
				TextSize = runtime._label_text_size,
				Parent = box,
			})

			local checkbox_manager = {}

			local function apply(animate)
				local color = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(40, 40, 40)

				tick.Visible = state
				checkbox_label.TextColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 180)

				local lock_transparency = locked and 0.55 or 0
				checkbox_label.TextTransparency = lock_transparency
				box.BackgroundTransparency = lock_transparency
				tick.TextTransparency = lock_transparency

				if animate then
					_create_tween(tween_service, box, _new_tween_info(0.2), { BackgroundColor3 = color }):Play()
				else
					box.BackgroundColor3 = color
				end
			end

			local function set_state(value, silent, force)
				if locked and not force then
					return
				end

				state = value == true

				apply(true)

				if flag then
					runtime._flags[flag] = state
					runtime:_save()
				end

				if not silent and _values.callback then
					_values.callback(state)
				end
			end

			function checkbox_manager:set_value(value, silent)
				set_state(value, silent, true)
			end

			function checkbox_manager:get_value()
				return state
			end

			function checkbox_manager:set_locked(value)
				locked = value == true
				apply(true)
			end

			checkbox_frame.MouseButton1Click:Connect(function()
				set_state(not state)
			end)

			apply(false)

			if state and _values.callback and _values.fire_default ~= false then
				_values.callback(state)
			end

			return checkbox_manager
		end

