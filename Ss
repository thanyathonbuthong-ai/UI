function library.update_tabs(self: _runtime, tab: tab_typeof)
	for _, tab_data in self._tabs do
		local btn = tab_data._btn

		local tab_icon = btn:FindFirstChildWhichIsA('ImageLabel')
		local tab_label = btn:FindFirstChildWhichIsA('TextLabel')

		if tab_data == tab then
			tab_data._active = true

			_create_tween(tween_service, btn, _new_tween_info(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
				BackgroundTransparency = 0,
			}):Play()

			if tab_label then
				_create_tween(
					tween_service,
					tab_label,
					_new_tween_info(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
					{
						TextColor3 = Color3.fromRGB(255, 255, 255),
					}
				):Play()
			end

			if tab_icon then
				_create_tween(
					tween_service,
					tab_icon,
					_new_tween_info(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
					{
						ImageColor3 = Color3.fromRGB(255, 255, 255),
					}
				):Play()
			end

			local target_y = (btn.AbsolutePosition.Y - self._sidebar.AbsolutePosition.Y + btn.AbsoluteSize.Y / 2)
					/ self._ui_scale
				- 8

			if self._pin.BackgroundTransparency == 1 then
				self._pin.Position = _new_udim2(0, 10, 0, target_y)
				self._pin.BackgroundTransparency = 0
			else
				_create_tween(
					tween_service,
					self._pin,
					_new_tween_info(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
					{
						Position = _new_udim2(0, 10, 0, target_y),
					}
				):Play()
			end

			continue
		end

		if tab_data._active then
			tab_data._active = false

			_create_tween(tween_service, btn, _new_tween_info(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
				BackgroundTransparency = 1,
			}):Play()

			if tab_label then
				_create_tween(
					tween_service,
					tab_label,
					_new_tween_info(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
					{
						TextColor3 = Color3.fromRGB(180, 180, 180),
					}
				):Play()
			end

			if tab_icon then
				_create_tween(
					tween_service,
					tab_icon,
					_new_tween_info(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
					{
						ImageColor3 = Color3.fromRGB(180, 180, 180),
					}
				):Play()
			end
		end
	end
end

function library.update_sections(self: _runtime, left_section: ScrollingFrame, right_section: ScrollingFrame)
	for _, object in self._sections:GetChildren() do
		if object == left_section or object == right_section then
			object.Visible = true

			continue
		end

		object.Visible = false
	end
end

local function resolve_runtime(self: runtime_typeof): _runtime?
	if self ~= library and _type(self) == 'table' and self._tabs then
		return self :: _runtime
	end

	return library._current
end

function library._save_toggle_settings(self: runtime_typeof)
	local runtime = resolve_runtime(self)

	if runtime and runtime._toggle_settings then
		_pcall(function()
			writefile(TOGGLE_SETTINGS_PATH, http_service:JSONEncode(runtime._toggle_settings))
		end)
	end
end

-- ui:set_toggle_icon(123456) / ('rbxassetid://123') / ('https://site/img.png') / ('my_icon.png') / (nil = reset)
function library.set_toggle_icon(self: runtime_typeof, icon, silent)
	local runtime = resolve_runtime(self)

	if not runtime or not runtime._toggle_icon then
		return false
	end

	local image, reason = resolve_toggle_icon(icon)

	if not image then
		if not silent then
			runtime:notify(`icon: {reason}`)
		end

		return false
	end

	runtime._toggle_icon.Image = image
	runtime:_layout_toggle_icon(image == DEFAULT_TOGGLE_ICON)

	local raw = icon ~= nil and _tostring(icon) or ''

	runtime._toggle_settings.icon = raw ~= '' and raw or nil
	runtime:_save_toggle_settings()

	return true
end

-- two looks for the toggle button (setting: button_bg)
--   off (default) = the icon IS the button: no background, icon fills the whole hit area
--   on            = classic round button with background + outline (small glyph, or custom image cropped round)
function library._layout_toggle_icon(self: runtime_typeof, is_default)
	local runtime = resolve_runtime(self)

	if not runtime or not runtime._toggle_icon then
		return
	end

	local icon = runtime._toggle_icon
	local with_background = runtime._toggle_settings.button_bg == true
	local button_size = runtime._toggle_button.Size.X.Offset

	runtime._toggle_button.BackgroundTransparency = with_background and 0 or 1

	if runtime._toggle_bg_stroke then
		runtime._toggle_bg_stroke.Enabled = with_background
	end

	icon.AnchorPoint = _new_vector2(0.5, 0.5)
	icon.Position = _new_udim2(0.5, 0, 0.5, 0)

	if with_background and is_default then
		local glyph = _floor(button_size * DEFAULT_TOGGLE_ICON_SIZE / TOGGLE_BUTTON_SIZE + 0.5)

		icon.Size = _new_udim2(0, glyph, 0, glyph)
		icon.ScaleType = Enum.ScaleType.Fit
		runtime._toggle_icon_corner.CornerRadius = _new_udim(0, 0)
	elseif with_background then
		icon.Size = _new_udim2(1, 0, 1, 0)
		icon.ScaleType = Enum.ScaleType.Crop
		runtime._toggle_icon_corner.CornerRadius = _new_udim(1, 0)
	else
		icon.Size = _new_udim2(1, 0, 1, 0)
		icon.ScaleType = Enum.ScaleType.Fit
		runtime._toggle_icon_corner.CornerRadius = _new_udim(0, 0)
	end
end

-- ui:set_toggle_background(true) = classic button with background, (false) = icon only
function library.set_toggle_background(self: runtime_typeof, state)
	local runtime = resolve_runtime(self)

	if not runtime or not runtime._toggle_icon then
		return false
