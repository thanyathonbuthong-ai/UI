					theme_dropdown:set_options(library.list_themes(), result)
					self:set_theme(result)
					import_box:clear()
					self:notify('Theme imported: ' .. result)
				else
					self:notify('Import failed: ' .. _tostring(result))
				end
			end,
		})

		-- keeps the dropdown and the pickers in sync when the theme is changed from code
		library.on_theme_change(function(name)
			if theme_registry[name] and not theme_registry[name].Hidden then
				if _find(library.list_themes(), name) then
					theme_dropdown:set_value(name, true)
				else
					theme_dropdown:set_options(library.list_themes(), name)
				end

				load_draft(name)
			end
		end)
	end

