				-- refused because a theme is active: do not leave the link in the box
				if theme_name ~= 'Dark' and background_box then
					background_box:clear()
				end
			end,
		})

		background_group:create_slider('ui_background_transparency', {
			title = 'Background Transparency (%)',
			minimum = 0,
