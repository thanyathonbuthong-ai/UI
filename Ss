-- ui:set_theme('Rose')   (Wind UI: WindUI:SetTheme('Rose'))
-- a theme can NOT be set while a background image is active ('Dark' = no theme is always allowed)
function library.set_theme(self, name)
	name = theme_arg(self, name)

	if _type(name) ~= 'string' or not theme_registry[name] then
		return false, 'unknown theme'
	end

	local runtime = (_type(self) == 'table' and self._tabs ~= nil) and self or library._current

	if name ~= 'Dark' and runtime and runtime._toggle_settings and runtime._toggle_settings.background then
		theme_gradient.notify(runtime, 'Remove the background image first to use a theme')

		return false, 'background active'
	end

	local old_rev = theme_set_active(name)

	if runtime and runtime._ui then
		theme_recolor(runtime._ui, old_rev)

		if runtime._toggle_button then
			theme_recolor(runtime._toggle_button:FindFirstAncestorOfClass('ScreenGui'), old_rev)
		end
	end

	_pcall(theme_gradient.apply, runtime)

	if not theme_registry[name].Hidden then
		theme_saved.current = name
		theme_write()
	end

	theme_fire()

	return true
end

-- ui:add_theme({ Name = 'My Theme', Accent = Color3.fromHex('#18181b'), Background = ..., Outline = ..., Text = ..., Placeholder = ..., Button = ..., Icon = ... })
function library.add_theme(self, def)
	def = theme_arg(self, def)

	if _type(def) ~= 'table' then
		return false, 'theme must be a table'
	end

	theme_register(def, def.Save == true)

	return true
end

function library.remove_theme(self, name)
	name = theme_arg(self, name)

	if _type(name) ~= 'string' or not theme_registry[name] or theme_registry[name].Legacy then
		return false
	end

	if theme_name == name then
		library.set_theme('Dark')
	end

	theme_registry[name] = nil
	theme_saved.custom[name] = nil

	local index = _find(theme_order, name)

	if index then
		table.remove(theme_order, index)
	end

	theme_write()

	return true
end

-- name -> theme table (like WindUI:GetThemes())
function library.get_themes(_self)
	local result = {}

	for _, name in theme_order do
		if not theme_registry[name].Hidden then
			result[name] = shallow_copy_theme(theme_registry[name])
		end
	end

	return result
end

