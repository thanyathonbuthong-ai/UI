				return Enum.KeyCode[minimize_flag]
			end)

			if success then
				minimize_key = result
			end
		end

		if input.KeyCode == minimize_key then
			self._ui_open = not self._ui_open

			self:change_visibility(self._ui_open)
		end
	end)

