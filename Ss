			_values = _values or {}

			local has_transparency = _values.transparency == true
			local current_color = _values.default or Color3.new(1, 1, 1)
			local current_alpha = 1

			if flag and runtime._flags[flag] ~= nil then
				local saved = runtime._flags[flag]

				if _type(saved) == 'table' then
					local r = _clamp(tonumber(saved.r or saved[1]) or 255, 0, 255)
					local g = _clamp(tonumber(saved.g or saved[2]) or 255, 0, 255)
					local b = _clamp(tonumber(saved.b or saved[3]) or 255, 0, 255)
					current_color = Color3.fromRGB(r, g, b)

