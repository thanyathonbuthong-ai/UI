			end,
		})

		name_group:create_button({
			title = 'Remove Title Icon',
			callback = function()
				title_icon_box:clear()
				self:set_ui_icon(nil)
			end,
		})
	end

	if not self:_find_group(configs, 'ui background', 'left') then
		local background_group = configs:create_group('ui background', 'left')

		local background_box

		background_box = background_group:create_textbox('ui_background_input', {
			title = 'Background (id / link / file)',
			placeholder = 'rbxassetid, image link or file name',
			default = self._toggle_settings.background or '',
