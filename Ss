	local tag_label = create_label({
		LayoutOrder = 1,
		Size = _new_udim2(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Text = _tostring(_values.title or _values.text or ''),
		TextColor3 = _values.text_color or Color3.fromRGB(220, 220, 220),
		TextSize = self._small_text_size + 2,
		ZIndex = 8,
		Parent = tag,
	})

