						{ title = 'Cancel', variant = 'tertiary' },
						{ title = 'Later', variant = 'secondary' },
						{ title = 'OK', variant = 'Primary', callback = function() say('Popup', 'กด OK') end },
					},
				})
			end },
			{ title = 'Notify', callback = function()
				ui:notify({ title = 'Can Close', content = 'แตะที่แจ้งเตือนเพื่อปิดได้', duration = 6, can_close = true })
			end },
		},
	})

	wind_right:create_section({ title = 'Element controls' })
	local ctrl_toggle = wind_right:create_toggle('wind_ctrl_toggle', {
		title = 'Toggle ที่ถูกควบคุม',
		desc = 'ใช้ปุ่มด้านล่างสั่ง lock / hide / เปลี่ยนชื่อ',
		default = false,
	})
	local ctrl_dropdown = wind_right:create_dropdown('wind_ctrl_dropdown', {
		title = 'Dropdown ที่ถูกควบคุม',
		options = { 'One', 'Two', 'Three' },
		default = 'One',
	})
	wind_right:create_button_row({
		{ title = 'Lock', callback = function() ctrl_toggle:lock() ctrl_dropdown:lock() end },
		{ title = 'Unlock', callback = function() ctrl_toggle:unlock() ctrl_dropdown:unlock() end },
	})
	wind_right:create_button_row({
		{ title = 'Hide', callback = function() ctrl_toggle:set_visible(false) end },
		{ title = 'Show', callback = function() ctrl_toggle:set_visible(true) end },
		{ title = 'Rename', callback = function() ctrl_toggle:set_title('ชื่อใหม่ ' .. math.random(1, 99)) end },
	})

	wind_right:create_section({ title = 'Keybind (set / get)' })
	local ctrl_keybind = wind_right:create_keybind('wind_keybind', {
		title = 'Keybind',
		default = 'H',
		callback = function(key_name)
			say('Keybind', 'กด ' .. tostring(key_name))
		end,
	})
	wind_right:create_button({
		title = 'Set keybind = J',
		callback = function()
			ctrl_keybind:set_value('J')
			say('Keybind', 'ตอนนี้ = ' .. ctrl_keybind:get_value())
		end,
	})

	-- ===== Tab 3: ทดลองเปลี่ยนไอคอน / พื้นหลัง =====
	local icon_tab = demo:create_tab('Icons', 'rbxassetid://10734941499')

	local toggle_group = icon_tab:create_group('toggle button', 'left')

	toggle_group:create_section({ title = 'Main toggle button' })
	toggle_group:create_textbox('demo_icon_input', {
		title = 'Icon (id / link / file)',
		placeholder = '6523858394',
		height = 24,
		compact = true,
		multi_line = false,
		callback = function(value)
			ui:set_toggle_icon(value)
		end,
	})
	toggle_group:create_button({
		title = 'Icon = 6523858394',
		callback = function()
			ui:set_toggle_icon(6523858394)
		end,
	})
	toggle_group:create_button({
		title = 'Reset toggle icon',
		callback = function()
			ui:set_toggle_icon(nil)
		end,
	})
	toggle_group:create_toggle('demo_toggle_bg', {
		title = 'Button Background',
		default = false,
		callback = function(state)
			if ui._unloaded then
				return
			end

			ui:set_toggle_background(state)
		end,
	})
	toggle_group:create_slider('demo_toggle_size', {
		title = 'Button Size',
		minimum = 30,
		maximum = 90,
		default = 50,
		callback = function(value)
			ui:set_toggle_button_size(value)
		end,
	})
	toggle_group:create_button({
		title = 'Reset Position',
		callback = function()
			ui:reset_toggle_position()
		end,
	})

	local window_group = icon_tab:create_group('window', 'right')

	window_group:create_section({ title = 'Title' })
	window_group:create_textbox('demo_name_input', {
		title = 'Menu Name',
		placeholder = 'My Hub',
		height = 24,
		compact = true,
		multi_line = false,
		callback = function(value)
			ui:set_ui_name(value)
		end,
	})
	window_group:create_textbox('demo_title_icon_input', {
		title = 'Title Icon',
		placeholder = '6523858394',
		height = 24,
		compact = true,
		multi_line = false,
		callback = function(value)
			ui:set_ui_icon(value)
		end,
	})
	window_group:create_slider('demo_title_icon_size', {
		title = 'Title Icon Size',
		minimum = 14,
		maximum = 34,
		default = 22,
		callback = function(value)
			ui:set_ui_icon_size(value)
		end,
	})

	window_group:create_section({ title = 'Background' })
	window_group:create_textbox('demo_bg_input', {
		title = 'Background (id / link / file)',
		placeholder = 'rbxassetid://123456',
		height = 24,
		compact = true,
		multi_line = false,
		callback = function(value)
			ui:set_background(value)
		end,
	})
	window_group:create_slider('demo_bg_transparency', {
		title = 'Background Transparency (%)',
		minimum = 0,
		maximum = 100,
		default = 60,
		callback = function(value)
			ui:set_background_transparency(value / 100)
		end,
	})
	window_group:create_button({
		title = 'Remove Background',
		callback = function()
			ui:set_background(nil)
		end,
	})

	-- ===== Tab 4: ควบคุม UI =====
	local control_tab = demo:create_tab('Control', 'rbxassetid://10709781717')

	local control_group = control_tab:create_group('ui control', 'left')

	control_group:create_button({
		title = 'Hide UI (แตะปุ่มไอคอนเพื่อเปิดกลับ)',
		callback = function()
			ui._ui_open = false
			ui:change_visibility(false)
		end,
	})
	control_group:create_button({
		title = 'Unload UI',
		callback = function()
			ui:unload()
		end,
	})

	ui:on_unload(function()
		print('demo unloaded')
	end)

	-- เมนู Configs / Lua (ตั้งค่าไอคอน, พื้นหลัง, โหลดสคริป)
	ui:load_manager()
end

return library
