-- 🔘  BUTTON TYPE 7 — ปุ่มสลับ (Toggle Switch เปลี่ยนสีตามสถานะ)
--══════════════════════════════════════════════════════════════════

function Aurora:CreateToggle(config)
    config = config or {}
    local gradColors = Aurora.Gradients[config.Gradient or "PurpleBlue"] or self.Gradient
    local state = config.Default or false
    local flag = config.Flag

    local Row = New("Frame", {
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundTransparency = 1,
        Parent = self.Holder,
    })
    New("TextLabel", {
        Text = config.Text or "Toggle Option",
        Font = Aurora.Theme.Font,
        TextSize = 14,
        TextColor3 = Aurora.Theme.TextPrimary,
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -60, 1, 0),
        Parent = Row,
    })

    local Track = New("Frame", {
        Size = UDim2.new(0, 46, 0, 24),
        Position = UDim2.new(1, -46, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        BackgroundColor3 = Color3.fromRGB(70, 65, 90),
        Parent = Row,
    }, { Corner(12) })

    local Knob = New("Frame", {
        Size = UDim2.new(0, 18, 0, 18),
        Position = UDim2.new(0, 3, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        Parent = Track,
    }, { Corner(9) })

    local Click = New("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1,0,1,0), Parent = Track })

    local function render(animate)
        local ti = animate and { time = 0.2 } or { time = 0 }
        if state then
            Tween(Knob, ti, { Position = UDim2.new(1, -21, 0.5, 0) })
            Tween(Track, ti, { BackgroundColor3 = gradColors[2] })
            local g = Track:FindFirstChildOfClass("UIGradient")
            if not g then Gradient(gradColors, 0).Parent = Track end
        else
            Tween(Knob, ti, { Position = UDim2.new(0, 3, 0.5, 0) })
            local g = Track:FindFirstChildOfClass("UIGradient")
            if g then g:Destroy() end
            Tween(Track, ti, { BackgroundColor3 = Color3.fromRGB(70, 65, 90) })
        end
    end
    render(false)

    Click.MouseButton1Click:Connect(function()
        state = not state
        render(true)
        if flag then Aurora.Flags[flag] = state end
        if config.Callback then config.Callback(state) end
    end)

    return { Set = function(_, v) state = v; render(true) end, Get = function() return state end }
end

