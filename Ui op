-- 🌈  SLIDER (แถบเลื่อน ไล่สีรุ้ง)
--══════════════════════════════════════════════════════════════════

function Aurora:CreateSlider(config)
    config = config or {}
    local min, max = config.Min or 0, config.Max or 100
    local default = config.Default or min
    local suffix = config.Suffix or ""
    local flag = config.Flag

    local Row = New("Frame", {
        Size = UDim2.new(1, 0, 0, 50),
        BackgroundTransparency = 1,
        Parent = self.Holder,
    })
    New("TextLabel", {
        Text = config.Text or "Slider",
        Font = Aurora.Theme.Font,
        TextSize = 14,
        TextColor3 = Aurora.Theme.TextPrimary,
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Size = UDim2.new(0.6, 0, 0, 18),
        Parent = Row,
    })
    local ValueLabel = New("TextLabel", {
        Text = tostring(default) .. suffix,
        Font = Aurora.Theme.FontSemibold,
        TextSize = 13,
        TextColor3 = Aurora.Theme.TextSecondary,
        TextXAlignment = Enum.TextXAlignment.Right,
        BackgroundTransparency = 1,
        Size = UDim2.new(0.4, 0, 0, 18),
        Position = UDim2.new(0.6, 0, 0, 0),
        Parent = Row,
    })

    local Track = New("Frame", {
        Size = UDim2.new(1, 0, 0, 10),
        Position = UDim2.new(0, 0, 0, 30),
        BackgroundColor3 = Color3.fromRGB(60, 55, 80),
        Parent = Row,
    }, { Corner(5) })

    local pct = (default - min) / (max - min)
    local Fill = New("Frame", {
        Size = UDim2.new(pct, 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        Parent = Track,
    }, { Corner(5) })
    Gradient(Aurora.Rainbow, 0).Parent = Fill

    local Knob = New("Frame", {
        Size = UDim2.new(0, 16, 0, 16),
        Position = UDim2.new(pct, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        Parent = Track,
    }, { Corner(8), Stroke(Color3.fromRGB(255,255,255), 2, 0.3) })

    local dragging = false
    local function updateFromInput(inputPos)
        local relX = math.clamp((inputPos.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
        local value = math.floor(min + (max - min) * relX + 0.5)
        Fill.Size = UDim2.new(relX, 0, 1, 0)
        Knob.Position = UDim2.new(relX, 0, 0.5, 0)
        ValueLabel.Text = tostring(value) .. suffix
        if flag then Aurora.Flags[flag] = value end
        if config.Callback then config.Callback(value) end
    end

    Track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromInput(input.Position)
        end
    end)
    Track.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromInput(input.Position)
        end
    end)

    return { Set = function(_, v) updateFromInput(Vector2.new(Track.AbsolutePosition.X + (v-min)/(max-min)*Track.AbsoluteSize.X, 0)) end }
end

