-- 🔘  BUTTON TYPE 4 — ปุ่มแท็บ (ทรงยาวโค้งมน เลือกหมวดหมู่)
--══════════════════════════════════════════════════════════════════

function Aurora:CreatePillTabs(config)
    config = config or {}
    local options = config.Options or {"A", "B", "C"}
    local gradColors = Aurora.Gradients[config.Gradient or "BluePurple"] or self.Gradient
    local default = config.Default or options[1]

    local Row = New("Frame", {
        Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = Aurora.Theme.GlassBG,
        BackgroundTransparency = 0.75,
        Parent = self.Holder,
    }, { Corner(19), Padding(4) })
    New("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }).Parent = Row

    local buttons = {}
    for _, opt in ipairs(options) do
        local Pill = New("TextButton", {
            Text = "",
            Size = UDim2.new(1 / #options, -3, 1, 0),
            BackgroundColor3 = Color3.fromRGB(255,255,255),
            BackgroundTransparency = 1,
            AutoButtonColor = false,
            Parent = Row,
        }, { Corner(15) })
        local lbl = New("TextLabel", {
            Text = opt,
            Font = Aurora.Theme.FontSemibold,
            TextSize = 13,
            TextColor3 = Aurora.Theme.TextSecondary,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0),
            Parent = Pill,
        })
        buttons[opt] = { pill = Pill, label = lbl }

        Pill.MouseButton1Click:Connect(function()
            for name, b in pairs(buttons) do
                Tween(b.pill, {time=0.2}, { BackgroundTransparency = 1 })
                local g = b.pill:FindFirstChildOfClass("UIGradient")
                if g then g:Destroy() end
                Tween(b.label, {time=0.2}, { TextColor3 = Aurora.Theme.TextSecondary })
            end
            Tween(Pill, {time=0.2}, { BackgroundTransparency = 0 })
            Gradient(gradColors, 45).Parent = Pill
            Tween(lbl, {time=0.2}, { TextColor3 = Color3.fromRGB(255,255,255) })
            if config.Callback then config.Callback(opt) end
        end)
    end

    if buttons[default] then
        task.defer(function() buttons[default].pill.MouseButton1Click:Fire() end)
    end

    return Row
end

