-- 🛠️  UTILITY FUNCTIONS
--══════════════════════════════════════════════════════════════════

local function New(class, props, children)
    local inst = Instance.new(class)
    for prop, value in pairs(props or {}) do
        inst[prop] = value
    end
    for _, child in ipairs(children or {}) do
        child.Parent = inst
    end
    return inst
end

local function Tween(obj, info, props)
    local ti = typeof(info) == "table"
        and TweenInfo.new(info.time or 0.2, info.style or Enum.EasingStyle.Quint, info.dir or Enum.EasingDirection.Out)
        or info
    local tw = TweenService:Create(obj, ti, props)
    tw:Play()
    return tw
end

local function Corner(radius)
    return New("UICorner", { CornerRadius = UDim.new(0, radius or 16) })
end

local function Stroke(color, thickness, transparency)
    return New("UIStroke", {
        Color = color or Aurora.Theme.StrokeColor,
        Thickness = thickness or 1,
        Transparency = transparency or Aurora.Theme.StrokeTransparency,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })
end

local function Gradient(colorTable, rotation)
    local seq = {}
    local step = 1 / (#colorTable - 1)
    for i, c in ipairs(colorTable) do
        table.insert(seq, ColorSequenceKeypoint.new(step * (i - 1), c))
    end
    return New("UIGradient", { Color = ColorSequence.new(seq), Rotation = rotation or 45 })
end

local function Padding(all)
    return New("UIPadding", {
        PaddingTop = UDim.new(0, all), PaddingBottom = UDim.new(0, all),
        PaddingLeft = UDim.new(0, all), PaddingRight = UDim.new(0, all),
    })
end

-- แผงกระจก (Glassmorphism panel): พื้นโปร่งแสง ขอบขาวใส เงานุ่ม
local function GlassPanel(props)
    props = props or {}
    local frame = New("Frame", {
        Name = props.Name or "Glass",
        BackgroundColor3 = props.Color or Aurora.Theme.GlassBG,
        BackgroundTransparency = props.Transparency or Aurora.Theme.GlassTransparency,
        BorderSizePixel = 0,
        Size = props.Size or UDim2.new(1, 0, 1, 0),
        Position = props.Position,
        AnchorPoint = props.AnchorPoint,
    }, {
        Corner(props.Radius or 20),
        Stroke(Aurora.Theme.StrokeColor, 1, Aurora.Theme.StrokeTransparency),
    })
    -- ไฮไลต์บาง ๆ ที่ขอบบนให้ดูเหมือนกระจกสะท้อนแสง
    local sheen = New("Frame", {
        Name = "Sheen",
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BackgroundTransparency = 0.9,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 1),
        Position = UDim2.new(0, 0, 0, 0),
    })
    sheen.Parent = frame
    return frame
end

-- เอฟเฟกต์เรืองแสง (glow) รอบวัตถุ ด้วยภาพเบลอที่ขยายใหญ่กว่าวัตถุเล็กน้อย
local function AttachGlow(parent, color, intensity, size)
    local glow = New("ImageLabel", {
        Name = "Glow",
        Image = GLOW_IMAGE,
        ImageColor3 = color,
        ImageTransparency = intensity or 0.55,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(90, 90, 90, 90),
        BackgroundTransparency = 1,
        Size = size or UDim2.new(1, 40, 1, 40),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        ZIndex = -1,
    })
    glow.Parent = parent
    return glow
end

-- ทำให้วัตถุขยาย/สว่างขึ้นเมื่อ hover (รองรับ touch ด้วย)
local function HoverScale(obj, glow, scaleUp)
    scaleUp = scaleUp or 1.045
    local baseSize = obj.Size
    local entered = false
    local function grow()
        if entered then return end
        entered = true
        Tween(obj, { time = 0.18 }, { Size = UDim2.new(
            baseSize.X.Scale * scaleUp, baseSize.X.Offset * scaleUp,
            baseSize.Y.Scale * scaleUp, baseSize.Y.Offset * scaleUp) })
        if glow then Tween(glow, { time = 0.18 }, { ImageTransparency = 0.25 }) end
    end
    local function shrink()
        entered = false
        Tween(obj, { time = 0.18 }, { Size = baseSize })
        if glow then Tween(glow, { time = 0.18 }, { ImageTransparency = 0.55 }) end
    end
    obj.MouseEnter:Connect(grow)
    obj.MouseLeave:Connect(shrink)
    obj.MouseButton1Down:Connect(function()
        Tween(obj, { time = 0.08 }, { Size = baseSize })
    end)
    obj.MouseButton1Up:Connect(grow)
    return grow, shrink
end

-- ทำให้เฟรมลากได้ ทั้งเมาส์และนิ้ว
local function MakeDraggable(topbar, target)
    local dragging, dragInput, dragStart, startPos
    topbar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = target.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    topbar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            target.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

