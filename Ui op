function Aurora:CreateTab(config)
    config = config or {}
    local name = config.Name or "Tab"
    local icon = config.Icon or ICONS.home
    local gradientKey = config.Gradient or "PurpleBlue"
    local gradColors = Aurora.Gradients[gradientKey]

    local layoutOrder = #self._tabButtons + 1

    local Btn = New("Frame", {
        Name = name .. "TabBtn",
        Size = IsMobile and UDim2.new(0, 44, 0, 44) or UDim2.new(1, -8, 0, 44),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        BackgroundTransparency = 1,
        LayoutOrder = layoutOrder,
        Parent = self.Sidebar,
    }, { Corner(14) })

    local IconHolder = New("Frame", {
        Size = UDim2.new(0, 30, 0, 30),
        Position = IsMobile and UDim2.new(0.5, 0, 0.5, 0) or UDim2.new(0, 8, 0.5, 0),
        AnchorPoint = IsMobile and Vector2.new(0.5, 0.5) or Vector2.new(0, 0.5),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        BackgroundTransparency = 0.85,
        Parent = Btn,
    }, { Corner(9) })
    Gradient(gradColors, 45).Parent = IconHolder

    local Icon = New("ImageLabel", {
        Image = icon,
        Size = UDim2.new(0, 18, 0, 18),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundTransparency = 1,
        ImageColor3 = Color3.fromRGB(255,255,255),
        Parent = IconHolder,
    })

    local Label
    if not IsMobile then
        Label = New("TextLabel", {
            Text = name,
            Font = Aurora.Theme.FontSemibold,
            TextSize = 13,
            TextColor3 = Aurora.Theme.TextSecondary,
            TextXAlignment = Enum.TextXAlignment.Left,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -50, 1, 0),
            Position = UDim2.new(0, 46, 0, 0),
            Parent = Btn,
        })
    end

    local ClickArea = New("TextButton", {
        Text = "", BackgroundTransparency = 1, Size = UDim2.new(1,0,1,0), Parent = Btn,
    })

    -- Page สำหรับแท็บนี้
    local Page = New("ScrollingFrame", {
        Name = name .. "Page",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = gradColors[1],
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        Parent = self.ContentArea,
    })
    local PageList = New("UIListLayout", {
        Padding = UDim.new(0, 14),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })
    PageList.Parent = Page

    table.insert(self._tabButtons, Btn)
    self._tabPages[name] = Page

    local function selectTab()
        for tname, p in pairs(self._tabPages) do p.Visible = (tname == name) end
        for _, b in ipairs(self._tabButtons) do
            Tween(b, {time=0.2}, { BackgroundTransparency = 1 })
            local lbl = b:FindFirstChildOfClass("TextLabel")
            if lbl then Tween(lbl, {time=0.2}, { TextColor3 = Aurora.Theme.TextSecondary }) end
        end
        Tween(Btn, {time=0.2}, { BackgroundTransparency = 0.85 })
        if Label then Tween(Label, {time=0.2}, { TextColor3 = Aurora.Theme.TextPrimary }) end
        self._activeTab = name
    end

    ClickArea.MouseButton1Click:Connect(selectTab)
    ClickArea.MouseEnter:Connect(function()
        if self._activeTab ~= name then Tween(Btn, {time=0.15}, { BackgroundTransparency = 0.93 }) end
    end)
    ClickArea.MouseLeave:Connect(function()
        if self._activeTab ~= name then Tween(Btn, {time=0.15}, { BackgroundTransparency = 1 }) end
    end)

    if #self._tabButtons == 1 then selectTab() end

    --── Tab object: ใช้สร้าง Section / Components ต่อ ──
    local Tab = setmetatable({ Page = Page, Gradient = gradColors }, Aurora)
    return Tab
end

