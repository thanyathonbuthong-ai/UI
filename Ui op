-- 🔔  NOTIFICATION (แจ้งเตือนแบบกระจก มุมขวาบน)
--══════════════════════════════════════════════════════════════════

function Aurora:Notify(config)
    config = config or {}
    local gradColors = Aurora.Gradients[config.Gradient or "PurpleBlue"]
    local gui = CoreGui:FindFirstChild("AuroraUI")
    if not gui then return end

    local Notif = New("Frame", {
        Size = UDim2.new(0, 300, 0, 0),
        Position = UDim2.new(1, -320, 0, 20),
        BackgroundColor3 = Aurora.Theme.GlassBG,
        BackgroundTransparency = 0.25,
        AutomaticSize = Enum.AutomaticSize.Y,
        ZIndex = 50,
        Parent = gui,
    }, { Corner(16), Stroke(Color3.fromRGB(255,255,255), 1, 0.75), Padding(14) })

    local bar = New("Frame", {
        Size = UDim2.new(0, 4, 1, 0),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        Parent = Notif,
    }, { Corner(2) })
    Gradient(gradColors, 90).Parent = bar

    New("TextLabel", {
        Text = config.Title or "Notification",
        Font = Aurora.Theme.FontBold,
        TextSize = 14,
        TextColor3 = Aurora.Theme.TextPrimary,
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -12, 0, 18),
        Position = UDim2.new(0, 12, 0, 0),
        Parent = Notif,
    })
    New("TextLabel", {
        Text = config.Text or "",
        Font = Aurora.Theme.Font,
        TextSize = 12,
        TextWrapped = true,
        TextColor3 = Aurora.Theme.TextSecondary,
        TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -12, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Position = UDim2.new(0, 12, 0, 20),
        Parent = Notif,
    })

    Notif.Position = UDim2.new(1, 20, 0, 20)
    Tween(Notif, { time = 0.3 }, { Position = UDim2.new(1, -320, 0, 20) })
    task.delay(config.Duration or 3.5, function()
        Tween(Notif, { time = 0.3 }, { Position = UDim2.new(1, 20, 0, 20) })
        task.wait(0.3)
        Notif:Destroy()
    end)
end

return Aurora
