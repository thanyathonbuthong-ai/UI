    -- sidebar search: filters tabs by tab / section / element name
    local function apply_search()
        local q = string.lower((string.gsub(search_input.Text, "^%s*(.-)%s*$", "%1")))
        for _, tab in ipairs(library.tabs or {}) do
            if not tab.hidden and tab.tab_button then
                local match = q == "" or string.find(string.lower(tab.name), q, 1, true) ~= nil
                if not match then
                    for _, sec in next, tab.sections do
                        if string.find(string.lower(sec.name or ""), q, 1, true) then match = true break end
                        for _, el in next, (sec.elements or {}) do
                            if el.name and string.find(string.lower(tostring(el.name)), q, 1, true) then match = true break end
                        end
                        if match then break end
                    end
                end
                tab.tab_button.Visible = match
            end
        end
        for _, ex in ipairs(library.tab_extras) do
            if ex and ex.Parent then ex.Visible = (q == "") end
        end
    end
