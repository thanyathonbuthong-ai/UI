            bind_btn.Text = key_name
            library.flags[cfg.flag.."_key"] = key_name
            
            if cfg.bind_conn then cfg.bind_conn:Disconnect() end
            if cfg.key ~= Enum.KeyCode.Unknown then
                cfg.bind_conn = uis.InputBegan:Connect(function(input, gpe)
                    if gpe then return end
                    if (cfg.key.EnumType == Enum.KeyCode and input.KeyCode == cfg.key) or (cfg.key.EnumType == Enum.UserInputType and input.UserInputType == cfg.key) then
                        if type(cfg.callback) == "function" then cfg.callback() end
                    end
                end)
            end
        end

        self:connection(remove_btn.MouseButton1Click, function()
            toggle_bind_input(Enum.KeyCode.Unknown)
        end)

        self:connection(bind_btn.MouseButton1Click, function()
            bind_btn.Text = "..."
            cfg.binding = true
            local conn
            conn = uis.InputBegan:Connect(function(input)
                if cfg.binding then
                    local valid_input = false
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        valid_input = true
                        toggle_bind_input(input.KeyCode)
                    elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then
                        valid_input = true
                        toggle_bind_input(input.UserInputType)
                    end
                    if valid_input then
                        cfg.binding = false
                        if conn then conn:Disconnect() end
                    end
                end
            end)
        end)

        local function update_popup_pos()
            local btn_pos = settings_btn.AbsolutePosition
            local btn_size = settings_btn.AbsoluteSize
            popup_frame.Position = UDim2.new(0, btn_pos.X - 180, 0, btn_pos.Y + btn_size.Y + 4)
        end

        self:connection(settings_btn.MouseButton1Click, function()
            expanded = not expanded
            current_rot += 360
            tween_service:Create(settings_btn, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Rotation = current_rot}):Play()
            
            if expanded then
                popup_frame.Visible = true
                popup_frame.Size = UDim2.new(0, 200, 0, 0)
                update_popup_pos()
                update_popup_size()
            else
                tween_service:Create(popup_frame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Size = UDim2.new(0, 200, 0, 0)}):Play()
                task.delay(0.3, function() 
                    if not expanded then 
                        popup_frame.Visible = false 
                    end 
                end)
            end
        end)

        self:connection(settings_btn:GetPropertyChangedSignal("AbsolutePosition"), function()
            if popup_frame.Visible then
                update_popup_pos()
            end
        end)

        toggle_bind_input(cfg.default_key)
        
        library.config_flags[cfg.flag.."_key"] = function(val) toggle_bind_input(val) end
    end

    self:connection(btn.MouseButton1Down, function()
        tween(btn, 0.1, { BackgroundTransparency = card.base - 0.07 }):Play()
    end)
    self:connection(btn.MouseButton1Up, function()
        tween(btn, 0.15, { BackgroundTransparency = card.base - 0.03 }):Play()
    end)
    self:connection(btn.MouseButton1Click, function()
        if type(cfg.callback) == "function" then cfg.callback() end
    end)
    if self.elements then table.insert(self.elements, cfg) end
    return cfg
end

function library:keybind(props)
    local cfg = {
        name = props.name or "keybind",
        desc = props.desc or props.description,
        default = props.default or Enum.KeyCode.Unknown,
        flag = props.flag or props.name or "keybind_"..tostring(math.random(1, 100000)),
        callback = props.callback or function() end,
        binding = false,
        conn = nil
    }

    local card = self:element_card({ name = cfg.name, desc = cfg.desc, reserve = 90 })
    local bind_frame = card.frame

    local bind_btn = self:create("TextButton", {
        Name = "bind",
        Parent = bind_frame,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.new(0, 0, 0, 26),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundColor3 = self.themes.preset.outline,
        BackgroundTransparency = 0.9,
        Text = "",
        AutoButtonColor = false,
        BorderSizePixel = 0
    })
    self:create("UICorner", { Parent = bind_btn, CornerRadius = UDim.new(0, 8) })
    local bind_stroke = self:create("UIStroke", { Parent = bind_btn, Color = self.themes.preset.outline, Thickness = 1, Transparency = 0.9 })
    self:create("UISizeConstraint", { Parent = bind_btn, MinSize = Vector2.new(46, 26) })
    self:create("UIPadding", { Parent = bind_btn, PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) })

    local bind_text = self:create("TextLabel", {
        Name = "text",
        Parent = bind_btn,
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 0, 1, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        FontFace = library:font(Enum.FontWeight.Medium),
        Text = "...",
        TextColor3 = self.themes.preset.text,
        TextSize = 12
    })

    local function set_binding_look(state)
        tween(bind_btn, 0.2, { BackgroundTransparency = state and 0.78 or 0.9 }):Play()
        tween(bind_stroke, 0.2, { Transparency = state and 0.6 or 0.9 }):Play()
    end

    local function get_key_name(key)
        if typeof(key) == "EnumItem" then
            return key.Name
        end
        return tostring(key)
    end

    local function bind_input(key)
        if typeof(key) == "string" then
            local k = Enum.KeyCode[key] or Enum.UserInputType[key]
            if k then key = k else return end
        end

        cfg.key = key
        local key_name = get_key_name(key)
        library.flags[cfg.flag] = key_name
        bind_text.Text = key_name

        if cfg.conn then cfg.conn:Disconnect() end
        cfg.conn = uis.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            local pressed = false
            if key.EnumType == Enum.KeyCode and input.KeyCode == key then
                pressed = true
            elseif key.EnumType == Enum.UserInputType and input.UserInputType == key then
                pressed = true
            end
            if pressed then
                if type(cfg.callback) == "function" then cfg.callback() end
            end
        end)
    end

    self:connection(bind_btn.MouseButton1Click, function()
        bind_text.Text = "..."
        set_binding_look(true)
        cfg.binding = true
        local conn
        conn = uis.InputBegan:Connect(function(input)
            if cfg.binding then
                local valid_input = false
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    valid_input = true
                    bind_input(input.KeyCode)
                elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then
                    valid_input = true
                    bind_input(input.UserInputType)
                end
                if valid_input then
                    cfg.binding = false
                    set_binding_look(false)
                    if conn then conn:Disconnect() end
                end
            end
        end)
    end)

    bind_input(cfg.default)
    library.config_flags[cfg.flag] = function(val)
        bind_input(val)
    end
    if self.elements then table.insert(self.elements, cfg) end
    return setmetatable(cfg, { __index = self })
end

function library:dropdown(props)
    local cfg = {
        name = props.name or "dropdown",
        desc = props.desc or props.description,
        options = props.options or {},
        default = props.default or (props.options and props.options[1] or nil),
        flag = props.flag or props.name or "dropdown_"..tostring(math.random(1, 100000)),
        callback = props.callback or function() end,
        open = false,
        multiple = props.multiple or false,
        search = props.search
    }

    local POPUP_W = 176
    local ROW_H = 30
    local MAX_LIST_H = 190

    local card = self:element_card({ name = cfg.name, desc = cfg.desc, reserve = 146 })
    local dd_frame = card.frame

    local dd_btn = self:create("TextButton", {
        Name = "select",
        Parent = dd_frame,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.new(0, 136, 0, 28),
        BackgroundColor3 = self.themes.preset.outline,
        BackgroundTransparency = 0.92,
        Text = "",
        BorderSizePixel = 0,
        AutoButtonColor = false
    })
    self:create("UICorner", { Parent = dd_btn, CornerRadius = UDim.new(0, 8) })
    local dd_stroke = self:create("UIStroke", { Parent = dd_btn, Color = self.themes.preset.outline, Thickness = 1, Transparency = 0.9 })

    local dd_text = self:create("TextLabel", {
        Name = "val",
        Parent = dd_btn,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 10, 0, 0),
        Size = UDim2.new(1, -32, 1, 0),
        FontFace = library:font(Enum.FontWeight.Medium),
        Text = "...",
        TextColor3 = self.themes.preset.text,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd
    })

    local dd_icon = self:create("ImageLabel", {
        Name = "icon",
        Parent = dd_btn,
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(1, -16, 0.5, 0),
        Size = UDim2.new(0, 14, 0, 14),
        Image = self:get_icon("down"),
        ImageColor3 = self.themes.preset.text,
        ImageTransparency = 0.4
    })

    -- floating menu (windui style): lives on the gui root so it never resizes the page
    local use_search = cfg.search
    if use_search == nil then use_search = #cfg.options > 10 end
    local search_h = use_search and 34 or 0

    local popup = self:create("Frame", {
        Name = "dropdown_popup",
        Parent = self.gui,
        Visible = false,
        Size = UDim2.new(0, POPUP_W, 0, 0),
        BackgroundColor3 = self.themes.preset.sidebar,
        BorderSizePixel = 0,
        ZIndex = 100,
        ClipsDescendants = true
    })
    self:create("UICorner", { Parent = popup, CornerRadius = UDim.new(0, 12) })
    self:create("UIStroke", { Parent = popup, Color = self.themes.preset.outline, Thickness = 1, Transparency = 0.9 })
    self:create("UIPadding", { Parent = popup, PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) })

    local search_input
    if use_search then
        local sf = self:create("Frame", {
            Name = "search",
            Parent = popup,
            Size = UDim2.new(1, 0, 0, 28),
            BackgroundColor3 = self.themes.preset.outline,
            BackgroundTransparency = 0.92,
            BorderSizePixel = 0
        })
        self:create("UICorner", { Parent = sf, CornerRadius = UDim.new(0, 8) })
        self:create("ImageLabel", {
            Parent = sf,
            BackgroundTransparency = 1,
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 9, 0.5, 0),
            Size = UDim2.new(0, 14, 0, 14),
            Image = self:get_icon("search"),
            ImageColor3 = self.themes.preset.text,
            ImageTransparency = 0.45
        })
        search_input = self:create("TextBox", {
            Name = "dd_search",
            Parent = sf,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 30, 0, 0),
            Size = UDim2.new(1, -38, 1, 0),
            Text = "",
            PlaceholderText = "Search",
            PlaceholderColor3 = self.themes.preset.placeholder,
            FontFace = library:font(Enum.FontWeight.Medium),
            TextSize = 12,
            TextColor3 = self.themes.preset.text,
            ClearTextOnFocus = false,
            TextXAlignment = Enum.TextXAlignment.Left
        })
    end

    local dd_list = self:create("ScrollingFrame", {
        Name = "list",
        Parent = popup,
        Position = UDim2.new(0, 0, 0, search_h),
        Size = UDim2.new(1, 0, 1, -search_h),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = self.themes.preset.outline,
        ScrollBarImageTransparency = 0.75,
        VerticalScrollBarInset = Enum.ScrollBarInset.None
    })
    local dd_layout = self:create("UIListLayout", { Parent = dd_list, Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder })

    local function is_selected(name)
        if cfg.multiple then
            return type(cfg.value) == "table" and table.find(cfg.value, name) ~= nil
        end
        return cfg.value == name
    end

    local function target_height()
        local list_h = math.min(dd_layout.AbsoluteContentSize.Y, MAX_LIST_H)
        return list_h + 12 + search_h
    end

    local function position_popup(h)
        local p, sz = dd_btn.AbsolutePosition, dd_btn.AbsoluteSize
        local gui_h = self.gui.AbsoluteSize.Y
        local down = (p.Y + sz.Y + 6 + h) <= (gui_h - 8) or (p.Y - 6 - h) < 8
        popup.AnchorPoint = Vector2.new(0, down and 0 or 1)
        popup.Position = UDim2.new(0, math.max(8, p.X + sz.X - POPUP_W), 0, down and (p.Y + sz.Y + 6) or (p.Y - 6))
    end

    local function set_look(open)
        tween(dd_icon, 0.2, { Rotation = open and 180 or 0 }):Play()
        tween(dd_stroke, 0.2, { Transparency = open and 0.75 or 0.9 }):Play()
    end

    local function close_popup()
        if not cfg.open then return end
        cfg.open = false
        local idx = table.find(library.active_popups, popup)
        if idx then table.remove(library.active_popups, idx) end
        set_look(false)
        local tw = tween(popup, 0.18, { Size = UDim2.new(0, POPUP_W, 0, 0) }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        tw:Play()
        tw.Completed:Connect(function()
            if not cfg.open then popup.Visible = false end
        end)
    end

    local function open_popup()
        library:close_popups()
        cfg.open = true
        local h = target_height()
        position_popup(h)
        popup.Size = UDim2.new(0, POPUP_W, 0, 0)
        popup.Visible = true
        table.insert(library.active_popups, popup)
        set_look(true)
        tween(popup, 0.25, { Size = UDim2.new(0, POPUP_W, 0, h) }, Enum.EasingStyle.Quart):Play()
    end

    -- closed from outside (tab switch, scrolling, other popup)
    self:connection(popup:GetPropertyChangedSignal("Visible"), function()
        if not popup.Visible and cfg.open then
            cfg.open = false
            set_look(false)
        end
    end)

    self:connection(dd_layout:GetPropertyChangedSignal("AbsoluteContentSize"), function()
        if cfg.open then
            tween(popup, 0.15, { Size = UDim2.new(0, POPUP_W, 0, target_height()) }):Play()
        end
    end)

    self:connection(dd_btn:GetPropertyChangedSignal("AbsolutePosition"), function()
        if cfg.open then close_popup() end
    end)

    self:connection(uis.InputBegan, function(input)
        if not cfg.open then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local pos = input.Position
        local function inside(gui)
            local p, sz = gui.AbsolutePosition, gui.AbsoluteSize
            return pos.X >= p.X and pos.X <= p.X + sz.X and pos.Y >= p.Y and pos.Y <= p.Y + sz.Y
        end
        if inside(popup) or inside(dd_btn) then return end
        close_popup()
    end)

    function cfg.set(val)
        if cfg.multiple then
            if type(val) == "table" then
                cfg.value = val
            elseif type(val) == "string" and val ~= "" then
                cfg.value = { val }
            else
                cfg.value = {}
            end
            library.flags[cfg.flag] = cfg.value
            dd_text.Text = (#cfg.value > 0 and table.concat(cfg.value, ", ")) or "..."
        else
            if type(val) == "table" then
                val = val[1]
            end
            cfg.value = val
            library.flags[cfg.flag] = val
            dd_text.Text = (val ~= nil and tostring(val)) or "..."
        end
        cfg:update_visuals()
        if type(cfg.callback) == "function" then cfg.callback(cfg.value) end
    end

    function cfg:update_visuals()
        for _, child in next, dd_list:GetChildren() do
            if child:IsA("TextButton") then
                local sel = is_selected(child.Name)
                local check = child:FindFirstChild("check")
                local text = child:FindFirstChild("val")
                tween(child, 0.2, { BackgroundTransparency = sel and 0.9 or 1 }):Play()
                if check then tween(check, 0.2, { ImageTransparency = sel and 0.1 or 1 }):Play() end
                if text then tween(text, 0.2, { TextTransparency = sel and 0 or 0.25 }):Play() end
            end
        end
    end

    function cfg:refresh(opts)
        cfg.options = opts or {}
        for _, child in next, dd_list:GetChildren() do
            if child:IsA("TextButton") then child:Destroy() end
        end
        for _, opt in next, cfg.options do
            local name = opt
            local icon = nil
            if type(opt) == "table" then
                name = opt.name
                icon = opt.icon
            end

            local opt_btn = library:create("TextButton", {
                Name = name,
                Parent = dd_list,
                Size = UDim2.new(1, 0, 0, ROW_H),
                BackgroundColor3 = library.themes.preset.outline,
                BackgroundTransparency = 1,
                Text = "",
                BorderSizePixel = 0,
                AutoButtonColor = false
            })
            library:create("UICorner", { Parent = opt_btn, CornerRadius = UDim.new(0, 8) })

            local text_x = 10
            if icon then
                library:create("ImageLabel", {
                    Name = "s_icon",
                    Parent = opt_btn,
                    BackgroundTransparency = 1,
                    AnchorPoint = Vector2.new(0, 0.5),
                    Position = UDim2.new(0, 10, 0.5, 0),
                    Size = UDim2.new(0, 16, 0, 16),
                    Image = library:get_icon(icon),
                    ImageColor3 = library.themes.preset.text
                })
                text_x = 34
            end

            library:create("TextLabel", {
                Name = "val",
                Parent = opt_btn,
                BackgroundTransparency = 1,
                Position = UDim2.new(0, text_x, 0, 0),
                Size = UDim2.new(1, -(text_x + 30), 1, 0),
                FontFace = library:font(Enum.FontWeight.Medium),
                Text = name,
                TextColor3 = library.themes.preset.text,
                TextTransparency = 0.25,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd
            })

            library:create("ImageLabel", {
                Name = "check",
                Parent = opt_btn,
                BackgroundTransparency = 1,
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -10, 0.5, 0),
                Size = UDim2.new(0, 14, 0, 14),
                Image = library:get_icon("check"),
                ImageColor3 = library.themes.preset.text,
                ImageTransparency = 1
            })

            library:connection(opt_btn.MouseEnter, function()
                if not is_selected(name) then tween(opt_btn, 0.15, { BackgroundTransparency = 0.94 }):Play() end
            end)
            library:connection(opt_btn.MouseLeave, function()
                if not is_selected(name) then tween(opt_btn, 0.2, { BackgroundTransparency = 1 }):Play() end
            end)

            library:connection(opt_btn.MouseButton1Click, function()
                if cfg.multiple then
                    local idx = table.find(cfg.value, name)
                    if idx then
                        table.remove(cfg.value, idx)
                    else
                        table.insert(cfg.value, name)
                    end
                    library.flags[cfg.flag] = cfg.value
                    dd_text.Text = (#cfg.value > 0 and table.concat(cfg.value, ", ")) or "..."
                    cfg:update_visuals()
                    if type(cfg.callback) == "function" then cfg.callback(cfg.value) end
                else
                    cfg.set(name)
                    close_popup()
                end
            end)
        end
        cfg:update_visuals()
    end

    if search_input then
        self:connection(search_input:GetPropertyChangedSignal("Text"), function()
            local q = string.lower(search_input.Text)
            for _, child in next, dd_list:GetChildren() do
                if child:IsA("TextButton") then
                    child.Visible = q == "" or string.find(string.lower(child.Name), q, 1, true) ~= nil
                end
            end
        end)
    end

    self:connection(dd_btn.MouseButton1Click, function()
        if cfg.open then close_popup() else open_popup() end
    end)
    self:connection(dd_btn.MouseEnter, function() if not cfg.open then tween(dd_stroke, 0.2, { Transparency = 0.8 }):Play() end end)
    self:connection(dd_btn.MouseLeave, function() if not cfg.open then tween(dd_stroke, 0.2, { Transparency = 0.9 }):Play() end end)

    if cfg.multiple then
        if type(cfg.default) == "table" then
            cfg.value = cfg.default
        elseif type(cfg.default) == "string" and cfg.default ~= "" then
            cfg.value = { cfg.default }
        else
            cfg.value = {}
        end
    else
        if type(cfg.default) == "table" then
            cfg.value = cfg.default[1]
        else
            cfg.value = cfg.default
        end
    end

    cfg:refresh(cfg.options)

    if cfg.multiple then
        cfg.set(cfg.value)
    else
        if cfg.default then cfg.set(cfg.default) end
    end

    library.config_flags[cfg.flag] = function(val) cfg.set(val) end
    if self.elements then table.insert(self.elements, cfg) end
    return cfg
end

