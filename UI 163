                    highlight = Color3.fromRGB(38, 38, 38),
                    outline = Color3.fromRGB(255, 255, 255)
                },
                ["light"] = {
                    background = Color3.fromRGB(244, 244, 245),
                    sidebar = Color3.fromRGB(255, 255, 255),
                    accent = library.themes.preset.accent,
                    text = Color3.fromRGB(24, 24, 27),
                    placeholder = Color3.fromRGB(113, 113, 122),
                    stroke = Color3.fromRGB(218, 218, 222),
                    element_background = Color3.fromRGB(232, 232, 235),
                    dropdown = Color3.fromRGB(238, 238, 241),
                    highlight = Color3.fromRGB(226, 226, 230),
                    outline = Color3.fromRGB(0, 0, 0)
                },
                ["amoled"] = {
                    background = Color3.fromRGB(0, 0, 0),
                    sidebar = Color3.fromRGB(10, 10, 10),
                    accent = library.themes.preset.accent,
                    text = Color3.fromRGB(255, 255, 255),
                    placeholder = Color3.fromRGB(150, 150, 150),
                    stroke = Color3.fromRGB(30, 30, 30),
                    element_background = Color3.fromRGB(15, 15, 15),
                    dropdown = Color3.fromRGB(20, 20, 20),
                    highlight = Color3.fromRGB(15, 15, 15),
                    outline = Color3.fromRGB(255, 255, 255)
                }
            }
            for name, data in pairs(cfg.custom_themes) do themes[name] = data end
            if themes[val] then
                library:change_theme(themes[val])
            end
        end
    })
    ui_section:colorpicker({
        name = "accent color",
        default = library.themes.preset.accent,
        flag = "accent_color",
        callback = function(color)
            self:change_accent(color)
        end
    })
    ui_section:slider({
        name = "drag speed",
        min = 0, max = 0.3, default = 0.08,
        flag = "drag_speed",
        callback = function(val)
            library.drag_speed = val
        end
    })
    ui_section:keybind({
        name = "menu toggle",
        default = Enum.KeyCode.RightShift,
        flag = "menu_toggle",
        callback = function()
            set_visible(not main_frame.Visible)
        end
    })

    local config_section = cfg.settings_tab:section({ name = "configs" })
    local config_name_input = config_section:textbox({ placeholder = "config name", clear_on_focus = true })

    library.button(config_section, { 
        name = "save config", 
        callback = function()
            local name = config_name_input.instance.Text
            if name == "" then return end
            local config_data = {}
            for flag, val in next, library.flags do config_data[flag] = val end
            local path = self.directory .. "/configs/" .. name .. ".json"
            writefile(path, http_service:JSONEncode(config_data))
            self:notification({ text = "saved config: " .. name, type = "success" })
            config_section:refresh_configs()
        end 
    })

    library.button(config_section, { 
        name = "load config", 
        callback = function()
            local name = config_name_input.instance.Text
            if name == "" then return end
            local path = self.directory .. "/configs/" .. name .. ".json"
            if isfile(path) then
                local data = http_service:JSONDecode(readfile(path))
                for flag, val in next, data do
                    if library.config_flags[flag] then library.config_flags[flag](val) end
                end
                self:notification({ text = "loaded config: " .. name, type = "success" })
            else
                self:notification({ text = "config not found!", type = "error" })
            end
        end 
    })

    library.button(config_section, { 
        name = "delete config", 
        callback = function()
            local name = config_name_input.instance.Text
            if name == "" then return end
            local path = self.directory .. "/configs/" .. name .. ".json"
            if isfile(path) then
                delfile(path)
                self:notification({ text = "deleted config: " .. name, type = "success" })
                config_section:refresh_configs()
            else
                self:notification({ text = "config not found!", type = "error" })
            end
        end 
    })

    config_section:toggle({
        name = "autoload config",
        default = isfile(self.directory .. "/autoload.txt"),
        flag = "autoload",
        callback = function(val)
            local path = self.directory .. "/autoload.txt"
            if val then
                writefile(path, config_name_input.instance.Text)
            else
                if isfile(path) then delfile(path) end
            end
        end
    })

    local other_section = cfg.settings_tab:section({ name = "other" })
    other_section:toggle({
        name = "auto execute",
        default = false,
        flag = "auto_exec",
        callback = function(val)
            if val then
                queue_on_teleport(cfg.script_url)
            else
                queue_on_teleport("")
            end
        end
    })

    function config_section:refresh_configs()
        if not isfolder(library.directory .. "/configs") then makefolder(library.directory .. "/configs") end
        local files = listfiles(library.directory .. "/configs")
        local names = {}
        for _, file in next, files do
            local name = file:match("([^/\\]+)%.json$")
            if name then table.insert(names, name) end
        end
        if config_section.config_dd then config_section.config_dd:refresh(names) end
    end

    config_section.config_dd = config_section:dropdown({ 
        name = "saved configs", 
        options = {}, 
        callback = function(val) config_name_input.instance.Text = val end
    })
    config_section:refresh_configs()

    if isfile(library.directory .. "/autoload.txt") then
        local name = readfile(library.directory .. "/autoload.txt")
        local path = library.directory .. "/configs/" .. name .. ".json"
        if isfile(path) then
            local data = http_service:JSONDecode(readfile(path))
            for flag, val in next, data do
                if library.config_flags[flag] then library.config_flags[flag](val) end
            end
        end
    end

    task.defer(function()
        if not library.is_loading then
            set_visible(true)
        end
    end)

    return setmetatable(cfg, { __index = self })
end

function library:tab(props)
    local cfg = {
        name = props.name or "tab",
        icon = props.icon or "down",
        hidden = props.hidden or false,
        search_enabled = props.search or false,
        sections = {}
    }

    local order = props.hidden_order or self.tab_order
    if not props.hidden_order then
        self.tab_order += 1
        order = self.tab_order
    end

    local button = self:create("TextButton", {
        Name = cfg.name,
        Parent = self.gui.main.content.sidebar.tab_list,
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = self.themes.preset.outline,
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        LayoutOrder = order
    })
    self:create("UICorner", { Parent = button, CornerRadius = UDim.new(0, 10) })
    local button_stroke = self:create("UIStroke", {
        Parent = button,
        Color = self.themes.preset.outline,
        Thickness = 1,
        Transparency = 1
    })

    local icon_label = self:create("ImageLabel", {
        Name = "icon",
        Parent = button,
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 11, 0.5, 0),
        Size = UDim2.new(0, 18, 0, 18),
        Image = self:get_icon(cfg.icon),
        ImageColor3 = self.themes.preset.text,
        ImageTransparency = 0.45
    })

    local text_label = self:create("TextLabel", {
        Name = "text",
        Parent = button,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 38, 0, 0),
        Size = UDim2.new(1, -46, 1, 0),
        FontFace = self:font(Enum.FontWeight.Medium),
        Text = cfg.name,
        TextColor3 = self.themes.preset.text,
        TextTransparency = library.sidebar_collapsed and 1 or 0.45,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd
    })

    local selected = false
    local function paint(hover)
        local bg = selected and 0.93 or (hover and 0.96 or 1)
        local tt = selected and 0 or (hover and 0.2 or 0.45)
        tween(button, 0.2, { BackgroundTransparency = bg }):Play()
        tween(icon_label, 0.2, { ImageTransparency = tt }):Play()
        tween(button_stroke, 0.2, { Transparency = selected and 0.94 or 1 }):Play()
        if not library.sidebar_collapsed then
            tween(text_label, 0.2, { TextTransparency = tt }):Play()
        end
    end
    self:connection(button.MouseEnter, function() paint(true) end)
    self:connection(button.MouseLeave, function() paint(false) end)

    local frame = self:create("Frame", {
        Name = cfg.name .. "_page",
        Parent = self.gui.main.content.tab_content,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = self.themes.preset.background,
        BackgroundTransparency = 1,
        Visible = false,
        Position = UDim2.new(0, 0, 0, 0),
        ZIndex = 1
    })

    local page_layout = frame.Parent:FindFirstChild("TabPageLayout")
    if not page_layout then
        page_layout = self:create("UIPageLayout", {
            Name = "TabPageLayout",
            Parent = frame.Parent,
            SortOrder = Enum.SortOrder.LayoutOrder,
            EasingDirection = Enum.EasingDirection.InOut,
            EasingStyle = Enum.EasingStyle.Quint,
            TweenTime = 0.35,
            Padding = UDim.new(0, 0),
            HorizontalAlignment = Enum.HorizontalAlignment.Center,
            VerticalAlignment = Enum.VerticalAlignment.Center
        })
    end

    local function make_list(parent, top_offset, top_pad)
        local lf = self:create("ScrollingFrame", {
            Name = "list_frame",
            Parent = parent,
            Position = UDim2.new(0, 0, 0, top_offset),
            Size = UDim2.new(1, 0, 1, -top_offset),
            BackgroundTransparency = 1,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = self.themes.preset.outline,
            ScrollBarImageTransparency = 0.75,
            VerticalScrollBarInset = Enum.ScrollBarInset.None,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            BorderSizePixel = 0
        })
        self:create("UIListLayout", { Parent = lf, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder })
        self:create("UIPadding", { Parent = lf, PaddingTop = UDim.new(0, top_pad), PaddingBottom = UDim.new(0, 14), PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14) })
        return lf
    end

    local list_frame
    if cfg.search_enabled then
        local search_container = self:create("Frame", {
            Name = "search_container",
            Parent = frame,
            Position = UDim2.new(0, 14, 0, 14),
            Size = UDim2.new(1, -28, 0, 36),
            BackgroundColor3 = self.themes.preset.outline,
            BackgroundTransparency = 0.95,
            BorderSizePixel = 0
        })
        self:create("UICorner", { Parent = search_container, CornerRadius = UDim.new(0, 10) })
        local page_stroke = self:create("UIStroke", { Parent = search_container, Color = self.themes.preset.outline, Thickness = 1, Transparency = 0.94 })
        self:create("ImageLabel", {
            Name = "icon",
            Parent = search_container,
            BackgroundTransparency = 1,
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 12, 0.5, 0),
            Size = UDim2.new(0, 16, 0, 16),
            Image = self:get_icon("search"),
            ImageColor3 = self.themes.preset.text,
            ImageTransparency = 0.45
        })
        local search_box = self:create("TextBox", {
            Name = "search",
            Parent = search_container,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 36, 0, 0),
            Size = UDim2.new(1, -46, 1, 0),
            Text = "",
            PlaceholderText = "Search",
            PlaceholderColor3 = self.themes.preset.placeholder,
            FontFace = self:font(Enum.FontWeight.Medium),
            TextSize = 13,
            TextColor3 = self.themes.preset.text,
            ClearTextOnFocus = false,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Center
        })
        self:connection(search_box.Focused, function() tween(page_stroke, 0.2, { Transparency = 0.8 }):Play() end)
        self:connection(search_box.FocusLost, function() tween(page_stroke, 0.2, { Transparency = 0.94 }):Play() end)

        list_frame = make_list(frame, 58, 0)

        self:connection(search_box:GetPropertyChangedSignal("Text"), function()
            local text = string.lower(search_box.Text)
            for _, section in next, cfg.sections do
                local matched = text == ""
                if not matched and string.find(string.lower(section.name), text, 1, true) then matched = true end
                if not matched then
                    for _, element in next, section.elements do
                        if element.name and string.find(string.lower(tostring(element.name)), text, 1, true) then
                            matched = true
                            break
                        end
                    end
                end
                section.frame.Visible = matched
            end
        end)
    else
        list_frame = make_list(frame, 0, 14)
    end

    cfg.tab_button = button
    cfg.frame = frame
    cfg.text_label = text_label
    cfg.icon_label = icon_label
    cfg.order = order
    cfg.holder = list_frame

    table.insert(self.tabs, cfg)

    function cfg.set_selected(state)
        selected = state
        paint(false)
    end

    function cfg:select()
        if library.current_tab == cfg then return end
        
        library:close_popups()
        
        local old_tab = library.current_tab

        if old_tab and old_tab.set_selected then
            old_tab.set_selected(false)
        end

        library.current_tab = cfg
        cfg.set_selected(true)
        
        frame.Visible = true
        frame.Parent.TabPageLayout:JumpTo(frame)
    end

    self:connection(button.MouseButton1Click, function() cfg:select() end)

    return setmetatable(cfg, { __index = self })
end

