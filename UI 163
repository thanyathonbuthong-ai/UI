    self:connection(uis.InputChanged, function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                local delta = input.Position - drag_start
                local target_pos = UDim2.new(start_pos.X.Scale, start_pos.X.Offset + delta.X, start_pos.Y.Scale, start_pos.Y.Offset + delta.Y)
                if library.drag_speed > 0 then
                    tween(main_frame, library.drag_speed, { Position = target_pos }, Enum.EasingStyle.Quad):Play()
                else
                    main_frame.Position = target_pos
                end
            elseif resizing then
                local delta = input.Position - rs_start
                local cam = workspace.CurrentCamera
                local max_v = cam and (cam.ViewportSize - Vector2.new(24, 24)) or Vector2.new(1920, 1080)
                local new_w = math.clamp(rs_size.X + delta.X, cfg.min_size.X, math.max(cfg.min_size.X, max_v.X))
                local new_h = math.clamp(rs_size.Y + delta.Y, cfg.min_size.Y, math.max(cfg.min_size.Y, max_v.Y))
                main_frame.Size = UDim2.new(0, new_w, 0, new_h)
                main_frame.Position = UDim2.new(rs_pos.X.Scale, rs_pos.X.Offset + (new_w - rs_size.X) / 2, rs_pos.Y.Scale, rs_pos.Y.Offset + (new_h - rs_size.Y) / 2)
                cfg.size = main_frame.Size
            elseif ob_drag then
                local delta = input.Position - ob_start
                if ob_moved or delta.Magnitude > 6 then
                    ob_moved = true
                    open_button.Position = UDim2.new(ob_pos.X.Scale, ob_pos.X.Offset + delta.X, ob_pos.Y.Scale, ob_pos.Y.Offset + delta.Y)
                end
            end
        elseif input.UserInputType == Enum.UserInputType.MouseWheel then
            library:close_popups()
        end
    end)

