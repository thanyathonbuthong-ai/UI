function library:section(props)
    local cfg = {
        name = props.name or props.title or "section",
        icon = props.icon or nil,
        box = props.box == true,
        expanded = props.opened ~= false,
        elements = {}
    }

    local HEADER_H = cfg.box and 42 or 36
    local pad_x = cfg.box and 10 or 0
    local pad_bottom = cfg.box and 10 or 4
    local extra = 2 + pad_bottom
    local text_pad = cfg.box and 14 or 2

    local section_frame = self:create("Frame", {
        Name = cfg.name,
        Parent = self.holder,
        Size = UDim2.new(1, 0, 0, HEADER_H),
        BackgroundColor3 = self.themes.preset.outline,
        BackgroundTransparency = cfg.box and 0.95 or 1,
        BorderSizePixel = 0,
        ClipsDescendants = true
    })
    self:create("UICorner", { Parent = section_frame, CornerRadius = UDim.new(0, 14) })
    if cfg.box then
        self:create("UIStroke", { Parent = section_frame, Color = self.themes.preset.outline, Thickness = 1, Transparency = 0.93 })
    end

    local header = self:create("TextButton", {
        Name = "header",
        Parent = section_frame,
        Size = UDim2.new(1, 0, 0, HEADER_H),
        BackgroundColor3 = self.themes.preset.outline,
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false
    })
    self:create("UICorner", { Parent = header, CornerRadius = UDim.new(0, 14) })
    self:connection(header.MouseEnter, function() tween(header, 0.2, { BackgroundTransparency = 0.97 }):Play() end)
    self:connection(header.MouseLeave, function() tween(header, 0.2, { BackgroundTransparency = 1 }):Play() end)

    local dropdown_icon = self:create("ImageLabel", {
        Name = "dropdown",
        Parent = header,
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -(pad_x + 4), 0.5, 0),
        Size = UDim2.new(0, 16, 0, 16),
        Image = self:get_icon("down"),
        ImageColor3 = self.themes.preset.text,
        ImageTransparency = 0.4,
        Rotation = cfg.expanded and 0 or 180
    })

    local text_x = text_pad
    if cfg.icon then
        self:create("ImageLabel", {
            Name = "s_icon",
            Parent = header,
            BackgroundTransparency = 1,
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, text_pad, 0.5, 0),
            Size = UDim2.new(0, 18, 0, 18),
            Image = self:get_icon(cfg.icon),
            ImageColor3 = self.themes.preset.text
        })
        text_x = text_pad + 26
    end

    local title = self:create("TextLabel", {
        Name = "title",
        Parent = header,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, text_x, 0, 0),
        Size = UDim2.new(1, -text_x - 40, 1, 0),
        FontFace = self:font(Enum.FontWeight.SemiBold),
        Text = cfg.name,
        TextColor3 = self.themes.preset.text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd
    })

    local elements_holder = self:create("Frame", {
        Name = "elements",
        Parent = section_frame,
        Position = UDim2.new(0, 0, 0, HEADER_H),
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1,
        ClipsDescendants = true
    })
    local elements_layout = self:create("UIListLayout", { Parent = elements_holder, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder })
    self:create("UIPadding", { Parent = elements_holder, PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, pad_bottom), PaddingLeft = UDim.new(0, pad_x), PaddingRight = UDim.new(0, pad_x) })

    cfg.holder = elements_holder
    cfg.frame = section_frame

    local function resize(animated)
        local body = cfg.expanded and (elements_layout.AbsoluteContentSize.Y + extra) or 0
        local t_info = TweenInfo.new(animated and 0.3 or 0, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        tween_service:Create(elements_holder, t_info, { Size = UDim2.new(1, 0, 0, body) }):Play()
        tween_service:Create(section_frame, t_info, { Size = UDim2.new(1, 0, 0, HEADER_H + body) }):Play()
    end

    self:connection(elements_layout:GetPropertyChangedSignal("AbsoluteContentSize"), function()
        if cfg.expanded then resize(true) end
    end)

    self:connection(header.MouseButton1Click, function()
        cfg.expanded = not cfg.expanded
        resize(true)
        tween_service:Create(dropdown_icon, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Rotation = cfg.expanded and 0 or 180 }):Play()
    end)

    function cfg:set_expanded(state)
        if cfg.expanded == state then return end
        cfg.expanded = state
        resize(true)
        tween_service:Create(dropdown_icon, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Rotation = state and 0 or 180 }):Play()
    end

    function cfg:add_info_row(name, val)
        local row = self:create("Frame", {
            Name = name,
            Parent = self.holder,
            Size = UDim2.new(1, 0, 0, 30),
            BackgroundTransparency = 1
        })
        self:create("TextLabel", {
            Name = "name",
            Parent = row,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 4, 0, 0),
            Size = UDim2.new(0.5, -4, 1, 0),
            FontFace = self:font(Enum.FontWeight.Medium),
            Text = name,
            TextColor3 = self.themes.preset.text,
            TextTransparency = 0.5,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Center
        })
        local val_label = self:create("TextLabel", {
            Name = "val",
            Parent = row,
            BackgroundTransparency = 1,
            Position = UDim2.new(0.5, 0, 0, 0),
            Size = UDim2.new(0.5, -4, 1, 0),
            FontFace = self:font(Enum.FontWeight.SemiBold),
            Text = val,
            TextColor3 = self.themes.preset.text,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Right,
            TextYAlignment = Enum.TextYAlignment.Center,
            TextTruncate = Enum.TextTruncate.AtEnd
        })
        return val_label
    end

    if self.sections then table.insert(self.sections, cfg) end

    return setmetatable(cfg, { __index = self })
end

