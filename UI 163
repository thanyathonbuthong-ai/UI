-- shared windui-style element card: rounded, faint fill + outline, title/desc stack
function library:element_card(opts)
    local base = opts.strong and 0.9 or 0.94
    local frame = self:create("TextButton", {
        Name = opts.name,
        Parent = self.holder,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = self.themes.preset.outline,
        BackgroundTransparency = base,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false
    })
    self:create("UICorner", { Parent = frame, CornerRadius = UDim.new(0, 12) })
    local stroke = self:create("UIStroke", {
        Parent = frame,
        Color = self.themes.preset.outline,
        Thickness = 1,
        Transparency = opts.strong and 0.9 or 0.93
    })
    self:create("UIPadding", {
        Parent = frame,
        PaddingTop = UDim.new(0, 13), PaddingBottom = UDim.new(0, 13),
        PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14)
    })
    self:create("UISizeConstraint", { Parent = frame, MinSize = Vector2.new(0, 44) })

    local text_holder = self:create("Frame", {
        Name = "text",
        Parent = frame,
        BackgroundTransparency = 1,
        Size = UDim2.new(1 - (opts.reserve_scale or 0), -(opts.reserve or 0), 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y
    })
    self:create("UIListLayout", { Parent = text_holder, Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder })

    local name_label = self:create("TextLabel", {
        Name = "name",
        Parent = text_holder,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        FontFace = library:font(Enum.FontWeight.Medium),
        Text = opts.name,
        TextColor3 = self.themes.preset.text,
        TextSize = 14,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = 1
    })
    local desc_label = self:create("TextLabel", {
        Name = "desc",
        Parent = text_holder,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        FontFace = library:font(Enum.FontWeight.Regular),
        Text = opts.desc or "",
        TextColor3 = self.themes.preset.text,
        TextTransparency = 0.5,
        TextSize = 12,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        Visible = (opts.desc or "") ~= "",
        LayoutOrder = 2
    })

    self:connection(frame.MouseEnter, function() tween(frame, 0.2, { BackgroundTransparency = base - 0.03 }):Play() end)
    self:connection(frame.MouseLeave, function() tween(frame, 0.25, { BackgroundTransparency = base }):Play() end)

    return { frame = frame, holder = text_holder, name = name_label, desc = desc_label, stroke = stroke, base = base }
end

