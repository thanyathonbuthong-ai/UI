        Parent = popup,
        Position = UDim2.new(0, 0, 0, 180),
        Size = UDim2.new(0, 200, 0, 26),
        BackgroundColor3 = self.themes.preset.outline,
        BackgroundTransparency = 0.92,
        Text = "#FFFFFF",
        FontFace = library:font(Enum.FontWeight.Medium),
        TextColor3 = self.themes.preset.text,
        TextSize = 12,
        BorderSizePixel = 0,
        ZIndex = 101,
        ClearTextOnFocus = false 
    })
    self:create("UICorner", { Parent = hex_box, CornerRadius = UDim.new(0, 8) })
    self:create("UIStroke", { Parent = hex_box, Color = self.themes.preset.outline, Thickness = 1, Transparency = 0.9 })

    local function update_color()
        local color = Color3.fromHSV(h, s, v)
        cp_btn.BackgroundColor3 = color
        sv_box.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        sv_cursor.Position = UDim2.new(s, 0, 1-v, 0)
        hue_cursor.Position = UDim2.new(h, 0, 0.5, 0)
        local r = math.floor(color.R * 255)
        local g = math.floor(color.G * 255)
        local b = math.floor(color.B * 255)
        hex_box.Text = string.format("#%02X%02X%02X", r, g, b)
        library.flags[cfg.flag] = {R=r, G=g, B=b}
        if type(cfg.callback) == "function" then cfg.callback(color) end
    end

    local dragging_sv = false
    local dragging_hue = false

    self:connection(sv_box.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging_sv = true
            local rel_x = math.clamp((input.Position.X - sv_box.AbsolutePosition.X) / sv_box.AbsoluteSize.X, 0, 1)
            local rel_y = math.clamp((input.Position.Y - sv_box.AbsolutePosition.Y) / sv_box.AbsoluteSize.Y, 0, 1)
            s = rel_x
            v = 1 - rel_y
            update_color()
        end
    end)

    self:connection(hue_bar.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging_hue = true
            local rel_x = math.clamp((input.Position.X - hue_bar.AbsolutePosition.X) / hue_bar.AbsoluteSize.X, 0, 1)
            h = rel_x
            update_color()
        end
    end)

    self:connection(uis.InputEnded, function(input) 
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then 
            dragging_sv = false 
            dragging_hue = false 
        end 
    end)

    self:connection(uis.InputChanged, function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            if dragging_sv then
                local rel_x = math.clamp((input.Position.X - sv_box.AbsolutePosition.X) / sv_box.AbsoluteSize.X, 0, 1)
                local rel_y = math.clamp((input.Position.Y - sv_box.AbsolutePosition.Y) / sv_box.AbsoluteSize.Y, 0, 1)
                s = rel_x
                v = 1 - rel_y
                update_color()
            elseif dragging_hue then
                local rel_x = math.clamp((input.Position.X - hue_bar.AbsolutePosition.X) / hue_bar.AbsoluteSize.X, 0, 1)
                h = rel_x
                update_color()
            end
        end
    end)

    self:connection(hex_box.FocusLost, function()
        local color = hex_to_color(hex_box.Text)
        if color then
            cfg.set(color)
        else
            update_color()
        end
    end)

    local function update_popup_pos()
        local btn_pos = cp_btn.AbsolutePosition
        local btn_size = cp_btn.AbsoluteSize
        local pop_size = popup.AbsoluteSize
        if pop_size.X == 0 then pop_size = Vector2.new(220, 226) end
        
        local target_x = btn_pos.X - pop_size.X - 8
        if target_x < 10 then
            target_x = btn_pos.X + btn_size.X + 8
        end
        
        local target_y = btn_pos.Y + (btn_size.Y / 2) - (pop_size.Y / 2)
        popup.Position = UDim2.new(0, target_x, 0, target_y)
    end

    self:connection(cp_btn.MouseButton1Click, function()
        if popup.Visible then
            popup.Visible = false
            local idx = table.find(library.active_popups, popup)
            if idx then table.remove(library.active_popups, idx) end
        else
            library:close_popups()
            update_popup_pos()
            popup.Visible = true
            table.insert(library.active_popups, popup)
        end
    end)

    self:connection(cp_btn:GetPropertyChangedSignal("AbsolutePosition"), function()
        if popup.Visible then
            update_popup_pos()
        end
    end)

    function cfg.set(color)
        if type(color) == "table" then
            color = Color3.fromRGB(color.R or color[1] or 255, color.G or color[2] or 255, color.B or color[3] or 255)
        end
        h, s, v = Color3.toHSV(color)
        h = (h == 0) and 0.001 or h
        update_color()
    end

    update_color()
    library.config_flags[cfg.flag] = function(val) cfg.set(val) end
    if self.elements then table.insert(self.elements, cfg) end
    return cfg
end

function library:notification(props)
    props = props or {}
    local cfg = {
        title = props.title,
        text = props.text or props.content or props.desc or "notification",
        duration = props.duration or 3,
        kind = props.type,
        icon = props.icon
    }
    local title_text, body_text = cfg.title, cfg.text
    if not title_text then title_text, body_text = cfg.text, nil end

    local type_colors = {
        success = Color3.fromRGB(48, 255, 106),
        warning = Color3.fromRGB(255, 184, 76),
        error = Color3.fromRGB(255, 84, 84)
    }
    local type_icons = { success = "check", error = "x" }
    local tint = type_colors[cfg.kind]
    local icon_name = cfg.icon or type_icons[cfg.kind]

    local container = library.notif_container
    if not container or not container.Parent then
        container = library:create("Frame", {
            Name = "notifications",
            Parent = library.gui,
            AnchorPoint = Vector2.new(1, 1),
            Position = UDim2.new(1, -16, 1, -16),
            Size = UDim2.new(0, 300, 1, -32),
            BackgroundTransparency = 1,
            ZIndex = 200
        })
        library:create("UIListLayout", {
            Parent = container,
            VerticalAlignment = Enum.VerticalAlignment.Bottom,
            HorizontalAlignment = Enum.HorizontalAlignment.Right,
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 8)
        })
        library.notif_container = container
    end

    library.notif_order = (library.notif_order or 0) + 1
    local wrapper = library:create("Frame", {
        Name = "notif",
        Parent = container,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        LayoutOrder = library.notif_order
    })

    local card = library:create("Frame", {
        Name = "card",
        Parent = wrapper,
        Position = UDim2.new(0, 330, 0, 0),
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = library.themes.preset.sidebar,
        BorderSizePixel = 0,
        ClipsDescendants = true
    })
    library:create("UICorner", { Parent = card, CornerRadius = UDim.new(0, 14) })
    library:create("UIStroke", { Parent = card, Color = library.themes.preset.outline, Thickness = 1, Transparency = 0.9 })

    local body = library:create("Frame", {
        Name = "body",
        Parent = card,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1
    })
    library:create("UIPadding", {
        Parent = body,
        PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 16),
        PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 12)
    })

    local left = 0
    if icon_name then
        left = 30
        local ic = library:create("ImageLabel", {
            Name = "icon",
            Parent = body,
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 0, 0, 0),
            Size = UDim2.new(0, 18, 0, 18),
            Image = library:get_icon(icon_name)
        })
        ic.ImageColor3 = tint or library.themes.preset.text
    end

    local holder = library:create("Frame", {
        Name = "text",
        Parent = body,
        Position = UDim2.new(0, left, 0, 0),
        Size = UDim2.new(1, -(left + 24), 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1
    })
    library:create("UIListLayout", { Parent = holder, Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder })

    library:create("TextLabel", {
        Name = "title",
        Parent = holder,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        FontFace = library:font(Enum.FontWeight.SemiBold),
        Text = title_text,
        TextColor3 = library.themes.preset.text,
        TextSize = 14,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        LayoutOrder = 1
    })
    if body_text then
        library:create("TextLabel", {
            Name = "content",
            Parent = holder,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            FontFace = library:font(Enum.FontWeight.Regular),
            Text = body_text,
            TextColor3 = library.themes.preset.text,
            TextTransparency = 0.4,
            TextSize = 12,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            LayoutOrder = 2
        })
    end

    local close = library:create("ImageButton", {
        Name = "close",
        Parent = body,
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 1),
        Size = UDim2.new(0, 16, 0, 16),
        Image = library:get_icon("x"),
        ImageColor3 = library.themes.preset.text,
        ImageTransparency = 0.55
    })
    library:connection(close.MouseEnter, function() tween(close, 0.15, { ImageTransparency = 0.1 }):Play() end)
    library:connection(close.MouseLeave, function() tween(close, 0.2, { ImageTransparency = 0.55 }):Play() end)

    -- duration bar
    local bar = library:create("Frame", {
        Name = "timer",
        Parent = card,
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, 2),
        BackgroundColor3 = library.themes.preset.accent,
        BorderSizePixel = 0,
        ZIndex = 2
    })
    if tint then bar.BackgroundColor3 = tint end

    table.insert(library.active_notifs, wrapper)

    local dismissed = false
    local function dismiss()
        if dismissed then return end
        dismissed = true
        local tw = tween(card, 0.35, { Position = UDim2.new(0, 330, 0, 0) }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        tw:Play()
        tw.Completed:Connect(function()
            local idx = table.find(library.active_notifs, wrapper)
            if idx then table.remove(library.active_notifs, idx) end
            if wrapper and wrapper.Parent then wrapper:Destroy() end
        end)
    end
    library:connection(close.MouseButton1Click, dismiss)

    tween(card, 0.45, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Quart):Play()
    tween(bar, cfg.duration, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear):Play()
    task.delay(cfg.duration, dismiss)

    return { close = dismiss }
end

-- windui-style modal dialog on top of the window
function library:dialog(props)
    props = props or {}
    local cfg = {
        title = props.title or "Dialog",
        content = props.content or props.text or "",
        icon = props.icon,
        buttons = props.buttons or { { title = "OK" } },
        dismissible = props.dismissible or false
    }

    local parent = (library.gui and library.gui:FindFirstChild("main")) or library.gui
    if not parent then return end

    local overlay = library:create("TextButton", {
        Name = "dialog_overlay",
        Parent = parent,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(2, 2, 2),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        BorderSizePixel = 0,
        ZIndex = 5000
    })

    local card = library:create("Frame", {
        Name = "dialog",
        Parent = overlay,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, 320, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = library.themes.preset.sidebar,
        BorderSizePixel = 0,
        ZIndex = 5001
    })
    library:create("UICorner", { Parent = card, CornerRadius = UDim.new(0, 16) })
    library:create("UIStroke", { Parent = card, Color = library.themes.preset.outline, Thickness = 1, Transparency = 0.9 })
    library:create("UIPadding", { Parent = card, PaddingTop = UDim.new(0, 20), PaddingBottom = UDim.new(0, 18), PaddingLeft = UDim.new(0, 20), PaddingRight = UDim.new(0, 20) })
    library:create("UIListLayout", { Parent = card, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder })
    local scale = library:create("UIScale", { Parent = card, Scale = 0.92 })

    if cfg.icon then
        library:create("ImageLabel", {
            Name = "icon",
            Parent = card,
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 24, 0, 24),
            Image = library:get_icon(cfg.icon),
            ImageColor3 = library.themes.preset.text,
            LayoutOrder = 1
        })
    end
    library:create("TextLabel", {
        Name = "title",
        Parent = card,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        FontFace = library:font(Enum.FontWeight.SemiBold),
        Text = cfg.title,
        TextColor3 = library.themes.preset.text,
        TextSize = 16,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = 2
    })
    if cfg.content ~= "" then
        library:create("TextLabel", {
            Name = "content",
            Parent = card,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            FontFace = library:font(Enum.FontWeight.Regular),
            Text = cfg.content,
            TextColor3 = library.themes.preset.text,
            TextTransparency = 0.4,
            TextSize = 13,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            LayoutOrder = 3
        })
    end

    local row = library:create("Frame", {
        Name = "buttons",
        Parent = card,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 34),
        LayoutOrder = 4
    })
    library:create("UIListLayout", {
        Parent = row,
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 8)
    })

    local closed = false
    local function close()
        if closed then return end
        closed = true
        tween(overlay, 0.2, { BackgroundTransparency = 1 }):Play()
        local tw = tween(scale, 0.2, { Scale = 0.92 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        tw:Play()
        tw.Completed:Connect(function()
            if overlay and overlay.Parent then overlay:Destroy() end
        end)
    end

    for i, b in ipairs(cfg.buttons) do
        local primary = (b.variant == "primary") or (b.variant == nil and i == #cfg.buttons)
        local btn = library:create("TextButton", {
            Name = b.title or "button",
            Parent = row,
            Size = UDim2.new(0, 0, 0, 34),
            AutomaticSize = Enum.AutomaticSize.X,
            BackgroundColor3 = primary and library.themes.preset.text or library.themes.preset.outline,
            BackgroundTransparency = primary and 0 or 0.9,
            Text = "",
            AutoButtonColor = false,
            BorderSizePixel = 0,
            LayoutOrder = i,
            ZIndex = 5002
        })
        library:create("UICorner", { Parent = btn, CornerRadius = UDim.new(0, 10) })
        library:create("UIPadding", { Parent = btn, PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16) })
        library:create("TextLabel", {
            Parent = btn,
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 0, 1, 0),
            AutomaticSize = Enum.AutomaticSize.X,
            FontFace = library:font(Enum.FontWeight.SemiBold),
            Text = b.title or "OK",
            TextColor3 = primary and library.themes.preset.background or library.themes.preset.text,
            TextSize = 13,
            ZIndex = 5003
        })
        local base = primary and 0 or 0.9
        library:connection(btn.MouseEnter, function() tween(btn, 0.15, { BackgroundTransparency = primary and 0.1 or 0.82 }):Play() end)
        library:connection(btn.MouseLeave, function() tween(btn, 0.2, { BackgroundTransparency = base }):Play() end)
        library:connection(btn.MouseButton1Click, function()
            close()
            if type(b.callback) == "function" then b.callback() end
        end)
    end

    if cfg.dismissible then
        library:connection(overlay.MouseButton1Click, close)
    end

    tween(overlay, 0.25, { BackgroundTransparency = 0.45 }):Play()
    tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Quint):Play()

    return { close = close }
end

getgenv().library = library
return library
