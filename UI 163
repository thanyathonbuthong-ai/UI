    if cfg.default ~= "" then
        tb_frame.Text = cfg.default
        library.flags[cfg.flag] = cfg.default
    end

    library.config_flags[cfg.flag] = function(val)
        if type(val) == "string" then
            tb_frame.Text = val
            library.flags[cfg.flag] = val
            if type(cfg.callback) == "function" then cfg.callback(val) end
        end
    end
    if self.elements then table.insert(self.elements, cfg) end
    return cfg
end

function library:slider(props)
    local cfg = {
        name = props.name or "slider",
        desc = props.desc or props.description,
        min = props.min or 0,
        max = props.max or 100,
        default = props.default or 50,
        step = props.step,
        flag = props.flag or props.name or "slider_"..tostring(math.random(1, 100000)),
        callback = props.callback or function() end,
        dragging = false
    }

    local card = self:element_card({ name = cfg.name, desc = cfg.desc, reserve_scale = 0.5, reserve = 12 })
    local s_frame = card.frame

    local cluster = self:create("Frame", {
        Name = "cluster",
        Parent = s_frame,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.new(0.5, 0, 0, 26),
        BackgroundTransparency = 1
    })

    -- editable value box (windui slider input)
    local val_box = self:create("TextBox", {
        Name = "val",
        Parent = cluster,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.new(0, 46, 0, 26),
        BackgroundColor3 = self.themes.preset.outline,
        BackgroundTransparency = 0.92,
        BorderSizePixel = 0,
        Text = tostring(cfg.default),
        FontFace = library:font(Enum.FontWeight.Medium),
        TextColor3 = self.themes.preset.text,
        TextSize = 12,
        ClearTextOnFocus = false
    })
    self:create("UICorner", { Parent = val_box, CornerRadius = UDim.new(0, 8) })
    local val_stroke = self:create("UIStroke", { Parent = val_box, Color = self.themes.preset.outline, Thickness = 1, Transparency = 0.9 })

    local track = self:create("TextButton", {
        Name = "track",
        Parent = cluster,
        Position = UDim2.new(0, 0, 0, 0),
        Size = UDim2.new(1, -54, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false
    })

    local bar = self:create("Frame", {
        Name = "bar",
        Parent = track,
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 8, 0.5, 0),
        Size = UDim2.new(1, -16, 0, 4),
        BackgroundColor3 = self.themes.preset.outline,
        BackgroundTransparency = 0.85,
        BorderSizePixel = 0
    })
    self:create("UICorner", { Parent = bar, CornerRadius = UDim.new(1, 0) })

    local fill = self:create("Frame", {
        Name = "fill",
        Parent = bar,
        Size = UDim2.new(0.5, 0, 1, 0),
        BackgroundColor3 = self.themes.preset.accent,
        BorderSizePixel = 0
    })
    self:create("UICorner", { Parent = fill, CornerRadius = UDim.new(1, 0) })

    local knob = self:create("Frame", {
        Name = "knob",
        Parent = bar,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, 14, 0, 14),
        BackgroundColor3 = Color3.fromRGB(254, 254, 254),
        BorderSizePixel = 0,
        ZIndex = 2
    })
    self:create("UICorner", { Parent = knob, CornerRadius = UDim.new(1, 0) })

    local function set_knob_size(big)
        local d = big and 18 or 14
        tween(knob, 0.15, { Size = UDim2.new(0, d, 0, d) }):Play()
    end

    function cfg.set(val)
        val = tonumber(val)
        if not val then return end
        val = math.clamp(val, cfg.min, cfg.max)
        if cfg.step and cfg.step > 0 then
            val = math.floor((val - cfg.min) / cfg.step + 0.5) * cfg.step + cfg.min
            val = math.clamp(math.floor(val * 1000 + 0.5) / 1000, cfg.min, cfg.max)
        else
            local range = cfg.max - cfg.min
            if range <= 1 then
                val = math.floor(val * 100) / 100
            elseif range <= 10 then
                val = math.floor(val * 10) / 10
            else
                val = math.floor(val)
            end
        end

        cfg.value = val
        library.flags[cfg.flag] = val
        if not val_box:IsFocused() then
            val_box.Text = tostring(val)
        end

        local percent = (cfg.max == cfg.min) and 0 or (val - cfg.min) / (cfg.max - cfg.min)
        local info = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        tween_service:Create(fill, info, { Size = UDim2.new(percent, 0, 1, 0) }):Play()
        tween_service:Create(knob, info, { Position = UDim2.new(percent, 0, 0.5, 0) }):Play()

        if type(cfg.callback) == "function" then cfg.callback(val) end
    end

    self:connection(val_box.Focused, function()
        tween(val_stroke, 0.2, { Transparency = 0.7 }):Play()
    end)
    self:connection(val_box.FocusLost, function()
        tween(val_stroke, 0.2, { Transparency = 0.9 }):Play()
        local n = tonumber(val_box.Text)
        if n then
            cfg.set(n)
        end
        val_box.Text = tostring(cfg.value)
    end)

    -- Track only the pointer that began on this slider. This prevents a
    -- touch drag from staying active after the finger is lifted, and stops
    -- unrelated touches elsewhere on the screen from moving the slider.
    local active_drag_input = nil

    local function update_slider_from_x(x)
        local width = bar.AbsoluteSize.X
        if width <= 0 then return end
        local percent = math.clamp((x - bar.AbsolutePosition.X) / width, 0, 1)
        cfg.set(cfg.min + (cfg.max - cfg.min) * percent)
    end

    self:connection(track.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            active_drag_input = input
            cfg.dragging = true
            set_knob_size(true)
            update_slider_from_x(input.Position.X)
        end
    end)

    self:connection(uis.InputChanged, function(input)
        if not cfg.dragging then return end

        if active_drag_input and active_drag_input.UserInputType == Enum.UserInputType.Touch then
            if input == active_drag_input then
                update_slider_from_x(input.Position.X)
            end
        elseif input.UserInputType == Enum.UserInputType.MouseMovement then
            update_slider_from_x(input.Position.X)
        end
    end)

    self:connection(uis.InputEnded, function(input)
        if input == active_drag_input
            or (active_drag_input and active_drag_input.UserInputType == Enum.UserInputType.MouseButton1
                and input.UserInputType == Enum.UserInputType.MouseButton1) then
            cfg.dragging = false
            active_drag_input = nil
            set_knob_size(false)
        end
    end)

    cfg.set(cfg.default)
    library.config_flags[cfg.flag] = cfg.set
    if self.elements then table.insert(self.elements, cfg) end
    return cfg
end

