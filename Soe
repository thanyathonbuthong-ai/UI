		local GripHit = Instance.new("TextButton")
		SetProperty(GripHit, {
			Name = "GripHit",
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0, .5),
