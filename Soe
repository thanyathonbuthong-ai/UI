				end
			end
			if not Rounded then
				local Round = Instance.new("UICorner")
				Round.CornerRadius = UDim.new(0, 6)
				Round.Parent = Fill
			end

			Connect(Button.InputBegan, function() Tween(Fill, .2, { BackgroundTransparency = .15 }) end)
			Connect(Button.InputEnded, function() Tween(Fill, .2, { BackgroundTransparency = 0 }) end)
		end

		--// Icon (rbxassetid / Lucide name).  WindUI: IconAlign = "Right" (default) | "Left"
		if Settings.Icon and Settings.Icon ~= "" then
			local Pic = SideIcon(Button, Settings.Icon, Settings.IconAlign == "Left", "ButtonIcon")
			local Tint = Settings.IconColor and ToColor(Settings.IconColor)

			--// WindUI: IconColor  (NoTheme keeps SetTheme from repainting it)
			if Pic and Tint then
				Pic:SetAttribute("NoTheme", true)
				Pic.ImageColor3 = Tint
			end
		end

		--// WindUI: Justify = "Between" (default) | "Left" | "Center" | "Right"
		do
			local Align = ({ Center = Enum.TextXAlignment.Center, Right = Enum.TextXAlignment.Right })[Settings.Justify]

			if Align then
				Title.TextXAlignment = Align
				Description.TextXAlignment = Align
			end
		end

		local Object = { Instance = Button }

		--// WindUI: Button:Highlight()
		function Object:Highlight()
			local Target = Fill or Button
			local Base = (Fill and Settings.Color) or Theme.Component

			Tween(Target, .15, { BackgroundColor3 = Accent })
			task.delay(.45, function()
				Tween(Target, .3, { BackgroundColor3 = Base })
			end)
		end

		function Object:SetTitle(Text) Title.Text = Text end
		function Object:SetDesc(Text) Description.Text = Text end

		return Object
	end

