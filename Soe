--// Animations [Window]
--// ---------------------------------------------------------------
--// WindUI Localization
--//   Library:Localization({ Enabled = true, Prefix = "loc:", DefaultLanguage = "en", Translations = { en = { KEY = "text" }, th = { KEY = "ข้อความ" } } })
--//   every TextLabel / TextButton / TextBox whose Text is "loc:KEY" is translated, and re-translated by Library:SetLanguage("th")
--// ---------------------------------------------------------------
local Localization = {
	Enabled = false,
	Prefix = "loc:",
	DefaultLanguage = "en",
	Language = "en",
	Translations = {},
	Keys = setmetatable({}, { __mode = "k" }),   --// Object -> translation key
	Hooked = setmetatable({}, { __mode = "k" }),
	Last = setmetatable({}, { __mode = "k" }),   --// Object -> the text this system wrote (so it ignores its own change)
}
local LangListeners = {}
local LangRootsHooked = false

local function LangPattern()
	return "^" .. (Localization.Prefix:gsub("%p", "%%%0")) .. "(.+)$"
end

local function TranslateKey(Key)
	local Pack = Localization.Translations
	local Value = Pack[Localization.Language] and Pack[Localization.Language][Key]

	if Value == nil and Pack[Localization.DefaultLanguage] then Value = Pack[Localization.DefaultLanguage][Key] end
	if Value == nil and Pack.en then Value = Pack.en[Key] end

	return Value
end

--// text -> translated text (works for plain strings that start with the prefix; used by the key window)
local function LocalizeText(Text)
	if type(Text) ~= "string" or not Localization.Enabled then return Text end

	local Key = Text:match(LangPattern())
	if not Key then return Text end

	local Value = TranslateKey(Key)
	return tostring(Value ~= nil and Value or Key)
end

local function ApplyLanguage(Object)
	local Key = Localization.Keys[Object]
	if not Key then return end

	local Value = TranslateKey(Key)
	local Text = tostring(Value ~= nil and Value or Key)

	Localization.Last[Object] = Text
	pcall(function() Object.Text = Text end)
end

local function HookText(Object)
	if not Localization.Enabled or Localization.Hooked[Object] then return end
	if not (Object:IsA("TextLabel") or Object:IsA("TextButton") or Object:IsA("TextBox")) then return end

	Localization.Hooked[Object] = true

	local function Check()
		local Text = Object.Text
		if Localization.Last[Object] == Text then return end --// our own write

		local Key = Text:match(LangPattern())
		if Key then
			Localization.Keys[Object] = Key
			ApplyLanguage(Object)
		else
			Localization.Keys[Object] = nil
			Localization.Last[Object] = nil
		end
	end

	Connect(Object:GetPropertyChangedSignal("Text"), Check)
	Check()
end

local function ScanLanguage()
	for _, Root in ipairs({ Screen, NotifyGui }) do
		for _, Object in next, Root:GetDescendants() do HookText(Object) end
	end
end

function Library:Localization(Info)
	Info = type(Info) == "table" and Info or {}

	Localization.Enabled = Info.Enabled or false
	Localization.Prefix = tostring(Info.Prefix or "loc:")
	Localization.DefaultLanguage = tostring(Info.DefaultLanguage or "en")
	Localization.Translations = Info.Translations or {}
	Localization.Language = Localization.DefaultLanguage

	if Localization.Enabled then
		if not LangRootsHooked then
			LangRootsHooked = true
			for _, Root in ipairs({ Screen, NotifyGui }) do
				--// deferred: the text is set right after the object is created
				Connect(Root.DescendantAdded, function(Object) task.defer(HookText, Object) end)
			end
		end

		ScanLanguage()
		for Object in next, Localization.Keys do ApplyLanguage(Object) end
	end

	return Localization
end

function Library:SetLanguage(Language)
	if not Localization.Enabled then return false end

	if Localization.Translations[Language] == nil then
		warn("[UI LIB]: language '" .. tostring(Language) .. "' has no translations")
		return false
	end

	Localization.Language = Language
	for Object in next, Localization.Keys do ApplyLanguage(Object) end
	for _, Callback in ipairs(LangListeners) do task.spawn(Callback, Language) end

	return true
end

function Library:GetLanguage() return Localization.Language end

function Library:GetLanguages()
	local List = {}
	for Name in next, Localization.Translations do table.insert(List, Name) end
	table.sort(List)
	return List
end

--// Library:Translate("HELLO") or Library:Translate("loc:HELLO") -> the text in the current language
function Library:Translate(Key)
	Key = tostring(Key)
	local Stripped = Key:match(LangPattern()) or Key
	local Value = TranslateKey(Stripped)
	return tostring(Value ~= nil and Value or Stripped)
end

function Library:OnLanguageChange(Callback)
	if type(Callback) ~= "function" then return end
	table.insert(LangListeners, Callback)

	return { Disconnect = function()
		local Index = table.find(LangListeners, Callback)
		if Index then table.remove(LangListeners, Index) end
	end }
end

--// Library:AddLangObject(TextObject, "HELLO")  -> any TextLabel / TextButton / TextBox follows the language
function Library:AddLangObject(Object, Key)
	if not Localization.Enabled or typeof(Object) ~= "Instance" then return false end

	HookText(Object)
	Localization.Keys[Object] = tostring(Key):match(LangPattern()) or tostring(Key)
	ApplyLanguage(Object)

	return true
end

--// ---------------------------------------------------------------
--// WindUI KeySystem
--//   Library:KeySystem({ Title, Note, Key = "abc" | { "a", "b" }, KeyValidator = function(key) .. end, SaveKey = true, URL = "https://..",
--//                       Thumbnail = { Image = "rbxassetid://..", Title = ".." }, API = { { Verify = function(key) .. end } }, Folder = "Hub", Cancel = false })
--//   yields until a right key was typed -> true   (Cancel button -> false).   Also: CreateWindow({ KeySystem = {...} })
--// ---------------------------------------------------------------
function Library:KeySystem(Info, WindowSettings)
	Info = type(Info) == "table" and Info or {}
	WindowSettings = type(WindowSettings) == "table" and WindowSettings or {}

	local WarnedAPI = false

	local function Verify(Key)
		Key = tostring(Key or "")
		Key = Key:gsub("^%s+", "")
		Key = Key:gsub("%s+$", "")

		if Key == "" then return false end

		if type(Info.KeyValidator) == "function" then
			local Ok, Result = pcall(Info.KeyValidator, Key)
			return (Ok and Result) and true or false
		end

		if type(Info.API) == "table" then
			for _, Service in next, Info.API do
				local Verifier = (type(Service) == "table" and Service.Verify) or (type(Service) == "function" and Service) or nil

				if Verifier then
					local Ok, Result = pcall(Verifier, Key)
					if Ok and Result then return true end
				elseif not WarnedAPI then
					WarnedAPI = true
					warn("[UI LIB]: KeySystem.API entries need a Verify = function(key) end (WindUI's built-in services are not included)")
				end
			end

			return false
		end

		if type(Info.Key) == "table" then return table.find(Info.Key, Key) ~= nil end
		return Info.Key ~= nil and tostring(Info.Key) == Key
	end

	--// saved key (same file name as WindUI: <Folder>/<hwid>.key)
	local FileOk = writefile and readfile and isfile and makefolder and isfolder
	local Hwid = "0"
	pcall(function() Hwid = tostring((gethwid and gethwid()) or LocalPlayer.UserId) end)
	Hwid = Hwid:gsub("[^%w_%-]", "")

	local Folder = tostring(Info.Folder or WindowSettings.Folder or WindowSettings.Title or "Temp")
	local KeyFile = Folder .. "/" .. Hwid .. ".key"

	if Info.SaveKey and FileOk and isfile(KeyFile) then
		local Ok, Saved = pcall(readfile, KeyFile)
		if Ok and Verify(Saved) then return true end
	end

	--// colours: the window's theme
	local T = ResolveTheme(WindowSettings.Theme)
	if not T and type(PendingTheme) == "table" and PendingTheme.Primary then T = PendingTheme end
	T = T or Theme

	local Gui = Instance.new("ScreenGui")
	Gui.Name = "UIKeySystem"
	Gui.ResetOnSpawn = false
	Gui.IgnoreGuiInset = true
	Gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	Gui.DisplayOrder = 2000

	xpcall(function() Gui.Parent = Screen.Parent end, function() Gui.Parent = Player.GUI end)

	local function Make(Class, Props, Parent)
		local Object = Instance.new(Class)
		SetProperty(Object, Props)
		Object.Parent = Parent
		return Object
	end

	local function Round(Parent, Radius) return Make("UICorner", { CornerRadius = UDim.new(0, Radius) }, Parent) end

	local Backdrop = Make("Frame", {
		Name = "Backdrop", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1, BorderSizePixel = 0, Active = true,
	}, Gui)

	local Panel = Make("Frame", {
		Name = "KeyPanel", AnchorPoint = Vector2.new(.5, .5), Position = UDim2.new(.5, 0, .5, 12),
		Size = UDim2.fromOffset(tonumber(Info.Width) or 340, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = T.Primary, BorderSizePixel = 0, Active = true,
	}, Backdrop)
	Round(Panel, 8)
	Make("UIStroke", { Color = T.Shadow, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, Panel)
	Make("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 14) }, Panel)
	Make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }, Panel)

	local Order = 0
	local function Next() Order += 1 return Order end

	--// thumbnail (picture on top)
	if type(Info.Thumbnail) == "table" and Info.Thumbnail.Image then
		local Image = ResolveIcon(Info.Thumbnail.Image) or tostring(Info.Thumbnail.Image)
		local Picture = Make("ImageLabel", {
			Name = "Thumbnail", LayoutOrder = Next(), Size = UDim2.new(1, 0, 0, tonumber(Info.Thumbnail.Height) or 110),
			BackgroundColor3 = T.Interactables, BorderSizePixel = 0, Image = Image, ScaleType = Enum.ScaleType.Crop,
		}, Panel)
		Round(Picture, 6)

		if Info.Thumbnail.Title then
			Make("TextLabel", {
				Name = "ThumbnailTitle", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 8, 1, -6), Size = UDim2.new(1, -16, 0, 18),
				BackgroundTransparency = 1, Text = LocalizeText(tostring(Info.Thumbnail.Title)), TextColor3 = Color3.new(1, 1, 1),
				Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
			}, Picture)
		end
	end

	Make("TextLabel", {
		Name = "Title", LayoutOrder = Next(), Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1,
		Text = LocalizeText(tostring(Info.Title or WindowSettings.Title or "Key System")), TextColor3 = T.Title,
		Font = Enum.Font.GothamBold, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left,
	}, Panel)

	if Info.Note and tostring(Info.Note) ~= "" then
		Make("TextLabel", {
			Name = "Note", LayoutOrder = Next(), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1, Text = LocalizeText(tostring(Info.Note)), TextColor3 = T.Description,
			Font = Enum.Font.Gotham, TextSize = 13, TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
		}, Panel)
	end

	local InputBack = Make("Frame", {
		Name = "Input", LayoutOrder = Next(), Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = T.Interactables, BorderSizePixel = 0,
	}, Panel)
	Round(InputBack, 6)

	local Box = Make("TextBox", {
		Name = "KeyBox", Size = UDim2.new(1, -20, 1, 0), Position = UDim2.fromOffset(10, 0), BackgroundTransparency = 1,
		Text = "", ClearTextOnFocus = false, PlaceholderText = LocalizeText(tostring(Info.Placeholder or "Enter Key")),
		PlaceholderColor3 = T.Placeholder, TextColor3 = T.Title, Font = Enum.Font.Gotham, TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, InputBack)

	local Message = Make("TextLabel", {
		Name = "Message", LayoutOrder = Next(), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1, Text = "", Visible = false, TextColor3 = T.Description,
		Font = Enum.Font.Gotham, TextSize = 12, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
	}, Panel)

	local Row = Make("Frame", { Name = "Buttons", LayoutOrder = Next(), Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1 }, Panel)
	Make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }, Row)

	local Defs = {}
	if Info.Cancel ~= false then table.insert(Defs, { Name = "Cancel", Text = "Cancel" }) end
	if Info.URL then table.insert(Defs, { Name = "GetKey", Text = "Get Key" }) end
	table.insert(Defs, { Name = "Submit", Text = "Submit", Primary = true })

	local Buttons = {}
	for Index, Def in ipairs(Defs) do
		local Count = #Defs
		local Button = Make("TextButton", {
			Name = Def.Name, LayoutOrder = Index, Size = UDim2.new(1 / Count, -8 * (Count - 1) / Count, 1, 0),
			BackgroundColor3 = Def.Primary and T.Highlight or T.Interactables, BorderSizePixel = 0, AutoButtonColor = false,
			Text = LocalizeText(Def.Text), TextColor3 = Def.Primary and Color3.new(1, 1, 1) or T.Title,
			Font = Enum.Font.GothamMedium, TextSize = 13,
		}, Row)
		Round(Button, 5)
		pcall(function() Animations:Press(Button, .95) end)
		Buttons[Def.Name] = Button
	end

	local Result --// nil = still open
	local Checking = false

	local function Say(Text, Colour)
		Message.Text = Text
		Message.TextColor3 = Colour or T.Description
		Message.Visible = Text ~= ""
	end

	local function Submit()
		if Checking or Result ~= nil then return end
		Checking = true
		Say("Checking...", T.Description)

		local Good = Verify(Box.Text)

		if Good then
			Say("Key is valid", Color3.fromRGB(51, 199, 89))

			if Info.SaveKey and FileOk then
				pcall(function()
					if not isfolder(Folder) then makefolder(Folder) end
					writefile(KeyFile, (Box.Text:gsub("^%s+", ""):gsub("%s+$", "")))
				end)
			end

			task.wait(.25)
			Result = true
		else
			Say("Invalid key", Color3.fromRGB(239, 68, 68))
			Checking = false
		end
	end

	Connect(Buttons.Submit.MouseButton1Click, Submit)
	Connect(Box.FocusLost, function(Enter) if Enter then Submit() end end)

	if Buttons.Cancel then
		Connect(Buttons.Cancel.MouseButton1Click, function() if not Checking then Result = false end end)
	end

	if Buttons.GetKey then
		Connect(Buttons.GetKey.MouseButton1Click, function()
			if setclipboard then
				pcall(setclipboard, tostring(Info.URL))
				Say("Link copied to the clipboard", T.Description)
			else
				Say(tostring(Info.URL), T.Description)
			end
		end)
	end

	if CurrentFamily then
		for _, Object in next, Gui:GetDescendants() do PaintFont(Object) end
	end

	Tween(Backdrop, .3, { BackgroundTransparency = .45 })
	Tween(Panel, .35, { Position = UDim2.fromScale(.5, .5) }, Smooth)

	repeat task.wait() until Result ~= nil or not Gui.Parent

	local Final = Result == true
	pcall(function() Gui:Destroy() end)

	return Final
end

function Animations:Open(Window: CanvasGroup, Transparency: number, UseCurrentSize: boolean)
	local Original = (UseCurrentSize and Window.Size) or Setup.Size
	local Multiplied = Multiply(Original, 1.1)
	local Shadow = Window:FindFirstChildOfClass("UIStroke")


	SetProperty(Shadow, { Transparency = 1 })
	SetProperty(Window, {
		Size = Multiplied,
		GroupTransparency = 1,
		Visible = true,
	})

	Tween(Shadow, .25, { Transparency = 0.5 })
	Tween(Window, .25, {
		Size = Original,
		GroupTransparency = Transparency or 0,
	})
end

function Animations:Close(Window: CanvasGroup)
	local Original = Window.Size
	local Multiplied = Multiply(Original, 1.1)
	local Shadow = Window:FindFirstChildOfClass("UIStroke")

	SetProperty(Window, {
		Size = Original,
	})

	Tween(Shadow, .25, { Transparency = 1 })
	Tween(Window, .25, {
		Size = Multiplied,
		GroupTransparency = 1,
	})

	task.wait(.25)
	Window.Size = Original
	Window.Visible = false
end


function Animations:Component(Component: any, Custom: boolean)	
	Connect(Component.InputBegan, function() 
		if Custom then
			Tween(Component, .25, { Transparency = .85 });
		else
			if Component:GetAttribute("GlassTint") then
				Tween(Component, .25, { BackgroundColor3 = GlassTint(true) });
			else
				Tween(Component, .25, { BackgroundColor3 = Color(Theme.Component, 5, Setup.ThemeMode) });
			end
		end
	end)

	Connect(Component.InputEnded, function() 
		if Custom then
			Tween(Component, .25, { Transparency = 1 });
		else
			if Component:GetAttribute("GlassTint") then
				Tween(Component, .25, { BackgroundColor3 = GlassTint() });
			else
				Tween(Component, .25, { BackgroundColor3 = Theme.Component });
			end
		end
	end)
end

--// Press feel (no scaling): scaling a button also scales its TEXT, and Roblox re-rasterises text on every
--// scale step -> it looks like the text "stretches" and lags.  Instead a soft overlay fades in under the
--// text on press and fades out on release, so the text never moves or resizes.
--// Animations:Press(Button, Depth, Target)  -> input comes from Button, the overlay is added to Target (default: Button)
function Animations:Press(Button: GuiObject, Depth: number?, Target: GuiObject?)
	Target = Target or Button
	if not Button or not Target or Target:FindFirstChild("PressOverlay") then return end

	local Overlay = Instance.new("Frame")
	SetProperty(Overlay, {
		Name = "PressOverlay",
		Active = false,
		BackgroundColor3 = (Setup.ThemeMode == "Light") and Color3.new(0, 0, 0) or Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = math.max(Target.ZIndex, 1), --// same level as the button (children draw above their parent) so it is always visible
		Parent = Target,
	})

	local Round = Target:FindFirstChildOfClass("UICorner")
	if Round then
		Clone(Round).Parent = Overlay
	else
		local Corner = Instance.new("UICorner")
		Corner.CornerRadius = UDim.new(0, 6)
		Corner.Parent = Overlay
	end

	local Down = false

	local function Press()
		if Down then return end
		Down = true
		Overlay.BackgroundColor3 = (Setup.ThemeMode == "Light") and Color3.new(0, 0, 0) or Color3.new(1, 1, 1)
		Tween(Overlay, .1, { BackgroundTransparency = .78 }, { EasingStyle = Enum.EasingStyle.Quad, EasingDirection = Enum.EasingDirection.Out })
	end

	local function Release()
		if not Down then return end
		Down = false
		Tween(Overlay, .35, { BackgroundTransparency = 1 }, { EasingStyle = Enum.EasingStyle.Quint, EasingDirection = Enum.EasingDirection.Out })
	end

	local function IsPointer(Input)
		return Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch
	end

	Connect(Button.InputBegan, function(Input) if IsPointer(Input) then Press() end end)
	Connect(Button.InputEnded, function(Input) if IsPointer(Input) then Release() end end)
	Connect(Button.MouseLeave, Release)
end

--// Library [Window]

function Library:CreateWindow(Settings: { Title: string, Size: UDim2, Transparency: number, MinimizeKeybind: Enum.KeyCode?, Blurring: boolean, Theme: string })
	Settings = Settings or {}

	--// WindUI: CreateWindow({ Localization = {...}, KeySystem = {...} })
	if Settings.Localization then Library:Localization(Settings.Localization) end

	if Settings.KeySystem then
		if not Library:KeySystem(Settings.KeySystem, Settings) then return nil end
	end

	local Window = Clone(Screen:WaitForChild("Main"));
	local Sidebar = Window:FindFirstChild("Sidebar");
	local Holder = Window:FindFirstChild("Main");
	local BG = Window:FindFirstChild("BackgroundShadow");
	local Tab = Sidebar:FindFirstChild("Tab");

	--// Make the sidebar tab list scrollable (mouse wheel / finger drag) so every tab can be reached
	do
		local Old = Tab
		local Scroll = Old

		if not Old:IsA("ScrollingFrame") then
			Scroll = Instance.new("ScrollingFrame")
			SetProperty(Scroll, {
				Name = Old.Name,
				AnchorPoint = Old.AnchorPoint,
				Position = Old.Position,
				Size = Old.Size,
				BackgroundColor3 = Old.BackgroundColor3,
				BackgroundTransparency = Old.BackgroundTransparency,
				BorderSizePixel = 0,
				LayoutOrder = Old.LayoutOrder,
				ZIndex = Old.ZIndex,
				ClipsDescendants = true,
			})

			--// an auto-sized frame can never scroll, so give it a fixed height (the rest of the sidebar)
			if Old.AutomaticSize ~= Enum.AutomaticSize.None then
				Scroll.Size = UDim2.new(Old.Size.X.Scale, Old.Size.X.Offset, 1 - Old.Position.Y.Scale, -Old.Position.Y.Offset - 6)
			end

			for _, Child in next, Old:GetChildren() do
				Child.Parent = Scroll
			end

			Scroll.Parent = Old.Parent
			Destroy(Old)
		end

		SetProperty(Scroll, {
			Active = true,
			ScrollingEnabled = true,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(0, 0, 0, 0),
			ScrollBarThickness = 2,
			ScrollBarImageColor3 = Theme.Interactables,
			ScrollBarImageTransparency = 0,
			VerticalScrollBarInset = Enum.ScrollBarInset.None,
			ElasticBehavior = Enum.ElasticBehavior.Never,
		})

		Tab = Scroll
	end

	local Options = {};
	local Examples = {};
	local Opened = true;
	local DropdownClosers = {} --// every dropdown list that is open right now (closed automatically when the tab changes)
	local Maximized = false;
	local BlurEnabled = false
	local Accent = Theme.Highlight --// highlight colour (WindUI "Primary"), updated by SetTheme
	local Custom = {} --// re-theme callbacks for code-built elements
	local LastTabOrder = 0 --// LayoutOrder of the newest tab (used by AddTabDivider)
	local SyncButton = function() end --// replaced by the open/close button below
	local TabChosen = false --// becomes true once any tab was opened (by script or by click)
	local TabCount = 0

	for Index, Example in next, Window:GetDescendants() do
		if Example.Name:find("Example") and not Examples[Example.Name] then
			Examples[Example.Name] = Example
		end
	end

	--// UI Blur & More
	Drag(Window);
	Resizeable(Window, Vector2.new(411, 271), Vector2.new(9e9, 9e9));
	Setup.Transparency = Settings.Transparency or 0

	--// Start small like WindUI (580 x 460) and always fit inside the screen.
	--// CreateWindow({ KeepSize = true }) uses the given Size as it is (still fitted to the screen).
	do
		local View = Screen.AbsoluteSize
		if View.X < 1 or View.Y < 1 then View = workspace.CurrentCamera.ViewportSize end

		local Wanted = Settings.Size or UDim2.fromOffset(580, 460)
		local Width = Wanted.X.Scale * View.X + Wanted.X.Offset
		local Height = Wanted.Y.Scale * View.Y + Wanted.Y.Offset

		if not Settings.KeepSize then
			Width, Height = math.min(Width, 580), math.min(Height, 460)
		end

		Width, Height = math.min(Width, View.X * .9), math.min(Height, View.Y * .9)
		Width = math.max(Width, math.min(411, View.X * .9)) --// 411 x 271 = smallest the window can be resized to
		Height = math.max(Height, math.min(271, View.Y * .9))

		Settings.Size = UDim2.fromOffset(math.floor(Width), math.floor(Height))
	end

	Setup.Size = Settings.Size
	do
		local Picked = ResolveTheme(Settings.Theme) or (not Settings.Theme and (PendingTheme or ResolveTheme(Setup.ThemeName))) or nil
		if Settings.Theme and not Picked then warn("[UI LIB]: theme '" .. tostring(Settings.Theme) .. "' doesn't exist, using Dark") end

		Theme = Picked or ThemePresets.Dark
		Setup.ThemeName = Theme.Name or "Custom"
		Setup.ThemeMode = (Theme.Light and "Light") or "Dark"
	end

	if Settings.Blurring then
		Blurs[Settings.Title] = Blur.new(Window, 5)
		BlurEnabled = true
	end

	if Settings.MinimizeKeybind then
		Setup.Keybind = Settings.MinimizeKeybind
	end

	--// WindUI triggers: Window:OnOpen(fn) / Window:OnClose(fn) / Window:OnDestroy(fn)
	local Triggers = { Open = {}, Close = {}, Destroy = {} }
	local function Fire(Kind)
		for _, Callback in ipairs(Triggers[Kind]) do task.spawn(Callback) end
	end

	--// Animate
	local Close = function()
		if Opened then
			if BlurEnabled then
				Blurs[Settings.Title].root.Parent = nil
			end

			Opened = false
			SyncButton()
			Animations:Close(Window)
			Window.Visible = false
			Fire("Close")
		else
			Animations:Open(Window, Setup.Transparency)
			Opened = true
			SyncButton()
			Fire("Open")

			if BlurEnabled then
				Blurs[Settings.Title].root.Parent = workspace.CurrentCamera
			end
		end
	end

	for Index, Button in next, Sidebar.Top.Buttons:GetChildren() do
		if Button:IsA("TextButton") then
			local Name = Button.Name
			Animations:Component(Button, true)
			Animations:Press(Button, .86)

			Connect(Button.MouseButton1Click, function() 
				if Name == "Close" then
					--// red dot: delete the whole UI and every system in it (CreateWindow({ CloseDialog = false }) = no confirm)
					if Settings.CloseDialog == false then
						Library:DestroyAll()
					else
						Options:Popup({
							Title = Settings.CloseTitle or "Delete UI",
							Content = Settings.CloseContent or "Do you want to close this window? Everything will be deleted and you will need to run the script again to open it.",
							Buttons = {
								{ Title = "Cancel" },
								{ Title = "Delete All", Variant = "Primary", Callback = function() Library:DestroyAll() end },
							},
						})
					end
				elseif Name == "Maximize" then
					if Maximized then
						Maximized = false
						Tween(Window, .15, { Size = Setup.Size });
					else
						Maximized = true
						Tween(Window, .15, { Size = UDim2.fromScale(1, 1), Position = UDim2.fromScale(0.5, 0.5 )});
					end
				elseif Name == "Minimize" then
					Opened = false
					Window.Visible = false
					SyncButton()
					Fire("Close")

					if BlurEnabled and Blurs[Settings.Title] then
						Blurs[Settings.Title].root.Parent = nil
					end
				end
			end)
		end
	end

	--// ------------------------------------------------------------------
	--// WindUI style window controls (top-right):  [ minimize ] [ fullscreen ] [ close ]
	--//   * big hit area (34x28), hover + press feedback, icons follow the theme
	--//   * minimize  = hide the window (reopen with the OpenButton / toggle key)
	--//   * fullscreen = smooth toggle, remembers the old size + position
	--//   * close     = confirm dialog -> Window:Destroy()   (CreateWindow({ CloseDialog = false }) = destroy at once)
	--// The old three colour dots are hidden; the window title now sits in the sidebar header.
	--// ------------------------------------------------------------------
	local ControlsInset = 36 --// height reserved at the top of every tab so content never sits under the buttons
	local CurrentInset = 0   --// 36 once the top bar exists (both "Buttons" and "Dots" style)
	local TabScrolls = {}    --// every tab's scroll frame + its original size / position
	local RefreshTags = function() end --// replaced by the tag strip once Window:Tag() is used
	local ControlStyle = "Buttons"
	local TagsWidth = 0    --// total width of the Window:Tag pills (the hub name leaves room for them)
	local RefitTitle = function() end
	local DoFullscreen = function() end --// set by the control buttons: toggles fullscreen
	local TopBarFrame      --// header strip across the top of the content area (holds the Window:Tag pills); filled in "Dots" style

	local function PlaceScroll(Info)
		local Scroll, Pos, Size = Info.Scroll, Info.Position, Info.Size
		local Anchor = Scroll.AnchorPoint

		Scroll.Size = UDim2.new(Size.X.Scale, Size.X.Offset, Size.Y.Scale, Size.Y.Offset - CurrentInset)
		Scroll.Position = UDim2.new(Pos.X.Scale, Pos.X.Offset, Pos.Y.Scale, Pos.Y.Offset + CurrentInset * (1 - Anchor.Y))
	end

	do
		local TopFrame = Sidebar:FindFirstChild("Top")
		local OldDots = TopFrame and TopFrame:FindFirstChild("Buttons")
		local TitleLabel
		local TitleStyle
		local DotVisible = {}

		if OldDots then
			for _, Dot in next, OldDots:GetChildren() do
				if Dot:IsA("GuiObject") then DotVisible[Dot] = Dot.Visible end
			end
		end

		--// hub name in the sidebar header (tags are placed right after it)
		--//   CreateWindow({ Title = "My Hub" })   (HubName / Name also work)   ShowTitle = false hides it
		--//   Window:SetTitle("New name")  /  Window:GetTitle()
		local TitleText = tostring(Settings.HubName or Settings.Name or Settings.Title or "")
		local ShowTitle = Settings.ShowTitle ~= false
		local FitTitle = function() end

		--// sub text under the hub name:  CreateWindow({ SubTitle = "..." })  (Subtitle / Desc also work)
		local SubText = tostring(Settings.SubTitle or Settings.Subtitle or Settings.Desc or "")
		local SubSize = tonumber(Settings.SubTitleSize or Settings.SubtitleSize) or 11
		local SubColor = Settings.SubTitleColor or Settings.SubtitleColor
		local SubLabel

		--// sub text needs more room: the header area at the top of the window grows a little (default +12px, CreateWindow({ SubTitleSpace = 16 }) to change).
		--// The sidebar header gets taller, the tab list moves down by the same amount and every tab's content starts lower, so nothing is squeezed.
		--// (decided once here, because the sub text can not be changed after CreateWindow)
		if SubText ~= "" and ShowTitle and TopFrame then
			local Extra = math.max(tonumber(Settings.SubTitleSpace or Settings.SubtitleSpace) or 12, 0)

			if Extra > 0 then
				local Size = TopFrame.Size
				TopFrame.Size = UDim2.new(Size.X.Scale, Size.X.Offset, Size.Y.Scale, Size.Y.Offset + Extra)

				local Anchor = Tab.AnchorPoint
				local Pos, TabSize = Tab.Position, Tab.Size
				Tab.Position = UDim2.new(Pos.X.Scale, Pos.X.Offset, Pos.Y.Scale, Pos.Y.Offset + Extra * (1 - Anchor.Y))
				Tab.Size = UDim2.new(TabSize.X.Scale, TabSize.X.Offset, TabSize.Y.Scale, TabSize.Y.Offset - Extra)

				ControlsInset = ControlsInset + Extra --// tab content starts below the taller header
			end
		end

		local function SubColorValue()
			if SubColor ~= nil then
				if typeof(SubColor) == "Color3" then return SubColor end
				if type(SubColor) == "string" then
					local Ok, Result = pcall(Color3.fromHex, SubColor)
					if Ok then return Result end
				end
			end
			return Theme.Title
		end

		if TopFrame then
			TitleLabel = Instance.new("TextLabel")
			SetProperty(TitleLabel, {
				Name = "WindowTitle",
				AnchorPoint = Vector2.new(0, .5),
				Position = UDim2.new(0, 14, .5, 0),
				Size = UDim2.fromOffset(60, 20),
				BackgroundTransparency = 1,
				Text = TitleText,
				Font = Enum.Font.GothamBold,
				TextSize = 14,
				TextColor3 = Theme.Title,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				ZIndex = 16,
				Parent = Window, --// lives in the window (not the narrow sidebar) so a long hub name can run across the top like WindUI
			})

			SubLabel = Instance.new("TextLabel")
			SetProperty(SubLabel, {
				Name = "WindowSubTitle",
				AnchorPoint = Vector2.new(0, .5),
				Position = UDim2.new(0, 14, .5, 9),
				Size = UDim2.fromOffset(60, 14),
				BackgroundTransparency = 1,
				Text = SubText,
				Font = Enum.Font.Gotham,
				TextSize = SubSize,
				TextColor3 = SubColorValue(),
				TextTransparency = SubColor == nil and .4 or 0,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Visible = SubText ~= "",
				ZIndex = 16,
				Parent = Window,
			})
			table.insert(Custom, function() SubLabel.TextColor3 = SubColorValue() end)

			--// Fallback x-position (px from the left of the sidebar header) used when the dots
			--// have not been laid out yet, so the title can never sit on top of them.
			local DotsFallback = 76

			FitTitle = function()
				if not TitleLabel or not TitleLabel.Parent then return end

				--// everything below is in WINDOW coordinates (the title is a child of the window)
				local WindowX, WindowY, WindowW = Window.AbsolutePosition.X, Window.AbsolutePosition.Y, Window.AbsoluteSize.X
				local TopX = TopFrame.AbsolutePosition.X - WindowX
				local CenterY = TopFrame.AbsolutePosition.Y - WindowY + TopFrame.AbsoluteSize.Y / 2

				--// "Buttons" style: title sits at the left edge.
				--// "Dots" style: title starts AFTER the three colour dots so they never overlap.
				local StartX = TopX + 14
				local EndX = WindowW - 10

				local Controls = Window:FindFirstChild("WindowControls")
				if ControlStyle == "Buttons" and Controls and Controls.AbsoluteSize.X > 0 then
					EndX = Controls.AbsolutePosition.X - WindowX - 8 --// stop before the control buttons
				end

				if ControlStyle == "Dots" and OldDots then
					local DotsLeft, DotsRight

					for Dot in next, DotVisible do
						--// only count dots that are really laid out (size > 0), otherwise AbsolutePosition is 0 and the title lands on top of them
						if Dot.Parent and Dot.AbsoluteSize.X > 0 then
							local Left = Dot.AbsolutePosition.X - WindowX
							local Right = Left + Dot.AbsoluteSize.X
							DotsLeft = math.min(DotsLeft or Left, Left)
							DotsRight = math.max(DotsRight or Right, Right)
						end
					end

					if DotsRight and WindowW > 0 then
						if DotsLeft > TopX + TopFrame.AbsoluteSize.X / 2 then
							--// dots sit on the right side of the header: title stays on the left and stops before them
							EndX = math.min(EndX, DotsLeft - 10)
						else
							StartX = math.max(DotsRight + 12, TopX + 14)
						end
					else
						StartX = TopX + DotsFallback
					end
				end

				local Ok, Measured = pcall(function()
					--// measured with the font the label really uses (custom fonts included)
					local Params = Instance.new("GetTextBoundsParams")
					Params.Text = TitleText
					Params.Font = TitleLabel.FontFace
					Params.Size = 14
					Params.Width = 5000
					return GetService(game, "TextService"):GetTextBoundsAsync(Params)
				end)

				if not Ok then
					Ok, Measured = pcall(function()
						return GetService(game, "TextService"):GetTextSize(TitleText, 14, Enum.Font.GothamBold, Vector2.new(5000, 20))
					end)
				end

				local Wanted = (Ok and Measured.X or 80) + 2

				--// long names are allowed: the name may use the whole top row, only leaving room for the tags after it
				local Room = math.max(EndX - StartX, 30)
				local ForTags = (TagsWidth > 0) and math.min(TagsWidth + 8, Room * .45) or 0
				local Max = math.max(Room - ForTags, 30)

				local HasSub = SubText ~= "" and ShowTitle
				--// with sub text the pair (name + sub text) is centred in the (taller) header
				local TitleY = HasSub and (CenterY - 7) or CenterY

				TitleLabel.Position = UDim2.fromOffset(StartX, TitleY)
				TitleLabel.Size = UDim2.fromOffset(math.floor(math.min(Wanted, Max)), 20)

				if SubLabel then
					SubLabel.Visible = HasSub and TitleLabel.Visible
					SubLabel.Position = UDim2.fromOffset(StartX, TitleY + 16)
					SubLabel.Size = UDim2.fromOffset(math.floor(Room), SubSize + 3)
				end
			end

			RefitTitle = FitTitle

			FitTitle()
			Connect(TopFrame:GetPropertyChangedSignal("AbsoluteSize"), FitTitle)
			Connect(Window:GetPropertyChangedSignal("AbsoluteSize"), FitTitle)
			Connect(Window:GetPropertyChangedSignal("AbsolutePosition"), FitTitle)
			Connect(TopFrame:GetPropertyChangedSignal("AbsolutePosition"), FitTitle)
			if OldDots then
				Connect(OldDots:GetPropertyChangedSignal("AbsolutePosition"), FitTitle)
				Connect(OldDots:GetPropertyChangedSignal("AbsoluteSize"), FitTitle)

				--// re-fit whenever any single dot moves / resizes (layout finishing after the window is shown)
				for Dot in next, DotVisible do
					Connect(Dot:GetPropertyChangedSignal("AbsolutePosition"), FitTitle)
					Connect(Dot:GetPropertyChangedSignal("AbsoluteSize"), FitTitle)
				end
			end
			TitleStyle = NewTextStyle(TitleLabel, function() return Theme.Title end)
			table.insert(Custom, function() TitleStyle:Refresh() end) --// keeps a custom colour / gradient after a theme change
		end

		function Options:SetTitle(Text)
			TitleText = tostring(Text or "")
			if TitleLabel then TitleLabel.Text = TitleText end
			FitTitle()
			task.defer(RefreshTags)

			--// the floating open button follows the hub name unless it has its own title
			local Custom_ = type(Settings.OpenButton) == "table" and Settings.OpenButton.Title
			if not Custom_ and Options.OpenButton and Options.OpenButton.SetTitle then
				pcall(function() Options.OpenButton:SetTitle(TitleText) end)
			end
		end

		function Options:GetTitle() return TitleText end

		--// sub text under the hub name
		--// locked like the hub name colour: the sub text can ONLY be set inside CreateWindow({...}); after that these calls are ignored
		function Options:SetSubTitle(Text)
			if Options._StyleLocked then return end
			SubText = tostring(Text or "")
			if SubLabel then SubLabel.Text = SubText end
			FitTitle()
			task.defer(RefreshTags)
		end

		function Options:GetSubTitle() return SubText end

		function Options:SetSubTitleColor(Color)
			if Options._StyleLocked then return end
			SubColor = Color
			if SubLabel then
				SubLabel.TextColor3 = SubColorValue()
				SubLabel.TextTransparency = SubColor == nil and .4 or 0
			end
		end

		function Options:SetSubTitleSize(Size)
			if Options._StyleLocked then return end
			SubSize = tonumber(Size) or SubSize
			if SubLabel then SubLabel.TextSize = SubSize end
			FitTitle()
		end

		Options.SetSubtitle, Options.GetSubtitle = Options.SetSubTitle, Options.GetSubTitle
		Options.SetSubtitleColor, Options.SetSubtitleSize = Options.SetSubTitleColor, Options.SetSubTitleSize

		--// Hub name colour / gradient
		--//   CreateWindow({ Title = "My Hub", TitleColor = "#ffcc00" })
		--//   CreateWindow({ Title = "My Hub", TitleGradient = { "#ff0080", "#7928ca" }, TitleRotation = 0, TitleAnimated = true, TitleSpeed = 40 })
		--//   Window:SetTitleColor("#ffcc00" | Color3)   Window:SetTitleGradient(stops, { Rotation, Animate, Speed })   Window:SetTitleRotation(deg)
		--//   Window:AnimateTitle(true | false | nil(toggle), speed?)   Window:RemoveTitleColor()  -> theme colour   Window:GetTitleGradient()
		--//   The floating open button's title follows the hub name colour unless the button has its own (OpenButton:SetTitleColor / SetTitleGradient).
		local function MirrorTitle()
			local OB = Options.OpenButton
			if not (TitleStyle and OB and OB.TitleStyle) or OB._OwnTitleStyle then return end

			local Target = OB.TitleStyle
			if TitleStyle.Info then
				Target:SetGradient(TitleStyle.Info, { Animate = TitleStyle.Spin.On, Speed = TitleStyle.Spin.Speed })
			elseif TitleStyle.Color then
				Target:SetColor(TitleStyle.Color)
			else
				Target:Remove()
			end
		end
		Options._MirrorTitle = MirrorTitle

		function Options:SetTitleColor(Color)
			if TitleStyle and not Options._StyleLocked then TitleStyle:SetColor(Color) MirrorTitle() end
		end

		function Options:SetTitleGradient(Stops, Props)
			if TitleStyle and not Options._StyleLocked then TitleStyle:SetGradient(Stops, Props) MirrorTitle() end
		end

		function Options:SetTitleRotation(Degrees)
			if TitleStyle and not Options._StyleLocked then TitleStyle:SetRotation(Degrees) MirrorTitle() end
		end

		function Options:AnimateTitle(On, Speed)
			if TitleStyle and not Options._StyleLocked then TitleStyle.Spin:Set(On, Speed) MirrorTitle() end
		end

		function Options:RemoveTitleColor()
			if TitleStyle and not Options._StyleLocked then TitleStyle:Remove() MirrorTitle() end
		end

		function Options:GetTitleGradient() return TitleStyle and TitleStyle.Info end

		if Settings.TitleGradient ~= nil then
			local Animate = Settings.TitleAnimated
			if Animate == nil and Settings.TitleSpeed ~= nil then Animate = true end --// TitleSpeed alone starts the rotation

			Options:SetTitleGradient(Settings.TitleGradient, { Rotation = Settings.TitleRotation, Animate = Animate, Speed = Settings.TitleSpeed })
		elseif Settings.TitleColor ~= nil then
			Options:SetTitleColor(Settings.TitleColor)
		end

		function Options:SetFont(Value) return Library:SetFont(Value) end
		function Options:GetFont() return CurrentFamily end

		--// font changed -> hub name / tags are measured again
		function Options:_RefitFont()
			RefitTitle()
			task.defer(RefreshTags)
		end
		Options.SetHubName, Options.GetHubName = Options.SetTitle, Options.GetTitle

		--// bar
		local Bar = Instance.new("Frame")
		SetProperty(Bar, {
			Name = "WindowControls",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -8, 0, 4),
			Size = UDim2.fromOffset(0, 28),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 20,
			Parent = Window,
		})

