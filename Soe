--// ---------------------------------------------------------------
--// Spinner: slowly rotates a UIGradient (degrees per second)
--//   GetGradient() -> the UIGradient to rotate   InGame() -> false once its owner was destroyed   IsActive() -> optional, false = pause
--// ---------------------------------------------------------------
local function NewSpinner(GetGradient, InGame, IsActive)
	local Spin = { On = false, Speed = 30, Conn = nil }
	local Seen = false

	function Spin:Set(On, Speed)
		if type(On) == "table" then On, Speed = (On.Enabled ~= false), On.Speed end
		if Speed ~= nil then Spin.Speed = tonumber(Speed) or Spin.Speed end

		if On == nil then On = not Spin.On end
		On = On == true
		if On == Spin.On then return end

		Spin.On = On

		if Spin.Conn then
			Spin.Conn:Disconnect()
			Spin.Conn = nil
		end

		if On then
			Seen = false

			Spin.Conn = Connect(Services.Run.Heartbeat, function(Delta)
				if InGame() then
					Seen = true
				elseif Seen then --// it was in the game and is gone now -> destroyed
					if Spin.Conn then Spin.Conn:Disconnect() Spin.Conn = nil end
					Spin.On = false
					return
				end

				if IsActive and not IsActive() then return end

				local Gradient = GetGradient()
				if Gradient and Gradient.Parent then
					Gradient.Rotation = (Gradient.Rotation + Spin.Speed * Delta) % 360
				end
			end)
		end
	end

	return Spin
end

--// ---------------------------------------------------------------
--// Text style: a solid colour OR a (rotating) gradient on a TextLabel; falls back to the theme colour
--//   Style:SetColor(color)  Style:SetGradient(stops, { Rotation, Offset, Animate, Speed })  Style:SetRotation(deg)
--//   Style.Spin:Set(on, speed)  Style:Remove()  Style:Refresh() (call after a theme change)
--// ---------------------------------------------------------------
local function NewTextStyle(Label, GetDefault)
	local Style = { Color = nil, Info = nil, Gradient = nil }

	Style.Spin = NewSpinner(
		function() return Style.Gradient end,
		function() return Label:IsDescendantOf(game) end
	)

	function Style:Refresh()
		if Style.Info then
			Label.TextColor3 = Color3.new(1, 1, 1) --// the gradient is multiplied with the text colour
		elseif Style.Color then
			Label.TextColor3 = Style.Color
		else
			Label.TextColor3 = GetDefault()
		end
	end

	local function DropGradient()
		if Style.Gradient then Style.Gradient:Destroy() end
		Style.Gradient, Style.Info = nil, nil
	end

	function Style:SetColor(Color)
		local Value = ToColor(Color)
		assert(Value, '[UI LIB]: a text colour needs a Color3 or a hex string such as "#ff8800"')

		DropGradient()
		Style.Color = Value
		Style:Refresh()
	end

	function Style:SetGradient(Stops, Props)
		Props = type(Props) == "table" and Props or {}
		local Info = ParseGradient(Stops, Props)

		if not (Style.Gradient and Style.Gradient.Parent) then
			Style.Gradient = Instance.new("UIGradient")
			Style.Gradient.Parent = Label
		end

		Style.Gradient.Color = Info.Color
		Style.Gradient.Transparency = Info.Transparency
		Style.Gradient.Rotation = Info.Rotation
		Style.Gradient.Offset = Info.Offset
		Style.Info, Style.Color = Info, nil
		Style:Refresh()

		if Props.Animate ~= nil then
			Style.Spin:Set(Props.Animate, Props.Speed)
		elseif Props.Speed ~= nil then
			Style.Spin.Speed = tonumber(Props.Speed) or Style.Spin.Speed
		end
	end

	function Style:SetRotation(Degrees)
		Degrees = tonumber(Degrees) or 0
		if Style.Info then Style.Info.Rotation = Degrees end
		if Style.Gradient then Style.Gradient.Rotation = Degrees end
	end

	function Style:Remove()
		Style.Spin:Set(false)
		DropGradient()
		Style.Color = nil
		Style:Refresh()
	end

	return Style
end

