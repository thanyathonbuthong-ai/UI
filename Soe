	function Options:AddTextarea(Settings: { Title: string, Description: string, Default: string, Placeholder: string, Height: number, Locked: boolean, LockedTitle: string, Tab: Instance, Callback: any })
		local Row, _, _, Bottom = NewRow(Settings, Settings.Height or 120, 0, true)
		local Object = BaseObject(Row, AddLock(Row, Settings))

		local Holder = Instance.new("Frame")
		SetProperty(Holder, {
			Name = "TextAreaHolder",
			Position = UDim2.fromOffset(14, Bottom),
			Size = UDim2.new(1, -28, 1, -(Bottom + 12)),
			BackgroundColor3 = Theme.Interactables,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Parent = Row,
		})
		Corner(Holder, 5)

		local Pad = Instance.new("UIPadding")
		Pad.PaddingLeft, Pad.PaddingRight, Pad.PaddingTop, Pad.PaddingBottom = UDim.new(0, 8), UDim.new(0, 8), UDim.new(0, 6), UDim.new(0, 6)
		Pad.Parent = Holder

		local Box = Instance.new("TextBox")
		SetProperty(Box, {
			Name = "TextArea",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			MultiLine = true,
			TextWrapped = true,
			ClearTextOnFocus = false,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			FontFace = DescRef.FontFace,
			TextSize = 13,
			TextColor3 = Theme.Title,
			PlaceholderColor3 = Theme.Description,
			PlaceholderText = Settings.Placeholder or "Enter text...",
			Text = Settings.Default or Settings.Value or "",
			Parent = Holder,
		})

		Animations:Press(Row, .985)
		Connect(Row.MouseButton1Click, function() Box:CaptureFocus() end)
		Connect(Box.FocusLost, function()
			if Settings.Callback then Settings.Callback(Box.Text) end
		end)

		function Object:Set(New, Silent)
			Box.Text = tostring(New or "")
			if not Silent and Settings.Callback then Settings.Callback(Box.Text) end
		end
		function Object:Get() return Box.Text end

		table.insert(Custom, function()
			Holder.BackgroundColor3 = Theme.Interactables
			Box.TextColor3 = Theme.Title
			Box.PlaceholderColor3 = Theme.Description
		end)

		return Object
	end

	--// ------------------------------------------------------------------
	--// Colorpicker  (HSV box + hue bar + optional transparency + hex)
	--// Callback(Color3, Transparency)
	--// ------------------------------------------------------------------
	function Options:AddColorpicker(Settings: { Title: string, Description: string, Default: Color3, Transparency: number?, Locked: boolean, LockedTitle: string, Tab: Instance, Callback: any })
		local Row = NewRow(Settings, nil, 52)
		local Object = BaseObject(Row, AddLock(Row, Settings))

		local Default = Settings.Default or Color3.fromRGB(255, 255, 255)
		local H, S, V = Default:ToHSV()
		local HasAlpha = Settings.Transparency ~= nil
		local A = Settings.Transparency or 0

		local Preview = Instance.new("Frame")
		SetProperty(Preview, {
			Name = "Preview",
			AnchorPoint = Vector2.new(1, .5),
			Position = UDim2.new(1, -14, .5, 0),
			Size = UDim2.fromOffset(40, 22),
			BackgroundColor3 = Default,
			BackgroundTransparency = A,
			BorderSizePixel = 0,
			Parent = Row,
		})
		Corner(Preview, 5)
		Stroke(Preview)

		local Sink, Panel, SV, Cursor, HueHandle, AlphaBack, AlphaFill, AlphaHandle, HexBox

		local function Apply(Silent)
			local Picked = Color3.fromHSV(H, S, V)
			Preview.BackgroundColor3 = Picked
			Preview.BackgroundTransparency = A

			if Panel then
				SV.BackgroundColor3 = Color3.fromHSV(H, 1, 1)
				Cursor.Position = UDim2.fromScale(S, 1 - V)
				HueHandle.Position = UDim2.fromScale(H, .5)
				HexBox.Text = "#" .. Picked:ToHex()

				if HasAlpha then
					AlphaFill.BackgroundColor3 = Picked
					AlphaHandle.Position = UDim2.fromScale(A, .5)
				end
			end

			if not Silent and Settings.Callback then
				Settings.Callback(Picked, A)
			end
		end

		local function Close()
			if Sink then
				Sink.Visible = false
				Sink.BackgroundTransparency = 1
			end
		end

		local function Build()
			Sink = NewSink()
			Sink.Visible = false
			Connect(Sink.MouseButton1Click, Close)

			local PanelHeight = (HasAlpha and 246) or 224
			Panel = Instance.new("Frame")
			SetProperty(Panel, {
				Name = "ColorpickerPanel",
				Active = true, --// swallow clicks so the sink doesn't close the panel
				AnchorPoint = Vector2.new(.5, .5),
				Position = UDim2.fromScale(.5, .5),
				Size = UDim2.fromOffset(250, PanelHeight),
				BackgroundColor3 = SolidBoxColor(),
				BorderSizePixel = 0,
				Parent = Sink,
			})
			Corner(Panel, 8)
			Stroke(Panel)

			local PanelTitle = Label(Panel, "Title", Settings.Title or "Colorpicker", TitleRef, Theme.Title)
			SetProperty(PanelTitle, { Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -24, 0, 18) })

			--// Saturation / Value box
			SV = Instance.new("Frame")
			SetProperty(SV, { Name = "SV", Position = UDim2.fromOffset(12, 32), Size = UDim2.new(1, -24, 0, 120), BorderSizePixel = 0, Parent = Panel })
			Corner(SV, 4)

			local White = Instance.new("Frame")
			SetProperty(White, { Name = "White", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = SV })
			Corner(White, 4)
			local WhiteGradient = Instance.new("UIGradient")
			WhiteGradient.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
			WhiteGradient.Parent = White

			local Black = Instance.new("Frame")
			SetProperty(Black, { Name = "Black", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Parent = SV })
			Corner(Black, 4)
			local BlackGradient = Instance.new("UIGradient")
			BlackGradient.Rotation = 90
			BlackGradient.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
			BlackGradient.Parent = Black

			Cursor = Instance.new("Frame")
			SetProperty(Cursor, { Name = "Cursor", AnchorPoint = Vector2.new(.5, .5), Size = UDim2.fromOffset(12, 12), BackgroundTransparency = 1, Parent = SV })
			Corner(Cursor, 6)
			local CursorStroke = Instance.new("UIStroke")
			CursorStroke.Name = "CursorStroke"
			CursorStroke.Color = Color3.new(1, 1, 1)
			CursorStroke.Thickness = 2
			CursorStroke.Parent = Cursor

			Track(SV, function(X, Y)
				S = math.clamp((X - SV.AbsolutePosition.X) / SV.AbsoluteSize.X, 0, 1)
				V = 1 - math.clamp((Y - SV.AbsolutePosition.Y) / SV.AbsoluteSize.Y, 0, 1)
				Apply()
			end)

			--// Hue bar
			local Hue = Instance.new("Frame")
			SetProperty(Hue, { Name = "Hue", Position = UDim2.fromOffset(12, 160), Size = UDim2.new(1, -24, 0, 14), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = Panel })
			Corner(Hue, 4)
			local HueGradient = Instance.new("UIGradient")
			local Keys = {}
			for Step = 0, 6 do
				table.insert(Keys, ColorSequenceKeypoint.new(Step / 6, Color3.fromHSV(Step / 6, 1, 1)))
			end
			HueGradient.Color = ColorSequence.new(Keys)
			HueGradient.Parent = Hue

			HueHandle = Instance.new("Frame")
			SetProperty(HueHandle, { Name = "Handle", AnchorPoint = Vector2.new(.5, .5), Size = UDim2.new(0, 4, 1, 6), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = Hue })
			Corner(HueHandle, 2)

			Track(Hue, function(X)
				H = math.clamp((X - Hue.AbsolutePosition.X) / Hue.AbsoluteSize.X, 0, 1)
				Apply()
			end)

			--// Transparency bar (only when Transparency was given)
			if HasAlpha then
				AlphaBack = Instance.new("Frame")
				SetProperty(AlphaBack, { Name = "AlphaBack", Position = UDim2.fromOffset(12, 182), Size = UDim2.new(1, -24, 0, 14), BackgroundColor3 = Theme.Interactables, BorderSizePixel = 0, Parent = Panel })
				Corner(AlphaBack, 4)

				AlphaFill = Instance.new("Frame")
				SetProperty(AlphaFill, { Name = "AlphaFill", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromHSV(H, S, V), BorderSizePixel = 0, Parent = AlphaBack })
				Corner(AlphaFill, 4)
				local AlphaGradient = Instance.new("UIGradient")
				AlphaGradient.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
				AlphaGradient.Parent = AlphaFill

				AlphaHandle = Instance.new("Frame")
				SetProperty(AlphaHandle, { Name = "Handle", AnchorPoint = Vector2.new(.5, .5), Size = UDim2.new(0, 4, 1, 6), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = AlphaBack })
				Corner(AlphaHandle, 2)

				Track(AlphaBack, function(X)
					A = math.clamp((X - AlphaBack.AbsolutePosition.X) / AlphaBack.AbsoluteSize.X, 0, 1)
					Apply()
				end)
			end

			--// Hex + Done
			local HexY = (HasAlpha and 206) or 184

			HexBox = Instance.new("TextBox")
			SetProperty(HexBox, {
				Name = "HexBox",
				Position = UDim2.fromOffset(12, HexY),
				Size = UDim2.new(1, -90, 0, 26),
				BackgroundColor3 = Theme.Interactables,
				BorderSizePixel = 0,
				ClearTextOnFocus = false,
				FontFace = DescRef.FontFace,
				TextSize = 13,
				TextColor3 = Theme.Title,
				PlaceholderText = "#FFFFFF",
				Text = "",
				Parent = Panel,
			})
			Corner(HexBox, 5)

			Connect(HexBox.FocusLost, function()
				local Ok, Parsed = pcall(Color3.fromHex, HexBox.Text)

				if Ok and Parsed then
					H, S, V = Parsed:ToHSV()
				end

				Apply()
			end)

			local Done = Instance.new("TextButton")
			SetProperty(Done, {
				Name = "Done",
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -12, 0, HexY),
				Size = UDim2.fromOffset(64, 26),
				BackgroundColor3 = Accent,
				BorderSizePixel = 0,
				AutoButtonColor = true,
				Text = "Done",
				FontFace = TitleRef.FontFace,
				TextSize = 13,
				TextColor3 = Color3.new(1, 1, 1),
				Parent = Panel,
			})
			Corner(Done, 5)
			Animations:Press(Done, .9)
			Connect(Done.MouseButton1Click, Close)

			Elevate(Sink, 99)
		end

		Animations:Press(Row, .975)

		Connect(Row.MouseButton1Click, function()
			if not Panel then Build() end

			Apply(true)
			Sink.Visible = true
			Tween(Sink, .2, { BackgroundTransparency = .55 })
		end)

		function Object:Set(New: Color3, NewTransparency: number?, Silent: boolean?)
			if New then H, S, V = New:ToHSV() end
			if NewTransparency then A = NewTransparency end
			Apply(Silent)
		end

		function Object:Get() return Color3.fromHSV(H, S, V), A end

		table.insert(Custom, function()
			if Panel then
				Panel.BackgroundColor3 = SolidBoxColor()
				HexBox.BackgroundColor3 = Theme.Interactables
				HexBox.TextColor3 = Theme.Title
				if AlphaBack then AlphaBack.BackgroundColor3 = Theme.Interactables end
			end
		end)

		function Object:Save() return { Color = "#" .. Color3.fromHSV(H, S, V):ToHex(), Alpha = A } end
		function Object:Load(Data)
			if type(Data) == "table" and Data.Color then
				local Ok, Parsed = pcall(Color3.fromHex, Data.Color)
				if Ok then Object:Set(Parsed, Data.Alpha) end
			end
		end

		Apply(true)
		return Object
	end

	--// ------------------------------------------------------------------
	--// Layout helpers: Space / Divider / Group
	--// ------------------------------------------------------------------
	function Options:AddSpace(Settings: { Tab: Instance, Columns: number?, Size: number? })
		Settings = Settings or {}
		local InGroup = Settings.Tab and (Settings.Tab.Name == "Group" or Settings.Tab.Name == "HStack")
		local Amount = Settings.Size or ((Settings.Columns or 1) * 6)

		local Space = Instance.new("Frame")
		SetProperty(Space, {
			Name = "Space",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = (InGroup and UDim2.fromOffset(Amount, 1)) or UDim2.new(RowWidth.Scale, RowWidth.Offset, 0, Amount),
			Parent = Settings.Tab,
		})

		return Space
	end

	function Options:AddDivider(Settings: { Tab: Instance })
		Settings = Settings or {}

		local Wrap = Instance.new("Frame")
		SetProperty(Wrap, {
			Name = "Divider",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.new(RowWidth.Scale, RowWidth.Offset, 0, 10),
			Parent = Settings.Tab,
		})

		local Line = Instance.new("Frame")
		SetProperty(Line, {
			Name = "Underline", --// themed automatically
			AnchorPoint = Vector2.new(0, .5),
			Position = UDim2.fromScale(0, .5),
			Size = UDim2.new(1, 0, 0, 1),
			BackgroundColor3 = Theme.Outline,
			BorderSizePixel = 0,
			Parent = Wrap,
		})

		return Wrap
	end

	--// Put elements side by side:  local G = Options:AddGroup({ Tab = Tab }) ; Options:AddButton({ Tab = G, ... })
	function Options:AddGroup(Settings: { Tab: Instance, Gap: number? })
		Settings = Settings or {}
		local Gap = Settings.Gap or 6
		local Order = 0

		local Group = Instance.new("Frame")
		SetProperty(Group, {
			Name = "Group",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(RowWidth.Scale, RowWidth.Offset, 0, 0),
			Parent = Settings.Tab,
		})

		local Layout = Instance.new("UIListLayout")
		SetProperty(Layout, {
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Top,
			Padding = UDim.new(0, Gap),
			Parent = Group,
		})

		local function Refit()
			local Items = {}

			for _, Child in next, Group:GetChildren() do
				if Child:IsA("GuiObject") and Child.Name ~= "Space" then
					table.insert(Items, Child)
				end
			end

			local Count = #Items
			if Count == 0 then return end

			for _, Child in next, Items do
				Child.Size = UDim2.new(1 / Count, -math.ceil(Gap * (Count - 1) / Count), Child.Size.Y.Scale, Child.Size.Y.Offset)
			end
		end

		Connect(Group.ChildAdded, function(Child)
			if Child:IsA("GuiObject") then
				Order = Order + 1
				Child.LayoutOrder = Order
				task.defer(Refit)
			end
		end)

		Connect(Group.ChildRemoved, function()
			task.defer(Refit)
		end)

		return Group
	end

	--// ------------------------------------------------------------------
	--// Code block with Copy button
	--// ------------------------------------------------------------------
	function Options:AddCode(Settings: { Title: string, Description: string, Code: string, MaxHeight: number?, Tab: Instance })
		local Code = Settings.Code or ""
		local Lines = select(2, Code:gsub("\n", "\n")) + 1
		local BoxHeight = math.min(Lines * 16 + 12, Settings.MaxHeight or 180)

		local Row, _, _, Bottom = NewRow(Settings, 0, 70, true)
		Bottom = math.max(Bottom, 38)
		Row.Size = UDim2.new(RowWidth.Scale, RowWidth.Offset, 0, Bottom + BoxHeight + 12)

		local Holder = Instance.new("ScrollingFrame")
		SetProperty(Holder, {
			Name = "CodeHolder",
			Position = UDim2.fromOffset(14, Bottom),
			Size = UDim2.new(1, -28, 0, BoxHeight),
			BackgroundColor3 = Theme.Interactables,
			BorderSizePixel = 0,
			ScrollBarThickness = 3,
			AutomaticCanvasSize = Enum.AutomaticSize.XY,
			CanvasSize = UDim2.fromOffset(0, 0),
			ScrollingDirection = Enum.ScrollingDirection.XY,
			Parent = Row,
		})
		Corner(Holder, 5)

		local Pad = Instance.new("UIPadding")
		Pad.PaddingLeft, Pad.PaddingRight, Pad.PaddingTop, Pad.PaddingBottom = UDim.new(0, 8), UDim.new(0, 8), UDim.new(0, 6), UDim.new(0, 6)
		Pad.Parent = Holder

		local CodeText = Instance.new("TextLabel")
		SetProperty(CodeText, {
			Name = "CodeText",
			BackgroundTransparency = 1,
			AutomaticSize = Enum.AutomaticSize.XY,
			Size = UDim2.fromOffset(0, 0),
			Font = Enum.Font.Code,
			TextSize = 13,
			TextColor3 = Theme.Title,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			RichText = false,
			Text = Code,
			Parent = Holder,
		})

		local Copy = Instance.new("TextButton")
		SetProperty(Copy, {
			Name = "Copy",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -14, 0, 8),
			Size = UDim2.fromOffset(54, 22),
			BackgroundColor3 = Theme.Interactables,
			BorderSizePixel = 0,
			Text = "Copy",
			FontFace = TitleRef.FontFace,
			TextSize = 12,
			TextColor3 = Theme.Title,
			Parent = Row,
		})
		Corner(Copy, 5)

		Animations:Press(Copy, .88)

		Connect(Copy.MouseButton1Click, function()
			local Clip = setclipboard or toclipboard or set_clipboard

			if Clip then
				Clip(Code)
				Options:Notify({ Title = "Copied", Description = "Code copied to clipboard", Duration = 1.5 })

				--// WindUI: OnCopy = function(code) end
				if type(Settings.OnCopy) == "function" then task.spawn(Settings.OnCopy, Code) end
			end
		end)

		table.insert(Custom, function()
			Holder.BackgroundColor3 = Theme.Interactables
			CodeText.TextColor3 = Theme.Title
			Copy.BackgroundColor3 = Theme.Interactables
			Copy.TextColor3 = Theme.Title
		end)

		local Object = { Instance = Row, Destroy = function() Destroy(Row) end }

		--// WindUI: Code:SetCode("...")
		function Object:SetCode(New)
			Code = tostring(New or "")
			CodeText.Text = Code
		end

		return Object
	end

	--// ------------------------------------------------------------------
	--// Image   (rbxassetid or http(s) url when the executor supports it)
	--// ------------------------------------------------------------------
	function Options:AddImage(Settings: { Image: string, AspectRatio: string?, Height: number?, Radius: number?, Tab: Instance })
		local Source = Settings.Image

		if type(Source) == "string" and Source:find("^https?://") and writefile and getcustomasset then
			local Ok, Result = pcall(function()
				local Hash = 0
				for Index = 1, #Source do
					Hash = (Hash * 31 + Source:byte(Index)) % 1000000007
				end

				local File = "uilib_img_" .. Hash .. ".png"
				if not (isfile and isfile(File)) then
					writefile(File, game:HttpGet(Source))
				end

				return getcustomasset(File)
			end)

			if Ok then Source = Result end
		end

		local Picture = Instance.new("ImageLabel")
		SetProperty(Picture, {
			Name = "Outline", --// harmless name: stops SetTheme from recolouring the picture
			Image = Source or "",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScaleType = Enum.ScaleType.Crop,
			Size = UDim2.new(RowWidth.Scale, RowWidth.Offset, 0, Settings.Height or 140),
			Parent = Settings.Tab,
		})
		Corner(Picture, Settings.Radius or 8)

		local Width, Height = (Settings.AspectRatio or ""):match("(%d+):(%d+)")
		if Width and Height then
			Picture.Size = UDim2.new(RowWidth.Scale, RowWidth.Offset, 0, 0)

			local Ratio = Instance.new("UIAspectRatioConstraint")
			Ratio.AspectRatio = tonumber(Width) / tonumber(Height)
			Ratio.DominantAxis = Enum.DominantAxis.Width
			Ratio.Parent = Picture
		end

		return Picture
	end

	--// ------------------------------------------------------------------
	--// Popup / Dialog
	--// Options:Popup({ Title, Content, Buttons = { { Title, Variant = "Primary"|"Tertiary", Callback } } })
	--// Multi-choice: Options:Popup({ Multi = true, Buttons = { { Title = "A", Selected = true }, { Title = "B" }, { Title = "OK", Variant = "Primary", Callback = function(Chosen) end } } })
	--// ------------------------------------------------------------------
	function Options:Popup(Settings: { Title: string, Content: string, Buttons: {} })
		Settings = Settings or {}

		local Sink = NewSink()
		local Panel = Instance.new("Frame")
		SetProperty(Panel, {
			Name = "PopupPanel",
			Active = true,
			AnchorPoint = Vector2.new(.5, .5),
			Position = UDim2.fromScale(.5, .5),
			Size = UDim2.fromOffset(300, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = SolidBoxColor(),
			BackgroundTransparency = 0,
			BorderSizePixel = 0,
			Parent = Sink,
		})
		Corner(Panel, 8)
		Stroke(Panel)

		local Pad = Instance.new("UIPadding")
		Pad.PaddingLeft, Pad.PaddingRight, Pad.PaddingTop, Pad.PaddingBottom = UDim.new(0, 14), UDim.new(0, 14), UDim.new(0, 14), UDim.new(0, 14)
		Pad.Parent = Panel

		local List = Instance.new("UIListLayout")
		List.SortOrder = Enum.SortOrder.LayoutOrder
		List.Padding = UDim.new(0, 8)
		List.Parent = Panel

		local PopupTitle = Label(Panel, "Title", Settings.Title or "", TitleRef, Theme.Title)
		SetProperty(PopupTitle, { Size = UDim2.new(1, 0, 0, 20), TextSize = TitleRef.TextSize + 2, LayoutOrder = 1 })

		local Content = Label(Panel, "Description", Settings.Content or Settings.Description or "", DescRef, Theme.Description)
		SetProperty(Content, {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			TextTruncate = Enum.TextTruncate.None,
			TextYAlignment = Enum.TextYAlignment.Top,
			LayoutOrder = 2,
		})

		local Object = {}
		function Object:Close() Destroy(Sink) end

		--// Multi-choice popup:
		--//   Options:Popup({ Title, Content, Multi = true, Buttons = {
		--//       { Title = "A", Selected = true, Callback = function(IsOn, Chosen) end },   --// option: toggles, popup stays open
		--//       { Title = "B" },
		--//       { Title = "OK", Variant = "Primary", Callback = function(Chosen) end },     --// Primary = confirm, closes
		--//   } })
		--//   Per button:  Select = true/false forces option / plain button,  Close = false keeps the popup open.
		--//   Object:GetSelected() -> { "A", "B" }
		local Choices = {} --// Choices[Index] = true when that option is on
		local Order = {}   --// { Index, Title } of every option, in order
		local Refreshers = {}

		function Object:GetSelected()
			local List = {}
			for _, Item in ipairs(Order) do
				if Choices[Item.Index] then table.insert(List, Item.Title) end
			end
			return List
		end

		for Index, Info in ipairs(Settings.Buttons or {}) do
			local Primary = Info.Variant == "Primary"
			local IsOption = Info.Select
			if IsOption == nil then IsOption = (Settings.Multi == true) and not Primary end

			local Button = Instance.new("TextButton")
			SetProperty(Button, {
				Name = Info.Title or "Button",
				LayoutOrder = 2 + Index,
				Size = UDim2.new(1, 0, 0, 32),
				BackgroundColor3 = (Primary and Accent) or Theme.Interactables,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = Info.Title or "",
				FontFace = TitleRef.FontFace,
				TextSize = 13,
				TextColor3 = (Primary and Color3.new(1, 1, 1)) or Theme.Title,
				Parent = Panel,
			})
			Corner(Button, 5)
			Animations:Press(Button, 0.95)

			if IsOption then
				Choices[Index] = Info.Selected == true
				table.insert(Order, { Index = Index, Title = Info.Title or "" })

				local Ring = Instance.new("UIStroke")
				SetProperty(Ring, { Name = "SelectRing", Color = Accent, Thickness = 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Enabled = false, Parent = Button })

				local Mark = Instance.new("TextLabel")
				SetProperty(Mark, {
					Name = "Check",
					AnchorPoint = Vector2.new(1, .5),
					Position = UDim2.new(1, -10, .5, 0),
					Size = UDim2.fromOffset(18, 18),
					BackgroundTransparency = 1,
					Text = "✓",
					Font = Enum.Font.GothamBold,
					TextSize = 16,
					TextColor3 = Accent,
					Visible = false,
					Parent = Button,
				})

				--// the light: the chosen option gets the accent colour + ring + check mark, the others stay plain
				local function Paint()
					local On = Choices[Index] == true
					Ring.Enabled = On
					Mark.Visible = On
					Tween(Button, .2, { BackgroundColor3 = On and Accent:Lerp(Theme.Interactables, .6) or Theme.Interactables })
				end

				table.insert(Refreshers, Paint)
				Paint()

				Connect(Button.MouseButton1Click, function()
					Choices[Index] = not Choices[Index]
					Paint()

					if Info.Callback then task.spawn(Info.Callback, Choices[Index], Object:GetSelected()) end
					if Info.Close == true then Object:Close() end
				end)
			else
				Connect(Button.MouseButton1Click, function()
					if Info.Callback then
						if Settings.Multi == true then Info.Callback(Object:GetSelected()) else Info.Callback() end
					end

					if Info.Close == false then return end

					--// let the press light be seen on the button that was chosen before the popup goes away
					task.delay(.12, function() Object:Close() end)
				end)
			end
		end

		Elevate(Sink, 99)
		Tween(Sink, .2, { BackgroundTransparency = .55 })

		return Object
	end


	--// =====================================================================
	--//  Extras: Tag, Video, Locked/aliases for every element, Flags + Config
	--// =====================================================================

	local HttpService = GetService(game, "HttpService")
	local WindowSettings = Settings

	--// ------------------------------------------------------------------
	--// Tag  (small badge next to the 3 window dots, auto-scrolls when too many)
	--// Options:Tag({ Title = "v1.0", Color = Color3, TextColor = Color3 })
	--// ------------------------------------------------------------------
	local TagHolder

	function Options:Tag(Info: { Title: string, Color: Color3?, TextColor: Color3? })
		Info = Info or {}

		if not TagHolder then
			local Bounds = Window --// tags float right after the hub name (WindUI style), so they are parented to the window
			local HolderHeight = 22

			--// scrolling strip: when the tags are too long it scrolls sideways instead of overflowing
			TagHolder = Instance.new("ScrollingFrame")
			SetProperty(TagHolder, {
				Name = "Tags",
				AnchorPoint = Vector2.new(0, 0.5),
				Size = UDim2.fromOffset(0, HolderHeight),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Active = true,
				ClipsDescendants = true,
				ScrollingDirection = Enum.ScrollingDirection.X,
				AutomaticCanvasSize = Enum.AutomaticSize.X,
				CanvasSize = UDim2.new(0, 0, 0, 0),
				ScrollBarThickness = 0,
				ElasticBehavior = Enum.ElasticBehavior.Never,
				ZIndex = 16,
				Parent = Bounds,
			})

			local Layout = Instance.new("UIListLayout")
			SetProperty(Layout, {
				FillDirection = Enum.FillDirection.Horizontal,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 4),
				Parent = TagHolder,
			})

			--// mouse wheel scrolls the tags sideways
			Connect(TagHolder.InputChanged, function(Input)
				if Input.UserInputType == Enum.UserInputType.MouseWheel then
					local Max = math.max(TagHolder.AbsoluteCanvasSize.X - TagHolder.AbsoluteSize.X, 0)
					local Next = TagHolder.CanvasPosition.X - Input.Position.Z * 24
					TagHolder.CanvasPosition = Vector2.new(math.clamp(Next, 0, Max), 0)
				end
			end)

			local function Place()
				local Content = Layout.AbsoluteContentSize.X
				local Top = Sidebar:FindFirstChild("Top")
				local Title = Window:FindFirstChild("WindowTitle")

				--// no header found -> strip along the bottom of the sidebar
				if not Top then
					TagHolder.AnchorPoint = Vector2.new(0, 1)
					TagHolder.Position = UDim2.fromOffset(Sidebar.AbsolutePosition.X - Window.AbsolutePosition.X + 10, Sidebar.AbsolutePosition.Y - Window.AbsolutePosition.Y + Sidebar.AbsoluteSize.Y - 10)
					TagHolder.Size = UDim2.fromOffset(math.min(Content, math.max(Sidebar.AbsoluteSize.X - 20, 0)), HolderHeight)
					return
				end

				local WindowX, WindowY, WindowW = Window.AbsolutePosition.X, Window.AbsolutePosition.Y, Window.AbsoluteSize.X
				local TopX = Top.AbsolutePosition.X - WindowX

				--// the tag starts right where the hub name ends (the name's Position / Size are updated instantly,
				--// and the name already sits after the three dots in "Dots" style)
				local StartX = TopX + 14
				if Title then
					StartX = Title.Position.X.Offset --// the title is a child of the window, so this is already window coordinates
					if Title.Visible and Title.Text ~= "" then
						StartX = StartX + Title.Size.X.Offset + 6
					end
				end

				--// same row as the hub name
				local Y = Top.AbsolutePosition.Y - WindowY + Top.AbsoluteSize.Y / 2
				if Title and Title.Visible and Title.Text ~= "" then
					Y = Title.Position.Y.Offset --// follows the hub name (it sits a little higher when there is sub text)
				end

				--// room: up to the right edge of the window (before the control buttons in "Buttons" style)
				local EndX = WindowW - 8
				local Controls = Window:FindFirstChild("WindowControls")
				if ControlStyle == "Buttons" and Controls and Controls.AbsoluteSize.X > 0 then
					EndX = Controls.AbsolutePosition.X - WindowX - 8
				end

				--// tell the hub name how much room the tags need; refit once if it changed
				if math.abs(TagsWidth - Content) > 1 then
					TagsWidth = Content
					task.defer(RefitTitle)
				end

				TagHolder.AnchorPoint = Vector2.new(0, 0.5)
				TagHolder.Position = UDim2.fromOffset(StartX, Y)
				TagHolder.Size = UDim2.fromOffset(math.min(Content, math.max(EndX - StartX, 0)), HolderHeight)
			end

			RefreshTags = Place
			Place()
			Connect(Layout:GetPropertyChangedSignal("AbsoluteContentSize"), Place)
			Connect(Window:GetPropertyChangedSignal("AbsoluteSize"), Place)
			Connect(Window:GetPropertyChangedSignal("AbsolutePosition"), Place)
			Connect(Sidebar:GetPropertyChangedSignal("AbsoluteSize"), Place)

			do
				local TopObject = Sidebar:FindFirstChild("Top")
				local TitleObject = Window:FindFirstChild("WindowTitle")
				local ControlsObject = Window:FindFirstChild("WindowControls")

				if TopObject then
					Connect(TopObject:GetPropertyChangedSignal("AbsoluteSize"), Place)
					Connect(TopObject:GetPropertyChangedSignal("AbsolutePosition"), Place)
				end

				if TitleObject then
					Connect(TitleObject:GetPropertyChangedSignal("Position"), Place)
					Connect(TitleObject:GetPropertyChangedSignal("Size"), Place)
					Connect(TitleObject:GetPropertyChangedSignal("Visible"), Place)
					Connect(TitleObject:GetPropertyChangedSignal("Text"), Place)
				end

				if ControlsObject then
					Connect(ControlsObject:GetPropertyChangedSignal("AbsoluteSize"), Place)
				end
			end

			task.defer(Place)

			--// auto scroll: when the tags do not fit, glide to the end, pause, glide back (pauses while hovered / touched)
			local SCROLL_SPEED = 30 --// pixels per second
			local SCROLL_PAUSE = 1.2 --// seconds to rest at each end
			local Paused, Direction, Resting = false, 1, 0

			Connect(TagHolder.MouseEnter, function() Paused = true end)
			Connect(TagHolder.MouseLeave, function() Paused = false end)
			Connect(TagHolder.InputBegan, function(Input)
				if Input.UserInputType == Enum.UserInputType.Touch then Paused = true end
			end)
			Connect(TagHolder.InputEnded, function(Input)
				if Input.UserInputType == Enum.UserInputType.Touch then Paused = false end
			end)

			Connect(Services.Run.Heartbeat, function(Delta)
				if Paused or not TagHolder.Parent then return end

				local Max = TagHolder.AbsoluteCanvasSize.X - TagHolder.AbsoluteSize.X
				if Max <= 1 then
					if TagHolder.CanvasPosition.X ~= 0 then TagHolder.CanvasPosition = Vector2.zero end
					return
				end

				if Resting > 0 then
					Resting = Resting - Delta
					return
				end

				local Next = TagHolder.CanvasPosition.X + SCROLL_SPEED * Delta * Direction

				if Next >= Max then
					Next, Direction, Resting = Max, -1, SCROLL_PAUSE
				elseif Next <= 0 then
					Next, Direction, Resting = 0, 1, SCROLL_PAUSE
				end

				TagHolder.CanvasPosition = Vector2.new(Next, 0)
			end)
		end

		--// Colours can be a Color3, a hex string ("#ff3366" / "ff3366"), an RGB table { 255, 51, 102 } or { R = , G = , B = }
		local function AsColor(Value)
			if typeof(Value) == "Color3" then return Value end

			if type(Value) == "string" then
				local Ok, Result = pcall(Color3.fromHex, Value)
				if Ok then return Result end
			elseif type(Value) == "table" then
				local R, G, B = Value.R or Value.r or Value[1], Value.G or Value.g or Value[2], Value.B or Value.b or Value[3]
				if tonumber(R) and tonumber(G) and tonumber(B) then
					if R <= 1 and G <= 1 and B <= 1 then return Color3.new(R, G, B) end
					return Color3.fromRGB(R, G, B)
				end
			end
		end

		--// WindUI style:
		--//   Window:Tag({ Title = "v1.0", Color = Color3.fromHex("#30ff6a"), Radius = 13 })
		--//   Color   = background (Color3 / hex string / {r,g,b}); text turns black or white automatically so it stays readable
		--//   Color2  = optional second colour -> gradient     TextColor = force a text colour     Outline = optional border colour
		--//   Returned tag:  :SetTitle(text)  :SetColor(color)  :Destroy()
		local function Pick(Key)
			return Info[Key]
		end

		--// readable text colour for a background (like WindUI)
		local function Contrast(Background)
			local Light = 0.299 * Background.R + 0.587 * Background.G + 0.114 * Background.B
			return Light > 0.6 and Color3.fromRGB(20, 20, 20) or Color3.new(1, 1, 1)
		end

		local Pill = Instance.new("Frame")
		SetProperty(Pill, {
			Name = "Tag",
			Size = UDim2.fromOffset(0, 0),
			AutomaticSize = Enum.AutomaticSize.XY,
			BackgroundColor3 = AsColor(Pick("Color")) or Accent,
			BackgroundTransparency = tonumber(Pick("Transparency")) or 0,
			BorderSizePixel = 0,
			ZIndex = 17,
			Parent = TagHolder,
		})
		Corner(Pill, tonumber(Pick("Radius")) or 99)

		local Pad = Instance.new("UIPadding")
		Pad.PaddingLeft, Pad.PaddingRight, Pad.PaddingTop, Pad.PaddingBottom = UDim.new(0, 8), UDim.new(0, 8), UDim.new(0, 3), UDim.new(0, 3)
		Pad.Parent = Pill

		local Text = Instance.new("TextLabel")
		SetProperty(Text, {
			Name = "TagText",
			Size = UDim2.fromOffset(0, 0),
			AutomaticSize = Enum.AutomaticSize.XY,
			BackgroundTransparency = 1,
			Text = Info.Title or "",
			FontFace = DescRef.FontFace,
			TextSize = tonumber(Pick("TextSize")) or 12,
			TextColor3 = AsColor(Pick("TextColor")) or Contrast(Pill.BackgroundColor3),
			TextWrapped = false,
			ZIndex = 18,
			Parent = Pill,
		})

		local Gradient
		local function SetColors(First, Second)
			local A = AsColor(First) or Accent
			local B = AsColor(Second)

			if B then
				Pill.BackgroundColor3 = Color3.new(1, 1, 1) --// the gradient is multiplied with the background colour
				Gradient = Gradient or Instance.new("UIGradient")
				Gradient.Color = ColorSequence.new(A, B)
				Gradient.Parent = Pill
			else
				Pill.BackgroundColor3 = A
				if Gradient then Gradient:Destroy() Gradient = nil end
			end
		end

		local Color2 = Pick("Color2")
		if Color2 then SetColors(Pick("Color") or Accent, Color2) end

		local Ring
		local function SetOutline(Value)
			local C = AsColor(Value)

			if not C then
				if Ring then Ring:Destroy() Ring = nil end
				return
			end

			if not Ring then
				Ring = Instance.new("UIStroke")
				SetProperty(Ring, { Name = "TagOutline", Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = Pill })
			end
			Ring.Color = C
		end

		local Outline = Pick("Outline") or (Pick("Border") == true and (Pick("TextColor") or Color3.new(1, 1, 1))) or Pick("Border")
		if Outline == false then Outline = nil end
		if Outline then SetOutline(Outline) end

		return {
			Instance = Pill,
			SetTitle = function(_, NewText) Text.Text = tostring(NewText) end,
			SetColor = function(_, NewColor, Second)
				SetColors(NewColor, Second)
				if not AsColor(Pick("TextColor")) then
					Text.TextColor3 = Contrast(AsColor(NewColor) or Accent)
				end
			end,
			Destroy = function() Destroy(Pill) end,
		}
	end

	--// ------------------------------------------------------------------
	--// Video  (rbxassetid / url via getcustomasset). Tap to pause / play.
	--// ------------------------------------------------------------------
	--// Viewport (WindUI): shows a 3D object / model in the page.
	--//   Tab:Viewport({ Object = Model, Height = 200, Interactive = true, Camera = Camera? })
	--//   Interactive = true -> drag to rotate.   Returned: SetObject / SetCamera / SetHeight / SetInteractive / Instance
	function Options:AddViewport(Settings: { Object: Instance, Camera: Camera?, Height: number?, Interactive: boolean?, Focused: boolean?, Tab: Instance })
		local Height = Settings.Height or 200
		local Interactive = Settings.Interactive == true
		local Camera = Settings.Camera or Instance.new("Camera")

		local Frame = Instance.new("ViewportFrame")
		SetProperty(Frame, {
			Name = "Viewport",
			Size = UDim2.new(RowWidth.Scale, RowWidth.Offset, 0, Height),
			BackgroundColor3 = Theme.Component,
			BorderSizePixel = 0,
			CurrentCamera = Camera,
			Parent = Settings.Tab,
		})
		Corner(Frame, 8)
		Camera.Parent = Frame
		table.insert(Custom, function() Frame.BackgroundColor3 = Theme.Component end)

		local Object
		local Yaw, Pitch, Distance = 0, 0, 5

		local function Frameit()
			if not Object then return end

			local Ok, Center, Size = pcall(function()
				if Object:IsA("Model") then return Object:GetBoundingBox() end
				if Object:IsA("BasePart") then return Object.CFrame, Object.Size end
		end)
			if not Ok or not Center then return end

			Distance = math.max(Size.Magnitude * 1.2, 2)
			Frame:SetAttribute("Center", Center.Position)
		end

		local function UpdateCamera()
			local Center = Frame:GetAttribute("Center") or Vector3.zero
			Camera.CFrame = CFrame.new(Center) * CFrame.Angles(0, Yaw, 0) * CFrame.Angles(Pitch, 0, 0) * CFrame.new(0, 0, Distance)
		end

		local function SetObject(New)
			if Object then Object:Destroy() end
			Object = New
			if Object then
				Object.Parent = Frame
				Frameit()
				UpdateCamera()
			end
		end

		if Settings.Object then SetObject(Settings.Object) end

		--// drag to rotate
		local Dragging, Last = false, nil
		Connect(Frame.InputBegan, function(Input)
			if Interactive and (Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch) then
				Dragging, Last = true, Input.Position
			end
		end)
		Connect(Services.Input.InputEnded, function(Input)
			if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then Dragging = false end
		end)
		Connect(Services.Input.InputChanged, function(Input)
			if Dragging and Last and (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then
				local Delta = Input.Position - Last
				Last = Input.Position
				Yaw = Yaw - math.rad(Delta.X * .6)
				Pitch = math.clamp(Pitch - math.rad(Delta.Y * .6), -1.2, 1.2)
				UpdateCamera()
			end
		end)

		return {
			Instance = Frame,
			SetObject = function(_, New) SetObject(New) end,
			SetCamera = function(_, New) Camera = New Frame.CurrentCamera = New end,
			SetHeight = function(_, New) Frame.Size = UDim2.new(RowWidth.Scale, RowWidth.Offset, 0, New) end,
			SetInteractive = function(_, On) Interactive = On == true end,
			Destroy = function() Frame:Destroy() end,
		}
	end

	function Options:AddVideo(Info: { Video: string, Height: number?, Looped: boolean?, Volume: number?, AutoPlay: boolean?, Radius: number?, Tab: Instance })
		local Source = Info.Video

		if type(Source) == "string" and Source:find("^https?://") and writefile and getcustomasset then
			local Ok, Result = pcall(function()
				local Hash = 0
				for Index = 1, #Source do
					Hash = (Hash * 31 + Source:byte(Index)) % 1000000007
				end

				local File = "uilib_vid_" .. Hash .. ".webm"
				if not (isfile and isfile(File)) then
					writefile(File, game:HttpGet(Source))
				end

				return getcustomasset(File)
			end)

			if Ok then Source = Result end
		end

		local Player_ = Instance.new("VideoFrame")
		SetProperty(Player_, {
			Name = "Video",
			Video = Source or "",
			Looped = Info.Looped ~= false,
			Volume = Info.Volume or .5,
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
			Size = UDim2.new(RowWidth.Scale, RowWidth.Offset, 0, Info.Height or 160),
			Parent = Info.Tab,
		})
		Corner(Player_, Info.Radius or 8)

		Connect(Player_.InputBegan, function(Input)
			if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
				if Player_.Playing then Player_:Pause() else Player_:Play() end
			end
		end)

		if Info.AutoPlay ~= false then Player_:Play() end

		return Player_
	end

	--// ------------------------------------------------------------------
	--// ProgressBar   (WindUI: Tab:ProgressBar)
	--// Value = { Min, Max, Default }, ShowValue, DisplayMode = "Percent" | "Value", Format(value, percentage, min, max),
	--// Animate, AnimationDuration, Indeterminate, IndeterminateText, Speed, ControlGap, Width, ValueWidth
	--// ------------------------------------------------------------------
	function Options:AddProgressBar(Settings: { [string]: any })
		Settings = Settings or {}
		if Settings.Title == nil then Settings.Title = "Progress" end

		local Range = (type(Settings.Value) == "table" and Settings.Value) or {}
		local Min = tonumber(Range.Min) or 0
		local Max = tonumber(Range.Max) or 100
		if Max < Min then Min, Max = Max, Min end

		local Indeterminate = Settings.Indeterminate == true
		local IndeterminateText = tostring(Settings.IndeterminateText or "")
		local ShowValue = Settings.ShowValue
		if ShowValue == nil then ShowValue = not Indeterminate end

		local HasLabel = (Indeterminate and IndeterminateText ~= "") or (not Indeterminate and ShowValue == true)
		local Gap = Settings.ControlGap or 16
		local BarWidth = Settings.Width or 160
		local LabelWidth = (HasLabel and (Settings.ValueWidth or 44)) or 0
		local Total = BarWidth + LabelWidth + ((HasLabel and Gap) or 0)
		local Animate = Settings.Animate ~= false
		local Duration = Settings.AnimationDuration or .15
		local Mode = Settings.DisplayMode or "Percent"

		local Row = NewRow(Settings, nil, Total)
		local Object = BaseObject(Row, AddLock(Row, Settings))

		local Controls = Instance.new("Frame")
		SetProperty(Controls, {
			Name = "ProgressControls",
			AnchorPoint = Vector2.new(1, .5),
			Position = UDim2.new(1, -14, .5, 0),
			Size = UDim2.fromOffset(Total, 20),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Parent = Row,
		})

		local Track = Instance.new("Frame")
		SetProperty(Track, {
			Name = "ProgressTrack",
			AnchorPoint = Vector2.new(0, .5),
			Position = UDim2.fromScale(0, .5),
			Size = UDim2.fromOffset(BarWidth, 6),
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Parent = Controls,
		})
		Corner(Track, 3)

		local Fill = Instance.new("Frame")
		SetProperty(Fill, {
			Name = "ProgressFill",
			Size = UDim2.fromScale(0, 1),
			BorderSizePixel = 0,
			Parent = Track,
		})
		Corner(Fill, 3)

		local ValueLabel
		if HasLabel then
			ValueLabel = Instance.new("TextLabel")
			SetProperty(ValueLabel, {
				Name = "ProgressValue",
				AnchorPoint = Vector2.new(1, .5),
				Position = UDim2.fromScale(1, .5),
				Size = UDim2.fromOffset(LabelWidth, 20),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				FontFace = DescRef.FontFace,
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Right,
				TextColor3 = Theme.Description,
				Text = "",
				Parent = Controls,
			})
		end

		local Current = math.clamp(tonumber(Range.Default) or Min, Min, Max)

		local function Percentage()
			if Max == Min then return 0 end
			return (Current - Min) / (Max - Min) * 100
		end

		local function Display()
			local Percent = Percentage()

			if type(Settings.Format) == "function" then
				local Ok, Result = pcall(Settings.Format, Current, Percent, Min, Max)
				if Ok and Result ~= nil then return tostring(Result) end
			end

			if Mode == "Value" then
				return tostring(math.floor(Current * 100 + .5) / 100)
			end

			return tostring(math.floor(Percent + .5)) .. "%"
		end

		local function Render(Instant)
			if Indeterminate then
				if ValueLabel then ValueLabel.Text = IndeterminateText end
				return
			end

			local Size = UDim2.fromScale(Percentage() / 100, 1)

			if Animate and not Instant then
				Tween(Fill, Duration, { Size = Size })
			else
				Fill.Size = Size
			end

			if ValueLabel then ValueLabel.Text = Display() end
		end

		local function Paint()
			PaintSliderTrack(Track)
			PaintSliderFill(Fill)
			if ValueLabel then ValueLabel.TextColor3 = Theme.Description end
		end

		Paint()
		table.insert(Custom, Paint)

		if Indeterminate then
			Fill.Size = UDim2.fromScale(.35, 1)
			local Speed = Settings.Speed or 1

			task.spawn(function()
				local Start = os.clock()

				while Row.Parent do
					local Phase = ((os.clock() - Start) * .8 * Speed) % 1
					Fill.Position = UDim2.fromScale(-.35 + Phase * 1.35, 0)
					task.wait()
				end
			end)
		end

		function Object:Get() return Current end
		function Object:GetPercentage() return Percentage() end

		function Object:Set(Number)
			Current = math.clamp(tonumber(Number) or Current, Min, Max)
			Render()
		end

		function Object:SetRange(NewMin, NewMax)
			Min = tonumber(NewMin) or Min
			Max = tonumber(NewMax) or Max
			if Max < Min then Min, Max = Max, Min end

			Current = math.clamp(Current, Min, Max)
			Render()
		end

		function Object:SetMin(NewMin) Object:SetRange(NewMin, Max) end
		function Object:SetMax(NewMax) Object:SetRange(Min, NewMax) end

		Render(true)

		return Object
	end

	--// ------------------------------------------------------------------
	--// HStack / VStack   (WindUI: Tab:HStack() / Tab:VStack(), AutoSpace)
	--// HStack puts its elements side by side (equal width), VStack stacks them top to bottom.
	--// They can be nested:  local H = Tab:AddHStack(); local L = H:AddVStack(); L:AddButton({ ... })
	--// AutoSpace = false removes the gap between the elements.
	--// ------------------------------------------------------------------
	local function NewStack(Settings, Horizontal)
		Settings = Settings or {}

		local Gap = (Settings.AutoSpace == false and 0) or Settings.Gap or 6
		local Order = 0
		local Parent = Settings.Tab
		local Nested = Parent ~= nil and (Parent.Name == "HStack" or Parent.Name == "VStack" or Parent.Name == "Group")

		local Stack = Instance.new("Frame")
		SetProperty(Stack, {
			Name = (Horizontal and "HStack") or "VStack",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = (Nested and UDim2.new(1, 0, 0, 0)) or UDim2.new(RowWidth.Scale, RowWidth.Offset, 0, 0),
			Parent = Parent,
		})

		local Layout = Instance.new("UIListLayout")
		SetProperty(Layout, {
			FillDirection = (Horizontal and Enum.FillDirection.Horizontal) or Enum.FillDirection.Vertical,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, Gap),
			Parent = Stack,
		})
		if Horizontal then Layout.VerticalAlignment = Enum.VerticalAlignment.Top end

		local function Refit()
			local Items, Count, Fixed = {}, 0, 0

			for _, Child in next, Stack:GetChildren() do
				if Child:IsA("GuiObject") then table.insert(Items, Child) end
			end

			if not Horizontal then
				for _, Child in next, Items do
					Child.Size = UDim2.new(1, 0, Child.Size.Y.Scale, Child.Size.Y.Offset)
				end

				return
			end

			Fixed = Gap * math.max(#Items - 1, 0)

			for _, Child in next, Items do
				if Child.Name == "Space" then
					Fixed = Fixed + Child.Size.X.Offset
				else
					Count = Count + 1
				end
			end

			if Count == 0 then return end

			for _, Child in next, Items do
				if Child.Name ~= "Space" then
					Child.Size = UDim2.new(1 / Count, -math.ceil(Fixed / Count), Child.Size.Y.Scale, Child.Size.Y.Offset)
				end
			end
		end

		Connect(Stack.ChildAdded, function(Child)
			if Child:IsA("GuiObject") then
				Order = Order + 1
				Child.LayoutOrder = Order
				task.defer(Refit)
			end
		end)

		Connect(Stack.ChildRemoved, function()
			task.defer(Refit)
		end)

		return Stack
	end

	function Options:AddHStack(Settings: { Tab: Instance, AutoSpace: boolean?, Gap: number? }) return NewStack(Settings, true) end
	function Options:AddVStack(Settings: { Tab: Instance, AutoSpace: boolean?, Gap: number? }) return NewStack(Settings, false) end

	--// ------------------------------------------------------------------
	--// Wrap every element: WindUI-style aliases (Desc / Content / Values / Value),
	--// Locked + LockedTitle + :Lock() / :Unlock() on ALL of them, and Flag registration
	--// ------------------------------------------------------------------
	local Flags = {}
	local PendingFlagValues = {} --// AutoLoad: saved values waiting for an element that is created later
	Options.Flags = Flags

	--// every element created through the wrapped Add* functions (for LockAll / GetElements ...)
	local Elements = {}

	for _, Name in ipairs({
		"AddButton", "AddInput", "AddToggle", "AddKeybind", "AddDropdown",
		"AddSlider", "AddParagraph", "AddCheckbox", "AddTextarea", "AddColorpicker", "AddCode", "AddProgressBar",
	}) do
		local Original = Options[Name]

		Options[Name] = function(Self, Info)
			Info = Info or {}

			if Info.Description == nil then Info.Description = Info.Desc or Info.Content end

			if Name == "AddDropdown" then
				Info.Options = Info.Options or Info.Values or {}
				if Info.Default == nil then Info.Default = Info.Value end
			end

			local Object = Original(Self, Info)

			if type(Object) == "table" then
				if Object.Instance and not Object.Lock then
					local Overlay = AddLock(Object.Instance, Info)

					function Object:Lock() Overlay.Visible = true end
					function Object:Unlock() Overlay.Visible = false end
					function Object:Destroy() Destroy(Object.Instance) end
				end

				--// WindUI: Element:SetTitle(text) / Element:SetDesc(text) on every element
				if Object.Instance and not Object.SetTitle then
					function Object:SetTitle(Text)
						local Ok, T = pcall(Options.GetLabels, Options, Object.Instance)
						if Ok and T then
							T.Text = tostring(Text or "")
							T.Visible = true
						end
					end
				end

				if Object.Instance and not Object.SetDesc then
					function Object:SetDesc(Text)
						local Ok, T, D = pcall(Options.GetLabels, Options, Object.Instance)
						if not (Ok and D) then return end

						local Show = Text ~= nil and tostring(Text) ~= ""
						D.Text = tostring(Text or "")

						--// row was built without a description: move the title up and put the description under it
						if Show and not D.Visible and T and T.AnchorPoint.Y == .5 then
							T.AnchorPoint = Vector2.new(0, 1)
							T.Position = UDim2.new(T.Position.X.Scale, T.Position.X.Offset, .5, 1)
							D.Position = UDim2.new(T.Position.X.Scale, T.Position.X.Offset, .5, 2)
							D.Size = UDim2.new(T.Size.X.Scale, T.Size.X.Offset, 0, 14)
						end

						D.Visible = Show
					end
				end

				--// WindUI: Element:Highlight() on every element
				if Object.Instance and not Object.Highlight then
					function Object:Highlight()
						local Row = Object.Instance

						if not (Row and Row.Parent) then return end

						Tween(Row, .15, { BackgroundColor3 = Accent })
						task.delay(.45, function()
							if Row.Parent then
								Tween(Row, .3, { BackgroundColor3 = Theme.Component })
							end
						end)
					end
				end

				if Object.Instance then
					function Object:IsLocked()
						local Overlay = Object.Instance:FindFirstChild("LockedOverlay")
						return Overlay ~= nil and Overlay.Visible
					end

					table.insert(Elements, Object)
				end

				if Info.Flag and Object.Get then
					Flags[Info.Flag] = Object

					--// AutoLoad: this element is created after the config was read -> give it its saved value now
					local Waiting = PendingFlagValues[Info.Flag]
					if Waiting ~= nil then
						PendingFlagValues[Info.Flag] = nil
						task.defer(function()
							pcall(function()
								if Object.Load then Object:Load(Waiting) else Object:Set(Waiting) end
							end)
						end)
					end
				end
			end

			return Object
		end
	end

	--// ------------------------------------------------------------------
	--// WindUI: Window:LockAll() / UnlockAll() / GetLocked() / GetUnlocked() / GetElements()
	--// ------------------------------------------------------------------
	local function Alive()
		local List = {}

		for _, Object in ipairs(Elements) do
			if Object.Instance and Object.Instance.Parent then table.insert(List, Object) end
		end

		Elements = List
		return List
	end

	function Options:GetElements() return table.clone(Alive()) end

	function Options:GetLockedElements()
		local List = {}
		for _, Object in ipairs(Alive()) do if Object:IsLocked() then table.insert(List, Object) end end
		return List
	end

	function Options:GetUnlockedElements()
		local List = {}
		for _, Object in ipairs(Alive()) do if not Object:IsLocked() then table.insert(List, Object) end end
		return List
	end

	function Options:LockAll()
		for _, Object in ipairs(Alive()) do if Object.Lock then Object:Lock() end end
	end

	function Options:UnlockAll()
		for _, Object in ipairs(Alive()) do if Object.Unlock then Object:Unlock() end end
	end

	--// ------------------------------------------------------------------
	--// Config:  give elements a Flag = "name", then
	--//   Options:SaveConfig("name")  Options:LoadConfig("name")
	--//   Options:GetConfigs()        Options:DeleteConfig("name")
	--// ------------------------------------------------------------------
	local ConfigRoot = tostring(WindowSettings.Folder or WindowSettings.Title or "UILibrary")
	local ConfigFolder = ConfigRoot .. "/configs"

	local function FileSupport()
		return writefile and readfile and isfile and makefolder and isfolder
	end

	local function ConfigPath(Name)
		return ConfigFolder .. "/" .. tostring(Name or "default") .. ".json"
	end

	function Options:SaveConfig(Name: string?)
		if not FileSupport() then
			warn("[UI LIB]: your executor has no file functions - can't save config")
			return false
		end

		local Data = {}

		for Flag, Object in next, Flags do
			local Ok, Value = pcall(function()
				if Object.Save then return Object:Save() end
				return Object:Get()
			end)

			if Ok and Value ~= nil then Data[Flag] = Value end
		end

		if not isfolder(ConfigRoot) then makefolder(ConfigRoot) end
		if not isfolder(ConfigFolder) then makefolder(ConfigFolder) end

		writefile(ConfigPath(Name), HttpService:JSONEncode(Data))
		return true
	end

	function Options:LoadConfig(Name: string?, KeepPending: boolean?)
		if not FileSupport() or not isfile(ConfigPath(Name)) then return false end

		local Ok, Data = pcall(function()
			return HttpService:JSONDecode(readfile(ConfigPath(Name)))
		end)
		if not Ok or type(Data) ~= "table" then return false end

		for Flag, Value in next, Data do
			local Object = Flags[Flag]

			if Object then
				pcall(function()
					if Object.Load then Object:Load(Value) else Object:Set(Value) end
				end)
			elseif KeepPending then
				PendingFlagValues[Flag] = Value
			end
		end

		return true
	end

	function Options:GetConfigs()
		local List = {}

		if FileSupport() and isfolder(ConfigFolder) and listfiles then
			for _, Path in ipairs(listfiles(ConfigFolder)) do
				local Name = tostring(Path):match("([^/\\]+)%.json$")
				if Name then table.insert(List, Name) end
			end
		end

		return List
	end

	function Options:DeleteConfig(Name: string?)
		if FileSupport() and delfile and isfile(ConfigPath(Name)) then
			delfile(ConfigPath(Name))
			return true
		end

		return false
	end

	--// ------------------------------------------------------------------
	--// WindUI style ConfigManager
	--//   local Config = Window.ConfigManager:CreateConfig("MyHub")
	--//   Config:Register("AutoFarm", ToggleObject)   Config:Save()   Config:Load()   Config:Delete()
	--//   Window.ConfigManager:AllConfigs()   Window.ConfigManager:GetConfig("MyHub")
	--//   (it saves / loads through Options:SaveConfig / LoadConfig, so every flagged element is included)
	--// ------------------------------------------------------------------
	do
		local Manager = { Configs = {} }
		Options.ConfigManager = Manager

		--// WindUI AutoLoad: configs marked with Config:SetAutoLoad(true) are loaded when the window is created
		--//   (stored in <Folder>/autoload.txt, one name per line)
		local AutoLoadFile = ConfigRoot .. "/autoload.txt"
		local AutoLoadNames = {}

		local function WriteAutoLoad()
			if not FileSupport() then return end
			pcall(function()
				if not isfolder(ConfigRoot) then makefolder(ConfigRoot) end
				writefile(AutoLoadFile, table.concat(AutoLoadNames, "\n"))
			end)
		end

		if FileSupport() and isfile(AutoLoadFile) then
			local Ok, Text = pcall(readfile, AutoLoadFile)
			if Ok and type(Text) == "string" then
				for Line in Text:gmatch("[^\r\n]+") do
					if not table.find(AutoLoadNames, Line) then table.insert(AutoLoadNames, Line) end
				end
			end
		end

		Manager.CurrentConfig = nil

		function Manager:GetAutoLoadConfigs() return table.clone(AutoLoadNames) end

		function Manager:SetCurrentConfig(Config)
			if type(Config) == "string" then Config = Manager.Configs[Config] end
			if type(Config) ~= "table" then return false end

			Manager.CurrentConfig = Config
			Options.CurrentConfig = Config
			return true
		end

		function Manager:AutoLoad()
			for _, ConfigName in ipairs(AutoLoadNames) do
				Options:LoadConfig(ConfigName, true)
			end
		end

		function Manager:CreateConfig(Name)
			Name = tostring(Name or "default")

			if Manager.Configs[Name] then return Manager.Configs[Name] end

			local Config = { Name = Name, Elements = {} }

			function Config:Register(Flag, Object)
				if type(Flag) == "string" and type(Object) == "table" and Object.Get then
					Config.Elements[Flag] = Object
					Flags[Flag] = Object
				end

				return Object
			end

			function Config:Save() return Options:SaveConfig(Name) end
			function Config:Load() return Options:LoadConfig(Name) end
			function Config:GetName() return Name end

			--// WindUI: Config:SetAutoLoad(true) / :IsAutoLoad() / :SetAsCurrent()
			function Config:SetAutoLoad(State)
				local Index = table.find(AutoLoadNames, Name)

				if State ~= false then
					if not Index then table.insert(AutoLoadNames, Name) end
				elseif Index then
					table.remove(AutoLoadNames, Index)
				end

				WriteAutoLoad()
				return true
			end

			function Config:IsAutoLoad() return table.find(AutoLoadNames, Name) ~= nil end
			function Config:SetAsCurrent() return Manager:SetCurrentConfig(Config) end

			function Config:Delete()
				Manager.Configs[Name] = nil
				return Options:DeleteConfig(Name)
			end

			Manager.Configs[Name] = Config
			return Config
		end

		function Manager:GetConfig(Name) return Manager.Configs[tostring(Name)] end
		function Manager:AllConfigs() return Options:GetConfigs() end

		Manager:AutoLoad() --// elements created after this point receive their saved value through PendingFlagValues
	end

	--// ------------------------------------------------------------------
	--// Collapsible section  (WindUI: Section with Opened / children)
	--//   local Content, Section = Options:AddCollapsible({ Title = "Group", Description = "...", Opened = true, Tab = Tab })
	--//   Options:AddButton({ Tab = Content, ... })	  --> elements go INSIDE Content
	--//   Section:Open()  Section:Close()  Section:Toggle()  Section:SetTitle("x")  Section:SetDesc("x")
	--// ------------------------------------------------------------------
	function Options:AddCollapsible(Settings: { Title: string, Description: string, Opened: boolean?, Tab: Instance })
		Settings = Settings or {}

		local Parent = Settings.Tab
		local ParentLayout = Parent and Parent:FindFirstChildOfClass("UIListLayout")
		local Gap = (ParentLayout and ParentLayout.Padding.Offset) or 6
		if Gap < 4 then Gap = 6 end

		local Wrap = Instance.new("Frame")
		SetProperty(Wrap, {
			Name = "Collapsible",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(RowWidth.Scale, RowWidth.Offset, 0, 0),
			Parent = Parent,
		})

		local WrapLayout = Instance.new("UIListLayout")
		SetProperty(WrapLayout, {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, Gap),
			Parent = Wrap,
		})

		local Header, HeaderTitle, HeaderDesc = NewRow({
			Title = Settings.Title,
			Description = Settings.Description or Settings.Desc,
			Tab = Wrap,
		}, nil, 24)
		Header.LayoutOrder = 0

		local Arrow = Instance.new("TextLabel")
		SetProperty(Arrow, {
			Name = "Arrow",
			AnchorPoint = Vector2.new(1, .5),
			Position = UDim2.new(1, -14, .5, 0),
			Size = UDim2.fromOffset(20, 20),
			BackgroundTransparency = 1,
			Text = "›",
			Font = Enum.Font.GothamBold,
			TextSize = 22,
			TextColor3 = Theme.Icon,
			Parent = Header,
		})

		local Content = Instance.new("Frame")
		SetProperty(Content, {
			Name = "Content",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(1, 0, 0, 0),
			LayoutOrder = 1,
			Parent = Wrap,
		})

		local ContentLayout = Instance.new("UIListLayout")
		SetProperty(ContentLayout, {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, Gap),
			Parent = Content,
		})

		local Opened = Settings.Opened ~= false
		local Object = { Instance = Wrap, Content = Content }

		local function Paint(Animate)
			Content.Visible = Opened

			if Animate then
				Tween(Arrow, .2, { Rotation = (Opened and 90) or 0 })
			else
				Arrow.Rotation = (Opened and 90) or 0
			end
		end

		function Object:Open() Opened = true Paint(true) end
		function Object:Close() Opened = false Paint(true) end
		function Object:Toggle() Opened = not Opened Paint(true) end
		function Object:IsOpen() return Opened end
		function Object:SetTitle(Text) HeaderTitle.Text = Text end
		function Object:SetDesc(Text) HeaderDesc.Text = Text HeaderDesc.Visible = Text ~= "" end
		function Object:Destroy() Destroy(Wrap) end

		Animations:Press(Header, .98)
		Connect(Header.MouseButton1Click, function() Object:Toggle() end)

		Paint(false)
		table.insert(Custom, function() Arrow.TextColor3 = Theme.Icon end)

		return Content, Object
	end

	--// ------------------------------------------------------------------
	--// Tab helpers (WindUI: Tab:Select / Tab:Lock / Tab:Divider)
