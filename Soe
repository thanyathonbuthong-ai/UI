		--// First run: sit centred just ABOVE the window (unless OpenButton.Position was given)
		function OpenButton:PlaceAboveWindow(Gap)
			local View = Screen.AbsoluteSize
			if View.X < 1 or View.Y < 1 then View = workspace.CurrentCamera.ViewportSize end

			local Size = Setup.Size or Window.Size
			local Width = Size.X.Scale * View.X + Size.X.Offset
			local Height = Size.Y.Scale * View.Y + Size.Y.Offset
			local Place, Anchor = Window.Position, Window.AnchorPoint

			local CenterX = Place.X.Scale * View.X + Place.X.Offset + (.5 - Anchor.X) * Width
			local Top = Place.Y.Scale * View.Y + Place.Y.Offset - Anchor.Y * Height
			local Y = math.max(Top - (Gap or 10) - BarHeight / 2, BarHeight / 2 + 6)

			Root.Position = UDim2.fromOffset(CenterX, Y)
		end

		if not UserConfig.Position then
			OpenButton:PlaceAboveWindow()
		end

	end

