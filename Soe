		GripHit.ZIndex = 1000

		--// ---- background behind the whole button (picture / video / colour / gradient) ----
		--//   OpenButton = { Background = "rbxassetid://.." | id | "https://.../pic.png" | "video:rbxassetid://.." | "video:https://.../clip.mp4"
		--//                              | Color3 | ColorSequence | Library:Gradient({ ["0"] = { Color = .. }, ["100"] = { Color = .. } }, { Rotation = 45 }),
		--//                  BackgroundImageTransparency = 0.35,   --// 0 = fully visible, 1 = hidden  (alias: BackgroundTransparency)
		--//                  ChipTransparency = 0.45 }             --// how see-through the title chip is while a background is set
		--//   OpenButton:SetBackground(src, transparency)  :SetBackgroundTransparency(n)  :SetChipTransparency(n)  :RemoveBackground()  :GetBackground()
		--//   Options:EditOpenButton({ Background = src })  /  Options:SetOpenButtonBackground(src, transparency)  /  Library:SetOpenButtonBackground(...)
		local OB_Layer, OB_Fill, OB_Picture, OB_Video, OB_Tint
		local OB_Kind, OB_Source, OB_Value = nil, nil, BGDefault
		local OB_ChipAlpha = .45
		local OB_Token = 0
		local OB_Gradient, OB_Info = nil, nil --// the UIGradient on the fill + the parsed gradient (nil for a plain colour)
		local OB_Spin = NewSpinner(function() return OB_Gradient end, function() return Root:IsDescendantOf(game) end, function() return Root.Visible end)

		local function OB_Make()
			if OB_Layer and OB_Layer.Parent then return OB_Layer end

			--// the layer sits under the row (ZIndex 201) and above the button's own plate
			local Sibling = Screen.ZIndexBehavior == Enum.ZIndexBehavior.Sibling
			local function Rank(Number) return Sibling and Number or 200 end

			OB_Layer = Instance.new("Frame")
			SetProperty(OB_Layer, {
				Name = "OpenBackground", Active = false, BackgroundTransparency = 1, BorderSizePixel = 0,
				ClipsDescendants = true, Size = UDim2.fromScale(1, 1), ZIndex = Rank(1), Visible = false, Parent = Root,
			})

			OB_Fill = Instance.new("Frame")
			SetProperty(OB_Fill, {
				Name = "OpenBGFill", Active = false, BorderSizePixel = 0, BackgroundColor3 = Color3.new(1, 1, 1),
				BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = Rank(1), Parent = OB_Layer,
			})

			OB_Picture = Instance.new("ImageLabel")
			OB_Picture:SetAttribute("NoTheme", true) --// SetTheme must never recolour the picture
			SetProperty(OB_Picture, {
				Name = "OpenBGPicture", Active = false, BackgroundTransparency = 1, BorderSizePixel = 0,
				ScaleType = Enum.ScaleType.Crop, Size = UDim2.fromScale(1, 1), ZIndex = Rank(2), Visible = false, Parent = OB_Layer,
			})

			OB_Video = Instance.new("VideoFrame")
			SetProperty(OB_Video, {
				Name = "OpenBGVideo", Active = false, BackgroundTransparency = 1, BorderSizePixel = 0,
				Looped = true, Volume = 0, Size = UDim2.fromScale(1, 1), ZIndex = Rank(2), Visible = false, Parent = OB_Layer,
			})

			--// a VideoFrame has no transparency of its own, so a theme coloured veil above it fades it instead
			OB_Tint = Instance.new("Frame")
			SetProperty(OB_Tint, {
				Name = "OpenBGTint", Active = false, BorderSizePixel = 0, BackgroundColor3 = Theme.Primary,
				BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = Rank(3), Visible = false, Parent = OB_Layer,
			})

			return OB_Layer
		end

		local function OB_Apply()
			if OB_Layer then
				if OB_Kind == "Image" then
					OB_Picture.ImageTransparency = OB_Value
				elseif OB_Kind == "Video" then
					OB_Tint.BackgroundTransparency = 1 - OB_Value
				elseif OB_Kind == "Color" then
					OB_Fill.BackgroundTransparency = OB_Value
				end
			end

			--// the title chip lets the background shine through (otherwise it would cover almost all of it)
			Inner.BackgroundTransparency = (OB_Kind ~= nil and OB_ChipAlpha) or 0
		end

		local function OB_Reset()
			OB_Token = OB_Token + 1 --// invalidates a download that is still running

			if not OB_Layer then return end

			for _, Gradient in ipairs(OB_Fill:GetChildren()) do
				if Gradient:IsA("UIGradient") then Gradient:Destroy() end
			end

			OB_Gradient = nil
			OB_Fill.BackgroundTransparency = 1
			OB_Fill.BackgroundColor3 = Color3.new(1, 1, 1)
			OB_Picture.Visible, OB_Picture.Image = false, ""
			OB_Tint.Visible = false

			pcall(function() OB_Video:Pause() end)
			OB_Video.Visible = false
			pcall(function() OB_Video.Video = "" end)
		end

		local function OB_Set(Source, Transparency)
			OB_Reset()

			if Source == nil or Source == false or Source == "" then
				OB_Kind, OB_Source = nil, nil
				if OB_Layer then OB_Layer.Visible = false end
				OB_Apply()
				return
			end

			OB_Make().Visible = true
			OB_Source = Source

			local Mine = OB_Token

			--// colour / gradient   ("#hex" strings are colours too)
			if type(Source) == "string" then
				local Hex = Source:match("^%s*(#%x+)%s*$")
				if Hex and ToColor(Hex) then Source = ToColor(Hex) end
			end

			if typeof(Source) == "Color3" or typeof(Source) == "ColorSequence" or type(Source) == "table" then
				OB_Kind = "Color"
				OB_Value = math.clamp(tonumber(Transparency) or 0, 0, 1)

				if typeof(Source) == "Color3" then
					OB_Fill.BackgroundColor3 = Source
					OB_Info = nil
				else
					local Info = ParseGradient(Source) --// hex / Color3 stops, { "#a", "#b" } lists, WindUI style tables, ColorSequence ...
					local Gradient = Instance.new("UIGradient")

					Gradient.Color = Info.Color
					if Info.Transparency then Gradient.Transparency = Info.Transparency end
					Gradient.Rotation = Info.Rotation or 0
					Gradient.Offset = Info.Offset or Vector2.new(0, 0)
					Gradient.Parent = OB_Fill

					OB_Gradient, OB_Info = Gradient, Info
				end
			else
				local Text = tostring(Source)
				local Raw, IsVideo = Text, false

				local Prefixed = Text:match("^[Vv][Ii][Dd][Ee][Oo]:(.+)$")
				if Prefixed then
					Raw, IsVideo = (Prefixed:gsub("^%s+", "")), true
				else
					local Lower = Text:lower()
					if Lower:find("%.mp4") or Lower:find("%.webm") or Lower:find("%.mov") then IsVideo = true end
				end

				OB_Kind = IsVideo and "Video" or "Image"
				OB_Value = math.clamp(tonumber(Transparency) or BGDefault, 0, 1)

				task.spawn(function() --// a download may yield, never block CreateWindow
					local Asset = BG_Resolve(Raw, IsVideo)
					if Mine ~= OB_Token or not Asset then return end

					if IsVideo then
						OB_Video.Video = Asset
						OB_Video.Visible = true
						OB_Tint.Visible = true
						OB_Video.Looped = true
						OB_Video.Volume = 0
						pcall(function() OB_Video:Play() end)
					else
						OB_Picture.Image = Asset
						OB_Picture.Visible = true
					end

					OB_Apply()
				end)
			end

			OB_Apply()
		end

		--// size follows the content
		local function Fit()
			local Width = Row.AbsoluteSize.X / math.max(Scaler.Scale, .01)
			Root.Size = UDim2.fromOffset(math.max(Width, 60), BarHeight)
		end
		Connect(Row:GetPropertyChangedSignal("AbsoluteSize"), Fit)

		local function IsMobile() return Services.Input.TouchEnabled and not Services.Input.KeyboardEnabled end

		--// icon: Lucide name or image id.  Returns true when an icon is shown
		local function ApplyIcon()
			local Image, Themed = ResolveIcon(Config.Icon)

			if not Image then
				IconImage.Visible = false
				return false
			end

			if Config.IconThemed ~= nil then Themed = Config.IconThemed end

			IconImage.Image = Image
			IconImage:SetAttribute("NoTheme", not Themed)
			IconImage.ImageColor3 = (Themed and Theme.Icon) or Color3.new(1, 1, 1)
			IconImage.Visible = true

			return true
		end

		--// switch follows the window state, exactly like a Toggle (on = Theme.Toggle, white knob)
		local function Paint(Animate)
			local TrackColour = (Opened and Theme.Toggle) or Theme.Interactables
			local KnobColour = (Opened and Color3.fromRGB(255, 255, 255)) or Theme.Primary
			local KnobPosition = (Opened and UDim2.new(1, -17, .5, 0)) or UDim2.new(0, 3, .5, 0)

			if Animate then
				Tween(Switch, .2, { BackgroundColor3 = TrackColour })
				Tween(Knob, .2, { BackgroundColor3 = KnobColour, Position = KnobPosition })
			else
				Switch.BackgroundColor3 = TrackColour
				Knob.BackgroundColor3 = KnobColour
				Knob.Position = KnobPosition
			end
		end

		--// show / hide with the same pop animation as the window
		local Shown = false
		local function Refresh()
			local Want = Config.Enabled and (not Config.OnlyMobile or IsMobile()) and not (Config.HideWhenOpen and Opened)

			if Want and not Shown then
				Shown = true
				Root.Visible = true
				Scaler.Scale = Config.Scale * .9
				Tween(Root, .25, { GroupTransparency = 0 })
				Tween(Scaler, .25, { Scale = Config.Scale })
			elseif not Want and Shown then
				Shown = false
				Tween(Root, .2, { GroupTransparency = 1 })
				Tween(Scaler, .2, { Scale = Config.Scale * .9 })

				task.delay(.22, function()
					if not Shown then Root.Visible = false end
				end)
			end
		end

		--// keep the button inside the screen after a drag.
		--// The top limit reaches the real top edge of the screen (over the Roblox top bar area), so it can be dragged higher.
		local function Clamp()
			local View = Screen.AbsoluteSize
			local Size, Place = Root.AbsoluteSize, Root.AbsolutePosition
			local Inset = (Screen.IgnoreGuiInset and 0) or GuiService:GetGuiInset().Y
			local MinY = -Inset + 4
			local X = math.clamp(Place.X, 0, math.max(View.X - Size.X, 0))
			local Y = math.clamp(Place.Y, MinY, math.max(View.Y - Size.Y, MinY))

			if math.abs(X - Place.X) > .5 or math.abs(Y - Place.Y) > .5 then
				local Now = Root.Position
				Tween(Root, .2, { Position = UDim2.new(Now.X.Scale, Now.X.Offset + (X - Place.X), Now.Y.Scale, Now.Y.Offset + (Y - Place.Y)) })
			end
		end

		--// tap = toggle window, move finger / mouse = drag
		local Busy = false
		local function Press()
			if Busy then return end
			Busy = true
			task.delay(.4, function() Busy = false end)
			task.spawn(Close)
		end

		local Tracked, StartInput, StartPosition, Dragged, AllowDrag

		--// Hit (whole button) = tap only.   GripHit (9 dots) = drag only.
		local function Begin(Input, CanDrag)
			if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
				Tracked, StartInput, StartPosition, Dragged, AllowDrag = Input, Input.Position, Root.Position, false, CanDrag
				Tween(Scaler, .1, { Scale = Config.Scale * .96 })

				local Ender
				Ender = Connect(Input.Changed, function()
					if Input.UserInputState == Enum.UserInputState.End then
						Ender:Disconnect()

						if Tracked == Input then
							Tracked = nil
							Tween(Scaler, .12, { Scale = Config.Scale })

							if Dragged then Clamp() elseif not CanDrag then Press() end
						end
					end
				end)
			end
		end

		Connect(Hit.InputBegan, function(Input) Begin(Input, false) end)
		Connect(GripHit.InputBegan, function(Input) Begin(Input, true) end)

		Connect(Services.Input.InputChanged, function(Input)
			if not Tracked or not AllowDrag or not Config.Draggable then return end

			local IsTouch = Tracked.UserInputType == Enum.UserInputType.Touch and Input.UserInputType == Enum.UserInputType.Touch
			if Input == Tracked or IsTouch or Input.UserInputType == Enum.UserInputType.MouseMovement then
				local Delta = Vector2.new(Input.Position.X - StartInput.X, Input.Position.Y - StartInput.Y)

				if not Dragged and Delta.Magnitude < 8 then return end

				Dragged = true
				Root.Position = UDim2.new(StartPosition.X.Scale, StartPosition.X.Offset + Delta.X, StartPosition.Y.Scale, StartPosition.Y.Offset + Delta.Y)
			end
		end)

		--// hover: same feedback as the other components (Component colour gets a bit lighter / darker)
		Connect(Hit.MouseEnter, function()
			Tween(Inner, .25, { BackgroundColor3 = Color(Theme.Component, 5, Setup.ThemeMode) })
			Tween(Edge, .25, { Transparency = .25 })
		end)
		Connect(Hit.MouseLeave, function()
			Tween(Inner, .25, { BackgroundColor3 = Theme.Component })
			Tween(Edge, .25, { Transparency = .5 })
		end)

		--// ---- public api ----
		local function ApplyColours()
			Root.BackgroundColor3 = Theme.Primary
			Inner.BackgroundColor3 = Theme.Component
			InnerEdge.Color = Theme.Outline
			Divider.BackgroundColor3 = Theme.Outline
			TitleStyle:Refresh()
			for _, Dot in ipairs(GripDots) do Dot.BackgroundColor3 = Theme.Icon end
			if OB_Tint then OB_Tint.BackgroundColor3 = Theme.Primary end

			if Config.Color then
				Edge.Color = Color3.new(1, 1, 1)
				Gradient.Color = Config.Color
				Gradient.Enabled = true
			else
				Edge.Color = Theme.Shadow
				Gradient.Enabled = false
			end
		end

		function OpenButton:Edit(Info)
			if type(Info) ~= "table" then return OpenButton end

			--// locked: the looks (background / title colour / outline colour) are ignored, everything else still works
			if Options._StyleLocked then
				Info = table.clone(Info)
				for _, Key in ipairs({ "Background", "BackgroundImageTransparency", "BackgroundTransparency", "BackgroundGradient", "BackgroundRotation",
					"BackgroundAnimated", "BackgroundSpeed", "ChipTransparency", "Color", "TitleColor", "TitleGradient", "TitleRotation", "TitleAnimated", "TitleSpeed" }) do
					Info[Key] = nil
				end
			end

			for Key, Value in next, Info do
				if Key == "Color" and typeof(Value) == "Color3" then
					Value = ColorSequence.new(Value)
				end

				Config[Key] = Value
			end

			if Info.ChipTransparency ~= nil then
				OB_ChipAlpha = math.clamp(tonumber(Info.ChipTransparency) or OB_ChipAlpha, 0, 1)
			end

			local GivenAlpha = Info.BackgroundImageTransparency
			if GivenAlpha == nil then GivenAlpha = Info.BackgroundTransparency end

			if Info.Background ~= nil then
				OB_Set(Info.Background, GivenAlpha) --// false / "" removes the background
			elseif GivenAlpha ~= nil then
				OB_Value = math.clamp(tonumber(GivenAlpha) or OB_Value, 0, 1)
			end

			--// OpenButton = { BackgroundGradient = { "#a", "#b" }, BackgroundRotation = 45, BackgroundAnimated = true, BackgroundSpeed = 30,
			--//                TitleColor = "#fc0"  |  TitleGradient = { "#a", "#b" }, TitleRotation = 0, TitleAnimated = true, TitleSpeed = 40 }
			if Info.BackgroundGradient ~= nil then
				OpenButton:SetBackgroundGradient(Info.BackgroundGradient, { Rotation = Info.BackgroundRotation, Transparency = GivenAlpha })
			elseif Info.BackgroundRotation ~= nil then
				OpenButton:SetBackgroundRotation(Info.BackgroundRotation)
			end

			if Info.BackgroundAnimated ~= nil or Info.BackgroundSpeed ~= nil then
				OB_Spin:Set(Info.BackgroundAnimated ~= false, Info.BackgroundSpeed)
			end

			if Info.TitleGradient ~= nil then
				local Animate = Info.TitleAnimated
				if Animate == nil and Info.TitleSpeed ~= nil then Animate = true end

				OpenButton:SetTitleGradient(Info.TitleGradient, { Rotation = Info.TitleRotation, Animate = Animate, Speed = Info.TitleSpeed })
			elseif Info.TitleColor ~= nil then
				OpenButton:SetTitleColor(Info.TitleColor)
			end

			OB_Apply()

			local HasIcon = ApplyIcon()
			local IconOnly = Config.OnlyIcon and HasIcon

			TitleLabel.Text = tostring(Config.Title or "")
			TitleLabel.Visible = not IconOnly
			InnerPad.PaddingLeft = UDim.new(0, (IconOnly and 9) or 12)
			InnerPad.PaddingRight = UDim.new(0, (IconOnly and 9) or 12)

			Grip.Visible = Config.Draggable ~= false
			Divider.Visible = Config.Draggable ~= false
			Switch.Visible = Config.ShowState ~= false

			Round.CornerRadius = Config.CornerRadius
			InnerRound.CornerRadius = UDim.new(Config.CornerRadius.Scale, math.max(Config.CornerRadius.Offset - 4, 0))
			Edge.Thickness = Config.StrokeThickness
			Scaler.Scale = Config.Scale
			if Info.Position then Root.Position = Info.Position end

			ApplyColours()
			Paint(false)
			Refresh()
			Fit()

			return OpenButton
		end

		function OpenButton:Show() Config.Enabled = true Refresh() end
		function OpenButton:Hide() Config.Enabled = false Refresh() end
		function OpenButton:SetTitle(Text) return OpenButton:Edit({ Title = Text }) end
		function OpenButton:SetIcon(Image) return OpenButton:Edit({ Icon = Image }) end
		function OpenButton:SetScale(Number) return OpenButton:Edit({ Scale = Number }) end

		function OpenButton:SetBackground(Source, Transparency)
			if Options._StyleLocked then return OpenButton end
			OB_Set(Source, Transparency)
			OB_Apply()
			return OpenButton
		end
		OpenButton.SetBackgroundImage = OpenButton.SetBackground

		function OpenButton:SetBackgroundTransparency(Value)
			if Options._StyleLocked then return OpenButton end
			OB_Value = math.clamp(tonumber(Value) or BGDefault, 0, 1)
			OB_Apply()
			return OpenButton
		end
		OpenButton.SetBackgroundImageTransparency = OpenButton.SetBackgroundTransparency

		function OpenButton:SetChipTransparency(Value)
			if Options._StyleLocked then return OpenButton end
			OB_ChipAlpha = math.clamp(tonumber(Value) or OB_ChipAlpha, 0, 1)
			OB_Apply()
			return OpenButton
		end

		function OpenButton:RemoveBackground() return OpenButton:SetBackground(nil) end

		--// colour / gradient background of the open button
		--//   OpenButton:SetBackgroundColor("#1e90ff" | Color3, transparency?)
		--//   OpenButton:SetBackgroundGradient({ "#5865f2", "#eb459e" }, { Rotation = 45, Transparency = 0, Animate = true, Speed = 30 })
		--//   OpenButton:SetBackgroundRotation(deg)   OpenButton:AnimateBackground(true | false | nil, speed?)   OpenButton:GetBackgroundGradient()
		function OpenButton:SetBackgroundColor(Color, Transparency)
			local Value = ToColor(Color)
			assert(Value, '[UI LIB]: SetBackgroundColor needs a Color3 or a hex string such as "#1e90ff"')
			return OpenButton:SetBackground(Value, Transparency or 0)
		end

		function OpenButton:SetBackgroundGradient(Stops, Props)
			if Options._StyleLocked then return OpenButton end
			Props = type(Props) == "table" and Props or {}
			OpenButton:SetBackground(ParseGradient(Stops, Props), Props.Transparency)

			if Props.Animate ~= nil then
				OB_Spin:Set(Props.Animate, Props.Speed)
			elseif Props.Speed ~= nil then
				OB_Spin.Speed = tonumber(Props.Speed) or OB_Spin.Speed
			end

			return OpenButton
		end

		function OpenButton:SetBackgroundRotation(Degrees)
			if Options._StyleLocked then return OpenButton end
			Degrees = tonumber(Degrees) or 0
			if OB_Info then OB_Info.Rotation = Degrees end
			if OB_Gradient and OB_Gradient.Parent then OB_Gradient.Rotation = Degrees end
			return OpenButton
		end

		function OpenButton:AnimateBackground(On, Speed)
			if Options._StyleLocked then return OpenButton end
			OB_Spin:Set(On, Speed)
			return OpenButton
		end
		function OpenButton:GetBackgroundGradient() return OB_Info end

		--// colour / gradient of the button's title (its own style; without one it follows the hub name colour)
		--//   OpenButton:SetTitleColor("#fc0")   OpenButton:SetTitleGradient({ "#a", "#b" }, { Rotation, Animate, Speed })
		--//   OpenButton:SetTitleRotation(deg)   OpenButton:AnimateTitle(on, speed?)   OpenButton:RemoveTitleColor()
		function OpenButton:SetTitleColor(Color)
			if Options._StyleLocked then return OpenButton end
			OpenButton._OwnTitleStyle = true
			TitleStyle:SetColor(Color)
			return OpenButton
		end

		function OpenButton:SetTitleGradient(Stops, Props)
			if Options._StyleLocked then return OpenButton end
			OpenButton._OwnTitleStyle = true
			TitleStyle:SetGradient(Stops, Props)
			return OpenButton
		end

		function OpenButton:SetTitleRotation(Degrees)
			if Options._StyleLocked then return OpenButton end
			OpenButton._OwnTitleStyle = true
			TitleStyle:SetRotation(Degrees)
			return OpenButton
		end

		function OpenButton:AnimateTitle(On, Speed)
			if Options._StyleLocked then return OpenButton end
			OpenButton._OwnTitleStyle = true
			TitleStyle.Spin:Set(On, Speed)
			return OpenButton
		end

		function OpenButton:RemoveTitleColor() --// back to following the hub name
			if Options._StyleLocked then return OpenButton end
			OpenButton._OwnTitleStyle = false
			TitleStyle:Remove()
			if Options._MirrorTitle then Options._MirrorTitle() end
			return OpenButton
		end
		function OpenButton:GetBackground() return OB_Source, OB_Value end
