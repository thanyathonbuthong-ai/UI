	--// Tab object fix: AddTab returns a wrapper so both styles work:
	--//   Window:AddSection({ Tab = Tab, ... })   and   Tab:AddSection({ ... })   (same for every Add* element)
	do
		local function Unwrap(Value)
			if type(Value) == "table" then
				local Inner = rawget(Value, "__Instance")
				if Inner then return Inner end
			end
			return Value
		end

		local function WrapTab(Frame, Aliases)
			local Proxy = {}
			rawset(Proxy, "__Instance", Frame)

			return setmetatable(Proxy, {
				__index = function(_, Key)
					--// stacks also accept the WindUI names:  Stack:Button({...})  Stack:HStack()  Stack:VStack() ...
					if Aliases and Aliases[Key] then Key = Aliases[Key] end

					if type(Key) == "string" and Key:sub(1, 3) == "Add" and type(Options[Key]) == "function" then
						return function(_, Info, ...)
							Info = Info or {}
							Info.Tab = Frame
							return Options[Key](Options, Info, ...)
						end
					end

					local Value = Frame[Key]
					if typeof(Value) == "function" then
						return function(_, ...) return Value(Frame, ...) end
					end
					return Value
				end,
				__newindex = function(_, Key, Value) Frame[Key] = Value end,
			})
		end

		--// every Add* element accepts either a real Instance or the wrapper as Tab
		local Names = {}
		for Name, Fn in next, Options do
			if type(Name) == "string" and Name:sub(1, 3) == "Add" and type(Fn) == "function" and Name ~= "AddTab" and Name ~= "AddTheme" then
				table.insert(Names, Name)
			end
		end
		for _, Name in ipairs(Names) do
			local Original = Options[Name]
			Options[Name] = function(Self, Info, ...)
				if type(Info) == "table" and Info.Tab ~= nil then Info.Tab = Unwrap(Info.Tab) end
				return Original(Self, Info, ...)
			end
		end

		local StackAliases = {}
		for _, Name in ipairs({
			"Section", "Button", "Toggle", "Checkbox", "Slider", "Input", "Textarea", "Dropdown", "Paragraph", "Keybind", "Colorpicker",
			"Code", "Divider", "Space", "Image", "Video", "Group", "HStack", "VStack", "ProgressBar", "Collapsible", "Viewport",
		}) do
			StackAliases[Name] = "Add" .. Name
		end

		--// AddHStack / AddVStack return an object that has the Add* functions (and the WindUI names) built in
		for _, Name in ipairs({ "AddHStack", "AddVStack" }) do
			local Inner = Options[Name]

			Options[Name] = function(Self, Info, ...)
				return WrapTab(Inner(Self, Info, ...), StackAliases)
			end
		end

		--// FIX: AddGroup returned a raw Frame -> Group:AddButton(...) errored with
		--//      "AddButton is not a valid member of Frame ...Group". Return the wrapper instead
		--//      (the wrapper is accepted as Tab everywhere because Unwrap runs on every Add*).
		do
			local InnerGroup = Options.AddGroup
			Options.AddGroup = function(Self, Info, ...)
				return WrapTab(InnerGroup(Self, Info, ...), StackAliases)
			end

			local InnerCollapsible = Options.AddCollapsible
			Options.AddCollapsible = function(Self, Info, ...)
				local Content, Section = InnerCollapsible(Self, Info, ...)
				return WrapTab(Content, StackAliases), Section
			end
		end

		local OriginalAddTab = Options.AddTab
		Options.AddTab = function(Self, Info, ...)
			return WrapTab(OriginalAddTab(Self, Info, ...), StackAliases) --// Tab:Button({...}) / Tab:Toggle({...}) / Tab:Section({...}) like WindUI
		end

		--// WindUI window API:
		--//   local Group = Window:Section({ Title = "Elements" })     -> category in the sidebar
		--//   local Tab   = Group:Tab({ Title = "Button", Icon = "mouse" })   /   Window:Tab({ Title = "..", Icon = ".." })
		--//   Group:Divider()  adds a line.   Tab options Desc / IconColor / IconShape / Border are accepted (ignored).
		function Options:Tab(Info)
			Info = Info or {}
			Info.Title = Info.Title or Info.Name or "Tab"
			return Options:AddTab(Info)
		end

		function Options:Section(Info)
			Info = Info or {}
			local Group = Options:AddTabSection({
				Name = Info.Title or Info.Name,
				Order = Info.Order,
				Opened = Info.Opened,
				Divider = Info.Divider,
			})

			function Group:Tab(TabInfo)
				TabInfo = TabInfo or {}
				TabInfo.Section = Group.Key
				return Options:Tab(TabInfo)
			end

			function Group:Divider() Group:SetDivider(true) end

			return Group
		end

		--// WindUI: WindUI:Notify({...}) / WindUI:Popup({...}) straight on the library (uses the newest window)
		function Library:Notify(Info)
			local Win = OpenWindows[#OpenWindows]
			if Win then return Win:Notify(Info) end
		end

		function Library:Popup(Info)
			local Win = OpenWindows[#OpenWindows]
			if Win then return Win:Popup(Info) end
		end

		function Library:Window(Info) return Library:CreateWindow(Info) end
		Library.Version = Library.Version or "1.0"
	end

	SetProperty(Window, { Size = Settings.Size, Visible = true, Parent = Screen });
	Options:SetTheme(Theme) --// apply theme (this was never called before!)
	--// from here on the looks are fixed: background, hub name colour / gradient and open button looks can no longer be changed
	BG_Locked, Options._StyleLocked = true, true
	Animations:Open(Window, Settings.Transparency or 0)

	table.insert(OpenWindows, Options)

	return Options
end

return Library
