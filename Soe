	function Options:Notify(Settings: { Title: string, Description: string, Duration: number }) 
		local Notification = Clone(Components["Notification"]);
		local Title, Description = Options:GetLabels(Notification);
		local Timer = Notification["Timer"];
		
		SetProperty(Title, { Text = Settings.Title });
		SetProperty(Description, { Text = Settings.Description or Settings.Content });
		SetProperty(Notification, {
			Parent = NotifyFrame or NotifyGui,
		})

		--// follows the theme: Dialog colour box, Outline border, theme text colours, Accent timer bar
		Notification.BackgroundColor3 = SolidBoxColor()
		local NotifyStroke = Notification:FindFirstChildOfClass("UIStroke")
		if NotifyStroke then NotifyStroke.Color = Theme.Outline end
		Title.TextColor3 = Theme.Title
		Description.TextColor3 = Theme.Description
		Timer.BackgroundColor3 = Theme.Accent

		--// always above everything else (also when ZIndexBehavior is Global)
		Notification.ZIndex = 5000
		for _, Descendant in next, Notification:GetDescendants() do
			if Descendant:IsA("GuiObject") then Descendant.ZIndex = 5000 + math.min(Descendant.ZIndex, 50) end
		end
		
		task.spawn(function() 
			local Duration = Settings.Duration or 2
			local Wait = task.wait;
			
			Animations:Open(Notification, Setup.Transparency, true); Tween(Timer, Duration, { Size = UDim2.new(0, 0, 0, 4) });
			Wait(Duration);
			Animations:Close(Notification);
			Wait(1);
			Notification:Destroy();
		end)
	end

