local function ToColor(Value)
	if typeof(Value) == "Color3" then return Value end

	if type(Value) == "string" then
		local Ok, Result = pcall(Color3.fromHex, Value)
		if Ok then return Result end
	end
end

local function Brightness(Colour)
	return Colour.R * .299 + Colour.G * .587 + Colour.B * .114
end

--// ---------------------------------------------------------------
--// Gradients - accepted everywhere a gradient is wanted
--//   (Background = ..., Library:Gradient(...), Window:SetBackgroundGradient(...), a theme's Background = ...)
--//     { ["0"] = { Color = "#ff0000", Transparency = 0 }, ["100"] = { Color = "#0000ff" } }   WindUI style, key = position 0-100
--//     { "#ff0000", "#00ff00", "#0000ff" }                                                      colours spread evenly (hex or Color3)
--//     { { Color = "#ff0000", Position = 0 }, { Color = Color3.new(0, 0, 1), Position = 70, Transparency = .2 } }
--//     ColorSequence.new(...)   or an already built Library:Gradient({...})
--// ---------------------------------------------------------------
local function ToOffset(Value)
	if typeof(Value) == "Vector2" then return Value end
	if type(Value) == "number" then return Vector2.new(math.clamp(Value, -1, 1), 0) end
	return Vector2.new(0, 0)
end

local function ParseGradient(Stops, Props)
	if type(Props) ~= "table" then Props = {} end

	if typeof(Stops) == "ColorSequence" then
		return { Color = Stops, Transparency = NumberSequence.new(0), Rotation = tonumber(Props.Rotation) or 0, Offset = ToOffset(Props.Offset) }
	end

	assert(type(Stops) == "table", "[UI LIB]: Gradient needs a table of colour stops")

	--// already built by Library:Gradient: only apply the overrides
	if typeof(Stops.Color) == "ColorSequence" then
		local Copy = table.clone(Stops)
		if Props.Rotation ~= nil then Copy.Rotation = tonumber(Props.Rotation) or 0 end
		if Props.Offset ~= nil then Copy.Offset = ToOffset(Props.Offset) end
		if Copy.Offset == nil then Copy.Offset = ToOffset(nil) end
		return Copy
	end

	local List = {}

	--// a real list ({ "#a", "#b" }) vs a position table ({ ["0"] = .., ["100"] = .. }): a list has no keys except 1..n
	local IsList = #Stops > 0
	if IsList then
		local Total = 0
		for _ in next, Stops do Total = Total + 1 end
		IsList = Total == #Stops
	end

	if IsList then
		local Count = #Stops

		for Index, Info in ipairs(Stops) do
			local Item = type(Info) == "table" and Info or { Color = Info }
			local Position = Item.Position or Item.Time

			if Position ~= nil then
				Position = math.clamp((tonumber(Position) or 0) / 100, 0, 1)
			else
				Position = (Count == 1) and 0 or (Index - 1) / (Count - 1)
			end

			table.insert(List, { Position, Item })
		end
	else
		for Key, Info in next, Stops do
			table.insert(List, { math.clamp((tonumber(Key) or 0) / 100, 0, 1), type(Info) == "table" and Info or { Color = Info } })
		end
	end

	table.sort(List, function(A, B) return A[1] < B[1] end)

	local Colors, Alphas, Last = {}, {}, -1

	for _, Item in ipairs(List) do
		local Time = Item[1]
		if Time <= Last then Time = Last + .0001 end --// two stops can't share one position

		if Time <= 1 then
			Last = Time
			table.insert(Colors, ColorSequenceKeypoint.new(Time, ToColor(Item[2].Color) or Color3.new(1, 1, 1)))
			table.insert(Alphas, NumberSequenceKeypoint.new(Time, math.clamp(tonumber(Item[2].Transparency) or 0, 0, 1)))
		end
	end

	if #Colors == 0 then
		Colors, Alphas = { ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)) }, { NumberSequenceKeypoint.new(0, 0) }
	end

	--// a sequence has to start at 0 and end at 1
	if Colors[1].Time > 0 then
		table.insert(Colors, 1, ColorSequenceKeypoint.new(0, Colors[1].Value))
		table.insert(Alphas, 1, NumberSequenceKeypoint.new(0, Alphas[1].Value))
	end
	if Colors[#Colors].Time < 1 then
		table.insert(Colors, ColorSequenceKeypoint.new(1, Colors[#Colors].Value))
		table.insert(Alphas, NumberSequenceKeypoint.new(1, Alphas[#Alphas].Value))
	end

	return {
		Color = ColorSequence.new(Colors),
		Transparency = NumberSequence.new(Alphas),
		Rotation = tonumber(Props.Rotation) or 0,
		Offset = ToOffset(Props.Offset),
	}
end

--// the middle colour of a gradient (used for brightness checks, e.g. Dark / Light mode of a theme whose Background is a gradient)
local function GradientAverage(Info)
	local R, G, B, Count = 0, 0, 0, 0

	for _, Point in ipairs(Info.Color.Keypoints) do
		R, G, B, Count = R + Point.Value.R, G + Point.Value.G, B + Point.Value.B, Count + 1
	end

	if Count == 0 then return Color3.new(0, 0, 0) end
	return Color3.new(R / Count, G / Count, B / Count)
end

--// WindUI theme  ->  the colour slots this library paints with
local function BuildTheme(Info, Name)
	local Base = WindThemes.Dark
	--// WindUI: a theme's Background may be a gradient (Library:Gradient({...}) / { "#..", "#.." } / ColorSequence)
	local BackGradient
	if type(Info.Background) == "table" or typeof(Info.Background) == "ColorSequence" then
		local Ok, Parsed = pcall(ParseGradient, Info.Background)
		if Ok then BackGradient = Parsed end
	end

	local function Get(Key)
		if Key == "Background" and BackGradient then return GradientAverage(BackGradient) end
		return ToColor(Info[Key]) or ToColor(Base[Key])
	end

	local Back, Text, Dialog, Placeholder = Get("Background"), Get("Text"), Get("Dialog"), Get("Placeholder")

	--// Highlight colour (selected rows, tags, check marks ...):
	--//   1. "Primary" if the theme gives one
	--//   2. otherwise the theme's "Accent", as long as it stands out from the background
	--//   3. otherwise the "Button" colour
	local Highlight = ToColor(Info.Primary)

	if not Highlight then
		local Accent, Button = Get("Accent"), Get("Button")

		if math.abs(Brightness(Accent) - Brightness(Back)) > .22 then
			Highlight = Accent
		elseif math.abs(Brightness(Button) - Brightness(Back)) > .22 then
			Highlight = Button
		else
			Highlight = ToColor(Base.Primary)
		end
	end

	--// ---- contrast guard (custom themes) ----
	--// A custom theme can pick a Dialog / Text / Outline that is almost the same as the Background, which made buttons,
	--// toggles, inputs and borders blend in until they could not be seen. Push those slots away from what they sit on.
	local IsLight = Brightness(Back) > .6
	local PushTo = IsLight and Color3.new(0, 0, 0) or Color3.new(1, 1, 1)

	local function Separate(Colour, Against, MinGap)
		local Out = Colour
		for Step = 1, 14 do
			if math.abs(Brightness(Out) - Brightness(Against)) >= MinGap then break end
			Out = Out:Lerp(PushTo, .12)
		end
		return Out
	end

	local Secondary   = Back:Lerp(Dialog, .55)

	--// text (tab names, titles, descriptions) and icons must be readable on the window / sidebar AND on the content area.
	--// Unselected tab names are drawn semi-transparent, so they need an extra-strong gap.
	Text = Separate(Separate(Text, Back, .55), Secondary, .5)
	local DescColour = Separate(Text:Lerp(Placeholder, .35), Secondary, .35)
	local IconColour = Separate(Get("Icon"), Back, .45)

	local Component   = Separate(Dialog:Lerp(Text, .05), Secondary, .08)           --// buttons / rows must stand out from the content area
	local Interactables = Separate(Dialog:Lerp(Text, .12), Component, .07)         --// switches, tracks, input boxes must stand out from the row
	local Outline     = Separate(Back:Lerp(Get("Outline"), .1), Secondary, .1)     --// borders must be visible
	local Shadow      = Separate(Back:Lerp(Text, .2), Back, .1)

	return {
		Name = Name or Info.Name or "Custom",
		Light = Brightness(Back) > .6,

		--// Frames
		Primary = Back,                           --// window
		Secondary = Secondary,                    --// content area
		Component = Component,                    --// elements (button, toggle ...)
		Interactables = Interactables,            --// switches, slider track, inputs

		--// Text
		Tab = Text,
		Title = Text,
		Description = DescColour,

		--// Outlines
		Shadow = Shadow,
		Outline = Outline,

		--// Image
