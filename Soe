		--// ---------------------------------------------------------------
		--// Control style:  "Buttons" (WindUI: minimize / fullscreen / close, top-right)
		--//                 "Dots"    (the original three colour dots)
		--// CreateWindow({ ControlStyle = "Dots" })   Window:SetControlStyle("Buttons")   Window:GetControlStyle()
		--// ---------------------------------------------------------------
		--// ---------------------------------------------------------------
		--// Top bar  (right of the sidebar, same height as the control buttons)
		--//   "Dots"    -> visible filled bar, tags live inside it and can be as long as the window is wide
		--//   "Buttons" -> invisible, only holds the tags and stops before [ minimize ][ fullscreen ][ close ]
