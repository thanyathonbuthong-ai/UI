			if TopbarList[Name] and TopbarList[Name].Parent then Destroy(TopbarList[Name]) end

			local Control = NewControl("Top" .. Name, -1000 + (tonumber(Order) or TopbarCount), false)
			TopbarList[Name] = Control

			if ResolveIcon(Icon) then
				NewIcon(Control, Icon)
			else
				SetProperty(Control, { Text = tostring(Icon or Name):sub(1, 2), TextColor3 = Theme.Title, Font = Enum.Font.GothamBold, TextSize = 12 })
				table.insert(Custom, function() Control.TextColor3 = Theme.Title end)
			end

			Connect(Control.MouseButton1Click, function()
				if type(Callback) == "function" then task.spawn(Callback) end
			end)

			local Object = { Instance = Control }
			function Object:Destroy() Destroy(Control) TopbarList[Name] = nil end
			function Object:SetVisible(Visible) Control.Visible = Visible ~= false end
			function Object:SetIcon(NewIconName)
				local Image = ResolveIcon(NewIconName)
				local Existing = Control:FindFirstChild("CtrlIcon")
				if Image and Existing then Existing.Image = Image end
			end

			return Object
		end

		local function TopbarByName(Name)
