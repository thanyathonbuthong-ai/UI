--// WindUI custom icon sets:  Library:AddIcons("solar", { home = "rbxassetid://.." })   Library:SetIconsType("solar")
--//   "solar:home" always works; a plain "home" looks in the active set first, then in Lucide
local IconSets = {}
local IconsType --// name of the active custom set (nil = Lucide only)

--// returns  Image, ThemedFlag   (Lucide icons are white so they get tinted by the theme, other images keep their colours)
local function ResolveIcon(Icon)
	if type(Icon) == "number" then return "rbxassetid://" .. Icon, false end
	if type(Icon) ~= "string" or Icon == "" then return nil end

	if Icon:find("^rbxassetid://") or Icon:find("^rbxasset://") or Icon:find("^http") then return Icon, false end
	if Icon:find("^%d+$") then return "rbxassetid://" .. Icon, false end

	local Name = (Icon:lower():gsub("^lucide[:%-]", ""))
	if Name == "home" then Name = "house" end

	local SetName, SetKey = Icon:match("^([%w_%-]+):(.+)$")
	if SetName and SetName:lower() ~= "lucide" and IconSets[SetName:lower()] then
		local Set = IconSets[SetName:lower()]
		local Found = Set.Icons[SetKey] or Set.Icons[SetKey:lower()]
		if Found then return Found, Set.Themed end
	end

	if IconsType and IconSets[IconsType] and not Icon:lower():find("^lucide[:%-]") then
		local Set = IconSets[IconsType]
		local Found = Set.Icons[Icon] or Set.Icons[Name]
		if Found then return Found, Set.Themed end
	end

	if Lucide[Name] then return Lucide[Name], true end
end

