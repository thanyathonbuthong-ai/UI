	--// WindUI: Window:ScrollToTheElement(element)  -> scrolls the tab to the element and highlights it
	function Options:ScrollToTheElement(Target)
		local Row = Target

		if type(Target) == "table" then Row = Target.Instance or rawget(Target, "__Instance") or Target.Frame end
		if typeof(Row) ~= "Instance" or not Row.Parent then return false end

		local Scroll = Row:FindFirstAncestorOfClass("ScrollingFrame")
		if not Scroll then return false end

		local Y = Row.AbsolutePosition.Y - Scroll.AbsolutePosition.Y + Scroll.CanvasPosition.Y - 8
		Y = math.clamp(Y, 0, math.max(Scroll.AbsoluteCanvasSize.Y - Scroll.AbsoluteSize.Y, 0))

		Tween(Scroll, .35, { CanvasPosition = Vector2.new(Scroll.CanvasPosition.X, Y) })

		if type(Target) == "table" and Target.Highlight then
			task.delay(.3, function() pcall(Target.Highlight, Target) end)
		end

		return true
	end

