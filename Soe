	--// ------------------------------------------------------------------
	--// Background  (WindUI parity)
	--//   CreateWindow({
	--//       Background = "rbxassetid://..." | 123456 | "https://.../pic.png" | "video:rbxassetid://.." | "video:https://.../clip.mp4"
	--//                    | Color3 | ColorSequence | Library:Gradient({ ["0"] = { Color = .., Transparency = 0 }, ["100"] = { .. } }, { Rotation = 45 }),
	--//       BackgroundImageTransparency = 0.42,   --// 0 = picture fully visible, 1 = hidden
	--//       Transparent = true,                   --// glass window: the picture shows through the window, sidebar and every element
	--//       TransparencyValue = 0.35,             --// how see-through the glass is (0 - 0.95)
	--//   })
	--//   Window:SetBackgroundImage(src, transparency)  Window:SetBackgroundImageTransparency(n)  Window:RemoveBackground()  Window:GetBackground()
	--//   Window:ToggleTransparency(bool?)  Window:SetTransparent(bool, value?)  Window:IsTransparent()
	--//   Window:SetBackgroundTransparency(n)  Window:GetBackgroundTransparency()
	--//   Library:SetBackgroundImage(..) / :SetBackgroundImageTransparency(..) / :ToggleTransparency(..) / :SetTransparent(..) do it on every window.
	--//   Setting a Background turns the glass on automatically (unless CreateWindow({ Transparent = false })).
	--// ------------------------------------------------------------------
	local BGDefault = .42
	local BG_Layer, BG_Fill, BG_Picture, BG_Video, BG_Tint
	local BG_Kind, BG_Source, BG_Value = nil, nil, BGDefault
	local BG_Token = 0
	local BG_Gradient, BG_Info = nil, nil                         --// the UIGradient on the fill + the parsed gradient (nil for a plain colour)
	local BG_Manual, BG_FromTheme, BG_ThemeCall = false, false, false --// Manual = chosen by the script / the person, not by a theme whose Background is a gradient
	local BG_Locked = false --// becomes true when CreateWindow is done: the background can only be set while the window is being created
	local BG_Anim = NewSpinner(function() return BG_Gradient end, function() return Window:IsDescendantOf(game) end, function() return Window.Visible end) --// rotating gradient

	local function BG_Make()
		if BG_Layer and BG_Layer.Parent then return BG_Layer end

		--// sit under every other child of the window (sidebar, content ...)
		local Lowest = 0
		for _, Child in ipairs(Window:GetChildren()) do
			if Child:IsA("GuiObject") then Lowest = math.min(Lowest, Child.ZIndex - 1) end
		end

		local Sibling = Screen.ZIndexBehavior == Enum.ZIndexBehavior.Sibling
		local function Rank(Number) return Sibling and Number or Lowest end

		BG_Layer = Instance.new("Frame")
		SetProperty(BG_Layer, {
			Name = "WindowBackground",
			Active = false,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Size = UDim2.fromScale(1, 1),
			ZIndex = Lowest,
			Visible = false,
			Parent = Window,
		})

		local WindowCorner = Window:FindFirstChildOfClass("UICorner")
		if WindowCorner then Clone(WindowCorner).Parent = BG_Layer end

		BG_Fill = Instance.new("Frame")
		SetProperty(BG_Fill, {
			Name = "Fill", Active = false, BorderSizePixel = 0, BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = Rank(1), Parent = BG_Layer,
		})

		BG_Picture = Instance.new("ImageLabel")
		BG_Picture:SetAttribute("NoTheme", true) --// SetTheme must never recolour the picture
		SetProperty(BG_Picture, {
			Name = "Picture", Active = false, BackgroundTransparency = 1, BorderSizePixel = 0,
			ScaleType = Enum.ScaleType.Crop, Size = UDim2.fromScale(1, 1), ZIndex = Rank(2), Visible = false, Parent = BG_Layer,
		})

		BG_Video = Instance.new("VideoFrame")
		SetProperty(BG_Video, {
			Name = "Video", Active = false, BackgroundTransparency = 1, BorderSizePixel = 0,
			Looped = true, Volume = 0, Size = UDim2.fromScale(1, 1), ZIndex = Rank(2), Visible = false, Parent = BG_Layer,
		})

		--// a VideoFrame has no transparency of its own, so a theme coloured veil above it fades it instead
		BG_Tint = Instance.new("Frame")
		SetProperty(BG_Tint, {
			Name = "Tint", Active = false, BorderSizePixel = 0, BackgroundColor3 = Theme.Primary,
			BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = Rank(3), Visible = false, Parent = BG_Layer,
		})

		Custom["WindowBackground"] = function()
			if BG_Tint then BG_Tint.BackgroundColor3 = Theme.Primary end
		end

		return BG_Layer
	end

	local function BG_Apply()
		if not BG_Layer then return end

		if BG_Kind == "Image" then
			BG_Picture.ImageTransparency = BG_Value
		elseif BG_Kind == "Video" then
			BG_Tint.BackgroundTransparency = 1 - BG_Value
		elseif BG_Kind == "Color" then
			BG_Fill.BackgroundTransparency = BG_Value
		end
	end

	local function BG_Reset()
		BG_Token = BG_Token + 1 --// invalidates a download that is still running

		if not BG_Layer then return end

		for _, Gradient in ipairs(BG_Fill:GetChildren()) do
			if Gradient:IsA("UIGradient") then Gradient:Destroy() end
		end

		BG_Gradient = nil
		BG_Fill.BackgroundTransparency = 1
		BG_Fill.BackgroundColor3 = Color3.new(1, 1, 1)
		BG_Picture.Visible, BG_Picture.Image = false, ""
		BG_Tint.Visible = false

		pcall(function() BG_Video:Pause() end)
		BG_Video.Visible = false
		pcall(function() BG_Video.Video = "" end)
	end

	--// http(s) link / local file / asset id  ->  something an Image or a VideoFrame can load
	local function BG_Resolve(Raw, IsVideo)
		if type(Raw) == "number" then return "rbxassetid://" .. tostring(math.floor(Raw)) end
		if type(Raw) ~= "string" or Raw == "" then return nil end

		if Raw:find("^https?://") then
			if not (writefile and getcustomasset) then
				warn("[UI LIB]: this executor can't download the background (needs writefile + getcustomasset), use an rbxassetid instead")
				return nil
			end

			local Ok, Result = pcall(function()
				local Hash = 0
				for Index = 1, #Raw do
					Hash = (Hash * 31 + Raw:byte(Index)) % 1000000007
				end

				local Ext = ".png"
				if IsVideo then
					local Lower = Raw:lower()
					Ext = (Lower:find("%.mp4") and ".mp4") or (Lower:find("%.mov") and ".mov") or ".webm"
				end

				local File = "uilib_bg_" .. Hash .. Ext
				if not (isfile and isfile(File)) then
					writefile(File, game:HttpGet(Raw))
				end

				return getcustomasset(File)
			end)

			if Ok then return Result end
			warn("[UI LIB]: couldn't load the background: " .. tostring(Result))
			return nil
		end

		if Raw:match("^%d+$") then return "rbxassetid://" .. Raw end
		if Raw:find("^rbxasset") then return Raw end

		--// a file inside the executor's workspace folder
		if isfile and getcustomasset then
			local Ok, Exists = pcall(isfile, Raw)
			if Ok and Exists then
				local Ok2, Asset = pcall(getcustomasset, Raw)
				if Ok2 and Asset then return Asset end
			end
		end

		return Raw
	end

	--// ---- glass: makes the window, the sidebar and every element see-through so the background shows ----
	local Glass = { On = false, Value = .35, Auto = false }
	local GlassGiven = setmetatable({}, { __mode = "k" }) --// object -> the transparency this code gave it
	local GlassWatched = setmetatable({}, { __mode = "k" })
	local GlassOriginal = {}
	local GlassHolderStroke = setmetatable({}, { __mode = "k" }) --// the content panel's outline -> its transparency before the glass hid it
	local GlassSkip = {
		WindowBackground = true, Fill = true, Picture = true, Video = true, Tint = true, BackgroundShadow = true,
		PressOverlay = true, Circle = true, Highlight = true, Slide = true, Resize = true, Shadow = true,
		--// things that carry their own colour / gradient / state and must stay as they are
		Handle = true, Cursor = true, SV = true, Hue = true, AlphaFill = true, AlphaBack = true, Preview = true,
		SelectBar = true, SelectRing = true, ColorFill = true, Check = true, ProgressFill = true, OpenKnob = true,
		Hit = true, Arrow = true, ModalSink = true, LockedOverlay = true, Underline = true, Divider = true,
		SectionDivider = true, __divider = true, OpenDivider = true, Viewport = true,
	}
	local GlassOrig = setmetatable({}, { __mode = "k" }) --// object -> its transparency before the glass touched it
	local GlassColor = setmetatable({}, { __mode = "k" }) --// object -> its colour before the glass tint
	local GlassStroke = setmetatable({}, { __mode = "k" }) --// object -> the thin outline the glass added
	local GlassChip = setmetatable({}, { __mode = "k" }) --// object -> "chip" (small box inside a row) | "track" (toggle track; its ON colour must stay readable)

	local GlassQueued = false
	local function GlassQueue(Delay)
		if not Glass.On or GlassQueued then return end
		GlassQueued = true

		task.delay(Delay or .15, function()
			GlassQueued = false
			if Glass.On then Options:_GlassPass() end
		end)
	end

	local GlassClasses = { "Frame", "TextButton", "TextBox", "TextLabel", "ScrollingFrame", "ImageButton", "ImageLabel", "CanvasGroup" }

	local function GlassCandidate(Object)
		for _, Class in ipairs(GlassClasses) do
			if Object:IsA(Class) then return true end
		end
		return false
	end

	local GlassClearElements --// defined below: puts every row / chip back to its normal solid look

	function Options:_GlassPass()
		if not Glass.On then return end

		local Base = math.clamp(Glass.Value, 0, .95)
		local Card = math.clamp(.78 + Glass.Value * .35, .8, .97)  --// element rows: a light glass tint (WindUI)
		local Chip = math.clamp(Card - .04, .75, .95)              --// small boxes inside a row (key box, value box, input box ...)
		local Track = .5                                            --// toggle tracks: see-through, but the ON colour still shows
		local Tint = GlassTint()
		local Edge = GlassBase()
		local EdgeAlpha = (Setup.ThemeMode == "Light") and .86 or .88
		local function LevelOf(Kind) return (Kind == "chip" and Chip) or (Kind == "track" and Track) or Card end

		--// a colour / gradient background IS the window fill: the plain window + sidebar fill must not tint it
		local Solid = BG_Kind == "Color"

		Window.BackgroundTransparency = Solid and 1 or Base
		--// the content panel behind the rows is what looked like a big black box: make it fully clear (WindUI has no such panel)
		Holder.BackgroundTransparency = 1

		for _, Line in ipairs(Holder:GetChildren()) do
			if Line:IsA("UIStroke") then
				if GlassHolderStroke[Line] == nil then GlassHolderStroke[Line] = Line.Transparency end
				Line.Transparency = 1
			end
		end

		if GlassOriginal.Sidebar ~= nil and GlassOriginal.Sidebar < 1 then
			Sidebar.BackgroundTransparency = Solid and 1 or Base
		end

		--// a colour / gradient background only clears the big panels so it shows; the rows, boxes and buttons keep their normal solid look.
		--// Only a picture / video makes them see-through (or Transparent = true / :SetTransparent(true), which the person asked for).
		if Solid and Glass.Auto then
			GlassClearElements()
			return
		end

		--// anything inside a popup / dropdown list (marked "SolidBox") is left opaque
		local function InSolidBox(Object)
			local Up = Object
			while Up and Up ~= Window do
				if Up:GetAttribute("SolidBox") then return true end
				Up = Up.Parent
			end
			return false
		end

		for _, Object in ipairs(Window:GetDescendants()) do
			if GlassCandidate(Object) and Object ~= Holder and Object ~= Sidebar and not GlassSkip[Object.Name] and not InSolidBox(Object) then
				local Given = GlassGiven[Object]

				if Given then
					--// keep it in step with the level, unless something else changed it meanwhile
					if math.abs(Object.BackgroundTransparency - Given) < .002 then
						local Level = LevelOf(GlassChip[Object])
						Object.BackgroundTransparency = Level
						GlassGiven[Object] = Level
					end

					--// after a theme change the colour goes back to the theme's own: tint it again (but never fight the hover tween)
					if Object:GetAttribute("GlassTint") then
						local Now = Object.BackgroundColor3
						local function Far(A, B) return math.abs(A.R - B.R) + math.abs(A.G - B.G) + math.abs(A.B - B.B) > .06 end

						if Far(Now, Tint) and Far(Now, GlassTint(true)) then
							Object.BackgroundColor3 = Tint
						end

						if GlassStroke[Object] and GlassStroke[Object].Parent then
							GlassStroke[Object].Color = Edge
							GlassStroke[Object].Transparency = EdgeAlpha
						end
					end
				elseif Object.BackgroundTransparency < .97 then
					local Size = Object.AbsoluteSize

					if Size.Y == 0 or Size.X == 0 then
						--// not laid out yet: look again once it has a size
						if not GlassWatched[Object] then
							GlassWatched[Object] = true
							Connect(Object:GetPropertyChangedSignal("AbsoluteSize"), function() GlassQueue(.1) end)
						end
					else
						--// tiny things (lines, dots, knobs, thin bars) keep their colour; a square-ish small thing is a knob / dot
						--// (the checkbox "Box" is the one square that should turn see-through)
						local Tiny = Size.Y < 14 or Size.X < 14
						local Knob = math.abs(Size.X - Size.Y) <= 2 and Size.X < 24 and Object.Name ~= "Box"

						if not Tiny and not Knob then
							--// what kind of box is it?
							--//   track : the toggle switch track (has a "Circle" knob inside)
							--//   chip  : a small box, or anything sitting inside a row that is already see-through
							--//   (none): a normal element row
							local Parent = Object.Parent
							local Inside = Parent ~= nil and GlassGiven[Parent] ~= nil
								and (Parent:IsA("Frame") or Parent:IsA("TextButton"))
								and Parent.AbsoluteSize.Y <= 120

							local Kind = nil
							if Object:FindFirstChild("Circle") then
								Kind = "track"
							elseif Inside or Size.Y < 32 or Size.X < 70 then
								Kind = "chip"
							end

							local Level = LevelOf(Kind)

							--// only ever make it MORE see-through, never more solid
							if Object.BackgroundTransparency < Level then
								GlassOrig[Object] = Object.BackgroundTransparency
								GlassChip[Object] = Kind
								Object.BackgroundTransparency = Level
								GlassGiven[Object] = Level

								--// WindUI look: light tint + hair-line outline (not on the toggle track / checkbox, they carry a state colour)
								if Kind == "track" then
									local Knob = Object:FindFirstChild("Circle")
									if Knob then Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255) end
								end

								if Kind ~= "track" and Object.Name ~= "Box" then
									GlassColor[Object] = Object.BackgroundColor3
									Object:SetAttribute("GlassTint", true)
									Object.BackgroundColor3 = Tint
								end

								if Kind ~= "track" and not Object:FindFirstChildOfClass("UIStroke") and Size.Y >= 20 then
									local Line = Instance.new("UIStroke")
									Line.Name = "GlassStroke"
									Line.Thickness = 1
									Line.Color = Edge
									Line.Transparency = EdgeAlpha
									Line.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
									Line.Parent = Object
									GlassStroke[Object] = Line
								end
							end
						end
					end
				end
			end
		end
	end

	GlassClearElements = function()
		for Object, Given in next, GlassGiven do
			if Object.Parent and math.abs(Object.BackgroundTransparency - Given) < .002 then
				Object.BackgroundTransparency = GlassOrig[Object] or 0
			end
		end

		for Object, Kind in next, GlassChip do
			if Kind == "track" and Object.Parent then
				local Knob = Object:FindFirstChild("Circle")
				local State = Object.Parent:FindFirstChild("Value")
				if Knob then
					Knob.BackgroundColor3 = (State and State:IsA("BoolValue") and State.Value) and Color3.fromRGB(255, 255, 255) or Theme.Primary
				end
			end
		end

		for Object, Colour in next, GlassColor do
			if Object.Parent then
				Object.BackgroundColor3 = Colour
				Object:SetAttribute("GlassTint", nil)
			end
		end

		for _, Line in next, GlassStroke do
			if Line.Parent then Line:Destroy() end
		end

		table.clear(GlassGiven)
		table.clear(GlassOrig)
		table.clear(GlassChip)
		table.clear(GlassColor)
		table.clear(GlassStroke)
	end

	local function GlassClear()
		GlassClearElements()

		Window.BackgroundTransparency = GlassOriginal.Window or 0
		Holder.BackgroundTransparency = GlassOriginal.Holder or 0

		for Line, Alpha in next, GlassHolderStroke do
			if Line.Parent then Line.Transparency = Alpha end
		end
		table.clear(GlassHolderStroke)
		Sidebar.BackgroundTransparency = GlassOriginal.Sidebar or Sidebar.BackgroundTransparency
	end

	local function SetGlass(On, Value)
		if Value ~= nil then Glass.Value = math.clamp(tonumber(Value) or Glass.Value, 0, .95) end

		Setup.Glass = On == true or (On == nil and Glass.On)

		if On and not Glass.On then
			GlassOriginal = { Window = Window.BackgroundTransparency, Holder = Holder.BackgroundTransparency, Sidebar = Sidebar.BackgroundTransparency }
			Glass.On = true

			if not Glass.Hooked then
				Glass.Hooked = true
				Connect(Window.DescendantAdded, function() GlassQueue(.15) end)
			end
		elseif not On and Glass.On then
			Glass.On, Glass.Auto = false, false
			GlassClear()
			return
		end

		if Glass.On then
			Options:_GlassPass()
			GlassQueue(.4) --// once more after the layout settled
		end
	end

	function Options:SetTransparent(On, Value)
		Glass.Auto = false --// the person decided, the background no longer controls it
		SetGlass(On == true, Value)
	end

	function Options:IsTransparent() return Glass.On end

	function Options:ToggleTransparency(On)
		if On == nil then On = not Glass.On end
		Options:SetTransparent(On == true)
	end

	--// 0 = solid window again, 1 = almost fully see-through
	function Options:SetBackgroundTransparency(Value)
		Value = math.clamp(tonumber(Value) or 0, 0, .95)

		if Value <= 0 then
			Options:SetTransparent(false)
		else
			Options:SetTransparent(true, Value)
		end
	end

	function Options:GetBackgroundTransparency() return Glass.On and Glass.Value or 0 end

	--// a theme whose Background is a gradient paints it, unless the script / person picked a background by hand
	local function BG_SyncTheme()
		if BG_Manual then return end

		local Wanted = Theme.BackgroundGradient
		if Wanted and BG_FromTheme and BG_Source == Wanted then return end --// already showing it
		if not Wanted and not BG_FromTheme then return end

		BG_ThemeCall = true
		pcall(function()
			if Wanted then Options:SetBackgroundImage(Wanted, 0) else Options:SetBackgroundImage(nil) end
		end)
		BG_ThemeCall = false
	end

	--// ---- the background itself ----
	function Options:SetBackgroundImage(Source, Transparency)
		if BG_Locked then return end --// locked: ignore every change

		BG_Reset()

		--// a hex string like "#1e90ff" is a colour, not a file
		if type(Source) == "string" then
			local Hex = Source:match("^%s*(#%x+)%s*$")
			if Hex and ToColor(Hex) then Source = ToColor(Hex) end
		end

		local Removing = Source == nil or Source == false or Source == ""
		if not BG_ThemeCall then BG_Manual = not Removing end
		BG_FromTheme = BG_ThemeCall and not Removing

		if Removing then
			BG_Kind, BG_Source, BG_Info = nil, nil, nil
			if BG_Layer then BG_Layer.Visible = false end
			if Glass.Auto then
				SetGlass(false)
			elseif Glass.On then
				Options:_GlassPass() --// window / sidebar fill come back
			end
			if not BG_ThemeCall then BG_SyncTheme() end --// no hand-made background any more -> the theme's own (if it has one)
			return
		end

		BG_Make().Visible = true
		BG_Source = Source

		local Mine = BG_Token

		--// colour / gradient
		if typeof(Source) == "Color3" or typeof(Source) == "ColorSequence" or type(Source) == "table" then
			BG_Kind = "Color"
			BG_Value = math.clamp(tonumber(Transparency) or 0, 0, 1)

			if typeof(Source) == "Color3" then
				BG_Fill.BackgroundColor3 = Source
				BG_Info = nil
			else
				local Info = ParseGradient(Source) --// hex / Color3 stops, { "#a", "#b" } lists, WindUI style tables, ColorSequence ...
				local Gradient = Instance.new("UIGradient")

				Gradient.Color = Info.Color
				if Info.Transparency then Gradient.Transparency = Info.Transparency end
				Gradient.Rotation = Info.Rotation or 0
				Gradient.Offset = Info.Offset or Vector2.new(0, 0)
				Gradient.Parent = BG_Fill

				BG_Gradient, BG_Info = Gradient, Info
			end

			BG_Apply()
		else
			local Text = tostring(Source)
			local Raw, IsVideo = Text, false

			local Prefixed = Text:match("^[Vv][Ii][Dd][Ee][Oo]:(.+)$")
			if Prefixed then
				Raw, IsVideo = (Prefixed:gsub("^%s+", "")), true
			else
				local Lower = Text:lower()
				if Lower:find("%.mp4") or Lower:find("%.webm") or Lower:find("%.mov") then IsVideo = true end
			end

			BG_Kind = IsVideo and "Video" or "Image"
			BG_Info = nil
			BG_Value = math.clamp(tonumber(Transparency) or BGDefault, 0, 1)

			task.spawn(function() --// a download may yield, never block CreateWindow
				local Asset = BG_Resolve(Raw, IsVideo)
				if Mine ~= BG_Token or not Asset then return end

				if IsVideo then
					BG_Video.Video = Asset
					BG_Video.Visible = true
					BG_Tint.Visible = true
					BG_Video.Looped = true
					BG_Video.Volume = 0
					pcall(function() BG_Video:Play() end)
				else
					BG_Picture.Image = Asset
					BG_Picture.Visible = true
				end

				BG_Apply()
			end)
		end

		--// a picture behind opaque panels would never be seen, so let it shine through (WindUI: Transparent = true)
		if not Glass.On and WindowSettings.Transparent ~= false then
			Glass.Auto = true
			SetGlass(true)
		elseif Glass.On then
			Options:_GlassPass() --// picture <-> colour changes how the window / sidebar fill is handled
		end
	end

	function Options:SetBackgroundImageTransparency(Value)
		if BG_Locked then return end
		BG_Value = math.clamp(tonumber(Value) or BGDefault, 0, 1)
		BG_Apply()
	end

	function Options:RemoveBackground() Options:SetBackgroundImage(nil) end
	function Options:GetBackground() return BG_Source, BG_Value end

	--// ------------------------------------------------------------------
	--// Colour / gradient background  (WindUI: Background = Color3 | Library:Gradient({...}))
	--//   Window:SetBackgroundColor("#1e90ff" | Color3, transparency?)
	--//   Window:SetBackgroundGradient({ "#5865f2", "#eb459e" }, { Rotation = 45, Transparency = 0, Animate = true, Speed = 30 })
	--//   Window:SetBackgroundGradient({ ["0"] = { Color = "#ff0000", Transparency = 0 }, ["50"] = { Color = "#00ff00" }, ["100"] = { Color = "#0000ff" } }, { Rotation = 90 })
	--//   Window:SetBackgroundRotation(deg)   Window:GetBackgroundRotation()
	--//   Window:AnimateBackground(true | false | nil(toggle), speedDegPerSec?)   Window:IsBackgroundAnimated()
	--//   Window:GetBackgroundGradient() -> { Color, Transparency, Rotation, Offset } (nil for a plain colour / picture)
	--//   Window:RemoveBackground()  -> back to the theme (a theme whose Background is a gradient paints it by itself)
	--// ------------------------------------------------------------------
	function Options:SetBackgroundColor(Color, Transparency)
		local Value = ToColor(Color)
		assert(Value, "[UI LIB]: SetBackgroundColor needs a Color3 or a hex string such as \"#1e90ff\"")
		Options:SetBackgroundImage(Value, Transparency or 0)
	end

	function Options:SetBackgroundGradient(Stops, Props)
		Props = type(Props) == "table" and Props or {}

		Options:SetBackgroundImage(ParseGradient(Stops, Props), Props.Transparency) --// Props.Transparency = how see-through the whole gradient is (0 - 1)

		if Props.Animate ~= nil then
			Options:AnimateBackground(Props.Animate, Props.Speed)
		elseif Props.Speed ~= nil then
			BG_Anim.Speed = tonumber(Props.Speed) or BG_Anim.Speed
		end
	end

	function Options:SetBackgroundRotation(Degrees)
		if BG_Locked then return end
		Degrees = tonumber(Degrees) or 0

		if BG_Info then BG_Info.Rotation = Degrees end
		if BG_Gradient and BG_Gradient.Parent then BG_Gradient.Rotation = Degrees end
	end

	function Options:GetBackgroundRotation() return (BG_Gradient and BG_Gradient.Rotation) or 0 end
	function Options:GetBackgroundGradient() return BG_Info end

	function Options:AnimateBackground(On, Speed)
		if BG_Locked then return end
		BG_Anim:Set(On, Speed)
	end

	function Options:IsBackgroundAnimated() return BG_Anim.On, BG_Anim.Speed end

	--// The background, hub name colour / gradient and open button looks are fixed once CreateWindow returns (see the end of CreateWindow).
	--// There is no way to unlock them again.   Window:IsBackgroundLocked() -> true once the window is built
	function Options:IsBackgroundLocked() return BG_Locked end
	Options.IsStyleLocked = Options.IsBackgroundLocked

	if WindowSettings.TransparencyValue ~= nil then Glass.Value = math.clamp(tonumber(WindowSettings.TransparencyValue) or Glass.Value, 0, .95) end
	if WindowSettings.Transparent == true then SetGlass(true) end --// no background -> the normal solid look; a background turns the glass on by itself
	--// CreateWindow({ Background = "#1e90ff" | Color3 | { "#a", "#b" } | Library:Gradient({...}) | "rbxassetid://.." | "video:..",
	--//                BackgroundGradient = { "#5865f2", "#eb459e" },  BackgroundRotation = 45,  BackgroundImageTransparency = 0,
	--//                BackgroundAnimated = true,  BackgroundSpeed = 30 })   (BackgroundSpeed alone also starts the rotation)
	if WindowSettings.BackgroundGradient ~= nil then
		Options:SetBackgroundGradient(WindowSettings.BackgroundGradient, { Rotation = WindowSettings.BackgroundRotation, Transparency = WindowSettings.BackgroundImageTransparency })
	elseif WindowSettings.Background ~= nil then
		Options:SetBackgroundImage(WindowSettings.Background, WindowSettings.BackgroundImageTransparency)
		if WindowSettings.BackgroundRotation ~= nil then Options:SetBackgroundRotation(WindowSettings.BackgroundRotation) end
	end

	if WindowSettings.BackgroundAnimated ~= nil or WindowSettings.BackgroundSpeed ~= nil then
		Options:AnimateBackground(WindowSettings.BackgroundAnimated ~= false, WindowSettings.BackgroundSpeed)
	end
	Options.Dialog = Options.Popup

	--// ------------------------------------------------------------------
	--// Open / close button  (same style as the main window: Primary background, Shadow outline,
	--// Component chip with Outline stroke, and a real toggle switch like the Toggle element)
	--//   CreateWindow({ ..., OpenButton = { Title = "Menu", Icon = "lucide:app-window" } })   (OpenButton = false -> none)
	--//   Icon       : "rbxassetid://..", an asset id, or a Lucide name ("settings", "lucide:sword")  (default: app-window)
	--//   Color      : optional ColorSequence / Color3 outline override  (default = theme Shadow, same as the window)
	--//   Options:EditOpenButton({ Title, Icon, IconThemed, Enabled, Position, OnlyIcon, ShowState, Draggable, OnlyMobile,
	--//                        HideWhenOpen, CornerRadius, StrokeThickness, Scale, Color })
	--//   Options.OpenButton:Show() / :Hide() / :SetTitle() / :SetIcon() / :SetScale() / :Destroy()
	--//   Background : Background = src (image / video / Color3 / gradient), BackgroundImageTransparency, ChipTransparency
	--//                Options.OpenButton:SetBackground(src, t) / :SetBackgroundTransparency(t) / :SetChipTransparency(t) / :RemoveBackground() / :GetBackground()
	--// Tap = open / close the window.  Drag = move the button.  The switch shows the window state.
	--// ------------------------------------------------------------------
	local OpenButton = {}

	do
		local Config = {
			Title = WindowSettings.HubName or WindowSettings.Name or WindowSettings.Title or "Menu",
			Icon = WindowSettings.Icon or "app-window",
			IconThemed = nil,     --// nil = Lucide icons follow the theme, your own images keep their colours
			Enabled = WindowSettings.OpenButton ~= false,
			OnlyMobile = false,   --// true = only on touch devices
			OnlyIcon = false,
			ShowState = true,     --// toggle switch that mirrors the window state
			Draggable = true,
			HideWhenOpen = false, --// true = button disappears while the window is open
			Scale = 1,
			StrokeThickness = 1,
			CornerRadius = UDim.new(0, 10),
			Color = nil,          --// nil = outline follows the theme
			Position = UDim2.new(.5, 0, 0, 34),
		}

		local BarHeight = 46
		local ChipHeight = 36

		--// ---- root: looks like the main window ----
		local Root = Instance.new("CanvasGroup")
		SetProperty(Root, {
			Name = "OpenButton",
			AnchorPoint = Vector2.new(.5, .5),
			Position = Config.Position,
			Size = UDim2.fromOffset(150, BarHeight),
			BackgroundColor3 = Theme.Primary,
			BackgroundTransparency = 0,
			BorderSizePixel = 0,
			GroupTransparency = 1,
			Visible = false,
			Parent = Screen,
		})

		local Round = Instance.new("UICorner")
		Round.CornerRadius = Config.CornerRadius
		Round.Parent = Root

		local Edge = Instance.new("UIStroke")
		SetProperty(Edge, {
			Name = "OpenStroke",
			Color = Theme.Shadow,
			Transparency = .5,
			Thickness = Config.StrokeThickness,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = Root,
		})

		--// only used when the user passes a custom Color
		local Gradient = Instance.new("UIGradient")
		Gradient.Enabled = false
		Gradient.Parent = Edge

		local Scaler = Instance.new("UIScale")
		Scaler.Parent = Root

		local Row = Instance.new("Frame")
		SetProperty(Row, {
			Name = "OpenRow",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 0, 1, 0),
			Parent = Root,
		})

		local Layout = Instance.new("UIListLayout")
		SetProperty(Layout, {
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
			Parent = Row,
		})

		local Pad = Instance.new("UIPadding")
		SetProperty(Pad, { PaddingLeft = UDim.new(0, 5), PaddingRight = UDim.new(0, 8), Parent = Row })

		--// ---- drag handle ----
		local Grip = Instance.new("Frame")
		SetProperty(Grip, { Name = "OpenGrip", BackgroundTransparency = 1, Size = UDim2.fromOffset(26, ChipHeight), LayoutOrder = 1, Parent = Row })

		--// 9-dot (3x3) drag handle - the ONLY place the floating button can be dragged from
		local MoveIcon = Instance.new("Frame")
		SetProperty(MoveIcon, {
			Name = "MoveIcon",
			AnchorPoint = Vector2.new(.5, .5),
			Position = UDim2.fromScale(.5, .5),
			Size = UDim2.fromOffset(16, 16),
			BackgroundTransparency = 1,
			Parent = Grip,
		})

		local GripDots = {}
		for Row_ = 0, 2 do
			for Col_ = 0, 2 do
				local Dot = Instance.new("Frame")
				SetProperty(Dot, {
					Name = "GripDot",
					AnchorPoint = Vector2.new(.5, .5),
					Position = UDim2.new(0, 2 + Col_ * 6, 0, 2 + Row_ * 6),
					Size = UDim2.fromOffset(4, 4),
					BackgroundColor3 = Theme.Icon,
					BackgroundTransparency = .25,
					BorderSizePixel = 0,
					Parent = MoveIcon,
				})
				Instance.new("UICorner", Dot).CornerRadius = UDim.new(1, 0)
				GripDots[#GripDots + 1] = Dot
			end
		end

		local Divider = Instance.new("Frame")
		SetProperty(Divider, {
			Name = "OpenDivider",
			Size = UDim2.fromOffset(1, 20),
			BackgroundColor3 = Theme.Outline,
			BorderSizePixel = 0,
			LayoutOrder = 2,
			Parent = Row,
		})

		--// ---- chip: icon + title (same look as a Button element) ----
		local Inner = Instance.new("Frame")
		SetProperty(Inner, {
			Name = "OpenInner",
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, ChipHeight),
			BackgroundColor3 = Theme.Component,
			BorderSizePixel = 0,
			LayoutOrder = 3,
			Parent = Row,
		})

		local InnerRound = Instance.new("UICorner")
