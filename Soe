local function RegisterTheme(Info)
	assert(type(Info) == "table" and type(Info.Name) == "string", "[UI LIB]: AddTheme needs a table with a Name")

	ThemePresets[Info.Name] = BuildTheme(Info, Info.Name)
	if not table.find(ThemeOrder, Info.Name) then table.insert(ThemeOrder, Info.Name) end

	return ThemePresets[Info.Name]
end

for Name, Info in next, WindThemes do
	ThemePresets[Name] = BuildTheme(Info, Name)
end

local Theme = ThemePresets[Setup.ThemeName] or ThemePresets.Dark

--// WindUI look: elements are a soft light (dark theme) / dark (light theme) tint with a very high transparency
local function GlassBase() return (Setup.ThemeMode == "Light") and Color3.new(0, 0, 0) or Color3.new(1, 1, 1) end
local function GlassTint(Hover)
	local Base = GlassBase()
	local Colour = Base:Lerp(Theme.Button, .3)
	if Hover then Colour = Colour:Lerp(Base, .35) end
	return Colour
end

--// accepts a theme name, a WindUI style table or a table that already uses this library's slots
local function ResolveTheme(Value)
	if type(Value) == "string" then
		return ThemePresets[Value]
	elseif type(Value) == "table" then
		if Value.Secondary and Value.Component then
			local Copy = table.clone(Value)

			for Key, Default in next, Theme do
				if Copy[Key] == nil then Copy[Key] = Default end
			end

			return Copy
		end

		return BuildTheme(Value, Value.Name or "Custom")
	end
end

