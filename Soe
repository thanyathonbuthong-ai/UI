	function Options:AddButton(Settings: { [string]: any }) 
		local Button = Clone(Components["Button"]);
		local Title, Description = Options:GetLabels(Button);
		local Fill --// only used when Color is given

		Connect(Button.MouseButton1Click, function()
			if Settings.Callback then Settings.Callback() end
		end)
		Animations:Component(Button)
		SetProperty(Title, { Text = Settings.Title });
		SetProperty(Description, { Text = Settings.Description });
		SetProperty(Button, {
			Name = Settings.Title,
			Parent = Settings.Tab,
			Visible = true,
		})
		Animations:Press(Button)

		--// Coloured button (WindUI: Color = Color3)
		if Settings.Color then
			Button.BackgroundTransparency = 1

			Fill = Instance.new("Frame")
			SetProperty(Fill, {
				Name = "ColorFill",
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = Settings.Color,
				BorderSizePixel = 0,
				ZIndex = 0,
				Parent = Button,
			})

			local Rounded = false
			for _, Child in next, Button:GetChildren() do
				if Child:IsA("UICorner") then
					Clone(Child).Parent = Fill
