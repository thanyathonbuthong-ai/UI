local function GetRealCoins()
    local tbl = {}
    for _, tbl5 in pairs(Workspace:GetDescendants()) do
        if tbl5:IsA("BasePart") or tbl5:IsA("MeshPart") then
            local n = tbl5.Name:lower()
            local lower = tbl5.Parent and tbl5.Parent.Name:lower() or ""
            if not n:find("counter") and not n:find("ui") and not n:find("screen") and not n:find("board")
                and not n:find("text") and not n:find("wall") and not n:find("floor") and not n:find("door")
                and not lower:find("ui") and not lower:find("camera") then
                local match = (n == "coin" or n:match("^coin%%d") or n == "pickup" or n == "collectible"
                    or n == "money" or n == "cash" or n:find("collect") or lower:find("coin") or lower == "pickups")
                if match and tbl5.Size.X < 15 and tbl5.Size.Y < 15 and tbl5.Size.Z < 15
                    and tbl5.Transparency < 0.9 and tbl5.Position.Y > -50 and tbl5:IsDescendantOf(Workspace) then
                    table.insert(tbl, tbl5)
