                local getRoleResult = GetRole(plr)
                local c, rn
                if getRoleResult == "Murderer" then c = Color3.fromRGB(255, 50, 50) rn = "قاتل"
                elseif getRoleResult == "Sheriff" then c = Color3.fromRGB(50, 150, 255) rn = "شرطي"
                else c = Color3.fromRGB(50, 255, 50) rn = "عادي" end
                local MM2_HL = plr.Character:FindFirstChild("MM2_HL")
                if not MM2_HL then
                    MM2_HL = Instance.new("Highlight")
                    MM2_HL.Name = "MM2_HL"
                    MM2_HL.FillTransparency = 0.5
                    MM2_HL.Parent = plr.Character
                end
                MM2_HL.FillColor = c
                MM2_HL.OutlineColor = c
                local head = plr.Character:FindFirstChild("Head")
                if head then
                    local MM2_ESP = head:FindFirstChild("MM2_ESP")
                    if not MM2_ESP then
                        MM2_ESP = Instance.new("BillboardGui")
                        MM2_ESP.Name = "MM2_ESP"
                        MM2_ESP.Size = UDim2.new(0, 140, 0, 25)
                        MM2_ESP.StudsOffset = Vector3.new(0, 3, 0)
                        MM2_ESP.AlwaysOnTop = true
                        MM2_ESP.Parent = head
                        local TextLabel3 = Instance.new("TextLabel")
                        TextLabel3.Name = "Label"
                        TextLabel3.Size = UDim2.new(1, 0, 1, 0)
                        TextLabel3.BackgroundTransparency = 1
                        TextLabel3.TextSize = 10
                        TextLabel3.Font = Enum.Font.GothamBold
                        TextLabel3.TextStrokeTransparency = 0
                        TextLabel3.Parent = MM2_ESP
                    end
                    local Label = MM2_ESP:FindFirstChild("Label")
                    if Label then
                        Label.Text = rn .. " — " .. plr.DisplayName
                        Label.TextColor3 = c
                    end
                end
            end
        end
    else
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local MM2_HL2 = plr.Character:FindFirstChild("MM2_HL")
                if MM2_HL2 then MM2_HL2:Destroy() end
                local head = plr.Character:FindFirstChild("Head")
                if head then
                    local MM2_ESP2 = head:FindFirstChild("MM2_ESP")
                    if MM2_ESP2 then MM2_ESP2:Destroy() end
                end
            end
        end
    end
    if Config.CoinESP then
        local getRPResult6 = GetRP()
        for _, c in pairs(GetRealCoins()) do
            if c and c.Parent and not c:FindFirstChild("MM2_CE") then
                local BillboardGui = Instance.new("BillboardGui")
