local function StartAutoCollect()
    if AutoCollectRunning then return end
    AutoCollectRunning = true
    Config.AutoCollectCoins = true
    CoinsCollectedCount = 0
    CollectedCoins = {}
    SkippedCoins = {}
    spawn(function()
        while AutoCollectRunning and CoinsCollectedCount < 40 do
            pcall(function()
                local getHumResult = GetHum()
                local getRPResult4 = GetRP()
                local char = GetChar()
                if not getHumResult or not getRPResult4 or not char or getHumResult.Health <= 0 then return end
                if getRPResult4.Position.Y > -5 then LastSafePos = getRPResult4.CFrame end
                if getRPResult4.Position.Y < -20 then
                    if LastSafePos then getRPResult4.CFrame = LastSafePos
                    else getRPResult4.CFrame = CFrame.new(getRPResult4.Position.X, 50, getRPResult4.Position.Z) end
                    return
                end
                local coins = GetRealCoins()
                if #coins == 0 then return end
                local tbl3 = {}
                for _, c in pairs(coins) do
                    if not table.find(CollectedCoins, c) and not table.find(SkippedCoins, c) then
                        table.insert(tbl3, c)
                    end
                end
                if #tbl3 == 0 then return end
                table.sort(tbl3, function(tbl2, b)
                    return (tbl2.Position - getRPResult4.Position).Magnitude < (b.Position - getRPResult4.Position).Magnitude
                end)
                local availableCoins = tbl3[1]
                local walkSpeed = getHumResult.WalkSpeed
                getHumResult.WalkSpeed = 32
                local num2 = 0
                local lastPos = getRPResult4.Position
                while AutoCollectRunning and CoinsCollectedCount < 40 and availableCoins
                    and availableCoins.Parent and availableCoins:IsDescendantOf(Workspace) do
                    local currentRp = GetRP()
                    local getHumResult2 = GetHum()
                    local getCharResult2 = GetChar()
                    if not currentRp or not getHumResult2 or not getCharResult2 or getHumResult2.Health <= 0 then break end
                    local dist = (currentRp.Position - availableCoins.Position).Magnitude
                    if dist < 5 then
                        CoinsCollectedCount = CoinsCollectedCount + 1
                        table.insert(CollectedCoins, availableCoins)
                        break
                    end
                    if (currentRp.Position - lastPos).Magnitude < 0.5 then
                        num2 = num2 + 0.015
                    else
                        num2 = 0
                    end
                    lastPos = currentRp.Position
                    if num2 > 2.5 then
                        table.insert(SkippedCoins, availableCoins)
                        break
                    end
                    getHumResult2:MoveTo(availableCoins.Position)
                    for _, part in pairs(getCharResult2:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                    if currentRp.Position.Y < -20 then
                        if LastSafePos then currentRp.CFrame = LastSafePos end
                        break
                    end
                    RunService.Heartbeat:Wait()
                end
                hum.WalkSpeed = walkSpeed
            end)
            wait(0.03)
        end
        if CoinsCollectedCount >= 40 then
            AutoCollectRunning = false
            Config.AutoCollectCoins = false
            local getHumResult3 = GetHum()
            if getHumResult3 then getHumResult3.WalkSpeed = 16 end
        end
    end)
end
local function StopAutoCollect()
    AutoCollectRunning = false
    Config.AutoCollectCoins = false
    local getHumResult4 = GetHum()
    if getHumResult4 then getHumResult4.WalkSpeed = 16 end
end
-- ══════════ Draggable ══════════
local function MakeDrag(topbar, frame)
    local dragging, dragInput, dragStart, startPos
    topbar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    topbar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local input = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + input.X, startPos.Y.Scale, startPos.Y.Offset + input.Y)
        end
    end)
end
