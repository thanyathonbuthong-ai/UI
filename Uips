local function FindGun()
    for _, tbl5 in pairs(Workspace:GetDescendants()) do
        if tbl5:IsA("Tool") then
            for _, n in pairs({"Gun", "Revolver", "Pistol"}) do
                if tbl5.Name == n then return {tbl = "dropped", tool = tbl5} end
            end
        end
    end
    for _, tbl5 in pairs(Workspace:GetDescendants()) do
        if tbl5:IsA("BasePart") then
            if tbl5.Name == "Handle" and tbl5.Parent and tbl5.Parent:IsA("Tool") then
                for _, n in pairs({"Gun", "Revolver", "Pistol"}) do
                    if tbl5.Parent.Name == n then return {tbl = "dropped", tool = tbl5.Parent} end
                end
            end
            if tbl5.Name == "GunDrop" or tbl5.Name == "DroppedGun" then return {tbl = "dropped_part", part = tbl5} end
        end
    end
    return nil
end
