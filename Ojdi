--[[
    UILibrary (ModuleScript)
    ธีมมืด + แท็บแบบ Sidebar ตามภาพตัวอย่าง
    วางไว้ใน ReplicatedStorage แล้ว require จาก LocalScript

    API:
      local Window  = Library:CreateWindow({Title, Badges, ToggleKey})
      local Tab     = Window:AddTab(name, iconAssetId?)
      local Section = Tab:AddSection(title)
      Section:AddLabel(text)
      Section:AddStatusCard({Title, Text})
      Section:AddToggle({Name, Default, Flag, Callback})
      Section:AddSlider({Name, Min, Max, Default, Increment, Flag, Callback})
      Section:AddButton({Name, Callback})
      Section:AddDropdown({Name, Options, Default, Multi, Flag, Callback})
      Section:AddTextbox({Name, Placeholder, Default, Flag, Callback})
      Window:Notify({Title, Text, Duration})
      Window:Destroy()
]]

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Library = {}
Library.Flags = {}

------------------------------------------------------------------
-- Theme
------------------------------------------------------------------
local Theme = {
	Background = Color3.fromRGB(25, 25, 35),
	TitleBar   = Color3.fromRGB(30, 30, 40),
	Sidebar    = Color3.fromRGB(20, 20, 29),
	Element    = Color3.fromRGB(35, 35, 50),
	ElementHover = Color3.fromRGB(45, 45, 64),
	Dark       = Color3.fromRGB(18, 18, 26),
	Accent     = Color3.fromRGB(120, 80, 255), -- เปลี่ยนเป็น Color3.fromRGB(0,170,255) ได้
	Text       = Color3.fromRGB(240, 240, 240),
	SubText    = Color3.fromRGB(150, 150, 170),
	Off        = Color3.fromRGB(90, 90, 105),
	Stroke     = Color3.fromRGB(55, 55, 75),
}
Library.Theme = Theme

local FONT = Enum.Font.Gotham
local FONT_BOLD = Enum.Font.GothamBold

------------------------------------------------------------------
-- Helpers
------------------------------------------------------------------
local function New(class, props, parent)
	local obj = Instance.new(class)
	for k, v in pairs(props or {}) do
		obj[k] = v
	end
	if parent then
		obj.Parent = parent
	end
	return obj
end

local function Round(obj, radius)
	return New("UICorner", { CornerRadius = UDim.new(0, radius or 6) }, obj)
end

local function Stroke(obj, color, thickness, transparency)
	return New("UIStroke", {
		Color = color or Theme.Stroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, obj)
end

local function Pad(obj, l, r, t, b)
	return New("UIPadding", {
		PaddingLeft = UDim.new(0, l or 0),
		PaddingRight = UDim.new(0, r or 0),
		PaddingTop = UDim.new(0, t or 0),
		PaddingBottom = UDim.new(0, b or 0),
	}, obj)
end

local function Text(props, parent)
	local p = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = FONT,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
	}
	for k, v in pairs(props) do
		p[k] = v
	end
	return New("TextLabel", p, parent)
end

local function Tween(obj, props, t)
	TweenService:Create(obj, TweenInfo.new(t or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function IsPointer(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function IsMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
end

local function Safe(fn, ...)
	if fn then
		task.spawn(fn, ...)
	end
end

------------------------------------------------------------------
-- Window
------------------------------------------------------------------
function Library:CreateWindow(cfg)
	cfg = cfg or {}
	local Window = { Tabs = {}, ActiveTab = nil }
	local connections = {}

	local function Connect(signal, fn)
		local c = signal:Connect(fn)
		table.insert(connections, c)
		return c
	end

	local guiName = "UILib_" .. tostring(cfg.Title or "Window")
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local old = playerGui:FindFirstChild(guiName)
	if old then
		old:Destroy()
	end

	local Gui = New("ScreenGui", {
		Name = guiName,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 100,
	}, playerGui)
	Window.Gui = Gui

	local FULL_SIZE = UDim2.fromOffset(550, 400)
	local MIN_SIZE = UDim2.fromOffset(550, 36)

	local Main = New("Frame", {
		Name = "Main",
		Size = FULL_SIZE,
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		ClipsDescendants = true,
	}, Gui)
	Round(Main, 8)
	Stroke(Main, Theme.Stroke, 1)

	-- Title bar ---------------------------------------------------
	local TitleBar = New("Frame", {
		Name = "TitleBar",
		Size = UDim2.new(1, 0, 0, 36),
		BackgroundColor3 = Theme.TitleBar,
		BorderSizePixel = 0,
	}, Main)

	local TitleHolder = New("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		Position = UDim2.fromOffset(12, 0),
		BackgroundTransparency = 1,
	}, TitleBar)
	New("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, TitleHolder)

	Text({
		Text = cfg.Title or "UI Library",
		Font = FONT_BOLD,
		TextSize = 15,
		Size = UDim2.new(0, 0, 0, 20),
		AutomaticSize = Enum.AutomaticSize.X,
		LayoutOrder = 0,
	}, TitleHolder)

	for i, badge in ipairs(cfg.Badges or {}) do
		local b = Text({
			Text = string.upper(badge),
			Font = FONT_BOLD,
			TextSize = 9,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.new(0, 0, 0, 16),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 0.7,
			BackgroundColor3 = Theme.Accent,
			LayoutOrder = i,
		}, TitleHolder)
		Round(b, 4)
		Pad(b, 6, 6, 0, 0)
	end

	local function TitleButton(txt, offsetX)
		local btn = New("TextButton", {
			Size = UDim2.fromOffset(28, 24),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, offsetX, 0.5, 0),
			BackgroundColor3 = Theme.Element,
			BorderSizePixel = 0,
			Text = txt,
			Font = FONT_BOLD,
			TextSize = 16,
			TextColor3 = Theme.Text,
			AutoButtonColor = false,
		}, TitleBar)
		Round(btn, 5)
		Connect(btn.MouseEnter, function() Tween(btn, { BackgroundColor3 = Theme.ElementHover }) end)
		Connect(btn.MouseLeave, function() Tween(btn, { BackgroundColor3 = Theme.Element }) end)
		return btn
	end

	local CloseBtn = TitleButton("×", -8)
	local MinBtn = TitleButton("—", -40)

	-- Body --------------------------------------------------------
	local Body = New("Frame", {
		Name = "Body",
		Size = UDim2.new(1, 0, 1, -36),
		Position = UDim2.fromOffset(0, 36),
		BackgroundTransparency = 1,
	}, Main)

	local Sidebar = New("Frame", {
		Size = UDim2.new(0, 130, 1, 0),
		BackgroundColor3 = Theme.Sidebar,
		BorderSizePixel = 0,
	}, Body)

	Text({
		Text = "NAVIGATION",
		Font = FONT_BOLD,
		TextSize = 9,
		TextColor3 = Theme.SubText,
		Position = UDim2.fromOffset(12, 8),
		Size = UDim2.new(1, -24, 0, 14),
	}, Sidebar)

	local TabList = New("ScrollingFrame", {
		Position = UDim2.fromOffset(6, 28),
		Size = UDim2.new(1, -12, 1, -34),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, Sidebar)
	New("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, TabList)

	local Content = New("Frame", {
		Position = UDim2.fromOffset(136, 6),
		Size = UDim2.new(1, -142, 1, -12),
		BackgroundTransparency = 1,
	}, Body)

	-- Drag --------------------------------------------------------
	local dragging, dragStart, startPos = false, nil, nil
	Connect(TitleBar.InputBegan, function(input)
		if IsPointer(input) then
			dragging = true
			dragStart = input.Position
			startPos = Main.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	Connect(UIS.InputChanged, function(input)
		if dragging and IsMove(input) then
			local d = input.Position - dragStart
			Main.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + d.X,
				startPos.Y.Scale, startPos.Y.Offset + d.Y
			)
		end
	end)

	-- Minimize / Close -------------------------------------------
	local minimized = false
	Connect(MinBtn.MouseButton1Click, function()
		minimized = not minimized
		if minimized then
			Body.Visible = false
			Tween(Main, { Size = MIN_SIZE }, 0.2)
		else
			Tween(Main, { Size = FULL_SIZE }, 0.2)
			task.delay(0.1, function()
				if not minimized then
					Body.Visible = true
				end
			end)
		end
	end)

	function Window:Destroy()
		for _, c in ipairs(connections) do
			c:Disconnect()
		end
		Gui:Destroy()
	end
	Connect(CloseBtn.MouseButton1Click, function()
		Window:Destroy()
	end)

	-- Toggle visibility with key ---------------------------------
	local toggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift
	Connect(UIS.InputBegan, function(input, processed)
		if not processed and input.KeyCode == toggleKey then
			Gui.Enabled = not Gui.Enabled
		end
	end)

	-- Notify ------------------------------------------------------
	local NotifyHolder = New("Frame", {
		Size = UDim2.new(0, 240, 1, -20),
		Position = UDim2.new(1, -10, 0, 10),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundTransparency = 1,
	}, Gui)
	New("UIListLayout", {
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, NotifyHolder)

	function Window:Notify(n)
		n = n or {}
		local card = New("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = Theme.Element,
			BorderSizePixel = 0,
		}, NotifyHolder)
		Round(card, 6)
		Stroke(card, Theme.Accent, 1, 0.4)
		Pad(card, 10, 10, 8, 8)
		New("UIListLayout", { Padding = UDim.new(0, 2) }, card)
		Text({ Text = n.Title or "Notice", Font = FONT_BOLD, Size = UDim2.new(1, 0, 0, 16) }, card)
		Text({
			Text = n.Text or "",
			TextColor3 = Theme.SubText,
			TextWrapped = true,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
		}, card)
		task.delay(n.Duration or 4, function()
			if card then
				card:Destroy()
			end
		end)
	end

	----------------------------------------------------------------
	-- Tabs
	----------------------------------------------------------------
	local tabOrder = 0

	function Window:AddTab(name, icon)
		local Tab = {}
		tabOrder += 1

		local Btn = New("TextButton", {
			Size = UDim2.new(1, 0, 0, 32),
			BackgroundColor3 = Theme.Element,
			BorderSizePixel = 0,
			Text = name,
			Font = FONT,
			TextSize = 12,
			TextColor3 = Theme.SubText,
			TextXAlignment = Enum.TextXAlignment.Left,
			AutoButtonColor = false,
			LayoutOrder = tabOrder,
		}, TabList)
		Round(Btn, 6)
		Pad(Btn, icon and 34 or 12, 6, 0, 0)

		if icon then
			New("ImageLabel", {
				Size = UDim2.fromOffset(16, 16),
				Position = UDim2.new(0, -24, 0.5, -8),
				BackgroundTransparency = 1,
				Image = icon,
				ImageColor3 = Theme.SubText,
			}, Btn)
		end

		local Page = New("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = Theme.Accent,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			Visible = false,
		}, Content)
		New("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, Page)
		Pad(Page, 0, 8, 0, 8)

		local function SetActive(active)
			Page.Visible = active
			Tween(Btn, {
				BackgroundColor3 = active and Theme.Accent or Theme.Element,
				TextColor3 = active and Color3.new(1, 1, 1) or Theme.SubText,
			})
		end

		Connect(Btn.MouseButton1Click, function()
			if Window.ActiveTab and Window.ActiveTab ~= Tab then
				Window.ActiveTab.SetActive(false)
			end
			Window.ActiveTab = Tab
			SetActive(true)
		end)

		Tab.SetActive = SetActive
		Tab.Page = Page
		table.insert(Window.Tabs, Tab)

		if not Window.ActiveTab then
			Window.ActiveTab = Tab
			SetActive(true)
		end

		--------------------------------------------------------------
		-- Section
		--------------------------------------------------------------
		local sectionOrder = 0

		function Tab:AddSection(title)
			local Section = {}
			sectionOrder += 1

			local Frame = New("Frame", {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				LayoutOrder = sectionOrder,
			}, Page)
			New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, Frame)

			local order = 0
			local function O()
				order += 1
				return order
			end

			Text({
				Text = title or "Section",
				Font = FONT_BOLD,
				TextSize = 13,
				Size = UDim2.new(1, 0, 0, 18),
				LayoutOrder = O(),
			}, Frame)
			New("Frame", {
				Size = UDim2.new(1, 0, 0, 1),
				BackgroundColor3 = Theme.Stroke,
				BorderSizePixel = 0,
				LayoutOrder = O(),
			}, Frame)

			local function Holder(height)
				local h = New("Frame", {
					Size = UDim2.new(1, 0, 0, height),
					BackgroundColor3 = Theme.Element,
					BorderSizePixel = 0,
					LayoutOrder = O(),
				}, Frame)
				Round(h, 6)
				return h
			end

			---------------- Label ----------------
			function Section:AddLabel(txt)
				local l = Text({
					Text = txt,
					TextColor3 = Theme.SubText,
					TextWrapped = true,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					LayoutOrder = O(),
				}, Frame)
				return { Set = function(_, t) l.Text = t end }
			end

			---------------- Status card ----------------
			function Section:AddStatusCard(c)
				c = c or {}
				local h = Holder(54)
				Stroke(h, Theme.Stroke, 1)
				Text({
					Text = "● " .. string.upper(c.Title or "Status"),
					Font = FONT_BOLD,
					TextSize = 9,
					TextColor3 = Theme.Accent,
					Position = UDim2.fromOffset(12, 8),
					Size = UDim2.new(1, -24, 0, 12),
				}, h)
				local body = Text({
					Text = c.Text or "",
					Position = UDim2.fromOffset(12, 26),
					Size = UDim2.new(1, -24, 0, 18),
				}, h)
				return { SetText = function(_, t) body.Text = t end }
			end

			---------------- Toggle ----------------
			function Section:AddToggle(t)
				local state = t.Default == true
				local h = Holder(34)
				Text({
					Text = t.Name or "Toggle",
					Position = UDim2.fromOffset(12, 0),
					Size = UDim2.new(1, -80, 1, 0),
				}, h)

				local pill = New("TextButton", {
					Size = UDim2.fromOffset(46, 20),
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -10, 0.5, 0),
					BackgroundColor3 = Theme.Off,
					BorderSizePixel = 0,
					Text = "",
					AutoButtonColor = false,
				}, h)
				Round(pill, 10)

				local knob = New("Frame", {
					Size = UDim2.fromOffset(14, 14),
					AnchorPoint = Vector2.new(0, 0.5),
					Position = UDim2.new(0, 3, 0.5, 0),
					BackgroundColor3 = Color3.new(1, 1, 1),
					BorderSizePixel = 0,
				}, pill)
				Round(knob, 7)

				local stateLabel = Text({
					Text = "OFF",
					Font = FONT_BOLD,
					TextSize = 8,
					TextXAlignment = Enum.TextXAlignment.Center,
					Size = UDim2.new(0, 22, 1, 0),
					Position = UDim2.new(1, -24, 0, 0),
				}, pill)

				local obj = {}
				local function Apply(silent)
					Tween(pill, { BackgroundColor3 = state and Theme.Accent or Theme.Off })
					Tween(knob, { Position = state and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) })
					stateLabel.Text = state and "ON" or "OFF"
					stateLabel.Position = state and UDim2.new(0, 4, 0, 0) or UDim2.new(1, -24, 0, 0)
					if t.Flag then Library.Flags[t.Flag] = state end
					if not silent then Safe(t.Callback, state) end
				end

				function obj:Set(v) state = v and true or false Apply() end
				function obj:Get() return state end

				pill.MouseButton1Click:Connect(function() obj:Set(not state) end)
				Apply(true)
				if t.Default then Safe(t.Callback, state) end
				return obj
			end

			---------------- Slider ----------------
			function Section:AddSlider(s)
				local min, max = s.Min or 0, s.Max or 100
				local inc = s.Increment or 1
				local value = math.clamp(s.Default or min, min, max)
				local h = Holder(46)

				local label = Text({
					Position = UDim2.fromOffset(12, 5),
					Size = UDim2.new(1, -24, 0, 16),
				}, h)

				local bar = New("Frame", {
					Position = UDim2.new(0, 12, 0, 31),
					Size = UDim2.new(1, -24, 0, 6),
					BackgroundColor3 = Theme.Dark,
					BorderSizePixel = 0,
				}, h)
				Round(bar, 3)

				local fill = New("Frame", {
					Size = UDim2.fromScale(0, 1),
					BackgroundColor3 = Theme.Accent,
					BorderSizePixel = 0,
				}, bar)
				Round(fill, 3)

				local thumb = New("Frame", {
					Size = UDim2.fromOffset(12, 12),
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(1, 0.5),
					BackgroundColor3 = Color3.new(1, 1, 1),
					BorderSizePixel = 0,
				}, fill)
				Round(thumb, 6)

				local hit = New("TextButton", {
					Position = UDim2.new(0, 12, 0, 22),
					Size = UDim2.new(1, -24, 0, 22),
					BackgroundTransparency = 1,
					Text = "",
				}, h)

				local obj = {}
				local function Set(v, silent)
					v = math.clamp(math.floor((v - min) / inc + 0.5) * inc + min, min, max)
					value = tonumber(string.format("%.4f", v))
					fill.Size = UDim2.fromScale((value - min) / (max - min), 1)
					label.Text = (s.Name or "Slider") .. ": " .. tostring(value)
					if s.Flag then Library.Flags[s.Flag] = value end
					if not silent then Safe(s.Callback, value) end
				end
				function obj:Set(v) Set(v) end
				function obj:Get() return value end

				local sliding = false
				local function Update(x)
					local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
					Set(min + (max - min) * a)
				end
				hit.InputBegan:Connect(function(input)
					if IsPointer(input) then
						sliding = true
						Update(input.Position.X)
					end
				end)
				Connect(UIS.InputChanged, function(input)
					if sliding and IsMove(input) then
						Update(input.Position.X)
					end
				end)
				Connect(UIS.InputEnded, function(input)
					if IsPointer(input) then
						sliding = false
					end
				end)

				Set(value, true)
				return obj
			end

			---------------- Button ----------------
			function Section:AddButton(b)
				local btn = New("TextButton", {
					Size = UDim2.new(1, 0, 0, 32),
					BackgroundColor3 = Theme.Element,
					BorderSizePixel = 0,
					Text = b.Name or "Button",
					Font = FONT,
					TextSize = 13,
					TextColor3 = Theme.Text,
					AutoButtonColor = false,
					LayoutOrder = O(),
				}, Frame)
				Round(btn, 6)
				Stroke(btn, Theme.Stroke, 1)
				Connect(btn.MouseEnter, function() Tween(btn, { BackgroundColor3 = Theme.ElementHover }) end)
				Connect(btn.MouseLeave, function() Tween(btn, { BackgroundColor3 = Theme.Element }) end)
				Connect(btn.MouseButton1Click, function()
					Tween(btn, { BackgroundColor3 = Theme.Accent }, 0.08)
					task.delay(0.12, function() Tween(btn, { BackgroundColor3 = Theme.ElementHover }) end)
					Safe(b.Callback)
				end)
				return { SetText = function(_, t) btn.Text = t end }
			end

			---------------- Dropdown ----------------
			function Section:AddDropdown(d)
				local options = d.Options or {}
				local multi = d.Multi == true
				local selected = multi and {} or d.Default
				if multi and type(d.Default) == "table" then
					for _, v in ipairs(d.Default) do selected[v] = true end
				end

				local wrap = New("Frame", {
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					BackgroundColor3 = Theme.Element,
					BorderSizePixel = 0,
					LayoutOrder = O(),
				}, Frame)
				Round(wrap, 6)
				New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, wrap)

				local header = New("TextButton", {
					Size = UDim2.new(1, 0, 0, 34),
					BackgroundTransparency = 1,
					Text = "",
					LayoutOrder = 1,
				}, wrap)
				Text({
					Text = d.Name or "Dropdown",
					Position = UDim2.fromOffset(12, 0),
					Size = UDim2.new(0.5, -12, 1, 0),
				}, header)
				local valueLabel = Text({
					TextColor3 = Theme.SubText,
					TextXAlignment = Enum.TextXAlignment.Right,
					Position = UDim2.new(0.5, 0, 0, 0),
					Size = UDim2.new(0.5, -30, 1, 0),
				}, header)
				local arrow = Text({
					Text = "▼",
					TextSize = 9,
					TextColor3 = Theme.SubText,
					TextXAlignment = Enum.TextXAlignment.Center,
					Position = UDim2.new(1, -24, 0, 0),
					Size = UDim2.fromOffset(16, 34),
				}, header)

				local list = New("Frame", {
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					BackgroundColor3 = Theme.Dark,
					BorderSizePixel = 0,
					Visible = false,
					LayoutOrder = 2,
				}, wrap)
				Round(list, 6)
				Pad(list, 6, 6, 6, 6)
				New("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, list)

				local obj = {}

				local function Current()
					if multi then
						local out = {}
						for _, o in ipairs(options) do
							if selected[o] then table.insert(out, o) end
						end
						return out
					end
					return selected
				end

				local function UpdateHeader()
					if multi then
						valueLabel.Text = #Current() .. " selected"
					else
						valueLabel.Text = tostring(selected or "None")
					end
					if d.Flag then Library.Flags[d.Flag] = Current() end
				end

				local buttons = {}
				local function Highlight()
					for opt, b in pairs(buttons) do
						local on = multi and selected[opt] or (not multi and selected == opt)
						b.TextColor3 = on and Theme.Accent or Theme.Text
					end
				end

				local function Build()
					for _, b in pairs(buttons) do b:Destroy() end
					buttons = {}
					for i, opt in ipairs(options) do
						local b = New("TextButton", {
							Size = UDim2.new(1, 0, 0, 26),
							BackgroundColor3 = Theme.Element,
							BorderSizePixel = 0,
							Text = tostring(opt),
							Font = FONT,
							TextSize = 12,
							TextColor3 = Theme.Text,
							AutoButtonColor = false,
							LayoutOrder = i,
						}, list)
						Round(b, 5)
						buttons[opt] = b
						b.MouseButton1Click:Connect(function()
							if multi then
								selected[opt] = not selected[opt] or nil
							else
								selected = opt
								list.Visible = false
								arrow.Text = "▼"
							end
							Highlight()
							UpdateHeader()
							Safe(d.Callback, Current())
						end)
					end
					Highlight()
				end

				function obj:Get() return Current() end
				function obj:Set(v)
					if multi then
						selected = {}
						for _, o in ipairs(v) do selected[o] = true end
					else
						selected = v
					end
					Highlight()
					UpdateHeader()
					Safe(d.Callback, Current())
				end
				function obj:Refresh(newOptions)
					options = newOptions
					Build()
					UpdateHeader()
				end

				header.MouseButton1Click:Connect(function()
					list.Visible = not list.Visible
					arrow.Text = list.Visible and "▲" or "▼"
				end)

				Build()
				UpdateHeader()
				return obj
			end

			---------------- Textbox ----------------
			function Section:AddTextbox(t)
				local h = Holder(34)
				Text({
					Text = t.Name or "Textbox",
					Position = UDim2.fromOffset(12, 0),
					Size = UDim2.new(0.5, -12, 1, 0),
				}, h)
				local box = New("TextBox", {
					Size = UDim2.new(0.5, -22, 0, 22),
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -10, 0.5, 0),
					BackgroundColor3 = Theme.Dark,
					BorderSizePixel = 0,
					Text = t.Default or "",
					PlaceholderText = t.Placeholder or "",
					PlaceholderColor3 = Theme.Off,
					Font = FONT,
					TextSize = 12,
					TextColor3 = Theme.Text,
					ClearTextOnFocus = false,
				}, h)
				Round(box, 5)
				Pad(box, 6, 6, 0, 0)
				local stroke = Stroke(box, Theme.Stroke, 1)
				box.Focused:Connect(function() Tween(stroke, { Color = Theme.Accent }) end)
				box.FocusLost:Connect(function(enter)
					Tween(stroke, { Color = Theme.Stroke })
					if t.Flag then Library.Flags[t.Flag] = box.Text end
					Safe(t.Callback, box.Text, enter)
				end)
				return {
					Get = function() return box.Text end,
					Set = function(_, v) box.Text = tostring(v) end,
				}
			end

			return Section
		end

		return Tab
	end

	return Window
end

return Library
