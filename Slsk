-- =========================
-- THEMES
-- =========================
local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

local function mk(o)
	local base = {
		Surface = rgb(45, 45, 52), Field = rgb(30, 30, 36), Popup = rgb(30, 30, 36),
		Accent = rgb(60, 120, 255), Text = rgb(255, 255, 255), TextSoft = rgb(225, 225, 230),
		Muted = rgb(160, 160, 170), Off = rgb(80, 80, 92), Stroke = rgb(255, 255, 255),
		Danger = rgb(235, 80, 80), Success = rgb(70, 200, 120), Overlay = rgb(0, 0, 0),
		SurfaceAlpha = 0.4, ButtonAlpha = 0.2,
	}
	for k, v in pairs(o or {}) do base[k] = v end
	return base
end

Library.Themes = {
	Dark = mk(),
	Midnight = mk({ Surface = rgb(24, 28, 44), Field = rgb(15, 18, 30), Popup = rgb(18, 21, 36), Accent = rgb(110, 140, 255), Off = rgb(60, 66, 92) }),
	Rose = mk({ Surface = rgb(56, 36, 44), Field = rgb(36, 22, 28), Popup = rgb(40, 25, 32), Accent = rgb(240, 90, 130), Off = rgb(96, 68, 78) }),
	Emerald = mk({ Surface = rgb(34, 50, 42), Field = rgb(22, 32, 27), Popup = rgb(25, 36, 30), Accent = rgb(52, 200, 120), Off = rgb(66, 92, 78) }),
	Ocean = mk({ Surface = rgb(28, 46, 58), Field = rgb(18, 30, 40), Popup = rgb(20, 33, 44), Accent = rgb(40, 170, 230), Off = rgb(62, 88, 104) }),
	Violet = mk({ Surface = rgb(46, 36, 64), Field = rgb(30, 22, 44), Popup = rgb(34, 25, 50), Accent = rgb(150, 100, 255), Off = rgb(86, 72, 112) }),
}

Library.Theme = mk()

local R = { Large = 14, Medium = 10, Small = 8 }
local refreshers = {}

local function T() return Library.Theme end

local function reg(fn)
	fn()
	table.insert(refreshers, fn)
end

local function themed(inst, map)
	reg(function()
		for prop, key in pairs(map) do inst[prop] = Library.Theme[key] end
	end)
end

function Library:SetTheme(name)
	local th = Library.Themes[name]
	if not th then return false end
	for k, v in pairs(th) do Library.Theme[k] = v end
	for _, fn in ipairs(refreshers) do pcall(fn) end
	return true
end

function Library:GetThemes()
	local names = {}
	for n in pairs(Library.Themes) do table.insert(names, n) end
	table.sort(names)
	return names
end

-- =========================
-- UTILS
-- =========================
local function create(class, props, parent)
	local inst = Instance.new(class)
	if props then
		for k, v in pairs(props) do inst[k] = v end
	end
	if parent then inst.Parent = parent end
	return inst
end

local function corner(parent, r)
	return create("UICorner", { CornerRadius = UDim.new(0, r) }, parent)
end

local function stroke(parent, key, transparency)
	local s = create("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Thickness = 1,
		Transparency = transparency or 0.9,
	}, parent)
	themed(s, { Color = key or "Stroke" })
	return s
end

local function tween(inst, props, time)
	TweenService:Create(inst, TweenInfo.new(time or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function safe(cb, ...)
	if type(cb) ~= "function" then return end
	local ok, err = pcall(cb, ...)
	if not ok then warn("[UILibrary] callback error: " .. tostring(err)) end
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
end

-- แปลงตำแหน่ง input เป็นพิกัดภายใน GuiObject (รองรับ GuiInset)
local function localPos(area, pos)
	local gui = area:FindFirstAncestorOfClass("ScreenGui")
	local insetY = 0
	if gui and gui.IgnoreGuiInset then insetY = GuiService:GetGuiInset().Y end
	return Vector2.new(pos.X - area.AbsolutePosition.X, pos.Y + insetY - area.AbsolutePosition.Y)
end

local function makeDrag(area, hub, onMove, onState)
	local dragging = false
	area.Active = true
	area.InputBegan:Connect(function(input)
		if isPress(input) then
			dragging = true
			if onState then onState(true) end
			onMove(input.Position)
		end
	end)
	hub:_conn(UserInputService.InputChanged:Connect(function(input)
		if dragging and isMove(input) then onMove(input.Position) end
	end))
	hub:_conn(UserInputService.InputEnded:Connect(function(input)
		if dragging and isPress(input) then
			dragging = false
			if onState then onState(false) end
		end
	end))
end

-- icon: rbxassetid / rbxasset / rbxthumb / ตัวเลข = รูป, อย่างอื่น = ตัวอักษร/อีโมจิ
local function makeIcon(parent, icon, size)
	if icon == nil or icon == "" then return nil end
	size = size or 18
	local isImage = type(icon) == "number"
		or (type(icon) == "string" and (icon:find("^rbxasset") or icon:find("^rbxthumb")))
	local inst
	if isImage then
		if type(icon) == "number" then icon = "rbxassetid://" .. icon end
		inst = create("ImageLabel", {
			Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1, Image = icon,
		}, parent)
		themed(inst, { ImageColor3 = "Text" })
	else
		inst = create("TextLabel", {
			Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1, Text = tostring(icon),
			Font = Enum.Font.GothamBold, TextSize = size - 3,
		}, parent)
		themed(inst, { TextColor3 = "Text" })
	end
	return inst
end

local function norm(opts)
	if type(opts) == "string" then opts = { Title = opts } end
	opts = opts or {}
	if opts.Title == nil and opts.Text ~= nil then opts.Title = opts.Text end
	if opts.Value == nil and opts.Default ~= nil then opts.Value = opts.Default end
	return opts
end

-- ---------- Lua syntax highlight (RichText) ----------
local KEYWORDS = {}
for w in ("and break do else elseif end false for function if in local nil not or repeat return then true until while continue"):gmatch("%S+") do KEYWORDS[w] = true end
local BUILTINS = {}
for w in ("print warn game workspace script task wait spawn pairs ipairs next type typeof tostring tonumber require pcall Instance Vector3 Vector2 CFrame Color3 UDim2 UDim Enum math string table"):gmatch("%S+") do BUILTINS[w] = true end

local function highlight(src)
	local function esc(s) return (s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")) end
	local function col(s, hex) return '<font color="' .. hex .. '">' .. esc(s) .. "</font>" end
	local out, i, n = {}, 1, #src
	while i <= n do
		local c = src:sub(i, i)
		if src:sub(i, i + 1) == "--" then
			local e = src:find("\n", i, true) or (n + 1)
			table.insert(out, col(src:sub(i, e - 1), "#5c6370"))
			i = e
		elseif c == '"' or c == "'" then
			local j = i + 1
			while j <= n do
				local d = src:sub(j, j)
				if d == "\\" then j = j + 2
				elseif d == c or d == "\n" then break
				else j = j + 1 end
			end
			table.insert(out, col(src:sub(i, j), "#98c379"))
			i = j + 1
		elseif c:match("%d") then
			local _, e = src:find("^%d[%d%.xXa-fA-F_]*", i)
			table.insert(out, col(src:sub(i, e), "#d19a66"))
			i = e + 1
		elseif c:match("[%a_]") then
			local _, e = src:find("^[%w_]+", i)
			local w = src:sub(i, e)
			if KEYWORDS[w] then table.insert(out, col(w, "#c678dd"))
			elseif BUILTINS[w] then table.insert(out, col(w, "#61afef"))
			else table.insert(out, esc(w)) end
			i = e + 1
		else
			table.insert(out, esc(c))
			i = i + 1
		end
	end
	return table.concat(out)
end

local function keyName(v)
	if typeof(v) == "EnumItem" then return v.Name end
	if type(v) == "string" then
		local ok, item = pcall(function() return Enum.KeyCode[v] end)
		if ok and item then return v end
	end
	return "F"
end

local function resolveRoblox()
	local gui = CoreGui:WaitForChild("RobloxGui")
	local shield = gui:WaitForChild("SettingsClippingShield"):WaitForChild("SettingsShield")
	local page = shield:WaitForChild("MenuContainer"):WaitForChild("Page")
	return {
		Shield = shield,
		Page = page,
		HubBar = page:WaitForChild("HubBar"):WaitForChild("TabHeaderContainer"):WaitForChild("HubBarContainer"),
		Clipper = page:WaitForChild("PageViewClipper"),
	}
end

local function makePill(parent, text, variant, cb, height)
	local key = (variant == "Primary" and "Accent") or (variant == "Danger" and "Danger") or "Field"
	local b = create("TextButton", {
		Size = UDim2.new(1, 0, 0, height or 34), AutoButtonColor = false, BorderSizePixel = 0,
		Text = text or "", Font = Enum.Font.GothamBold, TextSize = 13,
	}, parent)
	corner(b, R.Medium)
	themed(b, { BackgroundColor3 = key, TextColor3 = "Text" })
	b.MouseEnter:Connect(function() tween(b, { BackgroundTransparency = 0.18 }) end)
	b.MouseLeave:Connect(function() tween(b, { BackgroundTransparency = 0 }) end)
	b.MouseButton1Click:Connect(function() safe(cb, b) end)
	return b
end

-- =========================
-- ELEMENT (ฐานของทุก element แบบการ์ด)
-- =========================
local Element = {}
Element.__index = Element

function Element:_refreshTitle()
	local t = (self.Locked and self.LockedTitle) or self.Title or ""
	self.TitleLabel.Text = t
	self.TitleLabel.Visible = t ~= ""
end

function Element:SetTitle(t) self.Title = t; self:_refreshTitle() end

function Element:SetDesc(d)
	self.Desc = d
	self.DescLabel.Text = d or ""
	self.DescLabel.Visible = d ~= nil and d ~= ""
end

function Element:Lock()
	self.Locked = true
	self.LockOverlay.Visible = true
	self:_refreshTitle()
end

function Element:Unlock()
	self.Locked = false
	self.LockOverlay.Visible = false
	self:_refreshTitle()
end

function Element:SetVisible(v) self.Card.Visible = v end

function Element:_track(conn)
	table.insert(self._conns, conn)
	return conn
end

function Element:_hit()
	local hit = create("TextButton", {
		Name = "Hit", Size = UDim2.new(1, 28, 1, 22), Position = UDim2.fromOffset(-14, -11),
		BackgroundTransparency = 1, Text = "", ZIndex = 3,
	}, self.Main)
	return hit
end

function Element:_extra(visible)
	local f = create("Frame", {
		Name = "Extra", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1, LayoutOrder = 2, Visible = visible ~= false,
	}, self.Body)
	create("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), PaddingBottom = UDim.new(0, 12) }, f)
	create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, f)
	self.Extra = f
	return f
end

function Element:Destroy()
	for _, c in ipairs(self._conns) do pcall(function() c:Disconnect() end) end
	if self.Flag and self._hub.Flags[self.Flag] == self then self._hub.Flags[self.Flag] = nil end
	if self.Separator then self.Separator:Destroy() end
	self.Card:Destroy()
	local c = self._container
	if c and c._relayout then task.defer(function() c:_relayout() end) end
end

-- =========================
-- CONTAINER (Tab / Section / Stack ใช้ร่วมกัน)
-- =========================
local Container = {}
Container.__index = Container

function Container:_next()
	self._order = self._order + 1
	return self._order
end

function Container:_register(el, opts)
	if opts and opts.Flag then
		el.Flag = opts.Flag
		self._hub.Flags[opts.Flag] = el
	end
	if self._relayout then self:_relayout() end
	return el
end

function Container:_base(opts, ctrlW, style)
	style = style or {}
	ctrlW = ctrlW or 0
	local el = setmetatable({
		Title = opts.Title, Desc = opts.Desc, Locked = opts.Locked or false, LockedTitle = opts.LockedTitle,
		_conns = {}, _hub = self._hub, _container = self,
	}, Element)

	if self._flat and self._order > 0 then
		el.Separator = create("Frame", {
			Size = UDim2.new(1, -28, 0, 1), BorderSizePixel = 0, BackgroundTransparency = 0.9,
			LayoutOrder = self:_next(),
		}, self.Content)
		themed(el.Separator, { BackgroundColor3 = "Stroke" })
		el.Separator.Position = UDim2.fromOffset(14, 0)
	end

	local card = create("Frame", {
		Name = tostring(opts.Title or "Element"), Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, BorderSizePixel = 0, LayoutOrder = self:_next(),
	}, self.Content)
	corner(card, R.Large)
	if self._flat then
		card.BackgroundTransparency = 1
	else
		themed(card, { BackgroundColor3 = style.Bg or "Surface", BackgroundTransparency = style.Alpha or "SurfaceAlpha" })
		stroke(card, "Stroke", 0.92)
	end
	el.Card = card
	el.AlphaKey = style.Alpha or "SurfaceAlpha"

	local body = create("Frame", {
		Name = "Body", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
	}, card)
	create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, body)
	el.Body = body

	local main = create("Frame", {
		Name = "Main", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1, LayoutOrder = 1,
	}, body)
	create("UIPadding", {
		PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14),
		PaddingTop = UDim.new(0, 11), PaddingBottom = UDim.new(0, 11),
	}, main)
	create("UISizeConstraint", { MinSize = Vector2.new(0, 46) }, main)
	el.Main = main

	local head = create("Frame", {
		Name = "Head",
		Size = ctrlW > 0 and UDim2.new(1, -(ctrlW + 12), 0, 0) or UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
	}, main)
	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10),
		VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder,
	}, head)

	local icon = makeIcon(head, opts.Icon, 20)
	if icon then icon.LayoutOrder = 1 end

	local labels = create("Frame", {
		Size = icon and UDim2.new(1, -30, 0, 0) or UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 2,
	}, head)
	create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, labels)

	el.TitleLabel = create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold, TextSize = 14, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 1,
	}, labels)
	themed(el.TitleLabel, { TextColor3 = "Text" })

	el.DescLabel = create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
		Font = Enum.Font.Gotham, TextSize = 12, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 2,
	}, labels)
	themed(el.DescLabel, { TextColor3 = "Muted" })

	el.Control = create("Frame", {
		Name = "Control", Size = UDim2.fromOffset(ctrlW, 28), AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0), BackgroundTransparency = 1,
	}, main)

	el.LockOverlay = create("Frame", {
		Name = "Lock", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 0.45, BorderSizePixel = 0,
		ZIndex = 10, Active = true, Visible = el.Locked,
	}, card)
	themed(el.LockOverlay, { BackgroundColor3 = "Overlay" })
	corner(el.LockOverlay, R.Large)

	el:_refreshTitle()
	el:SetDesc(opts.Desc)
	return el
end

-- ---------- Paragraph ----------
function Container:Paragraph(opts)
	opts = norm(opts)
	local el = self:_base(opts, 0)
	el.Type = "Paragraph"
	if opts.Buttons and #opts.Buttons > 0 then
		local extra = el:_extra()
		for _, b in ipairs(opts.Buttons) do
			local pill = makePill(extra, b.Title or "Button", b.Variant, b.Callback, 36)
			pill.LayoutOrder = _
		end
	end
	return self:_register(el, opts)
end

-- ---------- Label ----------
function Container:Label(text)
	local opts = norm(text)
	local label = create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
		Text = opts.Title or "", Font = Enum.Font.Gotham, TextSize = 13, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = self:_next(),
	}, self.Content)
	themed(label, { TextColor3 = "Muted" })
	local obj = { Instance = label }
	function obj:SetText(t) label.Text = t end
	function obj:Destroy() label:Destroy() end
	return obj
end

-- ---------- Button ----------
function Container:Button(opts)
	opts = norm(opts)
	local variant = opts.Variant or "Default"
	local style = nil
	if variant == "Primary" then style = { Bg = "Accent", Alpha = "ButtonAlpha" }
	elseif variant == "Danger" then style = { Bg = "Danger", Alpha = "ButtonAlpha" } end

	local el = self:_base(opts, 34, style)
	el.Type = "Button"
	el.Control.Size = UDim2.fromOffset(34, 28)

	local arrow = create("TextLabel", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = opts.Arrow or "›",
		Font = Enum.Font.GothamBold, TextSize = 22, TextXAlignment = Enum.TextXAlignment.Right,
	}, el.Control)
	themed(arrow, { TextColor3 = "Muted" })

	local hit = el:_hit()
	hit.MouseEnter:Connect(function()
		if el.Locked or self._flat then return end
		tween(el.Card, { BackgroundTransparency = math.max(T()[el.AlphaKey] - 0.18, 0) })
	end)
	hit.MouseLeave:Connect(function()
		if self._flat then return end
		tween(el.Card, { BackgroundTransparency = T()[el.AlphaKey] })
	end)
	hit.MouseButton1Click:Connect(function()
		if el.Locked or el._cooling then return end
		safe(opts.Callback, el)
	end)

	function el:Cooldown(sec)
		if self._cooling then return false end
		self._cooling = true
		task.spawn(function()
			local t0 = tick()
			while true do
				local remain = math.ceil(sec - (tick() - t0))
				if remain <= 0 then break end
				arrow.Text = remain .. "s"
				arrow.TextSize = 12
				task.wait(0.1)
			end
			arrow.Text = opts.Arrow or "›"
			arrow.TextSize = 22
			self._cooling = false
		end)
		return true
	end

	return self:_register(el, opts)
end

-- ---------- Toggle / Checkbox ----------
function Container:Toggle(opts)
	opts = norm(opts)
	local isCheck = opts.Type == "Checkbox"
	local el = self:_base(opts, isCheck and 22 or 44)
	el.Type = "Toggle"
	el.Value = false
	el.Control.Size = isCheck and UDim2.fromOffset(22, 22) or UDim2.fromOffset(44, 24)

	local track = create("Frame", { Size = UDim2.fromScale(1, 1), BorderSizePixel = 0 }, el.Control)
	corner(track, isCheck and 6 or 12)
	local knob, check
	if isCheck then
		check = create("TextLabel", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "✓",
			Font = Enum.Font.GothamBold, TextSize = 15, TextColor3 = Color3.new(1, 1, 1),
		}, track)
	else
		knob = create("Frame", {
			Size = UDim2.fromOffset(18, 18), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0),
			BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
		}, track)
		corner(knob, 9)
	end

	local function apply(animate)
		local color = el.Value and T().Accent or T().Off
		if animate then tween(track, { BackgroundColor3 = color }) else track.BackgroundColor3 = color end
		if knob then
			local pos = el.Value and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
			if animate then tween(knob, { Position = pos }) else knob.Position = pos end
		end
		if check then check.TextTransparency = el.Value and 0 or 1 end
	end
	reg(function() apply(false) end)

	function el:Set(v, silent)
		self.Value = v and true or false
		apply(true)
		if not silent then safe(opts.Callback, self.Value, self) end
	end
	function el:Get() return self.Value end

	el:_hit().MouseButton1Click:Connect(function()
		if not el.Locked then el:Set(not el.Value) end
	end)

	el._save = function() return el.Value end
	el._load = function(v) el:Set(v and true or false) end
	el:Set(opts.Value or false, true)
	return self:_register(el, opts)
end

-- ---------- Slider ----------
function Container:Slider(opts)
	opts = norm(opts)
	local v = opts.Value
	if type(v) ~= "table" then
		v = { Min = opts.Min or 0, Max = opts.Max or 100, Default = (type(v) == "number" and v) or nil }
	end
	local min, max = v.Min or 0, v.Max or 100
	local step = opts.Step or opts.Increment or 1
	local hasTitle = opts.Title ~= nil and opts.Title ~= ""
	local useBox = opts.IsTextbox ~= false

	local el = self:_base(opts, hasTitle and 210 or 0)
	el.Type = "Slider"
	el.Value = min
	local ctrl = el.Control
	if hasTitle then ctrl.Size = UDim2.fromOffset(210, 28) else ctrl.Size = UDim2.new(1, 0, 0, 28) end

	local boxW = useBox and 46 or 0
	local hit = create("Frame", {
		Size = UDim2.new(1, -(boxW + (useBox and 10 or 0)), 1, 0), BackgroundTransparency = 1,
	}, ctrl)
	local bar = create("Frame", {
		Size = UDim2.new(1, 0, 0, 6), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), BorderSizePixel = 0,
	}, hit)
	corner(bar, 3)
	themed(bar, { BackgroundColor3 = "Off" })
	local fill = create("Frame", { Size = UDim2.fromScale(0, 1), BorderSizePixel = 0 }, bar)
	corner(fill, 3)
	themed(fill, { BackgroundColor3 = "Accent" })
	local thumb = create("Frame", {
		Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
		BorderSizePixel = 0, ZIndex = 2, BackgroundColor3 = Color3.new(1, 1, 1),
	}, bar)
	corner(thumb, 7)

	local tip
	if opts.IsTooltip then
		tip = create("TextLabel", {
			Size = UDim2.fromOffset(40, 20), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0, -6),
			Font = Enum.Font.GothamBold, TextSize = 11, Visible = false, ZIndex = 5,
		}, thumb)
		corner(tip, 6)
		themed(tip, { BackgroundColor3 = "Popup", TextColor3 = "Text" })
	end

	local box
	if useBox then
		box = create("TextBox", {
			Size = UDim2.fromOffset(46, 24), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
			BorderSizePixel = 0, Font = Enum.Font.GothamSemibold, TextSize = 12, ClearTextOnFocus = false,
		}, ctrl)
		corner(box, 6)
		themed(box, { BackgroundColor3 = "Field", TextColor3 = "Text" })
	end

	local decimals = 0
	local sstr = tostring(step)
	local dot = sstr:find("%.")
	if dot then decimals = #sstr - dot end
	local function snap(x)
		x = math.clamp(x, min, max)
		x = min + math.floor((x - min) / step + 0.5) * step
		x = math.clamp(x, min, max)
		return tonumber(string.format("%." .. decimals .. "f", x))
	end
	local function visual()
		local ratio = (max == min) and 0 or (el.Value - min) / (max - min)
		fill.Size = UDim2.fromScale(ratio, 1)
		thumb.Position = UDim2.new(ratio, 0, 0.5, 0)
		if box then box.Text = tostring(el.Value) end
		if tip then tip.Text = tostring(el.Value) end
	end

	function el:Set(val, silent)
		val = snap(tonumber(val) or min)
		local changed = val ~= self.Value
		self.Value = val
		visual()
		if changed and not silent then safe(opts.Callback, val, self) end
	end
	function el:Get() return self.Value end

	makeDrag(hit, self._hub, function(pos)
		if el.Locked then return end
		local lp = localPos(hit, pos)
		local ratio = math.clamp(lp.X / math.max(hit.AbsoluteSize.X, 1), 0, 1)
		el:Set(min + (max - min) * ratio)
	end, function(active)
		if tip then tip.Visible = active end
	end)

	if box then
		box.FocusLost:Connect(function()
			if el.Locked then box.Text = tostring(el.Value) return end
			el:Set(tonumber(box.Text) or el.Value)
			box.Text = tostring(el.Value)
		end)
	end

	el._save = function() return el.Value end
	el._load = function(val) el:Set(val) end
	el:Set(v.Default or min, true)
	return self:_register(el, opts)
end

-- ---------- ProgressBar ----------
function Container:ProgressBar(opts)
	opts = norm(opts)
	local v = opts.Value
	if type(v) ~= "table" then
		v = { Min = opts.Min or 0, Max = opts.Max or 100, Default = (type(v) == "number" and v) or 0 }
	end
	local min, max = v.Min or 0, v.Max or 100
	local el = self:_base(opts, 190)
	el.Type = "ProgressBar"
	el.Value = math.clamp(v.Default or min, min, max)
	el.Control.Size = UDim2.fromOffset(190, 28)

	local bar = create("Frame", {
		Size = UDim2.new(1, -54, 0, 8), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
		BorderSizePixel = 0, ClipsDescendants = true,
	}, el.Control)
	corner(bar, 4)
	themed(bar, { BackgroundColor3 = "Off" })
	local fill = create("Frame", { Size = UDim2.fromScale(0, 1), BorderSizePixel = 0 }, bar)
	corner(fill, 4)
	themed(fill, { BackgroundColor3 = "Accent" })
	local label = create("TextLabel", {
		Size = UDim2.fromOffset(46, 28), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1, Font = Enum.Font.GothamSemibold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right,
	}, el.Control)
	themed(label, { TextColor3 = "Muted" })

	local mode = opts.DisplayMode or "Percent"
	local function ratio()
		if max == min then return el.Value >= max and 1 or 0 end
		return math.clamp((el.Value - min) / (max - min), 0, 1)
	end
	local function text()
		local r = ratio()
		if type(opts.Format) == "function" then
			local ok, res = pcall(opts.Format, el.Value, r * 100, min, max)
			if ok and res ~= nil then return tostring(res) end
		end
		if mode == "Value" then return tostring(el.Value) end
		if mode == "Fraction" then return el.Value .. "/" .. max end
		return math.floor(r * 100 + 0.5) .. "%"
	end

	function el:Set(val)
		self.Value = math.clamp(tonumber(val) or min, min, max)
		if not self._indeterminate then
			if opts.Animate == false then fill.Size = UDim2.fromScale(ratio(), 1)
			else tween(fill, { Size = UDim2.fromScale(ratio(), 1) }, 0.2) end
			label.Text = text()
		end
	end
	function el:Get() return self.Value end

	function el:SetIndeterminate(on)
		self._indeterminate = on and true or false
		if self._indConn then self._indConn:Disconnect(); self._indConn = nil end
		if on then
			label.Text = opts.IndeterminateText or ""
			fill.Size = UDim2.fromScale(0.35, 1)
			self._indConn = self:_track(RunService.Heartbeat:Connect(function()
				local t = ((tick() * (opts.Speed or 1) * 0.8) % 1.35) - 0.35
				fill.Position = UDim2.fromScale(t, 0)
			end))
		else
			fill.Position = UDim2.fromScale(0, 0)
			self:Set(self.Value)
		end
	end

	fill.Size = UDim2.fromScale(ratio(), 1)
	label.Text = text()
	if opts.Indeterminate then el:SetIndeterminate(true) end
	return self:_register(el, opts)
end

-- ---------- Keybind ----------
function Container:Keybind(opts)
	opts = norm(opts)
	local el = self:_base(opts, 84)
	el.Type = "Keybind"
	el.Value = keyName(opts.Value)
	el.Control.Size = UDim2.fromOffset(84, 28)

	local blacklist = { Escape = true }
	for _, k in ipairs(opts.Blacklist or {}) do blacklist[keyName(k)] = true end

	local pill = create("TextButton", {
		Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, AutoButtonColor = false, Text = el.Value,
		Font = Enum.Font.GothamBold, TextSize = 12,
	}, el.Control)
	corner(pill, R.Small)
	themed(pill, { BackgroundColor3 = "Field", TextColor3 = "Text" })

	local picking = false
	function el:Set(k, silent)
		self.Value = keyName(k)
		pill.Text = self.Value
		if not silent then safe(opts.OnChange, self.Value, self) end
	end
	function el:Get() return self.Value end

	pill.MouseButton1Click:Connect(function()
		if el.Locked or opts.CanChange == false then return end
		picking = true
		pill.Text = "..."
	end)

	el:_track(UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		if picking then
			if input.KeyCode ~= Enum.KeyCode.Escape and not blacklist[input.KeyCode.Name] then
				el:Set(input.KeyCode.Name)
			else
				pill.Text = el.Value
			end
			picking = false
			return
		end
		if input.KeyCode.Name == el.Value and not el.Locked and not UserInputService:GetFocusedTextBox() then
			safe(opts.Callback, el.Value, el)
		end
	end))

	el._save = function() return el.Value end
	el._load = function(v) el:Set(v) end
	return self:_register(el, opts)
end

-- ---------- Input / Textarea ----------
function Container:Input(opts)
	opts = norm(opts)
	local isArea = opts.Type == "Textarea"
	local el = self:_base(opts, isArea and 0 or 170)
	el.Type = "Input"
	el.Value = opts.Value or ""

	local holder
	if isArea then
		local extra = el:_extra()
		holder = create("Frame", { Size = UDim2.new(1, 0, 0, opts.Height or 90), BorderSizePixel = 0 }, extra)
	else
		el.Control.Size = UDim2.fromOffset(170, 28)
		holder = create("Frame", { Size = UDim2.fromScale(1, 1), BorderSizePixel = 0 }, el.Control)
	end
	corner(holder, R.Small)
	themed(holder, { BackgroundColor3 = "Field" })

	local box = create("TextBox", {
		Size = isArea and UDim2.new(1, -20, 1, -16) or UDim2.new(1, -20, 1, 0),
		Position = isArea and UDim2.fromOffset(10, 8) or UDim2.fromOffset(10, 0),
		BackgroundTransparency = 1, Text = el.Value, PlaceholderText = opts.Placeholder or "Enter text...",
		Font = Enum.Font.Gotham, TextSize = 13, ClearTextOnFocus = opts.ClearTextOnFocus or false,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = isArea and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
		MultiLine = isArea, TextWrapped = isArea, TextTruncate = isArea and Enum.TextTruncate.None or Enum.TextTruncate.AtEnd,
	}, holder)
	themed(box, { TextColor3 = "Text", PlaceholderColor3 = "Muted" })

	function el:Set(t, silent)
		self.Value = tostring(t or "")
		box.Text = self.Value
		if not silent then safe(opts.Callback, self.Value, self) end
	end
	function el:Get() return self.Value end

	box.FocusLost:Connect(function()
		if el.Locked then box.Text = el.Value return end
		el.Value = box.Text
		safe(opts.Callback, el.Value, el)
	end)

	el._save = function() return el.Value end
	el._load = function(t) el:Set(t) end
	return self:_register(el, opts)
end

-- ---------- Dropdown ----------
local function normalizeValues(values)
	local out = {}
	for _, v in ipairs(values or {}) do
		if type(v) == "table" then
			table.insert(out, { Title = tostring(v.Title or v.Name or ""), Icon = v.Icon })
		else
			table.insert(out, { Title = tostring(v) })
		end
	end
	return out
end

function Container:Dropdown(opts)
	opts = norm(opts)
	local multi = opts.Multi and true or false
	local el = self:_base(opts, 150)
	el.Type = "Dropdown"
	el.Values = normalizeValues(opts.Values or opts.Options)
	el.Value = multi and {} or nil
	el.Control.Size = UDim2.fromOffset(150, 28)

	local pill = create("Frame", { Size = UDim2.fromScale(1, 1), BorderSizePixel = 0 }, el.Control)
	corner(pill, R.Small)
	themed(pill, { BackgroundColor3 = "Field" })
	local pillLabel = create("TextLabel", {
		Size = UDim2.new(1, -30, 1, 0), Position = UDim2.fromOffset(10, 0), BackgroundTransparency = 1,
		Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
	}, pill)
	themed(pillLabel, { TextColor3 = "Text" })
	local arrow = create("TextLabel", {
		Size = UDim2.fromOffset(20, 28), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 0),
		BackgroundTransparency = 1, Text = "▾", Font = Enum.Font.GothamBold, TextSize = 13,
	}, pill)
	themed(arrow, { TextColor3 = "Muted" })

	local extra = el:_extra(false)
	local search
	if opts.SearchBarEnabled then
		local sh = create("Frame", { Size = UDim2.new(1, 0, 0, 30), BorderSizePixel = 0, LayoutOrder = 1 }, extra)
		corner(sh, R.Small)
		themed(sh, { BackgroundColor3 = "Field" })
		search = create("TextBox", {
			Size = UDim2.new(1, -20, 1, 0), Position = UDim2.fromOffset(10, 0), BackgroundTransparency = 1, Text = "",
			PlaceholderText = "Search...", Font = Enum.Font.Gotham, TextSize = 12, ClearTextOnFocus = false,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, sh)
		themed(search, { TextColor3 = "Text", PlaceholderColor3 = "Muted" })
	end
	local list = create("ScrollingFrame", {
		Size = UDim2.new(1, 0, 0, 100), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
		AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), LayoutOrder = 2,
	}, extra)
	create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, list)

	local function isSelected(title)
		if multi then return table.find(el.Value, title) ~= nil end
		return el.Value == title
	end
	local function display()
		if multi then
			local n = #el.Value
			if n == 0 then return "None" end
			if n <= 2 then return table.concat(el.Value, ", ") end
			return n .. " selected"
		end
		return el.Value or "Select"
	end

	local itemButtons = {}
	local function resize()
		local visible = 0
		for _, b in ipairs(itemButtons) do if b.Visible then visible = visible + 1 end end
		list.Size = UDim2.new(1, 0, 0, math.clamp(visible * 34 - 4, 30, 170))
	end
	local function paint()
		pillLabel.Text = display()
		for _, b in ipairs(itemButtons) do
			local sel = isSelected(b.Name)
			b.BackgroundColor3 = sel and T().Accent or T().Field
			b.BackgroundTransparency = sel and 0.7 or 0.2
			b.Mark.Visible = sel
		end
	end
	reg(paint)

	local function fire() safe(opts.Callback, el.Value, el) end

	local function rebuild()
		for _, b in ipairs(itemButtons) do b:Destroy() end
		itemButtons = {}
		for i, item in ipairs(el.Values) do
			local b = create("TextButton", {
				Name = item.Title, Size = UDim2.new(1, 0, 0, 30), BorderSizePixel = 0, AutoButtonColor = false,
				Text = "", LayoutOrder = i,
			}, list)
			corner(b, R.Small)
			local icon = makeIcon(b, item.Icon, 16)
			if icon then icon.Position = UDim2.new(0, 10, 0.5, -8) end
			local t = create("TextLabel", {
				Size = UDim2.new(1, -(icon and 64 or 40), 1, 0), Position = UDim2.fromOffset(icon and 34 or 10, 0),
				BackgroundTransparency = 1, Text = item.Title, Font = Enum.Font.Gotham, TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
			}, b)
			themed(t, { TextColor3 = "TextSoft" })
			local mark = create("TextLabel", {
				Name = "Mark", Size = UDim2.fromOffset(24, 30), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 0),
				BackgroundTransparency = 1, Text = "✓", Font = Enum.Font.GothamBold, TextSize = 13, Visible = false,
			}, b)
			themed(mark, { TextColor3 = "Accent" })
			b.MouseButton1Click:Connect(function()
				if el.Locked then return end
				if multi then
					local idx = table.find(el.Value, item.Title)
					if idx then table.remove(el.Value, idx) else table.insert(el.Value, item.Title) end
				else
					if el.Value == item.Title then
						if opts.AllowNone then el.Value = nil else el:Close() return end
					else
						el.Value = item.Title
					end
					el:Close()
				end
				paint()
				fire()
			end)
			table.insert(itemButtons, b)
		end
		paint()
		resize()
	end

	if search then
		search:GetPropertyChangedSignal("Text"):Connect(function()
			local q = search.Text:lower()
			for _, b in ipairs(itemButtons) do
				b.Visible = q == "" or b.Name:lower():find(q, 1, true) ~= nil
			end
			resize()
		end)
	end

	function el:Open()
		self.Opened = true
		extra.Visible = true
		arrow.Text = "▴"
	end
	function el:Close()
		self.Opened = false
		extra.Visible = false
		arrow.Text = "▾"
	end

	function el:Set(v, silent)
		if multi then
			local out = {}
			if type(v) == "table" then
				for _, t in ipairs(v) do table.insert(out, tostring(t)) end
			end
			self.Value = out
		else
			if type(v) == "number" and self.Values[v] then v = self.Values[v].Title end
			self.Value = v ~= nil and tostring(v) or nil
		end
		paint()
		if not silent then fire() end
	end
	function el:Get() return self.Value end

	function el:Refresh(values, keep)
		self.Values = normalizeValues(values)
		if not keep then self.Value = multi and {} or nil end
		rebuild()
	end

	el:_hit().MouseButton1Click:Connect(function()
		if el.Locked then return end
		if el.Opened then el:Close() else el:Open() end
	end)

	rebuild()
	local init = opts.Value
	if multi then
		el:Set(type(init) == "table" and init or {}, true)
	else
		el:Set(init, true)
	end

	el._save = function() return el.Value end
	el._load = function(v) el:Set(v) end
	return self:_register(el, opts)
end

-- ---------- Colorpicker ----------
function Container:Colorpicker(opts)
	opts = norm(opts)
	local el = self:_base(opts, 40)
	el.Type = "Colorpicker"
	el.Control.Size = UDim2.fromOffset(40, 24)
	local start = opts.Value
	if typeof(start) ~= "Color3" then start = Color3.new(1, 1, 1) end
	local h, s, v = start:ToHSV()
	local hasAlpha = opts.Transparency ~= nil
	local alpha = 1 - (opts.Transparency or 0)

	local swatch = create("Frame", { Size = UDim2.fromScale(1, 1), BorderSizePixel = 0 }, el.Control)
	corner(swatch, 7)
	stroke(swatch, "Stroke", 0.7)

	local extra = el:_extra(false)

	local sv = create("Frame", { Size = UDim2.new(1, 0, 0, 120), BorderSizePixel = 0, ClipsDescendants = true, LayoutOrder = 1 }, extra)
	corner(sv, R.Small)
	local white = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, sv)
	create("UIGradient", { Transparency = NumberSequence.new(0, 1) }, white)
	local black = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0 }, sv)
	create("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }, black)
	local svMarker = create("Frame", {
		Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0, ZIndex = 3,
	}, sv)
	corner(svMarker, 6)
	create("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1.5 }, svMarker)

	local hueBar = create("Frame", { Size = UDim2.new(1, 0, 0, 14), BorderSizePixel = 0, BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = 2 }, extra)
	corner(hueBar, 7)
	local stops = {}
	for i = 0, 6 do table.insert(stops, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i == 6 and 0 or i / 6, 1, 1))) end
	create("UIGradient", { Color = ColorSequence.new(stops) }, hueBar)
	local hueMarker = create("Frame", {
		Size = UDim2.fromOffset(6, 20), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 3,
	}, hueBar)
	corner(hueMarker, 3)
	create("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1 }, hueMarker)

	local alphaFill, alphaMarker, alphaBar
	if hasAlpha then
		alphaBar = create("Frame", { Size = UDim2.new(1, 0, 0, 14), BorderSizePixel = 0, LayoutOrder = 3 }, extra)
		corner(alphaBar, 7)
		themed(alphaBar, { BackgroundColor3 = "Off" })
		alphaFill = create("Frame", { Size = UDim2.fromScale(1, 1), BorderSizePixel = 0 }, alphaBar)
		corner(alphaFill, 7)
		create("UIGradient", { Transparency = NumberSequence.new(1, 0) }, alphaFill)
		alphaMarker = create("Frame", {
			Size = UDim2.fromOffset(6, 20), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
			BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 3,
		}, alphaBar)
		corner(alphaMarker, 3)
		create("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1 }, alphaMarker)
	end

	local hexHolder = create("Frame", { Size = UDim2.new(1, 0, 0, 28), BorderSizePixel = 0, LayoutOrder = 4 }, extra)
	corner(hexHolder, R.Small)
	themed(hexHolder, { BackgroundColor3 = "Field" })
	local hexBox = create("TextBox", {
		Size = UDim2.new(1, -20, 1, 0), Position = UDim2.fromOffset(10, 0), BackgroundTransparency = 1,
		Font = Enum.Font.GothamSemibold, TextSize = 12, ClearTextOnFocus = false, Text = "",
	}, hexHolder)
	themed(hexBox, { TextColor3 = "Text" })

	local function refresh(fire)
		local c = Color3.fromHSV(h, s, v)
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svMarker.Position = UDim2.fromScale(s, 1 - v)
		hueMarker.Position = UDim2.new(h, 0, 0.5, 0)
		swatch.BackgroundColor3 = c
		swatch.BackgroundTransparency = hasAlpha and (1 - alpha) or 0
		if alphaFill then
			alphaFill.BackgroundColor3 = c
			alphaMarker.Position = UDim2.new(alpha, 0, 0.5, 0)
		end
		hexBox.Text = "#" .. c:ToHex():upper()
		el.Value = c
		el.Transparency = 1 - alpha
		if fire then safe(opts.Callback, c, 1 - alpha, el) end
	end

	makeDrag(sv, self._hub, function(pos)
		if el.Locked then return end
		local lp = localPos(sv, pos)
		s = math.clamp(lp.X / math.max(sv.AbsoluteSize.X, 1), 0, 1)
		v = 1 - math.clamp(lp.Y / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
		refresh(true)
	end)
	makeDrag(hueBar, self._hub, function(pos)
		if el.Locked then return end
		h = math.clamp(localPos(hueBar, pos).X / math.max(hueBar.AbsoluteSize.X, 1), 0, 0.999)
		refresh(true)
	end)
	if alphaBar then
		makeDrag(alphaBar, self._hub, function(pos)
			if el.Locked then return end
			alpha = math.clamp(localPos(alphaBar, pos).X / math.max(alphaBar.AbsoluteSize.X, 1), 0, 1)
			refresh(true)
		end)
	end
	hexBox.FocusLost:Connect(function()
		local ok, c = pcall(Color3.fromHex, hexBox.Text)
		if ok and c then
			h, s, v = c:ToHSV()
			refresh(true)
		else
			refresh(false)
		end
	end)

	function el:Set(c, transparency, silent)
		if typeof(c) == "Color3" then h, s, v = c:ToHSV() end
		if transparency ~= nil then alpha = 1 - transparency end
		refresh(not silent)
	end
	function el:Get() return self.Value, self.Transparency end

	el:_hit().MouseButton1Click:Connect(function()
		if el.Locked then return end
		extra.Visible = not extra.Visible
	end)

	el._save = function() return { Hex = el.Value:ToHex(), T = el.Transparency } end
	el._load = function(d)
		if type(d) ~= "table" then return end
		local ok, c = pcall(Color3.fromHex, d.Hex)
		if ok then el:Set(c, d.T) end
	end
	refresh(false)
	return self:_register(el, opts)
end

