-- ---------- Group / HStack / VStack ----------
local Stack = setmetatable({}, { __index = Container })
Stack.__index = Stack

function Stack:_relayout()
	if not self._hstack then return end
	local items = {}
	for _, c in ipairs(self.Content:GetChildren()) do
		if c:IsA("GuiObject") then table.insert(items, c) end
	end
	local n = #items
	if n == 0 then return end
	for _, c in ipairs(items) do
		c.Size = UDim2.new(1 / n, -(self._gap * (n - 1)) / n, 0, 0)
	end
end

local function newStack(parent, opts, kind)
	opts = opts or {}
	local gap = opts.Gap or ((kind == "Group") and 0 or 8)
	local st = setmetatable({
		_hub = parent._hub, _order = 0, _flat = (kind == "Group"), _hstack = (kind == "HStack"), _gap = gap,
	}, Stack)
	local frame = create("Frame", {
		Name = kind, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1, BorderSizePixel = 0, LayoutOrder = parent:_next(),
	}, parent.Content)
	create("UIListLayout", {
		FillDirection = (kind == "HStack") and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap), SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Top,
	}, frame)
	if kind == "Group" then
		corner(frame, R.Large)
		themed(frame, { BackgroundColor3 = "Surface", BackgroundTransparency = "SurfaceAlpha" })
		stroke(frame, "Stroke", 0.92)
	end
	st.Content = frame
	st.Instance = frame
	function st:Destroy() frame:Destroy() end
	if parent._relayout then parent:_relayout() end
	return st
end

function Container:Group(opts) return newStack(self, opts, "Group") end
function Container:HStack(opts) return newStack(self, opts, "HStack") end
function Container:VStack(opts) return newStack(self, opts, "VStack") end

