function Container:ConfigManager(opts)
	opts = opts or {}
	local hub = self._hub
	local sec = self:Section({ Title = opts.Title or "Configuration", Icon = opts.Icon, Collapsible = opts.Collapsible ~= false })
	local nameInput = sec:Input({ Title = "Config name", Placeholder = "default" })
	local dd = sec:Dropdown({ Title = "Saved configs", Values = hub:ListConfigs() })
	local function pick() return (nameInput.Value ~= "" and nameInput.Value) or dd.Value end
	local function refresh() dd:Refresh(hub:ListConfigs(), true) end
	local row = sec:HStack()
	row:Button({ Title = "Save", Variant = "Primary", Arrow = "", Callback = function()
		local n = pick()
		if not n then return hub:Notify({ Title = "Config", Content = "ใส่ชื่อ config ก่อน", Duration = 3 }) end
		local ok = hub:SaveConfig(n)
		refresh()
		hub:Notify({ Title = "Config", Content = ok and ("Saved: " .. n) or "Save failed", Duration = 3 })
	end })
	row:Button({ Title = "Load", Arrow = "", Callback = function()
		local n = dd.Value or pick()
		if not n then return end
		local ok = hub:LoadConfig(n)
		hub:Notify({ Title = "Config", Content = ok and ("Loaded: " .. n) or "Load failed", Duration = 3 })
	end })
	row:Button({ Title = "Delete", Variant = "Danger", Arrow = "", Callback = function()
		local n = dd.Value
		if not n then return end
		hub:DeleteConfig(n)
		dd:Set(nil, true)
		refresh()
	end })
	return sec
end

