function Library.new(opts)
	opts = opts or {}
	local r = resolveRoblox()
	local self = setmetatable({ _r = r, _tabs = {}, _conns = {}, Active = nil, Flags = {}, _notifId = 0 }, Library)
	if opts.Folder then self.ConfigFolder = opts.Folder end
	if opts.Theme then Library:SetTheme(opts.Theme) end

	self._origParent = r.HubBar.Parent
	self._scroll = create("ScrollingFrame", {
		Name = "HubScroll", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 0, ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X, CanvasSize = UDim2.new(),
	}, self._origParent)
	r.HubBar.Parent = self._scroll

	for _, btn in ipairs(r.HubBar:GetChildren()) do
		if btn:IsA("TextButton") then
			self:_conn(btn.MouseButton1Click:Connect(function() self:Deselect() end))
		end
	end
	self:_conn(r.Shield:GetPropertyChangedSignal("Visible"):Connect(function()
		if not r.Shield.Visible then self:Deselect() end
	end))
	return self
end

function Library:_conn(c)
	table.insert(self._conns, c)
	return c
end

function Library:_setNativeSelection(visible)
	for _, btn in ipairs(self._r.HubBar:GetChildren()) do
		if btn:IsA("TextButton") and not btn:GetAttribute("CustomTab") then
			local sel = btn:FindFirstChild("TabSelection")
			if sel then sel.Visible = visible end
		end
	end
end

-- opts: Name, Width, Order
function Library:CreateTab(opts)
	opts = opts or {}
	local r = self._r

	local button = create("TextButton", {
		Name = (opts.Name or "Custom") .. "Tab", Size = UDim2.new(0, opts.Width or 140, 1, 0), BackgroundTransparency = 1,
		Text = opts.Name or "Custom", Font = Enum.Font.GothamBold, TextSize = 14,
	}, r.HubBar)
	button:SetAttribute("CustomTab", true)
	if r.HubBar:FindFirstChildOfClass("UIListLayout") then
		button.LayoutOrder = opts.Order or #r.HubBar:GetChildren()
	end

	local underline
	local ref = r.HubBar:FindFirstChild("ReportAbuseTab")
	local refSel = ref and ref:FindFirstChild("TabSelection")
	if refSel then
		underline = refSel:Clone()
		underline.Visible = false
		underline.Parent = button
	end

	local page = create("Frame", {
		Name = (opts.Name or "Custom") .. "Page", BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false,
	}, r.Page)
	local function sync()
		page.Size = UDim2.fromOffset(r.Clipper.AbsoluteSize.X, r.Clipper.AbsoluteSize.Y)
		page.Position = UDim2.fromOffset(
			r.Clipper.AbsolutePosition.X - r.Page.AbsolutePosition.X,
			r.Clipper.AbsolutePosition.Y - r.Page.AbsolutePosition.Y
		)
	end
	task.defer(sync)
	self:_conn(r.Clipper:GetPropertyChangedSignal("AbsoluteSize"):Connect(sync))
	self:_conn(r.Clipper:GetPropertyChangedSignal("AbsolutePosition"):Connect(sync))

	local content = create("ScrollingFrame", {
		Name = "Content", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 0, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
	}, page)
	create("UIPadding", {
		PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16), PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 16),
	}, content)
	create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, content)

	local tab = setmetatable({
		Name = opts.Name, Button = button, Page = page, Content = content, Underline = underline,
		_hub = self, _order = 0,
	}, Tab)
	reg(function() if self.Active ~= tab then button.TextColor3 = T().Muted end end)

	button.MouseButton1Click:Connect(function() self:Select(tab) end)
	table.insert(self._tabs, tab)
	return tab
end

function Library:Select(tab)
	for _, t in ipairs(self._tabs) do
		local active = (t == tab)
		t.Page.Visible = active
		t.Button.TextColor3 = active and T().Text or T().Muted
		if t.Underline then t.Underline.Visible = active end
	end
	self:_setNativeSelection(false)
	self._r.Clipper.Visible = false
	self.Active = tab
end

function Library:Deselect()
	if not self.Active then return end
	for _, t in ipairs(self._tabs) do
		t.Page.Visible = false
		t.Button.TextColor3 = T().Muted
		if t.Underline then t.Underline.Visible = false end
	end
	self:_setNativeSelection(true)
	self._r.Clipper.Visible = true
	self.Active = nil
end

