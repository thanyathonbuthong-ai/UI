	}, item)
	create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, item)

	local headRow = create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 1 }, item)
	create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, headRow)
	local ic = makeIcon(headRow, opts.Icon, 18)
	if ic then ic.LayoutOrder = 1 end
	local title = create("TextLabel", {
		Size = UDim2.new(1, ic and -54 or -28, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
		Text = opts.Title or "Notification", Font = Enum.Font.GothamBold, TextSize = 14, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 2,
	}, headRow)
	themed(title, { TextColor3 = "Text" })

	local function dismiss()
		if not item.Parent then return end
		tween(item, { GroupTransparency = 1 }, 0.2)
		task.delay(0.22, function() item:Destroy() end)
	end

	local close = create("TextButton", {
		Size = UDim2.fromOffset(20, 20), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1, Text = "✕", Font = Enum.Font.GothamBold, TextSize = 12, ZIndex = 5,
	}, item)
	close.Parent = headRow
	close.LayoutOrder = 3
	close.Size = UDim2.fromOffset(20, 20)
	themed(close, { TextColor3 = "Muted" })
	close.MouseButton1Click:Connect(dismiss)

	if opts.Content and opts.Content ~= "" then
		local body = create("TextLabel", {
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Text = opts.Content,
			Font = Enum.Font.Gotham, TextSize = 13, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 2,
		}, item)
		themed(body, { TextColor3 = "Muted" })
	end

	if opts.Buttons and #opts.Buttons > 0 then
		local row = create("Frame", { Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1, LayoutOrder = 3 }, item)
		create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, row)
		local n = #opts.Buttons
		for i, b in ipairs(opts.Buttons) do
			local pill = makePill(row, b.Title, b.Variant, function() safe(b.Callback); dismiss() end, 32)
			pill.Size = UDim2.new(1 / n, -(8 * (n - 1)) / n, 0, 32)
			pill.LayoutOrder = i
		end
	end

	if duration > 0 then
		local barBg = create("Frame", { Size = UDim2.new(1, 0, 0, 3), BorderSizePixel = 0, LayoutOrder = 4 }, item)
		corner(barBg, 2)
		themed(barBg, { BackgroundColor3 = "Off" })
		local barFill = create("Frame", { Size = UDim2.fromScale(1, 1), BorderSizePixel = 0 }, barBg)
		corner(barFill, 2)
		themed(barFill, { BackgroundColor3 = "Accent" })
		TweenService:Create(barFill, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.fromScale(0, 1) }):Play()
		task.delay(duration, dismiss)
	end

	tween(item, { GroupTransparency = 0 }, 0.25)
	return { Close = dismiss }
end

