	local card = create("CanvasGroup", {
		Size = UDim2.new(0, 330, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5), BorderSizePixel = 0, GroupTransparency = 1, ZIndex = 51,
	}, overlay)
	corner(card, R.Large)
	themed(card, { BackgroundColor3 = "Popup" })
	stroke(card, "Stroke", 0.85)
	local scale = create("UIScale", { Scale = 0.92 }, card)
	create("UIPadding", {
		PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 18), PaddingTop = UDim.new(0, 18), PaddingBottom = UDim.new(0, 18),
	}, card)
	create("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, card)

	local headRow = create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 1 }, card)
	create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, headRow)
	local ic = makeIcon(headRow, opts.Icon, 22)
	if ic then ic.LayoutOrder = 1 end
	local title = create("TextLabel", {
		Size = UDim2.new(1, ic and -30 or 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
		Text = opts.Title or "Dialog", Font = Enum.Font.GothamBold, TextSize = 17, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 2,
	}, headRow)
	themed(title, { TextColor3 = "Text" })

	if opts.Content and opts.Content ~= "" then
		local body = create("TextLabel", {
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Text = opts.Content,
			Font = Enum.Font.Gotham, TextSize = 13, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 2,
		}, card)
		themed(body, { TextColor3 = "Muted" })
	end

	local function close()
		if not overlay.Parent then return end
		tween(overlay, { BackgroundTransparency = 1 }, 0.15)
		tween(card, { GroupTransparency = 1 }, 0.15)
		task.delay(0.17, function() overlay:Destroy() end)
	end

	local buttons = opts.Buttons
	if not buttons or #buttons == 0 then buttons = { { Title = "OK", Variant = "Primary" } } end
	local row = create("Frame", { Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1, LayoutOrder = 3 }, card)
	create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, row)
	local n = #buttons
	for i, b in ipairs(buttons) do
		local pill = makePill(row, b.Title, b.Variant, function() safe(b.Callback); close() end, 36)
		pill.Size = UDim2.new(1 / n, -(8 * (n - 1)) / n, 0, 36)
		pill.LayoutOrder = i
	end

	tween(overlay, { BackgroundTransparency = 0.5 }, 0.2)
	tween(card, { GroupTransparency = 0 }, 0.2)
	tween(scale, { Scale = 1 }, 0.2)
	return { Close = close }
end

-- =========================
-- CONFIG (Flag)
-- =========================
local function hasFS()
	return type(writefile) == "function" and type(readfile) == "function" and type(isfolder) == "function" and type(makefolder) == "function"
end

function Library:_ensureFolder()
	if not hasFS() then return false end
	local path = ""
	for part in self.ConfigFolder:gmatch("[^/]+") do
		path = (path == "") and part or (path .. "/" .. part)
		if not isfolder(path) then pcall(makefolder, path) end
	end
	return true
end

function Library:SaveConfig(name)
	if not self:_ensureFolder() then return false end
	local data = {}
	for flag, el in pairs(self.Flags) do
		if el._save then data[flag] = el._save() end
	end
	local ok = pcall(function()
		writefile(self.ConfigFolder .. "/" .. name .. ".json", HttpService:JSONEncode(data))
	end)
	return ok
end

function Library:LoadConfig(name)
	if not self:_ensureFolder() then return false end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(self.ConfigFolder .. "/" .. name .. ".json"))
	end)
	if not ok or type(data) ~= "table" then return false end
	for flag, value in pairs(data) do
		local el = self.Flags[flag]
		if el and el._load then pcall(el._load, value) end
	end
	return true
end

function Library:DeleteConfig(name)
	if type(delfile) ~= "function" then return false end
	return (pcall(delfile, self.ConfigFolder .. "/" .. name .. ".json"))
end

function Library:ListConfigs()
	local out = {}
	if not self:_ensureFolder() or type(listfiles) ~= "function" then return out end
	local ok, files = pcall(listfiles, self.ConfigFolder)
	if not ok then return out end
	for _, f in ipairs(files) do
		local n = f:match("([^/\\]+)%.json$")
		if n then table.insert(out, n) end
	end
	table.sort(out)
	return out
end

function Library:Destroy()
	self:Deselect()
	for _, c in ipairs(self._conns) do pcall(function() c:Disconnect() end) end
	for _, t in ipairs(self._tabs) do
		t.Page:Destroy()
		t.Button:Destroy()
	end
	if self._gui then self._gui:Destroy() end
	self._r.HubBar.Parent = self._origParent
	self._scroll:Destroy()
	self.Flags = {}
end

return Library
