-- ---------- Image ----------
function Container:Image(opts)
	opts = opts or {}
	local ratio = 16 / 9
	if type(opts.AspectRatio) == "string" then
		local a, b = opts.AspectRatio:match("^(%d+%.?%d*):(%d+%.?%d*)$")
		if a and b and tonumber(b) > 0 then ratio = tonumber(a) / tonumber(b) end
	elseif type(opts.AspectRatio) == "number" then
		ratio = opts.AspectRatio
	end
	local image = opts.Image or ""
	if type(image) == "number" then image = "rbxassetid://" .. image end
	local img = create("ImageLabel", {
		Size = UDim2.new(1, 0, 0, 160), BackgroundTransparency = 0.6, BorderSizePixel = 0, Image = image,
		ScaleType = Enum.ScaleType.Crop, LayoutOrder = self:_next(),
	}, self.Content)
	themed(img, { BackgroundColor3 = "Field" })
	corner(img, opts.Radius or R.Large)
	local function fit()
		local w = img.AbsoluteSize.X
		if w > 0 then
			local hh = math.floor(w / ratio + 0.5)
			if img.Size.Y.Offset ~= hh then img.Size = UDim2.new(1, 0, 0, hh) end
		end
	end
	img:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	task.defer(fit)
	local obj = { Instance = img }
	function obj:SetImage(i) img.Image = type(i) == "number" and ("rbxassetid://" .. i) or i end
	function obj:Destroy() img:Destroy() end
	if self._relayout then self:_relayout() end
	return obj
end

-- ---------- Viewport ----------
function Container:Viewport(opts)
	opts = opts or {}
	local frame = create("Frame", { Size = UDim2.new(1, 0, 0, opts.Height or 200), BorderSizePixel = 0, LayoutOrder = self:_next() }, self.Content)
	corner(frame, R.Large)
	themed(frame, { BackgroundColor3 = "Field" })
	stroke(frame, "Stroke", 0.92)
	local vp = create("ViewportFrame", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Ambient = Color3.fromRGB(170, 170, 170),
		LightColor = Color3.new(1, 1, 1),
	}, frame)
	corner(vp, R.Large)
	local cam = opts.Camera or Instance.new("Camera")
	cam.Parent = vp
	vp.CurrentCamera = cam

	local yaw, pitch, dist, center = 0.6, 0.25, 10, Vector3.zero
	local obj = { Instance = frame, Viewport = vp, Camera = cam }

	local function update()
		cam.CFrame = CFrame.new(center) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(-pitch, 0, 0) * CFrame.new(0, 0, dist)
	end

	function obj:SetObject(o)
		if self.Object then self.Object:Destroy() end
		if not o then return end
		local ok, clone = pcall(function() return o:Clone() end)
		if not ok or not clone then return end
		clone.Parent = vp
		self.Object = clone
		local size = Vector3.new(4, 4, 4)
		center = Vector3.zero
		if clone:IsA("Model") then
			local cf, sz = clone:GetBoundingBox()
			center, size = cf.Position, sz
		elseif clone:IsA("BasePart") then
			center, size = clone.Position, clone.Size
		end
		dist = (size.Magnitude / 2) / math.tan(math.rad(cam.FieldOfView / 2)) * 1.15
		update()
	end

	local last
	if opts.Interactive then
		makeDrag(frame, self._hub, function(pos)
			if last then
				yaw = yaw - (pos.X - last.X) * 0.01
				pitch = math.clamp(pitch + (pos.Y - last.Y) * 0.01, -1.3, 1.3)
				update()
			end
			last = pos
		end, function() last = nil end)
	end

	function obj:Destroy() frame:Destroy() end
	obj:SetObject(opts.Object)
	update()
	if self._relayout then self:_relayout() end
	return obj
end

