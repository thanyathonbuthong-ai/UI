--[[
    SettingsTab UI Library
    สร้างแท็บใหม่ในเมนู Settings ของ Roblox พร้อม component สำเร็จรูป
    (ไม่มีระบบเลือกเซิร์ฟเวอร์ — เป็น UI ล้วน ๆ)

    local Library = loadstring(readfile("UILibrary.lua"))()
    local hub = Library.new()
    local tab = hub:CreateTab({ Name = "My Tab" })
    tab:AddSection("General")
    tab:AddToggle({ Text = "Enabled", Callback = function(v) end })
]]

local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Library = {}
Library.__index = Library

-- =========================
-- THEME
-- =========================
Library.Theme = {
	Surface = Color3.fromRGB(45, 45, 52),
	SurfaceTransparency = 0.4,
	Cooldown = Color3.fromRGB(60, 60, 70),
	Accent = Color3.fromRGB(60, 120, 255),
	Text = Color3.fromRGB(255, 255, 255),
	TextSoft = Color3.fromRGB(220, 220, 220),
	TextMuted = Color3.fromRGB(160, 160, 160),
	TabIdle = Color3.fromRGB(180, 180, 180),
	Off = Color3.fromRGB(80, 80, 92),
	FontBold = Enum.Font.GothamBold,
	FontSemi = Enum.Font.GothamSemibold,
	FontRegular = Enum.Font.Gotham,
	CornerLarge = 14,
	CornerMedium = 10,
	CornerSmall = 8,
}

local function T() return Library.Theme end

-- =========================
-- HELPERS
-- =========================
local function create(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do inst[k] = v end
	if parent then inst.Parent = parent end
	return inst
end

local function corner(parent, r)
	return create("UICorner", { CornerRadius = UDim.new(0, r) }, parent)
end

local function tween(inst, props, time)
	TweenService:Create(inst, TweenInfo.new(time or 0.15), props):Play()
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function resolveRoblox()
	local gui = CoreGui:WaitForChild("RobloxGui")
	local shield = gui:WaitForChild("SettingsClippingShield"):WaitForChild("SettingsShield")
	local page = shield:WaitForChild("MenuContainer"):WaitForChild("Page")
	return {
		Shield = shield,
		Page = page,
		HubBar = page:WaitForChild("HubBar"):WaitForChild("TabHeaderContainer"):WaitForChild("HubBarContainer"),
		Clipper = page:WaitForChild("PageViewClipper"),
	}
end

-- =========================
-- BUTTON (ใช้ทั้งใน Row และเต็มความกว้าง)
-- =========================
local Button = {}
Button.__index = Button

local function newButton(parent, opts)
	local theme = T()
	local inst = create("TextButton", {
		Size = opts.FullWidth and UDim2.new(1, 0, 0, opts.Height or 40)
			or UDim2.new(0, opts.Width or 110, 0, opts.Height or 36),
		BackgroundColor3 = opts.Color or theme.Surface,
		BackgroundTransparency = opts.Transparency or theme.SurfaceTransparency,
		Text = opts.Text or "Button",
		TextColor3 = theme.Text,
		Font = theme.FontBold,
		TextSize = opts.TextSize or 13,
		BorderSizePixel = 0,
		LayoutOrder = opts.Order or 0,
		AutoButtonColor = false,
	}, parent)
	corner(inst, opts.Corner or theme.CornerMedium)

	local self = setmetatable({
		Instance = inst,
		_text = opts.Text or "Button",
		_color = opts.Color or theme.Surface,
		_transparency = opts.Transparency or theme.SurfaceTransparency,
		_cooldownEnd = 0,
	}, Button)

	inst.MouseEnter:Connect(function()
		if not self:IsCooling() then tween(inst, { BackgroundTransparency = math.max(self._transparency - 0.2, 0) }) end
	end)
	inst.MouseLeave:Connect(function()
		if not self:IsCooling() then tween(inst, { BackgroundTransparency = self._transparency }) end
	end)
	if opts.Callback then
		inst.MouseButton1Click:Connect(function() opts.Callback(self) end)
	end
	return self
end

function Button:SetText(text)
	self._text = text
	if not self:IsCooling() then self.Instance.Text = text end
end

function Button:IsCooling()
	return tick() < self._cooldownEnd
end

-- restore: string | function | nil
function Button:StartCooldown(seconds, restore)
	if self:IsCooling() then return false end
	local inst = self.Instance
	self._cooldownEnd = tick() + seconds
	inst.BackgroundColor3 = T().Cooldown
	inst.BackgroundTransparency = 0
	inst.Text = seconds .. "s"
	if self._conn then self._conn:Disconnect() end
	self._conn = RunService.Heartbeat:Connect(function()
		local remaining = math.ceil(self._cooldownEnd - tick())
		if remaining <= 0 then
			local text = type(restore) == "function" and restore() or restore
			inst.Text = text or self._text
			self._text = inst.Text
			inst.BackgroundColor3 = self._color
			inst.BackgroundTransparency = self._transparency
			self._conn:Disconnect()
			self._conn = nil
		else
			inst.Text = remaining .. "s"
		end
	end)
	return true
end

function Button:Destroy()
	if self._conn then self._conn:Disconnect() end
	self.Instance:Destroy()
end

-- =========================
-- ROW (ปุ่มเรียงแนวนอน)
-- =========================
local Row = {}
Row.__index = Row

function Row:AddButton(opts)
	self._count += 1
	opts = opts or {}
	opts.Order = opts.Order or self._count
	opts.FullWidth = false
	return newButton(self.Instance, opts)
end

-- =========================
-- TAB
-- =========================
local Tab = {}
Tab.__index = Tab

function Tab:_next()
	self._order += 1
	return self._order
end

function Tab:_card(height)
	local theme = T()
	local card = create("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = theme.Surface,
		BackgroundTransparency = theme.SurfaceTransparency,
		BorderSizePixel = 0,
		LayoutOrder = self:_next(),
		ClipsDescendants = true,
	}, self.Content)
	corner(card, theme.CornerLarge)
	return card
end

function Tab:_title(card, text, width)
	return create("TextLabel", {
		Size = UDim2.new(1, -(width or 32), 0, 40),
		Position = UDim2.new(0, 16, 0, 0),
		BackgroundTransparency = 1,
		Text = text or "",
		TextColor3 = T().TextSoft,
		Font = T().FontSemi,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, card)
end

-- ---------- Section ----------
function Tab:AddSection(text)
	local label = create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundTransparency = 1,
		Text = string.upper(text or ""),
		TextColor3 = T().TextMuted,
		Font = T().FontBold,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = self:_next(),
	}, self.Content)
	return { Instance = label, SetText = function(_, t) label.Text = string.upper(t) end }
end

-- ---------- Banner ----------
function Tab:AddBanner(opts)
	opts = opts or {}
	local theme = T()
	local card = self:_card(64)

	local icon = create("ImageLabel", {
		Size = UDim2.new(0, 44, 0, 44),
		Position = UDim2.new(0, 12, 0.5, -22),
		BackgroundTransparency = 1,
		Image = opts.Icon or "rbxasset://textures/ui/GuiImagePlaceholder.png",
		Visible = opts.Icon ~= false,
	}, card)
	corner(icon, theme.CornerSmall)

	local left = (opts.Icon ~= false) and 68 or 16
	local title = create("TextLabel", {
		Size = UDim2.new(1, -(left + 100), 0, 24),
		Position = UDim2.new(0, left, 0, 10),
		BackgroundTransparency = 1,
		Text = opts.Title or "",
		TextColor3 = theme.Text,
		Font = theme.FontBold,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, card)
	local subtitle = create("TextLabel", {
		Size = UDim2.new(1, -(left + 100), 0, 18),
		Position = UDim2.new(0, left, 0, 36),
		BackgroundTransparency = 1,
		Text = opts.Subtitle or "",
		TextColor3 = theme.TextMuted,
		Font = theme.FontRegular,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, card)
	local stats = create("TextLabel", {
		Size = UDim2.new(0, 180, 1, 0),
		Position = UDim2.new(1, -190, 0, 0),
		BackgroundTransparency = 1,
		Text = opts.Stats or "",
		TextColor3 = theme.TextMuted,
		Font = theme.FontRegular,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, card)

	return {
		Instance = card,
		SetTitle = function(_, t) title.Text = t end,
		SetSubtitle = function(_, t) subtitle.Text = t end,
		SetStats = function(_, t) stats.Text = t end,
		SetIcon = function(_, i) icon.Image = i end,
	}
end

