-- resolve ธีม: เติม keys ที่ขาดด้วย fallback chain ตามหลัก Wind UI -------------
local function ResolveTheme(raw)
	local t = {}
	for k, v in pairs(raw) do t[k] = v end
	t.Primary    = t.Primary or t.Icon or H("#0091ff")
	t.Toggle     = t.Toggle or t.Button or t.Primary
	t.Slider     = t.Slider or t.Primary
	t.Dialog     = t.Dialog or t.Accent or t.Background
	t.Checkbox   = t.Checkbox or t.Primary
	t.Outline    = t.Outline or Shade(t.Background, 0.28)
	t.WindowBg    = t.Background
	t.DialogBg    = t.Dialog
	t.TextColor   = t.Text
	t.TextDim     = t.Placeholder
	t.ButtonBg    = t.Button
	t.ToggleOn    = t.Toggle
	t.SliderThumb = t.Slider
	t.ToggleOffBg = Shade(t.Background, 0.18)
	t.BallOff     = Shade(t.Background, 0.55)
	t.BarOff      = Shade(t.Background, 0.18)
	t.OptionNormal= Shade(t.Background, 0.22)
	t.OptionSelected = t.Button
	t.Red         = H("#e64646")
	local lum = t.Button.R * 0.299 + t.Button.G * 0.587 + t.Button.B * 0.114
	t.WhiteOnButton = lum < 0.5
	return t
end

