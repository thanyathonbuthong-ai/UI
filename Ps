			lbl3:SetAttribute("Role", "text")
			local keyBtn = Create("TextButton", {
				Size = UDim2.new(0, 70, 0, 14), Position = UDim2.new(1, -78, 0.5, -7),
				BackgroundColor3 = Theme.ButtonBg, BorderSizePixel = 0, Text = keyName(currentKey),
				Font = CurrentFontBold, TextSize = 10,
				TextColor3 = Theme.WhiteOnButton and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(20, 20, 20),
				AutoButtonColor = false, ZIndex = 202, Parent = row,
			})
			keyBtn:SetAttribute("Role", "buttonBg"); keyBtn:SetAttribute("Bold", true)
			local listening, conn = false, nil
			keyBtn.MouseButton1Click:Connect(function()
				if listening then return end
				listening = true; keyBtn.Text = "..."
				conn = UserInputService.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.Keyboard then
						currentKey = (input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Escape) and nil or input.KeyCode
						keyBtn.Text = keyName(currentKey)
						listening = false; conn:Disconnect()
						if o.Callback then task.delay(0, function() pcall(o.Callback, currentKey) end) end
					end
				end)
			end)
			return { Set = function(_, k) currentKey = k; keyBtn.Text = keyName(currentKey) end, Get = function() return currentKey end, Instance = row }
		end

		self.Tabs = self.Tabs or {}
		self.Tabs[name] = Tab
		return Tab
	end

	function self:Toggle() Main.Visible = not Main.Visible end
	function self:Show() Main.Visible = true end
	function self:Hide() Main.Visible = false end
	function self:Destroy() ScreenGui:Destroy() end

	return self
end

return Library
