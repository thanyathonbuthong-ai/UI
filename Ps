	-- ฟีเจอร์ #3: Set Theme (ต่อหน้าต่าง) ----------------------------------------
	function self:SetTheme(name)
		local t = Themes[name]
		if not t then warn("[SupremacyUI] Theme ไม่มี: " .. tostring(name)); return nil end
		CurrentThemeName = name; Theme = t
		ApplyThemeToGui(ScreenGui)
		for _, cb in ipairs(ThemeChangeCallbacks) do pcall(cb, name) end
		return t
	end

