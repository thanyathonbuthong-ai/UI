		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		task.delay(0.12, function()
			if self._dropIgnoreUntil and tick() < self._dropIgnoreUntil then return end
			local pos = input.Position
			local anyOpen = false
			for _, dd in pairs(self.OpenDropdowns) do if dd.Visible then anyOpen = true end end
			if not anyOpen then return end
			for _, dd in pairs(self.OpenDropdowns) do if PointInside(dd, pos.X, pos.Y) then return end end
			CloseAllDropdowns()
		end)
	end)

