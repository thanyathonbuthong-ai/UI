local function buildColorPicker(parent, o, order)
	local color = o.Default or Color3.fromRGB(244, 49, 32)
	local h, s, v = color:ToHSV()

	local holder = new("Frame", {
		Name = "ColorPicker",
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = order,
	}, parent)
	vlist(holder, 4)

	local row = makeRow(holder, 1, o.Name or "Color", 44)
	hover(row)
	local swatch = new("Frame", {
		Name = "Swatch",
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(28, 16),
		LayoutOrder = 2,
	}, row)
	corner(swatch, 4)
	stroke(swatch)

	local panel = new("Frame", {
		Name = "Panel",
		BackgroundColor3 = theme.SurfaceElement,
		BorderSizePixel = 0,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = 2,
		Visible = false,
	}, holder)
	corner(panel, theme.RadiusMd)
	stroke(panel)
	pad(panel, 8, 12, 10, 12)
	vlist(panel, 8)

	local tracks = {}
	local function makeLine(letter, ord)
		local line = new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 18),
			LayoutOrder = ord,
		}, panel)
		hlist(line, 8)
		local l = label(line, letter, "sub", 1)
		l.Size = UDim2.fromOffset(14, 18)
		local track = new("Frame", {
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
			Size = UDim2.new(1, -22, 1, 0),
			LayoutOrder = 2,
		}, line)
		corner(track, theme.RadiusSm)
		stroke(track)
		local grad = new("UIGradient", {}, track)
		local handle = new("Frame", {
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(4, 22),
			AnchorPoint = Vector2.new(0.5, 0.5),
			ZIndex = 3,
		}, track)
		corner(handle, 2)
		stroke(handle, BLACK, 1)
		return { track = track, grad = grad, handle = handle }
	end
	tracks.h = makeLine("H", 1)
	tracks.s = makeLine("S", 2)
	tracks.v = makeLine("V", 3)

	local hexBox = new("TextBox", {
		Name = "Hex",
		BackgroundColor3 = theme.SurfaceField,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 26),
		LayoutOrder = 4,
		TextColor3 = theme.TextPrimary,
		TextSize = 12,
		ClearTextOnFocus = false,
		PlaceholderText = "#RRGGBB",
		PlaceholderColor3 = theme.TextMuted,
	}, panel)
	setFont(hexBox, "mono", Enum.FontWeight.Medium)
	corner(hexBox, theme.RadiusSm)
	stroke(hexBox)

	local hueSeq = {}
	for i = 0, 6 do
		hueSeq[#hueSeq + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 1, 1))
	end

	local function render(skipHex)
		color = Color3.fromHSV(h, s, v)
		swatch.BackgroundColor3 = color
		tracks.h.grad.Color = ColorSequence.new(hueSeq)
		tracks.s.grad.Color = ColorSequence.new(WHITE, Color3.fromHSV(h, 1, 1))
		tracks.v.grad.Color = ColorSequence.new(BLACK, Color3.fromHSV(h, s, 1))
		tracks.h.handle.Position = UDim2.new(h, 0, 0.5, 0)
		tracks.s.handle.Position = UDim2.new(s, 0, 0.5, 0)
		tracks.v.handle.Position = UDim2.new(v, 0, 0.5, 0)
		if not skipHex then
			hexBox.Text = "#" .. colorToHex(color)
		end
	end
	render()

	dragTrack(tracks.h.track, function(r)
		h = math.min(r, 0.999)
		render()
		fire(o, color)
	end)
	dragTrack(tracks.s.track, function(r)
		s = r
		render()
		fire(o, color)
	end)
	dragTrack(tracks.v.track, function(r)
		v = r
		render()
		fire(o, color)
	end)
	hexBox.FocusLost:Connect(function()
		local hex = hexBox.Text:gsub("[^%x]", "")
		if #hex == 6 then
			local r = tonumber(hex:sub(1, 2), 16)
			local g = tonumber(hex:sub(3, 4), 16)
			local b = tonumber(hex:sub(5, 6), 16)
			h, s, v = Color3.fromRGB(r, g, b):ToHSV()
			render()
			fire(o, color)
		else
			render()
		end
	end)

	local open = false
	onPress(row, function()
		open = not open
		panel.Visible = open
	end)
	tip(row, o.Tooltip)
	setFlag(o, color)

	local obj = { Frame = holder }
	function obj:Get()
		return color
	end
	function obj:Set(c, silent)
		h, s, v = c:ToHSV()
		render()
		if silent then
			setFlag(o, color)
		else
			fire(o, color)
		end
	end
	return obj
end

