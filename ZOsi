local function buildToggle(parent, o, order)
	local state = o.Default and true or false
	local row = makeRow(parent, order, o.Name or "Toggle", 46)
	hover(row)

	local track = new("Frame", {
		Name = "Track",
		BackgroundColor3 = theme.SurfaceField,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(38, 20),
		LayoutOrder = 2,
	}, row)
	corner(track, 10)
	local trackStroke = stroke(track)
	local grad = accentGradient(track, 0)
	grad.Enabled = false
	local knob = new("Frame", {
		Name = "Knob",
		BackgroundColor3 = theme.TextMuted,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(14, 14),
		Position = UDim2.fromOffset(2, 3),
		ZIndex = 2,
	}, track)
	corner(knob, 7)

	local first = true
	local function render()
		grad.Enabled = state
		track.BackgroundColor3 = state and WHITE or theme.SurfaceField
		trackStroke.Transparency = state and 1 or 0
		knob.BackgroundColor3 = state and theme.TextOnAccent or theme.TextMuted
		local pos = UDim2.fromOffset(state and 22 or 2, 3)
		if first then
			knob.Position = pos
		else
			TweenService:Create(knob, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				Position = pos,
			}):Play()
		end
		first = false
	end
	render()

	onPress(row, function()
		state = not state
		render()
		fire(o, state)
	end)
	tip(row, o.Tooltip)
	setFlag(o, state)

	local obj = { Frame = row }
	function obj:Get()
		return state
	end
	function obj:Set(v, silent)
		v = v and true or false
		if v == state then
			return
		end
		state = v
		render()
		if not silent then
			fire(o, state)
		else
			setFlag(o, state)
		end
	end
	return obj
end

local function buildSlider(parent, o, order)
	local min, max, step = o.Min or 0, o.Max or 100, o.Step or 1
	local dec = decimalsOf(step)
	local suffix = o.Suffix or ""

	local function snap(v)
		v = math.clamp(v, min, max)
		v = math.floor((v - min) / step + 0.5) * step + min
		v = tonumber(string.format("%." .. dec .. "f", v))
		return math.clamp(v, min, max)
	end
	local function fmt(v)
		return string.format("%." .. dec .. "f", v) .. suffix
	end

	local value = snap(o.Default or min)
	local holder = makeCard(parent, "Slider", order)

	local head = new("Frame", {
		Name = "Head",
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = 1,
	}, holder)
	vlist(head, 1)
	label(head, o.Name or "Slider", "row", 1).Size = UDim2.new(1, 0, 0, 18)
	if o.Description and o.Description ~= "" then
		label(head, o.Description, "caption", 2).Size = UDim2.new(1, 0, 0, 12)
	end

	local track = new("Frame", {
		Name = "Track",
		BackgroundColor3 = theme.SurfaceField,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 18),
		ClipsDescendants = true,
		LayoutOrder = 2,
	}, holder)
	corner(track, theme.RadiusSm)
	stroke(track)
	local fill = new("Frame", {
		Name = "Fill",
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
	}, track)
	corner(fill, theme.RadiusSm)
	accentGradient(fill, 0)

	local valueLabel = label(fill, "", "mono", 1)
	valueLabel.Name = "Value"
	valueLabel.Size = UDim2.new(1, -8, 1, 0)
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right
	valueLabel.ZIndex = 3

	local function render()
		local r = (max == min) and 0 or (value - min) / (max - min)
		fill.Size = UDim2.fromScale(r, 1)
		valueLabel.Text = fmt(value)
		if r < 0.22 then
			valueLabel.Parent = track
			valueLabel.TextColor3 = theme.TextPrimary
		else
			valueLabel.Parent = fill
			valueLabel.TextColor3 = theme.TextOnAccent
		end
	end
	render()

	local function apply(v, silent)
		v = snap(v)
		if v == value then
			return
		end
		value = v
		render()
		if silent then
			setFlag(o, value)
		else
			fire(o, value)
		end
	end
	dragTrack(track, function(r)
		apply(min + (max - min) * r)
	end)
	tip(holder, o.Tooltip)
	setFlag(o, value)

	local obj = { Frame = holder }
	function obj:Get()
		return value
	end
	function obj:Set(v, silent)
		apply(v, silent)
	end
	return obj
end

local function buildRangeSlider(parent, o, order)
	local min, max, step = o.Min or 0, o.Max or 100, o.Step or 1
	local dec = decimalsOf(step)

	local function snap(v)
		v = math.clamp(v, min, max)
		v = math.floor((v - min) / step + 0.5) * step + min
		v = tonumber(string.format("%." .. dec .. "f", v))
		return math.clamp(v, min, max)
	end
	local function fmt(v)
		return string.format("%." .. dec .. "f", v)
	end

	local lo = snap(o.DefaultMin or min)
	local hi = snap(o.DefaultMax or max)
	if lo > hi then
		lo, hi = hi, lo
	end

	local holder = makeCard(parent, "RangeSlider", order)
	local head = new("Frame", {
		Name = "Head",
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = 1,
	}, holder)
	vlist(head, 1)
	label(head, o.Name or "Range", "row", 1).Size = UDim2.new(1, 0, 0, 18)
	if o.Description and o.Description ~= "" then
		label(head, o.Description, "caption", 2).Size = UDim2.new(1, 0, 0, 12)
	end

	local track = new("Frame", {
		Name = "Track",
		BackgroundColor3 = theme.SurfaceField,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 18),
		LayoutOrder = 2,
	}, holder)
	corner(track, theme.RadiusSm)
	stroke(track)

	local fill = new("Frame", {
		Name = "Fill",
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
	}, track)
	accentGradient(fill, 0)

	local function makeHandle()
		local h = new("Frame", {
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(6, 22),
			ZIndex = 3,
		}, track)
		corner(h, 3)
		stroke(h, BLACK, 1)
		return h
	end
	local hLo, hHi = makeHandle(), makeHandle()

	local text = label(track, "", "monoMeta", 1)
	text.Size = UDim2.new(1, 0, 1, 0)
	text.TextXAlignment = Enum.TextXAlignment.Center
	text.TextColor3 = theme.TextPrimary
	text.ZIndex = 2

	local function render()
		local span = (max == min) and 1 or (max - min)
		local rLo, rHi = (lo - min) / span, (hi - min) / span
		fill.Position = UDim2.fromScale(rLo, 0)
		fill.Size = UDim2.fromScale(math.max(rHi - rLo, 0), 1)
		hLo.AnchorPoint = Vector2.new(rLo, 0.5)
		hLo.Position = UDim2.new(rLo, 0, 0.5, 0)
		hHi.AnchorPoint = Vector2.new(rHi, 0.5)
		hHi.Position = UDim2.new(rHi, 0, 0.5, 0)
		text.Text = fmt(lo) .. "  –  " .. fmt(hi)
	end
	render()

	local active = "lo"
	dragTrack(track, function(r)
		local v = snap(min + (max - min) * r)
		local oldLo, oldHi = lo, hi
		if active == "lo" then
			lo = math.min(v, hi)
		else
			hi = math.max(v, lo)
		end
		if lo ~= oldLo or hi ~= oldHi then
			render()
			if o.Flag then
				UILib.Flags[o.Flag] = { lo, hi }
			end
			if o.Callback then
				local ok, err = pcall(o.Callback, lo, hi)
				if not ok then
					warn("[UILib] callback error: " .. tostring(err))
				end
			end
		end
	end, function(r)
		local v = min + (max - min) * r
		active = (math.abs(v - lo) <= math.abs(v - hi)) and "lo" or "hi"
		if lo == hi then
			active = (v < lo) and "lo" or "hi"
		end
	end)
	tip(holder, o.Tooltip)
	if o.Flag then
		UILib.Flags[o.Flag] = { lo, hi }
	end

	local obj = { Frame = holder }
	function obj:Get()
		return lo, hi
	end
	function obj:Set(a, b)
		lo, hi = snap(a), snap(b)
		if lo > hi then
			lo, hi = hi, lo
		end
		render()
	end
	return obj
end

local function buildDropdown(parent, o, order)
	local multi = o.Multi and true or false
	local options = o.Options or {}
	local selected = {} -- multi
	local single = nil -- single
	if multi then
		for _, v in ipairs(o.Default or {}) do
			selected[v] = true
		end
	else
		single = o.Default
	end

	local holder = new("Frame", {
		Name = "Dropdown",
		BackgroundColor3 = theme.SurfaceElement,
		BorderSizePixel = 0,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = order,
	}, parent)
	corner(holder, theme.RadiusMd)
	stroke(holder)
	vlist(holder, 0)

	local head = new("Frame", {
		Name = "Head",
		BackgroundColor3 = theme.SurfaceElement,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, theme.RowH),
		LayoutOrder = 1,
	}, holder)
	corner(head, theme.RadiusMd)
	pad(head, 0, theme.GapLg, 0, theme.GapLg)
	hlist(head, theme.GapMd)
	hover(head)

	local nameLbl = label(head, o.Name or "Dropdown", "row", 1)
	nameLbl.Size = UDim2.new(0.5, 0, 1, 0)
	nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
	local valueLbl = label(head, "", "sub", 2)
	valueLbl.Size = UDim2.new(0.5, -40, 1, 0)
	valueLbl.TextXAlignment = Enum.TextXAlignment.Right
	valueLbl.TextTruncate = Enum.TextTruncate.AtEnd
	local chev = chevron(head)

	local list = new("Frame", {
		Name = "List",
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = 2,
		Visible = false,
	}, holder)
	pad(list, 0, 6, 6, 6)
	vlist(list, 3)

	local buttons = {}

	local function isSelected(opt)
		if multi then
			return selected[opt] == true
		end
		return single == opt
	end
	local function currentValue()
		if multi then
			local t = {}
			for _, opt in ipairs(options) do
				if selected[opt] then
					t[#t + 1] = opt
				end
			end
			return t
		end
		return single
	end
	local function valueText()
		if multi then
			local t = currentValue()
			if #t == 0 then
				return "None"
			elseif #t > 2 then
				return #t .. " selected"
			end
			local names = {}
			for i, v in ipairs(t) do
				names[i] = tostring(v)
			end
			return table.concat(names, ", ")
		end
		return single ~= nil and tostring(single) or (o.Placeholder or "Select")
	end
	local function refreshColors()
		for opt, b in pairs(buttons) do
			b.TextColor3 = isSelected(opt) and theme.AccentMid or theme.TextPrimary
		end
		valueLbl.Text = valueText()
	end

	local open = false
	local function setOpen(v)
		open = v
		list.Visible = v
		chev.SetOpen(v)
		nameLbl.TextColor3 = v and theme.AccentMid or theme.TextPrimary
	end

	local function choose(opt)
		if multi then
			selected[opt] = not selected[opt] or nil
		else
			single = opt
			setOpen(false)
		end
		refreshColors()
		fire(o, currentValue())
	end

	local function rebuild()
		for _, c in ipairs(list:GetChildren()) do
			if c:IsA("TextButton") then
				c:Destroy()
			end
		end
		buttons = {}
		for i, opt in ipairs(options) do
			local b = new("TextButton", {
				Name = "Option",
				AutoButtonColor = false,
				BackgroundColor3 = theme.SurfaceField,
				BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, 28),
				Text = tostring(opt),
				TextSize = 12,
				LayoutOrder = i,
			}, list)
			setFont(b, "sans", Enum.FontWeight.Medium)
			corner(b, theme.RadiusSm)
			hover(b)
			b.MouseButton1Click:Connect(function()
				choose(opt)
			end)
			buttons[opt] = b
		end
		refreshColors()
	end
	rebuild()

	onPress(head, function()
		setOpen(not open)
	end)
	tip(head, o.Tooltip)
	setFlag(o, currentValue())

	local obj = { Frame = holder }
	function obj:Get()
		return currentValue()
	end
	function obj:Set(v, silent)
		if multi then
			selected = {}
			for _, x in ipairs(v or {}) do
				selected[x] = true
			end
		else
			single = v
		end
		refreshColors()
		if silent then
			setFlag(o, currentValue())
		else
			fire(o, currentValue())
		end
	end
	function obj:Refresh(newOptions)
		options = newOptions or {}
		rebuild()
	end
	return obj
end

local function buildTextInput(parent, o, order)
