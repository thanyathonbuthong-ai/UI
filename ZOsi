----------------------------------------------------------------------
-- Instance helpers
----------------------------------------------------------------------
local function new(class, props, parent)
	local obj = Instance.new(class)
	if props then
		for k, v in pairs(props) do
			obj[k] = v
		end
	end
	if parent then
		obj.Parent = parent
	end
	return obj
end

local function corner(parent, radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

local function stroke(parent, color, thickness)
	return new("UIStroke", {
		Color = color or theme.Hairline,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

local function pad(parent, top, right, bottom, left)
	return new("UIPadding", {
		PaddingTop = UDim.new(0, top),
		PaddingRight = UDim.new(0, right),
		PaddingBottom = UDim.new(0, bottom),
		PaddingLeft = UDim.new(0, left),
	}, parent)
end

local function vlist(parent, gap)
	return new("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap or theme.GapSm),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, parent)
end

local function hlist(parent, gap)
	return new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Padding = UDim.new(0, gap or theme.GapMd),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, parent)
end

local function label(parent, text, styleName, order)
	local st = STYLES[styleName] or STYLES.row
	local lbl = new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text or "",
		TextColor3 = theme[st[4]],
		TextSize = st[3],
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		LayoutOrder = order or 1,
		Size = UDim2.new(1, 0, 1, 0),
	}, parent)
	setFont(lbl, st[1], st[2])
	return lbl
end

local function caption(parent, text, order)
	local lbl = label(parent, text, "caption", order)
	lbl.AutomaticSize = Enum.AutomaticSize.Y
	lbl.Size = UDim2.new(1, 0, 0, 0)
	lbl.TextWrapped = true
	lbl.TextYAlignment = Enum.TextYAlignment.Top
	return lbl
end

local function icon(parent, name, size, color, z)
	return new("ImageLabel", {
		Name = "Icon_" .. tostring(name),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Image = "rbxassetid://" .. tostring(ICONS[name] or ICONS.info),
		ImageColor3 = color or theme.TextSub,
		ScaleType = Enum.ScaleType.Fit,
		Size = UDim2.fromOffset(size or 16, size or 16),
		ZIndex = z or 1,
	}, parent)
end

local function chevron(parent)
	local holder = new("Frame", {
		Name = "Chevron",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(16, 16),
		LayoutOrder = 99,
	}, parent)
	local img = icon(holder, "chevron-down", 16, theme.TextSub)
	img.AnchorPoint = Vector2.new(0.5, 0.5)
	img.Position = UDim2.fromScale(0.5, 0.5)
	return {
		Frame = holder,
		SetOpen = function(open)
			img.Rotation = open and 180 or 0
			img.ImageColor3 = open and theme.AccentMid or theme.TextSub
		end,
	}
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
end

local function onPress(obj, fn)
	obj.Active = true
	obj.InputBegan:Connect(function(input)
		if isPress(input) then
			fn(input)
		end
	end)
end

local function hover(frame)
	local base = frame.BackgroundColor3
	frame.MouseEnter:Connect(function()
		TweenService:Create(frame, TweenInfo.new(0.14, Enum.EasingStyle.Quint), {
			BackgroundColor3 = theme.SurfaceHover,
		}):Play()
	end)
	frame.MouseLeave:Connect(function()
		TweenService:Create(frame, TweenInfo.new(0.2, Enum.EasingStyle.Quint), {
			BackgroundColor3 = base,
		}):Play()
	end)
end

local function accentGradient(parent, rotation)
	return new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, theme.AccentA),
			ColorSequenceKeypoint.new(0.53, theme.AccentMid),
			ColorSequenceKeypoint.new(1, theme.AccentB),
		}),
		Rotation = rotation or 0,
	}, parent)
end

-- แถบ accent ที่เลื่อนวนซ้ำ
local function accentSweep(band)
	band.ClipsDescendants = true
	local sweep = new("Frame", {
		Name = "Sweep",
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Size = UDim2.new(2, 0, 1, 0),
		Position = UDim2.new(-1, 0, 0, 0),
	}, band)
	new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, theme.AccentA),
			ColorSequenceKeypoint.new(0.125, theme.AccentMid),
			ColorSequenceKeypoint.new(0.25, theme.AccentB),
			ColorSequenceKeypoint.new(0.375, theme.AccentMid),
			ColorSequenceKeypoint.new(0.5, theme.AccentA),
			ColorSequenceKeypoint.new(0.625, theme.AccentMid),
			ColorSequenceKeypoint.new(0.75, theme.AccentB),
			ColorSequenceKeypoint.new(0.875, theme.AccentMid),
			ColorSequenceKeypoint.new(1, theme.AccentA),
		}),
	}, sweep)
	sweeps[#sweeps + 1] = sweep
	if not sweepConn then
		sweepConn = keep(RunService.RenderStepped:Connect(function()
			local t = os.clock() * theme.SweepSpeed % 1
			local pos = UDim2.new(t - 1, 0, 0, 0)
			for i = #sweeps, 1, -1 do
				local s = sweeps[i]
				if s.Parent then
					s.Position = pos
				else
					table.remove(sweeps, i)
				end
			end
		end))
	end
	return sweep
end

local function bodyGradient(parent)
	return new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, theme.BodyTop),
			ColorSequenceKeypoint.new(0.45, theme.BodyMid),
			ColorSequenceKeypoint.new(1, theme.BodyBot),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, theme.BodyTopA),
			NumberSequenceKeypoint.new(0.45, theme.BodyMidA),
			NumberSequenceKeypoint.new(1, theme.BodyBotA),
		}),
		Rotation = 90,
	}, parent)
end

-- เงานุ่ม ๆ ใต้หน้าต่าง (เป็น sibling ของ frame)
local function shadow(frame, z)
	local holder = new("Frame", {
		Name = "Shadow",
		BackgroundTransparency = 1,
		ZIndex = z - 1,
	}, frame.Parent)
	local function sync()
		holder.Position = frame.Position
		holder.Size = frame.Size
		holder.AnchorPoint = frame.AnchorPoint
		holder.Visible = frame.Visible
	end
	sync()
	for _, prop in ipairs({ "Position", "Size", "AnchorPoint", "Visible" }) do
		frame:GetPropertyChangedSignal(prop):Connect(sync)
	end
	frame.AncestryChanged:Connect(function()
		if not frame.Parent then
			holder:Destroy()
		end
	end)
	local layers = 8
	for i = 1, layers do
		local grow = i * 1.5
		local layer = new("Frame", {
			Name = "L" .. i,
			BackgroundColor3 = BLACK,
			BackgroundTransparency = 1 - 0.04,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(-grow, -grow + 10 * (i / layers)),
			Size = UDim2.new(1, grow * 2, 1, grow * 2),
		}, holder)
		corner(layer, theme.RadiusLg + grow)
	end
	return holder
end

----------------------------------------------------------------------
-- Tooltip
----------------------------------------------------------------------
local function buildTooltip()
	tipFrame = new("Frame", {
		Name = "Tooltip",
		BackgroundColor3 = Color3.fromHex("3a3a42"),
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 1000,
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.fromOffset(0, 0),
	}, gui)
	corner(tipFrame, theme.RadiusSm)
	stroke(tipFrame, Color3.fromHex("4a4a55"), 1)
	pad(tipFrame, 6, 8, 6, 8)
	tipLabel = new("TextLabel", {
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.fromOffset(0, 0),
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = Color3.fromHex("e8e8ee"),
		TextSize = 11,
	}, tipFrame)
	setFont(tipLabel, "sans", Enum.FontWeight.Medium)
	new("UISizeConstraint", { MaxSize = Vector2.new(240, math.huge) }, tipLabel)

	keep(RunService.RenderStepped:Connect(function()
		if not tipTarget then
			return
		end
		if not tipFrame.Visible then
			if os.clock() < tipShowAt then
				return
			end
			tipFrame.Visible = true
		end
		local m = UIS:GetMouseLocation()
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
		local w, h = tipFrame.AbsoluteSize.X, tipFrame.AbsoluteSize.Y
		local x = (m.X + 16 + w > vp.X) and (m.X - 16 - w) or (m.X + 16)
		local y = (m.Y + 18 + h > vp.Y) and (m.Y - 12 - h) or (m.Y + 18)
		tipFrame.Position = UDim2.fromOffset(x, y)
	end))
end

local function hideTip()
	tipTarget = nil
	if tipFrame then
		tipFrame.Visible = false
	end
end

local function tip(target, text)
	if not text or text == "" then
		return
	end
	target.MouseEnter:Connect(function()
		if not tipFrame then
			return
		end
		tipTarget = target
		tipShowAt = os.clock() + 0.45
		tipFrame.Visible = false
		tipLabel.Text = text
	end)
	target.MouseLeave:Connect(function()
		if tipTarget == target then
			hideTip()
		end
	end)
	target.AncestryChanged:Connect(function()
		if not target:IsDescendantOf(game) and tipTarget == target then
			hideTip()
		end
	end)
end

----------------------------------------------------------------------
-- Shared element helpers
----------------------------------------------------------------------
local function fire(opts, value)
	if opts.Flag then
		UILib.Flags[opts.Flag] = value
	end
	if opts.Callback then
		local ok, err = pcall(opts.Callback, value)
		if not ok then
			warn("[UILib] callback error: " .. tostring(err))
		end
	end
end

local function setFlag(opts, value)
	if opts.Flag then
		UILib.Flags[opts.Flag] = value
	end
end

local function makeRow(parent, order, text, reserve, height)
	local row = new("Frame", {
		Name = "Row",
		BackgroundColor3 = theme.SurfaceElement,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, height or theme.RowH),
		LayoutOrder = order,
	}, parent)
	corner(row, theme.RadiusMd)
	stroke(row)
	pad(row, 0, theme.GapLg, 0, theme.GapLg)
	hlist(row, theme.GapMd)
	local lbl = label(row, text, "row", 1)
	lbl.TextTruncate = Enum.TextTruncate.AtEnd
	lbl.Size = UDim2.new(1, -(reserve or 24), 1, 0)
	return row, lbl
end

local function makeCard(parent, name, order)
	local card = new("Frame", {
		Name = name,
		BackgroundColor3 = theme.SurfaceElement,
		BorderSizePixel = 0,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = order,
	}, parent)
	corner(card, theme.RadiusMd)
	stroke(card)
	pad(card, 7, 12, 9, 12)
	vlist(card, theme.GapSm)
	return card
end

local function decimalsOf(step)
	local frac = tostring(step):match("%.(%d+)$")
	return frac and #frac or 0
end

-- ลากบน track เพื่อเลือกค่า (รองรับเมาส์และทัช)
local function dragTrack(track, onRatio, onBegin)
	local dragging = false
	local function update(x)
		local w = track.AbsoluteSize.X
		if w <= 0 then
			return
		end
		onRatio(math.clamp((x - track.AbsolutePosition.X) / w, 0, 1))
	end
	track.Active = true
	track.InputBegan:Connect(function(input)
		if isPress(input) then
			dragging = true
			local r = math.clamp((input.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
			if onBegin then
				onBegin(r)
			end
			update(input.Position.X)
		end
	end)
	keep(UIS.InputChanged:Connect(function(input)
		if dragging and isMove(input) then
			update(input.Position.X)
		end
	end))
	keep(UIS.InputEnded:Connect(function(input)
		if isPress(input) then
			dragging = false
		end
	end))
end

local function colorToHex(c)
	return string.format(
		"%02X%02X%02X",
		math.floor(c.R * 255 + 0.5),
		math.floor(c.G * 255 + 0.5),
		math.floor(c.B * 255 + 0.5)
	)
end

