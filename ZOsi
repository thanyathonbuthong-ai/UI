local Container = {}

function Container:_next()
	self._n = (self._n or 0) + 1
	return self._n
end

function Container:AddToggle(o)
	return buildToggle(self._content, o or {}, self:_next())
end
function Container:AddSlider(o)
	return buildSlider(self._content, o or {}, self:_next())
end
function Container:AddRangeSlider(o)
	return buildRangeSlider(self._content, o or {}, self:_next())
end
function Container:AddDropdown(o)
	return buildDropdown(self._content, o or {}, self:_next())
end
function Container:AddTextInput(o)
	return buildTextInput(self._content, o or {}, self:_next())
end
function Container:AddButton(o)
	return buildButton(self._content, o or {}, self:_next())
end
function Container:AddColorPicker(o)
	return buildColorPicker(self._content, o or {}, self:_next())
end
function Container:AddLabel(o)
	return buildLabel(self._content, o or "", self:_next())
end

local function buildSection(parent, o, order)
	local frame = new("Frame", {
		Name = "Section",
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = order,
	}, parent)
	vlist(frame, 4)

	local head = new("Frame", {
		Name = "Head",
		BackgroundColor3 = theme.SurfaceSection,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, theme.RowH),
		LayoutOrder = 1,
	}, frame)
	corner(head, theme.RadiusMd)
	stroke(head)
	pad(head, 0, theme.GapLg, 0, theme.GapLg)
	hlist(head, theme.GapMd)
	hover(head)

	local title = label(head, o.Title or "Section", "row", 1)
	title.Size = UDim2.new(1, -24, 1, 0)
	title.TextTruncate = Enum.TextTruncate.AtEnd
	local chev = chevron(head)

	local content = new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = 2,
		Visible = false,
	}, frame)
	vlist(content, theme.GapSm)
	pad(content, 2, 0, 4, 0)

	if o.Description and o.Description ~= "" then
		local d = caption(content, o.Description, -1000)
		d.Name = "Description"
		d.TextSize = 11
		pad(d, 2, 4, 2, 4)
	end

	local sec = setmetatable({ Frame = frame, _content = content }, { __index = Container })
	local open = false
	local function setOpen(v)
		open = v and true or false
		content.Visible = open
		chev.SetOpen(open)
		title.TextColor3 = open and theme.AccentMid or theme.TextPrimary
	end
	setOpen(o.Open == true)

	onPress(head, function()
		setOpen(not open)
	end)
	tip(head, o.Tooltip)

	function sec:Open()
		setOpen(true)
	end
	function sec:Close()
		setOpen(false)
	end
	function sec:Toggle()
		setOpen(not open)
	end
	function sec:IsOpen()
		return open
	end
	function sec:SetTitle(t)
		title.Text = t
	end
	return sec
end

function Container:AddSection(o)
	return buildSection(self._content, o or {}, self:_next())
end

