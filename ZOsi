local function makeDraggable(handle, frame)
	local dragging, startMouse, startPos = false, nil, nil
	handle.InputBegan:Connect(function(input)
		if isPress(input) then
			dragging = true
			startMouse = Vector2.new(input.Position.X, input.Position.Y)
			startPos = frame.Position
		end
	end)
	keep(UIS.InputChanged:Connect(function(input)
		if dragging and isMove(input) then
			local d = Vector2.new(input.Position.X, input.Position.Y) - startMouse
			frame.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + d.X,
				startPos.Y.Scale,
				startPos.Y.Offset + d.Y
			)
		end
	end))
	keep(UIS.InputEnded:Connect(function(input)
		if isPress(input) then
			dragging = false
		end
	end))
end

function UILib:CreateWindow(o)
	o = o or {}
	self:Init()

	zCounter = zCounter + 2
	local width, height = o.Width or 310, o.Height or 460
	local offset = 30 * #windows

	local frame = new("Frame", {
		Name = o.Name or "Window",
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(width, height),
		Position = o.Position or UDim2.fromOffset(40 + offset, 40 + offset),
		Active = true,
		ClipsDescendants = true,
		ZIndex = zCounter,
	}, gui)
	corner(frame, theme.RadiusLg)
	stroke(frame)
	bodyGradient(frame)
	local shadowHolder = shadow(frame, zCounter)

	local win = setmetatable({ Frame = frame, _shadow = shadowHolder, _pinned = false, _hidden = false }, {
		__index = Container,
	})

	local function raise()
		zCounter = zCounter + 2
		frame.ZIndex = zCounter
		shadowHolder.ZIndex = zCounter - 1
	end
	frame.InputBegan:Connect(function(input)
		if isPress(input) and frame.ZIndex < zCounter then
			raise()
		end
	end)

	-- Header
	local header = new("Frame", {
		Name = "Header",
		BackgroundColor3 = theme.SurfaceHeader,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, theme.HeaderH),
		Position = UDim2.fromOffset(0, 3),
		Active = true,
		ZIndex = 3,
	}, frame)
	corner(header, theme.RadiusLg)
	pad(header, 0, 12, 0, 14)
	new("Frame", {
		Name = "HeaderFill",
		BackgroundColor3 = theme.SurfaceHeader,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, theme.HeaderH + 3 - theme.RadiusLg),
		Size = UDim2.new(1, 0, 0, theme.RadiusLg),
		ZIndex = 3,
	}, frame)

	local accentBar = new("CanvasGroup", {
		Name = "AccentBar",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, theme.RadiusLg + 3),
		ZIndex = 4,
	}, frame)
	corner(accentBar, theme.RadiusLg)
	local band = new("Frame", {
		Name = "Band",
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 3),
		ZIndex = 4,
	}, accentBar)
	accentSweep(band)

	hlist(header, theme.GapLg)
	makeDraggable(header, frame)

	local mark
	if o.Icon and ICONS[o.Icon] then
		mark = icon(header, o.Icon, 16, WHITE, 4)
	else
		mark = new("Frame", {
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(14, 14),
			ZIndex = 4,
		}, header)
		corner(mark, 4)
	end
	mark.Name = "Icon"
	mark.LayoutOrder = 1
	accentGradient(mark, 45)

	local title = label(header, o.Title or "Window", "title", 2)
	title.ZIndex = 4
	title.Size = UDim2.new(1, -(58 + (o.Info and 32 or 0)), 1, 0)
	title.TextTruncate = Enum.TextTruncate.AtEnd

	-- Pin
	local pin = new("TextButton", {
		Name = "Pin",
		BackgroundColor3 = theme.SurfaceElement,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(20, 20),
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = 3,
		ZIndex = 4,
	}, header)
	corner(pin, 6)
	local pinStroke = stroke(pin)
	local pinIcon = icon(pin, "pin", 13, theme.TextMuted, 5)
	pinIcon.AnchorPoint = Vector2.new(0.5, 0.5)
	pinIcon.Position = UDim2.fromScale(0.5, 0.5)
	local function renderPin()
		pinIcon.ImageColor3 = win._pinned and theme.AccentMid or theme.TextMuted
		pinStroke.Color = win._pinned and theme.AccentMid or theme.Hairline
		pin.BackgroundColor3 = win._pinned and theme.SurfaceHover or theme.SurfaceElement
	end
	renderPin()
	tip(pin, "Pin this window so it stays on screen when the interface is hidden. Click again to unpin.")

	if o.Info then
		local info = new("Frame", {
			Name = "Info",
			BackgroundColor3 = theme.SurfaceElement,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(20, 20),
			LayoutOrder = 4,
			ZIndex = 4,
		}, header)
		corner(info, 10)
		stroke(info)
		local ic = icon(info, "info", 13, theme.TextSub, 5)
		ic.AnchorPoint = Vector2.new(0.5, 0.5)
		ic.Position = UDim2.fromScale(0.5, 0.5)
		tip(info, o.Info)
	end

	new("Frame", {
		Name = "Divider",
		BackgroundColor3 = theme.Hairline,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 1),
		Position = UDim2.fromOffset(0, 3 + theme.HeaderH),
		ZIndex = 3,
	}, frame)

	-- Body
	local body = new("ScrollingFrame", {
		Name = "Body",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 4 + theme.HeaderH),
		Size = UDim2.new(1, 0, 1, -(4 + theme.HeaderH + theme.RadiusLg)),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = Color3.fromHex("50505f"),
		ZIndex = 3,
	}, frame)
	pad(body, 10, theme.GapLg, theme.GapXl, theme.GapLg)
	local layout = vlist(body, theme.GapSm)

	local maxHeight = o.MaxHeight or height
	local function fit()
		local h2 = 4 + theme.HeaderH + 10 + layout.AbsoluteContentSize.Y + theme.GapXl + theme.RadiusLg
		frame.Size = UDim2.fromOffset(width, math.clamp(h2, theme.HeaderH + 48, maxHeight))
	end
	if o.AutoHeight ~= false then
		layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(fit)
		task.defer(fit)
	end

	win.Body = body
	win._content = body
	win.Fit = fit

	local function refreshVisible()
		frame.Visible = (not win._hidden) and (libVisible or win._pinned)
	end
	win._refresh = refreshVisible
	frame.Visible = o.Visible ~= false
	win._hidden = not frame.Visible

	pin.MouseButton1Click:Connect(function()
		win:SetPinned(not win._pinned)
	end)

	function win:SetPinned(v)
		self._pinned = v and true or false
		renderPin()
		refreshVisible()
		if o.OnPinChanged then
			o.OnPinChanged(self._pinned)
		end
	end
	function win:IsPinned()
		return self._pinned
	end
	function win:SetVisible(v)
		self._hidden = not v
		refreshVisible()
	end
	function win:SetTitle(t)
		title.Text = t
	end
	function win:Destroy()
		for i, w in ipairs(windows) do
			if w == self then
				table.remove(windows, i)
				break
			end
		end
		frame:Destroy()
	end

	windows[#windows + 1] = win
	return win
end

----------------------------------------------------------------------
-- Library lifecycle
----------------------------------------------------------------------
function UILib:Init(opts)
	if gui and gui.Parent then
		return self
	end
	opts = opts or {}
	gui = new("ScreenGui", {
		Name = opts.Name or "UILib",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = opts.DisplayOrder or 999,
		IgnoreGuiInset = true,
	})
	-- ส่ง Parent เองได้ เช่น Init({ Parent = someGui }) ไม่งั้นใช้ PlayerGui
	gui.Parent = opts.Parent or Players.LocalPlayer:WaitForChild("PlayerGui")
	self.Gui = gui

	buildTooltip()

	local toggleKey = opts.ToggleKey
	if toggleKey then
		keep(UIS.InputBegan:Connect(function(input, processed)
			if processed then
				return
			end
			if input.KeyCode == toggleKey then
				self:Toggle()
			end
		end))
	end
	return self
end

function UILib:SetVisible(v)
	libVisible = v and true or false
	if not libVisible then
		hideTip()
	end
	for _, w in ipairs(windows) do
		w._refresh()
	end
end

function UILib:Toggle()
	self:SetVisible(not libVisible)
end

function UILib:IsVisible()
	return libVisible
end

function UILib:Destroy()
	for _, c in ipairs(conns) do
		pcall(function()
			c:Disconnect()
		end)
	end
	conns, windows, sweeps = {}, {}, {}
	sweepConn, tipFrame, tipLabel, tipTarget = nil, nil, nil, nil
	if gui then
		gui:Destroy()
		gui = nil
	end
	self.Gui = nil
	self.Flags = {}
	libVisible = true
	zCounter = 0
end

return UILib
