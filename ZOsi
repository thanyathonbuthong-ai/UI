end

local function buildButton(parent, o, order)
	local style = o.Style or "default"
	local b = new("TextButton", {
		Name = "Button",
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 32),
		Text = o.Name or "Button",
		TextSize = 13,
		AutoButtonColor = false,
		LayoutOrder = order,
	}, parent)
	setFont(b, "sans", Enum.FontWeight.SemiBold)
	corner(b, theme.RadiusMd)

	if style == "accent" or style == "danger" then
		b.BackgroundTransparency = 1
		b.TextTransparency = 1
		local fill = new("Frame", {
			Name = "Fill",
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
		}, b)
		corner(fill, theme.RadiusMd)
		local edge = (style == "danger") and theme.StatusBad or theme.AccentB
		new("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, edge),
				ColorSequenceKeypoint.new(0.5, theme.AccentDark),
				ColorSequenceKeypoint.new(1, edge),
			}),
		}, fill)
		local lbl = new("TextLabel", {
			Name = "Label",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
