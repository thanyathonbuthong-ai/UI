--[[
    Valkyrie UI Library
    Roblox (Luau) - Sidebar style UI library

    API summary
    -----------
    local Library = loadstring(...)()
    local Window = Library:CreateWindow({ Title, Subtitle, Footer, FooterRight, UserName, UserHandle, ToggleKey, Size })
    Window:AddSection("General")                       -- sidebar section header
    local Tab = Window:AddTab({ Name = "Auto Farm", Icon = "rbxassetid://..." or "A" })
    local Group = Tab:AddGroupbox({ Name = "Evolution", Icon = ..., Side = "Left" | "Right" })

    Group:AddToggle(id, { Text, Description, Default, Callback })
    Group:AddButton({ Text, Callback })
    Group:AddDropdown(id, { Text, Description, Values, Default, Multi, Callback })
    Group:AddSlider(id, { Text, Description, Min, Max, Step, Default, Suffix, Callback })
    Group:AddInput(id, { Text, Description, Default, Placeholder, Numeric, Callback })
    Group:AddKeybind(id, { Text, Description, Default, UIToggle, Callback, ChangedCallback })
    Group:AddLabel("text")
    Group:AddParagraph({ Title, Content })

    Library:Notify({ Title, Content, Duration, Type = "Info" | "Success" | "Warning" | "Error" })
    Library.Flags[id]   -- current values
    Library.Options[id] -- element objects (:Set(value))
]]

