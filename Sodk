			----------------------------------------------------------
			function Group:AddDropdown(id, dcfg)
				dcfg = dcfg or {}
				local row = NewRow()
				TextBlock(row, dcfg.Text or id, dcfg.Description, 130)
				local box2 = Create("TextButton", {
					BackgroundColor3 = Theme.Input,
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, 0, 0, 0),
					Size = UDim2.fromOffset(120, 24),
					Text = "",
					AutoButtonColor = false,
					Parent = row,
				}, { Corner(6), Stroke(Theme.Stroke) })
				local valueLabel = Create("TextLabel", {
					BackgroundTransparency = 1,
					Position = UDim2.fromOffset(8, 0),
					Size = UDim2.new(1, -28, 1, 0),
					Text = "",
					Font = FontRegular,
					TextSize = 12,
					TextColor3 = Theme.SubText,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
					Parent = box2,
				})
				Create("TextLabel", {
					BackgroundTransparency = 1,
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -6, 0.5, 0),
					Size = UDim2.fromOffset(14, 14),
					Text = "▾",
					Font = FontBold,
					TextSize = 12,
					TextColor3 = Theme.SubText,
					Parent = box2,
				})

				local Dropdown = {
					Type = "Dropdown",
					Values = dcfg.Values or {},
					Multi = dcfg.Multi or false,
					Value = dcfg.Multi and {} or nil,
				}

				local function display()
					if Dropdown.Multi then
						local t = {}
						for _, v in ipairs(Dropdown.Values) do
							if Dropdown.Value[v] then
								t[#t + 1] = tostring(v)
							end
						end
						return #t > 0 and table.concat(t, ", ") or "None"
					end
					return Dropdown.Value ~= nil and tostring(Dropdown.Value) or "None"
				end

				function Dropdown:Set(v, silent)
					if self.Multi then
						local nv = {}
						if type(v) == "table" then
							for k, val in pairs(v) do
								if type(k) == "number" then
									nv[val] = true
								elseif val then
									nv[k] = true
								end
							end
						end
						self.Value = nv
					else
						self.Value = v
					end
					valueLabel.Text = display()
					Library.Flags[id] = self.Value
					if self._refresh then
						self._refresh()
					end
					if not silent then
						Fire(dcfg.Callback, self.Value)
					end
				end

				function Dropdown:SetValues(values)
					self.Values = values or {}
				end

				local layer
				local function Close()
					if layer then
						layer:Destroy()
						layer = nil
					end
					Dropdown._refresh = nil
				end

				local function Open()
					Close()
					layer = Create("TextButton", {
						BackgroundTransparency = 1,
						Text = "",
						Size = UDim2.fromScale(1, 1),
						ZIndex = 100,
						Parent = Window.Gui,
					})
					layer.MouseButton1Click:Connect(Close)

					local abs, sz = box2.AbsolutePosition, box2.AbsoluteSize
					local w = math.max(sz.X, 150)
					local h = math.min(#Dropdown.Values * 28 + 8, 172)
					local list = Create("ScrollingFrame", {
						BackgroundColor3 = Theme.Card,
						BorderSizePixel = 0,
						Position = UDim2.fromOffset(abs.X + sz.X - w, abs.Y + sz.Y + 4),
						Size = UDim2.fromOffset(w, h),
						CanvasSize = UDim2.new(),
						AutomaticCanvasSize = Enum.AutomaticSize.Y,
						ScrollBarThickness = 2,
						ScrollBarImageColor3 = Theme.Off,
						ZIndex = 101,
						Parent = layer,
					}, { Corner(8), Stroke(Theme.Stroke), ListLayout(2), Padding(4, 4, 4, 4) })

					local buttons = {}
					local function refresh()
						for value, b in pairs(buttons) do
							local sel
							if Dropdown.Multi then
								sel = Dropdown.Value[value]
							else
								sel = Dropdown.Value == value
							end
							b.TextColor3 = sel and Theme.AccentText or Theme.Text
							b.BackgroundTransparency = sel and 0 or 1
						end
					end
					Dropdown._refresh = refresh

					for i, value in ipairs(Dropdown.Values) do
						local b = Create("TextButton", {
							BackgroundColor3 = Theme.Selected,
							BackgroundTransparency = 1,
							Size = UDim2.new(1, 0, 0, 26),
							Text = tostring(value),
							Font = FontMedium,
							TextSize = 12,
							TextColor3 = Theme.Text,
							TextXAlignment = Enum.TextXAlignment.Left,
							AutoButtonColor = false,
							LayoutOrder = i,
							ZIndex = 102,
							Parent = list,
						}, { Corner(6), Padding(8, 0, 8, 0) })
						buttons[value] = b
						b.MouseButton1Click:Connect(function()
							if Dropdown.Multi then
								local nv = {}
								for k, v in pairs(Dropdown.Value) do
									nv[k] = v
								end
								nv[value] = not nv[value] or nil
								Dropdown:Set(nv)
							else
								Dropdown:Set(value)
								Close()
							end
						end)
					end
					refresh()
				end

				box2.MouseButton1Click:Connect(function()
					if layer then
						Close()
					else
						Open()
					end
				end)

				if dcfg.Default ~= nil then
					Dropdown:Set(dcfg.Default, true)
				else
					valueLabel.Text = display()
					Library.Flags[id] = Dropdown.Value
				end
				Library.Options[id] = Dropdown
				return Dropdown
			end

			----------------------------------------------------------
			-- Slider
			----------------------------------------------------------
			function Group:AddSlider(id, scfg)
				scfg = scfg or {}
				local min, max = scfg.Min or 0, scfg.Max or 100
				local step = scfg.Step or 1
				local decimals = (tostring(step):match("%.(%d+)") or ""):len()
				local row = NewRow()
				Create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = row })

				local head2 = Create("Frame", {
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					LayoutOrder = 1,
					Parent = row,
				})
				TextBlock(head2, scfg.Text or id, scfg.Description, 70)
				local valueLabel = Create("TextLabel", {
					BackgroundTransparency = 1,
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, 0, 0, 0),
					Size = UDim2.fromOffset(64, 16),
					Text = "",
					Font = FontMedium,
					TextSize = 12,
					TextColor3 = Theme.AccentText,
					TextXAlignment = Enum.TextXAlignment.Right,
					Parent = head2,
				})

				local hit = Create("TextButton", {
					BackgroundTransparency = 1,
					Text = "",
					Size = UDim2.new(1, 0, 0, 16),
					LayoutOrder = 2,
					Parent = row,
				})
				local track = Create("Frame", {
					BackgroundColor3 = Theme.Off,
					AnchorPoint = Vector2.new(0, 0.5),
					Position = UDim2.new(0, 0, 0.5, 0),
					Size = UDim2.new(1, 0, 0, 6),
					Parent = hit,
				}, { Create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
				local fill = Create("Frame", {
					BackgroundColor3 = Theme.Accent,
					Size = UDim2.fromScale(0, 1),
					Parent = track,
				}, { Create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
				local knob = Create("Frame", {
					BackgroundColor3 = Theme.White,
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(0, 0.5),
					Size = UDim2.fromOffset(12, 12),
					Parent = track,
				}, { Create("UICorner", { CornerRadius = UDim.new(1, 0) }) })

				local Slider = { Type = "Slider", Value = min }
				function Slider:Set(v, silent)
					v = tonumber(v) or min
					v = min + math.floor((v - min) / step + 0.5) * step
					v = math.clamp(v, min, max)
					v = tonumber(string.format("%." .. decimals .. "f", v))
					self.Value = v
					Library.Flags[id] = v
					local alpha = (max == min) and 0 or (v - min) / (max - min)
					fill.Size = UDim2.fromScale(alpha, 1)
					knob.Position = UDim2.fromScale(alpha, 0.5)
					valueLabel.Text = tostring(v) .. (scfg.Suffix or "")
					if not silent then
						Fire(scfg.Callback, v)
					end
				end

				local dragging = false
				local function update(x)
					local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
					Slider:Set(min + (max - min) * rel)
				end
				hit.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						dragging = true
						update(input.Position.X)
					end
				end)
				Connect(UIS.InputChanged, function(input)
					if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
						update(input.Position.X)
					end
				end)
				Connect(UIS.InputEnded, function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						dragging = false
					end
				end)

				Slider:Set(scfg.Default or min, true)
				Library.Options[id] = Slider
				return Slider
			end

