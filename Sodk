--------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------
local function Create(class, props, children)
	local inst = Instance.new(class)
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then
			parent = v
		else
			inst[k] = v
		end
	end
	for _, c in ipairs(children or {}) do
		c.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function Tween(obj, time, goal, style)
	local t = TweenService:Create(obj, TweenInfo.new(time or 0.15, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
	t:Play()
	return t
end

local function Corner(r)
	return Create("UICorner", { CornerRadius = UDim.new(0, r) })
end

local function Stroke(color, thickness, transparency)
	return Create("UIStroke", {
		Color = color or Theme.Stroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

local function Padding(l, t, r, b)
	return Create("UIPadding", {
		PaddingLeft = UDim.new(0, l or 0),
		PaddingTop = UDim.new(0, t or 0),
		PaddingRight = UDim.new(0, r or 0),
		PaddingBottom = UDim.new(0, b or 0),
	})
end

local function ListLayout(pad)
	return Create("UIListLayout", {
		Padding = UDim.new(0, pad or 0),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

local function Connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(Library.Connections, c)
	return c
end

local function Fire(cb, ...)
	if cb then
		task.spawn(cb, ...)
	end
end

local function GetGuiParent()
	local ok, hui = pcall(function()
		return gethui and gethui()
	end)
	if ok and hui then
		return hui
	end
	local ok2 = pcall(function()
		return CoreGui.Name
	end)
	if ok2 then
		return CoreGui
	end
	return Players.LocalPlayer:WaitForChild("PlayerGui")
end

-- icon: "rbxassetid://123" | 123 | "A" (text glyph) | nil
local function MakeIcon(icon, parent, size, color, pos)
	size = size or 16
	local str = icon ~= nil and tostring(icon) or nil
	local isImage = str ~= nil and (str:find("rbxasset") ~= nil or str:match("^%d+$") ~= nil)
	if isImage then
		local id = str
		if id:match("^%d+$") then
			id = "rbxassetid://" .. id
		end
		return Create("ImageLabel", {
			BackgroundTransparency = 1,
			Image = id,
			ImageColor3 = color,
			Size = UDim2.fromOffset(size, size),
			AnchorPoint = Vector2.new(0, 0.5),
			Position = pos or UDim2.new(0, 0, 0.5, 0),
			Parent = parent,
		})
	end
	return Create("TextLabel", {
		BackgroundTransparency = 1,
		Text = str or "●",
		Font = FontBold,
		TextSize = size - 2,
		TextColor3 = color,
		Size = UDim2.fromOffset(size, size),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = pos or UDim2.new(0, 0, 0.5, 0),
		Parent = parent,
	})
end

local function SetIconColor(icon, color)
	if icon:IsA("ImageLabel") then
		icon.ImageColor3 = color
	else
		icon.TextColor3 = color
	end
end

-- title + optional description block (auto height)
local function TextBlock(parent, text, desc, rightPad)
	local holder = Create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = parent,
	}, {
		ListLayout(3),
		Padding(0, 0, rightPad or 0, 0),
	})
	local title = Create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text = text or "",
		Font = FontMedium,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		LayoutOrder = 1,
		Parent = holder,
	})
	local descLabel
	if desc and desc ~= "" then
		descLabel = Create("TextLabel", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Text = desc,
			Font = FontRegular,
			TextSize = 12,
			TextColor3 = Theme.SubText,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = true,
			LayoutOrder = 2,
			Parent = holder,
		})
	end
	return holder, title, descLabel
end

--------------------------------------------------------------------
-- Notifications
--------------------------------------------------------------------
local NotifyGui, NotifyHolder

local function EnsureNotifyHolder()
	if NotifyGui and NotifyGui.Parent then
		return NotifyHolder
	end
	NotifyGui = Create("ScreenGui", {
		Name = "ValkyrieNotify",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 1000,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	NotifyGui.Parent = GetGuiParent()
	NotifyHolder = Create("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.new(0, 290, 1, -32),
		Parent = NotifyGui,
	}, {
		Create("UIListLayout", {
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
		}),
	})
	return NotifyHolder
end

function Library:Notify(cfg)
	cfg = cfg or {}
	local holder = EnsureNotifyHolder()
	local duration = cfg.Duration or 4
	local color = ({
		Info = Theme.AccentText,
		Success = Theme.Success,
		Warning = Theme.Warning,
		Error = Theme.Error,
	})[cfg.Type or "Info"] or Theme.AccentText

	local wrapper = Create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = holder,
	})
	local toast = Create("Frame", {
		BackgroundColor3 = Theme.Card,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.new(1.3, 0, 0, 0),
		ClipsDescendants = true,
		Parent = wrapper,
	}, { Corner(8), Stroke(Theme.Stroke) })

	local content = Create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = toast,
	}, { ListLayout(3), Padding(14, 11, 14, 14) })

	Create("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 16),
		Text = cfg.Title or "Notification",
		Font = FontBold,
		TextSize = 13,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = 1,
		Parent = content,
	})
	if cfg.Content and cfg.Content ~= "" then
		Create("TextLabel", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Text = cfg.Content,
			Font = FontRegular,
			TextSize = 12,
			TextColor3 = Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = true,
			LayoutOrder = 2,
			Parent = content,
		})
	end

	local bar = Create("Frame", {
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 2),
		Parent = toast,
	})

	Tween(toast, 0.3, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Quint)
	Tween(bar, duration, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)

	task.delay(duration, function()
		if toast.Parent then
			local t = Tween(toast, 0.3, { Position = UDim2.new(1.3, 0, 0, 0) }, Enum.EasingStyle.Quint)
			t.Completed:Wait()
			wrapper:Destroy()
		end
	end)
end

