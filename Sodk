			function Group:AddKeybind(id, kcfg)
				kcfg = kcfg or {}
				local row = NewRow()
				TextBlock(row, kcfg.Text or id, kcfg.Description, 96)
				local box2 = Create("TextButton", {
					BackgroundColor3 = Theme.Input,
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, 0, 0, 0),
					Size = UDim2.fromOffset(86, 24),
