					TextSize = 12,
					TextColor3 = Theme.SubText,
					AutoButtonColor = false,
					Parent = row,
				}, { Corner(6), Stroke(Theme.Stroke) })

				local Keybind = { Type = "Keybind", Value = nil }
				local function toKey(v)
					if typeof(v) == "EnumItem" then
						return v
					elseif type(v) == "string" then
						return Enum.KeyCode[v]
					end
				end
				function Keybind:Set(v, silent)
					local key = toKey(v)
					self.Value = key
					box2.Text = key and key.Name or "None"
					Library.Flags[id] = key
					if kcfg.UIToggle and key then
						Window.ToggleKey = key
					end
					if not silent then
						Fire(kcfg.ChangedCallback, key)
					end
				end

				local listening = false
				box2.MouseButton1Click:Connect(function()
					if listening then
						return
					end
					listening = true
					Library.Listening = true
					box2.Text = "..."
					box2.TextColor3 = Theme.AccentText
					local conn
					conn = UIS.InputBegan:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.Keyboard then
							conn:Disconnect()
							task.defer(function()
								Library.Listening = false
							end)
							listening = false
							box2.TextColor3 = Theme.SubText
							if input.KeyCode == Enum.KeyCode.Escape then
								Keybind:Set(nil)
							else
								Keybind:Set(input.KeyCode)
							end
						end
					end)
				end)

				Connect(UIS.InputBegan, function(input, gp)
					if gp or listening or Library.Listening then
						return
					end
					if input.UserInputType == Enum.UserInputType.Keyboard and Keybind.Value and input.KeyCode == Keybind.Value then
						if not kcfg.UIToggle then
							Fire(kcfg.Callback, Keybind.Value)
						end
					end
				end)

				Keybind:Set(kcfg.Default, true)
				Library.Options[id] = Keybind
				return Keybind
			end

			----------------------------------------------------------
			-- Label / Paragraph
			----------------------------------------------------------
			function Group:AddLabel(text)
				local row = NewRow()
				local lbl = Create("TextLabel", {
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					Text = text or "",
					Font = FontRegular,
					TextSize = 12,
					TextColor3 = Theme.SubText,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextYAlignment = Enum.TextYAlignment.Top,
					TextWrapped = true,
					Parent = row,
				})
				local Label = { Type = "Label" }
				function Label:SetText(t)
					lbl.Text = t
				end
				return Label
			end

			function Group:AddParagraph(pcfg)
				pcfg = pcfg or {}
				local row = NewRow()
				local _, t, d = TextBlock(row, pcfg.Title or "", pcfg.Content or "", 0)
				local Paragraph = { Type = "Paragraph" }
				function Paragraph:SetTitle(x)
					t.Text = x
				end
				function Paragraph:SetContent(x)
					if d then
						d.Text = x
					end
				end
				return Paragraph
			end

			return Group
		end

		return Tab
	end

	-- search filter
	SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
		local q = SearchBox.Text:lower()
		for _, t in ipairs(Window.Tabs) do
			t.Button.Visible = (q == "") or (t.Name:lower():find(q, 1, true) ~= nil)
		end
	end)

	table.insert(Library.Windows, Window)
	return Window
end

function Library:Unload()
	for _, c in ipairs(self.Connections) do
		pcall(function()
			c:Disconnect()
		end)
	end
	for _, w in ipairs(self.Windows) do
		pcall(function()
			w:Destroy()
		end)
	end
	if NotifyGui then
		NotifyGui:Destroy()
	end
	table.clear(self.Connections)
	table.clear(self.Windows)
end

return Library
