function PrismGlass:CreateRouter()
    local router = {Routes = {}, Current = nil, Changed = PrismGlass.Signal.new()}
    function router:Register(name, page)
        self.Routes[name] = page
        return page
    end
    function router:Go(name)
        local page = self.Routes[name]
        if not page then return false end
        for routeName, routePage in pairs(self.Routes) do routePage.Visible = routeName == name end
        self.Current = name; self.Changed:Fire(name, page)
        return true
    end
    function router:Back()
        local first
        for name in pairs(self.Routes) do first = name; break end
        if first then return self:Go(first) end
        return false
    end
    return router
end

function PrismGlass:CreateConfigStore(defaults)
    local store = {Data = table.clone(defaults or {}), Changed = PrismGlass.Signal.new()}
    function store:Get(key, fallback)
        local value = self.Data[key]
        if value == nil then return fallback end
        return value
    end
    function store:Set(key, value)
        local previous = self.Data[key]; self.Data[key] = value; self.Changed:Fire(key, value, previous); return value
    end
    function store:Patch(values)
        for key, value in pairs(values) do self:Set(key, value) end
        return self.Data
    end
    function store:Reset()
        table.clear(self.Data)
        for key, value in pairs(defaults or {}) do self.Data[key] = value end
        self.Changed:Fire("__reset", self.Data)
    end
    function store:Encode()
        return HttpService:JSONEncode(self.Data)
    end
    function store:Decode(json)
        local decoded = HttpService:JSONDecode(json)
        self:Patch(decoded)
        return self.Data
    end
    return store
end

function PrismGlass:BindConfig(control, store, key)
    local state = store:Get(key)
    if control.Set then control:Set(state) end
    return store.Changed:Connect(function(changedKey, value) if changedKey == key and control.Set then control:Set(value) end end)
end

function PrismGlass:CreateAction(config)
    config = config or {}
    local action = {Name = config.Name or "Action", Enabled = config.Enabled ~= false, Callback = config.Callback, Changed = PrismGlass.Signal.new()}
    function action:SetEnabled(enabled)
        self.Enabled = enabled; self.Changed:Fire(enabled)
    end
    function action:Invoke(...)
        if not self.Enabled then return false end
        if self.Callback then self.Callback(...) end
        return true
    end
    return action
end

function PrismGlass:CreateDebounced(callback, delay)
    local running = false
    return function(...)
        if running then return end
        running = true
        local args = table.pack(...)
        task.delay(delay or 0.2, function()
            running = false
            callback(table.unpack(args, 1, args.n))
        end)
    end
end

function PrismGlass:CreateThrottled(callback, interval)
    local last = 0
    return function(...)
        local now = os.clock()
        if now - last < (interval or 0.2) then return end
        last = now
        return callback(...)
    end
end

function PrismGlass:Destroy()
    if self._destroyed then return end
    self._destroyed = true
    for _, state in ipairs(self._states or {}) do state:Destroy() end
    for _, janitor in ipairs(self._janitors or {}) do janitor:Destroy() end
    for _, connection in ipairs(self._connections or {}) do pcall(function() connection:Disconnect() end) end
    for _, instance in ipairs(self._tracked or {}) do if instance and instance.Parent then instance:Destroy() end end
    if self._worldBlur and self._worldBlur.Parent then self._worldBlur:Destroy() end
    if self.ScreenGui then self.ScreenGui:Destroy() end
end

