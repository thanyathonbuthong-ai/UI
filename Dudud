                if child:IsA("TextButton") then child.TextLabel.Text = "" end
            end
        else
            sidebar.Size = UDim2.new(0, self.WindStyle and 174 or 190, 1, 0)
            brand.Visible = true
            local sidebarWidth = self.WindStyle and 188 or 204
            content.Position = UDim2.new(0, sidebarWidth, 0, 0)
            content.Size = UDim2.new(1, -sidebarWidth, 1, 0)
        end
    end
    table.insert(self._connections, window:GetPropertyChangedSignal("AbsoluteSize"):Connect(compact))
    task.defer(compact)
    return self
end

function PrismGlass:AddTab(config: {[string]: any}): any
    assert(self.Menu and self.Content, "CreateWindow must be called before AddTab")
    local tab = {Name = config.Name or "Tab", Icon = config.Icon or "◆", Sections = {}, Library = self}
    local button = New("TextButton", {
        Name = tab.Name .. "Tab", Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false, LayoutOrder = #self._tabs + 1,
    }, self.Menu) :: TextButton
    Corner(button, 13)
    local icon = Text(button, tab.Icon, 18, C.Muted, true)
    icon.Name = "Icon"; icon.Position = UDim2.new(0, 13, 0, 0); icon.Size = UDim2.new(0, 28, 1, 0)
    icon.TextXAlignment = Enum.TextXAlignment.Center
    local label = Text(button, tab.Name, 13, C.Muted, true)
    label.Name = "TextLabel"; label.Position = UDim2.new(0, 48, 0, 0); label.Size = UDim2.new(1, -54, 1, 0)

    local page = New("Frame", {Name = tab.Name .. "Page", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Visible = false, LayoutOrder = #self._tabs + 1}, self.Content)
    New("UIListLayout", {Padding = UDim.new(0, 14), SortOrder = Enum.SortOrder.LayoutOrder}, page)
    tab.Page, tab.Button = page, button
    table.insert(self._tabs, tab)

    local function select()
        for _, other in ipairs(self._tabs) do
            local active = other == tab
            other.Page.Visible = active
            TweenService:Create(other.Button, TWEEN_SMOOTH, {BackgroundTransparency = active and 0.68 or 1}):Play()
            TweenService:Create(other.Button.Icon, TWEEN_SMOOTH, {TextColor3 = active and C.White or C.Muted}):Play()
            TweenService:Create(other.Button.TextLabel, TWEEN_SMOOTH, {TextColor3 = active and C.White or C.Muted}):Play()
            local gradient = other.Button:FindFirstChild("ActiveGradient")
            if active and not gradient then
                gradient = Gradient(other.Button, PrismGlass.Palettes.VioletSky, 0)
                gradient.Name = "ActiveGradient"
            elseif gradient then gradient.Enabled = active end
        end
        self.ActiveTab = tab
    end
    button.Activated:Connect(select)
    AddHover(button, New("UIScale", {Scale = 1}, button) :: UIScale, nil)
    if #self._tabs == 1 then select() end
    return tab
end

function PrismGlass:AddSection(tab: any, title: string, description: string?): Frame
    local card = self:_glass(tab.Page, title:gsub("%s", ""), {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 0.28}, 20)
    Padding(card, 16)
    local heading = Text(card, title, 16, C.Text, true)
    heading.Size = UDim2.new(1, 0, 0, 24)
    if description then
        local desc = Text(card, description, 12, C.Muted, false)
        desc.Size = UDim2.new(1, 0, 0, 20)
        desc.Position = UDim2.new(0, 0, 0, 25)
    end
    local holder = New("Frame", {Name = "Controls", Position = UDim2.new(0, 0, 0, description and 54 or 32), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1}, card)
    New("UIListLayout", {Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder}, holder)
    card:SetAttribute("ControlCount", 0)
    table.insert(tab.Sections, {Card = card, Holder = holder})
    return holder
end

