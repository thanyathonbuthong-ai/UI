local TWEEN_FAST = TweenInfo.new(0.16, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local TWEEN_SMOOTH = TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local TWEEN_SPRING = TweenInfo.new(0.42, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

local function New(className: string, props: {[string]: any}, parent: Instance?): Instance
    local object = Instance.new(className)
    for property, value in pairs(props) do
        object[property] = value
    end
    if parent then object.Parent = parent end
    return object
end

local function Corner(parent: Instance, radius: number): UICorner
    return New("UICorner", {CornerRadius = UDim.new(0, radius)}, parent) :: UICorner
end

local function Gradient(parent: Instance, colors: {Color3}, rotation: number?): UIGradient
    local keypoints = {}
    for index, color in ipairs(colors) do
        table.insert(keypoints, ColorSequenceKeypoint.new((index - 1) / math.max(#colors - 1, 1), color))
    end
    return New("UIGradient", {
        Color = ColorSequence.new(keypoints),
        Rotation = rotation or 0,
    }, parent) :: UIGradient
end

local function Stroke(parent: Instance, color: Color3, transparency: number, thickness: number): UIStroke
    return New("UIStroke", {
        Color = color,
        Transparency = transparency,
        Thickness = thickness,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, parent) :: UIStroke
end

local function Padding(parent: Instance, amount: number): UIPadding
    return New("UIPadding", {
        PaddingTop = UDim.new(0, amount), PaddingBottom = UDim.new(0, amount),
        PaddingLeft = UDim.new(0, amount), PaddingRight = UDim.new(0, amount),
    }, parent) :: UIPadding
end

local function Text(parent: Instance, text: string, size: number, color: Color3, bold: boolean?): TextLabel
    return New("TextLabel", {
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = color,
        TextSize = size,
        Font = bold and Enum.Font.GothamBold or Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        AutomaticSize = Enum.AutomaticSize.XY,
    }, parent) :: TextLabel
end

local function AddHover(button: GuiButton, scale: UIScale?, stroke: UIStroke?, hoverTransparency: number?)
    local originalScale = scale and scale.Scale or 1
    button.MouseEnter:Connect(function()
        if scale then TweenService:Create(scale, TWEEN_SPRING, {Scale = originalScale * 1.035}):Play() end
        if stroke then TweenService:Create(stroke, TWEEN_FAST, {Transparency = hoverTransparency or 0.08, Thickness = 1.7}):Play() end
    end)
    button.MouseLeave:Connect(function()
        if scale then TweenService:Create(scale, TWEEN_SMOOTH, {Scale = originalScale}):Play() end
        if stroke then TweenService:Create(stroke, TWEEN_SMOOTH, {Transparency = 0.42, Thickness = 1}):Play() end
    end)
end

function PrismGlass:_mountBackground()
    local background = New("Frame", {
        Name = "AuroraBackground", Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Background,
        BorderSizePixel = 0, ZIndex = 0,
    }, self.ScreenGui)
    local gradient = Gradient(background, {
        Color3.fromRGB(17, 11, 48), Color3.fromRGB(26, 10, 64),
        Color3.fromRGB(12, 35, 72), Color3.fromRGB(9, 15, 36),
    }, 25)
    gradient.Transparency = NumberSequence.new(0.04)

    local blobs = {
        {Color3.fromRGB(135, 58, 255), UDim2.fromScale(-0.12, -0.16), UDim2.fromScale(0.58, 0.55)},
        {Color3.fromRGB(35, 190, 255), UDim2.fromScale(0.56, -0.18), UDim2.fromScale(0.55, 0.48)},
        {Color3.fromRGB(255, 54, 156), UDim2.fromScale(0.67, 0.55), UDim2.fromScale(0.46, 0.50)},
        {Color3.fromRGB(255, 186, 77), UDim2.fromScale(-0.20, 0.72), UDim2.fromScale(0.42, 0.38)},
    }
    for index, blob in ipairs(blobs) do
        local orb = New("Frame", {
            Name = "AuroraOrb" .. index, Position = blob[2], Size = blob[3],
            BackgroundColor3 = blob[1], BackgroundTransparency = 0.76,
            BorderSizePixel = 0, ZIndex = 0,
        }, self.ScreenGui)
        Corner(orb, 999)
        New("UIBlurEffect", {Size = 34}, orb)
    end
end

function PrismGlass:_enableAmbientBlur()
    if self.Options.EnableWorldBlur == false then return end
    local blur = Lighting:FindFirstChild("PrismGlassBlur") or New("BlurEffect", {Name = "PrismGlassBlur", Size = 5}, Lighting)
    self._worldBlur = blur
end

function PrismGlass.new(options: {[string]: any}?): any
    local self = setmetatable({}, PrismGlass)
    self.Options = options or {}
    self.WindStyle = self.Options.WindStyle == true
    self._connections = {}
    self._tabs = {}
    self._sections = {}
    self._destroyed = false

    local playerGui = LocalPlayer:WaitForChild("PlayerGui")
    self.ScreenGui = New("ScreenGui", {
        Name = self.Options.Name or "PrismGlassUI",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = self.Options.DisplayOrder or 100,
    }, playerGui)

    self:_mountBackground()
    self:_enableAmbientBlur()

    self.Root = New("Frame", {
        Name = "Root", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        BorderSizePixel = 0, ZIndex = 2,
    }, self.ScreenGui)

    self.LayoutScale = New("UIScale", {Scale = 1}, self.Root) :: UIScale
    self:_bindResponsiveScale()
    return self
end

function PrismGlass:_bindResponsiveScale()
    local camera = workspace.CurrentCamera
    local function update()
        local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
        local scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.72, 1.08)
        self.LayoutScale.Scale = scale
    end
    table.insert(self._connections, camera:GetPropertyChangedSignal("ViewportSize"):Connect(update))
    update()
end

function PrismGlass:_glass(parent: Instance, name: string, props: {[string]: any}, radius: number?): Frame
    props.Name = name
    props.BackgroundColor3 = props.BackgroundColor3 or C.Surface
    props.BackgroundTransparency = props.BackgroundTransparency or 0.24
    props.BorderSizePixel = 0
    local frame = New("Frame", props, parent) :: Frame
    Corner(frame, radius or 20)
    local stroke = Stroke(frame, C.White, 0.69, 1)
    New("UIGradient", {
        Color = ColorSequence.new(Color3.fromRGB(255,255,255), Color3.fromRGB(135,127,204)),
        Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.20), NumberSequenceKeypoint.new(1, 0.72)}),
        Rotation = 90,
    }, frame)
    return frame
end

