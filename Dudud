        Name = "Content", Position = UDim2.new(0, 204, 0, 0), Size = UDim2.new(1, -204, 1, 0),
        BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
        ScrollBarImageColor3 = Color3.fromRGB(142, 92, 255), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(),
    }, body)
    Padding(content, 2)
    New("UIListLayout", {Padding = UDim.new(0, 14), SortOrder = Enum.SortOrder.LayoutOrder}, content)
    self.Sidebar = sidebar
    self.Menu = menu
    self.Content = content

    local function compact()
        local width = self.Window.AbsoluteSize.X
        if width < 680 then
            sidebar.Size = UDim2.new(0, 64, 1, 0)
            brand.Visible = false
            content.Position = UDim2.new(0, 76, 0, 0)
            content.Size = UDim2.new(1, -76, 1, 0)
