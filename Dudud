    Smooth = TweenInfo.new(0.26, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
    Spring = TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
}

function PrismGlass:SetTheme(theme)
    assert(type(theme) == "table", "theme must be a table")
    for key, value in pairs(theme) do
        self.Theme[key] = value
    end
    return self.Theme
end

function PrismGlass:SetAccent(colors)
    assert(type(colors) == "table" and #colors >= 2, "SetAccent expects at least two Color3 values")
    self.Accent = colors
    return colors
end

function PrismGlass:_makeRow(parent, height)
    local row = New("Frame", {
        Size = UDim2.new(1, 0, 0, height or 42),
        BackgroundTransparency = 1,
    }, parent)
    return row
end

