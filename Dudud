function PrismGlass:Pulse(instance, amount, duration)
    local scale = instance:FindFirstChildOfClass("UIScale") or New("UIScale", {Scale = 1}, instance)
    local value = amount or 1.04
    self:Tween(scale, {Scale = value}, TweenInfo.new(duration or 0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
    task.delay(duration or 0.16, function() if scale.Parent then self:Tween(scale, {Scale = 1}, self.Motion.Smooth) end end)
end

function PrismGlass:Shake(instance, distance, repeats)
    local original = instance.Position
    local offset = distance or 5
    for index = 1, repeats or 3 do
        local direction = index % 2 == 0 and -1 or 1
        self:Tween(instance, {Position = original + UDim2.fromOffset(offset * direction, 0)}, self.Motion.Fast)
        task.wait(0.05)
    end
    self:Tween(instance, {Position = original}, self.Motion.Smooth)
end

