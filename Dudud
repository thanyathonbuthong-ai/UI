    Corner(button, 999); Gradient(button, PrismGlass.Palettes.RoseGold, 135); local stroke = Stroke(button, C.White, 0.12, 1.5)
    AddHover(button, New("UIScale", {Scale = 1}, button) :: UIScale, stroke, 0)
    button.Activated:Connect(function() if config.Callback then config.Callback() end end)
    return button
end

function PrismGlass:Destroy()
    if self._destroyed then return end
    self._destroyed = true
    for _, connection in ipairs(self._connections) do connection:Disconnect() end
    if self._worldBlur and self._worldBlur.Parent then self._worldBlur:Destroy() end
    if self.ScreenGui then self.ScreenGui:Destroy() end
end


