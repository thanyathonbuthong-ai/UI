function PrismGlass:AddToggle(parent: Instance, config: {[string]: any}): (Frame, () -> boolean)
    local row = self:_controlRow(parent, 48)
    local title = Text(row, config.Text or "Enable feature", 13, C.Text, true)
    title.Position = UDim2.new(0, 0, 0, 0); title.Size = UDim2.new(1, -70, 1, 0)
    local toggle = New("TextButton", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(50, 28), BackgroundColor3 = Color3.fromRGB(53, 51, 78), AutoButtonColor = false, Text = ""}, row) :: TextButton
    Corner(toggle, 999); local knob = New("Frame", {Position = UDim2.new(0, 4, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromOffset(20, 20), BackgroundColor3 = C.White, BorderSizePixel = 0}, toggle) :: Frame; Corner(knob, 999)
    local state = config.Default == true
    local function render()
        TweenService:Create(toggle, TWEEN_SMOOTH, {BackgroundColor3 = state and Color3.fromRGB(91, 221, 166) or Color3.fromRGB(53, 51, 78)}):Play()
        TweenService:Create(knob, TWEEN_SPRING, {Position = state and UDim2.new(1, -4, 0.5, 0) or UDim2.new(0, 4, 0.5, 0), AnchorPoint = state and Vector2.new(1, 0.5) or Vector2.new(0, 0.5)}):Play()
        if config.Callback then config.Callback(state) end
    end
    toggle.Activated:Connect(function() state = not state; render() end); render()
    return row, function() return state end
end

function PrismGlass:AddSlider(parent: Instance, config: {[string]: any}): (Frame, () -> number)
    local row = self:_controlRow(parent, 58)
    local title = Text(row, config.Text or "Intensity", 13, C.Text, true); title.Size = UDim2.new(1, -60, 0, 22)
    local valueLabel = Text(row, "0", 12, C.Muted, false); valueLabel.AnchorPoint = Vector2.new(1, 0); valueLabel.Position = UDim2.new(1, 0, 0, 0)
    local track = New("Frame", {Position = UDim2.new(0, 0, 0, 34), Size = UDim2.new(1, 0, 0, 7), BackgroundColor3 = Color3.fromRGB(56, 51, 83), BorderSizePixel = 0}, row) :: Frame; Corner(track, 99)
    local fill = New("Frame", {Size = UDim2.fromScale(0.5, 1), BackgroundColor3 = C.White, BorderSizePixel = 0}, track) :: Frame; Corner(fill, 99); Gradient(fill, PrismGlass.Palettes.Rainbow, 0)
    local min, max = config.Min or 0, config.Max or 100; local value = math.clamp(config.Default or min, min, max)
    local dragging = false
    local function setFromX(x: number)
        local ratio = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1); value = min + (max - min) * ratio
        fill.Size = UDim2.new(ratio, 0, 1, 0); valueLabel.Text = string.format(config.Format or "%.0f", value)
        if config.Callback then config.Callback(value) end
    end
    track.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; setFromX(input.Position.X) end end)
    UserInputService.InputChanged:Connect(function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then setFromX(input.Position.X) end end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
    setFromX(track.AbsolutePosition.X + track.AbsoluteSize.X * ((value - min) / (max - min)))
    return row, function() return value end
end

function PrismGlass:AddFloatingButton(config: {[string]: any}): TextButton
