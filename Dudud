PrismGlass.Signal = {}
PrismGlass.Signal.__index = PrismGlass.Signal

function PrismGlass.Signal.new()
    return setmetatable({Listeners = {}, Destroyed = false}, PrismGlass.Signal)
end

function PrismGlass.Signal:Connect(callback)
    assert(type(callback) == "function", "Signal callback must be a function")
    if self.Destroyed then return {Disconnect = function() end} end
    local record = {Callback = callback, Connected = true}
    table.insert(self.Listeners, record)
    return {
        Disconnect = function()
            if not record.Connected then return end
            record.Connected = false
            for index, item in ipairs(self.Listeners) do
                if item == record then table.remove(self.Listeners, index); break end
            end
        end,
    }
end

function PrismGlass.Signal:Fire(...)
    if self.Destroyed then return end
    local args = table.pack(...)
    for _, record in ipairs(table.clone(self.Listeners)) do
        if record.Connected then task.spawn(record.Callback, table.unpack(args, 1, args.n)) end
    end
end

function PrismGlass.Signal:Wait()
    local thread = coroutine.running()
    local connection
    connection = self:Connect(function(...)
        connection.Disconnect()
        task.spawn(thread, ...)
    end)
    return coroutine.yield()
end

function PrismGlass.Signal:Destroy()
    self.Destroyed = true
    table.clear(self.Listeners)
end

PrismGlass.Janitor = {}
PrismGlass.Janitor.__index = PrismGlass.Janitor

function PrismGlass.Janitor.new()
    return setmetatable({Tasks = {}, Destroyed = false}, PrismGlass.Janitor)
end

function PrismGlass.Janitor:Add(taskObject, methodName, index)
    if self.Destroyed then
        if typeof(taskObject) == "RBXScriptConnection" then taskObject:Disconnect() elseif type(taskObject) == "function" then taskObject() elseif typeof(taskObject) == "Instance" then taskObject:Destroy() end
        return taskObject
    end
    local key = index or #self.Tasks + 1
    self:Remove(key)
    self.Tasks[key] = {Object = taskObject, Method = methodName}
    return taskObject
end

function PrismGlass.Janitor:Remove(index)
    local item = self.Tasks[index]
    if not item then return end
    self.Tasks[index] = nil
    local object = item.Object
    local method = item.Method
    if method and object and object[method] then object[method](object) elseif typeof(object) == "RBXScriptConnection" then object:Disconnect() elseif type(object) == "function" then object() elseif typeof(object) == "Instance" then object:Destroy() end
end

function PrismGlass.Janitor:Cleanup()
    for index in pairs(self.Tasks) do self:Remove(index) end
end

function PrismGlass.Janitor:Destroy()
    if self.Destroyed then return end
    self.Destroyed = true
    self:Cleanup()
end

PrismGlass.State = {}
PrismGlass.State.__index = PrismGlass.State

function PrismGlass.State.new(initial)
    local self = setmetatable({}, PrismGlass.State)
    self.Value = initial
    self.Changed = PrismGlass.Signal.new()
    self.Destroyed = false
    return self
end

function PrismGlass.State:Get()
    return self.Value
end

function PrismGlass.State:Set(value)
    if self.Destroyed or self.Value == value then return value end
    local previous = self.Value
    self.Value = value
    self.Changed:Fire(value, previous)
    return value
end

function PrismGlass.State:Update(callback)
    return self:Set(callback(self.Value))
end

function PrismGlass.State:Bind(callback)
    callback(self.Value)
    return self.Changed:Connect(callback)
end

function PrismGlass.State:Destroy()
    self.Destroyed = true
    self.Changed:Destroy()
end

function PrismGlass:CreateState(value)
    self._states = self._states or {}
    local state = PrismGlass.State.new(value)
    table.insert(self._states, state)
    return state
end

function PrismGlass:CreateJanitor()
    self._janitors = self._janitors or {}
    local janitor = PrismGlass.Janitor.new()
    table.insert(self._janitors, janitor)
    return janitor
end

function PrismGlass:TrackConnection(connection)
    self._connections = self._connections or {}
    table.insert(self._connections, connection)
    return connection
end

function PrismGlass:Track(instance)
    self._tracked = self._tracked or {}
    table.insert(self._tracked, instance)
    return instance
end

function PrismGlass:Find(name)
    return self.ScreenGui and self.ScreenGui:FindFirstChild(name, true)
end

function PrismGlass:SetDisplayOrder(order)
    if self.ScreenGui then self.ScreenGui.DisplayOrder = order end
    return order
end

function PrismGlass:SetZIndex(index)
    if self.Root then self.Root.ZIndex = index end
    return index
end

function PrismGlass:SetBackgroundVisible(visible)
    local background = self.ScreenGui and self.ScreenGui:FindFirstChild("AuroraBackground")
    if background then background.Visible = visible end
end

function PrismGlass:SetWorldBlur(size)
    if not self._worldBlur then
        self._worldBlur = New("BlurEffect", {Name = "PrismFusionBlur", Size = 0}, Lighting)
    end
    TweenService:Create(self._worldBlur, self.Motion.Smooth, {Size = math.clamp(size or 5, 0, 56)}):Play()
end

function PrismGlass:ClearWorldBlur()
    if self._worldBlur then self._worldBlur.Size = 0 end
end

function PrismGlass:Tween(instance, properties, info)
    local tween = TweenService:Create(instance, info or self.Motion.Smooth, properties)
    tween:Play()
    return tween
end

function PrismGlass:TweenPromise(instance, properties, info)
    local signal = PrismGlass.Signal.new()
    local tween = TweenService:Create(instance, info or self.Motion.Smooth, properties)
    local connection
    connection = tween.Completed:Connect(function(state)
        connection:Disconnect()
        signal:Fire(state)
        signal:Destroy()
    end)
    tween:Play()
    return signal
end

function PrismGlass:FadeIn(instance, duration)
    local original = instance.BackgroundTransparency
    instance.BackgroundTransparency = 1
    self:Tween(instance, {BackgroundTransparency = original}, TweenInfo.new(duration or 0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out))
    return instance
end

