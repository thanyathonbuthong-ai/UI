        Name = "Holder", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 0), AutomaticSize = Enum.AutomaticSize.Y,
        Parent = scroll,
    })
    list(holder, Enum.FillDirection.Vertical, r.TabGap, Enum.HorizontalAlignment.Center)
    local indicator = create("Frame", {
        Name = "Indicator", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0),
        Size = UDim2.fromOffset(r.TabSize, r.TabSize), BackgroundColor3 = WHITE, Visible = false, ZIndex = 0, Parent = scroll,
    })
    corner(indicator, 6)
    Theme.gradient(create("UIGradient", { Rotation = 45, Parent = indicator }), { "TabHighlight", "TabButtonSelected", "TabShadow" }, { 0, 0.5, 1 })
    self._rail = { Holder = holder, Indicator = indicator, Buttons = {}, Cursor = 0 }

    --  Page holder (rounded content panel) ----------------------------------
    local panel = create("Frame", {
        Name = "Panel", Position = UDim2.fromOffset(r.Width, 0), Size = UDim2.new(1, -r.Width, 1, 0), Parent = win,
    })
    panel.BackgroundTransparency = 0
    Theme.bind(panel, "BackgroundColor3", "Background")
    corner(panel, 12)
    stroke(panel, "Outline")
    panel.ZIndex = 0

    --  Accent line along the top of the window --------------------------------
    local top = create("Frame", { Name = "AccentLine", Size = UDim2.new(1, 0, 0, 1), ZIndex = 5, Parent = win })
    top.BackgroundTransparency = 0.08
    Theme.bind(top, "BackgroundColor3", "Accent")
    create("UIGradient", {
        Transparency = fadeEnds({ { 0, 1 }, { 0.06, 0.35 }, { 0.5, 0 }, { 0.94, 0.35 }, { 1, 1 } }), Parent = top,
    })

    --  Drag bar + resize handle -----------------------------------------------
    local drag = create("TextButton", { Name = "DragBar", Size = UDim2.new(1, 0, 0, 20), ZIndex = 50, Parent = win })
    self._drag = drag
    local startMouse, startPos
    bindDrag(j, drag, function(p)
        if not startMouse then startMouse, startPos = p, win.AbsolutePosition return end
        local d, v, s = p - startMouse, viewport(), win.AbsoluteSize
        win.Position = UDim2.fromOffset(clamp(startPos.X + d.X, 0, math.max(0, v.X - s.X)), clamp(startPos.Y + d.Y, 0, math.max(0, v.Y - s.Y)))
    end, function() startMouse = nil end, function()
        startMouse = nil
        self._state.Position = { win.AbsolutePosition.X, win.AbsolutePosition.Y }
        self:_SaveState()
    end)

    local grip = create("TextButton", { Name = "Resize", AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1, 1), Size = UDim2.fromOffset(20, 20), ZIndex = 60, Parent = win })
    for i, w in ipairs({ 9, 5 }) do
        local line = create("Frame", {
            AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -2, 1, i == 1 and -4 or -7), Size = UDim2.fromOffset(w, 2),
            Rotation = -45, ZIndex = 61, Parent = grip,
        })
        Theme.bind(line, "BackgroundColor3", i == 1 and "Outline" or "Accent")
    end
    local startSize
    bindDrag(j, grip, function(p)
        if not startMouse then startMouse, startSize = p, win.AbsoluteSize return end
        local d, v = p - startMouse, viewport()
        win.Size = UDim2.fromOffset(clamp(startSize.X + d.X, m.MinSize.X, v.X), clamp(startSize.Y + d.Y, m.MinSize.Y, v.Y))
    end, function() startMouse = nil end, function()
        startMouse = nil
        self._state.Size = { win.AbsoluteSize.X, win.AbsoluteSize.Y }
        self:_SaveState()
    end)

    --  Overlay: popups + tooltip ------------------------------------------------
    local root = create("Frame", { Name = "Root", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = self._overlay })
    self._overlayRoot = root
    local blocker = create("TextButton", { Name = "Blocker", Size = UDim2.fromScale(1, 1), ZIndex = 1, Visible = false, Parent = root })
    self._blocker = blocker
    j:Add(blocker.InputBegan:Connect(function(input)
        local t = input.UserInputType
        if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 or t == Enum.UserInputType.Touch then
            self:ClosePopup()
        end
    end))

    local tipFrame = create("Frame", { Name = "Tooltip", AutomaticSize = Enum.AutomaticSize.XY, Visible = false, ZIndex = 50, Parent = root })
    tipFrame.BackgroundTransparency = 0.05
    Theme.bind(tipFrame, "BackgroundColor3", "Background")
    corner(tipFrame, 4)
    stroke(tipFrame, "Outline")
    local tipLabel = create("TextLabel", {
        AutomaticSize = Enum.AutomaticSize.XY, TextSize = 13, TextWrapped = true, ZIndex = 51, Parent = tipFrame,
    })
    Theme.bind(tipLabel, "TextColor3", "TextColor")
    pad(tipLabel, 5, 8, 5, 8)
    create("UISizeConstraint", { MaxSize = Vector2.new(280, math.huge), Parent = tipLabel })
    self._tooltip = { Frame = tipFrame, Label = tipLabel }

    self:_BuildHud()
    self:_BindInput()

    --  Re-clamp when the viewport changes ----------------------------------------
    local cam = workspace.CurrentCamera
    if cam then
        j:Add(cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            local v, s = viewport(), win.AbsoluteSize
            local ns = Vector2.new(math.min(s.X, v.X), math.min(s.Y, v.Y))
            win.Size = UDim2.fromOffset(ns.X, ns.Y)
            local p = win.AbsolutePosition
            win.Position = UDim2.fromOffset(clamp(p.X, 0, math.max(0, v.X - ns.X)), clamp(p.Y, 0, math.max(0, v.Y - ns.Y)))
        end))
    end

    env.KiciaUI = self
    return self
end

--==========================================================================
--  State persistence
--==========================================================================
function Menu:_LoadState()
    self._state = {}
    if not (FS.read and FS.isfile) then return end
    local path = self.Directory .. "/state.json"
    pcall(function()
        if FS.isfile(path) then
            local data = HttpService:JSONDecode(FS.read(path))
            if type(data) == "table" then self._state = data end
        end
    end)
end

function Menu:_SaveState()
    if not FS.write or self._saveQueued then return end
    self._saveQueued = true
    task.delay(0.4, function()
        self._saveQueued = false
        self._state.Keybind = serializeKey(self.Keybind)
        pcall(function() FS.write(self.Directory .. "/state.json", HttpService:JSONEncode(self._state)) end)
    end)
end

--==========================================================================
--  Rail buttons / tab selection
--==========================================================================
function Menu:_NewRailButton(label, icon)
    local r = self.Metrics.Rail
    local rail = self._rail
    local index = #rail.Buttons + 1
    local btn = create("TextButton", {
        Name = label, Size = UDim2.fromOffset(r.TabSize, r.TabSize), LayoutOrder = index * 10, Parent = rail.Holder,
    })
    local img = create("ImageLabel", {
        Image = icon, ImageColor3 = Theme.Tokens.Unselected,
        AnchorPoint = Vector2.new(0.5, r.ShowLabels and 0 or 0.5),
        Position = r.ShowLabels and UDim2.new(0.5, 0, 0, 10) or UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(r.TabIconSize, r.TabIconSize), Parent = btn,
    })
    local txt = create("TextLabel", {
        Visible = r.ShowLabels, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6),
        Size = UDim2.new(1, -4, 0, 14), Text = label, TextSize = 10, FontFace = Fonts.Bold,
        TextTruncate = Enum.TextTruncate.AtEnd, TextColor3 = Theme.Tokens.Unselected, Parent = btn,
    })

    local y = rail.Cursor
    rail.Cursor = y + r.TabSize + r.TabGap
    local obj = { Button = btn, Index = index, Y = y, Selected = false, Clicked = self._j:Add(Signal.new()) }
    local function paint(instant)
        local c = obj.Selected and Theme.Tokens.Accent or Theme.Tokens.Unselected
        if instant then
            img.ImageColor3, txt.TextColor3 = c, c
        else
            tween(img, { ImageColor3 = c })
            tween(txt, { TextColor3 = c })
        end
    end
    function obj:SetSelected(s)
        if obj.Selected == s then return end
        obj.Selected = s
        paint(false)
    end
    self._j:Add(btn.MouseButton1Click:Connect(function() obj.Clicked:Fire() end))
    self._j:Add(btn.MouseEnter:Connect(function()
        if not obj.Selected then tween(img, { ImageColor3 = Theme.Tokens.TextColor }) end
    end))
    self._j:Add(btn.MouseLeave:Connect(function()
        if not obj.Selected then tween(img, { ImageColor3 = Theme.Tokens.Unselected }) end
    end))
    self._j:Add(Theme.onChange("Accent", function() if obj.Selected then paint(true) end end))
    self._j:Add(Theme.onChange("Unselected", function() if not obj.Selected then paint(true) end end))
    if not r.ShowLabels then self:AttachTooltip(self._j, btn, label) end
    rail.Buttons[index] = obj
    return obj
end

function Menu:_SelectTab(tab)
    local old = self._activeTab
    if old == tab then return end
    self:ClosePopup()
    if old then
        old._button:SetSelected(false)
        fadePage(old._page, false)
        old.Opened:Fire(false)
    end
    self._activeTab = tab
    tab._button:SetSelected(true)
    fadePage(tab._page, true)

    local r = self.Metrics.Rail
    local ind = self._rail.Indicator
    local y = tab._button.Y
    local target = UDim2.new(0.5, 0, 0, y)
    if not ind.Visible then
        ind.Position = target
        ind.Visible = true
    else
        tween(ind, { Position = target })
    end
    tab.Opened:Fire(true)
end

function Menu:AddTab(opts) return Tab.new(self, opts or {}) end
function Menu:GetTab(label)
    for _, t in ipairs(self._tabs) do if t.Label == label then return t end end
end

--==========================================================================
--  Visibility, accent, input
--==========================================================================
function Menu:SetVisible(v)
    v = v == true
    if self.Visible == v then return end
    self.Visible = v
    self._window.Visible = v
    self._drag.Modal = v
    if not v then
        self:ClosePopup()
        self:_HideTooltip()
    end
    if self._pill then self._pill.TextColor3 = v and Theme.Tokens.Accent or Theme.Tokens.TextColor end
    self.VisibilityChanged:Fire(v)
end

function Menu:Toggle() self:SetVisible(not self.Visible) end
function Menu:SetAccent(color) Theme.set("Accent", color) end
function Menu:SetKeybind(key)
    self.Keybind = key
    self:_SaveState()
end

function Menu:_BindInput()
    local j = self._j
    j:Add(UserInputService.InputBegan:Connect(function(input)
        if self._capturing then return end
        local bind = inputToBind(input)
        if not bind or UserInputService:GetFocusedTextBox() then return end
        if bind == self.Keybind then self:Toggle() end
        for _, kb in ipairs(table.clone(self._keybinds)) do kb:_OnInput(bind, true) end
    end))
    j:Add(UserInputService.InputEnded:Connect(function(input)
        local bind = inputToBind(input)
        if not bind then return end
        for _, kb in ipairs(table.clone(self._keybinds)) do kb:_OnInput(bind, false) end
    end))
end

--==========================================================================
--  HUD: watermark, keybind list, notifications, mobile button
--==========================================================================
local NOTIFY_COLORS = {
    info    = nil, -- accent
    success = Color3.fromRGB(88, 196, 126),
    warning = Color3.fromRGB(232, 184, 74),
    error   = Color3.fromRGB(224, 86, 86),
}

function Menu:_BuildHud()
    local j, hud, m = self._j, self._hud, self.Metrics

    --  Watermark ----------------------------------------------------------
    local wm = create("Frame", {
        Name = "Watermark", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12),
        AutomaticSize = Enum.AutomaticSize.XY, Parent = hud,
    })
    wm.BackgroundTransparency = 0.1
    Theme.bind(wm, "BackgroundColor3", "Background")
    corner(wm, 5)
    stroke(wm, "Outline")
    pad(wm, 6, 10, 6, 10)
    list(wm, Enum.FillDirection.Horizontal, 8, nil, Enum.VerticalAlignment.Center)
    local icon = create("ImageLabel", { Size = UDim2.fromOffset(16, 16), Image = self.Icon, ScaleType = Enum.ScaleType.Fit, Parent = wm })
    Theme.bind(icon, "ImageColor3", "Accent")
    local wmText = create("TextLabel", {
        Size = UDim2.fromOffset(0, 16), AutomaticSize = Enum.AutomaticSize.X, FontFace = Fonts.SemiBold, TextSize = 13,
        LayoutOrder = 2, Parent = wm,
    })
    Theme.bind(wmText, "TextColor3", "TextColor")
    self._wm = { Frame = wm, Text = wmText }

    local frames, last, fps = 0, os.clock(), 0
    j:Add(RunService.RenderStepped:Connect(function() frames = frames + 1 end))
    local function refreshWatermark()
        local parts = { self.Title, self._username, fps .. " fps" }
        local ok, ping = pcall(function() return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() end)
        if ok and ping then table.insert(parts, math.floor(ping + 0.5) .. " ms") end
        if self._wmExtra then table.insert(parts, self._wmExtra) end
        wmText.Text = table.concat(parts, "  |  ")
    end
    refreshWatermark()
    j:Add(task.spawn(function()
        while true do
            task.wait(0.5)
            local now = os.clock()
            fps = math.floor(frames / math.max(now - last, 0.001) + 0.5)
            frames, last = 0, now
            refreshWatermark()
        end
    end))

    --  Keybind list ---------------------------------------------------------
    local kl = create("Frame", {
        Name = "KeybindList", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 0),
        AutomaticSize = Enum.AutomaticSize.XY, Visible = false, Parent = hud,
    })
    kl.BackgroundTransparency = 0.1
    Theme.bind(kl, "BackgroundColor3", "Background")
    corner(kl, 5)
    stroke(kl, "Outline")
    pad(kl, 6, 10, 6, 10)
    list(kl, Enum.FillDirection.Vertical, 2)
    local klTitle = create("TextLabel", {
        Size = UDim2.fromOffset(0, 16), AutomaticSize = Enum.AutomaticSize.X, Text = "Keybinds", FontFace = Fonts.Bold,
        TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = -1, Parent = kl,
    })
    Theme.bind(klTitle, "TextColor3", "Accent")
    self._keybindList = { Frame = kl, Entries = {} }

    --  Notifications --------------------------------------------------------
    local nf = create("Frame", { Name = "Notifications", BackgroundTransparency = 1, Parent = hud })
    local nfList = list(nf, Enum.FillDirection.Vertical, 6)
    self._notifHolder, self._notifList = nf, nfList
    self:SetNotificationSide(self._notifSide)

    --  Mobile menu button -----------------------------------------------------
    if UserInputService.TouchEnabled or self._openButton then
        local pill = create("TextButton", {
            Name = "MenuButton", Position = UDim2.fromOffset(10, 64), Size = UDim2.fromOffset(64, 30), Text = "Menu",
            FontFace = Fonts.SemiBold, TextSize = 14, Parent = hud,
        })
        pill.BackgroundTransparency = 0.1
        Theme.bind(pill, "BackgroundColor3", "Background")
        Theme.bind(pill, "TextColor3", "TextColor")
        corner(pill, 6)
        stroke(pill, "Outline")
        j:Add(pill.MouseButton1Click:Connect(function() self:Toggle() end))
        self._pill = pill
    end
end

function Menu:SetWatermarkVisible(v) self._showWatermark = v == true self._wm.Frame.Visible = v == true end
function Menu:SetWatermarkText(extra) self._wmExtra = extra end

function Menu:SetKeybindListVisible(v)
    self._showKeybindList = v == true
    self:_RefreshKeybindList()
end

function Menu:_RefreshKeybindList()
    local kl = self._keybindList
    if not kl then return end
    for _, e in ipairs(kl.Entries) do e:Destroy() end
    kl.Entries = {}
    local any = false
    for i, kb in ipairs(self._keybinds) do
        if kb.ShowInList and not kb.NoMode and kb.Bind ~= nil and kb.State then
            any = true
            local e = create("TextLabel", {
                Size = UDim2.fromOffset(0, 16), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = i,
                Text = string.format("[%s]  %s  (%s)", keyName(kb.Bind), kb:GetLabel(), kb.Mode),
                TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = kl.Frame,
            })
            Theme.bind(e, "TextColor3", "TextColor")
            table.insert(kl.Entries, e)
        end
    end
    kl.Frame.Visible = any and self._showKeybindList
end

function Menu:SetNotificationSide(side)
    local right, bottom = side:find("Right") ~= nil, side:find("Bottom") ~= nil
    self._notifSide = side
    local nf = self._notifHolder
    nf.AnchorPoint = Vector2.new(right and 1 or 0, 0)
    nf.Position = UDim2.new(right and 1 or 0, right and -12 or 12, 0, right and 56 or 12)
    nf.Size = UDim2.new(0, 270, 1, right and -68 or -24)
    self._notifList.HorizontalAlignment = right and Enum.HorizontalAlignment.Right or Enum.HorizontalAlignment.Left
    self._notifList.VerticalAlignment = bottom and Enum.VerticalAlignment.Bottom or Enum.VerticalAlignment.Top
    self._notifBottom = bottom
end

--  Menu:Notify("Title", "Text", { Type = "success", Lifetime = 5 })   or   Menu:Notify({ Title=..., Text=... })
function Menu:Notify(a, b, c)
    local o = a
    if type(a) ~= "table" then
        o = { Title = a, Text = b }
        if type(c) == "table" then for k, v in pairs(c) do o[k] = v end end
    end
    local color = NOTIFY_COLORS[o.Type or "info"] or Theme.Tokens.Accent
    local lifetime = o.Lifetime or 5
    self._notifCounter = self._notifCounter + 1

    local toast = create("CanvasGroup", {
        Name = "Toast", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, GroupTransparency = 1,
        LayoutOrder = self._notifBottom and self._notifCounter or -self._notifCounter, Parent = self._notifHolder,
    })
    toast.BackgroundTransparency = 0
    Theme.bind(toast, "BackgroundColor3", "Background")
    corner(toast, 6)
    stroke(toast, "Outline")

    local bar = create("Frame", { Size = UDim2.new(0, 3, 1, 0), BackgroundColor3 = color, Parent = toast })
    local body = create("Frame", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = toast,
    })
    pad(body, 8, 10, 12, 14)
    list(body, Enum.FillDirection.Vertical, 2)
    local icon = assetImage(o.Icon)
    local head = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18), Parent = body })
    if icon then
        local im = create("ImageLabel", {
            AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(16, 16), Image = icon, Parent = head,
        })
        im.ImageColor3 = color
    end
    local title = create("TextLabel", {
        Position = UDim2.fromOffset(icon and 22 or 0, 0), Size = UDim2.new(1, icon and -22 or 0, 1, 0), Text = tostring(o.Title or ""),
        FontFace = Fonts.SemiBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, Parent = head,
    })
    Theme.bind(title, "TextColor3", "TextColor")
    if o.Text and o.Text ~= "" then
        local text = create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Text = tostring(o.Text), TextSize = 13,
            TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
            LayoutOrder = 2, Parent = body,
        })
        Theme.bind(text, "TextColor3", "Unselected")
    end
    local prog = create("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = color, Parent = toast })

    local entry = { Toast = toast }
    local gone = false
    function entry:Dismiss()
        if gone then return end
        gone = true
        local i = table.find(self._stackRef, entry)
        if i then table.remove(self._stackRef, i) end
        local tw = tween(toast, { GroupTransparency = 1 }, TweenInfo.new(0.2))
        tw.Completed:Once(function() toast:Destroy() end)
    end
    entry._stackRef = self._notifStack
    table.insert(self._notifStack, entry)
    while #self._notifStack > 6 do self._notifStack[1]:Dismiss() end

    tween(toast, { GroupTransparency = 0 }, TweenInfo.new(0.2))
    tween(prog, { Size = UDim2.new(0, 0, 0, 2) }, TweenInfo.new(lifetime, Enum.EasingStyle.Linear))
    task.delay(lifetime, function() entry:Dismiss() end)
    return entry
end

function Menu:ClearNotifications()
    for _, e in ipairs(table.clone(self._notifStack)) do e:Dismiss() end
end

--==========================================================================
--  Config manager
--==========================================================================
local function safeName(n)
    n = tostring(n or "")
    n = n:gsub("[^%w_%- ]", "")
    return (n:match("^%s*(.-)%s*$"))
end

function Menu:GetConfig()
    local data = {}
    for flag, ctrl in pairs(self.Flags) do
        if ctrl._Serialize then data[flag] = ctrl:_Serialize() end
    end
    return data
end

function Menu:SetConfig(data)
    if type(data) ~= "table" then return end
    for flag, value in pairs(data) do
        local ctrl = self.Flags[flag]
        if ctrl and ctrl._Deserialize then pcall(ctrl._Deserialize, ctrl, value) end
    end
end

function Menu:_ConfigPath(name) return string.format("%s/configs/%s.json", self.Directory, name) end

function Menu:SaveConfig(name)
    name = safeName(name)
    if name == "" then return false, "Enter a config name" end
    if not FS.write then return false, "Executor has no writefile" end
    local ok, err = pcall(function()
        FS.write(self:_ConfigPath(name), HttpService:JSONEncode({ Version = 1, Flags = self:GetConfig() }))
    end)
    return ok, ok and name or tostring(err)
end

function Menu:LoadConfig(name)
    name = safeName(name)
    if name == "" then return false, "No config selected" end
    if not (FS.read and FS.isfile) then return false, "Executor has no readfile" end
    local path = self:_ConfigPath(name)
    if not FS.isfile(path) then return false, "Config not found" end
    local ok, data = pcall(function() return HttpService:JSONDecode(FS.read(path)) end)
    if not ok or type(data) ~= "table" then return false, "Config is corrupted" end
    self:SetConfig(data.Flags or data)
    return true, name
end

function Menu:DeleteConfig(name)
    name = safeName(name)
    local path = self:_ConfigPath(name)
    if not (FS.del and FS.isfile and FS.isfile(path)) then return false, "Config not found" end
    local ok = pcall(FS.del, path)
    return ok, name
end

function Menu:ListConfigs()
    local names = {}
    if FS.list then
        pcall(function()
            for _, f in ipairs(FS.list(self.Directory .. "/configs")) do
                local n = tostring(f):match("([^/\\]+)%.json$")
                if n then table.insert(names, n) end
            end
        end)
    end
    table.sort(names)
    return names
end

function Menu:SetAutoLoad(name)
    if not FS.write then return false end
    return pcall(FS.write, self.Directory .. "/autoload.txt", name and safeName(name) or "")
end

function Menu:GetAutoLoad()
    local path = self.Directory .. "/autoload.txt"
    if not (FS.read and FS.isfile and FS.isfile(path)) then return nil end
    local ok, v = pcall(FS.read, path)
    v = ok and safeName(v) or ""
    return v ~= "" and v or nil
end

--  Call once after every tab has been built.
function Menu:LoadAutoConfig()
    local name = self:GetAutoLoad()
    if not name then return false end
    local ok, res = self:LoadConfig(name)
    if ok then self:Notify("Config", "Auto-loaded " .. name, { Type = "success" }) end
    return ok, res
end

