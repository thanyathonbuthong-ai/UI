            Parent = page,
        })
        Theme.bind(desc, "TextColor3", "Unselected")
    end
    self._hdr = hdr
    self._content = create("Frame", {
        Name = "Content", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, hdr),
        Size = UDim2.new(1, 0, 1, -hdr), Parent = page,
    })

    self._j:Connect(self._button.Clicked, function() menu:_SelectTab(self) end)
