-- // =====================================================================
-- // Theme System  (ported from WindUI's theme manager, adapted to ZyronX)
-- // Every colour used by the UI is a token; Library:SetTheme() swaps them live.
-- // =====================================================================
local ThemeTokens = {"Accent", "Background", "Card", "Hover", "Text", "SubText", "Stroke", "Stroke2", "Divider", "Field", "Popup", "Notif", "Panel", "Code", "Scroll", "Scroll2"}

local function RGB(r, g, b) return Color3.fromRGB(r, g, b) end

local DarkTheme = {
    Accent = RGB(190, 140, 255), Background = RGB(18, 18, 20), Card = RGB(24, 24, 27), Hover = RGB(35, 35, 40),
    Text = RGB(240, 240, 240), SubText = RGB(150, 150, 150), Stroke = RGB(45, 45, 50), Stroke2 = RGB(50, 50, 55),
    Divider = RGB(40, 40, 45), Field = RGB(15, 15, 18), Popup = RGB(20, 20, 24), Notif = RGB(20, 20, 22),
    Panel = RGB(16, 16, 20), Code = RGB(10, 10, 12), Scroll = RGB(60, 60, 65), Scroll2 = RGB(80, 80, 85),
}

local function DarkVariant(accent)
    local t = {}
    for k, v in pairs(DarkTheme) do t[k] = v end
    t.Accent = accent
    return t
end

Library.Themes = {
    Dark = DarkTheme,
    Light = {
        Accent = RGB(112, 72, 232), Background = RGB(236, 236, 242), Card = RGB(248, 248, 252), Hover = RGB(224, 224, 232),
        Text = RGB(28, 28, 34), SubText = RGB(110, 110, 122), Stroke = RGB(205, 205, 215), Stroke2 = RGB(198, 198, 208),
        Divider = RGB(214, 214, 222), Field = RGB(242, 242, 247), Popup = RGB(250, 250, 253), Notif = RGB(246, 246, 250),
        Panel = RGB(244, 244, 249), Code = RGB(232, 232, 240), Scroll = RGB(190, 190, 200), Scroll2 = RGB(170, 170, 182),
    },
    Rose = DarkVariant(RGB(255, 105, 150)),
    Ocean = DarkVariant(RGB(80, 170, 255)),
    Emerald = DarkVariant(RGB(70, 210, 140)),
    Amber = DarkVariant(RGB(255, 185, 60)),
}

local CurrentThemeName = "Dark"
local ThemeRoots = {}          -- every ScreenGui created by the library (for live re-theming)
local GlobalScreenGui = nil    -- last created ScreenGui (used by Library:Popup)

local AccentColor     = DarkTheme.Accent
local BackgroundColor = DarkTheme.Background
local CardColor       = DarkTheme.Card
local HoverColor      = DarkTheme.Hover
local TextColor       = DarkTheme.Text
local SubTextColor    = DarkTheme.SubText
local StrokeColor     = DarkTheme.Stroke
local Stroke2Color    = DarkTheme.Stroke2
local DividerColor    = DarkTheme.Divider
local FieldColor      = DarkTheme.Field
local PopupColor      = DarkTheme.Popup
local NotifColor      = DarkTheme.Notif
local PanelColor      = DarkTheme.Panel
local CodeColor       = DarkTheme.Code
local ScrollColor     = DarkTheme.Scroll
local Scroll2Color    = DarkTheme.Scroll2

local function ApplyTokens(t)
    AccentColor, BackgroundColor, CardColor, HoverColor = t.Accent, t.Background, t.Card, t.Hover
    TextColor, SubTextColor, StrokeColor, Stroke2Color = t.Text, t.SubText, t.Stroke, t.Stroke2
    DividerColor, FieldColor, PopupColor, NotifColor = t.Divider, t.Field, t.Popup, t.Notif
    PanelColor, CodeColor, ScrollColor, Scroll2Color = t.Panel, t.Code, t.Scroll, t.Scroll2
end

local function ColorId(c)
    return math.floor(c.R * 255 + 0.5) * 65536 + math.floor(c.G * 255 + 0.5) * 256 + math.floor(c.B * 255 + 0.5)
end

local function RecolorTree(root, map)
    local function remap(inst, prop)
        local n = map[ColorId(inst[prop])]
        if n then inst[prop] = n end
    end
    for _, d in ipairs(root:GetDescendants()) do
        if not d:GetAttribute("ZX_NoTheme") then
            if d:IsA("GuiObject") then remap(d, "BackgroundColor3") end
            if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                remap(d, "TextColor3")
                if d:IsA("TextBox") then remap(d, "PlaceholderColor3") end
            elseif d:IsA("ImageLabel") or d:IsA("ImageButton") then
                remap(d, "ImageColor3")
            elseif d:IsA("ScrollingFrame") then
                remap(d, "ScrollBarImageColor3")
            elseif d:IsA("UIStroke") then
                remap(d, "Color")
            end
        end
    end
end

function Library:AddTheme(theme)
    if type(theme) ~= "table" or not theme.Name then
        warn("[ZyronX] AddTheme expects a table with a Name field.")
        return
    end
    local t = {}
    for _, key in ipairs(ThemeTokens) do t[key] = theme[key] or DarkTheme[key] end
    Library.Themes[theme.Name] = t
end

function Library:GetThemes()
    local names = {}
    for name in pairs(Library.Themes) do table.insert(names, name) end
    table.sort(names)
    return names
end

function Library:GetTheme() return CurrentThemeName end

function Library:SetTheme(name)
    local new = Library.Themes[name]
    if not new then warn("[ZyronX] Unknown theme: " .. tostring(name)) return false end
    if name == CurrentThemeName then return true end
    local old = Library.Themes[CurrentThemeName]
    local map = {}
    for _, key in ipairs(ThemeTokens) do map[ColorId(old[key])] = new[key] end
    ApplyTokens(new)
    CurrentThemeName = name
    for i = #ThemeRoots, 1, -1 do
        local gui = ThemeRoots[i]
        if gui and gui.Parent then RecolorTree(gui, map) else table.remove(ThemeRoots, i) end
    end
    return true
end


