                    local custom = cfg.Color
                    local Wrap, SetDesc = NewSlot(cfg)

                    local BtnFrame = Create("Frame", {Parent = Wrap, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 1})
                    local Btn = Create("TextButton", {Parent = BtnFrame, Text = name, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = custom and Color3.fromRGB(255, 255, 255) or TextColor, BackgroundColor3 = custom or BackgroundColor, Size = UDim2.new(1, -20, 1, 0), Position = UDim2.new(0, 10, 0, 0), AutoButtonColor = false, NoTheme = custom ~= nil})
                    Create("UICorner", {Parent = Btn, CornerRadius = UDim.new(0, 4)})
                    Create("UIStroke", {Parent = Btn, Color = custom and custom:Lerp(Color3.new(1, 1, 1), 0.15) or StrokeColor, Thickness = 1, NoTheme = custom ~= nil})
                    if cfg.Icon then
                        Create("ImageLabel", {Parent = Btn, BackgroundTransparency = 1, Image = ToImage(cfg.Icon), ImageColor3 = custom and Color3.fromRGB(255, 255, 255) or TextColor, Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(0, 8, 0.5, -7)})
                    end

                    AddBounce(Btn)
                    Btn.MouseEnter:Connect(function() Tween(Btn, {BackgroundColor3 = custom and custom:Lerp(Color3.new(1, 1, 1), 0.12) or HoverColor}, 0.2) end)
                    Btn.MouseLeave:Connect(function() Tween(Btn, {BackgroundColor3 = custom or BackgroundColor}, 0.2) end)

                    local api = {}
                    Btn.MouseButton1Click:Connect(function() if not api.Locked then SafeCall(cfg.Callback) end end)
                    AddInfoIcon(BtnFrame, UDim2.new(1, -40, 0.5, -8), cfg.Info)

                    AttachAPI(api, cfg, Wrap, BtnFrame, SetDesc, Btn, nil)
                    function api:SetCallback(fn) cfg.Callback = fn end
                    return api
                end

                -- ======================================================================
                -- Toggle   (Type = "Toggle" | "Checkbox")
                -- ======================================================================
                function Elements:AddToggle(a, b, c, d)
                    local cfg = type(a) == "table" and a or {Title = a, Value = b, Callback = c, Info = d}
                    local name = cfg.Title or cfg.Name or "Toggle"
                    local state = cfg.Value
                    if state == nil then state = cfg.Default end
                    state = state == true
                    local isCheckbox = cfg.Type == "Checkbox"
                    local Wrap, SetDesc = NewSlot(cfg)

                    local TogFrame = Create("Frame", {Parent = Wrap, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 1})
                    local RowBtn = Create("TextButton", {Parent = TogFrame, Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), AutoButtonColor = false})
                    local TitleLbl = Create("TextLabel", {Parent = TogFrame, Text = name, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = SubTextColor, BackgroundTransparency = 1, Size = UDim2.new(1, -60, 1, 0), Position = UDim2.new(0, 10, 0, 0), TextXAlignment = Enum.TextXAlignment.Left})

                    local Lever, Visual
                    if isCheckbox then
                        Lever = Create("TextButton", {Parent = TogFrame, Text = "", BackgroundColor3 = state and AccentColor or StrokeColor, Size = UDim2.new(0, 18, 0, 18), Position = UDim2.new(1, -28, 0.5, -9), AutoButtonColor = false})
                        Create("UICorner", {Parent = Lever, CornerRadius = UDim.new(0, 4)})
                        local Check = Create("TextLabel", {Parent = Lever, Text = "✓", Font = Enum.Font.GothamBold, TextSize = 12, NoScale = true, TextColor3 = Color3.fromRGB(255, 255, 255), BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), TextTransparency = state and 0 or 1})
                        Visual = function()
                            Tween(Lever, {BackgroundColor3 = state and AccentColor or StrokeColor}, 0.25)
                            Tween(Check, {TextTransparency = state and 0 or 1}, 0.25)
                        end
                    else
                        Lever = Create("TextButton", {Parent = TogFrame, Text = "", BackgroundColor3 = state and AccentColor or StrokeColor, Size = UDim2.new(0, 36, 0, 18), Position = UDim2.new(1, -46, 0.5, -9), AutoButtonColor = false})
                        Create("UICorner", {Parent = Lever, CornerRadius = UDim.new(1, 0)})
                        local Knob = Create("Frame", {Parent = Lever, BackgroundColor3 = Color3.fromRGB(255, 255, 255), Size = UDim2.new(0, 14, 0, 14), Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7), NoTheme = true})
                        Create("UICorner", {Parent = Knob, CornerRadius = UDim.new(1, 0)})
                        Visual = function()
                            Tween(Lever, {BackgroundColor3 = state and AccentColor or StrokeColor}, 0.3)
                            Tween(Knob, {Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)}, 0.3)
                        end
                    end
                    AddBounce(Lever)

                    local function internalSet(val)
                        state = (val == true)
                        Visual()
                        SafeCall(cfg.Callback, state)
                    end

                    RowBtn.MouseButton1Click:Connect(function() internalSet(not state) end)
                    Lever.MouseButton1Click:Connect(function() internalSet(not state) end)
                    AddInfoIcon(TogFrame, isCheckbox and UDim2.new(1, -56, 0.5, -8) or UDim2.new(1, -70, 0.5, -8), cfg.Info)

                    local key = cfg.Flag or name
                    Register(key, internalSet, function() return state end)

                    local api = {}
                    function api:Set(v) internalSet(v) end
                    function api:Get() return state end
                    AttachAPI(api, cfg, Wrap, TogFrame, SetDesc, TitleLbl, key)
                    return api
                end

                -- ======================================================================
                -- Slider   (Value = {Min, Max, Default} | positional min/max/default, Step, Suffix)
                -- ======================================================================
                function Elements:AddSlider(a, b, c, d, e, f)
                    local cfg
                    if type(a) == "table" then cfg = a else cfg = {Title = a, Min = b, Max = c, Value = d, Callback = e, Info = f} end
                    local name = cfg.Title or cfg.Name or "Slider"
                    local range = type(cfg.Value) == "table" and cfg.Value or {}
                    local min = cfg.Min or range.Min or 0
                    local max = cfg.Max or range.Max or 100
                    if max == min then max = min + 1 end
                    local step = cfg.Step or 1
                    local suffix = cfg.Suffix or ""
                    local decimals = 0
                    do
                        local s = tostring(step)
                        local dot = s:find("%.")
                        if dot then decimals = #s - dot end
                    end

                    local function Snap(v)
                        v = math.clamp(tonumber(v) or min, min, max)
                        v = math.floor((v - min) / step + 0.5) * step + min
                        if decimals > 0 then v = tonumber(string.format("%." .. decimals .. "f", v)) end
                        return math.clamp(v, min, max)
                    end

                    local val = Snap(type(cfg.Value) == "number" and cfg.Value or range.Default or cfg.Default or min)
                    local valW = (suffix ~= "") and 50 or 30
                    local Wrap, SetDesc = NewSlot(cfg)

                    local SliFrame = Create("Frame", {Parent = Wrap, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 45), LayoutOrder = 1})
                    local TitleLbl = Create("TextLabel", {Parent = SliFrame, Text = name, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = SubTextColor, BackgroundTransparency = 1, Size = UDim2.new(1, -20, 0, 15), Position = UDim2.new(0, 10, 0, 0), TextXAlignment = Enum.TextXAlignment.Left})
                    local ValTxt = Create("TextLabel", {Parent = SliFrame, Text = tostring(val) .. suffix, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = TextColor, BackgroundTransparency = 1, Size = UDim2.new(0, valW, 0, 15), Position = UDim2.new(1, -(valW + 10), 0, 0), TextXAlignment = Enum.TextXAlignment.Right})

                    local TrackBase = Create("TextButton", {Parent = SliFrame, Text = "", AutoButtonColor = false, BackgroundColor3 = BackgroundColor, Size = UDim2.new(1, -20, 0, 6), Position = UDim2.new(0, 10, 0, 25)})
                    Create("UICorner", {Parent = TrackBase, CornerRadius = UDim.new(1, 0)})
                    Create("UIStroke", {Parent = TrackBase, Color = StrokeColor, Thickness = 1})

                    local Fill = Create("Frame", {Parent = TrackBase, BackgroundColor3 = AccentColor, Size = UDim2.new((val - min) / (max - min), 0, 1, 0)})
                    Create("UICorner", {Parent = Fill, CornerRadius = UDim.new(1, 0)})
                    local Knob = Create("Frame", {Parent = Fill, BackgroundColor3 = Color3.fromRGB(255, 255, 255), Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(1, -6, 0.5, -6), NoTheme = true})
                    Create("UICorner", {Parent = Knob, CornerRadius = UDim.new(1, 0)})

                    local function internalSet(v)
                        val = Snap(v)
                        ValTxt.Text = tostring(val) .. suffix
                        Tween(Fill, {Size = UDim2.new((val - min) / (max - min), 0, 1, 0)}, 0.1)
                        SafeCall(cfg.Callback, val)
                    end

                    local api = {}
                    local dragging = false
                    local function Update(input)
                        local pos = math.clamp((input.Position.X - TrackBase.AbsolutePosition.X) / TrackBase.AbsoluteSize.X, 0, 1)
                        internalSet(min + ((max - min) * pos))
                    end
                    local function StartDrag(input)
                        if api.Locked then return end
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            dragging = true
                            if PageObj and PageObj.Scroll then PageObj.Scroll.ScrollingEnabled = false end
                            Update(input)
                        end
                    end

                    Knob.InputBegan:Connect(StartDrag)
                    TrackBase.InputBegan:Connect(StartDrag)
                    table.insert(Conns, UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            if dragging and PageObj and PageObj.Scroll then PageObj.Scroll.ScrollingEnabled = true end
                            dragging = false
                        end
                    end))
                    table.insert(Conns, UserInputService.InputChanged:Connect(function(input)
                        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then Update(input) end
                    end))
                    AddInfoIcon(SliFrame, UDim2.new(1, -(valW + 35), 0, 0), cfg.Info)

                    local key = cfg.Flag or name
                    Register(key, internalSet, function() return val end)

                    function api:Set(v) internalSet(v) end
                    function api:Get() return val end
                    AttachAPI(api, cfg, Wrap, SliFrame, SetDesc, TitleLbl, key)
                    return api
                end

                -- ======================================================================
                -- Dropdown   (Values, Value, Multi, AllowNone) + :Refresh(values)
                -- ======================================================================
                function Elements:AddDropdown(a, b, c, d, e)
                    local cfg
                    if type(a) == "table" then cfg = a else cfg = {Title = a, Values = b, Multi = c, Callback = d, Info = e} end
                    local name = cfg.Title or cfg.Name or "Dropdown"
                    local isMulti = cfg.Multi == true

                    local function NormalizeValues(vals)
                        local out = {}
                        for _, v in ipairs(vals or {}) do
                            if type(v) == "table" then table.insert(out, tostring(v.Title or v.Name or v.Text or "?")) else table.insert(out, tostring(v)) end
                        end
                        return out
                    end

                    local options = NormalizeValues(cfg.Values or cfg.Options)
                    local selected
                    if isMulti then
                        selected = {}
                        if type(cfg.Value) == "table" then for _, v in ipairs(cfg.Value) do table.insert(selected, tostring(v)) end end
                    else
                        selected = cfg.Value
                        if type(selected) == "number" then selected = options[selected] end
                        if selected == nil and cfg.AllowNone ~= true then selected = options[1] end
                    end

                    local dropped = false
                    local optionButtons = {}
                    local function CalcListHeight() return math.max(math.min(#options, 3), 1) * 25 end
                    local listHeight = CalcListHeight()
                    local Wrap, SetDesc = NewSlot(cfg)

                    local DropFrame = Create("Frame", {Parent = Wrap, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 50), ClipsDescendants = true, LayoutOrder = 1})
                    local TitleLbl = Create("TextLabel", {Parent = DropFrame, Text = name, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = SubTextColor, BackgroundTransparency = 1, Size = UDim2.new(1, -20, 0, 15), Position = UDim2.new(0, 10, 0, 0), TextXAlignment = Enum.TextXAlignment.Left})

                    local MainBtn = Create("TextButton", {Parent = DropFrame, Text = isMulti and "Select Options..." or "Select...", Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = TextColor, BackgroundColor3 = BackgroundColor, Size = UDim2.new(1, -20, 0, 26), Position = UDim2.new(0, 10, 0, 20), AutoButtonColor = false, TextXAlignment = Enum.TextXAlignment.Left})
                    Create("UIPadding", {Parent = MainBtn, PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 28)})
                    Create("UICorner", {Parent = MainBtn, CornerRadius = UDim.new(0, 4)})
                    Create("UIStroke", {Parent = MainBtn, Color = StrokeColor, Thickness = 1})
                    AddBounce(MainBtn, 0.98)
                    local Arrow = Create("TextLabel", {Parent = MainBtn, Text = "▼", Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = SubTextColor, BackgroundTransparency = 1, Size = UDim2.new(0, 20, 1, 0), Position = UDim2.new(1, -28, 0, 0)})

                    local SearchBox = Create("TextBox", {Parent = DropFrame, PlaceholderText = "Search...", Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = TextColor, BackgroundColor3 = FieldColor, Size = UDim2.new(1, -20, 0, 24), Position = UDim2.new(0, 10, 0, 50), TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, Visible = false})
                    Create("UIPadding", {Parent = SearchBox, PaddingLeft = UDim.new(0, 8)})
                    Create("UICorner", {Parent = SearchBox, CornerRadius = UDim.new(0, 4)})
                    Create("UIStroke", {Parent = SearchBox, Color = StrokeColor, Thickness = 1})

                    local ListFrame = Create("ScrollingFrame", {Parent = DropFrame, BackgroundColor3 = BackgroundColor, Size = UDim2.new(1, -20, 0, listHeight), Position = UDim2.new(0, 10, 0, 78), CanvasSize = UDim2.new(0, 0, 0, #options * 25), ScrollBarThickness = 2, ScrollBarImageColor3 = Scroll2Color, BorderSizePixel = 0})
                    Create("UICorner", {Parent = ListFrame, CornerRadius = UDim.new(0, 4)})
                    local DList = Create("UIListLayout", {Parent = ListFrame, SortOrder = Enum.SortOrder.LayoutOrder})

                    local function IsSelected(opt)
                        if isMulti then return table.find(selected, opt) ~= nil end
                        return selected == opt
                    end

                    local function UpdateText()
                        if isMulti then
                            MainBtn.Text = #selected == 0 and "Select Options..." or table.concat(selected, ", ")
                        else
                            MainBtn.Text = selected or "Select..."
                        end
                    end

                    local function CopySelected()
                        if not isMulti then return selected end
                        local copy = {}
                        for _, v in ipairs(selected) do table.insert(copy, v) end
                        return copy
                    end

                    local function Repaint()
                        for _, btn in ipairs(optionButtons) do
                            local isSel = IsSelected(btn.Text)
                            Tween(btn, {TextColor3 = isSel and TextColor or SubTextColor}, 0.2)
                            local mark = btn:FindFirstChild("Frame")
                            if mark then Tween(mark, {Size = isSel and UDim2.new(1, 0, 1, 0) or UDim2.new(0, 0, 1, 0)}, 0.2) end
                        end
                    end

                    local function CloseDrop()
                        dropped = false
                        SearchBox.Visible = false
                        Tween(Arrow, {Rotation = 0}, 0.3)
                        Tween(DropFrame, {Size = UDim2.new(1, 0, 0, 50)}, 0.3)
                    end

                    local function internalSet(v)
                        if isMulti then
                            selected = {}
                            if type(v) == "table" then for _, x in ipairs(v) do table.insert(selected, tostring(x)) end end
                        else
                            if type(v) == "number" then v = options[v] end
                            selected = v
                        end
                        UpdateText()
                        Repaint()
                        SafeCall(cfg.Callback, CopySelected())
                    end

                    local function Rebuild()
                        for _, btn in ipairs(optionButtons) do btn:Destroy() end
                        optionButtons = {}
                        for _, opt in ipairs(options) do
                            local isSel = IsSelected(opt)
                            local OptBtn = Create("TextButton", {Parent = ListFrame, Text = opt, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = isSel and TextColor or SubTextColor, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 25), AutoButtonColor = false})
                            Create("Frame", {Parent = OptBtn, BackgroundColor3 = AccentColor, Size = isSel and UDim2.new(1, 0, 1, 0) or UDim2.new(0, 0, 1, 0), BackgroundTransparency = 0.8})
                            table.insert(optionButtons, OptBtn)

                            OptBtn.MouseButton1Click:Connect(function()
                                if isMulti then
                                    local idx = table.find(selected, opt)
                                    if idx then table.remove(selected, idx) else table.insert(selected, opt) end
                                    internalSet(selected)
                                else
                                    if cfg.AllowNone and selected == opt then internalSet(nil) else internalSet(opt) end
                                    CloseDrop()
                                end
                            end)
                        end
                        listHeight = CalcListHeight()
                        if not dropped then ListFrame.Size = UDim2.new(1, -20, 0, listHeight) end
                    end
                    Rebuild()
                    UpdateText()

                    SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
                        local q = SearchBox.Text:lower()
                        for _, btn in ipairs(optionButtons) do
                            btn.Visible = (q == "" or string.find(btn.Text:lower(), q, 1, true) ~= nil)
                        end
                    end)

                    DList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                        ListFrame.CanvasSize = UDim2.new(0, 0, 0, DList.AbsoluteContentSize.Y)
                        if dropped then
                            local dynamicHeight = math.min(DList.AbsoluteContentSize.Y, listHeight)
                            ListFrame.Size = UDim2.new(1, -20, 0, dynamicHeight)
                            Tween(DropFrame, {Size = UDim2.new(1, 0, 0, 50 + 32 + dynamicHeight)}, 0.1)
