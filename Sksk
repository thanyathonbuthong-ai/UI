    local m = self.Metrics

    ensureDir(self.Directory)
    ensureDir(self.Directory .. "/configs")
    self:_LoadState()
    local savedKey = deserializeKey(self._state.Keybind)
    if savedKey then self.Keybind = savedKey end

    --  GUIs ---------------------------------------------------------------
    local function newGui(name, order)
        local g = create("ScreenGui", {
            Name = name .. HttpService:GenerateGUID(false):sub(1, 6), DisplayOrder = order, IgnoreGuiInset = true,
            ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        })
