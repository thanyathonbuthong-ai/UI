--==========================================================================
--  Code block (Lua syntax highlight + copy button)
--==========================================================================
local LUA_KW = {}
for _, w in ipairs({ "local", "function", "end", "if", "then", "else", "elseif", "for", "while", "do", "return", "in", "and", "or", "not",
    "nil", "true", "false", "repeat", "until", "break", "continue" }) do LUA_KW[w] = true end

local function xmlEscape(s)
    s = s:gsub("&", "&amp;")
    s = s:gsub("<", "&lt;")
    s = s:gsub(">", "&gt;")
    return s
end

local function highlightLua(code)
    local out, i, n = {}, 1, #code
    local function add(text, color)
        if color then table.insert(out, '<font color="' .. color .. '">' .. xmlEscape(text) .. "</font>")
        else table.insert(out, xmlEscape(text)) end
    end
    while i <= n do
        local c = code:sub(i, i)
        if code:sub(i, i + 1) == "--" then
            local e = code:find("\n", i, true) or (n + 1)
            add(code:sub(i, e - 1), "#6a9955")
            i = e
        elseif c == '"' or c == "'" then
            local k = i + 1
            while k <= n do
                local d = code:sub(k, k)
                if d == "\\" then k = k + 2
                elseif d == c or d == "\n" then break
                else k = k + 1 end
            end
            add(code:sub(i, k), "#ce9178")
            i = k + 1
        elseif c:match("%d") then
            local s, e = code:find("^[%d%.]+", i)
            add(code:sub(s, e), "#b5cea8")
            i = e + 1
        elseif c:match("[%a_]") then
            local s, e = code:find("^[%w_]+", i)
            local w = code:sub(s, e)
            if LUA_KW[w] then add(w, "#c586c0")
            elseif code:sub(e + 1, e + 1) == "(" then add(w, "#dcdcaa")
            else add(w) end
            i = e + 1
        else
            add(c)
            i = i + 1
        end
    end
    return table.concat(out)
end

local function newCode(container, opts)
    local menu = container._menu
    local m = menu.Metrics
    local code = tostring(opts.Code or "")
    local card = create("Frame", {
        Name = "Code", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
