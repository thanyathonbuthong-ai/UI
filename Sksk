    function Window:CreateTopbarButton(a, b, c, d)
        local cfg = type(a) == "table" and a or {Name = a, Icon = b, Callback = c, LayoutOrder = d}
        TopBtnCount = TopBtnCount + 1
        local Btn = Create("TextButton", {Parent = TopRight, Text = "", BackgroundColor3 = HoverColor, BackgroundTransparency = 1, Size = UDim2.new(0, 24, 0, 24), AutoButtonColor = false, LayoutOrder = 1000 + (cfg.LayoutOrder or TopBtnCount)})
        Create("UICorner", {Parent = Btn, CornerRadius = UDim.new(0, 6)})
        AddBounce(Btn)

        local Icon
        local function SetIcon(icon)
            if Icon then Icon:Destroy() Icon = nil end
            if icon == nil then return end
            local str = ToImage(icon)
            if str:find("rbxasset") or str:find("http") then
                Icon = Create("ImageLabel", {Parent = Btn, BackgroundTransparency = 1, Image = str, ImageColor3 = cfg.IconColor or SubTextColor, Size = UDim2.new(0, cfg.IconSize or 16, 0, cfg.IconSize or 16), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), NoTheme = cfg.IconColor ~= nil})
            else
                Icon = Create("TextLabel", {Parent = Btn, BackgroundTransparency = 1, Text = str, Font = Enum.Font.GothamBold, TextSize = 14, NoScale = true, TextColor3 = cfg.IconColor or SubTextColor, Size = UDim2.new(1, 0, 1, 0), NoTheme = cfg.IconColor ~= nil})
            end
        end
        SetIcon(cfg.Icon)

        local function Prop() return Icon and Icon:IsA("ImageLabel") and "ImageColor3" or "TextColor3" end
        Btn.MouseEnter:Connect(function()
            Tween(Btn, {BackgroundTransparency = 0}, 0.15)
            if Icon and not cfg.IconColor then Tween(Icon, {[Prop()] = TextColor}, 0.15) end
        end)
        Btn.MouseLeave:Connect(function()
            Tween(Btn, {BackgroundTransparency = 1}, 0.15)
            if Icon and not cfg.IconColor then Tween(Icon, {[Prop()] = SubTextColor}, 0.15) end
        end)
        Btn.MouseButton1Click:Connect(function() SafeCall(cfg.Callback) end)

        local obj = {Button = Btn}
        function obj:SetIcon(icon) SetIcon(icon) end
        function obj:SetVisible(v) Btn.Visible = v end
        function obj:Destroy() Btn:Destroy() end
