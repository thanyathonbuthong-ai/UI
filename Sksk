            TabIconObj = Create("ImageLabel", {Parent = TabBtn, BackgroundTransparency = 1, Image = ToImage(tabIcon), ImageColor3 = SubTextColor, Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0, 11, 0.5, -8)})
            Txt.Position = UDim2.new(0, 34, 0, 0)
            Txt.Size = UDim2.new(1, -58, 1, 0)
        end

        local SoftLockIcon = Create("ImageLabel", {Parent = TabBtn, Image = "rbxassetid://6031082533", ImageColor3 = SubTextColor, BackgroundTransparency = 1, Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(1, -20, 0.5, -6), Visible = false})

        if isLocked then
            Create("ImageLabel", {Parent = TabBtn, Image = "rbxassetid://6031082533", ImageColor3 = Color3.fromRGB(255, 215, 0), BackgroundTransparency = 1, Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(1, -22, 0.5, -7)})
