function Grid.new(menu, parent, columns)
    local m = menu.Metrics
    local n = columns or (m.IsCompact and 1 or 2)
    local gap = m.Grid.Gap
    local self = setmetatable({ _menu = menu, _n = n, _cols = {}, _weights = {}, _count = 0 }, Grid)
    self.Frame = create("Frame", { Name = "Grid", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = parent })
    for i = 1, n do
        local sf = create("ScrollingFrame", {
            Name = "Column" .. i, Size = UDim2.new(1 / n, -gap * (n - 1) / n, 1, 0),
            Position = UDim2.new((i - 1) / n, (i - 1) * gap / n, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollBarThickness = 2,
            ScrollBarImageTransparency = 0.4, ScrollingDirection = Enum.ScrollingDirection.Y,
            ElasticBehavior = Enum.ElasticBehavior.Never, Parent = self.Frame,
        })
        Theme.bind(sf, "ScrollBarImageColor3", "Accent")
        pad(sf, 1, 6, 1, 1)
        list(sf, Enum.FillDirection.Vertical, m.Section.Gap)
        self._cols[i], self._weights[i] = sf, 0
    end
    return self
end

function Grid:AddSection(opts)
    opts = opts or {}
    local col = opts.Column
    if not col or col > self._n then
        col = 1
        for i = 2, self._n do
            if self._weights[i] < self._weights[col] then col = i end
        end
    end
    self._weights[col] = self._weights[col] + 3
    self._count = self._count + 1
    opts.Order = self._count
    return Section.new(self._menu, self._cols[col], opts, function() self._weights[col] = self._weights[col] + 1 end)
end

--==========================================================================
--  Environment helpers (file system, GUI parent)
--==========================================================================
local function ext(name)
    local ok, v = pcall(function() return getgenv()[name] end)
    if ok and type(v) == "function" then return v end
    ok, v = pcall(function() return getfenv(0)[name] end)
    return (ok and type(v) == "function") and v or nil
end

local FS = {
    read = ext("readfile"), write = ext("writefile"), list = ext("listfiles"), isfile = ext("isfile"),
    isfolder = ext("isfolder"), mkfolder = ext("makefolder"), del = ext("delfile"),
}

local function ensureDir(dir)
    if not (FS.isfolder and FS.mkfolder) then return end
    local acc
    for part in dir:gmatch("[^/]+") do
        acc = acc and (acc .. "/" .. part) or part
        pcall(function() if not FS.isfolder(acc) then FS.mkfolder(acc) end end)
    end
end

local function guiParent()
    local hui = ext("gethui")
    if hui then
        local ok, h = pcall(hui)
        if ok and h then return h end
    end
    local ok, core = pcall(service, "CoreGui")
    if ok and core then return core end
    return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local DEFAULT_TOKENS = table.clone(Theme.Tokens)

--==========================================================================
--  Page fade + Tab / SubTab
--==========================================================================
local fadeToken = setmetatable({}, { __mode = "k" })
local FADE_IN = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local FADE_OUT = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function fadePage(page, show)
    local tok = (fadeToken[page] or 0) + 1
    fadeToken[page] = tok
    if show then
        page.GroupTransparency = 1
        page.Visible = true
        tween(page, { GroupTransparency = 0 }, FADE_IN)
    else
        local tw = tween(page, { GroupTransparency = 1 }, FADE_OUT)
        tw.Completed:Once(function()
            if fadeToken[page] == tok then page.Visible = false end
        end)
    end
end

function Tab.new(menu, opts)
    local m = menu.Metrics
