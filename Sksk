local Input = subclass("Input")

function Input.new(container, opts)
    local menu = container._menu
    local m = menu.Metrics
    local area = opts.Type == "Textarea" or opts.Multiline == true
    local full = opts.Full == true or area
    local boxH = area and (opts.Height or 80) or m.Row.ControlHeight
    local row = container:_Row({ Label = opts.Label, Desc = opts.Desc, BodyHeight = full and (boxH + 2) or 0 })
    local self = setmetatable({}, Input)
    Control.init(self, menu, "Input", row, opts)
    local j = self._j
    self.Value = tostring(opts.Default or "")
    self.Numeric = opts.Numeric == true

    local box = create("TextBox", {
        Size = full and UDim2.new(1, 0, 0, boxH) or UDim2.fromOffset(opts.Width or 124, boxH),
        FontFace = Fonts.SemiBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = area and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
        ClearTextOnFocus = opts.ClearTextOnFocus == true, MultiLine = area, TextWrapped = area,
        PlaceholderText = opts.Placeholder or "", Text = self.Value,
    })
    box.BackgroundTransparency = 0
    Theme.bind(box, "BackgroundColor3", "Background")
    Theme.bind(box, "TextColor3", "TextColor")
    box.PlaceholderColor3 = Theme.Tokens.Unselected
    corner(box, 5)
    stroke(box, "Outline")
    pad(box, area and 6 or 0, 8, area and 6 or 0, 8)
    if full then box.Parent = row.Body else row:AttachRight(box, 50) end
    j:Add(box)
    self._box = box

    j:Add(box.FocusLost:Connect(function()
        local text = box.Text
        if self.Numeric and tonumber(text) == nil then
            box.Text = tostring(self.Value)
            return
        end
        self:Set(text)
    end))
    return self
end

function Input:Set(v, silent)
    v = tostring(v)
    self._box.Text = v
    if v == self.Value then return end
    self.Value = v
    if not silent then self:_Emit(v) end
end

function Input:_Serialize() return self.Value end
function Input:_Deserialize(v) if v ~= nil then self:Set(v) end end

