    -- Size / fullscreen
    function Window:SetSize(size)
        local x, y
        if typeof(size) == "UDim2" then x, y = size.X.Offset, size.Y.Offset else x, y = size.X, size.Y end
        x = math.clamp(x, winMin.X, winMax.X)
        y = math.clamp(y, winMin.Y, winMax.Y)
        Tween(MainFrame, {Size = UDim2.new(0, x, 0, y)}, 0.25)
    end

    local fullscreen = false
    local savedSize, savedPos
    function Window:ToggleFullscreen()
        fullscreen = not fullscreen
        Window.IsFullscreen = fullscreen
        if fullscreen then
            savedSize, savedPos = MainFrame.Size, MainFrame.Position
            local vp = ScreenGui.AbsoluteSize
            Tween(MainFrame, {Size = UDim2.new(0, vp.X - 40, 0, vp.Y - 90), Position = UDim2.new(0.5, 0, 0.5, -10)}, 0.3)
        else
            Tween(MainFrame, {Size = savedSize, Position = savedPos}, 0.3)
        end
    end

    -- Optional resize grip (Resizable = true)
    if resizable then
        local Grip = Create("TextButton", {Parent = MainFrame, Text = "◢", Font = Enum.Font.Gotham, TextSize = 10, NoScale = true, TextColor3 = SubTextColor, BackgroundTransparency = 1, Size = UDim2.new(0, 16, 0, 16), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -2, 1, -2), ZIndex = 30, AutoButtonColor = false})
        local resizing, startMouse, startSize, startPos = false, nil, nil, nil
        Grip.MouseEnter:Connect(function() Tween(Grip, {TextColor3 = AccentColor}, 0.15) end)
        Grip.MouseLeave:Connect(function() if not resizing then Tween(Grip, {TextColor3 = SubTextColor}, 0.15) end end)
        Grip.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                resizing = true
                startMouse = input.Position
                startSize = MainFrame.Size
                startPos = MainFrame.Position
            end
        end)
        table.insert(Conns, UserInputService.InputChanged:Connect(function(input)
            if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - startMouse
                local scale = math.max(MainScale.Scale, 0.01)
                local nx = math.clamp(startSize.X.Offset + delta.X / scale, winMin.X, winMax.X)
                local ny = math.clamp(startSize.Y.Offset + delta.Y / scale, winMin.Y, winMax.Y)
                MainFrame.Size = UDim2.new(0, nx, 0, ny)
                MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + (nx - startSize.X.Offset) / 2, startPos.Y.Scale, startPos.Y.Offset + (ny - startSize.Y.Offset) / 2)
            end
        end))
        table.insert(Conns, UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                if resizing then Tween(Grip, {TextColor3 = SubTextColor}, 0.15) end
                resizing = false
            end
        end))
    end

