        size = Vector2.new(clamp(ss[1], m.MinSize.X, vp.X), clamp(ss[2], m.MinSize.Y, vp.Y))
    end
    local pos = Vector2.new((vp.X - size.X) / 2, (vp.Y - size.Y) / 2)
    local sp = self._state.Position
    if type(sp) == "table" and sp[1] and sp[2] then
        pos = Vector2.new(clamp(sp[1], 0, math.max(0, vp.X - size.X)), clamp(sp[2], 0, math.max(0, vp.Y - size.Y)))
