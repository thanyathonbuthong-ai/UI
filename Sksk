--  Modal dialog:  Menu:Dialog({ Title=, Content=, Icon=, Buttons = { { Title=, Callback=, Variant= }, ... } })
function Menu:Dialog(opts)
    opts = opts or {}
    self:ClosePopup()
    local root = self._overlayRoot
    local vp = viewport()

    local dim = create("TextButton", { Name = "DialogDim", Size = UDim2.fromScale(1, 1), ZIndex = 30, Parent = root })
    dim.BackgroundColor3 = Color3.new(0, 0, 0)
    dim.BackgroundTransparency = 1
    tween(dim, { BackgroundTransparency = 0.5 })

    local panel = create("CanvasGroup", {
        Name = "Dialog", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(math.min(opts.Width or 360, vp.X - 32), 0), AutomaticSize = Enum.AutomaticSize.Y,
        GroupTransparency = 1, ZIndex = 31, Parent = root,
    })
    panel.BackgroundTransparency = 0
    Theme.bind(panel, "BackgroundColor3", "Background")
    corner(panel, 8)
    stroke(panel, "Outline")
    pad(panel, 16, 16, 16, 16)
    list(panel, Enum.FillDirection.Vertical, 10)
    tween(panel, { GroupTransparency = 0 }, TweenInfo.new(0.18))

    local head = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 1, Parent = panel })
    local ico = assetImage(opts.Icon)
    if ico then
        local im = create("ImageLabel", {
            AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(20, 20), Image = ico, Parent = head,
        })
        Theme.bind(im, "ImageColor3", "Accent")
    end
    local title = create("TextLabel", {
        Position = UDim2.fromOffset(ico and 28 or 0, 0), Size = UDim2.new(1, ico and -28 or 0, 1, 0),
        Text = tostring(opts.Title or opts.Label or "Dialog"), FontFace = Fonts.SemiBold, TextSize = 17,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = head,
    })
    Theme.bind(title, "TextColor3", "TextColor")

    local body = opts.Content or opts.Desc
    if body then
        local c = create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Text = tostring(body), TextSize = 14,
            TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
            LayoutOrder = 2, Parent = panel,
        })
        Theme.bind(c, "TextColor3", "TextColor")
    end

    local closed = false
    local function close()
        if closed then return end
        closed = true
        tween(dim, { BackgroundTransparency = 1 })
        local tw = tween(panel, { GroupTransparency = 1 }, TweenInfo.new(0.15))
        tw.Completed:Once(function()
            dim:Destroy()
            panel:Destroy()
        end)
    end

    local defs = {}
    for i, b in ipairs(opts.Buttons or { { Label = "OK", Variant = "primary" } }) do
        local nb = norm(b)
        local cb = nb.Callback
        nb.Callback = function()
            close()
            if cb then cb() end
        end
        defs[i] = nb
    end
    Button.newRow({ _menu = self, _content = panel, _NextOrder = function() return 10 end }, defs)
    if opts.Closable then dim.MouseButton1Click:Connect(close) end
    return { Close = close }
end

--==========================================================================
--  Tab shortcuts: WindUI style  Tab:Toggle({...})  (single column, no section needed)
--==========================================================================
function Tab:_Single()
    if not self._grid then self._grid = Grid.new(self._menu, self._content, 1) end
    return self._grid
end

function Tab:_Auto()
    assert(#self._subtabs == 0, "Use SubTab:AddSection on tabs that have sub-tabs")
    if not self._autoSection then self._autoSection = self:_Single():AddSection({}) end
    return self._autoSection
end

function Tab:Section(opts) return self:_Single():AddSection(norm(opts)) end

function SubTab:_Auto()
    if not self._autoSection then self._autoSection = self._grid:AddSection({}) end
    return self._autoSection
end

for _, name in ipairs({ "Toggle", "Slider", "Dropdown", "MultiDropdown", "Keybind", "ColorPicker", "Input", "Button", "ButtonRow",
    "Label", "Divider", "Paragraph", "Code", "Space", "Image", "Columns" }) do
    local method = "Add" .. name
    Tab[name] = function(self, ...) local s = self:_Auto() return s[method](s, ...) end
    SubTab[name] = function(self, ...) local s = self:_Auto() return s[method](s, ...) end
    Section[name], Group[name] = Section[method], Group[method]
end
Section.Colorpicker, Group.Colorpicker = Section.AddColorPicker, Group.AddColorPicker
Tab.Colorpicker, SubTab.Colorpicker = Tab.ColorPicker, SubTab.ColorPicker

--==========================================================================
--  Theme presets (Dark / Light + accent-tinted dark themes)
--==========================================================================
local function tinted(accent)
    local tint = accent:Lerp(Color3.fromRGB(128, 128, 128), 0.72)
    local function sh(k) return Color3.new(tint.R * k, tint.G * k, tint.B * k) end
    local sel = accent:Lerp(Color3.new(0, 0, 0), 0.72)
    return {
        Accent = accent, Outline = sh(0.12), Background = sh(0.025), ElementBackground = sh(0.05),
        TabButtonSelected = sel, Unselected = sh(0.5), TextColor = Color3.fromRGB(208, 208, 214),
        ToggleCircleUnselected = sh(0.42), ToggleBackgroundUnselected = sh(0.06),
        GradientTop = sh(0.085), GradientMid = sh(0.05), GradientDark = sh(0.03), GradientDeep = sh(0.01),
        TabHighlight = sel, TabShadow = accent:Lerp(Color3.new(0, 0, 0), 0.8),
    }
end

local Themes = {
    Dark = table.clone(DEFAULT_TOKENS),
    Light = {
        Accent = Color3.fromRGB(59, 130, 246), Outline = Color3.fromRGB(214, 218, 224), Background = Color3.fromRGB(245, 246, 248),
        ElementBackground = Color3.fromRGB(255, 255, 255), TabButtonSelected = Color3.fromRGB(219, 228, 240),
        Unselected = Color3.fromRGB(130, 138, 150), TextColor = Color3.fromRGB(30, 34, 40),
        ToggleCircleUnselected = Color3.fromRGB(170, 178, 190), ToggleBackgroundUnselected = Color3.fromRGB(226, 230, 236),
        GradientTop = Color3.fromRGB(250, 251, 252), GradientMid = Color3.fromRGB(244, 245, 247),
        GradientDark = Color3.fromRGB(238, 240, 243), GradientDeep = Color3.fromRGB(232, 235, 239),
        TabHighlight = Color3.fromRGB(219, 228, 240), TabShadow = Color3.fromRGB(200, 214, 235),
    },
    Rose = tinted(Color3.fromRGB(240, 98, 146)),
    Plant = tinted(Color3.fromRGB(88, 190, 110)),
    Indigo = tinted(Color3.fromRGB(99, 102, 241)),
    Sky = tinted(Color3.fromRGB(56, 189, 248)),
    Violet = tinted(Color3.fromRGB(168, 85, 247)),
    Amber = tinted(Color3.fromRGB(245, 166, 35)),
}

function Menu:GetThemes()
    local names = {}
    for k in pairs(Themes) do table.insert(names, k) end
    table.sort(names)
    return names
end

function Menu:SetTheme(name)
    local t = Themes[name]
    if not t then return false end
    for token, color in pairs(t) do Theme.set(token, color) end
    self.ThemeName = name
    return true
end


--==========================================================================
--  Built-in Settings tab (menu keybind, HUD, theme editor, configs, unload)
--==========================================================================
local THEME_PICKERS = {
    { "Accent", "Accent" }, { "TextColor", "Text" }, { "Unselected", "Unselected / Dim Text" },
    { "Background", "Background" }, { "ElementBackground", "Section Background" }, { "Outline", "Outline" },
    { "TabButtonSelected", "Selected Tab" }, { "ToggleCircleUnselected", "Toggle Circle" },
    { "ToggleBackgroundUnselected", "Toggle Background" },
}

function Menu:AddSettingsTab(opts)
    opts = opts or {}
    local tab = self:AddTab({ Label = opts.Label or "Settings", Description = "Menu, theme and configs", Icon = opts.Icon })

    local main = tab:AddSection({ Title = "Menu", Column = 1 })
    main:AddKeybind({
        Label = "Menu Keybind", Flag = "MenuKeybind", Default = self.Keybind, NoMode = true,
        OnBindChanged = function(bind) if bind then self:SetKeybind(bind) end end,
    })
    main:AddToggle({
        Label = "Show Watermark", Flag = "ShowWatermark", Default = true,
        Callback = function(v) self:SetWatermarkVisible(v) end,
    })
    main:AddToggle({
        Label = "Show Keybind List", Flag = "ShowKeybindList", Default = true,
        Callback = function(v) self:SetKeybindListVisible(v) end,
    })
    main:AddDropdown({
        Label = "Notification Side", Flag = "NotificationSide", Options = { "TopLeft", "TopRight", "BottomLeft", "BottomRight" },
        Default = "TopLeft", Callback = function(v) self:SetNotificationSide(v) end,
    })
    main:AddButtonRow({
        { Label = "Test Notification", Callback = function() self:Notify("Notification", "This is how alerts look.", { Type = "info" }) end },
        { Label = "Unload", Variant = "danger", Callback = function() self:Unload() end },
    })

    local cfg = tab:AddSection({ Title = "Configs", Column = 1 })
    local nameBox = cfg:AddInput({ Label = "Name", Placeholder = "my config", Full = true })
    local picker = cfg:AddDropdown({ Label = "Saved", Options = self:ListConfigs(), AllowNone = true })
    local info = cfg:AddLabel({ Text = "Autoload: " .. (self:GetAutoLoad() or "none") })
    local function refresh() picker:SetOptions(self:ListConfigs(), true) end
    local function current() return (nameBox.Value ~= "" and nameBox.Value) or picker.Value end
    local function report(ok, res, verb)
        if ok then self:Notify("Config", verb .. " " .. tostring(res), { Type = "success" })
        else self:Notify("Config", tostring(res), { Type = "error" }) end
    end
    cfg:AddButtonRow({
        { Label = "Save", Variant = "primary", Callback = function()
            local ok, res = self:SaveConfig(current())
            report(ok, res, "Saved")
            refresh()
        end },
        { Label = "Load", Callback = function() report(self:LoadConfig(current()), current(), "Loaded") end },
    })
    cfg:AddButtonRow({
        { Label = "Delete", Variant = "danger", Callback = function()
            local ok, res = self:DeleteConfig(current())
            report(ok, res, "Deleted")
            picker:Set(nil, true)
            refresh()
        end },
        { Label = "Refresh", Callback = refresh },
    })
    cfg:AddButtonRow({
        { Label = "Set Autoload", Callback = function()
            local n = current()
            if n and self:SetAutoLoad(n) then info:SetText("Autoload: " .. n) end
        end },
        { Label = "Clear Autoload", Callback = function()
            self:SetAutoLoad(nil)
            info:SetText("Autoload: none")
        end },
    })

    local themeSec = tab:AddSection({ Title = "Theme", Column = 2 })
    local pickers = {}
    themeSec:AddDropdown({
        Label = "Preset", Options = self:GetThemes(), Default = self.ThemeName or "Dark",
        Callback = function(v)
            self:SetTheme(v)
            for token, p in pairs(pickers) do p:Set(Theme.Tokens[token], true) end
        end,
    })
    for _, def in ipairs(THEME_PICKERS) do
        local token = def[1]
        pickers[token] = themeSec:AddColorPicker({
            Label = def[2], Flag = "Theme_" .. token, Default = Theme.Tokens[token],
            Callback = function(c) Theme.set(token, c) end,
        })
    end
    themeSec:AddButton({
        Label = "Reset Theme",
        Callback = function()
            for token, p in pairs(pickers) do p:Set(DEFAULT_TOKENS[token]) end
        end,
    })
    return tab
end

--==========================================================================
--  Unload
--==========================================================================
function Menu:Unload()
    if self._unloaded then return end
    self._unloaded = true
    self.Unloading:FireSync()
    if self._onUnload then pcall(self._onUnload) end
    self:ClosePopup()
    self:ClearNotifications()
    for _, ctrl in pairs(table.clone(self.Flags)) do pcall(ctrl.Destroy, ctrl) end
    self._j:Clean()
    if env.KiciaUI == self then env.KiciaUI = nil end
end

Menu.Tab = function(self, opts) return self:AddTab(opts) end
Menu.Destroy = Menu.Unload
Menu.Divider = Menu.AddTabDivider
Menu.Tag = Menu.AddTag
Tab.Select = Tab.Open

local function toKey(v)
    if typeof(v) == "EnumItem" then return v end
    if type(v) == "string" then
        local ok, k = pcall(function() return Enum.KeyCode[v] end)
        if ok then return k end
    end
    return nil
end

local UI = {
    Version = "2.0.0",
    new = Menu.new,
    Theme = Theme,
    Fonts = Fonts,
    Signal = Signal,
    Janitor = Janitor,
    Metrics = Metrics,
    Themes = Themes,
}

--  WindUI-compatible entry point:  UI:CreateWindow({ Title=, Icon=, Folder=, Theme=, ToggleKey=, OpenButton= })
function UI.CreateWindow(a, b)
    local cfg = (a == UI) and b or a
    cfg = cfg or {}
    local menu = Menu.new({
        Title = cfg.Title, Icon = assetImage(cfg.Icon), Directory = cfg.Folder or cfg.Directory,
        Keybind = toKey(cfg.ToggleKey or cfg.Keybind), Compact = cfg.Compact, OpenButton = cfg.OpenButton ~= false,
        OnUnload = cfg.OnUnload,
    })
    if cfg.Theme then menu:SetTheme(cfg.Theme) end
    return menu
end

function UI.Notify(a, ...)
    local args = { ... }
    if a ~= UI then table.insert(args, 1, a) end
    local m = env.KiciaUI
    if m then return m:Notify(table.unpack(args)) end
end

function UI.SetTheme(a, b)
    local name = (a == UI) and b or a
    local m = env.KiciaUI
    return m and m:SetTheme(name) or false
end

function UI.GetThemes() return Menu.GetThemes() end

return UI
