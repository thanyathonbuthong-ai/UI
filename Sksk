function Tab:_Layout()
    local top = self._hdr + (self._bar and 42 or 0)
    self._content.Position = UDim2.fromOffset(0, top)
    self._content.Size = UDim2.new(1, 0, 1, -top)
end

function Tab:Open() self._menu:_SelectTab(self) end

function Tab:AddSection(opts)
    assert(#self._subtabs == 0, "Tab:AddSection cannot be used on a tab that has sub-tabs; use SubTab:AddSection")
    if not self._grid then self._grid = Grid.new(self._menu, self._content) end
    return self._grid:AddSection(opts)
end

function Tab:AddSubTab(opts)
    assert(self._grid == nil, "Tab:AddSubTab cannot be used on a tab that already has sections")
    local m = self._menu.Metrics
    if not self._bar then
        local bar = create("ScrollingFrame", {
            Name = "SubTabs", Position = UDim2.fromOffset(0, self._hdr), Size = UDim2.new(1, 0, 0, 34),
            AutomaticCanvasSize = Enum.AutomaticSize.X, CanvasSize = UDim2.new(), ScrollBarThickness = 0,
            ScrollingDirection = Enum.ScrollingDirection.X, Parent = self._page,
        })
        list(bar, Enum.FillDirection.Horizontal, m.Page.TabGap > 8 and 8 or m.Page.TabGap, nil, Enum.VerticalAlignment.Center)
        self._bar = bar
        self:_Layout()
    end
    local st = SubTab.new(self, opts or {})
    table.insert(self._subtabs, st)
    if #self._subtabs == 1 then self:_SelectSub(st) end
    return st
end

function Tab:_SelectSub(sel)
    for _, st in ipairs(self._subtabs) do
        local on = st == sel
        st._grid.Frame.Visible = on
        tween(st._button, { BackgroundTransparency = on and 0.35 or 1 })
        tween(st._button, { TextColor3 = on and Theme.Tokens.Accent or Theme.Tokens.Unselected })
        st._selected = on
    end
    self._activeSub = sel
    self._menu:ClosePopup()
end

