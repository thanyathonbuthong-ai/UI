    rail.BackgroundTransparency = 0
    Theme.bind(rail, "BackgroundColor3", "ElementBackground")
    corner(rail, 6)
    local railBg = create("Frame", { ZIndex = 0, Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, Parent = rail })
    corner(railBg, 6)
    Theme.gradient(create("UIGradient", { Rotation = 90, Parent = railBg }), { "GradientTop", "GradientMid", "GradientDark" })

    local head = create("Frame", { Name = "Header", Size = UDim2.new(1, 0, 0, r.HeaderHeight), BackgroundColor3 = WHITE, Parent = rail })
    corner(head, 6)
    Theme.gradient(create("UIGradient", { Rotation = 90, Parent = head }), { "GradientTop", "GradientMid", "GradientDark" })
    local logo = create("ImageLabel", {
