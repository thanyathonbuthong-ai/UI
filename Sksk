-- // Utility: Safe Clipboard Copy
local function SafeCopyToClipboard(text)
    if setclipboard then
        setclipboard(text)
    elseif toclipboard then
        toclipboard(text)
    else
        warn("Clipboard copying is not supported on your current executor.")
    end
end

-- // Utility: Instance Creator
-- Extra keys:  NoTheme = true  -> instance is skipped by live re-theming
--              NoScale = true  -> text is NOT auto-scaled (needed for wrapped / multi-line text)
local function Create(className, properties)
    properties = properties or {}
    local instance = Instance.new(className)

    if className == "TextBox" then
        instance.Text = ""
        instance.PlaceholderColor3 = SubTextColor
    end

    for k, v in pairs(properties) do
        if k == "NoTheme" then
            if v then instance:SetAttribute("ZX_NoTheme", true) end
        elseif k ~= "NoScale" then
            instance[k] = v
        end
    end

    if (className == "TextLabel" or className == "TextButton" or className == "TextBox") then
        if properties.TextSize and properties.RichText ~= true and not properties.NoScale then
            instance.TextScaled = true
            local constraint = Instance.new("UITextSizeConstraint")
            constraint.MaxTextSize = properties.TextSize
            constraint.MinTextSize = 6
            constraint.Parent = instance
        end
    end

    return instance
end

-- // Utility: protected callback (a broken user callback never kills the UI)
local function SafeCall(fn, ...)
    if type(fn) ~= "function" then return end
    local ok, err = pcall(fn, ...)
    if not ok then warn("[ZyronX] Callback error: " .. tostring(err)) end
end

-- // Utility: best ScreenGui parent for the current executor
local function GetGuiParent()
    if RunService:IsStudio() then
        return game.Players.LocalPlayer:WaitForChild("PlayerGui")
    end
    if gethui then
        local ok, ui = pcall(gethui)
        if ok and ui then return ui end
    end
    return CoreGui
end

-- // Utility: turn "123456" / 123456 / "rbxassetid://123456" into a valid image string
local function ToImage(id)
    if id == nil then return "" end
    local s = tostring(id)
    if s:match("^%d+$") then return "rbxassetid://" .. s end
    return s
end


-- // Utility: Build search index for a card (cached)
local function BuildSearchIndex(card)
    local parts = {}
    for _, desc in ipairs(card:GetDescendants()) do
        if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
            if desc.Text and desc.Text ~= "" then
                table.insert(parts, desc.Text:lower())
            end
        end
    end
    return table.concat(parts, " ")
end

-- // Utility: Smooth Tweening
local function Tween(instance, properties, duration)
    duration = duration or 0.25
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    local tween = TweenService:Create(instance, tweenInfo, properties)
    tween:Play()
    return tween
end

-- // Utility: Micro-Interaction Bounce
local function AddBounce(button, scaleFactor)
    scaleFactor = scaleFactor or 0.96
    local scaleObj = button:FindFirstChild("UIScale") or Create("UIScale", {Parent = button, Scale = 1})
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Tween(scaleObj, {Scale = scaleFactor}, 0.15)
        end
    end)
    button.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Tween(scaleObj, {Scale = 1}, 0.15)
        end
    end)
    button.MouseLeave:Connect(function()
        Tween(scaleObj, {Scale = 1}, 0.15)
    end)
end

-- // Utility: Draggable
local function MakeDraggable(topbar, object, conns)
    topbar.Active = true
    object.Active = true
    local dragging, dragInput, dragStart, startPos
    
    topbar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = object.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    
    topbar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    
    local dragConn = UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            Tween(object, {Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)}, 0.08)
        end
    end)
    if conns then table.insert(conns, dragConn) end
end

-- // Global Notification API (WindUI-style: types, icons, progress bar, auto height)
local GlobalNotifContainer

local NotifTypeColors = {
    Info = nil,
    Success = Color3.fromRGB(80, 200, 120),
    Warning = Color3.fromRGB(255, 190, 60),
    Error = Color3.fromRGB(240, 80, 80),
}

function Library:Notify(options)
    if not GlobalNotifContainer then return end
    options = options or {}
    local title = options.Title or "Notification"
    local desc = options.Description or options.Content or "Information updated."
    local duration = options.Duration or 3
    local color = options.Color or NotifTypeColors[options.Type or "Info"] or AccentColor
    local icon = options.Icon

    local textX = icon and 48 or 15
    local textW = 320 - textX - 15
    local bounds = TextService:GetTextSize(desc, 12, Enum.Font.Gotham, Vector2.new(textW, 1000))
    local descH = math.max(15, bounds.Y)
    local height = 32 + descH + 14

    local Notif = Create("Frame", {Parent = GlobalNotifContainer, BackgroundColor3 = NotifColor, Size = UDim2.new(1, 0, 0, height), BackgroundTransparency = 1, ZIndex = 201, ClipsDescendants = true})
    Create("UICorner", {Parent = Notif, CornerRadius = UDim.new(0, 8)})
    local Stroke = Create("UIStroke", {Parent = Notif, Color = color, Thickness = 1.5, Transparency = 1, NoTheme = true})

    local IconImg
    if icon then
        IconImg = Create("ImageLabel", {Parent = Notif, BackgroundTransparency = 1, Image = icon, ImageColor3 = color, Size = UDim2.new(0, 22, 0, 22), Position = UDim2.new(0, 15, 0, 12), ImageTransparency = 1, ZIndex = 202, NoTheme = true})
    end
    local TitleText = Create("TextLabel", {Parent = Notif, Text = title, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = TextColor, BackgroundTransparency = 1, Position = UDim2.new(0, textX, 0, 12), Size = UDim2.new(1, -(textX + 15), 0, 15), TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = 1, ZIndex = 202})
    local DescText = Create("TextLabel", {Parent = Notif, Text = desc, Font = Enum.Font.Gotham, TextSize = 12, NoScale = true, TextWrapped = true, TextColor3 = SubTextColor, BackgroundTransparency = 1, Position = UDim2.new(0, textX, 0, 30), Size = UDim2.new(1, -(textX + 15), 0, descH), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextTransparency = 1, ZIndex = 202})
    local Bar = Create("Frame", {Parent = Notif, BackgroundColor3 = color, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 1, -2), BackgroundTransparency = 1, ZIndex = 203, NoTheme = true})

    Tween(Notif, {BackgroundTransparency = 0}, 0.3)
    Tween(Stroke, {Transparency = 0}, 0.3)
    Tween(TitleText, {TextTransparency = 0}, 0.3)
    Tween(DescText, {TextTransparency = 0}, 0.3)
    Tween(Bar, {BackgroundTransparency = 0}, 0.3)
    if IconImg then Tween(IconImg, {ImageTransparency = 0}, 0.3) end
    TweenService:Create(Bar, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 0, 2)}):Play()

    local closed = false
    local object = {}
    function object:Close()
        if closed then return end
        closed = true
        Tween(Notif, {BackgroundTransparency = 1}, 0.4)
        Tween(Stroke, {Transparency = 1}, 0.4)
        Tween(TitleText, {TextTransparency = 1}, 0.4)
        Tween(DescText, {TextTransparency = 1}, 0.4)
        Tween(Bar, {BackgroundTransparency = 1}, 0.4)
        if IconImg then Tween(IconImg, {ImageTransparency = 1}, 0.4) end
        task.wait(0.4)
        Notif:Destroy()
    end

    task.delay(duration, function() object:Close() end)
    return object
end

-- // Dialog / Popup builder (WindUI Dialog + Popup, drawn in the ZyronX popup style)
local function BuildDialog(gui, options)
    options = options or {}
    local width = options.Width or 340
    local buttons = options.Buttons or {}

    local Fades = {}
    local function Reg(inst, shown, hidden) table.insert(Fades, {inst, shown, hidden}) end

    local Overlay = Create("Frame", {Parent = gui, BackgroundColor3 = Color3.fromRGB(0, 0, 0), BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), ZIndex = 160, Active = true, NoTheme = true})
    local Card = Create("Frame", {Parent = Overlay, BackgroundColor3 = PopupColor, BackgroundTransparency = 1, Size = UDim2.new(0, width, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 161})
    Create("UICorner", {Parent = Card, CornerRadius = UDim.new(0, 12)})
    local CardStroke = Create("UIStroke", {Parent = Card, Color = Stroke2Color, Thickness = 1, Transparency = 1})
    local Scale = Create("UIScale", {Parent = Card, Scale = 0.8})
    Create("UIPadding", {Parent = Card, PaddingTop = UDim.new(0, 18), PaddingBottom = UDim.new(0, 18), PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 18)})
    Create("UIListLayout", {Parent = Card, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 12)})
    Reg(Overlay, {BackgroundTransparency = 0.5}, {BackgroundTransparency = 1})
    Reg(Card, {BackgroundTransparency = 0}, {BackgroundTransparency = 1})
    Reg(CardStroke, {Transparency = 0}, {Transparency = 1})

    -- Header (optional icon + title)
    local Header = Create("Frame", {Parent = Card, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 1, ZIndex = 162})
    local titleX = 0
    if options.Icon then
        local Ico = Create("ImageLabel", {Parent = Header, BackgroundTransparency = 1, Image = options.Icon, ImageColor3 = options.IconColor or AccentColor, Size = UDim2.new(0, 22, 0, 22), Position = UDim2.new(0, 0, 0.5, -11), ImageTransparency = 1, ZIndex = 162, NoTheme = options.IconColor ~= nil})
        Reg(Ico, {ImageTransparency = 0}, {ImageTransparency = 1})
        titleX = 30
    end
    local TitleLbl = Create("TextLabel", {Parent = Header, Text = options.Title or "Dialog", Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = TextColor, BackgroundTransparency = 1, Size = UDim2.new(1, -titleX, 1, 0), Position = UDim2.new(0, titleX, 0, 0), TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = 1, ZIndex = 162})
    Reg(TitleLbl, {TextTransparency = 0}, {TextTransparency = 1})

    -- Content
    if options.Content or options.Description then
        local Body = Create("TextLabel", {Parent = Card, Text = options.Content or options.Description, Font = Enum.Font.Gotham, TextSize = 13, NoScale = true, TextColor3 = SubTextColor, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 2, TextTransparency = 1, ZIndex = 162})
        Reg(Body, {TextTransparency = 0}, {TextTransparency = 1})
    end

    local closing = false
    local Dialog = {}
    function Dialog:Close()
        if closing then return end
        closing = true
        for _, f in ipairs(Fades) do Tween(f[1], f[3], 0.25) end
        Tween(Scale, {Scale = 0.8}, 0.25)
        task.wait(0.28)
        Overlay:Destroy()
    end

    -- Buttons
    if #buttons > 0 then
        local Row = Create("Frame", {Parent = Card, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 3, ZIndex = 162})
        local n = #buttons
        local gap = 8
        for i, b in ipairs(buttons) do
            local variant = b.Variant or (i == n and "Primary" or "Secondary")
            local bg, fg, transparent = DividerColor, TextColor, false
            if variant == "Primary" then bg, fg = AccentColor, Color3.fromRGB(255, 255, 255)
            elseif variant == "Danger" then bg, fg = Color3.fromRGB(180, 50, 50), Color3.fromRGB(255, 255, 255)
            elseif variant == "Tertiary" then bg, fg, transparent = CardColor, SubTextColor, true end

            local Btn = Create("TextButton", {Parent = Row, Text = b.Title or b.Name or "OK", Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = fg, BackgroundColor3 = bg, BackgroundTransparency = 1, TextTransparency = 1, AutoButtonColor = false, Size = UDim2.new(1 / n, -(gap * (n - 1)) / n, 1, 0), Position = UDim2.new((i - 1) / n, (i - 1) * gap / n, 0, 0), ZIndex = 162, NoTheme = (variant == "Danger")})
            Create("UICorner", {Parent = Btn, CornerRadius = UDim.new(0, 6)})
            if transparent then
                local s = Create("UIStroke", {Parent = Btn, Color = StrokeColor, Thickness = 1, Transparency = 1})
                Reg(s, {Transparency = 0}, {Transparency = 1})
                Reg(Btn, {TextTransparency = 0}, {TextTransparency = 1})
            else
                Reg(Btn, {BackgroundTransparency = 0, TextTransparency = 0}, {BackgroundTransparency = 1, TextTransparency = 1})
            end
            AddBounce(Btn)
            Btn.MouseButton1Click:Connect(function()
                if b.Callback then task.spawn(function() pcall(b.Callback) end) end
                if b.KeepOpen ~= true then Dialog:Close() end
            end)
        end
    end

    for _, f in ipairs(Fades) do Tween(f[1], f[2], 0.3) end
    Tween(Scale, {Scale = 1}, 0.3)
    return Dialog
end

function Library:Popup(options)
    local gui = (options and options.Parent) or GlobalScreenGui
    if not gui then warn("[ZyronX] Library:Popup needs a window first.") return end
    return BuildDialog(gui, options)
end


