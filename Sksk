--  Menu helpers: tween, popups, tooltips
--==========================================================================
local activeTweens = setmetatable({}, { __mode = "k" })
local DEFAULT_TWEEN = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function tween(inst, props, info)
    local reg = activeTweens[inst]
    if not reg then reg = {} activeTweens[inst] = reg end
    for prop in pairs(props) do
        if reg[prop] then reg[prop]:Cancel() end
    end
    local tw = TweenService:Create(inst, info or DEFAULT_TWEEN, props)
    for prop in pairs(props) do reg[prop] = tw end
    tw:Play()
    return tw
end

function Menu:Tween(inst, props, info) return tween(inst, props, info) end

function Menu:ClosePopup()
    local p = self._popup
    if not p then return end
    self._popup = nil
    self._blocker.Visible = false
    p.Janitor:Clean()
end

--  Opens a popup under `anchor`. build(frame, janitor) fills it. Calling again for the
--  same owner closes it (toggle behaviour). Returns frame, janitor (or nil when toggled off).
function Menu:OpenPopup(anchor, size, build, opts)
    opts = opts or {}
    local owner = opts.Owner or anchor
    if self._popup and self._popup.Owner == owner then
        self:ClosePopup()
        return nil
    end
    self:ClosePopup()

    local j = Janitor.new()
    local frame = create("Frame", {
        Name = "Popup", Size = UDim2.fromOffset(size.X, size.Y), ZIndex = 5, Active = true,
        Parent = self._overlayRoot,
    })
    Theme.bind(frame, "BackgroundColor3", "Background")
    corner(frame, 5)
    stroke(frame, "Outline")
    j:Add(frame)

    local vp = viewport()
    local ap, as = anchor.AbsolutePosition, anchor.AbsoluteSize
    local x = ap.X
    if opts.AlignRight then x = ap.X + as.X - size.X end
    x = clamp(x, 4, math.max(4, vp.X - size.X - 4))
    local y = ap.Y + as.Y + 4
    if y + size.Y > vp.Y - 4 then y = ap.Y - size.Y - 4 end
    y = clamp(y, 4, math.max(4, vp.Y - size.Y - 4))
    frame.Position = UDim2.fromOffset(x, y)

    self._popup = { Owner = owner, Frame = frame, Janitor = j }
    self._blocker.Visible = true
    build(frame, j)
    return frame, j
end

function Menu:_ShowTooltip(gui, text)
    if type(text) ~= "string" or text == "" or not self.Visible then return end
    local tip = self._tooltip
    tip.Label.Text = text
    local mouse = UserInputService:GetMouseLocation()
    local vp = viewport()
    tip.Frame.AnchorPoint = Vector2.new(mouse.X > vp.X - 260 and 1 or 0, mouse.Y > vp.Y - 80 and 1 or 0)
    tip.Frame.Position = UDim2.fromOffset(mouse.X + (mouse.X > vp.X - 260 and -10 or 14), mouse.Y + (mouse.Y > vp.Y - 80 and -10 or 18))
    tip.Frame.Visible = true
end

function Menu:_HideTooltip()
    if self._tooltip then self._tooltip.Frame.Visible = false end
end

function Menu:AttachTooltip(j, gui, text)
    local token = 0
    j:Add(gui.MouseEnter:Connect(function()
        token = token + 1
        local mine = token
        task.delay(0.45, function()
            if mine ~= token or not gui.Parent then return end
            local t = text
            if type(t) == "function" then t = t() end
            self:_ShowTooltip(gui, t)
        end)
    end))
    j:Add(gui.MouseLeave:Connect(function()
        token = token + 1
        self:_HideTooltip()
    end))
end

--==========================================================================
--  Row: title (+ description) on the left, attachments on the right, optional body
--==========================================================================
function Row.new(menu, parent, opts)
    local m = menu.Metrics
    local labelH = m.Row.Height
    local bodyH = opts.BodyHeight or 0
    local frame = create(opts.Button and "TextButton" or "Frame", {
        Name = "Row", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = opts.LayoutOrder or 0, Parent = parent,
    })
    local content = create("Frame", {
        Name = "Content", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, Parent = frame,
    })
    list(content, Enum.FillDirection.Vertical, 2)

    local self = setmetatable({
        _menu = menu, _j = Janitor.new(), _users = 0, _tooltip = opts.Tooltip, _descSize = m.Row.TextSize - 3,
        Frame = frame, Content = content, Menu = menu, Locked = false,
    }, Row)

    local top = create("Frame", {
        Name = "Top", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, labelH), LayoutOrder = 1, Parent = content,
    })
    local title = create("TextLabel", {
        Name = "Title", Size = UDim2.new(1, 0, 0, labelH), Text = opts.Label or "",
        TextXAlignment = Enum.TextXAlignment.Left, TextSize = m.Row.TextSize,
        TextTruncate = Enum.TextTruncate.AtEnd, Visible = opts.Label ~= nil, Parent = top,
    })
    Theme.bind(title, "TextColor3", "TextColor")
    self.TitleLabel = title

    local right = create("Frame", {
        Name = "Right", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 0, 0, labelH),
        AutomaticSize = Enum.AutomaticSize.X, Parent = top,
    })
    list(right, Enum.FillDirection.Horizontal, m.Row.AttachmentGap, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
    self.Right = right
    self._j:Add(right:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        local w = right.AbsoluteSize.X
        title.Size = UDim2.new(1, -(w + (w > 0 and 8 or 0)), 0, labelH)
    end))

    if opts.Desc then self:SetDesc(opts.Desc) end
    if bodyH > 0 then
        self.Body = create("Frame", {
            Name = "Body", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, bodyH), LayoutOrder = 3, Parent = content,
        })
    end

    local flash = create("Frame", { Name = "Flash", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 19, Parent = frame })
    Theme.bind(flash, "BackgroundColor3", "Accent")
    corner(flash, 4)
    local shield = create("TextButton", { Name = "Lock", Size = UDim2.fromScale(1, 1), ZIndex = 20, Visible = false, Parent = frame })
    shield.BackgroundTransparency = 0.45
    Theme.bind(shield, "BackgroundColor3", "ElementBackground")
    corner(shield, 4)
    self._flash, self._shield = flash, shield

    menu:AttachTooltip(self._j, frame, function() return self._tooltip end)
    return self
end

function Row:AttachRight(gui, order)
    gui.LayoutOrder = order or 0
    gui.Parent = self.Right
    return gui
end

function Row:SetLabel(text)
    self.TitleLabel.Text = text or ""
    self.TitleLabel.Visible = text ~= nil and text ~= ""
end

function Row:SetDesc(text)
    if text == nil or text == "" then
        if self._desc then self._desc.Visible = false end
        return
    end
    if not self._desc then
        local d = create("TextLabel", {
            Name = "Desc", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true,
            TextSize = self._descSize, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
            LayoutOrder = 2, Parent = self.Content,
        })
        Theme.bind(d, "TextColor3", "Unselected")
        self._desc = d
    end
    self._desc.Text = text
    self._desc.Visible = true
end

function Row:SetLocked(v)
    self.Locked = v == true
    self._shield.Visible = self.Locked
end

function Row:Flash()
    local tw = tween(self._flash, { BackgroundTransparency = 0.7 }, TweenInfo.new(0.15))
    tw.Completed:Once(function() tween(self._flash, { BackgroundTransparency = 1 }, TweenInfo.new(0.5)) end)
end

function Row:SetTooltip(text) self._tooltip = text end
function Row:SetVisible(v) self.Frame.Visible = v end
function Row:Retain() self._users = self._users + 1 end

function Row:Release()
    self._users = self._users - 1
    if self._users <= 0 then
        self._j:Destroy()
        self.Frame:Destroy()
    end
end

--  WindUI-style helpers available on every control
function Control:SetTitle(t) return self:SetLabel(t) end
function Control:SetDesc(t) self.Row:SetDesc(t) return self end
function Control:Lock() self.Row:SetLocked(true) return self end
function Control:Unlock() self.Row:SetLocked(false) return self end
function Control:IsLocked() return self.Row.Locked == true end
function Control:Highlight() self.Row:Flash() return self end

--==========================================================================
--  Control base
--==========================================================================
function Control.init(self, menu, kind, row, opts)
    self.Menu, self.Kind, self.Row = menu, kind, row
    self.Flag = opts.Flag
    self._j = Janitor.new()
    self.Changed = self._j:Add(Signal.new())
    self._callback = opts.Callback
    row:Retain()
    if opts.Locked then row:SetLocked(true) end
    if opts.Flag then menu.Flags[opts.Flag] = self end
    if opts.Tooltip then row:SetTooltip(opts.Tooltip) end
end

function Control:_Emit(...)
    self.Changed:Fire(...)
    if self._callback then task.spawn(self._callback, ...) end
end

function Control:OnChanged(fn) self._j:Add(self.Changed:Connect(fn)) return self end
function Control:Get() return self.Value end
function Control:SetLabel(t) self.Row:SetLabel(t) return self end
function Control:SetTooltip(t) self.Row:SetTooltip(t) return self end
function Control:SetVisible(v) self.Row:SetVisible(v) return self end

function Control:Destroy()
    if self._destroyed then return end
    self._destroyed = true
    if self.Flag and self.Menu.Flags[self.Flag] == self then self.Menu.Flags[self.Flag] = nil end
    self._j:Destroy()
    self.Row:Release()
end

local function subclass(name)
    local c = {}
    c.__index = c
    setmetatable(c, { __index = Control })
    Controls[name] = c
    return c
end

--  Small V-shaped chevron drawn with two bars (avoids glyph/font issues).
local function chevron(parent, x)
    local holder = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, x or -12, 0.5, 0),
        Size = UDim2.fromOffset(10, 10), BackgroundTransparency = 1, Parent = parent,
    })
    for i = 1, 2 do
        local bar = create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, i == 1 and -2 or 2, 0.5, 0),
            Size = UDim2.fromOffset(6, 1.5), Rotation = i == 1 and 45 or -45, Parent = holder,
        })
        Theme.bind(bar, "BackgroundColor3", "Unselected")
    end
    return holder
end

--  Scrollable list of options used by Dropdown / MultiDropdown / keybind mode popup.
local function buildOptionList(frame, j, options, isSelected, onPick, rowH)
    local sf = create("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1), AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
        ScrollBarThickness = 2, ScrollingDirection = Enum.ScrollingDirection.Y,
        ElasticBehavior = Enum.ElasticBehavior.Never, Parent = frame,
    })
    Theme.bind(sf, "ScrollBarImageColor3", "Accent")
    pad(sf, 3, 3, 3, 3)
    list(sf, Enum.FillDirection.Vertical, 1)
    local painters = {}
    for i, opt in ipairs(options) do
        local b = create("TextButton", {
            Size = UDim2.new(1, 0, 0, rowH), Text = tostring(opt), TextXAlignment = Enum.TextXAlignment.Left,
            TextSize = 14, LayoutOrder = i, Parent = sf,
        })
        corner(b, 4)
        pad(b, 0, 0, 0, 8)
        local function paint()
            b.TextColor3 = isSelected(opt) and Theme.Tokens.Accent or Theme.Tokens.TextColor
        end
        paint()
        painters[i] = paint
        j:Add(b.MouseEnter:Connect(function()
            b.BackgroundColor3 = Theme.Tokens.TabButtonSelected
            b.BackgroundTransparency = 0.55
        end))
        j:Add(b.MouseLeave:Connect(function() b.BackgroundTransparency = 1 end))
        j:Add(b.MouseButton1Click:Connect(function()
            onPick(opt)
            for _, p in ipairs(painters) do p() end
        end))
    end
end

local function popupHeight(count, rowH)
    return math.min(count * (rowH + 1) + 8, 210)
end

--  Rounded "field" button used by dropdowns.
local function fieldButton(menu, width)
    local h = menu.Metrics.Row.ControlHeight
    local btn = create("TextButton", { Size = UDim2.fromOffset(width, h) })
    Theme.bind(btn, "BackgroundColor3", "Background")
    btn.BackgroundTransparency = 0
    corner(btn, 5)
    stroke(btn, "Outline")
    local label = create("TextLabel", {
        Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -26, 1, 0), FontFace = Fonts.SemiBold,
        TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = btn,
    })
    Theme.bind(label, "TextColor3", "TextColor")
    chevron(btn, -12)
    return btn, label
end

--==========================================================================
--  Toggle
--==========================================================================
local Toggle = subclass("Toggle")

function Toggle.new(container, opts)
    local menu = container._menu
    local row = container:_Row({ Label = opts.Label, Desc = opts.Desc, Button = true })
    local self = setmetatable({}, Toggle)
    Control.init(self, menu, "Toggle", row, opts)
    self.Value = opts.Default == true
    local j = self._j
    local paint

    if opts.Type == "Checkbox" then
        local box = create("Frame", { Name = "Checkbox", Size = UDim2.fromOffset(20, 20) })
        box.BackgroundTransparency = 0
        Theme.bind(box, "BackgroundColor3", "Background")
        corner(box, 5)
        stroke(box, "Outline")
        local fill = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = box })
        Theme.bind(fill, "BackgroundColor3", "Accent")
        corner(fill, 5)
        local legs = {
            create("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(7, 12), Size = UDim2.fromOffset(5, 2),
                Rotation = 45, BackgroundColor3 = WHITE, BackgroundTransparency = 1, ZIndex = 2, Parent = box,
            }),
            create("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(12, 10), Size = UDim2.fromOffset(10, 2),
                Rotation = -45, BackgroundColor3 = WHITE, BackgroundTransparency = 1, ZIndex = 2, Parent = box,
            }),
        }
        row:AttachRight(box, 100)
        j:Add(box)
        paint = function(instant)
            local t = self.Value and 0 or 1
            if instant then
                fill.BackgroundTransparency = t
                for _, l in ipairs(legs) do l.BackgroundTransparency = t end
            else
                tween(fill, { BackgroundTransparency = t })
                for _, l in ipairs(legs) do tween(l, { BackgroundTransparency = t }) end
            end
        end
    else
        local sw = create("Frame", { Name = "Switch", Size = UDim2.fromOffset(32, 20), BackgroundColor3 = WHITE })
        local g = create("UIGradient", { Rotation = 90, Parent = sw })
        Theme.gradient(g, { "ToggleBackgroundUnselected", "GradientDark" })
        corner(sw, UDim.new(1, 0))
        local fill = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = sw })
        Theme.bind(fill, "BackgroundColor3", "Accent")
        corner(fill, UDim.new(1, 0))
        local circle = create("Frame", { Position = UDim2.fromOffset(3, 2), Size = UDim2.fromOffset(16, 16), Parent = sw })
        Theme.bind(circle, "BackgroundColor3", "ToggleCircleUnselected")
        corner(circle, UDim.new(1, 0))
        row:AttachRight(sw, 100)
        j:Add(sw)
        paint = function(instant)
            local on = self.Value
            local pos = on and UDim2.fromOffset(13, 2) or UDim2.fromOffset(3, 2)
            local col = on and WHITE or Theme.Tokens.ToggleCircleUnselected
            local t = on and 0 or 1
            if instant then
                fill.BackgroundTransparency = t
                circle.BackgroundColor3 = col
                circle.Position = pos
            else
                tween(fill, { BackgroundTransparency = t })
                tween(circle, { BackgroundColor3 = col, Position = pos })
            end
        end
        j:Add(Theme.onChange("ToggleCircleUnselected", function(c)
            if not self.Value then circle.BackgroundColor3 = c end
        end))
    end

    paint(true)
    self._paint = paint
    j:Add(row.Frame.MouseButton1Click:Connect(function() self:Set(not self.Value) end))
    return self
end

function Toggle:Set(v, silent)
    v = v == true
    if v == self.Value then return end
    self.Value = v
    self._paint(false)
    if not silent then self:_Emit(v) end
end

function Toggle:Toggle() self:Set(not self.Value) end
function Toggle:AddKeybind(opts) return Controls.Keybind.new(nil, opts or {}, self.Row) end
function Toggle:AddColorPicker(opts) return Controls.ColorPicker.new(nil, opts or {}, self.Row) end
function Toggle:_Serialize() return self.Value end
function Toggle:_Deserialize(v) if type(v) == "boolean" then self:Set(v) end end

--==========================================================================
--  Slider
--==========================================================================
local Slider = subclass("Slider")

function Slider.new(container, opts)
    local menu = container._menu
    local m = menu.Metrics
    local row = container:_Row({ Label = opts.Label, Desc = opts.Desc, BodyHeight = 18 })
    local self = setmetatable({}, Slider)
    Control.init(self, menu, "Slider", row, opts)
    local j = self._j

    self.Min = opts.Min or 0
    self.Max = opts.Max or 100
    self.Step = opts.Step or 1
    self.Decimals = opts.Decimals or decimalsOf(self.Step)
    self.Suffix = opts.Suffix or ""
    self.Value = clamp(opts.Default or self.Min, self.Min, self.Max)

    local box = create("TextBox", {
        Size = UDim2.fromOffset(60, m.Row.ControlHeight), FontFace = Fonts.SemiBold, TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Right, ClearTextOnFocus = false,
    })
    Theme.bind(box, "TextColor3", "TextColor")
    row:AttachRight(box, 1)
    j:Add(box)

    local body = row.Body
    pad(body, 0, 7, 0, 7)
    local track = create("Frame", {
        AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5),
        Size = UDim2.new(1, 0, 0, 3), BackgroundColor3 = WHITE, Parent = body,
    })
    local g = create("UIGradient", { Parent = track })
    Theme.gradient(g, { "GradientDark", "GradientMid" })
    stroke(track, "Outline")
    corner(track, UDim.new(1, 0))

    local hit = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.new(1, 14, 0, 26), BackgroundTransparency = 1, Active = true, Parent = track,
    })
    local fill = create("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = WHITE, Parent = track })
    Theme.bind(fill, "BackgroundColor3", "Accent")
    corner(fill, UDim.new(1, 0))
    local thumb = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(14, 14),
        BackgroundColor3 = WHITE, ZIndex = 2, Parent = track,
    })
    corner(thumb, UDim.new(1, 0))

    local bubble
    if opts.IsTooltip then
        bubble = create("TextLabel", {
            AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0, -8), AutomaticSize = Enum.AutomaticSize.XY,
            Size = UDim2.new(), FontFace = Fonts.SemiBold, TextSize = 12, Visible = false, ZIndex = 5, Parent = thumb,
        })
        bubble.BackgroundTransparency = 0
        Theme.bind(bubble, "BackgroundColor3", "Background")
        Theme.bind(bubble, "TextColor3", "TextColor")
        corner(bubble, 4)
        stroke(bubble, "Outline")
        pad(bubble, 2, 6, 2, 6)
    end

    local function fmt(v) return string.format("%." .. self.Decimals .. "f", v) .. self.Suffix end
    local function paint()
        local span = self.Max - self.Min
        local a = span > 0 and (self.Value - self.Min) / span or 0
        fill.Size = UDim2.fromScale(a, 1)
        thumb.Position = UDim2.fromScale(a, 0.5)
        if bubble then bubble.Text = fmt(self.Value) end
        if not box:IsFocused() then box.Text = fmt(self.Value) end
    end
    self._paint = paint
    paint()

    bindDrag(j, hit, function(pos)
        local w = track.AbsoluteSize.X
        if w <= 0 then return end
        local t = clamp((pos.X - track.AbsolutePosition.X) / w, 0, 1)
        self:Set(self.Min + (self.Max - self.Min) * t)
    end, function()
        tween(thumb, { Size = UDim2.fromOffset(18, 18) })
        if bubble then bubble.Visible = true end
    end, function()
        tween(thumb, { Size = UDim2.fromOffset(14, 14) })
        if bubble then bubble.Visible = false end
    end)

    j:Add(box.Focused:Connect(function() box.Text = tostring(self.Value) end))
    j:Add(box.FocusLost:Connect(function()
        local n = tonumber(box.Text:match("-?%d+%.?%d*"))
        if n then self:Set(n) end
        paint()
    end))
    return self
end

function Slider:Set(v, silent)
    v = clamp(roundTo(v - self.Min, self.Step) + self.Min, self.Min, self.Max)
    v = fixFloat(v, self.Decimals)
    if v == self.Value then return end
    self.Value = v
    self._paint()
    if not silent then self:_Emit(v) end
end

function Slider:SetRange(min, max)
    self.Min, self.Max = min, max
    self.Value = clamp(self.Value, min, max)
    self._paint()
end

function Slider:_Serialize() return self.Value end
function Slider:_Deserialize(v) if type(v) == "number" then self:Set(v) end end

--==========================================================================
--  Dropdown / MultiDropdown  (WindUI style: Values may be tables, Multi, search, locked items)
--==========================================================================
local function assetImage(v)
    if type(v) == "number" then return "rbxassetid://" .. v end
    if type(v) == "string" and (v:find("^rbxassetid://") or v:find("^http") or v:find("^rbxasset")) then return v end
    return nil
end

local function parseItems(raw)
    local keys, meta = {}, {}
    for _, v in ipairs(raw or {}) do
        if type(v) == "table" then
            local key = v.Title or v.Label or v.Name or v.Value
            if key ~= nil then
                table.insert(keys, key)
                meta[key] = { Desc = v.Desc, Icon = v.Icon, Locked = v.Locked }
            end
        else
            table.insert(keys, v)
        end
    end
    return keys, meta
end

local function itemHeight(meta, opt)
    local mt = meta[opt]
    return (mt and mt.Desc) and 40 or 26
end

local function listHeight(ctrl)
    local h = 8 + (ctrl._search and 30 or 0)
    for _, opt in ipairs(ctrl.Options) do h = h + itemHeight(ctrl._meta, opt) + 1 end
    return math.min(h, 230)
end

local function buildItemList(frame, j, ctrl, isSelected, onPick, multi)
    local searchH = ctrl._search and 30 or 0
    local box
    if ctrl._search then
        box = create("TextBox", {
            Position = UDim2.fromOffset(4, 4), Size = UDim2.new(1, -8, 0, 22), PlaceholderText = "Search...",
            ClearTextOnFocus = false, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Parent = frame,
        })
        box.BackgroundTransparency = 0
        Theme.bind(box, "BackgroundColor3", "ElementBackground")
        Theme.bind(box, "TextColor3", "TextColor")
        corner(box, 4)
        pad(box, 0, 6, 0, 6)
    end
    local sf = create("ScrollingFrame", {
        Position = UDim2.fromOffset(0, searchH), Size = UDim2.new(1, 0, 1, -searchH),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollBarThickness = 2,
        ScrollingDirection = Enum.ScrollingDirection.Y, ElasticBehavior = Enum.ElasticBehavior.Never, Parent = frame,
    })
    Theme.bind(sf, "ScrollBarImageColor3", "Accent")
    pad(sf, 3, 3, 3, 3)
    list(sf, Enum.FillDirection.Vertical, 1)

    local entries = {}
    for i, opt in ipairs(ctrl.Options) do
        local mt = ctrl._meta[opt] or {}
        local h = itemHeight(ctrl._meta, opt)
        local b = create("TextButton", { Size = UDim2.new(1, 0, 0, h), LayoutOrder = i, Parent = sf })
        corner(b, 4)
        local x = 8
        local ico = assetImage(mt.Icon)
        if ico then
            create("ImageLabel", {
                AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 8, 0.5, 0), Size = UDim2.fromOffset(16, 16),
                Image = ico, Parent = b,
            })
            x = 30
        end
        local label = create("TextLabel", {
            Position = UDim2.new(0, x, 0, mt.Desc and 4 or 0), Size = UDim2.new(1, -(x + (multi and 30 or 8)), 0, mt.Desc and 18 or h),
            Text = tostring(opt), TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd, Parent = b,
        })
        if mt.Desc then
            local d = create("TextLabel", {
                Position = UDim2.new(0, x, 0, 22), Size = UDim2.new(1, -(x + 8), 0, 14), Text = mt.Desc, TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = b,
            })
            Theme.bind(d, "TextColor3", "Unselected")
        end
        local chkFill
        if multi then
            local chk = create("Frame", {
                AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(14, 14), Parent = b,
            })
            chk.BackgroundTransparency = 0
            Theme.bind(chk, "BackgroundColor3", "Background")
            corner(chk, 3)
            stroke(chk, "Outline")
            chkFill = create("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(8, 8),
                BackgroundTransparency = 1, Parent = chk,
            })
            Theme.bind(chkFill, "BackgroundColor3", "Accent")
            corner(chkFill, 2)
        end
        local function paint()
            local sel = isSelected(opt)
            if mt.Locked then
                label.TextColor3, label.TextTransparency = Theme.Tokens.Unselected, 0.4
            else
                label.TextTransparency = 0
                label.TextColor3 = sel and Theme.Tokens.Accent or Theme.Tokens.TextColor
            end
            if chkFill then chkFill.BackgroundTransparency = sel and 0 or 1 end
        end
        paint()
        entries[i] = { Button = b, Name = tostring(opt), Paint = paint }
        j:Add(b.MouseEnter:Connect(function()
            if mt.Locked then return end
            b.BackgroundColor3 = Theme.Tokens.TabButtonSelected
            b.BackgroundTransparency = 0.55
        end))
        j:Add(b.MouseLeave:Connect(function() b.BackgroundTransparency = 1 end))
        j:Add(b.MouseButton1Click:Connect(function()
            if mt.Locked then return end
            onPick(opt)
            for _, e in ipairs(entries) do e.Paint() end
        end))
    end
    if box then
        j:Add(box:GetPropertyChangedSignal("Text"):Connect(function()
            local q = box.Text:lower()
            for _, e in ipairs(entries) do
                e.Button.Visible = q == "" or e.Name:lower():find(q, 1, true) ~= nil
            end
        end))
    end
end

local function openList(self, btn, multi, isSelected, onPick)
    local size = Vector2.new(math.max(btn.AbsoluteSize.X, multi and 150 or 140), listHeight(self))
    self.Menu:OpenPopup(btn, size, function(frame, pj)
        buildItemList(frame, pj, self, isSelected, onPick, multi)
    end, { Owner = btn })
end

local Dropdown = subclass("Dropdown")

function Dropdown.new(container, opts)
    local menu = container._menu
    local row = container:_Row({ Label = opts.Label, Desc = opts.Desc })
    local self = setmetatable({}, Dropdown)
    Control.init(self, menu, "Dropdown", row, opts)
    local j = self._j

    self.Options, self._meta = parseItems(opts.Options)
    self._search = opts.SearchBarEnabled == true or opts.Search == true or #self.Options > 12
    if opts.Default ~= nil then self.Value = opts.Default
    elseif not opts.AllowNone then self.Value = self.Options[1] end

    local btn, label = fieldButton(menu, opts.Width or 124)
    row:AttachRight(btn, 50)
    j:Add(btn)
    self._label = label
    self:_Paint()

    j:Add(btn.MouseButton1Click:Connect(function()
        openList(self, btn, false, function(o) return o == self.Value end, function(o)
            self:Set(o)
            menu:ClosePopup()
        end)
    end))
    return self
end

function Dropdown:_Paint()
    self._label.Text = self.Value ~= nil and tostring(self.Value) or "None"
end

function Dropdown:Set(v, silent)
    if v ~= nil and not table.find(self.Options, v) then return end
    if v == self.Value then return end
    self.Value = v
    self:_Paint()
    if not silent then self:_Emit(v) end
end

function Dropdown:SetOptions(raw, keep)
    self.Options, self._meta = parseItems(raw)
    self._search = self._search or #self.Options > 12
    if not (keep and self.Value ~= nil and table.find(self.Options, self.Value)) then
        self.Value = self.Options[1]
    end
    self:_Paint()
end

Dropdown.Refresh = Dropdown.SetOptions
Dropdown.Select = Dropdown.Set
function Dropdown:_Serialize() return self.Value end
function Dropdown:_Deserialize(v) if v ~= nil then self:Set(v) end end

local MultiDropdown = subclass("MultiDropdown")

function MultiDropdown.new(container, opts)
    local menu = container._menu
    local row = container:_Row({ Label = opts.Label, Desc = opts.Desc })
    local self = setmetatable({}, MultiDropdown)
    Control.init(self, menu, "MultiDropdown", row, opts)
    local j = self._j

    self.Options, self._meta = parseItems(opts.Options)
    self._search = opts.SearchBarEnabled == true or opts.Search == true or #self.Options > 12
    self.Selected = {}
    if type(opts.Default) == "table" then
        for _, v in ipairs(opts.Default) do self.Selected[v] = true end
    end

    local btn, label = fieldButton(menu, opts.Width or 124)
    row:AttachRight(btn, 50)
    j:Add(btn)
    self._label = label
    self:_Paint()

    j:Add(btn.MouseButton1Click:Connect(function()
        openList(self, btn, true, function(o) return self.Selected[o] == true end, function(o) self:_Toggle(o) end)
    end))
    return self
end

function MultiDropdown:Get()
    local out = {}
    for _, o in ipairs(self.Options) do if self.Selected[o] then table.insert(out, o) end end
    return out
end

function MultiDropdown:_Paint()
    local sel = self:Get()
    self.Value = sel
    local text
    if #sel == 0 then text = "None"
    elseif #sel <= 2 then
        local names = {}
        for i, v in ipairs(sel) do names[i] = tostring(v) end
        text = table.concat(names, ", ")
    else text = #sel .. " selected" end
    self._label.Text = text
end

function MultiDropdown:_Toggle(o)
    self.Selected[o] = (not self.Selected[o]) or nil
    self:_Paint()
    self:_Emit(self:Get())
end

function MultiDropdown:Set(list, silent)
    self.Selected = {}
    for _, v in ipairs(list or {}) do if table.find(self.Options, v) then self.Selected[v] = true end end
    self:_Paint()
    if not silent then self:_Emit(self:Get()) end
end

function MultiDropdown:SetOptions(raw)
    self.Options, self._meta = parseItems(raw)
    self._search = self._search or #self.Options > 12
    for k in pairs(self.Selected) do if not table.find(self.Options, k) then self.Selected[k] = nil end end
    self:_Paint()
end

MultiDropdown.Refresh = MultiDropdown.SetOptions
MultiDropdown.Select = MultiDropdown.Set
function MultiDropdown:IsSelected(o) return self.Selected[o] == true end
function MultiDropdown:_Serialize() return self:Get() end
function MultiDropdown:_Deserialize(v) if type(v) == "table" then self:Set(v) end end

--==========================================================================
--  Keybind
--==========================================================================
local Keybind = subclass("Keybind")
local MODES = { "Always", "Hold", "Toggle" }

function Keybind.new(container, opts, attachRow)
    local row = attachRow or container:_Row({ Label = opts.Label, Desc = opts.Desc })
    local menu = row._menu
    local self = setmetatable({}, Keybind)
    Control.init(self, menu, "Keybind", row, opts)
    local j = self._j

    self.Bind = opts.Default
    self.Mode = opts.Mode or "Toggle"
    self.State = self.Mode == "Always"
    self.NoMode = opts.NoMode == true
    self.ShowInList = opts.ShowInList ~= false
    self._labelOverride = opts.Label
    self.Triggered = j:Add(Signal.new())
    self.BindChanged = j:Add(Signal.new())
    self._onBind = opts.OnBindChanged

    local btn = create("TextButton", {
        Size = UDim2.fromOffset(60, menu.Metrics.Row.ControlHeight), FontFace = Fonts.SemiBold, TextSize = 13,
    })
    btn.BackgroundTransparency = 0
    Theme.bind(btn, "BackgroundColor3", "Background")
    Theme.bind(btn, "TextColor3", "TextColor")
    corner(btn, 5)
    stroke(btn, "Outline")
    btn.AutomaticSize = Enum.AutomaticSize.X
    pad(btn, 0, 8, 0, 8)
    create("UISizeConstraint", { MinSize = Vector2.new(44, 0), Parent = btn })
    btn.Text = keyName(self.Bind)
    row:AttachRight(btn, 10)
    j:Add(btn)
    self._btn = btn

    table.insert(menu._keybinds, self)
    j:Add(function()
        local i = table.find(menu._keybinds, self)
        if i then table.remove(menu._keybinds, i) end
        menu:_RefreshKeybindList()
    end)

    j:Add(btn.MouseButton1Click:Connect(function() self:_Listen() end))
    if not self.NoMode then
        j:Add(btn.MouseButton2Click:Connect(function()
            menu:OpenPopup(btn, Vector2.new(96, popupHeight(#MODES, 24)), function(frame, pj)
                buildOptionList(frame, pj, MODES, function(o) return o == self.Mode end, function(o)
                    self:SetMode(o)
                    menu:ClosePopup()
                end, 24)
            end, { Owner = self, AlignRight = true })
        end))
    end
    menu:_RefreshKeybindList()
    return self
end

function Keybind:GetLabel()
    return self._labelOverride or (self.Row.TitleLabel and self.Row.TitleLabel.Text) or "Keybind"
end

function Keybind:_SetState(v)
    if self.State == v then return end
    self.State = v
    self.Triggered:Fire(v)
    if self._callback then task.spawn(self._callback, v) end
    self.Menu:_RefreshKeybindList()
end

function Keybind:IsActive() return self.State end

function Keybind:_OnInput(bind, down)
    if self._listening or self.Bind == nil or self.Bind ~= bind or self.NoMode then return end
    if self.Mode == "Hold" then
        self:_SetState(down)
    elseif self.Mode == "Toggle" and down then
        self:_SetState(not self.State)
    end
end

function Keybind:_Listen()
    if self._listening then return end
    local menu = self.Menu
    self._listening = true
    menu._capturing = true
    self._btn.Text = "..."
    local con
    con = UserInputService.InputBegan:Connect(function(input)
        local b = inputToBind(input)
        if not b then return end
        con:Disconnect()
        self._listening = false
        task.defer(function() menu._capturing = false end)
        if b == Enum.KeyCode.Escape or b == Enum.KeyCode.Backspace then b = nil end
        self:SetBind(b)
    end)
    self._j:Add(con)
end

function Keybind:SetBind(bind, silent)
    self.Bind = bind
    if self._btn then self._btn.Text = keyName(bind) end
    if self.Mode ~= "Always" and not self.NoMode then self:_SetState(false) end
    self.BindChanged:Fire(bind)
    if self._onBind then task.spawn(self._onBind, bind) end
    if not silent then self.Changed:Fire(bind, self.Mode) end
    self.Menu:_RefreshKeybindList()
end

function Keybind:SetMode(mode, silent)
    if not table.find(MODES, mode) then return end
    self.Mode = mode
    self:_SetState(mode == "Always")
    if not silent then self.Changed:Fire(self.Bind, mode) end
    self.Menu:_RefreshKeybindList()
end

function Keybind:Get() return self.Bind, self.Mode end
function Keybind:_Serialize() return { Bind = serializeKey(self.Bind), Mode = self.Mode } end
function Keybind:_Deserialize(v)
    if type(v) ~= "table" then return end
    self:SetMode(v.Mode or self.Mode, true)
    self:SetBind(deserializeKey(v.Bind))
end

--==========================================================================
--  Option normalisation (WindUI-style names -> KiciaUI names) + small helpers
--==========================================================================
local function norm(o, kind)
    local n = {}
    for k, v in pairs(o or {}) do n[k] = v end
    if n.Label == nil then n.Label = n.Title end
    if n.Desc == nil then n.Desc = n.Description end
    if n.Options == nil then n.Options = n.Values end
    if kind == "Slider" and type(n.Value) == "table" then
        if n.Min == nil then n.Min = n.Value.Min end
        if n.Max == nil then n.Max = n.Value.Max end
        if n.Default == nil then n.Default = n.Value.Default end
    elseif n.Default == nil and n.Value ~= nil then
        n.Default = n.Value
    end
    if kind == "Keybind" and type(n.Default) == "string" then
        local ok, kc = pcall(function() return Enum.KeyCode[n.Default] end)
        n.Default = ok and kc or nil
    end
    return n
end

local function handle(inst, methods)
    local h = { Instance = inst }
    function h:SetVisible(v) inst.Visible = v return self end
    function h:Destroy() inst:Destroy() end
    for k, f in pairs(methods or {}) do h[k] = f end
    return h
end

local function copyText(s)
    for _, name in ipairs({ "setclipboard", "toclipboard", "set_clipboard" }) do
        local ok, f = pcall(function() return getgenv()[name] end)
        if ok and type(f) == "function" then
            pcall(f, s)
            return true
        end
    end
    return false
end

--==========================================================================
--  ColorPicker (HSV square + hue bar + optional transparency bar + hex box)
--==========================================================================
local ColorPicker = subclass("ColorPicker")
local HUE_SEQ = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)), ColorSequenceKeypoint.new(1 / 6, Color3.fromHSV(1 / 6, 1, 1)),
    ColorSequenceKeypoint.new(2 / 6, Color3.fromHSV(2 / 6, 1, 1)), ColorSequenceKeypoint.new(3 / 6, Color3.fromHSV(3 / 6, 1, 1)),
    ColorSequenceKeypoint.new(4 / 6, Color3.fromHSV(4 / 6, 1, 1)), ColorSequenceKeypoint.new(5 / 6, Color3.fromHSV(5 / 6, 1, 1)),
    ColorSequenceKeypoint.new(1, Color3.fromHSV(1, 1, 1)),
})

function ColorPicker.new(container, opts, attachRow)
    local row = attachRow or container:_Row({ Label = opts.Label, Desc = opts.Desc })
    local menu = row._menu
    local self = setmetatable({}, ColorPicker)
    Control.init(self, menu, "ColorPicker", row, opts)
    local j = self._j

    self.Value = opts.Default or Color3.new(1, 1, 1)
    self.H, self.S, self.V = self.Value:ToHSV()
    self.HasAlpha = type(opts.Transparency) == "number"
    self.Transparency = self.HasAlpha and clamp(opts.Transparency, 0, 1) or 0

    local swatch = create("TextButton", { Size = UDim2.fromOffset(30, 16) })
    swatch.BackgroundTransparency = self.Transparency
    swatch.BackgroundColor3 = self.Value
    corner(swatch, 4)
    stroke(swatch, "Outline")
    row:AttachRight(swatch, 20)
    j:Add(swatch)
    self._swatch = swatch

    j:Add(swatch.MouseButton1Click:Connect(function()
        menu:OpenPopup(swatch, Vector2.new(196, 176 + (self.HasAlpha and 20 or 0)), function(frame, pj)
            self:_BuildPopup(frame, pj)
        end, { Owner = swatch, AlignRight = true })
    end))
    j:Add(function() self._refresh = nil end)
    return self
end

function ColorPicker:_BuildPopup(frame, pj)
    local sv = create("Frame", { Position = UDim2.fromOffset(8, 8), Size = UDim2.fromOffset(180, 110), Parent = frame })
    sv.BackgroundTransparency = 0
    corner(sv, 4)
    local white = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, Parent = sv })
    corner(white, 4)
    create("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = white })
    local black = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), Parent = sv })
    corner(black, 4)
    create("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0), Parent = black })
    local cursor = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(10, 10), BackgroundTransparency = 1, ZIndex = 3, Parent = sv,
    })
    corner(cursor, UDim.new(1, 0))
    create("UIStroke", { Color = WHITE, Thickness = 2, Parent = cursor })

    local hue = create("Frame", {
        Position = UDim2.fromOffset(8, 126), Size = UDim2.fromOffset(180, 12), BackgroundColor3 = WHITE, Parent = frame,
    })
    corner(hue, 4)
    create("UIGradient", { Color = HUE_SEQ, Parent = hue })
    local hueThumb = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(4, 16),
        BackgroundColor3 = WHITE, ZIndex = 3, Parent = hue,
    })
    corner(hueThumb, 2)
    create("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1, Transparency = 0.4, Parent = hueThumb })

    local alpha, alphaThumb
    local nextY = 146
    if self.HasAlpha then
        alpha = create("Frame", {
            Position = UDim2.fromOffset(8, 146), Size = UDim2.fromOffset(180, 12), BackgroundColor3 = self.Value, Parent = frame,
        })
        corner(alpha, 4)
        stroke(alpha, "Outline")
        create("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = alpha })
        alphaThumb = create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(4, 16),
            BackgroundColor3 = WHITE, ZIndex = 3, Parent = alpha,
        })
        corner(alphaThumb, 2)
        create("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1, Transparency = 0.4, Parent = alphaThumb })
        nextY = 166
    end

    local hex = create("TextBox", {
        Position = UDim2.fromOffset(8, nextY), Size = UDim2.fromOffset(180, 22), FontFace = Fonts.SemiBold, TextSize = 13,
        ClearTextOnFocus = false, PlaceholderText = "HEX", Parent = frame,
    })
    hex.BackgroundTransparency = 0
    Theme.bind(hex, "BackgroundColor3", "ElementBackground")
    Theme.bind(hex, "TextColor3", "TextColor")
    corner(hex, 4)
    stroke(hex, "Outline")

    local function refresh()
        sv.BackgroundColor3 = Color3.fromHSV(self.H, 1, 1)
        cursor.Position = UDim2.fromScale(self.S, 1 - self.V)
        hueThumb.Position = UDim2.fromScale(self.H, 0.5)
        if alpha then
            alpha.BackgroundColor3 = self.Value
            alphaThumb.Position = UDim2.fromScale(self.Transparency, 0.5)
        end
        if not hex:IsFocused() then hex.Text = "#" .. toHex(self.Value) end
    end
    self._refresh = refresh
    pj:Add(function() self._refresh = nil end)
    refresh()

    bindDrag(pj, sv, function(pos)
        local a, s = sv.AbsolutePosition, sv.AbsoluteSize
        self:_SetHSV(self.H, clamp((pos.X - a.X) / s.X, 0, 1), 1 - clamp((pos.Y - a.Y) / s.Y, 0, 1))
    end)
    bindDrag(pj, hue, function(pos)
        local a, s = hue.AbsolutePosition, hue.AbsoluteSize
        self:_SetHSV(clamp((pos.X - a.X) / s.X, 0, 0.999), self.S, self.V)
    end)
    if alpha then
        bindDrag(pj, alpha, function(pos)
            local a, s = alpha.AbsolutePosition, alpha.AbsoluteSize
            self:_SetAlpha(clamp((pos.X - a.X) / s.X, 0, 1))
        end)
    end
    pj:Add(hex.FocusLost:Connect(function()
        local c = fromHex(hex.Text)
        if c then self:Set(c) end
        refresh()
    end))
end

function ColorPicker:_SetHSV(h, s, v, silent, exact)
    self.H, self.S, self.V = h, s, v
    self.Value = exact or Color3.fromHSV(h, s, v)
    self._swatch.BackgroundColor3 = self.Value
    if self._refresh then self._refresh() end
    if not silent then self:_Emit(self.Value, self.HasAlpha and self.Transparency or nil) end
end

function ColorPicker:_SetAlpha(t, silent)
    self.Transparency = t
    self._swatch.BackgroundTransparency = t
    if self._refresh then self._refresh() end
    if not silent then self:_Emit(self.Value, t) end
end

function ColorPicker:Set(color, silent, transparency)
    local alphaChanged = false
    if transparency ~= nil and self.HasAlpha then
        local t = clamp(transparency, 0, 1)
        alphaChanged = t ~= self.Transparency
        self.Transparency = t
        self._swatch.BackgroundTransparency = t
    end
    if typeof(color) == "Color3" and color ~= self.Value then
        local h, s, v = color:ToHSV()
        if s == 0 or v == 0 then h = self.H end
        self:_SetHSV(h, s, v, silent, color)
        return
    end
    if alphaChanged then
        if self._refresh then self._refresh() end
        if not silent then self:_Emit(self.Value, self.Transparency) end
    end
end

function ColorPicker:_Serialize()
    local t = color3ToTable(self.Value)
    if self.HasAlpha then t[4] = self.Transparency end
    return t
end

function ColorPicker:_Deserialize(v)
    local c = tableToColor3(v)
    if c then self:Set(c, false, type(v) == "table" and v[4] or nil) end
end

--==========================================================================
--  Buttons (single, with description/icon, or several per row)
--==========================================================================
local Button = subclass("Button")

function Button.newRow(container, defs)
    local menu = container._menu
    local m = menu.Metrics
    local gap, n = 8, #defs
    local first = norm(defs[1])
    local hasDesc = n == 1 and first.Desc ~= nil
    local height = hasDesc and math.max(m.Button.VisualHeight, 44) or m.Button.VisualHeight
    local frame = create("Frame", {
        Name = "ButtonRow", Size = UDim2.new(1, 0, 0, height), BackgroundTransparency = 1, LayoutOrder = container:_NextOrder(),
    })
    if container._onAdd then container._onAdd() end
    frame.Parent = container._content
    list(frame, Enum.FillDirection.Horizontal, gap)

    local j = Janitor.new()
    j:Add(frame)
    local self = setmetatable({
        Menu = menu, Kind = "Button", _j = j, Frame = frame, Buttons = {}, _titles = {}, _descs = {}, _locked = {},
    }, Button)

    for i, raw in ipairs(defs) do
        local def = norm(raw)
        local b = create("TextButton", {
            Size = UDim2.new(1 / n, -gap * (n - 1) / n, 1, 0), Text = "", LayoutOrder = i, Parent = frame,
        })
        b.BackgroundTransparency = 0
        Theme.bind(b, "BackgroundColor3", "GradientTop")
        corner(b, 5)
        stroke(b, "Outline")

        local variant = def.Variant
        local function baseColor()
            if variant == "primary" then return Theme.Tokens.Accent end
            if variant == "danger" then return Color3.fromRGB(224, 86, 86) end
            return Theme.Tokens.TextColor
        end

        local x = 10
        local ico = assetImage(def.Icon)
        local icon
        if ico then
            icon = create("ImageLabel", {
                AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Size = UDim2.fromOffset(16, 16),
                Image = ico, ImageColor3 = baseColor(), Parent = b,
            })
            x = 32
        end
        local left = hasDesc or def.Justify == "Left"
        local title = create("TextLabel", {
            Position = UDim2.new(0, left and x or 0, 0, hasDesc and 6 or 0),
            Size = UDim2.new(1, -(left and (x + 8) or 0), 0, hasDesc and 16 or height),
            Text = def.Label or "Button", FontFace = Fonts.SemiBold, TextSize = m.Row.TextSize - 2, TextColor3 = baseColor(),
            TextXAlignment = left and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center,
            TextTruncate = Enum.TextTruncate.AtEnd, Parent = b,
        })
        self._titles[i] = title
        if hasDesc then
            local d = create("TextLabel", {
                Position = UDim2.new(0, x, 0, 24), Size = UDim2.new(1, -(x + 8), 0, 14), Text = def.Desc, TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = b,
            })
            Theme.bind(d, "TextColor3", "Unselected")
            self._descs[i] = d
        end

        j:Add(Theme.onChange("Accent", function()
            title.TextColor3 = baseColor()
            if icon then icon.ImageColor3 = baseColor() end
        end))
        j:Add(b.MouseEnter:Connect(function()
            if not self._locked[i] then tween(b, { BackgroundColor3 = Theme.Tokens.TabButtonSelected }) end
        end))
        j:Add(b.MouseLeave:Connect(function() tween(b, { BackgroundColor3 = Theme.Tokens.GradientTop }) end))
        j:Add(b.MouseButton1Down:Connect(function()
            if not self._locked[i] then tween(b, { BackgroundColor3 = Theme.Tokens.TabShadow }, TweenInfo.new(0.06)) end
        end))
        j:Add(b.MouseButton1Click:Connect(function()
            if self._locked[i] then return end
            tween(b, { BackgroundColor3 = Theme.Tokens.TabButtonSelected })
            if def.Callback then task.spawn(def.Callback) end
        end))
        self.Buttons[i] = b
        if def.Locked then self:Lock(i) end
    end
    return self
end

function Button:SetLabel(text, index)
    local t = self._titles[index or 1]
    if t then t.Text = tostring(text) end
    return self
end
Button.SetTitle = Button.SetLabel

function Button:SetDesc(text, index)
    local d = self._descs[index or 1]
    if d then d.Text = tostring(text) end
    return self
end

function Button:Lock(index)
    local i = index or 1
    self._locked[i] = true
    self.Buttons[i].BackgroundTransparency = 0.5
    self._titles[i].TextTransparency = 0.5
    return self
end

function Button:Unlock(index)
    local i = index or 1
    self._locked[i] = false
    self.Buttons[i].BackgroundTransparency = 0
    self._titles[i].TextTransparency = 0
    return self
end

function Button:SetVisible(v) self.Frame.Visible = v return self end
function Button:Destroy() self._j:Destroy() end

