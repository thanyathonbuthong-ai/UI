--  Small coloured badge shown inside the watermark bar.
function Menu:AddTag(opts)
    opts = opts or {}
    local tag = create("Frame", { Name = "Tag", AutomaticSize = Enum.AutomaticSize.XY, LayoutOrder = 10, Parent = self._wm.Frame })
    tag.BackgroundTransparency = 0.7
    corner(tag, 4)
    pad(tag, 1, 6, 1, 6)
    local lbl = create("TextLabel", {
