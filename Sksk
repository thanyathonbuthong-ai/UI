                    local SVMap = Create("TextButton", {Parent = PickerArea, Text = "", BackgroundColor3 = Color3.fromHSV(h, 1, 1), Size = UDim2.new(1, -45, 0, 90), Position = UDim2.new(0, 10, 0, 10), AutoButtonColor = false, Active = true, NoTheme = true})
                    Create("UICorner", {Parent = SVMap, CornerRadius = UDim.new(0, 4)})

                    local WhiteGrad = Create("Frame", {Parent = SVMap, Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 2, NoTheme = true})
                    Create("UIGradient", {Parent = WhiteGrad, Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)}), Rotation = 0})
                    Create("UICorner", {Parent = WhiteGrad, CornerRadius = UDim.new(0, 4)})

                    local BlackGrad = Create("Frame", {Parent = SVMap, Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(0, 0, 0), ZIndex = 3, NoTheme = true})
                    Create("UIGradient", {Parent = BlackGrad, Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0)}), Rotation = 90})
                    Create("UICorner", {Parent = BlackGrad, CornerRadius = UDim.new(0, 4)})

                    local SVRing = Create("Frame", {Parent = BlackGrad, Size = UDim2.new(0, 10, 0, 10), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(s, 0, 1 - v_hsv, 0), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 4, NoTheme = true})
                    Create("UICorner", {Parent = SVRing, CornerRadius = UDim.new(1, 0)})
                    Create("UIStroke", {Parent = SVRing, Color = Color3.new(0, 0, 0), Thickness = 1, NoTheme = true})

                    local HueSlider = Create("TextButton", {Parent = PickerArea, Text = "", Size = UDim2.new(1, -20, 0, 15), Position = UDim2.new(0, 10, 0, 110), AutoButtonColor = false, BackgroundColor3 = Color3.new(1, 1, 1), Active = true, NoTheme = true})
                    Create("UICorner", {Parent = HueSlider, CornerRadius = UDim.new(0, 4)})
                    Create("UIGradient", {Parent = HueSlider, Color = ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)), ColorSequenceKeypoint.new(0.167, Color3.fromRGB(255, 255, 0)), ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0, 255, 0)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)), ColorSequenceKeypoint.new(0.667, Color3.fromRGB(0, 0, 255)), ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255, 0, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0))})})
                    local HueRing = Create("Frame", {Parent = HueSlider, Size = UDim2.new(0, 6, 0, 15), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(h, 0, 0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1), NoTheme = true})
                    Create("UICorner", {Parent = HueRing, CornerRadius = UDim.new(0, 2)})
                    Create("UIStroke", {Parent = HueRing, Color = Color3.new(0, 0, 0), Thickness = 1, NoTheme = true})

                    local function internalSet(value)
                        local c
                        if typeof(value) == "Color3" then
                            c = value
                        else
                            local ok, res = pcall(function() return Color3.fromHex(value) end)
                            if ok then c = res end
                        end
                        if c then
                            color = c
                            h, s, v_hsv = color:ToHSV()
                            DisplayBtn.BackgroundColor3 = color
                            SVMap.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                            SVRing.Position = UDim2.new(s, 0, 1 - v_hsv, 0)
                            HueRing.Position = UDim2.new(h, 0, 0.5, 0)
                            SafeCall(cfg.Callback, color)
                        end
                    end

                    local function UpdateColor()
                        color = Color3.fromHSV(h, s, v_hsv)
                        DisplayBtn.BackgroundColor3 = color
                        SVMap.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                        SafeCall(cfg.Callback, color)
                    end

                    local draggingSV = false
                    local draggingHue = false
                    local function LockScroll(state) if PageObj and PageObj.Scroll then PageObj.Scroll.ScrollingEnabled = state end end

                    SVMap.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then draggingSV = true LockScroll(false) end end)
                    HueSlider.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then draggingHue = true LockScroll(false) end end)
                    table.insert(Conns, UserInputService.InputEnded:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            draggingSV = false
                            draggingHue = false
                            LockScroll(true)
                        end
                    end))

                    table.insert(Conns, UserInputService.InputChanged:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                            if draggingSV then
                                local relX = math.clamp((input.Position.X - SVMap.AbsolutePosition.X) / SVMap.AbsoluteSize.X, 0, 1)
                                local relY = math.clamp((input.Position.Y - SVMap.AbsolutePosition.Y) / SVMap.AbsoluteSize.Y, 0, 1)
                                s = relX
                                v_hsv = 1 - relY
                                SVRing.Position = UDim2.new(s, 0, 1 - v_hsv, 0)
                                UpdateColor()
                            elseif draggingHue then
                                local relX = math.clamp((input.Position.X - HueSlider.AbsolutePosition.X) / HueSlider.AbsoluteSize.X, 0, 1)
                                h = relX
                                HueRing.Position = UDim2.new(h, 0, 0.5, 0)
                                UpdateColor()
                            end
                        end
                    end))

                    local api = {}
                    DisplayBtn.MouseButton1Click:Connect(function()
                        if api.Locked then return end
                        dropped = not dropped
                        Tween(CPFrame, {Size = UDim2.new(1, 0, 0, dropped and 185 or 30)}, 0.3)
                    end)
                    AddInfoIcon(CPFrame, UDim2.new(1, -65, 0, 7), cfg.Info)

                    local key = cfg.Flag or name
                    Register(key, internalSet, function() return color:ToHex() end)

                    function api:Set(v) internalSet(v) end
                    function api:Get() return color end
                    AttachAPI(api, cfg, Wrap, CPFrame, SetDesc, TitleLbl, key)
                    return api
                end

                -- ======================================================================
                -- Keybind   (WindUI Keybind: Value, CanChange, Blacklist, Callback(key))
                -- ======================================================================
                function Elements:AddKeybind(a, b, c, d)
                    local cfg = type(a) == "table" and a or {Title = a, Value = b, Callback = c, Info = d}
                    local name = cfg.Title or cfg.Name or "Keybind"
                    local function Norm(k)
                        if typeof(k) == "EnumItem" then return k.Name end
                        if type(k) == "string" and k ~= "" then return k end
                        return "None"
                    end
                    local value = Norm(cfg.Value or cfg.Default or "F")
                    local canChange = cfg.CanChange ~= false
                    local blacklist = {}
                    for _, k in ipairs(cfg.Blacklist or {}) do blacklist[Norm(k)] = true end
                    local picking = false
                    local Wrap, SetDesc = NewSlot(cfg)

                    local KFrame = Create("Frame", {Parent = Wrap, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 1})
                    local TitleLbl = Create("TextLabel", {Parent = KFrame, Text = name, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = SubTextColor, BackgroundTransparency = 1, Size = UDim2.new(1, -130, 1, 0), Position = UDim2.new(0, 10, 0, 0), TextXAlignment = Enum.TextXAlignment.Left})
                    local Pill = Create("TextButton", {Parent = KFrame, Text = value, Font = Enum.Font.GothamBold, TextSize = 11, NoScale = true, TextColor3 = TextColor, BackgroundColor3 = FieldColor, AutoButtonColor = false, Size = UDim2.new(0, 40, 0, 20), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0)})
                    Create("UICorner", {Parent = Pill, CornerRadius = UDim.new(0, 4)})
                    local PillStroke = Create("UIStroke", {Parent = Pill, Color = StrokeColor, Thickness = 1})
                    AddBounce(Pill)

                    local function Resize()
                        local w = TextService:GetTextSize(Pill.Text, 11, Enum.Font.GothamBold, Vector2.new(400, 20)).X + 18
                        Pill.Size = UDim2.new(0, math.max(w, 30), 0, 20)
                    end
                    Resize()

                    local api = {}
                    Pill.MouseButton1Click:Connect(function()
                        if api.Locked or not canChange or picking then return end
                        picking = true
                        Pill.Text = "..."
                        Resize()
                        Tween(PillStroke, {Color = AccentColor}, 0.2)
                        local conn
                        conn = UserInputService.InputBegan:Connect(function(input)
                            local picked
                            if input.UserInputType == Enum.UserInputType.Keyboard then
                                if input.KeyCode == Enum.KeyCode.Escape then picked = false
                                elseif blacklist[input.KeyCode.Name] then return
                                else picked = input.KeyCode.Name end
                            elseif input.UserInputType == Enum.UserInputType.MouseButton2 then picked = "MouseRight"
                            elseif input.UserInputType == Enum.UserInputType.MouseButton3 then picked = "MouseMiddle"
                            else return end
                            conn:Disconnect()
                            picking = false
                            if picked then
                                value = picked
                                SafeCall(cfg.OnChange, value)
                            end
                            Pill.Text = value
                            Resize()
                            Tween(PillStroke, {Color = StrokeColor}, 0.2)
                        end)
                    end)

                    table.insert(Conns, UserInputService.InputBegan:Connect(function(input)
                        if picking or api.Locked or UserInputService:GetFocusedTextBox() then return end
                        local pressed
                        if input.UserInputType == Enum.UserInputType.Keyboard then pressed = input.KeyCode.Name
                        elseif input.UserInputType == Enum.UserInputType.MouseButton2 then pressed = "MouseRight"
                        elseif input.UserInputType == Enum.UserInputType.MouseButton3 then pressed = "MouseMiddle" end
                        if pressed and pressed == value then SafeCall(cfg.Callback, pressed) end
                    end))
                    AddInfoIcon(KFrame, UDim2.new(1, -110, 0.5, -8), cfg.Info)

                    local function internalSet(v)
                        value = Norm(v)
                        Pill.Text = value
                        Resize()
                    end
                    local key = cfg.Flag or name
                    Register(key, internalSet, function() return value end)

                    function api:Set(v) internalSet(v) end
                    function api:Get() return value end
                    AttachAPI(api, cfg, Wrap, KFrame, SetDesc, TitleLbl, key)
                    return api
                end

