                            SearchBox.Text = ""
                            Tween(Arrow, {Rotation = 180}, 0.3)
                            local dynamicHeight = math.min(DList.AbsoluteContentSize.Y, listHeight)
                            ListFrame.Size = UDim2.new(1, -20, 0, dynamicHeight)
                            Tween(DropFrame, {Size = UDim2.new(1, 0, 0, 50 + 32 + dynamicHeight)}, 0.3)
                        else
                            CloseDrop()
                        end
                    end)
                    AddInfoIcon(DropFrame, UDim2.new(1, -25, 0, 0), cfg.Info)

                    local key = cfg.Flag or name
                    Register(key, internalSet, function() return selected end)

                    function api:Set(v) internalSet(v) end
                    function api:Get() return CopySelected() end
                    function api:GetOptions() return options end
                    function api:Refresh(newValues)
                        options = NormalizeValues(newValues)
                        if isMulti then
                            local kept = {}
                            for _, v in ipairs(selected) do if table.find(options, v) then table.insert(kept, v) end end
                            selected = kept
                        elseif selected ~= nil and not table.find(options, selected) then
                            selected = (cfg.AllowNone ~= true) and options[1] or nil
                        end
                        Rebuild()
                        UpdateText()
                    end
