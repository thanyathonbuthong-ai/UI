    card.Parent = container._content
    list(card, Enum.FillDirection.Vertical, 4)

    local head = create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 1, Parent = card })
    local title = create("TextLabel", {
        Size = UDim2.new(1, -64, 1, 0), Text = opts.Label or "Code", FontFace = Fonts.SemiBold, TextSize = m.Row.TextSize - 2,
        TextXAlignment = Enum.TextXAlignment.Left, Parent = head,
    })
    Theme.bind(title, "TextColor3", "TextColor")
    local copy = create("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(58, 22), Text = "Copy",
        FontFace = Fonts.SemiBold, TextSize = 12, Parent = head,
    })
    copy.BackgroundTransparency = 0
    Theme.bind(copy, "BackgroundColor3", "GradientTop")
    Theme.bind(copy, "TextColor3", "TextColor")
    corner(copy, 5)
    stroke(copy, "Outline")

    local lines = select(2, code:gsub("\n", "\n")) + 1
    local area = create("ScrollingFrame", {
        Size = UDim2.new(1, 0, 0, clamp(lines * 16 + 16, 40, 220)), AutomaticCanvasSize = Enum.AutomaticSize.XY,
        CanvasSize = UDim2.new(), ScrollBarThickness = 2, ScrollingDirection = Enum.ScrollingDirection.XY,
        ElasticBehavior = Enum.ElasticBehavior.Never, LayoutOrder = 2, Parent = card,
    })
    area.BackgroundTransparency = 0
    Theme.bind(area, "BackgroundColor3", "Background")
    Theme.bind(area, "ScrollBarImageColor3", "Accent")
    corner(area, 5)
    stroke(area, "Outline")
    local text = create("TextLabel", {
        Size = UDim2.new(), AutomaticSize = Enum.AutomaticSize.XY, RichText = true, Text = highlightLua(code),
        FontFace = Font.fromEnum(Enum.Font.Code), TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = false, Parent = area,
    })
    Theme.bind(text, "TextColor3", "TextColor")
    pad(text, 8, 8, 8, 8)

    local resetTok = 0
    copy.MouseButton1Click:Connect(function()
        local ok = copyText(code)
        copy.Text = ok and "Copied!" or "No clipboard"
        resetTok = resetTok + 1
        local mine = resetTok
        task.delay(1.2, function() if mine == resetTok and copy.Parent then copy.Text = "Copy" end end)
        if opts.OnCopy then task.spawn(opts.OnCopy, code) end
    end)
    return handle(card, {
        SetCode = function(_, c) code = tostring(c) text.Text = highlightLua(code) end,
        SetTitle = function(_, t) title.Text = tostring(t) end,
    })
end

