--  Side-by-side layout:  local left, right = section:AddColumns(2)
function Container:AddColumns(count)
    count = math.max(2, count or 2)
    local menu = self._menu
    local wrap = create("Frame", {
        Name = "Columns", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
        LayoutOrder = self:_NextOrder(),
    })
    if self._onAdd then self._onAdd() end
    wrap.Parent = self._content
    local gap, cells = 8, {}
    for i = 1, count do
        local cell = create("Frame", {
            Name = "Cell" .. i, BackgroundTransparency = 1, Size = UDim2.new(1 / count, -gap * (count - 1) / count, 0, 0),
            Position = UDim2.new((i - 1) / count, (i - 1) * gap / count, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = wrap,
        })
        list(cell, Enum.FillDirection.Vertical, menu.Metrics.Section.ElementGap)
        cells[i] = setmetatable({ _menu = menu, _content = cell, _order = 0, _onAdd = self._onAdd, Frame = cell, _j = Janitor.new() }, Group)
    end
    return table.unpack(cells)
end

--  Group: indented block that only shows while its Source control matches (default: toggle is on).
function Group.new(parent, opts)
    local menu = parent._menu
    local m = menu.Metrics
    local wrap = create("Frame", {
        Name = "Group", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, LayoutOrder = parent:_NextOrder(),
    })
    if parent._onAdd then parent._onAdd() end
    wrap.Parent = parent._content

    local bar = create("Frame", { Position = UDim2.fromOffset(2, 0), Size = UDim2.new(0, 1, 1, 0), Parent = wrap })
    Theme.bind(bar, "BackgroundColor3", "Outline")

    local inner = create("Frame", {
        Name = "Content", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, Parent = wrap,
    })
    pad(inner, 0, 0, 0, 14)
    list(inner, Enum.FillDirection.Vertical, m.Section.ElementGap)

    local self = setmetatable({
        _menu = menu, _content = inner, _order = 0, _onAdd = parent._onAdd, Frame = wrap, _j = Janitor.new(),
    }, Group)
    self._j:Add(wrap)

    local source = opts.Source
    if source then
        local test = opts.When or function(v) return v == true end
        local function apply(v) wrap.Visible = (test(v) and true or false) ~= (opts.Invert == true) end
        apply(source.Value)
        self._j:Add(source.Changed:Connect(apply))
    end
    return self
end

function Group:SetVisible(v) self.Frame.Visible = v end
function Group:Destroy() self._j:Destroy() end

