                local ItemContainer = Create("Frame", {Parent = SectionContainer, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 0, 30), AutomaticSize = Enum.AutomaticSize.Y})
                local Pad = Create("UIPadding", {Parent = ItemContainer, PaddingBottom = UDim.new(0, 10), PaddingTop = UDim.new(0, 5)})
                local SList = Create("UIListLayout", {Parent = ItemContainer, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8)})

                local Elements = {}

                -- ======================================================================
                -- WindUI-style section controls (collapse, rename, destroy)
                -- ======================================================================
                sectionOpts = sectionOpts or {}
                local Collapsed = false
                local SectionArrow

                local function SetCollapsed(state)
                    Collapsed = state
                    if state then
                        ItemContainer.AutomaticSize = Enum.AutomaticSize.None
                        ItemContainer.Size = UDim2.new(1, 0, 0, 0)
                        ItemContainer.Visible = false
                    else
                        ItemContainer.Visible = true
                        ItemContainer.AutomaticSize = Enum.AutomaticSize.Y
                    end
                    if SectionArrow then Tween(SectionArrow, {Rotation = state and -90 or 0}, 0.2) end
                end

                if sectionOpts.Collapsible then
                    SectionArrow = Create("TextLabel", {Parent = SectionContainer, Text = "▼", Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = SubTextColor, BackgroundTransparency = 1, Size = UDim2.new(0, 20, 0, 30), Position = UDim2.new(1, -28, 0, 0)})
                    local HeaderBtn = Create("TextButton", {Parent = SectionContainer, Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), ZIndex = 3, AutoButtonColor = false})
                    HeaderBtn.MouseButton1Click:Connect(function() SetCollapsed(not Collapsed) end)
                    if sectionOpts.Opened == false then SetCollapsed(true) end
                end

                -- ======================================================================
                -- Element helpers
                -- ======================================================================
                -- Every element lives inside a "slot": [ element frame ] + optional description line
                local function NewSlot(cfg)
                    local Wrap = Create("Frame", {Parent = ItemContainer, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y})
                    Create("UIListLayout", {Parent = Wrap, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2)})
                    local DescLabel
                    local function SetDesc(text)
                        if text == nil or text == "" then
                            if DescLabel then DescLabel.Visible = false end
                            return
                        end
                        if not DescLabel then
                            DescLabel = Create("TextLabel", {Parent = Wrap, Text = text, Font = Enum.Font.Gotham, TextSize = 11, NoScale = true, TextColor3 = SubTextColor, TextTransparency = 0.2, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 2})
                            Create("UIPadding", {Parent = DescLabel, PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10)})
                        end
                        DescLabel.Text = text
                        DescLabel.Visible = true
                    end
                    SetDesc(cfg and cfg.Desc)
                    return Wrap, SetDesc
                end

                -- Shared element API: :SetTitle :SetDesc :SetVisible :Lock :Unlock :Highlight :Destroy
                local function AttachAPI(api, cfg, Wrap, Frame, SetDesc, TitleLabel, configKey)
                    api.Frame = Wrap
                    api.Locked = false
                    local Overlay, OverlayText

                    function api:SetTitle(t) if TitleLabel then TitleLabel.Text = t end end
                    function api:SetDesc(t) SetDesc(t) end
                    function api:SetVisible(v) Wrap.Visible = v end

                    function api:Lock(msg)
                        api.Locked = true
                        if not Overlay then
                            Overlay = Create("TextButton", {Parent = Frame, Text = "", AutoButtonColor = false, BackgroundColor3 = CardColor, BackgroundTransparency = 0.2, Size = UDim2.new(1, 0, 1, 0), ZIndex = 20, Active = true})
                            Create("UICorner", {Parent = Overlay, CornerRadius = UDim.new(0, 4)})
                            Create("ImageLabel", {Parent = Overlay, Image = "rbxassetid://6031082533", ImageColor3 = SubTextColor, BackgroundTransparency = 1, Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(1, -24, 0.5, -6), ZIndex = 21})
                            OverlayText = Create("TextLabel", {Parent = Overlay, Text = "", Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = SubTextColor, BackgroundTransparency = 1, Size = UDim2.new(1, -50, 1, 0), Position = UDim2.new(0, 10, 0, 0), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 21})
                        end
                        OverlayText.Text = msg or cfg.LockedTitle or "Locked"
                        Overlay.Visible = true
                    end

                    function api:Unlock()
                        api.Locked = false
                        if Overlay then Overlay.Visible = false end
                    end

                    function api:Highlight()
                        local s = Create("UIStroke", {Parent = Wrap, Color = AccentColor, Thickness = 1.5, Transparency = 0})
                        Tween(s, {Transparency = 1}, 1)
                        task.delay(1.1, function() s:Destroy() end)
                    end

                    function api:Destroy()
                        if configKey and Window.ConfigElements[configKey] then Window.ConfigElements[configKey] = nil end
                        Wrap:Destroy()
                    end

                    if cfg.Locked then api:Lock(cfg.LockedTitle) end
                end

                local function Register(key, setFn, getFn)
                    Window.ConfigElements[key] = { Set = setFn, Get = getFn }
                end

                -- ======================================================================
                -- Copy button
                -- ======================================================================
                function Elements:AddCopyButton(a, b, c)
                    local cfg = type(a) == "table" and a or {Title = a, Text = b, Info = c}
                    local name = cfg.Title or cfg.Name or "Copy"
                    local copyText = cfg.Text or cfg.Value or ""
                    local Wrap, SetDesc = NewSlot(cfg)

                    local BtnFrame = Create("Frame", {Parent = Wrap, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 1})
                    local Btn = Create("TextButton", {Parent = BtnFrame, Text = name, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = TextColor, BackgroundColor3 = BackgroundColor, Size = UDim2.new(1, -20, 1, 0), Position = UDim2.new(0, 10, 0, 0), AutoButtonColor = false})
                    Create("UICorner", {Parent = Btn, CornerRadius = UDim.new(0, 4)})
                    Create("UIStroke", {Parent = Btn, Color = StrokeColor, Thickness = 1})

                    AddBounce(Btn)
                    Btn.MouseEnter:Connect(function() Tween(Btn, {BackgroundColor3 = HoverColor}, 0.2) end)
                    Btn.MouseLeave:Connect(function() Tween(Btn, {BackgroundColor3 = BackgroundColor}, 0.2) end)

                    local busy = false
                    Btn.MouseButton1Click:Connect(function()
                        SafeCopyToClipboard(copyText)
                        if busy then return end
                        busy = true
                        local oldText = Btn.Text
                        Btn.Text = "Copied to Clipboard!"
                        Tween(Btn, {TextColor3 = AccentColor, BackgroundColor3 = HoverColor}, 0.2)
                        task.wait(1.5)
                        if Btn.Parent then
                            Btn.Text = oldText
                            Tween(Btn, {TextColor3 = TextColor, BackgroundColor3 = BackgroundColor}, 0.2)
                        end
                        busy = false
                    end)
                    AddInfoIcon(BtnFrame, UDim2.new(1, -40, 0.5, -8), cfg.Info)

                    local api = {}
                    function api:SetText(t) copyText = t end
                    AttachAPI(api, cfg, Wrap, BtnFrame, SetDesc, Btn, nil)
                    return api
                end

                -- ======================================================================
                -- Button   (WindUI: Title / Desc / Callback / Color / Icon / Locked)
                -- ======================================================================
                function Elements:AddButton(a, b, c)
                    local cfg = type(a) == "table" and a or {Title = a, Callback = b, Info = c}
