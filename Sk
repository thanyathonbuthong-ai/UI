        BorderSizePixel  = 0,
        ZIndex           = 5,
        Parent           = track,
    })
    corner(fill, 3)

    local comp = {
        Type     = "Slider",
        Name     = opts.Name,
        Flag     = opts.Flag,
        Min      = min, Max = max,
        Value    = opts.Default or min,
        Callback = opts.Callback or function() end,
        SetValue = function(_, v, fire)
            v = math.clamp(tonumber(v) or min, min, max)
            if opts.Increment then v = math.floor(v / opts.Increment + 0.5) * opts.Increment end
            comp.Value = v
            local pct = (v - min) / (max - min)
            fill.Size = UDim2.new(pct, 0, 1, 0)
            valueBox.Text = tostring(math.floor(v * 100) / 100)
            if fire ~= false then task.spawn(comp.Callback, v) end
        end,
        SetCallback = function(_, fn) comp.Callback = fn or function() end end,
        Destroy  = function() row:Destroy() end,
    }

    local dragging = false
    local function updateFrom(input)
        local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        comp:SetValue(min + rel * (max - min))
    end
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; updateFrom(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then updateFrom(input) end
    end)
    valueBox.FocusLost:Connect(function()
        comp:SetValue(tonumber(valueBox.Text) or comp.Value)
    end)

    comp:SetValue(comp.Value, false)
    if opts.Default then task.spawn(comp.Callback, comp.Value) end
    return register(self, comp)
end

-- --------------------------------------------------------------------------
-- Input (text box)
-- --------------------------------------------------------------------------
function Tab:CreateInput(opts)
    opts = opts or {}
    local row  = makeRow(self, 58)
    makeRowLabel(row, opts.Name or "Input")
    local box = new("TextBox", {
        Size                   = UDim2.new(0, 140, 0, 28),
        Position               = UDim2.new(1, -140, 0.5, -14),
        BackgroundColor3       = Theme.CardBackground,
        BackgroundTransparency = 0.2,
        BorderSizePixel        = 0,
        Text                   = opts.Default or "",
        PlaceholderText        = opts.PlaceholderText or "",
        TextColor3             = Theme.Accent,
        PlaceholderColor3      = Theme.TextDim,
        TextSize               = 12,
        Font                   = Theme.Font,
        ClearTextOnFocus       = false,
        ZIndex                 = 5,
        Parent                 = row,
    })
    corner(box, 6)
    local comp = {
        Type     = "Input",
        Name     = opts.Name,
        Flag     = opts.Flag,
        Value    = opts.Default or "",
        Callback = opts.Callback or function() end,
        SetText  = function(_, t) box.Text = t; comp.Value = t end,
        SetCallback = function(_, fn) comp.Callback = fn or function() end end,
        Destroy  = function() row:Destroy() end,
    }
    box.FocusLost:Connect(function(enter)
        comp.Value = box.Text
        task.spawn(comp.Callback, box.Text, enter)
    end)
    return register(self, comp)
end

-- --------------------------------------------------------------------------
-- Dropdown
-- --------------------------------------------------------------------------
function Tab:CreateDropdown(opts)
    opts = opts or {}
    local options = opts.Options or {}
    local row = makeRow(self, 46)
    local label = makeRowLabel(row, opts.Name or "Dropdown")
    label.Size = UDim2.new(1, -110, 1, 0)

    local btn = new("TextButton", {
        Size                   = UDim2.new(0, 90, 0, 28),
        Position               = UDim2.new(1, -90, 0.5, -14),
        BackgroundColor3       = Theme.CardBackground,
        BackgroundTransparency = 0.2,
        BorderSizePixel        = 0,
        Text                   = opts.Default or options[1] or "None",
        TextColor3             = Theme.Accent,
        TextSize               = 12,
        Font                   = Theme.Font,
        ZIndex                 = 5,
        Parent                 = row,
    })
    corner(btn, 6)

    local listFrame = new("Frame", {
        Size             = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = Theme.CardBackground,
        BorderSizePixel  = 0,
        ClipsDescendants = true,
        Visible          = false,
        LayoutOrder      = #self.Components + 1,
        ZIndex           = 3,
        Parent           = self.Page,
    })
    corner(listFrame, 10)
    stroke(listFrame, Theme.Accent, 1.5, 0.5)
    padding(listFrame, 6, 6, 6, 6)
    listLayout(listFrame, 4, Enum.FillDirection.Vertical, Enum.SortOrder.LayoutOrder)
    table.insert(self.Components, listFrame)

    local open, openConn = false
    local comp = {
        Type     = "Dropdown",
        Name     = opts.Name,
        Flag     = opts.Flag,
        Value    = opts.Default or options[1],
        Options  = options,
        Callback = opts.Callback or function() end,
        SetOptions = function(_, opts2)
            comp.Options = opts2 or {}
            for _, c in ipairs(listFrame:GetChildren()) do
                if c:IsA("TextButton") then c:Destroy() end
            end
            comp:_buildOptions(listFrame, btn, function() open = false; listFrame.Visible = false; row.Size = UDim2.new(1, 0, 0, 46) end)
        end,
        SetCallback = function(_, fn) comp.Callback = fn or function() end end,
        Destroy  = function() row:Destroy(); listFrame:Destroy() end,
    }
    function comp:_buildOptions(parent, button, close)
        local n = 0
        for i, opt in ipairs(self.Options) do
            n = n + 1
            local ob = new("TextButton", {
                Size                   = UDim2.new(1, 0, 0, 26),
                BackgroundColor3       = Theme.MainBackground,
                BackgroundTransparency = 0.4,
                Text                   = opt,
                TextColor3             = (opt == self.Value) and Theme.Accent or Theme.TextInactive,
                TextSize               = 12,
                Font                   = Theme.Font,
                LayoutOrder            = i,
                ZIndex                 = 4,
                Parent                 = parent,
            })
            corner(ob, 6)
            ob.MouseButton1Click:Connect(function()
                self.Value = opt; button.Text = opt
                task.spawn(self.Callback, opt)
                close()
            end)
        end
        parent.Size = UDim2.new(1, 0, 0, math.max(n, 1) * 30 + 12)
    end
    comp:_buildOptions(listFrame, btn, function()
        open = false; listFrame.Visible = false
    end)

    btn.MouseButton1Click:Connect(function()
        open = not open
        listFrame.Visible = open
    end)
    return register(self, comp)
end

