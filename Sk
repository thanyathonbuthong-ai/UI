function KawatanUI:Toggle(force)
    self._visible = (force ~= nil) and force or (not self._visible)
    self.Window.Visible = self._visible
    if self.TopBar then self.TopBar.Visible = self._visible end
end

-- --------------------------------------------------------------------------
-- Tabs
-- --------------------------------------------------------------------------
local Tab = {}
Tab.__index = Tab

function KawatanUI:CreateTab(name)
    local tab = setmetatable({ Name = name, Window = self, Components = {} }, Tab)
    local index = #self.Tabs + 1

    -- Tab button
    local count = math.max(index, 1)
    local btn = new("TextButton", {
        Size                   = UDim2.new(1 / count, 0, 1, 0),
        BackgroundTransparency = 1,
        Text                   = name,
        TextColor3             = (index == 1) and Theme.AccentStrong or Theme.TextInactive,
        TextSize               = 11,
        Font                   = Theme.Font,
        TextStrokeColor3       = Color3.fromRGB(0, 0, 0),
        TextStrokeTransparency = 0.5,
        ZIndex                 = 3,
        Parent                 = self.TabBar,
    })
    -- re-layout existing tab buttons to equal widths
    for i, t in ipairs(self.Tabs) do
        t.Button.Size = UDim2.new(1 / count, 0, 1, 0)
        t.Button.Position = UDim2.new((i - 1) / count, 0, 0, 0)
    end
    btn.Position = UDim2.new((index - 1) / count, 0, 0, 0)
    tab.Button = btn

    -- Scrolling page
    local page = new("ScrollingFrame", {
        Size                   = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        ScrollBarThickness     = 6,
        ScrollBarImageColor3   = Theme.AccentStrong,
        BorderSizePixel        = 0,
        ZIndex                 = 2,
        Active                 = true,
        ScrollingDirection     = Enum.ScrollingDirection.Y,
        ElasticBehavior        = Enum.ElasticBehavior.Never,
        AutomaticCanvasSize    = Enum.AutomaticSize.Y,
        CanvasSize             = UDim2.new(0, 0, 0, 0),
        ScrollBarImageTransparency = 0.4,
        Visible                = (index == 1),
        Parent                 = self.PageContainer,
    })
    padding(page, 3, 9, 3, 3)
    listLayout(page, 15, Enum.FillDirection.Vertical, Enum.SortOrder.LayoutOrder)
    tab.Page = page

    btn.MouseButton1Click:Connect(function()
        for _, t in ipairs(self.Tabs) do
            t.Page.Visible = false
            tween(t.Button, { TextColor3 = Theme.TextInactive }):Play()
        end
        page.Visible = true
        tween(btn, { TextColor3 = Theme.AccentStrong }):Play()
    end)

    table.insert(self.Tabs, tab)
    return tab
end

-- --------------------------------------------------------------------------
-- Base card row (58px tall, matching original toggle rows)
-- --------------------------------------------------------------------------
local function makeRow(tab, height)
    height = height or 58
    local row = new("Frame", {
        Size             = UDim2.new(1, 0, 0, height),
        BackgroundColor3 = Theme.CardBackground,
        BorderSizePixel  = 0,
        LayoutOrder      = #tab.Components + 1,
        ZIndex           = 3,
        Parent           = tab.Page,
    })
    corner(row, 12)
    padding(row, 15, 15, 15, 15)
    stroke(row, Theme.Accent, 1.5, 0.5)
    table.insert(tab.Components, row)
    return row
end

local function makeRowLabel(row, text)
    return new("TextLabel", {
        Size                   = UDim2.new(1, -90, 1, 0),
        BackgroundTransparency = 1,
        Text                   = text,
        TextColor3             = Theme.TextInactive,
        TextSize               = 13,
        Font                   = Theme.Font,
        TextXAlignment         = Enum.TextXAlignment.Left,
        TextWrapped            = true,
        ZIndex                 = 4,
        Parent                 = row,
    })
end

local function register(tab, comp)
    table.insert(tab.Window.Components, comp)
    if comp.Flag then tab.Window._flags[comp.Flag] = comp end
    return comp
end

-- --------------------------------------------------------------------------
-- Toggle (pill switch, original style: 60x28 track, 26x26 knob)
-- --------------------------------------------------------------------------
function Tab:CreateToggle(opts)
    opts = opts or {}
    local row  = makeRow(self)
    local label = makeRowLabel(row, opts.Name or "Toggle")

    local switch = new("Frame", {
        Size                   = UDim2.new(0, 60, 0, 28),
        Position               = UDim2.new(1, -60, 0.5, -14),
        BackgroundColor3       = Theme.TrackDark,
        BackgroundTransparency = 0.1,
        BorderSizePixel        = 0,
        ZIndex                 = 4,
        Parent                 = row,
    })
    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = switch }) -- pill (original style)
    local knob = new("Frame", {
        Size             = UDim2.new(0, 26, 0, 26),
        Position         = UDim2.new(0, 1, 0.5, -13),
        BackgroundColor3 = Theme.White,
        BorderSizePixel  = 0,
        ZIndex           = 5,
        Parent           = switch,
    })
    new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob }) -- pill knob

    local hitbox = new("TextButton", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        Text = "", ZIndex = 6, Parent = row,
    })

    local comp = {
        Type     = "Toggle",
        Name     = opts.Name,
        Flag     = opts.Flag,
        State    = not not opts.Default,
        Callback = opts.Callback or function() end,
        SetState = function(_, v, fire)
            comp.State = not not v
            if comp.State then
                tween(switch, { BackgroundColor3 = Theme.AccentDeep }):Play()
                tween(knob, { Position = UDim2.new(0, 31, 0.5, -13) }):Play()
                label.TextColor3 = Theme.Accent
            else
                tween(switch, { BackgroundColor3 = Theme.TrackDark }):Play()
                tween(knob, { Position = UDim2.new(0, 1, 0.5, -13) }):Play()
                label.TextColor3 = Theme.TextInactive
            end
            if fire ~= false then task.spawn(comp.Callback, comp.State) end
        end,
        SetCallback = function(_, fn) comp.Callback = fn or function() end end,
        Destroy    = function() row:Destroy() end,
    }
    hitbox.MouseButton1Click:Connect(function() comp:SetState(not comp.State) end)
    comp:SetState(comp.State, false) -- apply visuals without firing
    if opts.Default then task.spawn(comp.Callback, true) end
    return register(self, comp)
end

-- --------------------------------------------------------------------------
-- Button
-- --------------------------------------------------------------------------
function Tab:CreateButton(opts)
    opts = opts or {}
    local row = makeRow(self, 46)
    local btn = new("TextButton", {
        Size                   = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text                   = opts.Name or "Button",
        TextColor3             = Theme.Accent,
        TextSize               = 14,
        Font                   = Theme.Font,
        ZIndex                 = 4,
        Parent                 = row,
    })
    local comp = {
        Type     = "Button",
        Name     = opts.Name,
        Callback = opts.Callback or function() end,
        SetCallback = function(_, fn) comp.Callback = fn or function() end end,
        SetName  = function(_, n) btn.Text = n end,
        Destroy  = function() row:Destroy() end,
    }
    btn.MouseButton1Click:Connect(function()
        tween(row, { BackgroundColor3 = Theme.AccentDeep, BackgroundTransparency = 0.6 }):Play()
        task.delay(0.12, function()
            tween(row, { BackgroundColor3 = Theme.CardBackground, BackgroundTransparency = 0 }):Play()
        end)
        task.spawn(comp.Callback)
    end)
    return register(self, comp)
end

-- --------------------------------------------------------------------------
-- Keybind (original style: 60x28 button, "Not Set" grey, click -> "..." listen)
-- --------------------------------------------------------------------------
function Tab:CreateKeybind(opts)
    opts = opts or {}
    local row  = makeRow(self)
    makeRowLabel(row, opts.Name or "Keybind")

    local btn = new("TextButton", {
        Size                   = UDim2.new(0, 60, 0, 28),
        Position               = UDim2.new(1, -60, 0.5, -14),
        BackgroundColor3       = Theme.CardBackground,
        BackgroundTransparency = 0.3,
        BorderSizePixel        = 0,
        TextSize               = 12,
        Font                   = Theme.Font,
        Text                   = "Not Set",
        TextColor3             = Theme.TextDim,
        ZIndex                 = 5,
        Parent                 = row,
    })
    corner(btn, 6)

    local comp = {
        Type     = "Keybind",
        Name     = opts.Name,
        Flag     = opts.Flag,
        Key      = opts.Default,
        Callback = opts.Callback or function() end,
        SetKey   = function(_, key)
            comp.Key = key
            btn.Text = key and key.Name or "Not Set"
            btn.TextColor3 = key and Theme.Accent or Theme.TextDim
        end,
        SetCallback = function(_, fn) comp.Callback = fn or function() end end,
        Destroy  = function() row:Destroy() end,
    }
    if opts.Default then comp:SetKey(opts.Default) end

    local listening, conn
    btn.MouseButton1Click:Connect(function()
        if listening then return end
        listening = true
        btn.Text = "..."
        btn.TextColor3 = Theme.Accent
        btn.BackgroundColor3 = Theme.AccentDeep
        btn.BackgroundTransparency = 0.5
        conn = UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                comp:SetKey(input.KeyCode)
                listening = false; conn:Disconnect()
                btn.BackgroundColor3 = Theme.CardBackground
                btn.BackgroundTransparency = 0.3
            end
        end)
    end)
    btn.MouseButton2Click:Connect(function() -- right-click clears (original behaviour)
        if conn then conn:Disconnect() end
        listening = false
        comp:SetKey(nil)
        btn.BackgroundColor3 = Theme.CardBackground
        btn.BackgroundTransparency = 0.3
    end)

    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if comp.Key and input.KeyCode == comp.Key and not listening then
            task.spawn(comp.Callback)
        end
    end)
    return register(self, comp)
end

