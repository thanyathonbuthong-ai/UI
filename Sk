--[[
    ========================================================================
    KawatanUI  —  Reusable Roblox UI Library
    ------------------------------------------------------------------------
    Style ported from the "Kawatan Hub | Combat Duels" deobfuscated script.
    Accent: sky-cyan (76,194,255) / (50,180,255) / (0,150,255)
    Dark panels: (15,20,30) main, (25,35,50) cards, GothamBold font,
    12px rounded corners, accent UIStroke, pill toggles, hamburger toggle
    button, and an optional FPS/PING top bar — all matching the original.

    Usage:
        local KawatanUI = loadstring(game:HttpGet("<raw-url>"))()
        -- or: local KawatanUI = require(path.to.module)

        local Window = KawatanUI:CreateWindow({
            Name       = "Kawatan Hub",
            ToggleKey  = Enum.KeyCode.RightShift,  -- optional, hides/shows window
            ShowTopBar = true,                     -- FPS / PING bar (original style)
            Watermark  = true,                     -- bottom-right watermark
        })

        local Tab = Window:CreateTab("Combat")

        Tab:CreateToggle({
            Name    = "Melee Aimbot",
            Default = true,
            Flag    = "melee_aimbot",   -- optional, used by config save/load
            Callback = function(state) end,
        })

        Tab:CreateButton({ Name = "Fling Everyone", Callback = function() end })

        Tab:CreateKeybind({
            Name    = "Fling Key",
            Default = Enum.KeyCode.F,
            Callback = function() end, -- fired when the bound key is pressed
        })

        Tab:CreateSlider({
            Name = "Range", Min = 1, Max = 100, Default = 20,
            Callback = function(value) end,
        })

        Tab:CreateInput({
            Name = "Target Player", PlaceholderText = "username",
            Callback = function(text) end,
        })

        Tab:CreateDropdown({
            Name = "Speed Preset", Options = {"Normal","Steal","Desync"},
            Default = "Normal", Callback = function(option) end,
        })

        Tab:CreateLabel("--- Visuals ---")
        Tab:CreateParagraph({ Title = "Info", Content = "Line one.\nLine two." })

        Window:Notify({ Title = "KawatanUI", Text = "Loaded!", Duration = 5 })

        -- Config (requires executor filesystem; silently no-ops otherwise):
        Window:LoadConfig("MyScriptConfig.json")
        -- call Window:SaveConfig("MyScriptConfig.json") whenever you want to save
    ========================================================================
]]

if not game:IsLoaded() then game.Loaded:Wait() end

local Players            = game:GetService("Players")
local UserInputService   = game:GetService("UserInputService")
local TweenService       = game:GetService("TweenService")
local RunService         = game:GetService("RunService")
local HttpService        = game:GetService("HttpService")
local LocalPlayer        = Players.LocalPlayer
local PlayerGui          = LocalPlayer:WaitForChild("PlayerGui")

-- --------------------------------------------------------------------------
-- Theme (extracted from the original Kawatan Hub script)
-- --------------------------------------------------------------------------
local Theme = {
    Accent         = Color3.fromRGB(76, 194, 255),
    AccentStrong   = Color3.fromRGB(50, 180, 255),
    AccentDeep     = Color3.fromRGB(0, 150, 255),
    MainBackground = Color3.fromRGB(15, 20, 30),
    CardBackground = Color3.fromRGB(25, 35, 50),
    BarBackground  = Color3.fromRGB(30, 30, 30),
    TrackDark      = Color3.fromRGB(40, 40, 50),
    TextActive     = Color3.fromRGB(76, 194, 255),
    TextInactive   = Color3.fromRGB(180, 190, 210),
    TextDim        = Color3.fromRGB(100, 100, 100),
    White          = Color3.fromRGB(255, 255, 255),
    Font           = Enum.Font.GothamBold,
}

local TWEEN_INFO = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- --------------------------------------------------------------------------
-- Small helpers
-- --------------------------------------------------------------------------
local function new(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do obj[k] = v end
    if parent then obj.Parent = parent end
    return obj
end

local function corner(parent, radius)
    return new("UICorner", { CornerRadius = UDim.new(0, radius or 12), Parent = parent })
end

local function stroke(parent, color, thickness, transparency)
    return new("UIStroke", {
        Color            = color or Theme.Accent,
        Thickness        = thickness or 1.5,
        Transparency     = transparency or 0.4,
        ApplyStrokeMode  = Enum.ApplyStrokeMode.Border,
        Parent           = parent,
    })
end

local function padding(parent, l, r, t, b)
    return new("UIPadding", {
        PaddingLeft   = UDim.new(0, l or 0),
        PaddingRight  = UDim.new(0, r or 0),
        PaddingTop    = UDim.new(0, t or 0),
        PaddingBottom = UDim.new(0, b or 0),
        Parent        = parent,
    })
end

local function listLayout(parent, paddingPx, fillDir, sortOrder)
    local l = new("UIListLayout", {
        Padding           = UDim.new(0, paddingPx or 15),
        SortOrder         = sortOrder or Enum.SortOrder.LayoutOrder,
        FillDirection     = fillDir or Enum.FillDirection.Vertical,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        Parent            = parent,
    })
    if fillDir == Enum.FillDirection.Horizontal then
        l.VerticalAlignment = Enum.VerticalAlignment.Center
    end
    return l
end

local function tween(obj, props, info)
    return TweenService:Create(obj, info or TWEEN_INFO, props)
end

-- Simple drag controller for a frame (drags `target` when holding `handle`).
local function makeDraggable(handle, target)
    local dragging, dragStart, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging  = true
            dragStart = input.Position
            startPos  = target.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                                        startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

-- --------------------------------------------------------------------------
-- Library root
-- --------------------------------------------------------------------------
local KawatanUI = {}
KawatanUI.__index = KawatanUI

function KawatanUI:CreateWindow(options)
    options = options or {}
    local self = setmetatable({}, KawatanUI)
    self.Name       = options.Name or "Kawatan Hub"
    self.ToggleKey  = options.ToggleKey
    self.Tabs       = {}
    self.Components = {} -- flat list for config save/load
    self._flags     = {} -- [flag] = component

    -- Root ScreenGui
    self.ScreenGui = new("ScreenGui", {
        Name           = "KawatanUI",
        ResetOnSpawn   = false,
        DisplayOrder   = 999999,
        ZIndexBehavior = Enum.ZIndexBehavior.Global,
        Parent         = PlayerGui,
    })

    if options.ShowTopBar ~= false then self:_buildTopBar() end
    if options.Watermark then self:_buildWatermark() end

    self:_buildToggleButton()
    self:_buildMainWindow()
    self:_buildNotifications()

    if self.ToggleKey then
        UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            if input.KeyCode == self.ToggleKey then self:Toggle() end
        end)
    end

    return self
end

-- --------------------------------------------------------------------------
-- Top bar (original style: "Kawatan Hub | FPS 60 | PING 50ms")
-- --------------------------------------------------------------------------
function KawatanUI:_buildTopBar()
    local bar = new("Frame", {
        Name                   = "TopBar",
        Size                   = UDim2.new(0, 300, 0, 30),
        Position               = UDim2.new(0.5, 0, 0, 10),
        AnchorPoint            = Vector2.new(0.5, 0),
        BackgroundColor3       = Theme.BarBackground,
        BackgroundTransparency = 0.3,
        BorderSizePixel        = 0,
        ZIndex                 = 999,
        Parent                 = self.ScreenGui,
    })
    corner(bar, 10)
    stroke(bar, Theme.Accent, 1.5, 0.5)
    padding(bar, 15, 15, 8, 8)
    local layout = listLayout(bar, 10, Enum.FillDirection.Horizontal)
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

    local function stat(text)
        return new("TextLabel", {
            Size             = UDim2.new(0, 0, 1, 0),
            AutomaticSize    = Enum.AutomaticSize.X,
            BackgroundTransparency = 1,
            Text             = text,
            TextColor3       = Theme.Accent,
            TextSize         = 12,
            Font             = Theme.Font,
            ZIndex           = 1000,
            Parent           = bar,
        })
    end
    stat(self.Name)
    local sep = stat("|"); sep.TextTransparency = 0.5
    local fpsLabel  = stat("FPS --")
    local sep2 = stat("|"); sep2.TextTransparency = 0.5
    local pingLabel = stat("PING --ms")

    local frames, last = 0, os.clock()
    RunService.RenderStepped:Connect(function()
        frames = frames + 1
        local now = os.clock()
        if now - last >= 1 then
            fpsLabel.Text = "FPS " .. frames
            frames, last = 0, now
            local ok, stats = pcall(function() return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValueString() end)
            pingLabel.Text = "PING " .. (ok and (stats:match("%d+") or "--") or "--") .. "ms"
        end
    end)
    self.TopBar = bar
end

function KawatanUI:_buildWatermark()
    local wm = new("TextLabel", {
        Size                   = UDim2.new(0, 0, 0, 20),
        AutomaticSize          = Enum.AutomaticSize.X,
        Position               = UDim2.new(1, -12, 1, -28),
        AnchorPoint            = Vector2.new(1, 1),
        BackgroundColor3       = Theme.BarBackground,
        BackgroundTransparency = 0.3,
        Text                   = "  " .. self.Name .. "  ",
        TextColor3             = Theme.Accent,
        TextSize               = 12,
        Font                   = Theme.Font,
        ZIndex                 = 999,
        Parent                 = self.ScreenGui,
    })
    corner(wm, 6)
    stroke(wm, Theme.Accent, 1, 0.6)
    self.Watermark = wm
end

-- --------------------------------------------------------------------------
-- Floating hamburger toggle button (original style: 50x50, 3 white bars)
-- --------------------------------------------------------------------------
function KawatanUI:_buildToggleButton()
    local btn = new("TextButton", {
        Name             = "ToggleButton",
        Size             = UDim2.new(0, 50, 0, 50),
        Position         = UDim2.new(1, -65, 0, 15),
        BackgroundColor3 = Theme.AccentStrong,
        Text             = "",
        BorderSizePixel  = 0,
        ZIndex           = 10,
        Parent           = self.ScreenGui,
    })
    corner(btn, 12)
    makeDraggable(btn, btn)
    for i = 0, 2 do
        local bar = new("Frame", {
            Size             = UDim2.new(0, 24, 0, 3),
            Position         = UDim2.new(0.5, -12, 0, 12 + i * 9),
            BackgroundColor3 = Theme.White,
            BorderSizePixel  = 0,
            ZIndex           = 11,
            Parent           = btn,
        })
        corner(bar, 2)
    end
    btn.MouseButton1Click:Connect(function() self:Toggle() end)
    self.ToggleButton = btn
end

