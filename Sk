-- Notifications (toast stack, top-right)
-- --------------------------------------------------------------------------
function KawatanUI:_buildNotifications()
    self.NotifyHolder = new("Frame", {
        Size                   = UDim2.new(0, 280, 1, -20),
        Position               = UDim2.new(1, -20, 0, 10),
        AnchorPoint            = Vector2.new(1, 0),
        BackgroundTransparency = 1,
        ZIndex                 = 10000,
        Parent                 = self.ScreenGui,
    })
    local l = listLayout(self.NotifyHolder, 8, Enum.FillDirection.Vertical)
    l.HorizontalAlignment = Enum.HorizontalAlignment.Right
    l.VerticalAlignment   = Enum.VerticalAlignment.Top
end

function KawatanUI:Notify(opts)
    opts = opts or {}
    local n = new("Frame", {
        Size                   = UDim2.new(1, 0, 0, 0),
        AutomaticSize          = Enum.AutomaticSize.Y,
        BackgroundColor3       = Theme.MainBackground,
        BackgroundTransparency = 0.15,
        BorderSizePixel        = 0,
        ZIndex                 = 10001,
        Parent                 = self.NotifyHolder,
    })
    corner(n, 10)
    stroke(n, Theme.Accent, 1.5, 0.4)
    padding(n, 12, 12, 10, 10)
    listLayout(n, 4)
    new("TextLabel", {
        Size                   = UDim2.new(1, 0, 0, 18),
        BackgroundTransparency = 1,
        Text                   = opts.Title or self.Name,
        TextColor3             = Theme.Accent,
        TextSize               = 14,
        Font                   = Theme.Font,
        TextXAlignment         = Enum.TextXAlignment.Left,
        ZIndex                 = 10002,
        Parent                 = n,
    })
    local body = new("TextLabel", {
        Size                   = UDim2.new(1, 0, 0, 0),
        AutomaticSize          = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Text                   = opts.Text or "",
        TextColor3             = Theme.TextInactive,
        TextSize               = 12,
        Font                   = Theme.Font,
        TextXAlignment         = Enum.TextXAlignment.Left,
        TextWrapped            = true,
        ZIndex                 = 10002,
        Parent                 = n,
    })
    n.Size = UDim2.new(1, 0, 0, body.TextBounds.Y + 40)
    task.delay(opts.Duration or 5, function()
        tween(n, { BackgroundTransparency = 1, Position = n.Position + UDim2.new(0, 20, 0, 0) }):Play()
        for _, d in ipairs(n:GetDescendants()) do
            if d:IsA("TextLabel") then tween(d, { TextTransparency = 1 }):Play() end
        end
        task.wait(0.25); n:Destroy()
    end)
end

-- --------------------------------------------------------------------------
-- Config save / load (uses executor FS if available, no-ops otherwise)
-- --------------------------------------------------------------------------
function KawatanUI:SaveConfig(path)
    local data = {}
    for _, comp in ipairs(self.Components) do
        if comp.Flag then
            if comp.Type == "Toggle" then data[comp.Flag] = comp.State
            elseif comp.Type == "Slider" then data[comp.Flag] = comp.Value
            elseif comp.Type == "Keybind" then data[comp.Flag] = comp.Key and comp.Key.Name or nil
            elseif comp.Type == "Dropdown" then data[comp.Flag] = comp.Value
            elseif comp.Type == "Input" then data[comp.Flag] = comp.Value end
        end
    end
    pcall(function()
        if writefile then writefile(path, HttpService:JSONEncode(data)) end
    end)
end

function KawatanUI:LoadConfig(path)
    local ok, raw = pcall(function()
        return (readfile and isfile and isfile(path)) and readfile(path) or nil
    end)
    if not ok or not raw then return end
    local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok2 or type(data) ~= "table" then return end
    for flag, value in pairs(data) do
        local comp = self._flags[flag]
        if comp then
            if comp.Type == "Toggle" then comp:SetState(value, true)
            elseif comp.Type == "Slider" then comp:SetValue(value, true)
            elseif comp.Type == "Keybind" then
                local k = Enum.KeyCode[value]
                if k then comp:SetKey(k) end
            elseif comp.Type == "Dropdown" then
                comp.Value = value
            elseif comp.Type == "Input" then comp:SetText(value) end
        end
    end
end

-- --------------------------------------------------------------------------
-- Destroy whole UI
-- --------------------------------------------------------------------------
function KawatanUI:Destroy()
    if self.ScreenGui then self.ScreenGui:Destroy() end
end

return KawatanUI

