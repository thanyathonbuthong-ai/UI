        LayoutOrder            = #self.Components + 1,
        ZIndex                 = 3,
        Parent                 = self.Page,
    })
    new("TextLabel", {
        Size                   = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text                   = text or "",
        TextColor3             = Theme.Accent,
        TextSize               = 14,
        Font                   = Theme.Font,
        TextXAlignment         = Enum.TextXAlignment.Left,
        ZIndex                 = 4,
        Parent                 = row,
    })
    table.insert(self.Components, row)
    return { Type = "Label", Destroy = function() row:Destroy() end,
             SetText = function(_, t) row:FindFirstChildWhichIsA("TextLabel").Text = t end }
end

function Tab:CreateParagraph(opts)
    opts = opts or {}
    local text = (opts.Title and (opts.Title .. "\n") or "") .. (opts.Content or "")
    local h = 30 + (#text:split("\n") * 16)
    local row = makeRow(self, h)
    local lbl = new("TextLabel", {
        Size                   = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text                   = text,
        TextColor3             = Theme.TextInactive,
        TextSize               = 12,
        Font                   = Theme.Font,
        TextXAlignment         = Enum.TextXAlignment.Left,
        TextYAlignment         = Enum.TextYAlignment.Top,
        TextWrapped            = true,
        ZIndex                 = 4,
        Parent                 = row,
    })
    return { Type = "Paragraph", Destroy = function() row:Destroy() end }
end

