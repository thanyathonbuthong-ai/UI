--[[
	Kings UI Library
	โหลดด้วย:
		local Kings = loadstring(game:HttpGet("LINK_RAW_ของคุณ"))()
]]

local Kings = {}
local UIAnimationSpeed = 0.1

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local GUI_NAME = "KingsLibUI"

---------------------------------------------------------------------
-- helpers
---------------------------------------------------------------------
local function new(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		inst[k] = v
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function gotham(weight)
	return Font.new("rbxasset://fonts/families/GothamSSm.json", weight or Enum.FontWeight.Bold, Enum.FontStyle.Normal)
end

local function corner(parent, r)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 7) }, parent)
end

local function stroke(parent, color, thickness)
	return new("UIStroke", { Color = color or Color3.fromRGB(20, 20, 20), Thickness = thickness or 0.51 }, parent)
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
end

local function getTab(window, tab)
	if type(tab) == "table" then
		return tab[1]
	end
	return window[1][tab or "main"]
end

---------------------------------------------------------------------
-- ScreenGui (สร้างเองเพราะรันผ่าน loadstring)
---------------------------------------------------------------------
local function candidateParents()
	local list = {}
	pcall(function()
		if gethui then
			table.insert(list, gethui())
		end
	end)
	pcall(function()
		table.insert(list, game:GetService("CoreGui"))
	end)
	pcall(function()
		table.insert(list, Players.LocalPlayer:WaitForChild("PlayerGui"))
	end)
	return list
end

-- ลบอันเก่าถ้ารันซ้ำ
for _, p in ipairs(candidateParents()) do
	pcall(function()
		local old = p:FindFirstChild(GUI_NAME)
		if old then
			old:Destroy()
		end
	end)
end

local ScreenGui = new("ScreenGui", {
	Name = GUI_NAME,
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	DisplayOrder = 999,
})

pcall(function()
	if syn and syn.protect_gui then
		syn.protect_gui(ScreenGui)
	end
end)

for _, p in ipairs(candidateParents()) do
	local ok = pcall(function()
		ScreenGui.Parent = p
	end)
	if ok and ScreenGui.Parent then
		break
	end
end

Kings.ScreenGui = ScreenGui

function Kings.destroy()
	ScreenGui:Destroy()
end

