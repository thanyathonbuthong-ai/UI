-- Dropdown (เลือกอันเดียว หรือ multi เลือกหลายอัน)
-- options = { multi = true, default = {...}, search = true, callback = function(v) end }
function Kings.newDropdownElement(window, tab, text, values, options)
	if type(options) == "function" then
		options = { callback = options }
	end
	options = options or {}
	values = values or {}

	local multi = options.multi == true
	local ITEM_H, MAX_LIST = 28, 150
	local topOffset = options.search and 34 or 0

	local frame, uiStroke = baseElement(getTab(window, tab), "windowElementDropdown", 40)
	frame.ClipsDescendants = true

	local header = new("TextButton", {
		BackgroundTransparency = 1,
		Text = "",
		Size = UDim2.new(1, 0, 0, 40),
	}, frame)

	local title = titleLabel(header, text, UDim2.new(0.5, -10, 1, 0))

	local valueLabel = new("TextLabel", {
		BackgroundTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTruncate = Enum.TextTruncate.AtEnd,
		FontFace = gotham(Enum.FontWeight.Regular),
		TextSize = 14,
		TextColor3 = Color3.fromRGB(150, 150, 150),
		Size = UDim2.new(0.5, -40, 1, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		Text = "",
	}, header)

	local arrow = new("TextLabel", {
		BackgroundTransparency = 1,
		FontFace = gotham(),
		TextSize = 16,
		TextColor3 = TEXT,
		Text = ">",
		Size = UDim2.new(0, 20, 0, 40),
		Position = UDim2.new(1, -28, 0, 0),
	}, header)

	local search
	if options.search then
		search = new("TextBox", {
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.92,
			BorderSizePixel = 0,
			ClearTextOnFocus = false,
			PlaceholderText = "Search...",
			PlaceholderColor3 = Color3.fromRGB(150, 150, 150),
			Text = "",
			TextColor3 = WHITE,
			TextSize = 14,
			FontFace = gotham(Enum.FontWeight.Regular),
			Size = UDim2.new(1, -16, 0, 26),
			Position = UDim2.new(0, 8, 0, 44),
		}, frame)
		corner(search, 5)
	end

	local list = new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Active = true,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Color3.fromRGB(90, 90, 90),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Position = UDim2.new(0, 8, 0, 44 + topOffset),
		Size = UDim2.new(1, -16, 0, 0),
	}, frame)
	new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, list)

	local selected, callbacks, buttons = {}, {}, {}
	local open, filter = false, ""
	local setOpen, resize

	if options.callback then
		table.insert(callbacks, options.callback)
	end

	local function selectedList()
		local out = {}
		for _, v in ipairs(values) do
			if selected[v] then
				table.insert(out, v)
			end
		end
		return out
	end

	local function summary()
		local l = selectedList()
		if #l == 0 then
			return multi and "None" or "-"
		end
		local s = {}
		for _, v in ipairs(l) do
			table.insert(s, tostring(v))
		end
		return table.concat(s, ", ")
	end

	local function fire()
		local result = multi and selectedList() or selectedList()[1]
		for _, f in ipairs(callbacks) do
			task.spawn(f, result)
		end
	end

	local function paint()
		for v, b in pairs(buttons) do
			local on = selected[v] == true
			b.BackgroundColor3 = on and ACCENT or WHITE
			b.BackgroundTransparency = on and 0.6 or 0.95
			b.TextColor3 = on and WHITE or Color3.fromRGB(200, 200, 200)
		end
		valueLabel.Text = summary()
	end

	local function visibleCount()
		local n = 0
		for _, b in pairs(buttons) do
			if b.Visible then
				n = n + 1
			end
		end
		return n
	end

	resize = function()
		local h = math.clamp(visibleCount() * (ITEM_H + 2), 0, MAX_LIST)
		list.Size = UDim2.new(1, -16, 0, h)
		if open then
			TweenService:Create(frame, TweenInfo.new(0.15), {
				Size = UDim2.new(1, -26, 0, 44 + topOffset + h + 8),
			}):Play()
		end
	end

	setOpen = function(state)
		open = state
		TweenService:Create(arrow, TweenInfo.new(0.15), { Rotation = open and 90 or 0 }):Play()
		if open then
			resize()
		else
			TweenService:Create(frame, TweenInfo.new(0.15), { Size = UDim2.new(1, -26, 0, 40) }):Play()
		end
	end

	local function choose(v)
		if multi then
			selected[v] = (not selected[v]) or nil
		else
			selected = { [v] = true }
		end
		paint()
		fire()
		if not multi then
			setOpen(false)
		end
	end

	local function applyFilter()
		for v, b in pairs(buttons) do
			b.Visible = filter == "" or string.find(string.lower(tostring(v)), filter, 1, true) ~= nil
		end
	end

	local function rebuild()
		for _, b in pairs(buttons) do
			b:Destroy()
		end
		buttons = {}
		for i, v in ipairs(values) do
			local b = new("TextButton", {
				Name = tostring(v),
				LayoutOrder = i,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				BackgroundColor3 = WHITE,
				BackgroundTransparency = 0.95,
				FontFace = gotham(Enum.FontWeight.Regular),
				TextSize = 14,
				TextColor3 = Color3.fromRGB(200, 200, 200),
				Text = tostring(v),
				Size = UDim2.new(1, -6, 0, ITEM_H),
			}, list)
			corner(b, 5)
			b.MouseButton1Click:Connect(function()
				choose(v)
			end)
			buttons[v] = b
		end
		applyFilter()
		paint()
		resize()
	end

	if search then
		search:GetPropertyChangedSignal("Text"):Connect(function()
			filter = string.lower(search.Text)
			applyFilter()
			resize()
		end)
	end

	header.MouseButton1Click:Connect(function()
		setOpen(not open)
	end)

	-- default
	local def = options.default
	if type(def) == "table" then
		for _, v in ipairs(def) do
			selected[v] = true
			if not multi then break end
		end
	elseif def ~= nil then
		selected[def] = true
	end

	rebuild()

	local t = commonFunctions(frame, uiStroke, title)
	t.getValue = function()
		return multi and selectedList() or selectedList()[1]
	end
	t.setValue = function(v)
		selected = {}
		if type(v) == "table" then
			for _, x in ipairs(v) do
				selected[x] = true
				if not multi then break end
			end
		elseif v ~= nil then
			selected[v] = true
		end
		paint()
		fire()
	end
	t.refresh = function(newValues)
		values = newValues or {}
		local keep = {}
		for _, v in ipairs(values) do
			if selected[v] then
				keep[v] = true
			end
		end
		selected = keep
		rebuild()
	end
	t.onchange = function(func)
		table.insert(callbacks, func)
	end
	t.open = function() setOpen(true) end
	t.close = function() setOpen(false) end
	return t
end

-- Keybind
-- defaultKey = Enum.KeyCode.F หรือ "F"
function Kings.newKeybindElement(window, tab, text, defaultKey, callback)
	local key
	if typeof(defaultKey) == "EnumItem" then
		key = defaultKey
	elseif type(defaultKey) == "string" then
		local ok, k = pcall(function() return Enum.KeyCode[defaultKey] end)
		key = ok and k or nil
	end

	local pressCallbacks, changeCallbacks = {}, {}
	if callback then
		table.insert(pressCallbacks, callback)
	end

	local frame, uiStroke = baseElement(getTab(window, tab), "windowElementKeybind", 40)
	local title = titleLabel(frame, text, UDim2.new(1, -110, 1, 0))

	local keyBtn = new("TextButton", {
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.85,
		BorderSizePixel = 0,
		FontFace = gotham(),
		TextSize = 13,
		TextColor3 = TEXT,
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.new(0, 84, 0, 26),
	}, frame)
	corner(keyBtn, 5)

	local listening = false
	local function render()
		keyBtn.Text = listening and "..." or (key and key.Name or "None")
	end
	render()

	keyBtn.MouseButton1Click:Connect(function()
		listening = true
		render()
	end)

	local conn = UserInputService.InputBegan:Connect(function(input, processed)
		if listening then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				listening = false
				key = input.KeyCode ~= Enum.KeyCode.Escape and input.KeyCode or nil
				render()
				for _, f in ipairs(changeCallbacks) do
					task.spawn(f, key)
				end
			end
		elseif key and not processed and input.KeyCode == key then
			for _, f in ipairs(pressCallbacks) do
				task.spawn(f, key)
			end
		end
	end)
	frame.Destroying:Connect(function()
		conn:Disconnect()
	end)

	local t = commonFunctions(frame, uiStroke, title)
	t.getKey = function() return key end
	t.setKey = function(k)
		key = k
		render()
	end
	t.onpress = function(func) table.insert(pressCallbacks, func) end
	t.onchange = function(func) table.insert(changeCallbacks, func) end
	return t
end

-- Colorpicker
function Kings.newColorpickerElement(window, tab, text, defaultColor, callback)
	local color = typeof(defaultColor) == "Color3" and defaultColor or Color3.fromRGB(255, 255, 255)
	local h, s, v = color:ToHSV()
	local callbacks = {}
	if callback then
		table.insert(callbacks, callback)
	end

	local frame, uiStroke = baseElement(getTab(window, tab), "windowElementColorpicker", 40)
	frame.ClipsDescendants = true

	local header = new("TextButton", {
		BackgroundTransparency = 1,
		Text = "",
		Size = UDim2.new(1, 0, 0, 40),
	}, frame)
	local title = titleLabel(header, text, UDim2.new(1, -60, 1, 0))

	local swatch = new("Frame", {
		BorderSizePixel = 0,
		BackgroundColor3 = color,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.new(0, 34, 0, 20),
	}, header)
	corner(swatch, 5)
	stroke(swatch, WHITE, 1).Transparency = 0.7

	-- saturation / value square
	local sv = new("Frame", {
		BorderSizePixel = 0,
		BackgroundColor3 = Color3.fromHSV(h, 1, 1),
		Position = UDim2.new(0, 10, 0, 48),
		Size = UDim2.new(1, -50, 0, 100),
	}, frame)
	corner(sv, 5)

	local white = new("Frame", { BorderSizePixel = 0, BackgroundColor3 = WHITE, Size = UDim2.new(1, 0, 1, 0) }, sv)
	corner(white, 5)
	new("UIGradient", { Transparency = NumberSequence.new(0, 1) }, white)

	local black = new("Frame", { BorderSizePixel = 0, BackgroundColor3 = Color3.new(0, 0, 0), Size = UDim2.new(1, 0, 1, 0) }, sv)
	corner(black, 5)
	new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }, black)

	local svCursor = new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.new(0, 10, 0, 10),
		ZIndex = 3,
	}, sv)
	corner(svCursor, 5).CornerRadius = UDim.new(1, 0)
	stroke(svCursor, WHITE, 2)

	-- hue bar
	local hueBar = new("Frame", {
		BorderSizePixel = 0,
		BackgroundColor3 = WHITE,
		Position = UDim2.new(1, -30, 0, 48),
		Size = UDim2.new(0, 20, 0, 100),
	}, frame)
	corner(hueBar, 5)
	local keys = {}
	for i = 0, 6 do
		table.insert(keys, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6 == 1 and 0.999 or i / 6, 1, 1)))
	end
	new("UIGradient", { Rotation = 90, Color = ColorSequence.new(keys) }, hueBar)

	local hueCursor = new("Frame", {
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.new(1, 4, 0, 3),
		ZIndex = 3,
	}, hueBar)
	stroke(hueCursor, Color3.new(0, 0, 0), 1)

	local hex = new("TextBox", {
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.9,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		TextColor3 = WHITE,
		TextSize = 14,
		FontFace = gotham(Enum.FontWeight.Regular),
		Position = UDim2.new(0, 10, 0, 156),
		Size = UDim2.new(1, -20, 0, 26),
		Text = "",
	}, frame)
	corner(hex, 5)

	local function refresh(fire)
		color = Color3.fromHSV(h, s, v)
		swatch.BackgroundColor3 = color
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
		hueCursor.Position = UDim2.new(0.5, 0, h, 0)
		hex.Text = "#" .. color:ToHex()
		if fire then
			for _, f in ipairs(callbacks) do
				task.spawn(f, color)
			end
		end
	end
	refresh(false)

	onDrag(sv, function(pos)
		s = math.clamp((pos.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
		v = 1 - math.clamp((pos.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
		refresh(true)
	end)

	onDrag(hueBar, function(pos)
		h = math.clamp((pos.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y, 0, 0.999)
		refresh(true)
	end)

	hex.FocusLost:Connect(function()
		local ok, c = pcall(Color3.fromHex, hex.Text)
		if ok and c then
			h, s, v = c:ToHSV()
		end
		refresh(ok)
	end)

	local open = false
	header.MouseButton1Click:Connect(function()
		open = not open
		TweenService:Create(frame, TweenInfo.new(0.15), {
			Size = UDim2.new(1, -26, 0, open and 192 or 40),
		}):Play()
	end)

	local t = commonFunctions(frame, uiStroke, title)
	t.getColor = function() return color end
	t.setColor = function(c)
		h, s, v = c:ToHSV()
		refresh(true)
	end
	t.onchange = function(func) table.insert(callbacks, func) end
	return t
end

