-- Switch
function Kings.newSwitchElement(window, tab, text, state)
	state = state == true

	local frame, uiStroke = baseElement(getTab(window, tab), "windowElementSwitch", 40)

	local label = new("TextButton", {
		TextWrapped = true,
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		FontFace = gotham(),
		TextSize = 15,
		TextColor3 = Color3.fromRGB(221, 221, 221),
		Size = UDim2.new(1, 0, 1, 0),
		Text = text or "",
	}, frame)

	local stateImg = new("ImageButton", {
		Name = "off",
		Image = "rbxassetid://3926307971",
		ImageRectSize = Vector2.new(36, 36),
		Size = UDim2.new(0, 25, 0, 25),
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(1, -35, 0.5, 0),
		BackgroundTransparency = 1,
		ZIndex = 2,
	}, frame)

	local function render()
		if state then
			stateImg.ImageColor3 = Color3.fromRGB(118, 150, 255)
			stateImg.ImageRectOffset = Vector2.new(764, 244)
		else
			stateImg.ImageColor3 = Color3.fromRGB(116, 116, 116)
			stateImg.ImageRectOffset = Vector2.new(804, 124)
		end
	end
	render()

	local t = commonFunctions(frame, uiStroke, label)

	t.getState = function() return state end
	t.setState = function(v)
		state = v == true
		render()
	end
	t.switch = function()
		state = not state
		render()
	end
	-- กดแล้วสลับสถานะอัตโนมัติ และส่งค่า state ใหม่ให้ func
	t.onclick = function(func)
		local function handler()
			state = not state
			render()
			task.spawn(func, state)
		end
		label.MouseButton1Click:Connect(handler)
		stateImg.MouseButton1Click:Connect(handler)
	end

	return t
end

