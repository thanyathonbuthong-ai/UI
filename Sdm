function Kings.newTab(window, name)
	local content = new("ScrollingFrame", {
		Name = name,
		Active = true,
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, -31),
		Position = UDim2.new(0, 0, 0, 31),
		ScrollBarImageColor3 = Color3.fromRGB(71, 71, 71),
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
	}, window[1])

	new("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8) }, content)
	new("UIListLayout", {
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 7),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, content)

	return {
		content;
		clear = function()
			for _, v in pairs(content:GetChildren()) do
				if v:IsA("Frame") then
					v:Destroy()
				end
			end
		end;
		destroy = function() content:Destroy() end;
	}
end

function Kings.newSidebarOption(window, tabToView, text, icon)
	window = window[1]

	local tab = new("TextButton", {
		Name = "tab",
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		TextSize = 16,
		FontFace = Font.new("rbxasset://fonts/families/Ubuntu.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal),
		TextColor3 = Color3.fromRGB(221, 221, 221),
		Size = UDim2.new(0, 124, 0, 40),
		Text = text,
		ZIndex = 2,
	}, window.windowSidebar.Tabs)

	tab.MouseButton1Click:Connect(function()
		for _, v in pairs(window:GetChildren()) do
			if v:IsA("ScrollingFrame") then
				v.Visible = false
			end
		end
		tabToView[1].Visible = true
	end)

	new("Frame", {
		Name = "underline",
		BorderSizePixel = 0,
		BackgroundColor3 = Color3.fromRGB(151, 151, 151),
		Size = UDim2.new(0, 110, 0, 1),
		Position = UDim2.new(0.038, 0, 1, 0),
		ZIndex = 2,
	}, tab)

	local iconBtn = new("ImageButton", {
		Name = "home",
		ImageTransparency = 0.1,
		Size = UDim2.new(0, 25, 0, 25),
		Position = UDim2.new(0, 6, 0, 6),
		BackgroundTransparency = 1,
		ZIndex = 2,
	}, tab)

	if icon == nil then
		iconBtn.Image = "rbxassetid://3926305904"
		iconBtn.ImageRectOffset = Vector2.new(964, 204)
		iconBtn.ImageRectSize = Vector2.new(36, 36)
	else
		iconBtn.Image = icon[1]
		iconBtn.ImageRectOffset = icon[2]
		if icon[3] ~= nil then
			iconBtn.ImageRectSize = icon[3]
		end
	end

	return {
		tab;
		onclick = function(func)
			tab.MouseButton1Click:Connect(func)
			iconBtn.MouseButton1Click:Connect(func)
		end;
		destroy = function() tab:Destroy() end;
	}
end

