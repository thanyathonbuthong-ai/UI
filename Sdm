-- Window
---------------------------------------------------------------------
function Kings.newWindow(windowName, windowSettings)
	windowName = windowName or "Window"
	windowSettings = windowSettings or {}

	local newWindow = new("Frame", {
		BorderSizePixel = 0,
		BackgroundColor3 = Color3.fromRGB(50, 50, 50),
		Size = windowSettings.windowSize or UDim2.new(0, 300, 0, 400),
		Position = windowSettings.windowPosition or UDim2.new(0.07, 0, 0.15, 0),
		Name = windowName,
	}, ScreenGui)

	corner(newWindow, 7)

	local gradient = new("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.fromRGB(50, 50, 50), Color3.fromRGB(50, 50, 50)),
	}, newWindow)

	if windowSettings.windowColor then
		local c = windowSettings.windowColor
		gradient.Color = ColorSequence.new(Color3.fromRGB(c[1], c[2], c[3]), Color3.fromRGB(0, 0, 0))
	end

	local function setWindowLight(integer)
		newWindow.BackgroundColor3 = Color3.fromRGB(integer, integer, integer)
	end

	if windowSettings.hide == true then
		newWindow.Visible = false
	end

	local function toggleVisibility()
		newWindow.Visible = not newWindow.Visible
	end

	-- pattern / shadows (อยู่ใต้ content)
	if windowSettings.pattern == true then
		local bg = new("ImageLabel", {
			Name = "background",
			ZIndex = 0,
			ScaleType = Enum.ScaleType.Tile,
			TileSize = UDim2.new(0, 250, 0, 250),
			ImageTransparency = 0.6,
			Image = "rbxassetid://2151741365",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 1, 0),
		}, newWindow)
		corner(bg, 7)
	end

	if windowSettings.showShadows == true then
		local holder = new("Frame", {
			Name = "shadowHolder",
			ZIndex = 0,
			BackgroundTransparency = 1,
			Size = UDim2.new(1.0567, 0, 1.0375, 0),
			Position = UDim2.new(-0.0267, 0, -0.016, 0),
		}, newWindow)

		for _, s in ipairs({ { "umbraShadow", 0.86 }, { "penumbraShadow", 0.88 }, { "ambientShadow", 0.88 } }) do
			new("ImageLabel", {
				Name = s[1],
				ZIndex = 0,
				SliceCenter = Rect.new(10, 10, 118, 118),
				ScaleType = Enum.ScaleType.Slice,
				ImageColor3 = Color3.fromRGB(0, 0, 0),
				ImageTransparency = s[2],
				AnchorPoint = Vector2.new(0.5, 0.5),
				Image = "rbxassetid://1316045217",
				Size = UDim2.new(1, 2, 1, 2),
				BackgroundTransparency = 1,
				Position = UDim2.new(0.5, 0, 0.5, 0),
			}, holder)
		end
	end

	-- แถบด้านบน (ใช้ลาก)
	local topbar = new("Frame", {
		Name = "topbar",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 31),
		Active = true,
	}, newWindow)

	if windowSettings.draggable == true then
		local dragging, dragStart, startPos

		topbar.InputBegan:Connect(function(input)
			if isPress(input) then
				dragging = true
				dragStart = input.Position
				startPos = newWindow.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			end
		end)

		local conn = UserInputService.InputChanged:Connect(function(input)
			if dragging and isMove(input) then
				local d = input.Position - dragStart
				TweenService:Create(newWindow, TweenInfo.new(0.08, Enum.EasingStyle.Linear), {
					Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y),
				}):Play()
			end
		end)

		newWindow.Destroying:Connect(function()
			conn:Disconnect()
		end)
	end

	-- title
	local newTitle = new("TextLabel", {
		Name = "windowTitle",
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		FontFace = gotham(),
		TextSize = 17,
		TextColor3 = Color3.fromRGB(221, 221, 221),
		Size = UDim2.new(1, -80, 0, 25),
		Position = UDim2.new(0, 40, 0, 3),
		Text = windowName,
	}, newWindow)

	if windowSettings.hideWindowTitle == true then
		newTitle.Visible = false
	end

	local function setWindowName(name)
		newTitle.Text = name
	end

	-- ปุ่มปิด
	if windowSettings.noCloseButton ~= true then
		local closeBtn = new("ImageButton", {
			Name = "windowButton",
			Image = "rbxassetid://3926305904",
			ImageRectSize = Vector2.new(24, 24),
			ImageRectOffset = Vector2.new(284, 4),
			Size = UDim2.new(0, 25, 0, 25),
			Position = UDim2.new(1, -30, 0, 3),
			BackgroundTransparency = 1,
			ZIndex = 3,
		}, newWindow)

		closeBtn.MouseButton1Click:Connect(function()
			newWindow.ClipsDescendants = true
			newWindow:TweenSize(UDim2.new(0, 0, 0, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, UIAnimationSpeed, true)
			task.wait(UIAnimationSpeed + 0.04)
			newWindow:Destroy()
		end)
	end

	-- content หลัก
	local content = new("ScrollingFrame", {
		Name = "main",
		Active = true,
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, -31),
		Position = UDim2.new(0, 0, 0, 31),
		ScrollBarImageColor3 = Color3.fromRGB(71, 71, 71),
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, newWindow)

	new("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8) }, content)
	new("UIListLayout", {
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 7),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, content)

	local function clear()
		for _, v in pairs(content:GetChildren()) do
			if v:IsA("Frame") then
				v:Destroy()
			end
		end
	end

	-- sidebar
	if windowSettings.sidebar == true then
		local sidebar = new("Frame", {
			Name = "windowSidebar",
			BorderSizePixel = 0,
			BackgroundColor3 = Color3.fromRGB(0, 0, 0),
			Size = UDim2.new(0, 130, 1, -31),
			Position = UDim2.new(0, 0, 0, 31),
			Visible = false,
			ZIndex = 2,
		}, newWindow)
		corner(sidebar, 7)

		local tabs = new("ScrollingFrame", {
			Name = "Tabs",
			Active = true,
			BorderSizePixel = 0,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 1, 0),
			ScrollBarImageColor3 = Color3.fromRGB(0, 0, 0),
			CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ZIndex = 2,
		}, sidebar)

		new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, tabs)
		new("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingTop = UDim.new(0, 4) }, tabs)

		local sideBtn = new("ImageButton", {
			Name = "windowIcon",
			Image = "rbxassetid://3926307971",
			ImageRectSize = Vector2.new(36, 36),
			ImageRectOffset = Vector2.new(404, 44),
			Size = UDim2.new(0, 25, 0, 25),
			Position = UDim2.new(0, 8, 0, 3),
			BackgroundTransparency = 1,
			ZIndex = 3,
		}, newWindow)

		local prevSize = sidebar.Size
		local busy = false

		sideBtn.MouseButton1Click:Connect(function()
			if busy then return end
			busy = true
			local info = TweenInfo.new(UIAnimationSpeed, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)

			if not sidebar.Visible then
				sidebar.Size = UDim2.new(0, 0, 0, 0)
				sidebar.Visible = true
				sidebar:TweenSize(prevSize, Enum.EasingDirection.Out, Enum.EasingStyle.Sine, UIAnimationSpeed, true)
				TweenService:Create(sideBtn, info, { Rotation = -90 }):Play()
			else
				TweenService:Create(sideBtn, info, { Rotation = 0 }):Play()
				sidebar:TweenSize(UDim2.new(0, 0, 0, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Sine, UIAnimationSpeed, true)
				task.wait(UIAnimationSpeed + 0.04)
				sidebar.Visible = false
			end
			busy = false
		end)

		local mainName = windowSettings.sidebarMainName or "main"

		local mainTab = new("TextButton", {
			Name = "tab",
			BorderSizePixel = 0,
			BackgroundTransparency = 1,
			TextSize = 16,
			FontFace = Font.new("rbxasset://fonts/families/Ubuntu.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal),
			TextColor3 = Color3.fromRGB(221, 221, 221),
			Size = UDim2.new(0, 124, 0, 40),
			Text = mainName,
			ZIndex = 2,
		}, tabs)

		new("Frame", {
			Name = "underline",
			BorderSizePixel = 0,
			BackgroundColor3 = Color3.fromRGB(151, 151, 151),
			Size = UDim2.new(0, 110, 0, 1),
			Position = UDim2.new(0.038, 0, 1, 0),
			ZIndex = 2,
		}, mainTab)

		new("ImageButton", {
			Name = "home",
			ImageTransparency = 0.1,
			Image = "rbxassetid://3926305904",
			ImageRectSize = Vector2.new(36, 36),
			ImageRectOffset = Vector2.new(964, 204),
			Size = UDim2.new(0, 25, 0, 25),
			Position = UDim2.new(0, 6, 0, 6),
			BackgroundTransparency = 1,
			ZIndex = 2,
		}, mainTab)

		mainTab.MouseButton1Click:Connect(function()
			for _, v in pairs(newWindow:GetChildren()) do
				if v:IsA("ScrollingFrame") then
					v.Visible = false
				end
			end
			content.Visible = true
		end)
	end

	return {
		newWindow;
		toggleVisibility = toggleVisibility;
		clear = clear;
		setWindowLight = setWindowLight;
		setWindowName = setWindowName;
		destroy = function() newWindow:Destroy() end;
	}
end

