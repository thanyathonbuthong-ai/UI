		end)
	end)

	local t = commonFunctions(frame, uiStroke, titleLbl)
	t.setCode = function(c) codeLbl.Text = c end
	t.getCode = function() return codeLbl.Text end
	return t
end

-- Notification (toast)
local notifyHolder
local notifyCount = 0

local function toastVisible(toast, visible, instant)
	local info = TweenInfo.new(instant and 0 or 0.2)
	TweenService:Create(toast, info, { BackgroundTransparency = visible and 0.05 or 1 }):Play()
	for _, d in ipairs(toast:GetDescendants()) do
		if d:IsA("TextLabel") then
			TweenService:Create(d, info, { TextTransparency = visible and 0 or 1 }):Play()
		elseif d:IsA("UIStroke") then
			TweenService:Create(d, info, { Transparency = visible and 0 or 1 }):Play()
		end
	end
end

-- Kings.notify({Title = "Hi", Content = "text", Duration = 4})
function Kings.notify(opts)
	if type(opts) == "string" then
		opts = { Title = opts }
	end
	opts = opts or {}

	if not (notifyHolder and notifyHolder.Parent) then
		notifyHolder = new("Frame", {
			Name = "Notifications",
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -12, 1, -12),
			Size = UDim2.new(0, 260, 1, -24),
			ZIndex = 200,
		}, ScreenGui)
		new("UIListLayout", {
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
		}, notifyHolder)
	end

	notifyCount = notifyCount + 1
	local toast = new("Frame", {
		BorderSizePixel = 0,
		BackgroundColor3 = Color3.fromRGB(30, 30, 30),
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = notifyCount,
	}, notifyHolder)
	corner(toast, 8)
	stroke(toast, Color3.fromRGB(70, 70, 70), 1)
	new("UIPadding", {
		PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10),
		PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
	}, toast)
	new("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, toast)

	if opts.Title then
		new("TextLabel", {
			LayoutOrder = 1,
			BackgroundTransparency = 1,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			FontFace = gotham(),
			TextSize = 15,
			TextColor3 = WHITE,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(1, 0, 0, 0),
			Text = opts.Title,
		}, toast)
	end
	if opts.Content then
		new("TextLabel", {
			LayoutOrder = 2,
			BackgroundTransparency = 1,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			FontFace = gotham(Enum.FontWeight.Regular),
			TextSize = 13,
			TextColor3 = Color3.fromRGB(180, 180, 180),
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(1, 0, 0, 0),
			Text = opts.Content,
		}, toast)
	end

	toastVisible(toast, false, true)
	task.defer(toastVisible, toast, true)

	local closed = false
	local function close()
		if closed then return end
		closed = true
		toastVisible(toast, false)
		task.delay(0.25, function()
			toast:Destroy()
		end)
	end
	task.delay(opts.Duration or 4, close)

	return { close = close }
end

-- Dialog / Popup
-- Kings.newDialog({Title="Hi", Content="...", Buttons={{Title="OK", Callback=function() end}}})
function Kings.newDialog(opts)
	opts = opts or {}
	local buttons = opts.Buttons or { { Title = "OK" } }

	local overlay = new("TextButton", {
		Name = "KingsDialog",
		Text = "",
		AutoButtonColor = false,
		BorderSizePixel = 0,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.5,
		Size = UDim2.new(1, 0, 1, 0),
		ZIndex = 100,
	}, ScreenGui)

	local box = new("Frame", {
		BorderSizePixel = 0,
		BackgroundColor3 = Color3.fromRGB(40, 40, 40),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0, 300, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	}, overlay)
	corner(box, 8)
	stroke(box, Color3.fromRGB(70, 70, 70), 1)
	new("UIPadding", {
		PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 14),
		PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14),
	}, box)
	new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, box)

	if opts.Title then
		new("TextLabel", {
			LayoutOrder = 1,
			BackgroundTransparency = 1,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			FontFace = gotham(),
			TextSize = 17,
			TextColor3 = WHITE,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(1, 0, 0, 0),
			Text = opts.Title,
		}, box)
	end
	if opts.Content then
		new("TextLabel", {
			LayoutOrder = 2,
			BackgroundTransparency = 1,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			FontFace = gotham(Enum.FontWeight.Regular),
			TextSize = 14,
			TextColor3 = Color3.fromRGB(190, 190, 190),
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(1, 0, 0, 0),
			Text = opts.Content,
		}, box)
	end

	local row = new("Frame", { LayoutOrder = 3, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34) }, box)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, row)

	local function close()
		overlay:Destroy()
	end

	local n = #buttons
	for i, b in ipairs(buttons) do
		local primary = b.Primary
		if primary == nil then
			primary = i == n
		end
		local btn = new("TextButton", {
			LayoutOrder = i,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			BackgroundColor3 = primary and ACCENT or WHITE,
			BackgroundTransparency = primary and 0.2 or 0.85,
			FontFace = gotham(),
			TextSize = 14,
			TextColor3 = WHITE,
			Text = b.Title or "OK",
			Size = UDim2.new(1 / n, -6 * (n - 1) / n, 1, 0),
		}, row)
		corner(btn, 6)
		btn.MouseButton1Click:Connect(function()
			if b.Callback then
				task.spawn(b.Callback)
			end
			close()
		end)
	end

	return { close = close }
end

return Kings
