	t.setInput = function(v) box.Text = v end
	t.getInput = function() return box.Text end
	-- func(text, enterPressed) ถูกเรียกตอนเลิกพิมพ์
	t.onchange = function(func)
		box.FocusLost:Connect(function(enter)
			func(box.Text, enter)
		end)
	end

	return t
end

-- Slider
function Kings.newSliderElement(window, tab, text, defaultValue)
	local ORANGE = Color3.fromRGB(255, 161, 98)
	local minV, maxV = 0, 100
	local val = tonumber(defaultValue) or 0
	local callbacks = {}

	local frame = new("TextButton", {
		Name = "windowElementSlider",
		BorderSizePixel = 0,
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0.9,
		Size = UDim2.new(1, -26, 0, 60),
		Text = "",
		AutoButtonColor = false,
	}, getTab(window, tab))
	corner(frame, 7)
	local uiStroke = stroke(frame)

	local label = new("TextLabel", {
		TextWrapped = true,
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		FontFace = gotham(),
		TextSize = 15,
		TextColor3 = Color3.fromRGB(221, 221, 221),
		Size = UDim2.new(1, 0, 0, 40),
		Text = text or "",
	}, frame)

	new("ImageButton", {
		Name = "icon",
		ImageColor3 = ORANGE,
		Image = "rbxassetid://3926305904",
		ImageRectSize = Vector2.new(36, 36),
		ImageRectOffset = Vector2.new(4, 124),
		Size = UDim2.new(0, 25, 0, 25),
		Position = UDim2.new(1, -35, 0, 6),
		BackgroundTransparency = 1,
	}, frame)

	local outline = new("Frame", {
		Name = "sliderOutline",
		BorderSizePixel = 0,
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0.9,
		Size = UDim2.new(1, -36, 0, 8),
		Position = UDim2.new(0, 18, 0, 42),
	}, frame)
	corner(outline, 7)
	stroke(outline, ORANGE)

	local fill = new("Frame", {
		Name = "slider",
		BorderSizePixel = 0,
		BackgroundColor3 = ORANGE,
		BackgroundTransparency = 0.1,
		Size = UDim2.new(0, 0, 1, 0),
	}, outline)
	corner(fill, 7)

	local title = text or ""

	local function render()
		local range = maxV - minV
		local pct = range == 0 and 0 or (val - minV) / range
		fill.Size = UDim2.new(math.clamp(pct, 0, 1), 0, 1, 0)
		label.Text = title .. " [" .. tostring(val) .. "]"
	end

	local function apply(v, fire)
		v = math.clamp(math.floor(v + 0.5), minV, maxV)
		local changed = v ~= val
		val = v
		render()
		if fire and changed then
			for _, f in ipairs(callbacks) do
				task.spawn(f, val)
			end
		end
	end

	local function updateFromX(x)
		local w = outline.AbsoluteSize.X
		if w <= 0 then return end
		local rel = math.clamp((x - outline.AbsolutePosition.X) / w, 0, 1)
		apply(minV + (maxV - minV) * rel, true)
	end

	local dragging = false

	frame.InputBegan:Connect(function(input)
		if isPress(input) then
			dragging = true
			updateFromX(input.Position.X)
		end
	end)

	local c1 = UserInputService.InputChanged:Connect(function(input)
		if dragging and isMove(input) then
			updateFromX(input.Position.X)
		end
	end)

	local c2 = UserInputService.InputEnded:Connect(function(input)
		if isPress(input) then
			dragging = false
		end
	end)

	frame.Destroying:Connect(function()
		c1:Disconnect()
		c2:Disconnect()
	end)

	render()

	local t = commonFunctions(frame, uiStroke, nil)
	t.getValue = function() return val end -- คืนค่าเป็น number
	t.setValue = function(v) apply(v, false) end
	t.minValue = function(v) minV = v; apply(val, false) end
	t.maxValue = function(v) maxV = v; apply(val, false) end
	t.onchange = function(func) table.insert(callbacks, func) end

	return t
end

