		ZIndex = 2,
	}, frame)

	local btn = new("TextButton", {
		TextWrapped = true,
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		FontFace = gotham(),
		TextSize = 15,
		TextColor3 = Color3.fromRGB(221, 221, 221),
		Size = UDim2.new(1, 0, 1, 0),
