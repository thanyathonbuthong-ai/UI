    titleText.Position = UDim2.new(0, 14, 0, 7)
    titleText.BackgroundTransparency = 1
    titleText.TextColor3 = Color3.fromRGB(235, 200, 200)
    titleText.TextSize = 18
    titleText.Font = Enum.Font.GothamBold
    titleText.Text = self.title
    titleText.TextXAlignment = Enum.TextXAlignment.Left
    titleText.Parent = titleBar
    
    -- Version Text (V2.0)
    local versionText = Instance.new("TextLabel")
    versionText.Name = "VersionText"
    versionText.Size = UDim2.new(0, 80, 0, 14)
    versionText.Position = UDim2.new(0, 14, 0, 26)
    versionText.BackgroundTransparency = 1
    versionText.TextColor3 = COLORS.BrightRed
    versionText.TextSize = 10
    versionText.Font = Enum.Font.Gotham
    versionText.Text = self.version
    versionText.TextXAlignment = Enum.TextXAlignment.Left
    versionText.Parent = titleBar
    
    -- Ping Text
    local pingText = Instance.new("TextLabel")
    pingText.Name = "PingText"
    pingText.Size = UDim2.new(0, 90, 0, 16)
    pingText.Position = UDim2.new(0, 210, 0, 16)
    pingText.BackgroundTransparency = 1
    pingText.TextColor3 = COLORS.BrightRed
    pingText.TextSize = 12
    pingText.Font = Enum.Font.Gotham
    pingText.Text = "Ping: 90ms"
    pingText.TextXAlignment = Enum.TextXAlignment.Left
    pingText.Parent = titleBar
    
    -- FPS Text
    local fpsText = Instance.new("TextLabel")
    fpsText.Name = "FpsText"
    fpsText.Size = UDim2.new(0, 70, 0, 16)
    fpsText.Position = UDim2.new(0, 310, 0, 16)
    fpsText.BackgroundTransparency = 1
    fpsText.TextColor3 = COLORS.BrightRed
    fpsText.TextSize = 12
    fpsText.Font = Enum.Font.Gotham
    fpsText.Text = "FPS: 41"
    fpsText.TextXAlignment = Enum.TextXAlignment.Left
    fpsText.Parent = titleBar
    
    -- Minimize Button ("-")
    local minimizeButton = Instance.new("TextButton")
    minimizeButton.Name = "MinimizeButton"
    minimizeButton.Size = UDim2.new(0, 26, 0, 22)
    minimizeButton.Position = UDim2.new(1, -58, 0, 13)
    minimizeButton.BackgroundTransparency = 1
    minimizeButton.TextColor3 = COLORS.White
    minimizeButton.TextSize = 16
    minimizeButton.Font = Enum.Font.GothamBold
    minimizeButton.Text = "-"
    minimizeButton.Parent = titleBar
    
    minimizeButton.MouseButton1Click:Connect(function()
        self:ToggleMinimize()
    end)
    
    -- Update FPS every second
    local lastUpdate = tick()
    local frameCount = 0
    RunService.RenderStepped:Connect(function()
        frameCount = frameCount + 1
        local currentTime = tick()
        if currentTime - lastUpdate >= 1 then
            fpsText.Text = "FPS: " .. frameCount
            frameCount = 0
            lastUpdate = currentTime
        end
    end)
    
    self.TitleBar = titleBar
end

-- Toggle minimize (ย่อ/ขยาย content ส่วนล่าง title bar)
function NossxUI:ToggleMinimize()
    self.Sidebar.Visible = not self.Sidebar.Visible
    self.SettingsPanel.Visible = not self.SettingsPanel.Visible
end

-- สร้าง Left Sidebar
function NossxUI:CreateLeftSidebar()
    local sidebar = Instance.new("Frame")
    sidebar.Name = "Sidebar"
    sidebar.Size = UDim2.new(0, 128, 1, -48)
    sidebar.Position = UDim2.new(0, 0, 0, 48)
    sidebar.BackgroundColor3 = COLORS.DarkRed
    sidebar.BorderSizePixel = 0
    sidebar.Parent = self.MainFrame
    
    -- เส้นแบ่งด้านขวาของ sidebar
    local rightLine = Instance.new("Frame")
    rightLine.Size = UDim2.new(0, 1, 1, 0)
    rightLine.Position = UDim2.new(1, -1, 0, 0)
    rightLine.BackgroundColor3 = COLORS.LineRed
    rightLine.BorderSizePixel = 0
    rightLine.Parent = sidebar
    
    -- Menu Items (icon แบบ text ให้ใกล้เคียงรูปมากที่สุด: วงกลม, คลื่นสัญญาณ, กากบาทในกรอบ, กากบาทในกรอบ)
    local menuItems = {
        {icon = "◉", name = "Info"},
        {icon = "∿", name = "Main"},
        {icon = "✕", name = "Teleport"},
        {icon = "✕", name = "Bonus"},
    }
    
    for i, item in ipairs(menuItems) do
        self:CreateMenuButton(sidebar, item.name, item.icon, (i-1) * 42, i)
    end
    
    -- ตั้งค่าเริ่มต้นให้ "Main" เป็นเมนูที่ถูกเลือก (ตามรูป)
    self.currentSelectedMenu = "Main"
    
    -- User Profile
    self:CreateUserProfile(sidebar)
    
    self.Sidebar = sidebar
end

-- สร้าง Menu Button
function NossxUI:CreateMenuButton(parent, name, icon, offsetY, index)
    local isActive = (name == "Main")
    
    local button = Instance.new("TextButton")
    button.Name = name .. "Button"
    button.Size = UDim2.new(1, 0, 0, 38)
    button.Position = UDim2.new(0, 0, 0, offsetY + 6)
    button.BackgroundColor3 = isActive and COLORS.ActiveRed or COLORS.DarkRed
    button.BackgroundTransparency = isActive and 0 or 1
    button.TextColor3 = isActive and COLORS.White or COLORS.BrightRed
    button.TextSize = 12
    button.Font = isActive and Enum.Font.GothamBold or Enum.Font.Gotham
    button.Text = "   " .. icon .. "   " .. name
    button.TextXAlignment = Enum.TextXAlignment.Left
    button.BorderSizePixel = 0
    button.AutoButtonColor = false
    button.Parent = parent
    
    -- เส้นบาง ๆ ใต้แต่ละแถวเมนู
    local underline = Instance.new("Frame")
    underline.Size = UDim2.new(1, -16, 0, 1)
    underline.Position = UDim2.new(0, 8, 1, -1)
    underline.BackgroundColor3 = COLORS.LineRed
    underline.BorderSizePixel = 0
    underline.Parent = button
    
    button.MouseButton1Click:Connect(function()
        -- reset ปุ่มเก่า
        for _, btnData in ipairs(self.menuButtons) do
            btnData.button.BackgroundTransparency = 1
            btnData.button.TextColor3 = COLORS.BrightRed
            btnData.button.Font = Enum.Font.Gotham
        end
        
        -- highlight ปุ่มที่เลือก
        button.BackgroundColor3 = COLORS.ActiveRed
        button.BackgroundTransparency = 0
        button.TextColor3 = COLORS.White
        button.Font = Enum.Font.GothamBold
        
        self.currentSelectedMenu = name
        if self.onMenuSelected then
            self.onMenuSelected(name)
        end
    end)
    
    table.insert(self.menuButtons, {button = button, name = name})
end

