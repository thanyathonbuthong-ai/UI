-- สร้าง Settings Panel
function NossxUI:CreateSettingsPanel()
    local settingsPanel = Instance.new("ScrollingFrame")
    settingsPanel.Name = "SettingsPanel"
    settingsPanel.Size = UDim2.new(1, -128, 1, -48)
    settingsPanel.Position = UDim2.new(0, 128, 0, 48)
    settingsPanel.BackgroundColor3 = COLORS.DarkRed
    settingsPanel.BorderSizePixel = 0
    settingsPanel.ScrollBarThickness = 6
    settingsPanel.ScrollBarImageColor3 = COLORS.BrightRed
    settingsPanel.CanvasSize = UDim2.new(1, 0, 0, 0)
    settingsPanel.TopImage = ""
    settingsPanel.BottomImage = ""
    settingsPanel.MidImage = ""
    settingsPanel.Parent = self.MainFrame
    
    -- List Layout
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 3)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = settingsPanel
    
    -- Update canvas size
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        settingsPanel.CanvasSize = UDim2.new(1, 0, 0, layout.AbsoluteContentSize.Y + 5)
    end)
    
    self.SettingsPanel = settingsPanel
    self.SettingsLayout = layout
end

-- Add Toggle Option
function NossxUI:AddToggle(name, defaultState, callback)
    local toggleOption = Instance.new("Frame")
    toggleOption.Name = name .. "Toggle"
    toggleOption.Size = UDim2.new(1, -20, 0, 54)
    toggleOption.BackgroundTransparency = 1
    toggleOption.LayoutOrder = #self.toggleOptions + 1
    toggleOption.Parent = self.SettingsPanel
    
    -- เส้นแบ่งด้านล่างของแต่ละแถว (จางๆ)
    local rowDivider = Instance.new("Frame")
    rowDivider.Size = UDim2.new(1, 0, 0, 1)
    rowDivider.Position = UDim2.new(0, 0, 1, -1)
    rowDivider.BackgroundColor3 = COLORS.LineRed
    rowDivider.BackgroundTransparency = 0.3
    rowDivider.BorderSizePixel = 0
    rowDivider.Parent = toggleOption
    
    -- Label
    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.Size = UDim2.new(0.65, -5, 1, -1)
    label.Position = UDim2.new(0, 4, 0, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = COLORS.White
    label.TextSize = 13
    label.Font = Enum.Font.GothamBold
    label.Text = name
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.Parent = toggleOption
    
    -- Toggle Button Background
    local toggleButton = Instance.new("Frame")
    toggleButton.Name = "ToggleButton"
    toggleButton.Size = UDim2.new(0, 40, 0, 20)
    toggleButton.Position = UDim2.new(1, -46, 0.5, -11)
    toggleButton.BackgroundColor3 = defaultState and COLORS.Green or COLORS.DarkGray
    toggleButton.BorderSizePixel = 0
    toggleButton.Parent = toggleOption
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = toggleButton
    
    -- Circle indicator
    local circle = Instance.new("Frame")
    circle.Name = "Circle"
    circle.Size = UDim2.new(0, 16, 0, 16)
    circle.Position = defaultState and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
    circle.BackgroundColor3 = COLORS.White
    circle.BorderSizePixel = 0
    circle.Parent = toggleButton
    
    local circleCorner = Instance.new("UICorner")
    circleCorner.CornerRadius = UDim.new(1, 0)
    circleCorner.Parent = circle
    
    -- ใช้ table เก็บ state เพื่อให้ GetToggleState อ่านค่าล่าสุดได้เสมอ
    local toggleData = {name = name, button = toggleButton, state = defaultState}
    
    -- Make toggle button clickable
    local clickButton = Instance.new("TextButton")
    clickButton.Name = "ClickButton"
    clickButton.Size = UDim2.new(1, 0, 1, 0)
    clickButton.BackgroundTransparency = 1
    clickButton.TextTransparency = 1
    clickButton.BorderSizePixel = 0
    clickButton.Parent = toggleButton
    
    clickButton.MouseButton1Click:Connect(function()
        toggleData.state = not toggleData.state
        
        -- Animate
        toggleButton.BackgroundColor3 = toggleData.state and COLORS.Green or COLORS.DarkGray
        
        local tweenInfo = TweenInfo.new(0.15)
        local tween = game:GetService("TweenService"):Create(
            circle,
            tweenInfo,
            {Position = toggleData.state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)}
        )
        tween:Play()
        
        if callback then
            callback(toggleData.state)
        end
    end)
    
    table.insert(self.toggleOptions, toggleData)
    
    return toggleButton
end

-- Make GUI draggable
function NossxUI:MakeDraggable()
    local dragging = false
    local dragInput = nil
    local dragStart = nil
    local startPos = nil
    
    self.TitleBar.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = self.MainFrame.Position
            dragInput = input
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input, gameProcessed)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            self.MainFrame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input, gameProcessed)
        if input == dragInput then
            dragging = false
        end
    end)
end

-- Create Close Button
function NossxUI:CreateCloseButton()
    local closeButton = Instance.new("TextButton")
    closeButton.Name = "CloseButton"
    closeButton.Size = UDim2.new(0, 24, 0, 22)
    closeButton.Position = UDim2.new(1, -28, 0, 13)
    closeButton.BackgroundTransparency = 1
    closeButton.TextColor3 = COLORS.White
    closeButton.TextSize = 15
    closeButton.Font = Enum.Font.GothamBold
    closeButton.Text = "x"
    closeButton.BorderSizePixel = 0
    closeButton.Parent = self.MainFrame
    
    closeButton.MouseButton1Click:Connect(function()
        self:Close()
    end)
    
    closeButton.MouseEnter:Connect(function()
        closeButton.TextColor3 = COLORS.BrightRed
    end)
    
    closeButton.MouseLeave:Connect(function()
        closeButton.TextColor3 = COLORS.White
    end)
end

-- Close the UI
function NossxUI:Close()
    self.ScreenGui:Destroy()
end

-- Toggle visibility
function NossxUI:ToggleVisibility()
    self.MainFrame.Visible = not self.MainFrame.Visible
end

-- Get toggle state
function NossxUI:GetToggleState(name)
    for _, toggle in ipairs(self.toggleOptions) do
        if toggle.name == name then
            return toggle.state
        end
    end
    return nil
end

-- Set menu selected callback
function NossxUI:OnMenuSelected(callback)
    self.onMenuSelected = callback
end

return NossxUI
