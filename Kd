--[[
    NOSSX HUB UI Library
    สำหรับสร้าง UI Hub ใน Roblox ตามรูปแบบของ NOSSX HUB
    ใช้ได้กับ LocalScript หรือ Script ที่อยู่ใน StarterPlayer > StarterCharacterScripts
]]

local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local NossxUI = {}
NossxUI.__index = NossxUI

-- สีที่ใช้ในการสร้าง UI (จับคู่จากรูปต้นฉบับ)
local COLORS = {
    DarkRed = Color3.fromRGB(30, 8, 10),        -- พื้นหลังหลัก
    PanelRed = Color3.fromRGB(45, 14, 16),      -- พื้นหลัง panel เข้มกว่านิด
    HeaderRed = Color3.fromRGB(20, 5, 7),       -- title bar เข้มสุด
    ActiveRed = Color3.fromRGB(80, 20, 22),     -- แถบเมนูที่ถูกเลือก (Main)
    BrightRed = Color3.fromRGB(200, 45, 45),    -- ตัวอักษร/เส้นแดงสว่าง
    LineRed = Color3.fromRGB(90, 25, 28),       -- เส้นแบ่งจางๆ
    White = Color3.fromRGB(240, 240, 240),
    Gray = Color3.fromRGB(140, 130, 130),
    DarkGray = Color3.fromRGB(90, 85, 85),
    Green = Color3.fromRGB(60, 210, 110),
    Black = Color3.fromRGB(0, 0, 0),
    Gold = Color3.fromRGB(230, 200, 150),
}

-- ฟังก์ชันสร้าง Hub UI
function NossxUI.new(title, version)
    local self = setmetatable({}, NossxUI)
    
    self.title = title or "NOSSX HUB"
    self.version = version or "V2.0"
    self.isOpen = true
    self.isDragging = false
    self.dragStart = Vector2.new(0, 0)
    self.toggleOptions = {}
    self.menuButtons = {}
    self.currentSelectedMenu = nil
    
    self:CreateMainUI()
    
    return self
end

-- สร้าง Main UI Container
function NossxUI:CreateMainUI()
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")
    
    -- Main Screen GUI
    self.ScreenGui = Instance.new("ScreenGui")
    self.ScreenGui.Name = "NossxHubUI"
    self.ScreenGui.ResetOnSpawn = false
    self.ScreenGui.Parent = playerGui
    
    -- Main Frame
    self.MainFrame = Instance.new("Frame")
    self.MainFrame.Name = "MainFrame"
    self.MainFrame.Size = UDim2.new(0, 550, 0, 420)
    self.MainFrame.Position = UDim2.new(0.5, -275, 0.5, -210)
    self.MainFrame.BackgroundColor3 = COLORS.DarkRed
    self.MainFrame.BorderSizePixel = 0
    self.MainFrame.ClipsDescendants = true
    self.MainFrame.Parent = self.ScreenGui
    
    -- Corner Radius
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = self.MainFrame
    
    -- Title Bar
    self:CreateTitleBar()
    
    -- Left Sidebar
    self:CreateLeftSidebar()
    
    -- Right Settings Panel
    self:CreateSettingsPanel()
    
    -- Close button
    self:CreateCloseButton()
    
    -- Make draggable
    self:MakeDraggable()
end

-- สร้าง Title Bar
