--[[==========================================================================
  PUBLIC API  (LumenUI) ??? a friendly wrapper over L.Window / L.C.
============================================================================]]
local LumenUI = {}
LumenUI.L = L
LumenUI.Version = L.VERSION

function LumenUI.Window(opts)
  opts = opts or {}
  if opts.Scale ~= nil and L.Cfg then L.Cfg.data.scale = tonumber(opts.Scale) end
  local savedName = (L.Cfg and L.Cfg.data and L.Cfg.data.hubName) or nil
  local w = L.Window.new({
    width   = opts.Width,
    height  = opts.Height,
    title   = savedName or opts.Title or opts.Name or getgenv().LUMEN_HUB_NAME,
    guiName = opts.Name and ("Lumen_" .. opts.Name) or nil,
  })
  if opts.Title then w:subtitle(tostring(opts.Title)) end
  L.Hub.window = w
  if opts.Open ~= false then w:show() end

  local api = {}
  api.Window = w

  function api:Tab(tabOpts)
    if type(tabOpts) == "string" then tabOpts = { name = tabOpts } end
    tabOpts = tabOpts or {}
    local tab = w:tab({
      name = tabOpts.Name or tabOpts.Title or tabOpts.name or "Tab",
      desc = tabOpts.Desc or tabOpts.desc,
      icon = tabOpts.Icon or tabOpts.icon,
    })
    local body = tab.body

    -- WindUI-style field names are accepted next to the native ones, so a script
    -- written for WindUI (Title / Desc / Value / Values / Multi ...) works as-is.
    local ALIAS = {
      Title = "text", Name = "text", Text = "text",
      Desc = "desc", Description = "desc",
      Default = "default", Value = "default",
      Callback = "callback",
      Min = "min", Max = "max", Step = "step", Suffix = "suffix",
      Options = "items", Values = "items", Items = "items",
      Multi = "multi", Placeholder = "placeholder",
      Transparency = "transparency", Code = "code",
      Id = "id", Flag = "id", Primary = "primary",
      Height = "height", Size = "size", When = "when",
      AllowNone = "allowNone", Locked = "locked", LockedTitle = "lockedTitle",
      Box = "box", BoxBorder = "boxBorder", Opened = "opened",
      Collapsible = "collapsible", Image = "image", ImageSize = "imageSize",
      Buttons = "buttons", Color = "color", Justify = "justify", Icon = "icon",
      Scale = "scale",
    }
    local function norm(o)
      if type(o) == "string" then o = { text = o } end
      o = o or {}
      for k, lk in pairs(ALIAS) do
        if o[k] ~= nil and o[lk] == nil then o[lk] = o[k] end
      end
      if type(o.Value) == "table" and o.Value.Min ~= nil then   -- WindUI slider: Value = {Min, Max, Default}
        local v = o.Value
        o.min, o.max, o.default = v.Min, v.Max, v.Default
      end
      if o.SearchBarEnabled ~= nil and o.search == nil then o.search = o.SearchBarEnabled end
      if o.Columns and o.size == nil then o.size = tonumber(o.Columns) * 4 end
      return o
    end

    -- buttons given the WindUI way: { Title, Callback, Variant = "Primary" }
    local function normButtons(list)
      local out = {}
      for i, b in ipairs(list or {}) do
        b = norm(b)
        out[i] = {
          text = b.text, callback = b.callback,
          primary = b.primary or tostring(b.Variant or ""):lower() == "primary",
        }
      end
      return out
    end

    -- ---- what every element gets: Lock / SetTitle / Highlight / OnChanged ...
    local function labelsOf(frame)
      local out = {}
      for _, c in ipairs(frame:GetChildren()) do
        if c:IsA("TextLabel") then out[#out + 1] = c end
      end
      return out
    end

    local function highlight(el)
      local f = el.frame
      if not (f and f.Parent) then return end
      local h = L.mk("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = L.T.c.accent,
        BackgroundTransparency = 0.55, BorderSizePixel = 0,
        ZIndex = (f.ZIndex or 1) + 15, Parent = f,
      })
      local rc = f:FindFirstChildOfClass("UICorner")
      L.mk("UICorner", { CornerRadius = rc and rc.CornerRadius or UDim.new(0, 12), Parent = h })
      L.Motion.to(h, "BackgroundTransparency", 1, "slow")
      task.delay(0.9, function() pcall(function() h:Destroy() end) end)
    end

    local function decorate(el, o, listeners)
      if type(el) ~= "table" or not el.frame then return el end
      local function sub(name, fn) if el[name] == nil then el[name] = fn end end

      sub("Lock", function(self, why)
        if el.setEnabled then el.setEnabled(false, why or o.lockedTitle) end
      end)
      sub("Unlock", function(self) if el.setEnabled then el.setEnabled(true) end end)
      sub("Destroy", function(self)
        pcall(function() el.frame:Destroy() end)
      end)
      sub("SetVisible", function(self, v) el.frame.Visible = v and true or false end)
      sub("Show", function(self) el.frame.Visible = true end)
      sub("Hide", function(self) el.frame.Visible = false end)
      sub("Highlight", function(self) highlight(el) end)
      sub("SetTitle", function(self, s)
        local l = labelsOf(el.frame)[1]
        if l then l.Text = tostring(s) end
      end)
      sub("SetDesc", function(self, s)
        -- only rows that were built with a description have a second label
        local l = labelsOf(el.frame)[2]
        if l and o.desc and o.desc ~= "" then l.Text = tostring(s) return true end
        return false
      end)

      if el.set then
        sub("Set", function(self, ...) return el.set(el, ...) end)
        sub("Select", function(self, ...) return el.set(el, ...) end)
      end
      if el.get then sub("Get", function(self) return el.get(el) end) end
      if el.refresh then
        sub("Refresh", function(self, list) return el.refresh(el, list) end)
        sub("SetValues", function(self, list) return el.refresh(el, list) end)
      end
      if el.open then sub("Open", function(self) return el.open() end) end
      if el.close then sub("Close", function(self) return el.close() end) end

      sub("OnChanged", function(self, fn)
        if listeners and type(fn) == "function" then listeners[#listeners + 1] = fn end
        return el
      end)
      sub("SetCallback", function(self, fn) o.callback = fn end)

      if o.locked then el:Lock(o.lockedTitle) end
      return el
    end

    -- Button Justify / Icon: the labels are direct children, so realign them
    local function styleButton(el, o)
      local f = el.frame
      if not f then return end
      local j = tostring(o.justify or "Center"):lower()
      local hasIcon = type(o.icon) == "string"
        and (o.icon:match("^rbxasset") or o.icon:match("^%d+$")) ~= nil
      if hasIcon then
        local id = o.icon:match("^%d+$") and ("rbxassetid://" .. o.icon) or o.icon
        L.mk("ImageLabel", {
          AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 12, 0.5, 0),
          Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1,
          Image = id, ImageColor3 = o.primary and L.T.c.accentInk or L.T.c.text,
          ZIndex = 3, Parent = f,
        })
      end
      if j == "left" or j == "right" then
        local x = (j == "left") and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right
        local pad = hasIcon and 36 or 14
        for _, l in ipairs(labelsOf(f)) do
          l.TextXAlignment = x
          l.Position = UDim2.new(0, pad, l.Position.Y.Scale, l.Position.Y.Offset)
          l.Size = UDim2.new(1, -(pad + 14), l.Size.Y.Scale, l.Size.Y.Offset)
        end
      elseif hasIcon then
        for _, l in ipairs(labelsOf(f)) do
          l.Position = UDim2.new(0, 20, l.Position.Y.Scale, l.Position.Y.Offset)
          l.Size = UDim2.new(1, -20, l.Size.Y.Scale, l.Size.Y.Offset)
        end
      end
    end

    -- Dropdown Values can be plain strings, WindUI tables ({Title, Callback,
    -- Icon...}) or a mix. Returns plain names plus, for a menu-style dropdown
    -- (every entry carries its own Callback), a dispatcher.
    local function normDropdown(o)
      local names, cbs, menu = {}, {}, true
      local list = o.items or {}
      for i, v in ipairs(list) do
        if type(v) == "table" then
          local name = tostring(v.Title or v.Name or v.Text or v.Value or i)
          names[i] = name
          if v.Callback or v.callback then cbs[name] = v.Callback or v.callback else menu = false end
        else
          names[i] = v
          menu = false
        end
      end
      if #list == 0 then menu = false end
      o.items = names
      if type(o.default) == "table" and not o.multi then o.default = o.default[1] end
      if type(o.default) == "table" then          -- multi default given as table entries
        for i, v in ipairs(o.default) do
          if type(v) == "table" then o.default[i] = tostring(v.Title or v.Name or v.Text or v.Value) end
        end
      end
      if o.allowNone then o.persist = false end   -- a cleared value cannot be persisted
      return menu, cbs
    end

    local controls = {
      "button","toggle","checkbox","segmented","slider","dropdown","keybind","input",
      "textarea","colorpicker","code","progress","tag","divider","space","output",
      "textDots","logView","image","tiles","actions",
    }

    local function makeElements(host, afterAdd)
      local t = {}
      local direct = {
        tiles = function(o) return L.C.tiles(host, o.items or {}, o) end,
        actions = function(o)
          return L.C.actions(host, normButtons(o.items or o.Buttons or o.buttons))
        end,
      }

      for _, name in ipairs(controls) do
        local method = name:sub(1,1):upper() .. name:sub(2)
        t[method] = function(self, o)
          o = norm(o)
          local el
          if direct[name] then
            el = direct[name](o)
          else
            local fn = name
            local ty = tostring(o.Type or o.type or ""):lower()
            if name == "toggle" and ty == "checkbox" then fn = "checkbox" end   -- WindUI Toggle{Type="Checkbox"}
            if name == "input" and ty == "textarea" then fn = "textarea" end    -- WindUI Input{Type="Textarea"}

            local listeners, menuCbs, apiRef = {}, nil, nil
            if fn == "dropdown" then
              local isMenu, cbs = normDropdown(o)
              if isMenu then
                menuCbs = cbs
                o.persist, o.default = false, nil
              end
            end
            local orig = o.callback
            if fn ~= "code" and fn ~= "divider" and fn ~= "space" then
              o.callback = function(...)
                local r, why
                if menuCbs then
                  local pick = ...
                  if menuCbs[pick] then r, why = menuCbs[pick]() end
                  -- a menu does not keep a selection; put it back to empty
                  task.defer(function() if apiRef and apiRef.set then apiRef:set(nil, true) end end)
                elseif orig then
                  r, why = orig(...)
                end
                if r ~= false then
                  for _, fnL in ipairs(listeners) do L.try("OnChanged", fnL, ...) end
                end
                return r, why
              end
            end
            el = L.C[fn](host, o)
            apiRef = el
            if name == "button" then styleButton(el, o) end
            decorate(el, o, listeners)
          end
          if afterAdd then afterAdd() end
          return el
        end
      end

      -- Paragraph: plain text, or a card with an image and/or buttons
      t.Paragraph = function(self, o)
        o = norm(o)
        local el
        if o.image or (o.buttons and #o.buttons > 0) then
          o.buttons = normButtons(o.buttons)
          el = L.C.card(host, o)
        else
          local txt = o.text or ""
          if o.desc and o.desc ~= "" then
            txt = (txt ~= "" and (txt .. "\n") or "") .. o.desc
          end
          el = { frame = L.C.paragraph(host, txt) }
        end
        decorate(el, o)
        if afterAdd then afterAdd() end
        return el
      end

      -- Group: elements side by side
      t.Group = function(self, o)
        o = norm(o)
        local g = L.C.group(host, o)
        local sub = makeElements(g.body, function() g:rebalance() end)
        sub.Frame, sub.frame = g.frame, g.frame
        decorate(sub, o)
        if afterAdd then afterAdd() end
        return sub
      end

      -- Section: a plain heading, or (Box / Opened / Collapsible) a foldable box
      -- that owns the elements added to it
      t.Section = function(self, o)
        o = norm(o)
        local foldable = o.box ~= nil or o.opened ~= nil or o.collapsible ~= nil
        local sub
        if foldable then
          local fold = L.C.fold(host, o)
          sub = makeElements(fold.body)
          sub.Frame, sub.frame, sub.Body = fold.frame, fold.frame, fold.body
          sub.Open = function() fold:set(true) end
          sub.Close = function() fold:set(false) end
          sub.Toggle = function() fold:toggle() end
          sub.Set = function(_, v) fold:set(v) end
          sub.Get = function() return fold:get() end
        else
          local h = L.C.section(host, o.text or "")
          sub = makeElements(host, afterAdd)      -- elements continue on the same page
          sub.Frame, sub.frame = h, h
        end
        decorate(sub, o)
        if afterAdd then afterAdd() end
        return sub
      end

      t.ProgressBar, t.ColorPicker = t.Progress, t.Colorpicker
      t.Buttons = t.Actions
      return t
    end

    local t = makeElements(body)
    t.Tab, t.Body = tab, body
    function t:Select() return w:select(tab.index) end
    return t
  end

  -- ---- window-level: Dialog / Popup / Topbar button -----------------------
  local function dialogOpts(o)
    o = o or {}
    local list = {}
    for i, b in ipairs(o.Buttons or o.buttons or {}) do
      list[i] = {
        text = b.Title or b.Name or b.text or "OK",
        callback = b.Callback or b.callback,
        primary = b.primary or tostring(b.Variant or ""):lower() == "primary",
      }
    end
    return {
      text = o.Title or o.Name or o.text, desc = o.Content or o.Desc or o.desc,
      image = o.Icon or o.Image, buttons = list, width = o.Width,
      dismissable = o.Dismissable,
    }
  end
  function api:Dialog(o) return L.Dialog.show(dialogOpts(o)) end
  api.Popup = api.Dialog

  -- a small button in the header, left of the search hint
  local topbarN = 0
  function api:TopbarButton(o)
    o = o or {}
    local header = w.header
    if not header then return nil end
    topbarN = topbarN + 1
    local A_, T_ = L.A, L.T
    local b = L.mk("Frame", {
      AnchorPoint = Vector2.new(1, 0.5),
      Position = UDim2.new(1, -262 - (topbarN - 1) * 34, 0.5, 0),
      Size = UDim2.fromOffset(30, 30), BackgroundColor3 = T_.c.hover,
      BackgroundTransparency = 1, BorderSizePixel = 0,
      Name = "TopbarButton", Parent = header,
    })
    L.corner(T_.r.sm + 2, b)
    local glyph = tostring(o.Glyph or o.Text or o.Title or o.Name or "?"):sub(1, 2)
    A_.text({
      Text = glyph, font = T_.font.strong, size = T_.size.body, colour = T_.c.textMute,
      align = Enum.TextXAlignment.Center, Parent = b,
    })
    A_.interactive(b, {
      radius = T_.r.sm + 2, hoverAlpha = 0.9, pressAlpha = 0.82,
      onClick = function() if o.Callback then L.try("topbar", o.Callback) end end,
    })
    return { frame = b, Destroy = function() pcall(function() b:Destroy() end) end }
  end

  function api:NavSection(name) return w:navSection(tostring(name)) end
  function api:Show()     return w:show() end
  function api:Hide()     return w:hide() end
  function api:Toggle()   return w:toggle() end
  function api:Minimise() return w:minimise() end
  function api:Restore()  return w:restore() end
  function api:Select(i)  return w:select(i) end
  function api:Subtitle(s) return w:subtitle(tostring(s)) end
  function api:Rename(s)   return w:rename(tostring(s)) end
  function api:GetName()   return w._name end
  return api
end

-- Toast.push reads opts.title + opts.body
function LumenUI.Toast(text, kind, title)
  if L.Toast and L.Toast.push then
    return L.Toast.push({ body = tostring(text), kind = kind or "note",
                          title = title and tostring(title) or nil })
  end
end
-- WindUI:Notify{ Title, Content, Duration, Icon } as well as Notify(text, kind, title)
function LumenUI.Notify(a, kind, title)
  if type(a) ~= "table" then return LumenUI.Toast(a, kind, title) end
  local icon = tostring(a.Icon or ""):lower()
  local k = a.Kind or a.Type
  if not k then
    k = (icon == "check" or icon == "check-circle") and "ok"
      or (icon == "x" or icon == "x-circle") and "bad"
      or (icon == "alert-triangle" or icon == "warning") and "warn" or "info"
  end
  if L.Toast and L.Toast.push then
    return L.Toast.push({
      title = a.Title and tostring(a.Title) or nil,
      body = tostring(a.Content or a.Text or ""), kind = k, duration = a.Duration,
    })
  end
end

-- WindUI:Popup / Window:Dialog without needing the window object
function LumenUI.Dialog(o)
  local list = {}
  for i, b in ipairs((o and (o.Buttons or o.buttons)) or {}) do
    list[i] = { text = b.Title or b.Name or b.text or "OK", callback = b.Callback or b.callback,
                primary = b.primary or tostring(b.Variant or ""):lower() == "primary" }
  end
  return L.Dialog.show({ text = o and (o.Title or o.Name), desc = o and (o.Content or o.Desc),
                         image = o and o.Icon, buttons = list })
end
LumenUI.Popup = LumenUI.Dialog

function LumenUI.SetAccent(color3)
  if not (L.T and L.T.c and L.repaint) then return end
  L.T.c.accent = color3
  if L.T.reindex then L.T.reindex() end
  L.repaint("accent")
end
function LumenUI.SetDense(v)  if L.T then L.T.dense = tonumber(v) or 1 end end
function LumenUI.SetRadius(m) if L.Cfg then L.Cfg.data.radius = tonumber(m) or 1 end end
function LumenUI.SetScale(x)
  x = tonumber(x) or 1
  if L.Cfg then L.Cfg.data.scale = x end
  local w = L.Hub and L.Hub.window
  if w and w.scaleObj then w.scaleObj.Scale = x end
  return x
end
-- rename the hub window (header title + minimised dock pill), persisted
function LumenUI.Rename(name)
  local w = L.Hub and L.Hub.window
  if w then return w:rename(tostring(name)) end
end
function LumenUI.GetName()
  local w = L.Hub and L.Hub.window
  return w and w._name
end
-- low-level passthrough: Orb.new(parent, size, opts)
LumenUI.Orb = function(parent, size, opts)
  if L.Orb and L.Orb.new then return L.Orb.new(parent, size, opts or {}) end
end
function LumenUI.SaveConfig() if L.Cfg and L.Cfg.save then return L.Cfg.save() end end
function LumenUI.LoadConfig() if L.Cfg and L.Cfg.load then return L.Cfg.load() end end
function LumenUI.Unload()     if L.teardown then return L.teardown() end end

getgenv().LumenUI = LumenUI
return LumenUI

