  orbSpin     = { t = "boolean", scope = "global", def = true },

  -- the one feature safe to restore on join: it changes nothing the game can see
  antiAfk     = { t = "boolean", scope = "global", def = false },

  -- feature -> key name. No `fields`: the set of bindable features changes as
  -- features are added, so anything beyond "it is a table" is validated by
  -- L.Binds.load, which drops names it no longer recognises.
  binds       = { t = "table",   scope = "global" },

  -- notifications
  toastDur    = { t = "number",  scope = "global", def = 4.5, min = 0.2, max = 60 },
  toastMax    = { t = "number",  scope = "global", def = 4,   min = 1,   max = 20 },

  -- Games to start automatically whenever you enter them, keyed by place id as
