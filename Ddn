  -- declared place-scoped below, and a PROFILE can carry a whole per-game set
  -- for anyone who does want to switch wholesale.
  features  = { t = "table",   scope = "global" },

  -- Feature ids the user has pinned to the dock, in order. Global: a pin is a
  -- statement about how you like to work, not about one game.
  pins      = { t = "table",   scope = "global" },

  -- name of the profile last loaded, so a reload comes back where you left off
  profile   = { t = "string",  scope = "global", def = "default" },

  -- tuning -- depends on the game you are actually in
  tab       = { t = "number",  scope = "place", def = 1, min = 1, max = 64 },
  autoRun   = { t = "boolean", scope = "place", def = false },
  -- ranges match the sliders. A schema clamp tighter than the control it
  -- validates means the value you set is quietly rewritten on the way to disk.
  walkSpeed = { t = "number",  scope = "place", min = 0, max = 10000 },
  jumpPower = { t = "number",  scope = "place", min = 0, max = 10000 },
  -- PER-GAME FEATURE OVERLAY -- a NEW key that is place-scoped by declaration,
  -- not `features` loosened. absorb routes by scope, so it still bins a
  -- global-scoped block found in a place file: a game can shadow the base map
  -- for itself, and can still never reach into it.
  featureOverrides = { t = "table", scope = "place" },
  -- Which layer a control edit lands in. Place-scoped so the mode belongs to
  -- the game you set it up in and does not follow you into the next one.
  gameOnly  = { t = "boolean", scope = "place", def = false },
}

-- WHAT COMES BACK ON AT EXECUTE, AND WHAT DOES NOT.
--
-- Every control's value is remembered. Re-APPLYING it is a separate question,
-- and for a boolean that arms behaviour the answer is now no.
--
-- THE OLD POLICY WAS A DENYLIST AND IT HAD BEEN DEAD FOR MONTHS. It named four
-- ids -- "fly", "noclip", "infJump", "esp" -- from a scheme that stopped
-- existing when ids became `context.section.label`. So `restorable` compared
-- "universal.movement.Fly" against "fly", never matched, and returned true for
-- everything. EVERY saved boolean re-armed itself on execute, including
-- "hub.combat.Blink shot -- any range, through cover" and three other labels
-- that no longer exist anywhere in the build. A feature you switched off days
-- ago came back on, silently, in a game that can see it.
--
-- So it is an allowlist now, and it fails the safe way round: an id nobody
-- added here does not re-arm, which costs one click. A denylist that goes stale
-- turns features on behind you, which costs a round -- and did.
--
-- Numbers, strings and a stored `false` are untouched by this. A slider cannot
-- switch anything on by itself, and restoring an OFF is restoring the default.
-- That is the whole of what the operator asked for: keep the tuning, keep the
-- pins, stop the arming.
Cfg.ARM_SAFE = {
  -- Sends nothing, draws nothing; it only stops the game idle-kicking you.
  ["universal.movement.Anti-AFK"]     = "local only; nothing the game can see",
  -- Chrome. These decide how the hub looks, not what it does.
  ["config.behaviour.Notifications"]  = "hub chrome",
  ["config.motion.Animation profile"] = "hub chrome",
  -- A preference, not an action: it decides how far aim leads, and cannot
  -- switch anything on by itself.
  ["combat.fling.Automatic prediction"] = "changes how aim leads, not whether it acts",
  ["config.motion.Loading screen"] = "hub chrome",
  ["config.motion.Made in Heaven"] = "hub chrome",
  -- APPEARANCE SUB-OPTIONS. Each one only changes how another feature draws, so
  -- none of them can turn anything on: with ESP off they render nothing at all.
  -- Restoring them is why your ESP looks the way you left it once you switch it
  -- back on by hand.
  ["visuals.esp.Nametag"]             = "how ESP draws, not whether it draws",
  ["visuals.esp.Box"]                 = "how ESP draws, not whether it draws",
  ["visuals.esp.Outline"]             = "how ESP draws, not whether it draws",
  ["visuals.esp.Skeleton"]            = "how ESP draws, not whether it draws",
  ["visuals.esp.Tracer"]              = "how ESP draws, not whether it draws",
  ["visuals.esp.Health bar"]          = "how ESP draws, not whether it draws",
  ["visuals.esp.Off-screen arrow"]    = "how ESP draws, not whether it draws",
  ["hub.esp.Role colours on ESP"]     = "how ESP draws, not whether it draws",
}

-- NUMBERS THAT ARE NOT "JUST A NUMBER".
--
-- The rule above only gates booleans, on the reasoning -- inherited from the
-- old comment in bindPersist -- that "a value cannot switch anything on by
-- itself". That is true of a search radius and false of a walk speed. Measured
-- immediately after the boolean fix landed: auto kill correctly came up off,
-- and the character was still standing there at WalkSpeed 10000, restored from
-- a slider, because a number was allowed through unconditionally.
--
-- These are the ids whose stored value writes straight to the character, so
-- they are remembered and left on disk but not re-applied. Nudge the control
-- and you get your tuning back on the spot.
Cfg.NO_APPLY = {
  ["universal.movement.Walk speed"] = "you would spawn moving at your tuned speed",
  ["universal.movement.Jump power"] = "you would spawn jumping at your tuned power",
}

-- Kept as the human-readable statement of the above, for the Interface tab. It
-- is prose about a rule rather than a list of ids, because the ids are now the
-- exception and the rule is the part worth reading.
Cfg.ARM_POLICY =
  "Switches do not switch themselves back on. Values, sliders, dropdowns and "
  .. "pins all come back exactly as you left them; anything that ARMS a feature "
  .. "starts off every time you execute, so nothing is running before you ask "
  .. "for it. Appearance options and Anti-AFK are the exceptions -- they cannot "
  .. "act on their own."

Cfg.global, Cfg.place, Cfg.data = {}, {}, {}

-- ---------------------------------------------------------------- validation

local function coerce(key, v)
  local s = Cfg.SCHEMA[key]
  if not s then return nil, "unknown key" end
  if type(v) ~= s.t then
    return nil, string.format("expected %s, got %s", s.t, type(v))
  end
  if s.t == "number" then
    if v ~= v then return nil, "not a number" end           -- NaN survives JSON
    local c = math.clamp(v, s.min or -math.huge, s.max or math.huge)
    if c ~= v then
      L.log("refused", "config",
        string.format("%s was %.4g, outside %s..%s -- clamped to %.4g",
          key, v, tostring(s.min), tostring(s.max), c))
    end
    return c
  end
  if s.t == "table" and s.fields then
    for f, ft in pairs(s.fields) do
      if type(v[f]) ~= ft then
        return nil, string.format("field %s must be %s", f, ft)
      end
    end
  end
  return v
end

-- ---------------------------------------------------------------- io

local function folders()
  L.try("cfg.folder", function()
    if not isfolder(Cfg.DIR) then makefolder(Cfg.DIR) end
    if not isfolder(Cfg.PLACE_DIR) then makefolder(Cfg.PLACE_DIR) end
  end)
end

-- "gone" and "broken" are different answers and the caller needs both: one is
-- a fresh machine, the other is a half-written file with a copy to recover from.
local function decodeFile(path)
  local ok, raw = pcall(readfile, path)
  if not ok or type(raw) ~= "string" or #raw == 0 then return nil, "gone" end
  local dok, t = pcall(function() return L.Http:JSONDecode(raw) end)
  if not dok or type(t) ~= "table" then return nil, "broken" end
  return t
end

-- A corrupt file SAYS SO. Silently reverting to defaults is how a user loses
-- every setting and concludes the tool is flaky rather than that one file broke.
--
-- The staged copy is consulted only when the primary is PRESENT and unreadable,
-- which is what a kill mid-write leaves. An ABSENT primary is a wipe or a fresh
-- machine, and recovering there would make Cfg.wipe undo itself on next load.
local function readJson(path)
  local t, why = decodeFile(path)
  if t then return t end
  local present = false
  pcall(function() present = isfile(path) == true end)
  if why == "broken" or present then
    local staged = decodeFile(path .. "~")
    if staged then
      L.log("note", "config", path .. " was cut short -- recovered the staged copy")
      return staged
    end
  end
  if why == "broken" then
    L.log("refused", "config", "could not parse " .. path .. " -- using defaults")
  end
  return nil
end

local function withVersion(t)
  local out = { __v = Cfg.VERSION }
  for k, v in pairs(t) do out[k] = v end
  return out
end

-- ---------------------------------------------------------------- resolve

function Cfg.resolve()
  local d = {}
  for k, s in pairs(Cfg.SCHEMA) do
    if s.def ~= nil then d[k] = s.def end
  end
  for k, v in pairs(Cfg.global) do d[k] = v end
  for k, v in pairs(Cfg.place) do d[k] = v end   -- place wins
  Cfg.data = d
  return d
end

-- Keys this place is currently overriding, for the UI to show. A per-place
-- system the user cannot see the state of is just an unexplained inconsistency
-- between two sessions.
function Cfg.overrides()
  local out = {}
  for k, v in pairs(Cfg.place) do out[#out + 1] = { key = k, value = v } end
  table.sort(out, function(a, b) return a.key < b.key end)
  return out
end

-- ---------------------------------------------------------------- load

function Cfg.load()
  Cfg.global, Cfg.place = {}, {}

  -- MIGRATION FALLS OUT OF ROUTING BY SCOPE. A v1 file was flat and held both
  -- kinds of key. Every key is placed by what the schema says it is, not by
  -- which file it arrived in, so an old config lands correctly with no version
  -- check and the next write splits it into the two files properly.
  local function absorb(t, fromPlaceFile)
    if not t then return end
    for k, v in pairs(t) do
      if k ~= "__v" then
        local s = Cfg.SCHEMA[k]
        if not s then
          L.log("note", "config", "ignoring unknown key '" .. tostring(k) .. "'")
        else
          local cv, why = coerce(k, v)
          if cv == nil then
            L.log("refused", "config", string.format("%s dropped -- %s", k, why or "invalid"))
          elseif s.scope == "place" then
            Cfg.place[k] = cv
          elseif not fromPlaceFile then
            Cfg.global[k] = cv
          end
          -- a global-scoped key sitting in a place file is ignored on purpose:
          -- it would let one game silently change a setting for every game
        end
      end
    end
  end

  local globalFile = readJson(Cfg.PATH)
  local placeFile = readJson(Cfg.PLACE_PATH)
  absorb(globalFile, false)
  absorb(placeFile, true)

  -- ONE-TIME RESCUE OF SETTINGS SAVED WHILE `features` WAS PLACE-SCOPED.
  --
  -- absorb drops a global-scoped key found in a place file on purpose, so
  -- flipping features from place to global would have silently binned every
  -- setting anybody had already tuned -- the exact "it forgot everything"
  -- complaint the flip was meant to fix. Adopt them instead, but only when
  -- nothing global exists yet, so this can never overwrite newer values.
  if placeFile and type(placeFile.features) == "table"
     and type(Cfg.global.features) ~= "table" then
    local cv = coerce("features", placeFile.features)
    if cv ~= nil then
      Cfg.global.features = cv
      L.log("note", "config",
        "adopted settings saved under this place -- they now apply everywhere")
      Cfg._migrated = true
    end
  end

  Cfg.resolve()
  Cfg.foldRenamed()
  Cfg.loaded = true
  return Cfg.data
end

-- ---------------------------------------------------------------- write

-- THERE IS NO RENAME, SO THE STAGED FILE IS THE BACKUP.
--
-- writefile over a live config is not atomic, and an executor killed mid-write
-- is the NORMAL way a session ends: the JSON is truncated and the next execute
-- starts from stock across all 104 settings. So the same bytes go to path.."~"
-- first and are read back and compared before path is touched. A kill during
-- the real write leaves "~" holding the complete NEW state, which readJson
-- picks up; a kill during the staging write leaves path fully intact.
--
-- Residual window: a kill inside the staging write when path was ALREADY
-- broken, and whatever writefile leaves buffered past the readback -- there is
-- no fsync to reach for. Both are strictly narrower than one bare write.
local function writeAtomic(label, path, text)
  local staged = pcall(function()
    writefile(path .. "~", text)
    if readfile(path .. "~") ~= text then error("short write", 0) end
  end)
  if not staged and not Cfg._noStage then
    Cfg._noStage = true
    L.log("note", "config", "no staged copy here -- a kill mid-write can still lose settings")
  end
  local ok = (L.try(label, function() writefile(path, text) end)) and true or false
  -- THE STAGED COPY IS A CRASH ARTEFACT, NOT A BACKUP, so it must not outlive
  -- the write. Left behind it is worse than useless: a later corruption of the
  -- real file silently resolves to whatever this held, so the user is told the
  -- write was cut short and quietly handed older settings instead of being told
  -- the file is unreadable. Present == a write did not finish, and only then.
  if ok and staged then pcall(delfile, path .. "~") end
  return ok
end

function Cfg.flush()
  if not Cfg.loaded then return false end
  folders()
  local a = writeAtomic("cfg.write", Cfg.PATH,
    L.Http:JSONEncode(withVersion(Cfg.global)))
  local b = true
  if next(Cfg.place) then
    b = writeAtomic("cfg.writePlace", Cfg.PLACE_PATH,
      L.Http:JSONEncode(withVersion(Cfg.place)))
  else
    -- AN EMPTY PLACE LAYER IS A STATE, NOT AN ABSENCE. Skipping the write left
    -- the old file on disk, so whatever cleared the layer got its values back
    -- on the next load. clearPlace deletes explicitly; this is the same rule,
    -- one branch wider, and it is the branch loadProfile lands in.
    pcall(delfile, Cfg.PLACE_PATH)
  end
  local ok = (a and b) and true or false
  Cfg.saveError = not ok
  if ok then Cfg._dirty=false; Cfg.lastSaved=os.clock() end
  return ok
end

function Cfg.setAutoSave(on)
  if Cfg.data.autoSave == (on == true) then return true end
  Cfg.set("autoSave", on == true)
  -- Persist the preference once. Further edits remain in memory when off.
  return Cfg.flush()
end

local function schedule()
  if not Cfg.loaded then return end
  Cfg._dirty = true
  if Cfg.data.autoSave == false or Cfg._pending then return end
  Cfg._pending = true
  task.delay(0.6, function()
    Cfg._pending = false
    if L.live() and Cfg._dirty and Cfg.data.autoSave ~= false then
      Cfg.flush()
    end
  end)
end

-- AUTOSAVE ALREADY WORKS, AND THIS IS WHERE I NEARLY BROKE IT.
--
-- A timed flush was added here on the assumption that Cfg.set only marks the
-- table and waits for teardown -- the story that explained a setting reverting
-- across a reload earlier in the session. It is not what happens: schedule()
-- above already debounces a real flush 0.6 s after any change, so writes reach
-- disk during normal use without anything else.
--
-- The reverting setting had a different cause entirely (one value stored under
-- two keys, fixed in Theme.setMotion), and a second flush loop would have added
-- per-frame work to every session to solve a problem that was never here.
function Cfg.set(key, value)
  local s = Cfg.SCHEMA[key]
  if not s then
    -- a typo'd key is OUR bug, not the user's, so it lights the fault indicator
    L.fault("cfg.key", "unknown config key '" .. tostring(key) .. "'")
    return false
  end

  local layer = (s.scope == "place") and Cfg.place or Cfg.global
  if value == nil then
    layer[key] = nil
    Cfg.resolve()
    schedule()
    return true
  end

  local v, why = coerce(key, value)
  if v == nil then
    L.log("refused", "config", string.format("%s not set -- %s", key, why or "invalid"))
    return false
  end
  layer[key] = v
  Cfg.data[key] = v
  schedule()
  return true
end

-- Drop this place's override and fall back to the global value.
function Cfg.clearPlace(key)
  if key then
    Cfg.place[key] = nil
  else
    Cfg.place = {}
    pcall(delfile, Cfg.PLACE_PATH)
  end
  Cfg.resolve()
  schedule()
  return true
end

function Cfg.wipe(alsoPlace)
  pcall(delfile, Cfg.PATH)
  Cfg.global = {}
  if alsoPlace ~= false then
    pcall(delfile, Cfg.PLACE_PATH)
    Cfg.place = {}
  end
  Cfg.resolve()
  Cfg.loaded = true
  return true
end

-- ---------------------------------------------------------------- features
--
-- The per-control store. `id` is whatever the control was given; there is no
-- registry of valid ids on purpose, because the alternative is that adding a
-- slider to a feature tab also means editing the schema, and that is precisely
-- the coupling that left a hundred settings unsaved.
--
-- Values are restored by the control itself at construction, so a control that
-- has never been saved simply keeps the default it was written with.

-- OVERLAY FIRST, BASE SECOND -- the same "place wins" rule resolve applies to
-- schema keys, moved into the one function every reader already goes through.
-- resolve itself cannot do it: Cfg.data.features IS Cfg.global.features by
-- reference, and setFeat and declare write through that alias every frame of a
-- slider drag, so a merged copy there would be stale before it was read.
function Cfg.ovr()
  local t = Cfg.place.featureOverrides
  return (type(t) == "table") and t or nil
end

-- RETIRED IDS. A renamed or merged control strands its saved value as an orphan
-- -- there are already 36 on this machine, every one a setting somebody tuned
-- and silently lost. An id listed here resolves to the id that replaced it, so
-- the value follows the control instead of rotting.
Cfg.RENAMED = {
  -- Universal's "Player ESP" and Visuals' "ESP" drove two different ESP
  -- engines. There is one engine now (lm_30) and one boolean behind both.
  ["universal.players.Player ESP"] = "visuals.esp.ESP",
}

-- Rewrites the stored map once so the dead id does not sit in the file forever.
-- The replacement wins when both exist: it is the id the surviving control
-- declares, and the one the user was actually looking at.
function Cfg.foldRenamed()
  local t = Cfg.global.features
  if type(t) ~= "table" then return 0 end
  local n = 0
  for old, new in pairs(Cfg.RENAMED) do
    if t[old] ~= nil then
      if t[new] == nil then t[new] = t[old] end
      t[old] = nil
      Cfg.featCount = nil           -- setFeat recounts when it is not a number
      n = n + 1
    end
  end
  if n > 0 then
    L.log("note", "config", "carried " .. n .. " renamed setting(s) to their new id")
  end
  return n
end

function Cfg.feat(id, default)
  id = Cfg.RENAMED[id] or id
  local o = Cfg.ovr()
  if o then
    local ov = o[id]
    if ov ~= nil then return ov end
  end
  local t = Cfg.data.features
  if type(t) ~= "table" then return default end
  local v = t[id]
  if v == nil then return default end
  return v
end

-- The merged map, for callers that ITERATE rather than look one id up. Freshly
-- built each call, so nothing may write into it -- the layers are the store.
function Cfg.featAll()
  local out = {}
  local t = Cfg.data.features
  if type(t) == "table" then for k, v in pairs(t) do out[k] = v end end
  local o = Cfg.ovr()
  if o then for k, v in pairs(o) do out[k] = v end end
  return out
end

-- Is this id shadowed for this game -- the override indicator's whole question,
-- and the same shape of question as Cfg.isDefault, answered per row.
function Cfg.isOverridden(id)
  local o = Cfg.ovr()
  return (o ~= nil) and (o[id] ~= nil)
end

-- What this game shadows, with what every other game sees. Same shape as
-- Cfg.overrides(), so the Config tab gains a section and not a renderer.
function Cfg.overriddenHere()
  local out = {}
  local o = Cfg.ovr()
  if not o then return out end
  local base = Cfg.data.features
  for id, v in pairs(o) do
    out[#out + 1] = { id = id, value = v,
      base = (type(base) == "table") and base[id] or nil }
  end
  table.sort(out, function(a, b) return a.id < b.id end)
  return out
end

-- ORDER IS LOAD-BEARING, same as resetFeat: move the live control first, drop
-- the shadow second. The persist wrapper writes the value back on the way past,
-- so clearing the key first would just re-shadow it with the value on screen.
function Cfg.clearOverride(id)
  local o = Cfg.ovr()
  if not o or o[id] == nil then return false end
  o[id] = nil
  if not next(o) then Cfg.place.featureOverrides = nil end
  local base = Cfg.data.features
  local v = (type(base) == "table") and base[id] or nil
  if v == nil then v = (L.C and L.C._def) and L.C._def[id] or nil end
  if v ~= nil then
    local C = L.C
    local h = C and C.find and C.find(id)
    if h and h.set then L.try("cfg.unoverride", h.set, h, v) end
    if C and C._live then C._live[id] = v if C.notify then C.notify(id) end end
  end
  schedule()
  return true
end

-- Make this game normal again.
function Cfg.clearOverrides()
  local o = Cfg.ovr()
  if not o then return 0 end
  local ids = {}
  for id in pairs(o) do ids[#ids + 1] = id end
  for _, id in ipairs(ids) do Cfg.clearOverride(id) end
  return #ids
end

-- MUTATED IN PLACE, BECAUSE A SLIDER DRAG CALLS THIS EVERY FRAME.
--
-- The copy existed to keep Cfg.set's coercion in the path, and for this key
-- that coercion is one type() call: `features` is declared t="table" with no
-- `fields`, so the 104 entries were never inspected. Cfg.resolve copies
-- references and `features` is global-scoped, so Cfg.data.features IS
-- Cfg.global.features -- storing one key here is already visible everywhere.
--
-- Cfg.set("features", t) still works for whoever replaces the map wholesale.
-- ------------------------------------------------------ per-feature specs
--
-- `features` passes coerce as one t="table" with no fields, so until now every
-- value inside it was accepted unread: any type under any id. That is how a
-- hand-edited walk speed of 1e9 reached the character past a slider that stops
-- at 10000. These specs close it, and they are DERIVED -- each control hands
-- over its own range or item list at construction (bindPersist, lm_06), so
-- nothing here is maintained by hand.
Cfg.SPEC = {}

-- The same answers coerce gives a schema key: clamp a number back into range,
-- refuse a wrong type or a choice that is not on the control's list.
function Cfg.checkFeat(id, v)
  local s = Cfg.SPEC[id]
  if not s or v == nil then return v end
  if type(v) ~= s.t then
    return nil, string.format("expected %s, got %s", s.t, type(v))
  end
  if s.t == "number" then
    -- NaN and both infinities survive JSON, and an unbounded spec would clamp
    -- neither of them
    if v ~= v or v == math.huge or v == -math.huge then
      return nil, "not a finite number"
    end
    local c = math.clamp(v, s.min or -math.huge, s.max or math.huge)
    if c ~= v then
      L.log("refused", "config", string.format(
        "%s was %.4g, outside %s..%s -- clamped to %.4g",
        id, v, tostring(s.min), tostring(s.max), c))
    end
    return c
  end
  if s.enum and not s.enum[v] then
    return nil, "'" .. tostring(v) .. "' is not one of its choices"
  end
  return v
end

local function repairFeat(t, id)
  local cur = t[id]
  if cur == nil then return false end
  local v, why = Cfg.checkFeat(id, cur)
  if v == cur then return false end
  if v == nil then
    L.log("refused", "config",
      string.format("%s dropped -- %s", id, why or "invalid"))
  end
  t[id] = v
  return true
end

-- A CONTROL IS BUILT LONG AFTER ITS VALUE WAS LOADED, so no spec can exist when
-- the file is read -- the rule does not exist yet. Construction is instead both
-- the moment the rule becomes knowable and the last moment before the value is
-- used, so declaring repairs what is already in the store, right then, and the
-- Cfg.feat on the next line of bindPersist never sees the bad value. Ids whose
-- control is never built stay untouched and unchecked; nothing reads them
-- either. Writing straight into the table is safe because Cfg.data.features is
-- the same table resolve aliased -- going through Cfg.set would be a full
-- SCHEMA pass plus a resolve per control, 126 times, during the build.
function Cfg.declare(id, spec)
  if type(id) ~= "string" or id == "" or type(spec) ~= "table" then return end
  Cfg.SPEC[id] = spec
  local t = Cfg.global.features
  local dirty = (type(t) == "table") and repairFeat(t, id) or false
  -- the overlay is hand-editable too, and it is the layer that wins
  local o = Cfg.ovr()
  if o and repairFeat(o, id) then dirty = true end
  if dirty then schedule() end
end

-- Where a whole features map arrives at once -- a profile, or anything pasted --
-- rather than a key at a time. Only ids with a spec can be checked; the rest
-- stay inert until a control claims one, and declare catches them then.
function Cfg.sweepFeatures()
  local t = Cfg.global.features
  local o = Cfg.ovr()
  if type(t) ~= "table" and not o then return 0 end
  Cfg.foldRenamed()                   -- a profile can carry a retired id too
  local n = 0
  for id in pairs(Cfg.SPEC) do
    if type(t) == "table" and repairFeat(t, id) then n = n + 1 end
    if o and repairFeat(o, id) then n = n + 1 end
  end
  return n
end

function Cfg.setFeat(id, value)
  if type(id) ~= "string" or id == "" then return false end
  id = Cfg.RENAMED[id] or id
  -- The features map is the one store coerce never inspected. Clamp or refuse
  -- here, which is the only path every writer goes through.
  if value ~= nil then
    local ok, why = Cfg.checkFeat(id, value)
    if ok == nil then
      L.log("refused", "config", string.format("%s dropped -- %s", id, why or "invalid"))
      return false
    end
    value = ok
  end
  local t = Cfg.global.features
  if type(t) ~= "table" then
    t = {}
    Cfg.global.features = t
  end
  Cfg.data.features = t

  -- FORGETTING IS UNCONDITIONAL, SETTING IS ROUTED. nil means "this setting no
  -- longer exists" -- resetFeat, a wipe -- and a shadow left behind would hand
  -- the value straight back on the next load. A VALUE goes to whichever layer
  -- is being edited, which is what "this game only" actually means.
  if value == nil then
    local o = Cfg.ovr()
    if o and o[id] ~= nil then
      o[id] = nil
      if not next(o) then Cfg.place.featureOverrides = nil end
    end
  elseif Cfg.data.gameOnly == true then
    local o = Cfg.ovr()
    if not o then
      o = {}
      Cfg.place.featureOverrides = o
      Cfg.data.featureOverrides = o
    end
    o[id] = value
    schedule()
    return true
  end

  if type(Cfg.featCount) ~= "number" then
    Cfg.featCount = 0
    for _ in pairs(t) do Cfg.featCount = Cfg.featCount + 1 end
  end
  local had = t[id] ~= nil
  t[id] = value
  if value == nil then
    if had then Cfg.featCount = Cfg.featCount - 1 end
  elseif not had then
    Cfg.featCount = Cfg.featCount + 1
  end
  schedule()
  return true
end

-- How many settings are being remembered, for the Config tab to report.
function Cfg.featTotal()
  local n = 0
  for _ in pairs(Cfg.featAll()) do n = n + 1 end
  return n
end

-- Forget every remembered control value without touching theme/geometry.
function Cfg.wipeFeatures()
  Cfg.set("features", {})
  Cfg.featCount = nil   -- the map was replaced, so the running count is a lie
  return true
end

-- ----------------------------------------------------- defaults and reset
--
-- C._def is filled by bindPersist at construction, so "stock" is what the source
-- says TODAY -- never a value on disk that outlived the code that wrote it. That
-- one fact is the whole difference between wipeFeatures and a per-control reset.

local function defaultOf(id)
  local C = L.C
  local d = C and C._def
  return d and d[id]
end

function Cfg.isDefault(id)
  local cur = Cfg.feat(id, nil)
  if cur == nil then return true end
  local def = defaultOf(id)
  if def == nil then return false end   -- stored, with no source default to match
  return cur == def
end

-- ORDER IS LOAD-BEARING: move the live control first, drop the override second.
-- The control's persist wrapper writes the value back on the way past, so
-- deleting the key first would just re-save the default as an explicit override.
function Cfg.resetFeat(id)
  local def = defaultOf(id)
  if def == nil then return false end
  local had = Cfg.feat(id, nil) ~= nil
  local C = L.C
  local h = C and C.find and C.find(id)
  if h and h.set then L.try("cfg.reset", h.set, h, def) end
  if C and C._live then C._live[id] = def if C.notify then C.notify(id) end end
  if had then Cfg.setFeat(id, nil) end     -- nil removes the key; featCount recounts
  return had
end

-- Everything that differs from stock, for a UI to list. The second return is the
-- stored ids with NO known default -- orphans left by a renamed label, which
-- until now were invisible and permanent.
function Cfg.changedFromDefault()
  local out, orphans = {}, {}
  local t = Cfg.featAll()
  for id, v in pairs(t) do
    local def = defaultOf(id)
    if def == nil then
      orphans[#orphans + 1] = id
    elseif v ~= def then
      out[#out + 1] = { id = id, value = v, default = def }
    end
  end
  table.sort(out, function(a, b) return a.id < b.id end)
  table.sort(orphans)
  return out, orphans
end

-- Restoring a stored value must not switch a feature on behind the user's back.
-- Consulted by bindPersist for one case only: a saved boolean that is TRUE. The
-- value stays on disk either way -- this decides whether it is re-applied, not
-- whether it is kept.
-- THE GATE IS A DENYLIST AGAIN -- DELIBERATELY, AND NOT BY REVERTING.
--
-- The allowlist above was the right answer to a specific accident: a STALE
-- denylist that had silently stopped matching anything, so every saved boolean
-- re-armed and nobody knew. Failing closed was the correct response to not
-- knowing what was being restored.
--
-- That is no longer the situation. The operator has asked for their state back
-- and the restoration is now VISIBLE -- every re-armed feature is counted, named
-- and revertible in one click (see Cfg.restored below). A denylist is only
-- dangerous when it goes stale unnoticed; a stale entry here shows up as a
-- feature in the toast that the operator did not expect, which is exactly the
-- signal the old one could not produce.
--
-- What stays held back is a much shorter list than before, and it is a
-- different KIND of thing: not "features", but the handful that move your
-- character the instant they arm. A bad saved value there strands you before
-- there is a panel to fix it from.
Cfg.ARM_HOLD = {
  ["universal.movement.Fly"]           = "you would spawn already flying",
  ["universal.movement.Noclip"]        = "you would spawn already through the floor",
  ["universal.movement.Infinite jump"] = "arms a bind that fires before the hub draws",
  ["universal.movement.Freeze in place"] = "you would spawn unable to move",
}

function Cfg.restorable(id)
  local held = Cfg.ARM_HOLD[id]
  if held then return false, held end
  return true, Cfg.ARM_SAFE[id] or "restored as you left it"
end

-- ---------------------------------------------------------------- ledger
--
-- WHAT CAME BACK ON, SO IT CAN BE UNDONE IN ONE CLICK.
--
-- Restoring armed features is only reasonable if the operator can SEE what was
-- restored. Without that it is the old silent-rearm bug wearing better
-- intentions -- the failure mode is identical, it is just now on purpose.
Cfg.restored = {}

function Cfg.noteRestored(id, value, cb)
  Cfg.restored[#Cfg.restored + 1] = { id = id, value = value, cb = cb }
end

function Cfg.restoredCount() return #Cfg.restored end

function Cfg.restoredNames(limit)
  local out = {}
  for i, r in ipairs(Cfg.restored) do
    if limit and i > limit then break end
    -- the label is the last segment of `context.section.Label`
    out[#out + 1] = tostring(r.id):match("([^.]+)$") or tostring(r.id)
  end
  return out
end

-- Switch every restored feature back off and write that. Used by the toast.
function Cfg.revertRestored()
  local n = 0
  for _, r in ipairs(Cfg.restored) do
    if r.cb then pcall(r.cb, false) end
    Cfg.setFeat(r.id, false)
    n = n + 1
  end
  Cfg.restored = {}
  -- ONE write for the whole revert: each setFeat above only marked the map and
  -- armed the 0.6 s debounce, so clearing the flag after a flush that actually
  -- succeeded stops that debounce writing the same file a second time.
  local ok, wrote = pcall(Cfg.flush)
  if ok and wrote then Cfg._dirty = false end
  return n
end

-- ---------------------------------------------------------------- pins

function Cfg.pins()
  local t = Cfg.data.pins
  if type(t) ~= "table" then return {} end
  local out = {}
  for _, id in ipairs(t) do
    if type(id) == "string" then out[#out + 1] = id end
  end
  return out
end

function Cfg.pinned(id)
  for _, v in ipairs(Cfg.pins()) do if v == id then return true end end
  return false
end

function Cfg.setPin(id, on)
  if type(id) ~= "string" or id == "" then return false end
  local list, out = Cfg.pins(), {}
  for _, v in ipairs(list) do
    if v ~= id then out[#out + 1] = v end
  end
  if on then out[#out + 1] = id end
  if #out > 12 then table.remove(out, 1) end   -- the dock is a strip, not a menu
  Cfg.set("pins", out)
  if L.Pins and L.Pins.refresh then L.try("pins.refresh", L.Pins.refresh) end
  return true
end

-- ---------------------------------------------------------------- profiles
--
-- A profile is a snapshot of BOTH layers under a name. Saving copies what is
-- live; loading replaces what is live and re-applies it. The active profile's
-- name is itself a global setting, so a reload returns to the same one.

Cfg.PROFILE_DIR = "Lumen/profiles"

-- A NAME THAT IS NOT THE NAME YOU TYPED IS A DIFFERENT PROFILE. Stripping the
-- illegal characters meant "combat/2" saved silently over "combat2", and a name
-- with nothing legal in it produced "/.json", which profiles() cannot list -- so
-- the save vanished with no error to show for it. The rule the Save-as field
-- already states is now the rule that is enforced.
local function profilePath(name)
  name = tostring(name)
  if name == "" or name:gsub("[%w_%- ]", "") ~= "" then
    return nil, "letters, numbers, spaces, - and _ only"
  end
  return Cfg.PROFILE_DIR .. "/" .. name .. ".json"
end

function Cfg.profiles()
  local out = {}
  L.try("cfg.profiles", function()
    if not isfolder(Cfg.PROFILE_DIR) then return end
    for _, f in ipairs(listfiles(Cfg.PROFILE_DIR)) do
      local name = tostring(f):gsub("\\", "/"):match("([^/]+)%.json$")
      if name then out[#out + 1] = name end
    end
  end)
  table.sort(out)
  return out
end

function Cfg.saveProfile(name)
  if type(name) ~= "string" or name:gsub("%s", "") == "" then
    return false, "give it a name"
  end
  folders()
  L.try("cfg.profileDir", function()
    if not isfolder(Cfg.PROFILE_DIR) then makefolder(Cfg.PROFILE_DIR) end
  end)
  local path, bad = profilePath(name)
  if not path then return false, bad end
  local ok = L.try("cfg.saveProfile", function()
    writefile(path, L.Http:JSONEncode({
      -- WHICH GAME THE PLACE LAYER IS ABOUT. Without it a profile's per-place
      -- tuning is indistinguishable from tuning meant for wherever you load it.
      __v = Cfg.VERSION, placeId = Cfg.placeId,
      global = Cfg.global, place = Cfg.place,
    }))
  end)
  if ok then
    Cfg.set("profile", name)
    return true
  end
  return false, "could not write it"
end

function Cfg.loadProfile(name)
  local path, bad = profilePath(name)
  if not path then return false, bad end
  local t = readJson(path)
  if not t then return false, "no profile called " .. tostring(name) end
  if type(t.global) ~= "table" or type(t.place) ~= "table" then
    return false, "that profile file is not readable"
  end

  -- A PROFILE'S PLACE LAYER BELONGS TO THE GAME IT WAS SAVED IN. Adopting it
  -- anywhere wrote one game's walkSpeed permanently into the next one, and
  -- overrides() then reported it as this place's own tuning with nothing to say
  -- it arrived by profile. Profiles saved before the stamp have no placeId, so
  -- they keep the old behaviour rather than losing their tuning to a fix.
  local samePlace = (t.placeId == nil) or (tostring(t.placeId) == Cfg.placeId)

  Cfg.global = {}
  for k, v in pairs(t.global) do
    if k ~= "__v" then
      local s = Cfg.SCHEMA[k]
      if s and s.scope ~= "place" then
        local cv = coerce(k, v)
        if cv ~= nil then Cfg.global[k] = cv end
      end
    end
  end
  if samePlace then
    local place = {}
    for k, v in pairs(t.place) do
      if k ~= "__v" then
        local s = Cfg.SCHEMA[k]
        if s and s.scope == "place" then
          local cv = coerce(k, v)
          if cv ~= nil then place[k] = cv end
        end
      end
    end
    Cfg.place = place
  else
    L.log("note", "config", "kept this place's tuning -- that profile's belongs to place "
      .. tostring(t.placeId))
  end
  -- A PROFILE CARRIES THE ENTIRE features MAP and coerce waves it through as a
  -- single t="table", so this is the one place a pasted file lands unread.
  Cfg.sweepFeatures()
  Cfg.resolve()
  Cfg.global.profile = name
  Cfg.data.profile = name
  schedule()
  return true
end

function Cfg.deleteProfile(name)
  local path = profilePath(name)
  if not path then return false end
  local ok = pcall(delfile, path)
  return ok and true or false
end

-- ---------------------------------------------------------------- share codes
--
-- A SHARED THING IS ONE GROUP OF FEATURE VALUES, NOT A PROFILE. A profile is the
-- whole program -- theme, window rect, keybinds, seenVersion -- so sharing one
-- moves the recipient's window and repaints their hub to say you were here. A
-- code carries the tuning under a single id prefix, which is the grouping the
-- ids already encode as ctx.section.label: "combat.fling" names 24 knobs and
-- costs no registry to maintain.

Cfg.SHARE_TAG = "LM1-"
Cfg.SHARE_VER = 1

-- Own codec rather than crypt.base64: lm_26 already has to fall back on
-- executors that ship none, the alphabet has to survive a paste (- and _, no
-- padding), and a code is under a kilobyte, so the native speed that earns its
-- keep on a 47 KB PNG buys nothing here.
local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
local B64R

local function b64enc(s)
  local out, n = {}, 0
  for i = 1, #s, 3 do
    local a, b, c = string.byte(s, i, i + 2)
    local v = a * 65536 + (b or 0) * 256 + (c or 0)
    local q = {}
    for k = 4, 1, -1 do
      q[k] = string.sub(B64, v % 64 + 1, v % 64 + 1)
      v = math.floor(v / 64)
    end
    n = n + 1
    out[n] = table.concat(q, "", 1, b and (c and 4 or 3) or 2)
  end
  return table.concat(out)
end

local function b64dec(s)
  if not B64R then
    B64R = {}
    for i = 1, #B64 do B64R[string.byte(B64, i)] = i - 1 end
  end
  local out, n, acc, bits = {}, 0, 0, 0
  for i = 1, #s do
    local v = B64R[string.byte(s, i)]
    if not v then return nil end
    acc = acc * 64 + v
    bits = bits + 6
    if bits >= 8 then
      bits = bits - 8
      local byte = math.floor(acc / 2 ^ bits)
      acc = acc - byte * 2 ^ bits
      n = n + 1
      out[n] = string.char(byte)
    end
  end
  return table.concat(out)
end

-- Fletcher-16 over version+body, so a paste that lost its tail is refused whole
-- rather than applied as far as it still parses. mod 255 keeps both halves
-- inside a byte.
local function sum16(s)
  local a, b = 1, 0
  for i = 1, #s do
    a = (a + string.byte(s, i)) % 255
    b = (b + a) % 255
  end
  return b * 256 + a
end

-- prefix -> how many saved values sit under it, so the UI can offer what exists
-- instead of asking the user to know the id scheme.
function Cfg.shareGroups()
  local out = {}
  for id in pairs(Cfg.featAll()) do
    local a, b = string.match(id, "^([^%.]+)%.([^%.]*)%.")
    if a then
      local g = a .. "." .. b
      out[g] = (out[g] or 0) + 1
    end
  end
  return out
end

-- Returns the code and how many values are in it, or nil and why not.
function Cfg.shareCode(prefix)
  if type(prefix) ~= "string" or prefix == "" then return nil, "which group?" end
  local src = Cfg.featAll()
  local head, pick, n = prefix .. ".", {}, 0
  for id, v in pairs(src) do
    if string.sub(id, 1, #head) == head then
      pick[string.sub(id, #head + 1)] = v      -- prefix is stored once, not 24 times
      n = n + 1
    end
  end
  if n == 0 then return nil, "nothing saved under " .. prefix end
  local ok, body = pcall(function()
    return L.Http:JSONEncode({ p = prefix, f = pick })
  end)
  if not ok or type(body) ~= "string" then return nil, "could not encode that group" end
  local raw = string.char(Cfg.SHARE_VER) .. body
  local c = sum16(raw)
  return Cfg.SHARE_TAG .. b64enc(raw .. string.char(math.floor(c / 256), c % 256)), n
end

-- Decodes and verifies, applies nothing -- so the UI can show what a code holds
-- before anyone commits to it.
function Cfg.readShare(code)
  if type(code) ~= "string" then return nil, "paste a code" end
  code = string.gsub(code, "%s", "")           -- a wrapped paste is still the code
  if string.sub(code, 1, #Cfg.SHARE_TAG) ~= Cfg.SHARE_TAG then
    return nil, "that is not a Lumen code"
  end
  local raw = b64dec(string.sub(code, #Cfg.SHARE_TAG + 1))
  if not raw or #raw < 4 then return nil, "that code is cut short" end
  local body = string.sub(raw, 1, #raw - 2)
  if sum16(body) ~= string.byte(raw, #raw - 1) * 256 + string.byte(raw, #raw) then
    return nil, "that code is damaged or incomplete"
  end
  local ver = string.byte(body, 1)
  if ver ~= Cfg.SHARE_VER then
    return nil, "that code was made by format v" .. tostring(ver)
  end
  local ok, t = pcall(function() return L.Http:JSONDecode(string.sub(body, 2)) end)
  if not ok or type(t) ~= "table" or type(t.p) ~= "string" or type(t.f) ~= "table" then
    return nil, "that code is not readable"
  end
  return t
end

-- Every imported pair is somebody else's text on its way to a feature callback,
-- so it goes through the per-key check. Cfg.validFeat is the per-key validation
-- work's; without it this refuses anything that is not a plain scalar, which is
-- the most this file can say on its own.
function Cfg.acceptFeat(id, v)
  if type(id) ~= "string" or id == "" or #id > 160 then return false, "bad id" end
  local vf = rawget(Cfg, "validFeat")
  if type(vf) == "function" then return vf(id, v) end
  local ty = type(v)
  if ty == "boolean" then return true end
  if ty == "number" then
    if v ~= v or v == math.huge or v == -math.huge then return false, "not a number" end
    return true
  end
  if ty == "string" then
    if #v > 240 then return false, "too long" end
    return true
  end
  return false, "only switches, numbers and text travel in a code"
end

-- Returns how many values were taken, plus the group and how many were refused.
-- APPLYING A GROUP IS ONE OPERATION WITH ONE UNDO, whether it arrived pasted or
-- named. Everything below shares this path.
--
-- Per-id setFeat replaced the wholesale Cfg.set("features", merged) this grew
-- out of: setFeat is O(1) since the spec work, so 22 calls cost what the one
-- copy cost; each value now passes checkFeat, so a hand-edited pack cannot
-- outrun the slider it describes; and it honours the per-game routing, so a
-- pack applied under "this game only" is itself per-game.
local NONE = {}          -- "there was no key here", which nil cannot say
Cfg.NONE = NONE
Cfg.undo = nil

local function pushLive(id, v)
  local hold = (v == true) and not Cfg.restorable(id)
  local h = (not hold) and L.C and L.C.find and L.C.find(id) or nil
  if h and h.set then pcall(function() h:set(v) end) end
end

function Cfg.applyGroup(prefix, f, label)
  if type(prefix) ~= "string" or prefix == "" or type(f) ~= "table" then
    return nil, "nothing to apply"
  end
  local head, live, took, refused = prefix .. ".", {}, 0, 0
  -- SNAPSHOT PER LAYER, NOT THE RESOLVED VALUE. Recording what Cfg.feat
  -- returned would put a base value back through setFeat on revert, which under
  -- "this game only" writes a shadow equal to the base and leaves the id
  -- reporting as overridden forever.
  local prevB, prevO, ids = {}, {}, {}
  for leaf, v in pairs(f) do
    local id = head .. tostring(leaf)
    if Cfg.acceptFeat(id, v) then
      local b, o = Cfg.data.features, Cfg.ovr()
      local hadB = (type(b) == "table") and b[id] or nil
      local hadO = o and o[id] or nil
      if Cfg.setFeat(id, v) then
        prevB[id] = (hadB == nil) and NONE or hadB
        prevO[id] = (hadO == nil) and NONE or hadO
        ids[#ids + 1] = id
        live[id] = v
        took = took + 1
      else
        refused = refused + 1     -- refused by its spec; it displaced nothing
      end
    else
      refused = refused + 1
    end
  end
  if took == 0 then return nil, "nothing in that was accepted" end
  Cfg.undo = { group = prefix, name = label, base = prevB, ovr = prevO, ids = ids }
  -- Then the live controls -- except the ones ARM_HOLD keeps from arming
  -- themselves. A pack you applied may not start you flying.
  for id, v in pairs(live) do pushLive(id, v) end
  return took, refused
end

-- ONE STEP BACK, NOT A HISTORY. The question after a preset is "put it back how
-- it was", once, immediately. Each layer is restored literally, so an id that
-- held no shadow before the apply holds none after the revert.
function Cfg.revertGroup()
  local u = Cfg.undo
  if not u then return nil, "nothing applied yet" end
  local b = Cfg.global.features
  if type(b) == "table" then
    for id, was in pairs(u.base) do b[id] = (was ~= NONE) and was or nil end
  end
  for id, was in pairs(u.ovr) do
    local o = Cfg.ovr()
    if was ~= NONE then
      if not o then
        o = {}
        Cfg.place.featureOverrides = o
        Cfg.data.featureOverrides = o
      end
      o[id] = was
    elseif o then
      o[id] = nil
    end
  end
  local o = Cfg.ovr()
  if o and not next(o) then Cfg.place.featureOverrides = nil end
  Cfg.featCount = nil          -- both maps were edited behind setFeat's back
  for _, id in ipairs(u.ids) do
    local v = Cfg.feat(id, nil)
    if v == nil then v = (L.C and L.C._def) and L.C._def[id] or nil end
    if v ~= nil then
      pushLive(id, v)
      if L.C and L.C._live then
        L.C._live[id] = v
        if L.C.notify then L.C.notify(id) end
      end
    end
  end
  Cfg.undo = nil
  schedule()
  return #u.ids, u.group
end

function Cfg.applyShare(code)
  local t, why = Cfg.readShare(code)
  if not t then return nil, why end
  local took, refused = Cfg.applyGroup(t.p, t.f, "pasted code")
  if not took then return nil, refused end
  return took, { group = t.p, refused = refused }
end

-- ------------------------------------------------------------ preset packs
--
-- A pack is a NAMED PARTIAL set under one group -- byte for byte the {p, f}
-- payload a share code carries, so a pack and a code are the same object stored
-- two ways and applyGroup above serves both. combat.fling's 22 knobs get names
-- instead of a second taxonomy: the id prefix IS the group.
--
-- One file per group rather than one file of everything, so a corrupt write
-- costs one group's packs, and the UI only reads the group whose tab is open.

Cfg.PRESET_DIR = "Lumen/presets"

local function presetPath(group)
  if type(group) ~= "string" or group == "" then return nil, "which group?" end
  if group:gsub("[%w_%-%.]", "") ~= "" or group:find("%.%.") then
    return nil, "not a group id"
  end
  return Cfg.PRESET_DIR .. "/" .. group .. ".json"
end

local function readPacks(group)
  local path = presetPath(group)
  if not path then return {} end
  local t = readJson(path)
  return (type(t) == "table") and t or {}
end

local function writePacks(group, packs)
  local path, bad = presetPath(group)
  if not path then return false, bad end
  folders()
  L.try("cfg.presetDir", function()
    if not isfolder(Cfg.PRESET_DIR) then makefolder(Cfg.PRESET_DIR) end
  end)
  if not next(packs) then
    pcall(delfile, path)   -- an emptied group is a state, same as a place layer
    return true
  end
  return writeAtomic("cfg.presets", path, L.Http:JSONEncode(packs)) and true or false
end

function Cfg.presets(group)
  local out = {}
  for name, p in pairs(readPacks(group)) do
    if type(p) == "table" and type(p.f) == "table" then
      local n = 0
      for _ in pairs(p.f) do n = n + 1 end
      out[#out + 1] = { name = name, count = n }
    end
  end
  table.sort(out, function(a, b) return a.name < b.name end)
  return out
end

-- Captures what is LIVE under the group, overlay included -- the same
-- collection shareCode makes, kept under a name instead of encoded.
function Cfg.savePreset(group, name)
  if type(name) ~= "string" or name:gsub("%s", "") == "" then
    return false, "give it a name"
  end
  if name:gsub("[%w_%- ]", "") ~= "" then
    return false, "letters, numbers, spaces, - and _ only"
  end
  local head, pick, n = tostring(group) .. ".", {}, 0
  for id, v in pairs(Cfg.featAll()) do
    if string.sub(id, 1, #head) == head then
      pick[string.sub(id, #head + 1)] = v
      n = n + 1
    end
  end
  if n == 0 then return false, "nothing saved under " .. tostring(group) end
  local packs = readPacks(group)
  packs[name] = { p = group, f = pick }
  local ok, why = writePacks(group, packs)
  if not ok then return false, why or "could not write it" end
  return true, n
end

function Cfg.deletePreset(group, name)
  local packs = readPacks(group)
  if packs[name] == nil then return false, "no pack called " .. tostring(name) end
  packs[name] = nil
  return (writePacks(group, packs)) and true or false
end

-- A PACK IS PARTIAL AND STAYS PARTIAL: it writes the ids it names and touches
-- nothing else. That is the whole difference from loadProfile, which replaces
-- both layers wholesale -- which is why nobody wants a profile as a preset.
function Cfg.applyPreset(group, name)
  local p = readPacks(group)[name]
  if type(p) ~= "table" or type(p.f) ~= "table" then
    return nil, "no pack called " .. tostring(name)
  end
  local took, refused = Cfg.applyGroup(p.p or group, p.f, name)
  if not took then return nil, refused end
  Cfg.appliedPreset = { group = group, name = name }
  return took, refused
end

-- HAS IT DRIFTED -- the same shape of question as Cfg.changedFromDefault, and
-- deliberately the same answer shape, so one list renderer serves both. Second
-- return is the pack's ids with no live value at all.
function Cfg.presetDrift(group, name)
  local out, missing = {}, {}
  local p = readPacks(group)[name]
  if type(p) ~= "table" or type(p.f) ~= "table" then return out, missing end
  local head = tostring(p.p or group) .. "."
  for leaf, want in pairs(p.f) do
    local id = head .. tostring(leaf)
    local cur = Cfg.feat(id, nil)
    if cur == nil then
      missing[#missing + 1] = id
    elseif cur ~= want then
      out[#out + 1] = { id = id, value = cur, want = want }
    end
  end
  table.sort(out, function(a, b) return a.id < b.id end)
  table.sort(missing)
  return out, missing
end

function Cfg.keyCode()
  local name = Cfg.data.toggleKey
  if type(name) ~= "string" then return Enum.KeyCode.RightControl end
  local ok, k = pcall(function() return Enum.KeyCode[name] end)
  return (ok and k) or Enum.KeyCode.RightControl
end

Cfg.load()

end

