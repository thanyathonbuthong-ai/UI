-- ---------------------------------------------------------------- code
-- A monospace block with a Copy button. `opts.code` is the snippet, `opts.text`
-- the title above it.
function C.code(parent, opts)
  opts = opts or {}
  local code = tostring(opts.code or opts.default or "")

  local f = A.surface({
    Parent = parent, elev = 1, radius = T.r.md,
    Size = UDim2.new(1, 0, 0, 0), Name = "Code",
  })
  f.AutomaticSize = Enum.AutomaticSize.Y
  L.pad(10, 12, 12, 12, f)
  L.list(8, nil, f)

  local head = mk("Frame", {
    Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1,
    LayoutOrder = 1, Parent = f,
  })
  A.text({
    Text = opts.text or "Code", font = T.font.medium, size = T.size.label,
    colour = T.c.textDim, Size = UDim2.new(1, -70, 1, 0), truncate = true,
    Parent = head,
  })

  local copyBtn = A.surface({
    Parent = head, elev = 2, radius = T.r.sm, Name = "Copy",
    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
    Size = UDim2.fromOffset(60, 22),
  })
  local copyLbl = A.text({
    Text = "Copy", font = T.font.medium, size = T.size.micro,
    colour = T.c.textDim, align = Enum.TextXAlignment.Center, Parent = copyBtn,
  })

  local body = A.surface({
    Parent = f, elev = 0, radius = T.r.sm, fill = T.c.overlay, Name = "CodeBody",
    Size = UDim2.new(1, 0, 0, 0),
  })
  body.LayoutOrder = 2
  body.AutomaticSize = Enum.AutomaticSize.Y
  L.pad(8, 10, 8, 10, body)
  local codeLbl = A.text({
    Text = code, wrap = true, font = T.font.mono, size = T.size.micro,
    colour = T.c.textDim, valign = Enum.TextYAlignment.Top,
    Size = UDim2.new(1, 0, 0, 0), autoSize = Enum.AutomaticSize.Y,
    tip = false, Parent = body,
  })

  local api = { frame = f }
  local function copy()
    local env = getgenv()
    local fn = env.setclipboard or env.toclipboard or env.set_clipboard
    local ok = fn and pcall(fn, code)
    copyLbl.Text = ok and "Copied" or "No clipboard"
    if L.Toast and L.Toast.info then
      L.Toast.info(tostring(opts.text or "Code"), ok and "Copied to clipboard." or "Clipboard is not available here.")
    end
    task.delay(1.2, function() if copyLbl.Parent then copyLbl.Text = "Copy" end end)
  end
  A.interactive(copyBtn, { radius = T.r.sm, onClick = copy })
  function api:set(text) code = tostring(text or "") codeLbl.Text = code end
  function api:get() return code end
  api.copy = copy
  register(opts, api)
  return api
end

-- ---------------------------------------------------------------- progress
function C.progress(parent, opts)
  opts = opts or {}
  local min, max = tonumber(opts.min) or 0, tonumber(opts.max) or 100
  local value = math.clamp(tonumber(opts.default) or min, min, max)
  local f = row(parent, { text = opts.text, desc = opts.desc, rightRoom = 190 })

  local readout = A.text({
    Text = "", font = T.font.mono, size = T.size.micro, colour = T.c.textDim,
    align = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0.5),
    Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(40, 20),
    ZIndex = 2, tip = false, Parent = f,
  })
  local track = mk("Frame", {
    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -58, 0.5, 0),
    Size = UDim2.fromOffset(110, 6), BackgroundColor3 = T.c.active,
    BorderSizePixel = 0, ZIndex = 2, Parent = f,
  })
  L.corner(999, track)
  local fill = mk("Frame", {
    Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1),
    BorderSizePixel = 0, ZIndex = 3, Parent = track,
  })
  L.corner(999, fill)
  A.accentGradient(fill, 0)

  local api = {}
  local function paint(immediate)
    local p = (max > min) and ((value - min) / (max - min)) or 0
    local setter = immediate and M.set or M.to
    setter(fill, "Size", UDim2.fromScale(p, 1), (not immediate) and "base" or nil)
    readout.Text = string.format("%d%%", math.floor(p * 100 + 0.5))
  end
  function api:set(v) value = math.clamp(tonumber(v) or value, min, max) paint(false) end
  function api:get() return value end
  paint(true)
  api.frame = f
  register(opts, api)
  return api
end

-- ---------------------------------------------------------------- tag
-- A row of small pills. `items` may be strings or { text =, colour = }.
function C.tag(parent, opts)
  opts = opts or {}
  local items = opts.items or { opts.text or "Tag" }
  local holder = mk("Frame", {
    Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1,
    Name = "Tags", Parent = parent,
  })
  local lay = L.list(6, Enum.FillDirection.Horizontal, holder)
  lay.VerticalAlignment = Enum.VerticalAlignment.Center

  for i, item in ipairs(items) do
    if type(item) ~= "table" then item = { text = tostring(item) } end
    local col = typeof(item.colour or item.color) == "Color3" and (item.colour or item.color) or nil
    local label = tostring(item.text or item.Title or "Tag")
    local pill = A.surface({
      Parent = holder, elev = 1, radius = T.r.pill, Name = "Tag", LayoutOrder = i,
      Size = UDim2.fromOffset(20 + #label * 6, 22),
      fill = col, line = col == nil,
    })
    local ink = T.c.textDim
    if col then
      local lum = 0.299 * col.R + 0.587 * col.G + 0.114 * col.B
      ink = lum > 0.55 and Color3.new(0, 0, 0) or Color3.new(1, 1, 1)
    end
    A.text({
      Text = label, font = T.font.medium, size = T.size.micro, colour = ink,
      align = Enum.TextXAlignment.Center, Parent = pill,
    })
  end
  return { frame = holder }
end

-- ---------------------------------------------------------------- colorpicker
local function cpHex(c)
  return string.format("%02X%02X%02X",
    math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

local function cpParse(s)
  s = string.gsub(tostring(s or ""), "[#%s]", "")
  if #s == 6 and string.match(s, "^%x+$") then
    return Color3.fromRGB(tonumber(string.sub(s, 1, 2), 16),
                          tonumber(string.sub(s, 3, 4), 16),
                          tonumber(string.sub(s, 5, 6), 16))
  end
  return nil
end

-- Row with a swatch; clicking opens a popover with a saturation/value square,
-- a hue bar, an optional transparency bar and a hex box. `callback(Color3,
-- transparency)` fires live while dragging and once more on release.
function C.colorpicker(parent, opts)
  opts = opts or {}
  local def = typeof(opts.default) == "Color3" and opts.default or Color3.fromRGB(255, 255, 255)
  local user = opts.callback
  local withAlpha = opts.transparency ~= nil or opts.alpha == true
  local alpha = 1 - math.clamp(tonumber(opts.transparency) or 0, 0, 1)   -- 1 = opaque

  -- Persist as a hex string: bindPersist only understands bool/number/string.
  local popts = {
    text = opts.text, id = opts.id, persist = opts.persist, default = cpHex(def),
    callback = function(hex)
      local c = cpParse(hex)
      if c and user then return user(c, 1 - alpha) end
    end,
  }
  bindPersist(popts)
  local color = cpParse(popts.default) or def
  local h, s, v = color:ToHSV()
  local committed = color

  local f = row(parent, { text = opts.text, desc = opts.desc, rightRoom = 130 })
  local swatch = mk("Frame", {
    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
    Size = UDim2.fromOffset(44, 22), BorderSizePixel = 0, ZIndex = 2, Parent = f,
  })
  swatch.BackgroundColor3 = color
  L.corner(T.r.sm, swatch)
  L.stroke(T.c.lineStrong, 1, 0.3, swatch)
  local hexLbl = A.text({
    Text = "#" .. cpHex(color), font = T.font.mono, size = T.size.micro,
    colour = T.c.textMute, align = Enum.TextXAlignment.Right,
    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -64, 0.5, 0),
    Size = UDim2.fromOffset(60, 20), ZIndex = 2, tip = false, Parent = f,
  })

  local api = {}
  local ui = nil          -- widgets of the open popover; nil while closed

  local function refresh()
    color = Color3.fromHSV(h, s, v)
    swatch.BackgroundColor3 = color
    swatch.BackgroundTransparency = withAlpha and (1 - alpha) or 0
    hexLbl.Text = "#" .. cpHex(color)
    if ui and ui.pop.Parent then
      ui.sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
      ui.svCur.Position = UDim2.fromScale(s, 1 - v)
      ui.hueCur.Position = UDim2.fromScale(h, 0.5)
      if ui.aTint then
        ui.aTint.BackgroundColor3 = color
        ui.aCur.Position = UDim2.fromScale(alpha, 0.5)
      end
      if not ui.hex:IsFocused() then ui.hex.Text = cpHex(color) end
    end
  end

  local function commit()
    if commitValue("colorpicker", popts, cpHex(color)) then
      committed = color
    else
      h, s, v = committed:ToHSV()
      refresh()
    end
  end

  local lastLive = 0
  local function live()
    if not user then return end
    local now = os.clock()
    if now - lastLive < 0.08 then return end
    lastLive = now
    L.try("colorpicker.live:" .. tostring(opts.text or "?"), user, color, 1 - alpha)
  end

  function api:set(c, silent, transparency)
    if type(c) == "string" then c = cpParse(c) end
    if typeof(c) ~= "Color3" then return end
    h, s, v = c:ToHSV()
    if transparency ~= nil then alpha = 1 - math.clamp(transparency, 0, 1) end
    refresh()
    if not silent then commit() end
  end
  function api:get() return color, 1 - alpha end

  -- ONE pair of global listeners per picker (not per open), so re-opening never
  -- adds connections.
  local active = nil      -- { target, onMove } while a drag is in progress
  local function sample()
    if not (active and active.target.Parent) then return end
    local m = L.pointer()
    local a, z = active.target.AbsolutePosition, active.target.AbsoluteSize
    active.onMove(math.clamp((m.X - a.X) / math.max(z.X, 1), 0, 1),
                  math.clamp((m.Y - a.Y) / math.max(z.Y, 1), 0, 1))
  end
  L.hold(L.UIS.InputChanged:Connect(function(i)
    if active and (i.UserInputType == Enum.UserInputType.MouseMovement
                or i.UserInputType == Enum.UserInputType.Touch) then
      sample()
    end
  end))
  L.hold(L.UIS.InputEnded:Connect(function(i)
    if active and (i.UserInputType == Enum.UserInputType.MouseButton1
                or i.UserInputType == Enum.UserInputType.Touch) then
      active = nil
      commit()
    end
  end))

  local function hitFor(target, onMove)
    local btn = mk("TextButton", {
      Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "",
      AutoButtonColor = false, ZIndex = 40, Parent = target,
    })
    btn.InputBegan:Connect(function(i)
      if i.UserInputType == Enum.UserInputType.MouseButton1
      or i.UserInputType == Enum.UserInputType.Touch then
        active = { target = target, onMove = onMove }
        sample()
      end
    end)
  end

  -- geometry of the popover
  local PW, SVH, BAR = 216, 120, 12
  local PH = 10 + SVH + 8 + BAR + (withAlpha and (8 + BAR) or 0) + 8 + 24 + 10
  local open, pop, shadow = false, nil, nil

  local function closePop(instant)
    if not open then return end
    open = false
    local p, sh = pop, shadow
    pop, shadow, ui = nil, nil, nil
    if sh then
      if instant then pcall(function() sh:Destroy() end)
      else
        M.to(sh, "ImageTransparency", 1, "fast")
        task.delay(0.28, function() pcall(function() sh:Destroy() end) end)
      end
    end
    if p then
      if instant then pcall(function() p:Destroy() end)
      else
        M.to(p, "Size", UDim2.fromOffset(p.Size.X.Offset, 0), "fast")
        A.fadeTo(p, 1, "fast")
        task.delay(0.28, function() pcall(function() p:Destroy() end) end)
      end
    end
  end
  api.close = closePop

  local function build()
    local layer = overlayLayer()
    if not layer then return end
    local win = L.Hub.window
    local sc = (win.scaleObj and win.scaleObj.Scale) or 1

    local originAbs = layer.AbsolutePosition
    local fAbs, fSize = f.AbsolutePosition, f.AbsoluteSize
    local x = math.max(4, (fAbs.X + fSize.X - originAbs.X) / sc - PW)
    local yBelow = (fAbs.Y + fSize.Y - originAbs.Y) / sc + 4

    local panelH = win.root.AbsoluteSize.Y / sc
    local top = 8
    local content = win.root:FindFirstChild("Content")
    if content then top = (content.AbsolutePosition.Y - originAbs.Y) / sc + 6 end
    local bottom = panelH - 8
    local flip = (yBelow + PH) > bottom
    local y = flip and ((fAbs.Y - originAbs.Y) / sc - PH - 4) or yBelow
    y = math.clamp(y, top, math.max(top, bottom - PH))

    pop = mk("Frame", {
      Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(PW, 0),
      BackgroundColor3 = T.c.overlay, BorderSizePixel = 0,
      ClipsDescendants = true, ZIndex = 31, Name = "Popover", Parent = layer,
    })
    L.corner(T.r.md, pop)
    L.stroke(T.c.lineStrong, 1, 0.25, pop)

    shadow = A.shadow(nil, { Parent = layer, spread = 22, alpha = 1, ZIndex = 30 })
    if shadow then
      shadow.AnchorPoint = Vector2.new(0, 0)
      shadow.Position = UDim2.fromOffset(x - 22, y - 22 + 6)
      shadow.Size = UDim2.fromOffset(PW + 44, PH + 44)
      M.to(shadow, "ImageTransparency", 0.42, "base")
    end
    M.to(pop, "Size", UDim2.fromOffset(PW, PH), "base")

    -- Picker colours are assigned AFTER creation on purpose: mk registers any
    -- Color3 that equals a theme token for repainting, and a white/black overlay
    -- that got repainted on a theme change would break the picker.
    local W = PW - 20
    local sv = mk("Frame", {
      Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(W, SVH),
      BorderSizePixel = 0, ZIndex = 32, Parent = pop,
    })
    sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
    L.corner(T.r.sm, sv)

    local white = mk("Frame", { Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, ZIndex = 33, Parent = sv })
    white.BackgroundColor3 = Color3.new(1, 1, 1)
    L.corner(T.r.sm, white)
    mk("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = white })

    local black = mk("Frame", { Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, ZIndex = 34, Parent = sv })
    black.BackgroundColor3 = Color3.new(0, 0, 0)
    L.corner(T.r.sm, black)
    mk("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0), Parent = black })

    local svCur = mk("Frame", {
      AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(s, 1 - v),
      Size = UDim2.fromOffset(12, 12), BackgroundTransparency = 1, ZIndex = 36, Parent = sv,
    })
    L.corner(999, svCur)
    L.stroke(T.c.text, 2, 0, svCur).Color = Color3.new(1, 1, 1)

    local function bar(yPos)
      local b = mk("Frame", {
        Position = UDim2.fromOffset(10, yPos), Size = UDim2.fromOffset(W, BAR),
        BorderSizePixel = 0, ZIndex = 32, Parent = pop,
      })
      L.corner(999, b)
      return b
    end
    local function cursor(parentBar, pos)
      local c = mk("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = pos,
        Size = UDim2.fromOffset(6, BAR + 4), BorderSizePixel = 0, ZIndex = 36, Parent = parentBar,
      })
      c.BackgroundColor3 = Color3.new(1, 1, 1)
      L.corner(3, c)
      L.stroke(T.c.text, 1, 0.5, c).Color = Color3.new(0, 0, 0)
      return c
    end

    local yHue = 10 + SVH + 8
    local hueBar = bar(yHue)
    hueBar.BackgroundColor3 = Color3.new(1, 1, 1)
    local keys = {}
    for i = 0, 6 do
      keys[#keys + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(math.min(i / 6, 0.9999), 1, 1))
    end
    mk("UIGradient", { Color = ColorSequence.new(keys), Parent = hueBar })
    local hueCur = cursor(hueBar, UDim2.fromScale(h, 0.5))

    local aTint, aCur
    local yNext = yHue + BAR + 8
    if withAlpha then
      local aBar = bar(yNext)
      aBar.BackgroundColor3 = T.c.active
      aTint = mk("Frame", { Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, ZIndex = 33, Parent = aBar })
      aTint.BackgroundColor3 = color
      L.corner(999, aTint)
      mk("UIGradient", { Transparency = NumberSequence.new(1, 0), Parent = aTint })
      aCur = cursor(aBar, UDim2.fromScale(alpha, 0.5))
      hitFor(aBar, function(px) alpha = px refresh() live() end)
      yNext = yNext + BAR + 8
    end

    local hex = mk("TextBox", {
      Position = UDim2.fromOffset(10, yNext), Size = UDim2.fromOffset(W, 24),
      BackgroundColor3 = T.c.raised, BorderSizePixel = 0,
      Text = cpHex(color), PlaceholderText = "RRGGBB",
      PlaceholderColor3 = T.c.textOff, TextColor3 = T.c.text,
      Font = T.font.mono, TextSize = T.size.micro,
      TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
      ZIndex = 32, Parent = pop,
    })
    L.corner(T.r.sm, hex)
    L.pad(0, 8, 0, 8, hex)
    hex.FocusLost:Connect(function()
      local c = cpParse(hex.Text)
      if c then api:set(c) else hex.Text = cpHex(color) end
    end)

    hitFor(sv, function(px, py) s = px v = 1 - py refresh() live() end)
    hitFor(hueBar, function(px) h = math.min(px, 0.9999) refresh() live() end)

    ui = { pop = pop, sv = sv, svCur = svCur, hueCur = hueCur, aTint = aTint, aCur = aCur, hex = hex }
  end

  local function openPop()
    if open then return end
    C.closePopovers(true)
    open = true
    build()
    if not pop then open = false end
  end
  api.open = openPop
  api.toggle = function() if open then closePop() else openPop() end end
  api.isOpen = function() return open end
  C._pops[#C._pops + 1] = { frame = f, close = closePop }

  L.hold(L.UIS.InputBegan:Connect(function(i, typing)
    if not open then return end
    if i.KeyCode == Enum.KeyCode.Escape then closePop() return end
    if typing then return end
    if i.UserInputType == Enum.UserInputType.MouseButton1
    or i.UserInputType == Enum.UserInputType.Touch then
      local m = L.pointer()
      local function inside(g)
        if not g then return false end
        local a, z = g.AbsolutePosition, g.AbsoluteSize
        return m.X >= a.X and m.X <= a.X + z.X and m.Y >= a.Y and m.Y <= a.Y + z.Y
      end
      if not inside(f) and not inside(pop) then closePop() end
    end
  end))

  A.interactive(f, { radius = T.r.md, onClick = function() api.toggle() end })
  focusable(f, {
    radius = T.r.md, label = opts.text,
    activate = function() api.toggle() end,
  })
  refresh()
  api.frame = f
  register(opts, api)
  return api
end

-- ============================================================================
-- WINDUI PARITY II
-- What was still missing next to WindUI: Image, Section (collapsible, boxed),
-- Group (elements side by side), rich Paragraph (image + buttons), Dialog and
-- Popup.  Same scaffolding as the controls above, so they inherit the theme,
-- spacing and the disabled veil.
-- ============================================================================

-- ---------------------------------------------------------------- image
function C.image(parent, opts)
  opts = opts or {}
  local f = A.surface({
    Parent = parent, elev = 1, radius = T.r.md, clip = true,
    Size = UDim2.new(1, 0, 0, opts.height or 140), Name = "Image",
  })
  local okScale, scale = pcall(function() return Enum.ScaleType[opts.scale or "Crop"] end)
  local img = mk("ImageLabel", {
    Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
    Image = tostring(opts.image or opts.default or ""),
    ScaleType = okScale and scale or Enum.ScaleType.Crop,
    ZIndex = 2, Parent = f,
  })
  if opts.text and opts.text ~= "" then
    local bar = mk("Frame", {
      AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1),
      Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = Color3.new(0, 0, 0),
      BackgroundTransparency = 0.45, BorderSizePixel = 0, ZIndex = 3, Parent = f,
    })
    A.text({
      Text = opts.text, font = T.font.medium, size = T.size.label,
      colour = Color3.new(1, 1, 1), Position = UDim2.fromOffset(10, 0),
      Size = UDim2.new(1, -20, 1, 0), truncate = true, ZIndex = 4, Parent = bar,
    })
  end
  local api = { frame = f }
  function api:set(v) img.Image = tostring(v or "") end
  function api:get() return img.Image end
  register(opts, api)
  return api
end

-- ---------------------------------------------------------------- group
-- Elements side by side. Each child gets an equal share of the width; the group
-- is as tall as its tallest member.
function C.group(parent, opts)
  opts = opts or {}
  local holder = mk("Frame", {
    Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
    BackgroundTransparency = 1, Name = "Group", Parent = parent,
  })
  local gap = T.gap.sm
  local lay = L.list(gap, Enum.FillDirection.Horizontal, holder)
  lay.VerticalAlignment = Enum.VerticalAlignment.Top
  local api = { frame = holder, body = holder }
  function api:rebalance()
    local kids = {}
    for _, c in ipairs(holder:GetChildren()) do
      if c:IsA("GuiObject") then kids[#kids + 1] = c end
    end
    local n = #kids
    if n == 0 then return end
    for i, c in ipairs(kids) do
      c.LayoutOrder = i
      c.Size = UDim2.new(1 / n, -gap * (n - 1) / n, c.Size.Y.Scale, c.Size.Y.Offset)
    end
  end
  return api
end

-- ---------------------------------------------------------------- fold
-- WindUI's Section: a titled container that can be boxed and collapsed. The
-- returned `body` is what elements are parented to.
function C.fold(parent, opts)
  opts = opts or {}
  C._section = tostring(opts.text or "")       -- keeps saved ids stable underneath
  local open = opts.opened ~= false
  local holder = mk("Frame", {
    Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
    BackgroundTransparency = 1, Name = "Fold", Parent = parent,
  })
  L.list(T.gap.sm, nil, holder)

  local hasDesc = opts.desc and opts.desc ~= ""
  local head = A.surface({
    Parent = holder, elev = 1, radius = T.r.md, sheen = true,
    Size = UDim2.new(1, 0, 0, hasDesc and 46 or ROWH()), Name = "FoldHead",
    LayoutOrder = 1,
  })
  A.text({
    Text = opts.text or "", font = T.font.strong, size = T.size.body, colour = T.c.text,
    Position = UDim2.fromOffset(12, hasDesc and 7 or 0),
    Size = hasDesc and UDim2.new(1, -44, 0, 15) or UDim2.new(1, -44, 1, 0),
    truncate = true, Parent = head,
  })
  if hasDesc then
    A.text({
      Text = opts.desc, font = T.font.body, size = T.size.micro, colour = T.c.textMute,
      Position = UDim2.fromOffset(12, 23), Size = UDim2.new(1, -44, 0, 13),
      truncate = true, Parent = head,
    })
  end
  local _, chevInner = A.Icon.chevron(head, 14, T.c.textMute, "down")
  local chev = chevInner.Parent
  chev.AnchorPoint = Vector2.new(1, 0.5)
  chev.Position = UDim2.new(1, -14, 0.5, 0)
  chev.ZIndex = 2
  chevInner.Rotation = open and 180 or 0

  local body
  if opts.box ~= false then
    body = A.surface({
      Parent = holder, elev = 0, radius = T.r.md, Size = UDim2.new(1, 0, 0, 0),
      Name = "FoldBody", LayoutOrder = 2, line = opts.boxBorder ~= false,
    })
    L.pad(8, 8, 8, 8, body)
  else
    body = mk("Frame", {
      Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1,
      Name = "FoldBody", LayoutOrder = 2, Parent = holder,
    })
  end
  body.AutomaticSize = Enum.AutomaticSize.Y
  L.list(T.gap.sm, nil, body)
  body.Visible = open

  local api = { frame = holder, body = body, head = head }
  function api:set(v)
    open = v and true or false
    body.Visible = open
    M.to(chevInner, "Rotation", open and 180 or 0, "base")
  end
  function api:get() return open end
  function api:toggle() api:set(not open) end
  A.interactive(head, { radius = T.r.md, onClick = function() api:toggle() end })
  focusable(head, {
    radius = T.r.md, label = opts.text, activate = function() api:toggle() end,
  })
  return api
end

-- ---------------------------------------------------------------- card
-- WindUI Paragraph with an image and/or buttons under the text.
function C.card(parent, opts)
  opts = opts or {}
  local f = A.surface({
    Parent = parent, elev = 1, radius = T.r.md,
    Size = UDim2.new(1, 0, 0, 0), Name = "Paragraph",
  })
  f.AutomaticSize = Enum.AutomaticSize.Y
  L.pad(12, 12, 12, 12, f)
  L.list(8, nil, f)

  local hasTitle = opts.text and opts.text ~= ""
  if hasTitle or opts.image then
    local isz = tonumber(opts.imageSize) or 20
    local top = mk("Frame", {
      Size = UDim2.new(1, 0, 0, math.max(isz, 18)), BackgroundTransparency = 1,
      LayoutOrder = 1, Name = "Top", Parent = f,
    })
    local x = 0
    if opts.image and opts.image ~= "" then
      mk("ImageLabel", {
        Size = UDim2.fromOffset(isz, isz), BackgroundTransparency = 1,
        Image = tostring(opts.image), ImageColor3 = opts.color or T.c.text,
        Parent = top,
      })
      x = isz + 8
    end
    A.text({
      Text = opts.text or "", font = T.font.strong, size = T.size.body,
      colour = opts.color or T.c.text, Position = UDim2.fromOffset(x, 0),
      Size = UDim2.new(1, -x, 1, 0), truncate = true, Parent = top,
    })
  end
  if opts.desc and opts.desc ~= "" then
    A.text({
      Text = opts.desc, wrap = true, LayoutOrder = 2,
      font = T.font.body, size = T.size.label, colour = T.c.textDim,
      valign = Enum.TextYAlignment.Top,
      Size = UDim2.new(1, 0, 0, 0), autoSize = Enum.AutomaticSize.Y, Parent = f,
    })
  end
  local api = { frame = f }
  if type(opts.buttons) == "table" and #opts.buttons > 0 then
    local acts = C.actions(f, opts.buttons)
    acts.frame.LayoutOrder = 3
  end
  return api
end

-- ---------------------------------------------------------------- dialog
-- WindUI Window:Dialog / WindUI:Popup. A scrim over the whole window and a
-- centred card. Lives on the window root, not the popover overlay, because the
-- overlay is wiped on every tab change.
local Dialog = { _cur = nil }
L.Dialog = Dialog

function Dialog.close()
  local cur = Dialog._cur
  Dialog._cur = nil
  if not cur then return end
  M.to(cur.scrim, "BackgroundTransparency", 1, "fast")
  M.to(cur.card, "Position", UDim2.new(0.5, 0, 0.5, 12), "fast")
  A.fadeTo(cur.card, 1, "fast")
  task.delay(0.24, function() pcall(function() cur.scrim:Destroy() end) end)
end

function Dialog.show(opts)
  opts = opts or {}
  local w = L.Hub and L.Hub.window
  local root = w and w.root
  if not root then return nil end
  if Dialog._cur then
    pcall(function() Dialog._cur.scrim:Destroy() end)
    Dialog._cur = nil
  end

  local scrim = mk("TextButton", {
    Name = "Dialog", Text = "", AutoButtonColor = false, Active = true,
    Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
    BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 60, Parent = root,
  })
  L.corner(T.r.lg, scrim)
  M.to(scrim, "BackgroundTransparency", 0.42, "base")

  local card = A.surface({
    Parent = scrim, elev = 2, radius = T.r.lg, Name = "Card",
    Size = UDim2.fromOffset(opts.width or 340, 0),
    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 12),
  })
  card.AutomaticSize = Enum.AutomaticSize.Y
  card.ZIndex = 61
  card.Active = true                 -- sink clicks so the card does not count as the scrim
  L.pad(16, 16, 16, 16, card)
  L.list(10, nil, card)
  M.to(card, "Position", UDim2.fromScale(0.5, 0.5), "base")

  local top = mk("Frame", {
    Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, LayoutOrder = 1, Parent = card,
  })
  local x = 0
  if opts.image and opts.image ~= "" then
    mk("ImageLabel", {
      Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 1,
      Image = tostring(opts.image), Parent = top,
    })
    x = 28
  end
  A.text({
    Text = tostring(opts.text or "Dialog"), font = T.font.strong, size = T.size.title,
    Position = UDim2.fromOffset(x, 0), Size = UDim2.new(1, -x, 1, 0),
    truncate = true, Parent = top,
  })
  if opts.desc and opts.desc ~= "" then
    A.text({
      Text = tostring(opts.desc), wrap = true, LayoutOrder = 2,
      font = T.font.body, size = T.size.label, colour = T.c.textDim,
      valign = Enum.TextYAlignment.Top,
      Size = UDim2.new(1, 0, 0, 0), autoSize = Enum.AutomaticSize.Y, Parent = card,
    })
  end

  local handle = {}
  function handle:close() if Dialog._cur and Dialog._cur.scrim == scrim then Dialog.close() end end

  local buttons = opts.buttons
  if type(buttons) ~= "table" or #buttons == 0 then
    buttons = { { text = "OK", primary = true } }
  end
  local rowF = mk("Frame", {
    Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, LayoutOrder = 3, Parent = card,
  })
  local lay = L.list(T.gap.sm, Enum.FillDirection.Horizontal, rowF)
  lay.HorizontalAlignment = Enum.HorizontalAlignment.Right
  lay.VerticalAlignment = Enum.VerticalAlignment.Center
  for i, b in ipairs(buttons) do
    local label = tostring(b.text or "OK")
    local primary = b.primary or false
    local pill = A.surface({
      Parent = rowF, elev = 1, radius = T.r.pill, LayoutOrder = i, Name = "DialogButton",
      Size = UDim2.fromOffset(28 + #label * 7, 32),
      fill = primary and T.c.accent or nil, line = not primary,
    })
    if primary then A.accentGradient(pill, 100) end
    A.text({
      Text = label, font = T.font.medium, size = T.size.label,
      colour = primary and T.c.accentInk or T.c.textDim,
      align = Enum.TextXAlignment.Center, Parent = pill,
    })
    A.interactive(pill, {
      radius = T.r.pill,
      layerColour = primary and Color3.new(0, 0, 0) or Color3.new(1, 1, 1),
      hoverAlpha = primary and 0.9 or 0.95, pressAlpha = primary and 0.8 or 0.9,
      onClick = function()
        handle:close()
        if b.callback then L.try("dialog.button", b.callback) end
      end,
    })
  end

  -- a click on the scrim (outside the card) or Escape dismisses, unless told not to
  if opts.dismissable ~= false then
    scrim.Activated:Connect(function() handle:close() end)
    L.hold(L.UIS.InputBegan:Connect(function(i)
      if i.KeyCode == Enum.KeyCode.Escape and Dialog._cur and Dialog._cur.scrim == scrim then
        Dialog.close()
      end
    end))
  end
  Dialog._cur = { scrim = scrim, card = card }
  return handle
end
L.Popup = Dialog
L.cleanup(function() Dialog._cur = nil end)

end

do -- ==== lm_20_binds.lua ====
-- LUMEN :: KEYBINDS
-- Bind any feature to a key, so the common ones never need the window open.
--
-- One listener for every bind, not one per feature. A bind is refused while text
-- is being typed, while the palette is up, and while a keybind chip is recording.

local L = getgenv().LUMEN

local B = {}
L.Binds = B

B.actions = {}      -- ordered list of { name, label, run, get }
B.byName = {}
B.map = {}          -- name -> KeyCode
B.capturing = false -- set by the keybind control while it listens

-- run: fn(newState) toggles the feature. get: fn() -> state, so a bind can flip.
function B.register(name, label, run, get)
  if B.byName[name] then
    B.byName[name].run, B.byName[name].get = run, get
    B.byName[name].label = label
    return B.byName[name]
  end
  local a = { name = name, label = label, run = run, get = get }
  B.actions[#B.actions + 1] = a
  B.byName[name] = a
  return a
end

function B.keyFor(name) return B.map[name] end

-- Returns the name of whatever else already owns this key, so the caller can warn
-- instead of creating a shortcut that fires two things at once.
function B.conflict(name, key)
  if not key then return nil end
  for other, k in pairs(B.map) do
    if other ~= name and k == key then return other end
  end
  return nil
end

function B.set(name, key)
  B.map[name] = key
  local out = {}
  for n, k in pairs(B.map) do out[n] = k.Name end
  if L.Cfg then L.Cfg.set("binds", out) end
  return true
end

-- Restore from config. Names that no longer exist are dropped, not kept as dead
-- entries: features get renamed, and a bind to nothing is a key silently lost.
function B.load()
  local saved = L.Cfg and L.Cfg.data.binds
  if type(saved) ~= "table" then return end
  for name, keyName in pairs(saved) do
    if type(keyName) == "string" and B.byName[name] then
      local ok, k = pcall(function() return Enum.KeyCode[keyName] end)
      if ok and k then B.map[name] = k end
    end
  end
end

local function blocked()
  if not L.live() then return true end
  if B.capturing then return true end
  if L.Palette and L.Palette.open then return true end
  if L.UIS:GetFocusedTextBox() then return true end
  return false
end

L.hold(L.UIS.InputBegan:Connect(function(input, typing)
  if typing or blocked() then return end
  if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
  for _, a in ipairs(B.actions) do
    if B.map[a.name] == input.KeyCode then
      -- Not `a.get and (not a.get()) or true`: the and/or idiom cannot carry a
      -- false value, so that form is always true and could only switch things on.
      local now = true
      if a.get then now = not a.get() end
      local ran, ok, why = L.try("bind:" .. a.name, a.run, now)
      -- the window may be closed, so the toast is the feedback
      if L.Toast and L.Cfg and L.Cfg.data.notify ~= false then
        if ran and ok ~= false then
          L.Toast.info(a.label, now and "on" or "off")
        else
          L.Toast.warn(a.label, tostring(why or "did not engage"))
        end
      end
      L.note("bind", a.label .. " -> " .. (now and "on" or "off"))
    end
  end
end))

end

do -- ==== lm_29_pins.lua ====
-- LUMEN :: PINS
-- Favourite features, reachable from the minimised pill.
--
-- The hub is eight tabs deep. Half of what anyone actually uses is three or
-- four switches and a couple of buttons, and hunting for them through the nav
-- every time is the tax you pay for having a big interface. DEV HUD solves this
-- with a quick strip; this is the same idea wired into LUMEN's dock.
--
-- WHAT MAKES IT WORK IS THAT CONTROLS REGISTER THEMSELVES. A pin is not a
-- second implementation of a feature -- it is a handle on the control that
-- already exists, so a pinned toggle and its switch in the tab are the same
-- object and can never disagree. Controls hand us their api at construction;
-- the strip only ever calls back into it.
--
-- The strip is parented to the dock, so it inherits the dock's position and
-- every minimise/restore animation for free rather than needing a second clock
-- to chase it with.

local L = getgenv().LUMEN
local T, M, A = L.T, L.Motion, L.A
local mk = L.mk

local P = {}
L.Pins = P

P.registry = {}      -- id -> { id, label, kind, get, set, run, ctx }
P.order = {}         -- registration order, so the manager lists them sensibly

local CHIP_W, CHIP_H, GAP = 34, 26, 5
P.HOLD = 0.5      -- seconds of press before a chip unpins itself

-- ---------------------------------------------------------------- registry

-- kind: "toggle" needs get+set; "action" needs run.
function P.register(id, spec)
  if type(id) ~= "string" or id == "" or type(spec) ~= "table" then return end
  if not P.registry[id] then P.order[#P.order + 1] = id end
  spec.id = id
  spec.label = spec.label or id
  P.registry[id] = spec
  -- A pin saved from a previous session only becomes real when the control that
  -- owns it is built, which is why the strip refreshes on registration.
  --
  -- WRAPPED, BECAUSE THIS RUNS INSIDE TAB CONSTRUCTION. Registration happens
  -- while a page is being built, so anything that throws in here escapes into
  -- the middle of a builder. That is not hypothetical: a call to a helper that
  -- did not exist took out the Universal page and, with it, every tab after it.
  -- The strip is decoration; it must never be able to cost somebody their hub.
  if L.Cfg and L.Cfg.pinned and L.Cfg.pinned(id) then
    L.try("pins.refresh", P.refresh)
  end
end

function P.forget(id)
  P.registry[id] = nil
end

-- Everything currently registered, for the manager list in Interface.
function P.list()
  local out = {}
  for _, id in ipairs(P.order) do
    local s = P.registry[id]
    if s then out[#out + 1] = s end
  end
  return out
end

-- A short, readable chip label. "combat.fling.Launch power" -> "Launch power",
-- then trimmed to something that fits 34px without becoming an initialism
-- nobody can read.
-- A LABEL THAT DISTINGUISHES, not merely one that fits.
--
-- Truncating to the first five characters produced a dock reading
-- "Fly / Open / Anti- / Nocli / Anti- / Infin / Open" -- two "Anti-" and two
-- "Open", so the strip told you how many things were pinned and nothing about
-- which. A quick-access bar whose buttons cannot be told apart is worse than no
-- quick-access bar.
--
-- Multi-word names become initials, which stays unique where truncation
-- collides: "Anti-fling" and "Anti-AFK" are AF and AA, "Open player panel" is
-- OPP. Single words keep their letters. Anything still colliding gets a digit,
-- because two identical chips is the one outcome worth avoiding outright.
local function baseLabel(spec)
  local label = tostring(spec.short or spec.label or spec.id)
  label = label:gsub("^.*%.", "")                     -- drop the id prefix
  local words = {}
  for w in label:gmatch("[%a%d]+") do words[#words + 1] = w end
  if #words >= 2 then
    local ini = ""
    for i = 1, math.min(#words, 3) do ini = ini .. words[i]:sub(1, 1):upper() end
    return ini
  end
  local one = words[1] or label
  return (#one > 5) and one:sub(1, 5) or one
end

local function chipLabels(specs)
  local seen, out = {}, {}
  for i, spec in ipairs(specs) do
    local base = baseLabel(spec)
    local text, n = base, 1
    while seen[text] do
      n = n + 1
      text = base .. n
    end
    seen[text] = true
    out[i] = text
  end
  return out
end

-- ---------------------------------------------------------------- the strip

function P.attach(dock)
  if not dock then return end
  -- A CanvasGroup makes the whole quick strip one visual unit during the dock
  -- morph. The window animates GroupTransparency once, so chip plates, labels,
  -- dots and strokes cannot reveal on four slightly different spring clocks.
  P.bar = mk("CanvasGroup", {
    AnchorPoint = Vector2.new(0, 0),
    -- a child of the dock, so it rides every minimise and restore without a
    -- second animation chasing the first
    Position = UDim2.new(1, 8, 0, 5),
    Size = UDim2.fromOffset(0, CHIP_H),
    BackgroundTransparency = 1, GroupTransparency = 0, BorderSizePixel = 0,
    ZIndex = 6, Name = "PinBar", Parent = dock,
  })
  -- SECOND BAR, GROWING LEFT. A strip that only ever extends right walks off
  -- the screen once more than a handful are pinned, and the pill is rarely
  -- against the left edge -- so half the available space went unused. Anchored
  -- at the dock's left edge with AnchorPoint 1 on X, it grows away from the
  -- dock in the opposite direction.
  --
  -- A SEPARATE CanvasGroup, not negative offsets inside the first: a CanvasGroup
  -- renders its children into a buffer its own size, so a chip placed at a
  -- negative X inside the right-hand bar would simply be clipped away.
  P.barL = mk("CanvasGroup", {
    AnchorPoint = Vector2.new(1, 0),
    Position = UDim2.new(0, -8, 0, 5),
    Size = UDim2.fromOffset(0, CHIP_H),
    BackgroundTransparency = 1, GroupTransparency = 0, BorderSizePixel = 0,
    ZIndex = 6, Name = "PinBarLeft", Parent = dock,
  })
  P.bars = { P.bar, P.barL }
  P.dock = dock
  P.refresh()
  return P.bar
end

local function paintChip(chip, spec)
  if spec.kind ~= "toggle" or not spec.get then return end
  local on = false
  pcall(function() on = spec.get() and true or false end)
  M.to(chip.dot, "BackgroundColor3", on and T.c.accent or T.c.textOff, "fast")
  M.to(chip.dot, "BackgroundTransparency", on and 0 or 0.45, "fast")
  M.to(chip.lbl, "TextColor3", on and T.c.text or T.c.textDim, "fast")
  M.to(chip.stroke, "Color", on and T.c.accent or T.c.lineStrong, "fast")
  M.to(chip.stroke, "Transparency", on and 0.25 or 0.55, "fast")
end

function P.refresh()
  if not (P.bar and P.bar.Parent) then return end
  for _, bar in ipairs(P.bars or { P.bar }) do
    for _, c in ipairs(bar:GetChildren()) do
      if c:IsA("GuiObject") then c:Destroy() end
    end
  end
  P.chips = {}

  local ids = (L.Cfg and L.Cfg.pins and L.Cfg.pins()) or {}
  -- resolve every spec up front: the labels are chosen as a SET so two chips
  -- can never end up saying the same thing
  local specs = {}
  for _, id in ipairs(ids) do
    if P.registry[id] then specs[#specs + 1] = P.registry[id] end
  end
  local labels = chipLabels(specs)

  -- HOW MANY FIT BEFORE THE EDGE, measured rather than guessed at. The pill sits
  -- wherever it was last dragged, so the room to its right is not a constant.
  local vpx = (L.viewport and L.viewport().X) or 1920
  local dockRight = 0
  pcall(function()
    dockRight = P.dock.AbsolutePosition.X + P.dock.AbsoluteSize.X
  end)
  local roomRight = math.max(0, vpx - dockRight - 24)
  local perRight = math.max(1, math.floor(roomRight / (CHIP_W + GAP)))

  -- NEAREST SIDE FIRST, AND STABLE. Chips fill the right until it is full and
  -- then continue on the left, so adding a pin only ever APPENDS. A rule that
  -- balanced the two sides evenly would instead reshuffle chips across the dock
  -- every time the count changed, and a control that moves when you add a
  -- different one is worse than a control in an awkward place.
  local nR, nL = 0, 0
  for si, spec in ipairs(specs) do
    local id = spec.id
    do
      local onRight = nR < perRight
      local slot = onRight and nR or nL
      local parentBar = onRight and P.bar or P.barL
      local f = mk("Frame", {
        Position = UDim2.fromOffset(slot * (CHIP_W + GAP), 0),
        Size = UDim2.fromOffset(CHIP_W, CHIP_H),
        BackgroundColor3 = T.c.raised, BackgroundTransparency = 0.15,
        BorderSizePixel = 0, ZIndex = 6, Name = "Pin", Parent = parentBar,
      })
      L.corner(T.r.sm, f)
      local stroke = L.stroke(T.c.lineStrong, 1, 0.55, f)

      -- a state dot for toggles, so the strip reports as well as commands
      local dot = mk("Frame", {
        AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0, 4), Size = UDim2.fromOffset(4, 4),
        BackgroundColor3 = T.c.textOff, BackgroundTransparency = 0.45,
        BorderSizePixel = 0, ZIndex = 7, Parent = f,
      })
      L.corner(999, dot)

      local lbl = A.text({
        Text = labels[si], font = T.font.medium, size = T.size.nano,
        colour = T.c.textDim, align = Enum.TextXAlignment.Center,
        Position = UDim2.fromOffset(0, 10), Size = UDim2.new(1, 0, 0, 12),
        ZIndex = 7, Parent = f,
      })

      local chip = { frame = f, dot = dot, lbl = lbl, stroke = stroke, spec = spec }
      P.chips[#P.chips + 1] = chip

      -- HOLD TO UNPIN, WITH THE HOLD MADE VISIBLE. A press that appears to do
      -- nothing for half a second reads as a dead control, so the fill is the
      -- affordance: it says something is happening and how much longer it wants.
      local fill = mk("Frame", {
        Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = T.c.accent,
        BackgroundTransparency = 0.55, BorderSizePixel = 0,
        ZIndex = 6, Name = "Hold", Parent = f,
      })
      L.corner(T.r.sm, fill)
      chip.fill = fill
      local holdConn, holdStart
      local function endHold(done)
        if holdConn then holdConn:Disconnect() holdConn = nil end
        holdStart = nil
        if fill.Parent then
          if done then M.set(fill, "Size", UDim2.new(0, 0, 1, 0))
          else M.to(fill, "Size", UDim2.new(0, 0, 1, 0), "fast") end
        end
      end
      f.InputBegan:Connect(function(i)
        if i.UserInputType ~= Enum.UserInputType.MouseButton1 and i.UserInputType ~= Enum.UserInputType.Touch then return end
        holdStart = os.clock()
        chip.heldFired = false
        if holdConn then holdConn:Disconnect() end
        holdConn = L.RunService.RenderStepped:Connect(function()
          if not (holdStart and fill.Parent) then return end
          local prog = math.clamp((os.clock() - holdStart) / P.HOLD, 0, 1)
          fill.Size = UDim2.new(prog, 0, 1, 0)
          if prog >= 1 then
            chip.heldFired = true
            endHold(true)
            if L.Cfg and L.Cfg.setPin then L.Cfg.setPin(id, false) end
            if L.Toast then L.Toast.info("Unpinned", spec.label) end
            P.refresh()
          end
        end)
      end)
      f.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then endHold(false) end
      end)
      f.MouseLeave:Connect(function() endHold(false) end)

      A.interactive(f, { radius = T.r.sm, spotSize = 40, onClick = function()
        -- a completed hold has already acted; releasing after it must not also
        -- toggle the feature it just unpinned
        if chip.heldFired then chip.heldFired = false return end
        if spec.kind == "action" then
          if spec.run then L.try("pin.run", spec.run) end
          return
        end
        if not (spec.get and spec.set) then return end
        local now = false
        pcall(function() now = spec.get() and true or false end)
        L.try("pin.set", spec.set, not now)
        paintChip(chip, spec)
      end })

      A.explain(f, spec.label .. (spec.kind == "toggle"
        and "  -- click to switch it on or off, hold to unpin"
        or "  -- click to run it, hold to unpin"))
      paintChip(chip, spec)
      if onRight then nR = nR + 1 else nL = nL + 1 end
    end
  end

  local function span(k) return math.max(0, k * (CHIP_W + GAP) - GAP) end
  P.bar.Size = UDim2.fromOffset(span(nR), CHIP_H)
  P.bar.Visible = nR > 0
  if P.barL then
    P.barL.Size = UDim2.fromOffset(span(nL), CHIP_H)
    P.barL.Visible = nL > 0
  end
  P.lastSplit = { right = nR, left = nL, perRight = perRight }
end

-- The strip reports live state, so a feature switched off from its tab (or by a
-- keybind, or by the watchdog) must not leave a lit chip behind. Polled rather
-- than subscribed: there is no change signal on a plain Lua flag, and six chips
-- at 4Hz is nothing.
task.spawn(function()
  while true do
    task.wait(0.25)
    if L.live() and P.chips and P.bar and P.bar.Parent and P.bar.Visible then
      for _, c in ipairs(P.chips) do paintChip(c, c.spec) end
    end
  end
end)

end

do -- ==== lm_07_toast.lua ====
-- LUMEN :: TOAST
-- Notifications, bottom-right, four visible at once and the rest queued.
-- Repeats of the same message collapse into a count rather than stacking, and
-- the stack springs into gaps instead of relaying out.
-- The card is a CanvasGroup so its whole subtree fades as one image; fading
-- label by label reads as several things appearing separately.

local L = getgenv().LUMEN
local T, M, A = L.T, L.Motion, L.A
local mk = L.mk

local Toast = {}
L.Toast = Toast

local W, GAP, MARGIN = 364, 10, 20
local RISE  = 22      -- how far below its resting place a toast starts
local SMALL = 0.90    -- and how far under full size
-- read live, so changing it in Interface takes effect on the next toast
local function MAX_VISIBLE()
  return math.floor((L.Cfg and tonumber(L.Cfg.data.toastMax)) or 4)
end

local live, queue = {}, {}
local departing = 0

-- ---------------------------------------------------------------- easing
-- A curve, not a spring: duration 0.4s, cubic-bezier(0.25, 0.46, 0.45, 0.94).
-- TweenService has no arbitrary bezier, so the curve is solved directly (Newton
-- on X for the parameter, then read Y) and driven per frame.
local EASE = { 0.25, 0.46, 0.45, 0.94 }

local function bezier(t)
  if t <= 0 then return 0 end
  if t >= 1 then return 1 end
  local x1, y1, x2, y2 = EASE[1], EASE[2], EASE[3], EASE[4]
  local u = t
  for _ = 1, 5 do
    local mu = 1 - u
    local x = 3 * mu * mu * u * x1 + 3 * mu * u * u * x2 + u * u * u
    local dx = 3 * mu * mu * x1 + 6 * mu * u * (x2 - x1) + 3 * u * u * (1 - x2)
    if math.abs(dx) < 1e-6 then break end
    u = u - (x - t) / dx
  end
  local mu = 1 - u
  return 3 * mu * mu * u * y1 + 3 * mu * u * u * y2 + u * u * u
end

-- One driver per (object, property). Re-targeting mid-flight restarts from where
-- it is, so a toast still sliding when the stack shifts does not jump.
-- Keyed on the instance, not tostring(it): tostring(Instance) returns its Name
-- and every wrapper is called "Toast", so string keys collapse onto one entry.
local drives = setmetatable({}, { __mode = "k" })
local function easeTo(obj, prop, target, dur, onDone)
  if not obj then return end
  local perObj = drives[obj]
  if not perObj then perObj = {} drives[obj] = perObj end
  local d = perObj[prop]
  if d then d.dead = true end
  local from = L.uiRead(obj,prop)
  local t0 = os.clock()
  dur = dur or 0.4
  local rec = { dead = false }
  perObj[prop] = rec
  task.spawn(function()
    while not rec.dead do
      if not obj.Parent then
        if perObj[prop] == rec then perObj[prop] = nil end
        return
      end
      local a = math.clamp((os.clock() - t0) / dur, 0, 1)
      local e = bezier(a)
      if typeof(from) == "UDim2" then
        obj[prop] = UDim2.new(
          from.X.Scale + (target.X.Scale - from.X.Scale) * e,
          from.X.Offset + (target.X.Offset - from.X.Offset) * e,
          from.Y.Scale + (target.Y.Scale - from.Y.Scale) * e,
          from.Y.Offset + (target.Y.Offset - from.Y.Offset) * e)
      else
        L.uiWrite(obj,prop,from + (target - from) * e)
      end
      if a >= 1 then
        -- only clear our OWN row: a newer drive may already own this slot
        if perObj[prop] == rec then perObj[prop] = nil end
        if onDone then L.try("toast.done", onDone) end
        return
      end
      L.RunService.Heartbeat:Wait()
    end
  end)
end


local KIND = {
  info = { colour = T.c.accent, icon = "dot" },
  ok   = { colour = T.c.ok,     icon = "check" },
  warn = { colour = T.c.warn,   icon = "bars" },
  bad  = { colour = T.c.bad,    icon = "close" },
}

local function ensureHost()
  if Toast.gui and Toast.gui.Parent then return Toast.gui end
  local gui = mk("ScreenGui", {
    Name = "GiorgioNotices", ResetOnSpawn = false, IgnoreGuiInset = true,
    ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 20,
  })
  gui.Parent = L.host()
  L.own(gui)
  mk("UIScale", { Scale = L.autoScale(), Parent = gui })

  -- The column fades at its top edge so a tall stack dissolves upward instead of
  -- reading as a wall.
  local fade = mk("Frame", {
    AnchorPoint = Vector2.new(1, 1),
    Position = UDim2.new(1, 0, 1, 0), Size = UDim2.fromOffset(W + MARGIN * 2, 420),
    BackgroundTransparency = 1, ZIndex = 0, Name = "FadeHost", Parent = gui,
  })
  Toast.fadeHost = fade
  Toast.gui = gui
  return gui
end

-- ---------------------------------------------------------------- overflow pill

local morePill, moreLbl
local function updateMore()
  local n = #queue
  if n == 0 then
    if morePill then A.groupTo(morePill, 1, "fast") end
    return
  end
  if not morePill then
    local gui = ensureHost()
    morePill = mk("CanvasGroup", {
      AnchorPoint = Vector2.new(1, 1),
      Position = UDim2.new(1, -MARGIN, 1, -MARGIN),
      Size = UDim2.fromOffset(112, 22),
      BackgroundColor3 = T.c.overlay, BackgroundTransparency = 0.05,
      GroupTransparency = 1,
      BorderSizePixel = 0, Parent = gui,
    })
    L.corner(999, morePill)
    L.stroke(T.c.lineStrong, 1, 0.35, morePill)
    moreLbl = A.text({
      Text = "", font = T.font.mono, size = T.size.tiny, colour = T.c.textDim,
      align = Enum.TextXAlignment.Center, Parent = morePill,
    })
  end
  moreLbl.Text = string.format("+%d waiting", n)
  A.groupTo(morePill, 0, "fast")
end

-- Recompute every visible toast's resting Y from the bottom up and spring it.
local function restack()
  local y = -MARGIN - (#queue > 0 and 28 or 0)
  for i = #live, 1, -1 do
    local t = live[i]
    if t.wrap.Parent then
      t.restY = y
      easeTo(t.wrap, "Position", UDim2.new(1, -MARGIN, 1, y), 0.4)
      y = y - (t.height + GAP)
    end
  end
  updateMore()
end

local spawnOne   -- forward declaration: dismiss promotes from the queue

-- Fade, shrink and sink: the entrance played backwards.
local function dismiss(entry)
  if not entry.alive then return end
  entry.alive = false
  for i, e in ipairs(live) do
    if e == entry then table.remove(live, i) break end
  end
  departing = departing + 1

  -- Every part of the exit shares OUT, or the card keeps settling after it has
  -- left.
  local OUT = 0.26
  local finished = false
  local function finishDeparture()
    if finished then return end
    finished = true
    departing = math.max(0, departing - 1)
    pcall(function() entry.wrap:Destroy() end)
    -- A queued card takes the slot only once the departing one is fully gone.
    if #queue > 0 and (#live + departing) < MAX_VISIBLE() then
      local nextOpts = table.remove(queue, 1)
      spawnOne(nextOpts)
    else
      updateMore()
    end
  end
  entry.wrap.Destroying:Connect(finishDeparture)
  easeTo(entry.wrap, "GroupTransparency", 1, OUT, finishDeparture)
  easeTo(entry.scale, "Scale", SMALL, OUT)
  easeTo(entry.wrap, "Position",
    UDim2.new(1, -MARGIN + W * 0.5, 1, entry.restY or -MARGIN), OUT)

  restack()
end

function spawnOne(opts)
  local kind = KIND[opts.kind or "info"] or KIND.info
  local gui = ensureHost()
  local hasBody = opts.body and opts.body ~= ""
  local height = hasBody and 108 or 76
  local elev = T.elev[2]

  -- The wrapper carries position and scale only. Everything visible is a child
  -- of it, so one UIScale pulls the card, its halo and its shadow together --
  -- scaling the card alone would leave the shadow the wrong size mid-flight.
  local wrap = mk("CanvasGroup", {
    AnchorPoint = Vector2.new(1, 1),
    Position = UDim2.new(1, -MARGIN, 1, -MARGIN + RISE),
    Size = UDim2.fromOffset(W, height),
    BackgroundTransparency = 1, GroupTransparency = 1, BorderSizePixel = 0,
    Name = "Toast", Parent = gui,
  })
  local scale = mk("UIScale", { Scale = SMALL, Parent = wrap })

  -- THE DEFOCUS GHOST IS GONE, and it is worth saying why because the idea was
  -- sound and the result was not.
  --
  -- The entrance used to crossfade a soft silhouette of the card into the sharp
  -- card, imitating something pulling into focus. The silhouette was the 9-slice
  -- shadow sprite tinted with the card's own fill -- which on a dark theme is a
  -- DARK RECTANGLE, larger than the card, drawn at 0.06 transparency on the
  -- first frame while the card itself was still fully invisible.
  --
  -- So every notification opened with a dark box appearing on its own, holding
  -- for a beat, and then dissolving as the card arrived. Read as an artifact,
  -- because it is one: nothing in the interface has a reason to be a dark
  -- rectangle. The concept only works if the blob is genuinely a blurred copy of
  -- the card, and Roblox has no GUI blur, so there was never a version of this
  -- that was going to land.
  --
  -- What replaces it: the card fades and rises on one clock, and its shadow is
  -- on the SAME clock so the pair arrives as one object. No stand-in, nothing
  -- that exists only during the transition.
  local drop = A.shadow(nil, {
    Parent = wrap, spread = 24, alpha = 0.42, lift = 8, ZIndex = 0,
  })

  -- A small, PERMANENT colour bloom behind the icon well -- not a flash that
  -- fades out. The old one animated from visible to invisible during the
  -- entrance, which is another thing appearing and then leaving for no reason
  -- the viewer can name.
  local bloom = A.glow(wrap, 78, kind.colour, {
    alpha = 0.72, ZIndex = 2,
    Position = UDim2.new(0, 22, 0.5, 0),
  })

  local card = mk("CanvasGroup", {
    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
    Size = UDim2.fromOffset(W, height),
    BackgroundColor3 = elev.fill, BackgroundTransparency = 0,
    BorderSizePixel = 0, GroupTransparency = 0,
    ZIndex = 4, Name = "Card", Parent = wrap,
  })
  L.corner(T.r.md, card)
  L.stroke(elev.line, 1, elev.lineT, card)
  mk("Frame", {
    Size = UDim2.new(1, -T.r.md * 2, 0, 1), Position = UDim2.new(0, T.r.md, 0, 0),
    BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.92,
    BorderSizePixel = 0, ZIndex = 2, Parent = card,
  })

  -- ---- the card's face ---------------------------------------------------
  --
  -- The first version was a coloured bar, a glyph and two lines of text, which
  -- is the shape every hub ships and reads as a debug print with rounded
  -- corners. What was missing was HIERARCHY: nothing told the eye where to land
  -- first, so it landed everywhere.
  --
  -- Now the status colour is carried by a filled disc that the glyph sits
  -- inside, which gives the card one clear anchor point on the left; the title
  -- is heavier and the body is dimmer, so the two lines separate at a glance;
  -- and the accent runs as a soft vertical wash off the left edge rather than a
  -- hard three-pixel rule, so the colour is present without being a stripe.
  local edge = mk("Frame", {
    Size = UDim2.new(0, 64, 1, 0), BackgroundColor3 = kind.colour,
    BackgroundTransparency = 0.86, BorderSizePixel = 0, ZIndex = 1, Parent = card,
  })
  mk("UIGradient", {
    Transparency = NumberSequence.new({
      NumberSequenceKeypoint.new(0.00, 0.10),
      NumberSequenceKeypoint.new(1.00, 1.00),
    }),
    Parent = edge,
  })

  -- the icon well: a filled disc in the status colour, glyph knocked out of it
  local well = mk("Frame", {
    AnchorPoint = Vector2.new(0, 0.5),
    Position = UDim2.new(0, 12, 0.5, 0), Size = UDim2.fromOffset(26, 26),
    BackgroundColor3 = kind.colour, BackgroundTransparency = 0.18,
    BorderSizePixel = 0, ZIndex = 3, Parent = card,
  })
  L.corner(999, well)
  L.stroke(kind.colour, 1, 0.45, well)

  local glyph = (A.Icon[kind.icon] or A.Icon.dot)(well, 13, T.c.accentInk)
  glyph.AnchorPoint = Vector2.new(0.5, 0.5)
  glyph.Position = UDim2.fromScale(0.5, 0.5)
  glyph.ZIndex = 4

  -- ---- the two lines ------------------------------------------------------
  -- Title heavier, body dimmer and a size smaller: the separation is what lets
  -- the pair be read as one message with a headline rather than two sentences.
  local titleLbl = A.text({
    Text = opts.title or "Notice",
    font = T.font.strong, size = T.size.label, colour = T.c.text,
    Position = UDim2.fromOffset(50, hasBody and 12 or 0),
    Size = hasBody and UDim2.new(1, -96, 0, 15) or UDim2.new(1, -96, 1, 0),
    truncate = true, ZIndex = 3, Parent = card,
  })
  if hasBody then
    A.text({
      Text = opts.body, font = T.font.body, size = T.size.micro,
      colour = T.c.textMute, valign = Enum.TextYAlignment.Top,
      Position = UDim2.fromOffset(50, 29), Size = UDim2.new(1, -62, 0, 24),
      wrap = true, ZIndex = 3, Parent = card,
    })
  end

  -- repeat counter, hidden until it is needed
  local countLbl = A.text({
    Text = "", font = T.font.mono, size = T.size.tiny, colour = kind.colour,
    align = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0),
    Position = UDim2.new(1, -12, 0, hasBody and 12 or 0),
    Size = hasBody and UDim2.fromOffset(40, 15) or UDim2.new(0, 40, 1, 0),
    ZIndex = 4, Parent = card,
  })

  -- INSET AND ROUNDED, not a full-width rule welded to the bottom edge. A bar
  -- that runs corner to corner fights the card's own radius and reads as a
  -- progress bar for the card rather than a clock on the message.
  local timerTrack = mk("Frame", {
    AnchorPoint = Vector2.new(0, 1),
    Position = UDim2.new(0, 12, 1, -7), Size = UDim2.new(1, -24, 0, 2),
    BackgroundColor3 = T.c.line, BackgroundTransparency = 0.55,
    BorderSizePixel = 0, ZIndex = 3, Parent = card,
  })
  L.corner(999, timerTrack)
  local timer = mk("Frame", {
    Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = kind.colour,
    BackgroundTransparency = 0.15, BorderSizePixel = 0, ZIndex = 4,
    Parent = timerTrack,
  })
  L.corner(999, timer)

  if L.Giorgio and L.Giorgio.styleToast then
    L.Giorgio.styleToast({card=card,wrap=wrap,title=titleLbl,count=countLbl,
      well=well,glyph=glyph,edge=edge,bloom=bloom,timer=timer,track=timerTrack},opts)
  end
  local entryHovered = false
  local entry = {
    wrap = wrap, card = card, scale = scale, bloom = bloom,
    drop = drop, height = height, alive = true, count = 1,
    key = (opts.title or "") .. "|" .. (opts.body or ""),
    countLbl = countLbl, title = titleLbl,
    life = opts.duration or (L.Cfg and tonumber(L.Cfg.data.toastDur)) or 4.5, born = os.clock(),
    onAction = opts.onAction,
  }
  live[#live + 1] = entry
  -- AN ACTIONABLE TOAST. A card click has always dismissed; if the caller
  -- supplies onAction it now RUNS first and dismisses after, so a notice can
  -- offer the one obvious response to itself instead of only reporting.
  -- Used by the restored-settings notice, which needs a one-click undo to be
  -- honest about re-arming features.
  A.interactive(card, { radius = T.r.md, onClick = function()
    if type(entry.onAction) == "function" then
      L.try("toast.action", entry.onAction)
    end
    dismiss(entry)
  end })

  -- ---- entrance ----------------------------------------------------------
  --
  -- Slide in from the right on the list's own curve, while the stack above
  -- shifts up on the SAME curve and duration -- so the arrival and the
  -- rearrangement read as one motion instead of two things happening near each
  -- other. Scale and the defocus blob ride along, which is what stops it
  -- looking like a rectangle being translated.
  -- ONE CLOCK FOR EVERY PART OF IT.
  --
  -- These used to run on 0.4 / 0.4 / 0.4 / 0.45 / 0.34, which is five things
  -- finishing at four different moments. Individually each is defensible;
  -- together they read as a card that keeps settling after it has arrived, and
  -- the shadow in particular finished last, so it looked like it was catching
  -- up with the card it belongs to.
  --
  -- Everything that is part of "the toast appearing" now shares IN, so the
  -- whole thing lands as a single object.
  local IN = 0.40
  wrap.Position = UDim2.new(1, -MARGIN + W * 0.55, 1, -MARGIN)
  restack()
  easeTo(scale, "Scale", 1, IN)
  easeTo(wrap, "GroupTransparency", 0, IN)

  -- ---- hover: lift, and hold the clock ------------------------------------
  -- Reading a notification should not be a race. Hovering pauses the timer and
  -- lifts the card slightly, which is also the affordance that says it can be
  -- interacted with at all.
  local hit = card:FindFirstChild("Hit")
  if hit then
    hit.MouseEnter:Connect(function()
      entryHovered = true
      easeTo(scale, "Scale", 1.03, 0.18)
    end)
    hit.MouseLeave:Connect(function()
      entryHovered = false
      easeTo(scale, "Scale", 1, 0.18)
    end)
  end

  -- The timer bar is the one place a linear curve is correct: it is a literal
  -- readout of remaining time, so easing it would misreport the clock.
  task.spawn(function()
    local held = 0
    while L.live() and entry.alive do
      -- paused while hovered: the clock stops rather than the bar freezing at a
      -- lie, so releasing resumes from where it actually was
      if entryHovered then
        held = held + L.RunService.Heartbeat:Wait()
      else
        L.RunService.Heartbeat:Wait()
      end
      local a = 1 - math.clamp((os.clock() - entry.born - held) / entry.life, 0, 1)
      timer.Size = UDim2.new(a, 0, 1, 0)
      -- dims as it empties, so a nearly-spent toast recedes
      timer.BackgroundTransparency = 0.15 + (1 - a) * 0.45
      if a <= 0 then break end
    end
    if entry.alive then dismiss(entry) end
  end)

  return entry
end

-- ---------------------------------------------------------------- api

function Toast.push(opts)
  opts = opts or {}
  local key = (opts.title or "") .. "|" .. (opts.body or "")

  -- collapse a repeat of the most recent message rather than stacking it
  local newest = live[#live]
  if newest and newest.alive and newest.key == key then
    newest.count = newest.count + 1
    newest.countLbl.Text = "x" .. newest.count
    newest.born = os.clock()             -- restart its clock
    -- a nudge of the same focus pull, so a repeat reads as the SAME card being
    -- struck again rather than as a new one that failed to appear
    M.set(newest.scale, "Scale", 0.965)
    M.to(newest.scale, "Scale", 1, "fast")
    return { dismiss = function() dismiss(newest) end, frame = newest.card }
  end

  if (#live + departing) >= MAX_VISIBLE() then
    queue[#queue + 1] = opts
    -- never let the backlog itself become a leak
    if #queue > 40 then table.remove(queue, 1) end
    updateMore()
    return { queued = true }
  end

  local e = spawnOne(opts)
  return { dismiss = function() dismiss(e) end, frame = e.card }
end

function Toast.clear()
  -- EMPTY THE QUEUE FIRST. dismiss() promotes the next queued toast into the
  -- freed slot, so clearing while the queue still had items refilled the stack
  -- as fast as it was emptied -- a burst of 14 "cleared" straight back into 4
  -- live toasts, and the next push then failed to collapse against them because
  -- it was comparing itself to a resurrected message.
  queue = {}
  for i = #live, 1, -1 do dismiss(live[i]) end
  updateMore()
end

function Toast.stats() return { visible = #live, departing = departing, queued = #queue } end

function Toast.info(title, body) return Toast.push({ title = title, body = body, kind = "info" }) end
function Toast.ok(title, body)   return Toast.push({ title = title, body = body, kind = "ok" }) end
function Toast.warn(title, body) return Toast.push({ title = title, body = body, kind = "warn" }) end
function Toast.bad(title, body)  return Toast.push({ title = title, body = body, kind = "bad" }) end

end

do -- ==== lm_13_backdrop.lua ====
-- LUMEN :: BACKDROP
-- The living background behind the loading screen: drifting wash, sparse stars,
-- a slow light sweep, edge falloff. Fadable parts are registered with the caller
-- rather than wrapped in a CanvasGroup, which would cost the text its crispness.

local L = getgenv().LUMEN
local T = L.T
local A = L.A
local mk = L.mk

local Backdrop = {}
L.Backdrop = Backdrop

local TICK = 1 / 30

-- ---------------------------------------------------------------- styles
--
-- Every layer is built once and a style decides which are live, so `faders()` and
-- `destroy()` still walk one known tree and switching styles sets flags rather
-- than rebuilding a screen the user is looking at.
Backdrop.STYLES = { "Nebula", "Aurora", "Particles", "Plain" }
Backdrop.DEFAULT_STYLE = "Nebula"

-- These describe the hub; the loading screen follows the same choice.
Backdrop.STYLE_DESC = {
  Nebula    = "The Saturn and a still dot lattice -- quiet behind live controls",
  Aurora    = "Slow iridescent colour fields drifting through each other",
  Particles = "The dot lattice carries a travelling wave",
  Plain     = "Surface and wash only -- nothing behind the content at all",
}

function Backdrop.styleName()
  local want = L.Cfg and L.Cfg.data and L.Cfg.data.backdrop
  for _, n in ipairs(Backdrop.STYLES) do if n == want then return n end end
  return Backdrop.DEFAULT_STYLE
end

function Backdrop.setStyle(name)
  local found
  for _, n in ipairs(Backdrop.STYLES) do if n == name then found = n end end
  if not found then return false, "unknown background " .. tostring(name) end
  if L.Cfg then L.Cfg.set("backdrop", found) end
  if Backdrop.live and Backdrop.live.applyStyle then
    pcall(function() Backdrop.live:applyStyle(found) end)
  end
  -- The loading screen is on for four seconds; the hub carries the style after.
  local w = L.Hub and L.Hub.window
  if w and w.applyBackground then
    pcall(function() w:applyBackground(found) end)
  end
  return true, found
end

function Backdrop.new(parent, opts)
  opts = opts or {}
  local self = { t = 0, acc = 0, nextStreak = 4, dirty = {} }
  local Z = opts.ZIndex or 0

  local root = mk("Frame", {
    Size = UDim2.fromScale(1, 1),
    BackgroundColor3 = opts.base or Color3.fromRGB(1, 1, 2),
    BorderSizePixel = 0, ZIndex = Z, Name = "Backdrop", Parent = parent,
  })
  self.frame = root

  -- ---- 1. wash ---------------------------------------------------------
  local wash = mk("Frame", {
    Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1),
    BorderSizePixel = 0, ZIndex = Z, Name = "Wash", Parent = root,
  })
  local washGrad = mk("UIGradient", {
    Color = ColorSequence.new({
      ColorSequenceKeypoint.new(0, Color3.fromRGB(7, 11, 26)),
      ColorSequenceKeypoint.new(0.52, Color3.fromRGB(1, 1, 3)),
      ColorSequenceKeypoint.new(1, Color3.fromRGB(4, 3, 2)),
    }),
    Rotation = 90, Parent = wash,
  })
  self.washGrad = washGrad

  -- ---- 2. dot grid -----------------------------------------------------
  local vp = L.viewport()
  local step = opts.gridStep or 96
  local cols = math.floor(vp.X / step) + 1
  local rows = math.floor(vp.Y / step) + 1
  local gridHost = mk("Frame", {
    Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
    ZIndex = Z + 1, Name = "Grid", Parent = root,
  })
  self.dots, self.cols, self.rows = {}, cols, rows
  local BASE_A = 0.93
  for r = 0, rows - 1 do
    for c = 0, cols - 1 do
      local d = mk("Frame", {
        Position = UDim2.fromOffset(c * step, r * step),
        Size = UDim2.fromOffset(3, 3),
        BackgroundColor3 = Color3.fromRGB(168, 188, 228),
        BackgroundTransparency = BASE_A,
        BorderSizePixel = 0, ZIndex = Z + 1, Parent = gridHost,
      })
      self.dots[#self.dots + 1] = { obj = d, u = c / math.max(cols - 1, 1),
                                    v = r / math.max(rows - 1, 1) }
    end
  end
  self.baseA = BASE_A

  -- ---- 2b. aurora fields -----------------------------------------------
  --
  -- No shader here, so the iridescent-mesh look is a few very large, very soft,
  -- very transparent discs drifting through one another; overlap does the
  -- blending. Lissajous paths, not random walks: two sines at incommensurable
  -- rates never repeat and cannot drift into a corner and sit there.
  local FIELDS = {
    { c = Color3.fromRGB( 92, 128, 255), sx = 0.34, sy = 0.21, rx = 0.019, ry = 0.013, sz = 1.05 },
    { c = Color3.fromRGB(196, 108, 255), sx = 0.28, sy = 0.30, rx = 0.014, ry = 0.023, sz = 0.86 },
    { c = Color3.fromRGB( 88, 226, 220), sx = 0.31, sy = 0.24, rx = 0.024, ry = 0.010, sz = 0.94 },
    { c = Color3.fromRGB(255, 154, 118), sx = 0.22, sy = 0.26, rx = 0.011, ry = 0.017, sz = 0.72 },
    { c = Color3.fromRGB(120, 160, 255), sx = 0.36, sy = 0.18, rx = 0.008, ry = 0.021, sz = 1.20 },
  }
  self.fields = {}
  if A and A.img and A.img.glow then
    local auroraHost = mk("Frame", {
      Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
      Visible = false, ZIndex = Z + 1, Name = "Aurora", Parent = root,
    })
    self.auroraHost = auroraHost
    for i, f in ipairs(FIELDS) do
      local d = math.floor(vp.X * f.sz)
      local obj = mk("ImageLabel", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(d, d),
        BackgroundTransparency = 1,
        Image = A.img.glow, ImageColor3 = f.c, ImageTransparency = 0.80,
        ZIndex = Z + 1, Name = "Field" .. i, Parent = auroraHost,
      })
      self.fields[i] = { obj = obj, spec = f, phase = i * 1.7 }
    end
  end

  -- ---- 3. terrain ------------------------------------------------------
  -- Thin vertical bars whose heights follow a sum of sines. Three sines is
  -- enough to stop it reading as a repeating wave.
  local function ridge(yScale, height, colour, bars, seed, zoff)
    local host = mk("Frame", {
      AnchorPoint = Vector2.new(0.5, 1),
      Position = UDim2.fromScale(0.5, yScale),
      Size = UDim2.fromScale(1.25, 0),
      BackgroundTransparency = 1,
      ZIndex = Z + 2 + zoff, Name = "Ridge", Parent = root,
    })
    local w = (vp.X * 1.25) / bars
    for i = 0, bars - 1 do
      local x = i / bars * 12
      local hh = height * (0.55
        + 0.28 * math.sin(x * 1.7 + seed)
        + 0.13 * math.sin(x * 3.9 + seed * 2.3)
        + 0.06 * math.sin(x * 8.1 + seed * 4.7))
      mk("Frame", {
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.fromOffset(i * w, 0),
        Size = UDim2.fromOffset(math.ceil(w) + 1, math.max(hh, 2)),
        BackgroundColor3 = colour, BorderSizePixel = 0,
        ZIndex = Z + 2 + zoff, Parent = host,
      })
    end
    return host
  end

  local vh = vp.Y
  self.ridges = {
    { obj = ridge(1.00, vh * 0.13, Color3.fromRGB(7, 10, 19), 400, 1.0, 2), rate = 0.0035 },
    { obj = ridge(1.00, vh * 0.09, Color3.fromRGB(4, 6, 11),  400, 3.7, 1), rate = 0.0022 },
    { obj = ridge(1.00, vh * 0.06, Color3.fromRGB(2, 2, 5),   400, 6.2, 0), rate = 0.0012 },
  }

  -- ---- 4. streak -------------------------------------------------------
  local streak = mk("Frame", {
    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(-0.2, 0.2),
    Size = UDim2.fromOffset(170, 1), BackgroundColor3 = Color3.fromRGB(200, 218, 255),
    BackgroundTransparency = 1, BorderSizePixel = 0, Rotation = 20,
    ZIndex = Z + 4, Name = "Streak", Parent = root,
  })
  mk("UIGradient", {
    Transparency = NumberSequence.new({
      NumberSequenceKeypoint.new(0, 1),
      NumberSequenceKeypoint.new(0.85, 0.3),
      NumberSequenceKeypoint.new(1, 1),
    }), Parent = streak,
  })
  self.streak, self.streakOn, self.streakT, self.streakY = streak, false, 0, 0.2

  -- ---- 5. edges --------------------------------------------------------
  local edges = mk("Frame", {
    Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
    BorderSizePixel = 0, ZIndex = Z + 5, Name = "Edges", Parent = root,
  })
  mk("UIGradient", {
    Transparency = NumberSequence.new({
      NumberSequenceKeypoint.new(0, 0.02),
      NumberSequenceKeypoint.new(0.30, 1),
      NumberSequenceKeypoint.new(0.70, 1),
      NumberSequenceKeypoint.new(1, 0.02),
    }), Parent = edges,
  })
  self.edges = edges

  -- ---- style ------------------------------------------------------------
  function self:applyStyle(name)
    name = name or Backdrop.DEFAULT_STYLE
    self.style = name
    local aurora    = (name == "Aurora")
    local particles = (name == "Particles")
    local plain     = (name == "Plain")

    if self.auroraHost then self.auroraHost.Visible = aurora end
    for _, rg in ipairs(self.ridges) do
      -- Aurora has no horizon: a ridge in front of a colour field reads as two
      -- backgrounds. Plain has nothing but the wash.
      rg.obj.Visible = not (aurora or plain)
    end
    self.streak.Visible = not plain
    -- the dot field survives into Aurora, dimmed, so the colour does not read
    -- as flat wallpaper
    self.baseA = aurora and 0.965 or 0.93
    self.dotsOn = not plain
    for i = 1, #self.dots do
      local d = self.dots[i]
      d.obj.Visible = self.dotsOn
      d.obj.BackgroundTransparency = self.baseA
      if not particles then d.obj.Size = UDim2.fromOffset(3, 3) end
    end
    for i = #self.dirty, 1, -1 do self.dirty[i] = nil end
    return self
  end

  -- ---- drive -----------------------------------------------------------
  local BAND = 0.14          -- how wide the lit band is, in diagonal units
  self.conn = L.hold(L.RunService.RenderStepped:Connect(function(dt)
    if not L.live() or not root.Parent then return end
    self.t = self.t + dt
    local t = self.t

    washGrad.Rotation = 90 + math.sin(t * 0.10) * 8

    for i = 1, #self.ridges do
      local rg = self.ridges[i]
      if rg.obj.Visible then
        rg.obj.Position = UDim2.fromScale(0.5 + math.sin(t * rg.rate * 6) * 0.012, 1.0)
      end
    end

    if self.style == "Aurora" then
      for i = 1, #self.fields do
        local f = self.fields[i]
        local sp = f.spec
        f.obj.Position = UDim2.fromScale(
          0.5 + math.sin(t * sp.rx * 6.283 + f.phase) * sp.sx,
          0.5 + math.cos(t * sp.ry * 6.283 + f.phase * 1.31) * sp.sy)
        -- breathing opacity, so two fields crossing do not always look the same.
        -- 0.87 read as a barely-tinted black screen; 0.80 with a wider breath is
        -- where the colour shows without competing with the wordmark.
        f.obj.ImageTransparency = 0.80 + math.sin(t * 0.11 + f.phase) * 0.07
      end
    end

    if not self.streak.Visible then
      -- nothing to move, and nothing should accumulate while it is put away
      self.streakOn, self.nextStreak = false, t + 4
    elseif not self.streakOn then
      if t >= self.nextStreak then
        self.streakOn, self.streakT = true, 0
        self.streakY = 0.08 + ((t * 0.37) % 1) * 0.45
        streak.Rotation = 14 + ((t * 0.91) % 1) * 20
      end
    else
      self.streakT = self.streakT + dt
      local p = self.streakT / 0.8
      if p >= 1 then
        self.streakOn = false
        self.nextStreak = t + 6 + ((t * 0.53) % 1) * 8
        streak.BackgroundTransparency = 1
      else
        streak.Position = UDim2.fromScale(-0.15 + p * 1.3, self.streakY)
        streak.BackgroundTransparency = 0.3 + (1 - math.sin(p * math.pi)) * 0.7
      end
    end

    self.acc = self.acc + dt
    if self.acc < TICK then return end
    self.acc = 0

    if not self.dotsOn then return end

    if self.style == "Particles" then
      -- The grid itself is displaced, not lit by a passing band. Two sines at
      -- different angles and rates give an interference pattern that never
      -- repeats. Size moves with brightness: a dot that only changes opacity
      -- reads as a light flicking on rather than a particle rising toward you.
      for i = 1, #self.dots do
        local d = self.dots[i]
        local w = math.sin((d.u * 3.1 + d.v * 1.7) * 3.14159 - t * 1.05)
                + math.sin((d.u * 1.3 - d.v * 2.9) * 3.14159 - t * 0.68)
        local k = math.clamp((w + 2) / 4, 0, 1)
        k = k * k * k                            -- most of the field stays quiet
        d.obj.BackgroundTransparency = self.baseA - (self.baseA - 0.06) * k
        local sz = 3 + math.floor(k * 3.4)
        if d.sz ~= sz then
          d.sz = sz
          d.obj.Size = UDim2.fromOffset(sz, sz)
        end
      end
      return
    end

    -- reset only what was lit last tick, then light only the current band
    local dirty = self.dirty
    for i = 1, #dirty do dirty[i].BackgroundTransparency = self.baseA end
    local n = 0
    local head = ((t * 0.16) % 1.6) - 0.3     -- travels, then a gap before repeating
    for i = 1, #self.dots do
      local d = self.dots[i]
      local pos = (d.u + d.v) * 0.5            -- diagonal coordinate
      local dist = math.abs(pos - head)
      if dist < BAND then
        local k = 1 - (dist / BAND)
        n = n + 1
        dirty[n] = d.obj
        d.obj.BackgroundTransparency = self.baseA - (self.baseA - 0.10) * k * k
      end
    end
    for i = #dirty, n + 1, -1 do dirty[i] = nil end
  end))

  function self:destroy()
    if self.conn then self.conn:Disconnect() end
    if Backdrop.live == self then Backdrop.live = nil end
    pcall(function() root:Destroy() end)
  end

  function self:faders()
    local out = {
      { obj = root, prop = "BackgroundTransparency" },
      { obj = wash, prop = "BackgroundTransparency" },
      { obj = edges, prop = "BackgroundTransparency" },
      { obj = streak, prop = "BackgroundTransparency" },
    }
    for i = 1, #self.dots do
      out[#out + 1] = { obj = self.dots[i].obj, prop = "BackgroundTransparency" }
    end
    -- the colour fields must fade too, or the hub inherits five coloured discs
    for i = 1, #self.fields do
      out[#out + 1] = { obj = self.fields[i].obj, prop = "ImageTransparency" }
    end
    for i = 1, #self.ridges do
      for _, bar in ipairs(self.ridges[i].obj:GetChildren()) do
        out[#out + 1] = { obj = bar, prop = "BackgroundTransparency" }
      end
    end
    return out
  end

  Backdrop.live = self
  self:applyStyle(Backdrop.styleName())

  return self
end

end

do -- ==== lm_12_video.lua ====
-- LUMEN :: VIDEO
-- Plays a folder of PNGs as an image sequence, via getcustomasset.
-- getcustomasset keys on the BASENAME, not the path, so two sequences that both
-- contain f001.png resolve to the same id. Every sequence needs its own prefix.
-- `first` picks where a loop starts, since footage rarely loops across a folder.

local L = getgenv().LUMEN
local mk = L.mk

local Video = {}
L.Video = Video

local getAsset = rawget(getgenv(), "getcustomasset") or rawget(getgenv(), "getsynasset")

-- getcustomasset returns rbxasset://<sessionhash>/<basename>, keyed on the
-- basename and not the path, so every sequence needs a unique prefix.
-- Digit width and extension are parameters because frame naming varies by
-- pipeline (f001.png here, f_0001.jpg elsewhere); defaults are the old values.
function Video.framePath(folder, prefix, i, digits, ext)
  return string.format("%s/%s%0" .. tostring(digits or 3) .. "d%s",
                       folder, prefix, i, ext or ".png")
end

-- `cells` is frames per file (1 when unpacked), so the check counts files.
function Video.available(folder, prefix, count, first, digits, ext, cells)
  if type(getAsset) ~= "function" then return false, "executor has no getcustomasset" end
  first = first or 1
  cells = math.max(1, cells or 1)
  local files = math.max(1, math.ceil(count / cells))
  local firstPath = Video.framePath(folder, prefix, first, digits, ext)
  local ok, present = pcall(isfile, firstPath)
  if not ok or not present then return false, "no frames at " .. firstPath end
  local lastPath = Video.framePath(folder, prefix, first + files - 1, digits, ext)
  local ok2, last = pcall(isfile, lastPath)
  if not ok2 or not last then return false, "sequence is short -- missing " .. lastPath end
  return true
end

-- opts: folder, count, fps, size (px), Position, ZIndex, loop, first
function Video.new(parent, opts)
  opts = opts or {}
  local folder = opts.folder
  local count  = opts.count or 120
  local fps    = opts.fps or 15
  -- Take every Nth frame. The textures are already decoded by the loader, so a
  -- strided instance costs only its ImageLabels.
  local stride = math.max(math.floor(opts.stride or 1), 1)

  local prefix = opts.prefix or "f"
  local first  = math.max(math.floor(opts.first or 1), 1)
  local digits = opts.digits or 3
  local ext    = opts.ext or ".png"
  local okAvail, why = Video.available(folder, prefix, count, first, digits, ext,
    opts.atlas and ((opts.atlas.cols or 1) * (opts.atlas.rows or 1)) or 1)
  if not okAvail then return nil, why end

  local self = { count = count, fps = fps, frame = 1, t = 0, playing = true }

  local holder = mk("Frame", {
    AnchorPoint = Vector2.new(0.5, 0.5),
    Position = opts.Position or UDim2.fromScale(0.5, 0.5),
    -- an explicit Size wins, so a background can fill its parent, not just a square
    Size = opts.Size or UDim2.fromOffset(opts.size or 465, opts.size or 465),
    BackgroundTransparency = 1,
    ZIndex = opts.ZIndex or 3,
    Name = "Video", Parent = parent,
  })
  self.frameObj = holder

  -- Built in batches so building ~700 frames is not one long stall; every caller
  -- is already inside a coroutine. BATCH is 8, not 24: a frame of this work
  -- measures ~2.1 ms, so 24 is a 50 ms chunk while 8 fits one 60 fps frame.
  -- ---- atlases --------------------------------------------------------
  -- Roblox refuses textures over 1024 px on either axis, so long clips are
  -- packed: 30 files of 1024x576, each a 2x2 grid of 512x288 cells, is 120
  -- frames. `atlas = { cols, rows, tile }` describes the packing; `count` stays
  -- the number of FRAMES. One ImageLabel per file, ImageRectOffset picks the cell.
  local atlas = opts.atlas
  local cells = 1
  if atlas then
    cells = math.max(1, (atlas.cols or 1) * (atlas.rows or 1))
  end
  local fileCount = math.max(1, math.ceil(count / cells))

  local BATCH = 8
  local labels = {}
  local made = 0
  for i = first, first + fileCount - 1, stride do
    local ok, id = pcall(getAsset, Video.framePath(folder, prefix, i, digits, ext))
    if ok and id then
      local props = {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Image = id,
        ScaleType = opts.scaleType or Enum.ScaleType.Stretch,
        ImageTransparency = 1,
        ZIndex = opts.ZIndex or 3,
        Name = prefix .. i,
        Parent = holder,
      }
      if atlas and atlas.tile then props.ImageRectSize = atlas.tile end
      labels[#labels + 1] = mk("ImageLabel", props)
    end
    made = made + 1
    if made % BATCH == 0 and opts.yield ~= false then
      L.RunService.Heartbeat:Wait()
    end
  end
  self.labels = labels
  self.atlas, self.cells = atlas, cells
  count = #labels * cells
  self.count = count

  -- Which label holds frame n, and which cell within it.
  local function cellOf(n)
    if not atlas then return labels[n], nil end
    local fi = math.floor((n - 1) / cells) + 1
    return labels[fi], (n - 1) % cells
  end

  -- Reveal frame n and hide whatever was showing. Shared by the manual seek and
  -- the auto-advance.
  local function present(n, prevN)
    local lbl, ci = cellOf(n)
    local prevLbl = prevN and cellOf(prevN) or nil
    if prevLbl and prevLbl ~= lbl then prevLbl.ImageTransparency = 1 end
    if lbl then
      if ci and atlas.tile then
        lbl.ImageRectOffset = Vector2.new(
          (ci % (atlas.cols or 1)) * atlas.tile.X,
          math.floor(ci / (atlas.cols or 1)) * atlas.tile.Y)
      end
      lbl.ImageTransparency = self.rest or 0
    end
  end
  self._present = present
  fps = fps / stride
  if #labels == 0 then
    pcall(function() holder:Destroy() end)
    return nil, "no frames decoded"
  end
  self.rest = opts.rest or 0
  self.shown = 1
  present(1, nil)

  -- Warm the texture cache before anything is on screen. PreloadAsync blocks, so
  -- it runs on its own thread rather than stalling the loader.
  task.spawn(function()
    L.try("video.preload", function()
      game:GetService("ContentProvider"):PreloadAsync(labels)
    end)
    self.warm = true
  end)

  -- Manual mode: the caller owns the playhead and the auto-advance stays out.
  function self:setFrame(n)
    n = ((math.floor(n) - 1) % count) + 1
    local prev = self.shown
    if prev == n then return end
    present(n, prev)
    self.shown, self.frame = n, n
  end

  local step = 1 / fps
  self.conn = L.hold(L.RunService.RenderStepped:Connect(function(dt)
    if opts.manual then return end
    if not L.live() or not holder.Parent or not self.playing then return end
    self.t = self.t + dt
    if self.t < step then return end
    -- Advance by however many frame periods elapsed, so a hitch skips ahead.
    local advance = math.floor(self.t / step)
    self.t = self.t - advance * step
    local nxt = self.frame + advance
    if opts.loop == false and nxt > count then
      nxt = count
      self.playing = false
    else
      nxt = ((nxt - 1) % count) + 1
    end
    self.frame = nxt
    local prev = self.shown
    if prev ~= nxt then
      present(nxt, prev)
      self.shown = nxt
    end
  end))

  function self:setSpeed(mult) step = 1 / (fps * math.max(mult, 0.05)) end
  function self:pause() self.playing = false end
  function self:play() self.playing = true end
  function self:destroy()
    if self.conn then self.conn:Disconnect() end
    pcall(function() holder:Destroy() end)
  end

  return self
end

end

do -- ==== lm_10_orb.lua ====
-- LUMEN :: ORB
-- Drawn fallback mark for when the rendered Saturn frames are unavailable.

local L = getgenv().LUMEN
local T, M, A = L.T, L.Motion, L.A
local mk = L.mk

local Orb = {}
L.Orb = Orb

local BLUE   = Color3.fromRGB(46, 96, 255)
local BLUE_L = Color3.fromRGB(120, 170, 255)
local GOLD   = Color3.fromRGB(255, 176, 62)
local WHITE  = Color3.fromRGB(226, 238, 255)

local function ball(parent, size, colour, transparency, offset)
  local p = Instance.new("Part")
  p.Shape = Enum.PartType.Ball
  p.Size = Vector3.new(size, size, size)
  p.Color = colour
  p.Material = Enum.Material.Neon
  p.Transparency = transparency
  p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
  p.CastShadow = false
  p.CFrame = CFrame.new(offset or Vector3.new())
  p.Parent = parent
  return p
end

-- An ellipse drawn as a stroked, rounded frame; its height animates edge-on.
local function arc(parent, w, h, rot, colour, thickness, alpha)
  local f = mk("Frame", {
    AnchorPoint = Vector2.new(0.5, 0.5),
    Position = UDim2.fromScale(0.5, 0.5),
    Size = UDim2.fromScale(w, h),
    BackgroundTransparency = 1,
    Rotation = rot,
    ZIndex = 6,
    Name = "Arc", Parent = parent,
  })
  L.corner(999, f)
  local s = L.stroke(colour, thickness or 1.4, alpha or 0.25, f)
  return f, s
end

-- size: pixel square. Returns a controller.
function Orb.new(parent, size, opts)
  opts = opts or {}
  local self = { }

  local holder = mk("Frame", {
    AnchorPoint = Vector2.new(0.5, 0.5),
    Position = opts.Position or UDim2.fromScale(0.5, 0.5),
    Size = UDim2.fromOffset(size, size),
    BackgroundTransparency = 1,
    ZIndex = opts.ZIndex or 3,
    Name = "Orb", Parent = parent,
  })
  self.frame = holder

  -- ---- 3D body -------------------------------------------------------
  local vp = mk("ViewportFrame", {
    Size = UDim2.fromScale(1, 1),
    BackgroundTransparency = 1,
    -- A viewport has its own lighting rig; Neon ignores it, ambient lifts the rim.
    Ambient = Color3.fromRGB(40, 60, 120),
    LightColor = Color3.fromRGB(190, 210, 255),
    LightDirection = Vector3.new(-0.4, -0.8, -0.5),
    ZIndex = (opts.ZIndex or 3) + 1,
    Name = "Body", Parent = holder,
  })
  self.vp = vp

  local world = Instance.new("WorldModel")
  world.Parent = vp

  local model = Instance.new("Model")
  model.Name = "OrbModel"
  model.Parent = world

  -- A glass shell, not a glowing ball: bright rim, see-through middle.
  ball(model, 5.60, BLUE,   0.93)
  ball(model, 5.05, BLUE,   0.90)
  ball(model, 4.30, BLUE_L, 0.92)

  -- Colour pooled low inside the shell, plus one small specular opposite it.
  local goldA = ball(model, 3.10, GOLD,  0.76, Vector3.new(-0.5, -1.8, 0.3))
  local goldB = ball(model, 1.70, GOLD,  0.68, Vector3.new(1.3, -1.4, -0.7))
  local pool  = ball(model, 2.40, BLUE_L, 0.80, Vector3.new(0.4, -1.2, 1.0))
  local spec  = ball(model, 0.70, WHITE, 0.30, Vector3.new(-1.2, 1.7, 1.3))
  self.gold = { goldA, goldB, pool, spec }

  local cam = Instance.new("Camera")
  cam.FieldOfView = 42
  cam.CFrame = CFrame.new(Vector3.new(0, 0, 13), Vector3.new())
  cam.Parent = vp
  vp.CurrentCamera = cam

  -- ---- the glass edge -------------------------------------------------
  -- The rim a viewport cannot produce, plus a thinner brighter one inside it.
  local rim = mk("Frame", {
    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
    Size = UDim2.fromScale(0.80, 0.80), BackgroundTransparency = 1,
    ZIndex = (opts.ZIndex or 3) + 5, Name = "Rim", Parent = holder,
  })
  L.corner(999, rim)
  -- Stroke widths are a fraction of the orb, not fixed pixels: tuned at 250 px
  -- and left constant they become invisible hairlines by 470 px.
  local K = size / 250
  L.stroke(BLUE_L, 2.6 * K, 0.22, rim)

  local rimIn = mk("Frame", {
    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
    Size = UDim2.fromScale(0.755, 0.755), BackgroundTransparency = 1,
    ZIndex = (opts.ZIndex or 3) + 6, Name = "RimInner", Parent = holder,
  })
  L.corner(999, rimIn)
  local rimStroke = L.stroke(WHITE, 1.1 * K, 0.55, rimIn)
  -- Brightest top-left, fading round the bottom, so the light source reads fixed.
  mk("UIGradient", {
    Transparency = NumberSequence.new({
      NumberSequenceKeypoint.new(0, 0.15),
      NumberSequenceKeypoint.new(0.45, 0.75),
      NumberSequenceKeypoint.new(1, 1),
    }),
    Rotation = 118, Parent = rimStroke,
  })
  self.rim, self.rimIn = rim, rimIn

  -- ---- 2D arcs -------------------------------------------------------
  self.arcs = {}
  local defs = {
    { w = 0.98, rot = -14, colour = BLUE_L, th = 1.6, a = 0.20, phase = 0.00, speed = 0.55 },
    { w = 0.86, rot =  22, colour = WHITE,  th = 1.2, a = 0.42, phase = 2.10, speed = 0.41 },
    { w = 0.92, rot =  62, colour = GOLD,   th = 1.1, a = 0.55, phase = 4.05, speed = 0.33 },
  }
  for _, d in ipairs(defs) do
    local f, s = arc(holder, d.w, d.w, d.rot, d.colour, d.th * (size / 250), d.a)
    self.arcs[#self.arcs + 1] = { frame = f, stroke = s, def = d }
  end

  -- ---- animation -----------------------------------------------------
  self.t = 0
  self.speed = opts.speed or 1
  self.conn = L.hold(L.RunService.RenderStepped:Connect(function(dt)
    if not L.live() or not holder.Parent then return end
    self.t = self.t + dt * self.speed

    -- Tilted axis, so the gold pool swings through the silhouette.
    model:PivotTo(CFrame.Angles(math.rad(14), self.t * 0.55, math.rad(6)))

    for i, a in ipairs(self.arcs) do
      local d = a.def
      -- |cos| of the phase is the ring's projected height, floored off zero.
      local k = math.abs(math.cos(self.t * d.speed + d.phase))
      a.frame.Size = UDim2.fromScale(d.w, d.w * (0.06 + 0.94 * k))
      a.frame.Rotation = d.rot + math.sin(self.t * d.speed * 0.5 + d.phase) * 9
      -- fade as it goes edge-on, so the far side does not read as in front
      a.stroke.Transparency = d.a + (1 - d.a) * (1 - k) * 0.55
      local _ = i
    end
  end))

  function self:setSpeed(v) self.speed = v end
  function self:destroy()
    if self.conn then self.conn:Disconnect() end
    pcall(function() holder:Destroy() end)
  end

  return self
end

end

do -- ==== lm_11_spinner.lua ====
-- LUMEN :: SPINNER
-- The game carousel: a fan of cards on an arc, positioned by distance from the
-- front, so the one in focus is largest and brightest.

local L = getgenv().LUMEN
local T, M, A = L.T, L.Motion, L.A
local mk = L.mk

local Spinner = {}
L.Spinner = Spinner

local CARD_W, CARD_H, CARD_D = 3.3, 3.3, 0.08
local RADIUS = 4.9
-- 0.16 rad/s was ~6.5 s per card to the front, too slow to read as motion.
-- 0.42 brings a card round every ~2.5 s.
local IDLE = 0.42

local getAsset = rawget(getgenv(), "getcustomasset") or rawget(getgenv(), "getsynasset")

local function iconId(key)
  if type(getAsset) ~= "function" or not key then return nil end
  local path = "lumen_fx/games/" .. key .. ".png"
  local ok, present = pcall(isfile, path)
  if not ok or not present then return nil end
  local gok, id = pcall(getAsset, path)
  return gok and id or nil
end

function Spinner.new(parent, opts)
  opts = opts or {}
  local items = opts.items or {}
  local n = math.max(#items, 1)
  local self = { items = items, index = 1, drift = 0,
                 idleScale = 1, slowUntil = 0 }

  local holder = mk("Frame", {
    Size = opts.Size or UDim2.new(1, 0, 0, 320),
    BackgroundTransparency = 1, Name = "Spinner", Parent = parent,
  })
  self.frame = holder

  local vp = mk("ViewportFrame", {
    Size = UDim2.new(1, 0, 1, -46), BackgroundTransparency = 1,
    Ambient = Color3.fromRGB(150, 162, 190),
    LightColor = Color3.fromRGB(255, 255, 255),
    LightDirection = Vector3.new(-0.3, -0.55, -0.8),
    ZIndex = 2, Name = "Stage", Parent = holder,
  })
  self.vp = vp

  local world = Instance.new("WorldModel")
  world.Parent = vp
  local model = Instance.new("Model")
  model.Parent = world

  local cam = Instance.new("Camera")
  cam.FieldOfView = 42
  cam.CFrame = CFrame.new(Vector3.new(0, 0.5, 14.5), Vector3.new(0, 0, 0))
  cam.Parent = vp
  vp.CurrentCamera = cam

  local step = (2 * math.pi) / n
  self.step = step
  self.cards = {}

  for i, it in ipairs(items) do
    -- chrome backing plate, slightly larger, so the card reads as a printed panel
    local back = Instance.new("Part")
    back.Size = Vector3.new(CARD_W + 0.16, CARD_H + 0.16, CARD_D)
    back.Color = Color3.fromRGB(176, 196, 232)
    back.Material = Enum.Material.SmoothPlastic
    back.Anchored, back.CanCollide, back.CanQuery, back.CanTouch = true, false, false, false
    back.CastShadow = false
    back.Parent = model

    local face = Instance.new("Part")
    face.Size = Vector3.new(CARD_W, CARD_H, CARD_D + 0.02)
    face.Color = Color3.fromRGB(16, 18, 26)
    face.Material = Enum.Material.SmoothPlastic
    face.Anchored, face.CanCollide, face.CanQuery, face.CanTouch = true, false, false, false
    face.CastShadow = false
    face.Parent = model

    local id = iconId(it.key)
    if id then
      for _, f in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
        local d = Instance.new("Decal")
        d.Texture = id
        d.Face = f
        d.Parent = face
      end
    end

    self.cards[i] = { back = back, face = face, has = id ~= nil }
  end

  -- ---- labels ---------------------------------------------------------
  self.label = A.text({
    Text = items[1] and items[1].name or "",
    font = T.font.strong, size = T.size.head, colour = T.c.text,
    align = Enum.TextXAlignment.Center,
    AnchorPoint = Vector2.new(0.5, 1),
    Position = UDim2.new(0.5, 0, 1, -18), Size = UDim2.new(1, 0, 0, 20),
    ZIndex = 4, Parent = holder,
  })
  -- subFor lets the caller replace the "3 / 10" counter with what picking the
  -- front card actually gets you.
  local function subText(item, i)
    if opts.subFor then
      local ok, s = pcall(opts.subFor, item, i, #items)
      if ok and type(s) == "string" then return s end
    end
    return string.format("%d / %d", i, #items)
  end
  self.subText = subText

  self.sub = A.text({
    Text = subText(items[1], 1),
    font = T.font.mono, size = T.size.tiny, colour = T.c.textMute,
    align = Enum.TextXAlignment.Center,
    AnchorPoint = Vector2.new(0.5, 1),
    Position = UDim2.new(0.5, 0, 1, -2), Size = UDim2.new(1, 0, 0, 12),
    ZIndex = 4, Parent = holder,
  })

  -- ---- motion ---------------------------------------------------------
  self.spring = L.Spring.new(0.70, 0.26, 0)

  self.conn = L.hold(L.RunService.RenderStepped:Connect(function(dt)
    if not L.live() or not holder.Parent then return end
    -- 2.5 s at the front is not long enough to read a label and click Join, so
    -- touching an arrow drops the rate to a crawl for five seconds, then eases
    -- back. It never fully stops.
    local want = (os.clock() < self.slowUntil) and 0.04 or 1
    self.idleScale = self.idleScale + (want - self.idleScale) * math.min(dt * 2.4, 1)
    self.drift = self.drift + dt * IDLE * self.idleScale
    local base = self.drift + self.spring:step(dt)

    local bestI, bestFacing = 1, -2
    for i, c in ipairs(self.cards) do
      local theta = base + (i - 1) * step
      local x = math.sin(theta) * RADIUS
      local z = math.cos(theta) * RADIUS
      local bob = math.sin(theta * 2 + self.drift * 0.7) * 0.14
      local cf = CFrame.new(x, bob, z)
                 * CFrame.Angles(0, theta, 0)
                 * CFrame.Angles(math.rad(-3), 0, 0)
      c.back.CFrame = cf
      c.face.CFrame = cf

      local facing = math.cos(theta)              -- 1 front, -1 back
      if facing > bestFacing then bestFacing, bestI = facing, i end
      -- fade the far side so the ring reads as having a front
      local a = (facing + 1) * 0.5
      local t = 0.04 + (1 - a) * 0.66
      c.face.Transparency = t
      c.back.Transparency = math.min(t + 0.10, 1)
      for _, d in ipairs(c.face:GetChildren()) do
        if d:IsA("Decal") then d.Transparency = t end
      end
    end

    -- the label follows whatever is actually at the front
    if bestI ~= self.index then
      self.index = bestI
      self.label.Text = self.items[bestI].name or ""
      self.sub.Text = subText(self.items[bestI], bestI)
      if opts.onFront then L.try("spinner.front", opts.onFront, self.items[bestI], bestI) end
    end
  end))

  -- Arrows push the spring by exactly one card. Repeated presses accumulate
  -- because a retarget keeps the velocity already in flight.
  function self:hold(seconds)
    self.slowUntil = os.clock() + (seconds or 5)
  end

  function self:nudge(dir)
    self:hold(5)
    self.spring:to(self.spring.target - dir * step)
  end
  function self:next() self:nudge(1) end
  function self:prev() self:nudge(-1) end

  function self:select(i)
    local total = #self.items
    if total == 0 then return end
    self:hold(5)
    i = ((i - 1) % total) + 1
    -- solve for the offset that puts card i at the front, given current drift
    local want = -((i - 1) * step) - self.drift
    local cur = self.spring.target
    while want - cur > math.pi do want = want - 2 * math.pi end
    while cur - want > math.pi do want = want + 2 * math.pi end
    self.spring:to(want)
    if opts.callback then L.try("spinner.cb", opts.callback, self.items[i], i) end
  end

  function self:destroy()
    if self.conn then self.conn:Disconnect() end
    pcall(function() holder:Destroy() end)
  end

  -- ---- arrows ---------------------------------------------------------
  local function arrow(xScale, dir, fn)
    local b = mk("Frame", {
      AnchorPoint = Vector2.new(0.5, 0.5),
      Position = UDim2.new(xScale, 0, 0.44, 0),
      Size = UDim2.fromOffset(32, 32),
      BackgroundColor3 = T.c.raised, BackgroundTransparency = 0.12,
      BorderSizePixel = 0, ZIndex = 5, Parent = holder,
    })
    L.corner(999, b)
    L.stroke(T.c.lineStrong, 1, 0.35, b)
    local g = A.Icon.chevron(b, 14, T.c.textDim, dir)
    g.AnchorPoint = Vector2.new(0.5, 0.5)
    g.Position = UDim2.fromScale(0.5, 0.5)
    g.ZIndex = 6
    A.interactive(b, { radius = 999, onClick = fn })
    return b
  end
  arrow(0.05, "left",  function() self:prev() end)
  arrow(0.95, "right", function() self:next() end)

  return self
end

end

do -- ==== lm_27_infinity.lua ====
-- LUMEN :: BOOT MARKS
--
-- Two shapes, one renderer. `Inf.new` is the morphing infinity; `Inf.newRing`
-- is the arc that replaced it on the loading screen. They share `update`'s
-- chord-laying step and the same small interface, so the loader swaps between
-- them on one line.
--
-- ---------------------------------------------------------------- infinity
-- A port of loading-ui.com's morphing-infinity, which is an SVG whose single
-- stroked path animates through circle -> infinity -> circle -> infinity over
-- five seconds.
--
-- Roblox draws no vector paths, so the curve is walked and rebuilt every frame
-- out of 64 rounded segments. That sounds worse than it is: at this size each
-- segment is about three pixels long under a six pixel stroke, so the round
-- caps overlap into one continuous line with no visible facets.
--
-- WHY THE TWO CIRCLES ARE NOT THE SAME CIRCLE. circleA starts at the top and
-- runs clockwise; circleB starts at the bottom and runs anticlockwise. They
-- draw an identical ring. Interpolating between them THROUGH the lemniscate is
-- what makes the loop read as one ribbon turning inside out, because no two
-- consecutive transitions are the same motion -- swap circleB for circleA and
-- the whole thing collapses into a circle that flexes and un-flexes on the
-- spot. That asymmetry is the entire idea and it costs nothing.
--
-- All three paths share a structure -- a start point and four cubic segments --
-- so morphing is interpolating 26 numbers and re-walking the curve, which is
-- exactly what the web version's path interpolation does underneath.

local L = getgenv().LUMEN
local T = L.T
local mk = L.mk

local Inf = {}
L.Infinity = Inf

-- flat, in the source's own 24x24 box: x0 y0 then four (c1 c2 end) triples
local circleA = {
  12, 8,
  14.21, 8,     16, 9.79,   16, 12,
  16, 14.21,    14.21, 16,  12, 16,
  9.79, 16,     8, 14.21,   8, 12,
  8, 9.79,      9.79, 8,    12, 8,
}
local infinity = {
  12, 12,
  14, 8.5,      19, 8.5,    19, 12,
  19, 15.5,     14, 15.5,   12, 12,
  10, 8.5,      5, 8.5,     5, 12,
  5, 15.5,      10, 15.5,   12, 12,
}
local circleB = {
  12, 16,
  14.21, 16,    16, 14.21,  16, 12,
  16, 9.79,     14.21, 8,   12, 8,
  9.79, 8,      8, 9.79,    8, 12,
  8, 14.21,     9.79, 16,   12, 16,
}

local KEYS  = { circleA, infinity, circleB, infinity, circleA }
local TIMES = { 0, 0.25, 0.50, 0.75, 1.00 }
local CYCLE = 5.0            -- seconds, from the source
local SUB   = 16             -- samples per cubic; 4 cubics -> 64 segments
local N     = SUB * 4

-- The source eases each keyframe-to-keyframe leg with motion's "easeInOut",
-- which is cubic-bezier(0.42, 0, 0.58, 1). Its Y curve happens to be exactly
-- smoothstep, but its X curve is not linear, so feeding time straight into
-- smoothstep is wrong by up to 0.03 -- visible here as the shape lingering at
-- the circle and rushing the crossing. Solve X for the curve parameter first,
-- then read Y off it.
local function easeInOut(t)
  if t <= 0 then return 0 end
  if t >= 1 then return 1 end
  local s = t
  for _ = 1, 4 do
    local x = ((0.52 * s - 0.78) * s + 1.26) * s - t
    local dx = (1.56 * s - 1.56) * s + 1.26
    if dx <= 1e-6 then break end
    s = s - x / dx
  end
  return (3 - 2 * s) * s * s
end

function Inf.new(parent, size, opts)
  opts = opts or {}
  local self = setmetatable({}, { __index = Inf })

  local px = size / 24                      -- the source box is 24 units wide
  local thick = math.max(2, math.floor(1.5 * px + 0.5))   -- strokeWidth 1.5
  self.size, self.px, self.thick = size, px, thick
  self.t, self.settle = 0, 0

  -- One CanvasGroup so the whole curve fades on a single property. There is no
  -- text inside it, so nothing pays the resampling cost that keeps the loading
  -- screen's wordmark out of one.
  local holder = mk("CanvasGroup", {
    AnchorPoint = opts.AnchorPoint or Vector2.new(0.5, 0.5),
    Position = opts.Position or UDim2.fromScale(0.5, 0.5),
    Size = UDim2.fromOffset(size, size),
    BackgroundTransparency = 1,
    GroupTransparency = opts.transparency or 0,
    ZIndex = opts.ZIndex or 2,
    Name = "Infinity", Parent = parent,
  })
  self.holder = holder

  local colour = opts.colour or T.c.accent
  self.segs = table.create(N)
  for i = 1, N do
    local s = mk("Frame", {
      AnchorPoint = Vector2.new(0.5, 0.5),
      Size = UDim2.fromOffset(thick, thick),
      BackgroundColor3 = colour,
      BorderSizePixel = 0,
      Name = "S" .. i, Parent = holder,
    })
    L.corner(999, s)                        -- round caps, and so round joins
    self.segs[i] = s
  end

  -- scratch, reused every frame: this runs 60 times a second and allocating
  -- three tables per frame is how a loading screen ends up stuttering
  self._n = table.create(26)
  self._x = table.create(N)
  self._y = table.create(N)

  self:update(0)

  if opts.drive ~= false then
    self.conn = L.hold(L.RunService.RenderStepped:Connect(function(dt)
      if not (L.live() and holder.Parent) then return end
      self:update(self.t + dt)
    end))
  end
  return self
end


-- ---------------------------------------------------------------- ring
--
-- WHY THE INFINITY WAS REPLACED, having been the thing that replaced a bar.
--
-- Its whole argument was that a bar tells you a number the percentage already
-- says, and says it worse. That is true. But the infinity then says NOTHING --
-- it is equally busy at 4% and at 96%, so the screen has one element that
-- carries information and one that is purely decorative, and they sit in
-- separate places doing separate jobs.
--
-- This does both at once, and answers the bar objection on its own terms:
--
--   the TRACK is the whole ring, always there, so there is a shape to read
--   the ARC lights from twelve o'clock as progress arrives  -- the number
--   the COMET keeps orbiting regardless                     -- still alive
--
-- The bar's real failure is that 40% and 45% look identical because a bar has
-- no motion of its own to compare against. The comet supplies exactly that: it
-- laps a stationary arc, so the arc's edge is always being pointed at. And
-- unlike the infinity, at 96% it visibly nearly-closed.
--
-- The percentage goes in the middle of it, which is the other half of the
-- reason: three scattered elements (mark, status, percent) become one object
-- with a caption.
local TAIL = 15                 -- comet segments; ~85 degrees at N = 64
local SPIN = 1.45               -- seconds per lap

function Inf.newRing(parent, size, opts)
  opts = opts or {}
  local self = setmetatable({}, { __index = Inf })
  self.isRing = true
  self.size   = size
  self.thick  = opts.thick or math.max(3, math.floor(size * 0.055))
  self.t, self._last = 0, nil
  self.progress, self.progressTo = 0, 0
  self.settle, self.settleTo = 0, 0

  local holder = mk("CanvasGroup", {
    AnchorPoint = opts.AnchorPoint or Vector2.new(0.5, 0.5),
    Position = opts.Position or UDim2.fromScale(0.5, 0.5),
    Size = UDim2.fromOffset(size, size),
    BackgroundTransparency = 1,
    GroupTransparency = opts.transparency or 0,
    ZIndex = opts.ZIndex or 2,
    Name = "Ring", Parent = parent,
  })
  self.holder = holder

  self.colour = opts.colour or T.c.accent
  self.segs = table.create(N)
  for i = 1, N do
    local seg = mk("Frame", {
      AnchorPoint = Vector2.new(0.5, 0.5),
      Size = UDim2.fromOffset(self.thick, self.thick),
      BackgroundColor3 = self.colour,
      BackgroundTransparency = 1,
      BorderSizePixel = 0,
      Name = "S" .. i, Parent = holder,
    })
    L.corner(999, seg)
    self.segs[i] = seg
  end

  -- LAID OUT ONCE. The infinity rebuilds its geometry every frame because its
  -- geometry actually changes; a circle's does not. Only transparency and
  -- colour move here, which is the difference between 64 CFrame-equivalent
  -- writes per frame and 64 float writes.
  local r = size * 0.5 - self.thick * 0.5 - 1
  local half = size / 2
  for i = 1, N do
    local a0 = ((i - 1) / N) * math.pi * 2 - math.pi / 2
    local a1 = (i / N) * math.pi * 2 - math.pi / 2
    local x0, y0 = half + math.cos(a0) * r, half + math.sin(a0) * r
    local x1, y1 = half + math.cos(a1) * r, half + math.sin(a1) * r
    local dx, dy = x1 - x0, y1 - y0
    local len = math.sqrt(dx * dx + dy * dy)
    local seg = self.segs[i]
    seg.Position = UDim2.fromOffset(x0 + dx * 0.5, y0 + dy * 0.5)
    seg.Size = UDim2.fromOffset(len + self.thick, self.thick)
    seg.Rotation = math.deg(math.atan2(dy, dx))
  end

  self:update(0)
  if opts.drive ~= false then
    self.conn = L.hold(L.RunService.RenderStepped:Connect(function(dt)
      if not (L.live() and holder.Parent) then return end
      self:update(self.t + dt)
    end))
  end
  return self
end

-- 0..1. Eased toward rather than snapped, for the same reason the percentage is
-- sprung: a stage boundary is a step in the DATA, never in the picture.
function Inf:setProgress(a)
  self.progressTo = math.clamp(a or 0, 0, 1)
  return self
end

local TRACK_ALPHA = 0.88
local ARC_ALPHA   = 0.30

function Inf:updateRing(t)
  local dt = math.clamp(t - (self._last or t), 0, 0.25)
  self._last, self.t = t, t

  self.progress = self.progress
    + (self.progressTo - self.progress) * (1 - math.exp(-dt / 0.22))
  if self.settleTo ~= self.settle then
    self.settle = self.settle + (self.settleTo - self.settle) * (1 - math.exp(-dt / 0.10))
    if math.abs(self.settleTo - self.settle) < 0.002 then self.settle = self.settleTo end
  end

  -- resolving fills the ring and puts the comet away: the lap is a promise that
  -- something is still happening, and once it is not, the promise has to stop
  local p = self.progress + (1 - self.progress) * self.settle
  local litTo = p * N
  local head = (t / SPIN) % 1 * N
  local cometFade = 1 - self.settle

  for i = 1, N do
    -- partial credit on the leading segment, so the arc grows smoothly instead
    -- of in 1/64 steps -- at this size one step is a visible tick
    local fill = math.clamp(litTo - (i - 1), 0, 1)
    local alpha = TRACK_ALPHA + (ARC_ALPHA - TRACK_ALPHA) * fill

    if cometFade > 0.01 then
      -- distance BEHIND the head, wrapped: the comet is a tail, not a dot
      local d = (head - (i - 1)) % N
      if d < TAIL then
        local w = (1 - d / TAIL)
        w = w * w * cometFade
        alpha = math.min(alpha, TRACK_ALPHA + (0.02 - TRACK_ALPHA) * w)
      end
    end
    self.segs[i].BackgroundTransparency = alpha
  end
  return self
end

-- absolute time in, so a caller that already has a clock can hand us theirs and
-- the two can never drift apart
function Inf:update(t)
  if self.isRing then return self:updateRing(t) end
  local dt = math.clamp(t - (self._last or t), 0, 0.25)
  self._last, self.t = t, t
  local n = self._n

  -- exponential approach rather than a Motion track: Motion's tracks are built
  -- for Instances, and this is a plain table. tau 0.09 puts it at rest inside a
  -- quarter second, under the loader's own handover.
  if self.settleTo and self.settleTo ~= self.settle then
    self.settle = self.settle + (self.settleTo - self.settle) * (1 - math.exp(-dt / 0.09))
    if math.abs(self.settleTo - self.settle) < 0.001 then self.settle = self.settleTo end
  end

  local phase = (t / CYCLE) % 1
  local k = 1
  while k < #TIMES - 1 and phase >= TIMES[k + 1] do k = k + 1 end
  local span = TIMES[k + 1] - TIMES[k]
  local e = easeInOut(span > 0 and (phase - TIMES[k]) / span or 0)
  local a, b = KEYS[k], KEYS[k + 1]
  for i = 1, 26 do n[i] = a[i] + (b[i] - a[i]) * e end

  -- settling blends whatever we are toward the resting circle, so finishing
  -- does not wait for the five second cycle to come back around
  local s = self.settle
  if s > 0 then
    for i = 1, 26 do n[i] = n[i] + (circleA[i] - n[i]) * s end
  end

  -- walk the four cubics
  local px, half = self.px, self.size / 2
  local X, Y = self._x, self._y
  local p = 0
  for seg = 0, 3 do
    local o = seg * 6
    local x0, y0 = n[o + 1], n[o + 2]
    local x1, y1 = n[o + 3], n[o + 4]
    local x2, y2 = n[o + 5], n[o + 6]
    local x3, y3 = n[o + 7], n[o + 8]
    for j = 0, SUB - 1 do
      local u = j / SUB
      local m = 1 - u
      local w0 = m * m * m
      local w1 = 3 * m * m * u
      local w2 = 3 * m * u * u
      local w3 = u * u * u
      p = p + 1
      X[p] = (w0 * x0 + w1 * x1 + w2 * x2 + w3 * x3) * px
      Y[p] = (w0 * y0 + w1 * y1 + w2 * y2 + w3 * y3) * px
    end
  end

  -- lay a rounded bar along each chord. Length carries the full stroke width so
  -- consecutive caps overlap; without it the curve beads at every joint.
  local thick = self.thick
  local segs = self.segs
  for i = 1, N do
    local j = (i % N) + 1
    local ax, ay = X[i], Y[i]
    local dx, dy = X[j] - ax, Y[j] - ay
    local len = math.sqrt(dx * dx + dy * dy)
    local f = segs[i]
    if len < 0.05 then
      -- the lemniscate's own crossing point, where two samples coincide: a zero
      -- length chord has no direction, and atan2(0,0) would spin it randomly
      f.Visible = false
    else
      f.Visible = true
      f.Position = UDim2.fromOffset(ax + dx * 0.5, ay + dy * 0.5)
      f.Size = UDim2.fromOffset(len + thick, thick)
      f.Rotation = math.deg(math.atan2(dy, dx))
    end
  end
  return self
end

-- Bring it to rest on the circle NOW rather than letting it run out its cycle.
-- Loading finishing is the event; the animation has no business adding another
-- two and a half seconds to it.
function Inf:resolve()
  self.settleTo = 1
  return self
end

function Inf:setColour(c)
  self.colour = c
  for i = 1, N do self.segs[i].BackgroundColor3 = c end
  return self
end

function Inf:destroy()
  if self.conn then pcall(function() self.conn:Disconnect() end) end
  pcall(function() self.holder:Destroy() end)
end

end

do -- ==== lm_08_loader.lua ====
-- LUMEN :: LOADER
-- The loading screen.
--
-- No CanvasGroup around the text: one rasterises its subtree to an offscreen
-- buffer, and text drawn through that is resampled and goes soft. Fading walks
-- a list of (object, property, resting value) instead.
--
-- Sizes derive from viewport height, so it renders at its final resolution
-- rather than being authored small and stretched.

local L = getgenv().LUMEN
local T, M, A = L.T, L.Motion, L.A
local mk = L.mk

local Loader = {}
L.Loader = Loader

-- The folder holds 301 frames but the orbit only repeats every 183, starting at
-- 68. Playing the whole folder snapped once per revolution; this window loops.
local ORB_FIRST, ORB_FRAMES, ORB_FPS = 68, 183, 30

-- ---------------------------------------------------------------- skins
--
-- There is more than one loading screen now, and which one runs is a saved
-- preference rather than whichever was compiled in last.
--
-- EVERY SKIN IMPLEMENTS THE SAME FIVE METHODS -- stage, say, flash, finish,
-- fade -- so Hub.launch never learns which one it is driving. That is the whole
-- reason a second screen is cheap to add: the boot sequence is a list of
-- progress calls, not a description of a picture.

Loader.SKINS = { "Aurora", "Made in Heaven" }
Loader.DEFAULT_SKIN = "Aurora"

-- Made in Heaven ships as loose files rather than baked assets, so it can be
-- absent on a fresh install. Asked, never assumed: a picker that offers a
-- screen which then falls back to a different one is worse than a picker that
-- greys the option out.
Loader.MIH = {
  dir = "leakvid", frames = "max", prefix = "f_", count = 685, fps = 30,
  audio = "mih_full_v2.mp3", stand = "stand_v1.png",
  -- 30 FILES, 120 FRAMES. Each 1024x576 backdrop holds a 2x2 grid of 512x288
  -- cells, because Roblox will not take a texture over 1024 px on either axis.
  -- count is frames; the atlas describes how they are packed.
  swirl = "swirl", swirlPrefix = "sw_", swirlCount = 120,
  swirlAtlas = { cols = 2, rows = 2, tile = Vector2.new(512, 288) },
  swirlFps = 15,
}

-- HELD BACK ON PURPOSE, which is a different thing from missing.
--
-- The skin runs -- the files are there, the audio clock works, the stand drives.
-- It is the finish that is not done, and shipping a picker option that opens a
-- half-finished screen makes the whole hub look unfinished on the one screen
-- every user sees first. `skinAvailable` already had a vocabulary for "you
-- cannot have this and here is why", so this uses it rather than inventing a
-- second one -- and every caller that pcalls or checks the reason keeps working
-- unchanged.
--
-- Clearing this table is the whole of shipping it.
Loader.LOCKED = {
  ["Made in Heaven"] = "still in development -- it plays, but it is not finished",
}

function Loader.skinLocked(name)
  return Loader.LOCKED[name]
end

function Loader.skinAvailable(name)
  local heldBack = Loader.LOCKED[name]
  if heldBack then return false, heldBack end
  if name == "Aurora" then return true end
  if name ~= "Made in Heaven" then return false, "unknown skin" end
  local gca = rawget(getgenv(), "getcustomasset") or rawget(getgenv(), "getsynasset")
  if type(gca) ~= "function" then return false, "executor cannot load local files" end
  local M2 = Loader.MIH
  if not (L.Video and L.Video.available) then return false, "no video module" end
  local okV, whyV = L.Video.available(
    M2.dir .. "/" .. M2.frames, M2.prefix, M2.count, 1, 4, ".jpg", 1)
  if not okV then return false, tostring(whyV) end
  local okS, whyS = L.Video.available(
    M2.dir .. "/" .. M2.swirl, M2.swirlPrefix, M2.swirlCount, 1, 2, ".jpg", 4)
  if not okS then return false, tostring(whyS) end
  return true
end

function Loader.skinName()
  local want = L.Cfg and L.Cfg.data and L.Cfg.data.loader
  if type(want) ~= "string" then want = Loader.DEFAULT_SKIN end
  local ok = Loader.skinAvailable(want)
  if not ok then return Loader.DEFAULT_SKIN end
  return want
end

function Loader.setSkin(name)
  local ok, why = Loader.skinAvailable(name)
  if not ok then return false, why end
  if L.Cfg then L.Cfg.set("loader", name) end
  return true, name
end

-- ---------------------------------------------------------------- MIH skin
--
-- A full-bleed sequence with its own audio, wearing the standard loader
-- interface. It does NOT reimplement the progress UI: the status line is one
-- label, because when a 685-frame reveal is playing nobody is reading a
-- six-stage checklist -- they are watching the screen.
local function newMIH(opts)
  local M2 = Loader.MIH
  local self = setmetatable({}, { __index = Loader })
  self.total = math.max(opts.stages or 4, 1)
  self.done = 0
  self._fade = {}
  self.skin = "Made in Heaven"

  local gui = mk("ScreenGui", {
    Name = "LumenLoader", ResetOnSpawn = false, IgnoreGuiInset = true,
    ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 40,
  })
  gui.Parent = L.host()
  L.own(gui)
  self.gui = gui

  -- SIZED FROM THE VIEWPORT, NOT FROM A PIXEL CAP.
  --
  -- The first version capped the card at 760 px. That looked reasonable on the
  -- machine it was checked on and turned into a video thumbnail floating in the
  -- middle of a large display -- which is exactly how it read back: a small
  -- unframed box on a bright background. Aurora derives every size from
  -- viewport height for this reason; so does this now.
  local vp = L.viewport()
  local vy = vp.Y
  local function S(f) return math.floor(vy * f + 0.5) end
  self.S, self.vy = S, vy

  -- The backdrop has to LOSE. At 0.35 the game stayed bright and legible and
  -- competed with the footage the whole way through; the clip is dark and
  -- low-contrast, so anything busy behind it wins. Blurred and heavily dimmed,
  -- the game is still there -- you can see you have not crashed -- but it has
  -- stopped arguing.
  local ground = mk("Frame", {
    Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
    BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 1, Parent = gui,
  })
  self.ground = ground
  M.to(ground, "BackgroundTransparency", 0.12, "slow")
  A.blurTo(L.Window.BLUR or 18, "slow")

  -- The clip is 1024x711, so the card keeps that ratio rather than letterboxing
  -- footage into a shape it was not cut for.
  local cardH = S(0.60)
  local cardW = math.floor(cardH * (1024 / 711))
  if cardW > vp.X * 0.86 then
    cardW = math.floor(vp.X * 0.86)
    cardH = math.floor(cardW * (711 / 1024))
  end
  local CY = 0.50

  -- A GLOW UNDER IT, NOT A BORDER AROUND IT. A hard rectangle on a dark ground
  -- reads as pasted on; light spilling out from behind gives the card somewhere
  -- to sit. Built before the card so it stays underneath.
  if A.img and A.img.glow then
    local sp = math.floor(cardH * 0.55)
    self.cardGlow = mk("ImageLabel", {
      AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, CY),
      Size = UDim2.fromOffset(cardW + sp, cardH + sp),
      BackgroundTransparency = 1, Image = A.img.glow,
      ImageColor3 = T.c.accent, ImageTransparency = 1,
      ZIndex = 1, Parent = gui,
    })
    M.to(self.cardGlow, "ImageTransparency", 0.82, "slow")
  end

  local card = mk("Frame", {
    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, CY),
    Size = UDim2.fromOffset(math.floor(cardW * 0.94), math.floor(cardH * 0.94)),
    BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0,
    ClipsDescendants = true, ZIndex = 2, Name = "Stage", Parent = gui,
  })
  L.corner(T.r.lg, card)
  L.stroke(T.c.lineStrong, 1, 0.55, card)
  -- it arrives at size rather than appearing at it
  M.to(card, "Size", UDim2.fromOffset(cardW, cardH), "slow")

  -- WORDMARK ABOVE, STATUS BELOW. The old build had a 10 px status line and
  -- nothing else, so there was no way to tell whose loading screen it was.
  local GLYPH = S(0.038)
  self.wordLbl = A.text({
    Text = L.track(tostring(opts.title or getgenv().LUMEN_HUB_NAME or "Untitled"), 3),
    font = T.font.display, size = GLYPH, colour = T.c.text,
    align = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0.5, 1),
    Position = UDim2.new(0.5, 0, CY, -cardH / 2 - S(0.030)),
    Size = UDim2.fromOffset(S(0.9), math.floor(GLYPH * 1.4)),
    ZIndex = 8, Parent = gui,
  })
  M.set(self.wordLbl, "TextTransparency", 1)
  M.to(self.wordLbl, "TextTransparency", 0, "slow")

  self.subLbl = A.text({
    Text = tostring(opts.subtitle or ""),
    font = T.font.body, size = S(0.0135), colour = T.c.textMute,
    align = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0.5, 1),
    Position = UDim2.new(0.5, 0, CY, -cardH / 2 - S(0.012)),
    Size = UDim2.fromOffset(S(0.9), S(0.03)),
    ZIndex = 8, Parent = gui,
  })
  M.set(self.subLbl, "TextTransparency", 1)
  M.to(self.subLbl, "TextTransparency", 0.25, "slow")
  -- NOT self.stage: Loader:stage() is a METHOD, and an instance field of the
  -- same name shadows it. Assigning the card there made loader:stage("...")
  -- try to CALL a Frame, which killed the boot sequence at step 0 of 6 while
  -- the video carried on playing -- so the screen looked perfectly healthy and
  -- the hub simply never appeared.
  self.card = card

  -- the swirl runs behind on its own slower clock, so the two sequences do not
  -- beat against each other at a shared frame rate
  self.swirl = L.Video and L.Video.new(card, {
    folder = M2.dir .. "/" .. M2.swirl, prefix = M2.swirlPrefix,
    count = M2.swirlCount, fps = M2.swirlFps, loop = true,
    digits = 2, ext = ".jpg", atlas = M2.swirlAtlas,
    Size = UDim2.fromScale(1, 1), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 2,
  })

  -- MANUAL, because the audio is the clock. Left to its own RenderStepped
  -- timer the picture drifts against the music within a few seconds -- and this
  -- clip is cut to the track, so drift is the one thing that ruins it. The
  -- sound reports where it actually is; the picture follows that.
  self.vid = L.Video and L.Video.new(card, {
    folder = M2.dir .. "/" .. M2.frames, prefix = M2.prefix,
    count = M2.count, fps = M2.fps, loop = false, manual = true,
    digits = 4, ext = ".jpg",
    Size = UDim2.fromScale(1, 1), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 3,
  })

  local gca = rawget(getgenv(), "getcustomasset") or rawget(getgenv(), "getsynasset")
  if gca then
    local okS, id = pcall(gca, M2.dir .. "/" .. M2.audio)
    if okS and id then
      local snd = mk("Sound", { SoundId = id, Volume = 1, Looped = false, Parent = gui })
      self.sound = snd
      -- PLAY AFTER IsLoaded, NOT BEFORE. Calling Play on a Sound that has not
      -- finished loading does nothing and reports nothing -- the first version
      -- of this ran the whole sequence in silence with TimePosition stuck at
      -- 0.00, which also stranded the picture, because the audio is its clock.
      -- Measured: the file loads in well under a second and is 22.91 s long.
      task.spawn(function()
        for _ = 1, 80 do
          if snd.IsLoaded then break end
          task.wait(0.05)
        end
        if snd.Parent then pcall(function() snd:Play() end) end
      end)
    end
    -- ---- the stand ---------------------------------------------------
    --
    -- IT DOES NOT LIVE IN THE MIDDLE, AND IT DOES NOT FADE IN.
    --
    -- Made in Heaven's whole conceit is that it has already been everywhere. A
    -- thing that strobes in one place is a flickering image; a thing that is in
    -- a DIFFERENT place every time you catch it has been moving between the
    -- glimpses, faster than you can see -- and the viewer supplies that
    -- inference for free, which is why it needs no motion trail.
    --
    -- So every burst picks a new anchor, scale and facing, and inside a longer
    -- burst it jumps AGAIN mid-strobe: two glimpses 30 ms apart in different
    -- places read as being in both at once rather than as travelling between.
    local okI, sid = pcall(gca, M2.dir .. "/" .. M2.stand)
    if okI and sid then
      local st = {}
      local holder = mk("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.47),
        Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1,
        ZIndex = 6, Parent = card,
      })
      st.holder = holder

      -- HEAVENLY MEANS LIGHT BEHIND IT, not a brighter picture. The fan and the
      -- bloom are parented to the holder, so when the stand jumps the light
      -- jumps with it as one object instead of trailing behind.
      local rays = mk("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1,
        ZIndex = 6, Parent = holder,
      })
      st.rays, st.rayList = rays, {}
      for i = 1, 28 do
        local a = (i / 28) * math.pi * 2
        local r = mk("Frame", {
          AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(2, 300),
          BackgroundColor3 = Color3.fromRGB(255, 246, 220), BackgroundTransparency = 1,
          BorderSizePixel = 0, Rotation = math.deg(a) + 90, ZIndex = 6, Parent = rays,
        })
        st.rayList[i] = { f = r, a = a }
      end

      -- Fourteen discs on a QUADRATIC falloff read as one glow. A linear ramp
      -- across this few shows as concentric bands.
      st.bloom = {}
      for i = 1, 14 do
        local b = mk("Frame", {
          AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
          Size = UDim2.fromOffset(10, 10),
          BackgroundColor3 = Color3.fromRGB(255, 248, 228), BackgroundTransparency = 1,
          BorderSizePixel = 0, ZIndex = 6, Parent = holder,
        })
        L.corner(999, b)
        st.bloom[i] = { f = b, k = i / 14 }
      end

      -- Three copies of the same image: a red and a cyan pass offset against
      -- each other for the chromatic tear, and the white one on top.
      local function layer(colour, z)
        return mk("ImageLabel", {
          AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
          Size = UDim2.fromOffset(S(0.30), S(0.47)), BackgroundTransparency = 1,
          ScaleType = Enum.ScaleType.Fit, Image = sid, ImageTransparency = 1,
          ImageColor3 = colour, ZIndex = z, Parent = holder,
        })
      end
      st.r = layer(Color3.fromRGB(255, 60, 70), 7)
      st.c = layer(Color3.fromRGB(60, 230, 255), 7)
      st.main = layer(Color3.new(1, 1, 1), 8)
      self.stand = st
    end
  end

  -- ONE LOOP DRIVES BOTH. The picture is seeked from the sound, and the stand
  -- is revealed on a cue measured in seconds of the track rather than in frames
  -- of the clip, so it lands in the same place whatever the playback does.
  local clipLen = M2.count / M2.fps
  self._t = 0
  self.conn = L.hold(L.RunService.RenderStepped:Connect(function(dt)
    if not L.live() or not gui.Parent then return end
    self._t = self._t + dt
    local at = self._t
    local snd = self.sound
    if snd and snd.IsPlaying and snd.TimePosition > 0 then at = snd.TimePosition end
    if self.vid then
      local want = math.floor(at * M2.fps) + 1
      if want > M2.count then want = M2.count end
      self.vid:setFrame(want)
    end
    -- THE STAND IS PACED BY THE BOOT, NOT BY THE CLIP.
    --
    -- Measured: the hub finishes loading about 9 s in and the clip runs 22.8 s,
    -- so driving the stand off clip time meant it never left its opening
    -- section -- cubed pressure at that point is 0.04, which is a burst every
    -- 1.3 s lasting 0.08 s, and the escalation and the p>=0.93 hold simply never
    -- happened. The footage got cut off mid-sentence every single time.
    --
    -- Pacing it by how much of the BOOT is done means the finale lands exactly
    -- as the hub appears, whether that takes four seconds or twenty. The picture
    -- and the audio keep their own clock; only the apparition follows the work.
    if self.stand then
      local boot = math.clamp((self.done or 0) / math.max(self.total or 1, 1), 0, 1)
      local byClip = at / clipLen
      self:_driveStand(at, math.max(boot, byClip * 0.35))
    end
  end))
  self.clipLen = clipLen

  self.status = A.text({
    Text = opts.status or "starting", font = T.font.mono, size = S(0.0125),
    colour = T.c.textDim, align = Enum.TextXAlignment.Center,
    AnchorPoint = Vector2.new(0.5, 0),
    Position = UDim2.new(0.5, 0, CY, cardH / 2 + S(0.028)),
    Size = UDim2.fromOffset(S(0.9), S(0.03)), ZIndex = 8, Parent = gui,
  })

  -- A VIGNETTE INSIDE THE CARD, so the footage falls off into its own edge
  -- instead of stopping dead at a rectangle. Wide and weak: narrow strong edges
  -- stack at the corners into visible dark blobs.
  if A.img and A.img.glow then
    self.vig = mk("ImageLabel", {
      AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
      Size = UDim2.fromScale(1.9, 1.9), BackgroundTransparency = 1,
      Image = A.img.glow, ImageColor3 = Color3.new(0, 0, 0),
      ImageTransparency = 0.55, ZIndex = 7, Parent = card,
    })
  end
  return self
end

function Loader.new(opts)
  opts = opts or {}
  -- SKIN DISPATCH. Anything that is not the default hands off entirely; the
  -- rest of this function is Aurora and only Aurora.
  if Loader.skinName() == "Made in Heaven" then
    local okB, alt = pcall(newMIH, opts)
    if okB and alt then return alt end
  end
  local self = setmetatable({}, { __index = Loader })
  self.total = math.max(opts.stages or 4, 1)
  self.done = 0
  self._fade = {}

  local gui = mk("ScreenGui", {
    Name = "LumenLoader", ResetOnSpawn = false, IgnoreGuiInset = true,
    ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 50,
  })
  gui.Parent = L.host()
  L.own(gui)
  self.gui = gui

  -- No UIScale: every size derives from viewport height, so the composition is
  -- rasterised at its final resolution instead of authored small and stretched.
  local vy = L.viewport().Y
  local function S(f) return math.floor(vy * f + 0.5) end
  self.S, self.vy = S, vy

  A.blurTo(L.Window.BLUR, "slow")

  -- Register something to fade, remembering the transparency it rests at.
  local function fadable(obj, prop)
    self._fade[#self._fade + 1] = { obj = obj, prop = prop, base = obj[prop] }
    return obj
  end

  local root = mk("Frame", {
    Size = UDim2.fromScale(1, 1),
    BackgroundColor3 = Color3.fromRGB(3, 4, 7),
    BackgroundTransparency = 0.02,
    BorderSizePixel = 0,
    Name = "Root", Parent = gui,
  })
  self.root = root
  fadable(root, "BackgroundTransparency")

  -- Living backdrop: drifting wash, a sparse star field breathing on its own
  -- phases, a slow light sweep, and linear edge falloff. It registers its own
  -- fadable parts with us rather than being wrapped in a CanvasGroup, so none of
  -- it costs the text its crispness.
  -- The orb's centre and size are handed to the backdrop so the pulse rings
  -- originate from the hero rather than from the middle of the screen.
  self.backdrop = L.Backdrop.new(root, {
    ZIndex = 0,
  })
  for _, e in ipairs(self.backdrop:faders()) do
    self._fade[#self._fade + 1] = { obj = e.obj, prop = e.prop, base = e.obj[e.prop] }
  end

  local ORB   = S(0.34)
  local CY    = 0.40
  local below = function(px) return UDim2.new(0.5, 0, CY, ORB * 0.5 + px) end

  -- ---- the orb, from the real footage --------------------------------
  local vgroup = mk("CanvasGroup", {
    AnchorPoint = Vector2.new(0.5, 0.5),
    Position = UDim2.new(0.5, 0, CY, 0),
    Size = UDim2.fromOffset(ORB, ORB),
    BackgroundTransparency = 1,
    GroupTransparency = 0,
    Name = "OrbGroup", Parent = root,
  })
  fadable(vgroup, "GroupTransparency")

  local vid = L.Video.new(vgroup, {
    folder = "lumen_fx/saturn", prefix = "sat", first = ORB_FIRST,
    count = ORB_FRAMES, fps = ORB_FPS, size = ORB,
    Position = UDim2.fromScale(0.5, 0.5), ZIndex = 3, loop = true,
  })
  if vid then
    self.orb, self.isVideo = vid, true
  else
    pcall(function() vgroup:Destroy() end)
    self.orb = L.Orb.new(root, ORB, {
      Position = UDim2.new(0.5, 0, CY, 0), ZIndex = 3, speed = 1,
    })
    self.isVideo = false
  end

  -- ---- wordmark, assembled per letter --------------------------------
  local word = tostring(opts.title or getgenv().LUMEN_HUB_NAME or "Untitled")
  local GLYPH = S(0.052)
  local holder = mk("Frame", {
    AnchorPoint = Vector2.new(0.5, 0),
    Position = below(S(0.045)),
    Size = UDim2.fromOffset(S(0.55), math.floor(GLYPH * 1.25)),
    BackgroundTransparency = 1, Name = "Word", Parent = root,
  })
  local lay = L.list(math.max(2, S(0.003)), Enum.FillDirection.Horizontal, holder)
  lay.HorizontalAlignment = Enum.HorizontalAlignment.Center
  lay.VerticalAlignment = Enum.VerticalAlignment.Center

  -- ONE SWEEP ACROSS THE WORD, NOT FIVE LETTERS FLASHING SEPARATELY.
  --
  -- The wordmark is five independent TextLabels in a list layout, so a gradient
  -- per glyph would give each its own highlight and read as a row of blinking
  -- letters. A.chromeSeq takes a SLICE of the shared pattern, so glyph i is
  -- handed the window [i/n, (i+1)/n] of one continuous sweep -- and the light
  -- crosses the word the way it crosses a page title.
  -- Exactly what a page title uses: same palette, same rotation, same 12.5 s
  -- pass. The wordmark is five labels, so each gets a slice of one sweep.
  self.chromePat = A.chromePattern(A.CHROME.__default)
  self.chromeSpeed = A.CHROME.__default.speed
  self.glyphGrads = {}

  self.glyphs = {}
  for i = 1, #word do
    local ch = A.text({
      Text = word:sub(i, i),
      font = T.font.display, size = GLYPH, colour = T.c.text,
      align = Enum.TextXAlignment.Center,
      Size = UDim2.fromOffset(math.floor(GLYPH * 0.80), math.floor(GLYPH * 1.25)),
      LayoutOrder = i, Parent = holder,
    })
    ch.TextTransparency = 1
    self.glyphGrads[i] = mk("UIGradient", {
      Color = A.chromeSeq(self.chromePat, 0, (i - 1) / #word, i / #word),
      Rotation = A.CHROME.__default.rot, Parent = ch,
    })
    self.glyphs[i] = ch
    M.set(ch, "Position", UDim2.fromOffset(0, math.floor(GLYPH * 0.45)))
    M.after(0.12 + (i - 1) * 0.055, function()
      M.to(ch, "TextTransparency", 0, "base")
      M.to(ch, "Position", UDim2.fromOffset(0, 0), "expressive")
    end)
  end

  local SUB = S(0.0135)
  self.subLbl = A.text({
    Text = opts.subtitle or "",
    font = T.font.medium, size = SUB, colour = T.c.textMute,
    align = Enum.TextXAlignment.Center,
    AnchorPoint = Vector2.new(0.5, 0),
    Position = below(S(0.108)), Size = UDim2.fromOffset(S(0.6), SUB * 2),
    Parent = root,
  })
  fadable(self.subLbl, "TextTransparency")
  -- arrives after the wordmark has finished assembling, so the eye is led down
  self.subLbl.TextTransparency = 1
  M.set(self.subLbl, "Position", below(S(0.108) + S(0.010)))
  M.after(0.12 + #word * 0.055 + 0.10, function()
    M.to(self.subLbl, "TextTransparency", 0, "base")
    M.to(self.subLbl, "Position", below(S(0.108)), "expressive")
  end)

  -- ---- progress ------------------------------------------------------
  --
  -- A SHAPE, NOT A BAR. A progress bar spends its whole life telling you a
  -- number the percentage underneath it already says, and it says it worse --
  -- a bar at 40% and a bar at 45% look the same. The morphing infinity says
  -- the only other thing a loading screen has to communicate, which is that
  -- the thing is alive and still working, and it says that continuously.
  local SUB_BOTTOM = 0.108 + 0.0135 * 2      -- subtitle top + its own height
  -- The mark replaced a bar that was a third of the screen wide. At the same
  -- optical weight as a bar it would dominate; at the size the reference uses
  -- inline it disappeared into the gap the bar left. This is the size where it
  -- reads as deliberate against a 0.34 orb and a display-size wordmark.
  local MARK_H     = 0.105
  local BREATH     = 0.010
  local MARK_Y     = SUB_BOTTOM + MARK_H / 2 + BREATH
  local STATUS_Y   = MARK_Y + MARK_H / 2 + BREATH

  local BAR_W = S(0.34)                      -- the column the status row sits in

  local INF = S(MARK_H)
  self.inf = L.Infinity.newRing(root, INF, {
    Position = below(S(MARK_Y)),
    colour = T.c.accent,
    ZIndex = 2,
    -- NOT SELF DRIVEN. This screen already has one RenderStepped running the
    -- percentage, the shimmer and the wordmark's breathing; a second clock for
    -- the curve is a second thing to fall out of step on a bad frame. It gets
    -- handed the same time value as everything else below.
    drive = false,
  })
  fadable(self.inf.holder, "GroupTransparency")


  -- status and percent on one line, in the same column the mark is centred on
  local MONO = S(0.0125)
  self.statusPair, self.statusIdx = {}, 1
  for k = 1, 2 do
    local lbl = A.text({
      Text = (k == 1) and (opts.status or "starting") or "",
      font = T.font.mono, size = MONO, colour = T.c.textMute,
      -- CENTRED NOW THAT IT IS ALONE. It was left-aligned in a column shared
      -- with a right-aligned percentage; with the percentage moved inside the
      -- ring, keeping it left just parks one short word off to one side of a
      -- screen whose every other element is centred.
      align = Enum.TextXAlignment.Center,
      AnchorPoint = Vector2.new(0.5, 0),
      Position = below(S(STATUS_Y)), Size = UDim2.fromOffset(BAR_W, MONO * 2),
      Parent = root,
    })
    lbl.TextTransparency = (k == 1) and 0 or 1
    self.statusPair[k] = lbl
    fadable(lbl, "TextTransparency")
  end
  self.status = self.statusPair[1]
  self._statusY = S(STATUS_Y)
  self._below = below

  -- INSIDE THE RING, NOT BESIDE IT.
  --
  -- It used to sit at the right end of the status row, which put the two things
  -- that describe the same fact -- how far along this is -- at opposite ends of
  -- the screen, with a decorative mark between them. The ring carries the
  -- progress now, so the number belongs in the middle of it: one object that
  -- says the same thing twice, precisely and approximately, instead of three
  -- objects saying different things in different places.
  --
  -- Bigger, too. It is the only number on the screen.
  local PCT = S(0.020)
  self.pct = A.text({
    Text = "0%", font = T.font.mono, size = PCT, colour = T.c.text,
    align = Enum.TextXAlignment.Center, valign = Enum.TextYAlignment.Center,
    AnchorPoint = Vector2.new(0.5, 0.5),
    Position = below(S(MARK_Y)),
    Size = UDim2.fromOffset(S(MARK_H), S(MARK_H)),
    ZIndex = 3, Parent = root,
  })
  fadable(self.pct, "TextTransparency")

  -- One line below the status row, hidden until there is something to wait for.
  -- Wider than the status column because it carries a sentence, not a word.
  self.flashLbl = A.text({
    Text = "", font = T.font.mono, size = MONO, colour = T.c.accent,
    align = Enum.TextXAlignment.Center,
    AnchorPoint = Vector2.new(0.5, 0),
    Position = below(S(STATUS_Y + 0.030)),
    Size = UDim2.fromOffset(S(0.62), MONO * 2),
    Visible = false, Parent = root,
  })
  fadable(self.flashLbl, "TextTransparency")

  -- ---- continuous motion ----------------------------------------------
  -- One connection drives everything that is always moving: the percentage
  -- counting up, the curve morphing, and the wordmark breathing.
  self.pctSpring = L.Spring.new(0.75, -0.25, 0)   -- overdamped: a counter must
  self._wordT = 0                                  -- never tick past its target
  self.animConn = L.hold(L.RunService.RenderStepped:Connect(function(dt)
    if not L.live() or not root.Parent then return end

    -- percentage COUNTS rather than jumping between stage values
    local v = self.pctSpring:step(dt)
    local shown = math.floor(v + 0.5)
    if shown ~= self._lastPct then
      self._lastPct = shown
      self.pct.Text = shown .. "%"
    end

    -- THE CURVE RUNS ON THIS CLOCK, NOT ITS OWN. Handed the same accumulating
    -- time as the wordmark's breathing, so the two can never drift; and it is
    -- driven right through the exit rather than being cut off at `leaving`,
    -- because the settle to the circle happens DURING the fade and stopping the
    -- updates would freeze it mid-morph while it faded.
    self._wordT = self._wordT + dt
    if self.inf then
      -- the ring is handed the same figure the counter is easing toward, so the
      -- arc and the number can never disagree about where we are
      if self.inf.setProgress then self.inf:setProgress((self.pctSpring.value or 0) / 100) end
      self.inf:update(self._wordT)
    end

    -- THE DOWNLOAD LINE FLASHES, because it is the one thing on this screen the
    -- user is actually waiting on. Everything else here breathes gently; this
    -- pulses hard enough to read as "something is happening, keep waiting"
    -- rather than as decoration. Driven off the same clock as the rest, so it
    -- cannot drift out of step with the wordmark underneath it.
    if self.flashLbl and self.flashLbl.Visible and not self.leaving then
      local p = 0.5 + 0.5 * math.sin(self._wordT * 4.2)
      self.flashLbl.TextTransparency = 0.72 - 0.72 * p
    end

    -- wordmark breathes once it has finished arriving, staggered per glyph so it
    -- ripples along the word instead of pulsing as a block
    if not self.leaving
       and self._wordT > 0.12 + #self.glyphs * 0.055 + 0.5 then
      for i, g in ipairs(self.glyphs) do
        g.TextTransparency = 0.06 + math.sin(self._wordT * 1.15 + i * 0.55) * 0.06
      end
    end

    -- CHROME. Same throttle as the page titles and for the same reason: the
    -- phase stays continuous, only the rebuild is paced. Five glyphs at 24 Hz
    -- is 120 sequence builds a second on a screen that exists for four.
    if self.glyphGrads then
      self._chromeAcc = (self._chromeAcc or 1) + dt
      if self._chromeAcc >= 1 / 24 then
        self._chromeAcc = 0
        local n = #self.glyphGrads
        local phase = (self._wordT * self.chromeSpeed * 0.5) % 1
        for i, g in ipairs(self.glyphGrads) do
          g.Color = A.chromeSeq(self.chromePat, phase, (i - 1) / n, i / n)
        end
      end
    end
  end))

  -- ---- entrance ------------------------------------------------------
  self:fade(1, true)
  self:fade(0, false, "base")

  return self
end

-- alpha 0 = fully visible, 1 = gone. Walking a list keeps the group fade without
-- forcing the text through a render target to get it.
function Loader:fade(alpha, immediate, token)
  for _, e in ipairs(self._fade) do
    local v = e.base + (1 - e.base) * alpha
    if immediate then M.set(e.obj, e.prop, v)
    else M.to(e.obj, e.prop, v, token or "base") end
  end
  -- glyphs run their own entrance cascade, so they are only driven on the exit
  if alpha > 0 and self.glyphs then
    for _, g in ipairs(self.glyphs) do
      if immediate then M.set(g, "TextTransparency", alpha)
      else M.to(g, "TextTransparency", alpha, token or "base") end
    end
  end
end

-- The flashing wait line. Pass nil to put it away.
function Loader:flash(text)
  if not self.flashLbl then return self end
  if text == nil then
    self.flashLbl.Visible = false
    return self
  end
  self.flashLbl.Text = tostring(text)
  self.flashLbl.Visible = true
  return self
end

function Loader:stage(text)
  self.done = math.min(self.done + 1, self.total)
  if text then self:say(text) end
  if not self.pctSpring then return self end   -- MIH shows no percentage
  local a = self.done / self.total
  self.pctSpring:to(a * 100)
  return self
end

function Loader:say(text)
  if not text then return self end
  -- MIH carries ONE plain label, Aurora a swapping pair. Branching here rather
  -- than giving MIH a fake statusPair keeps the difference visible: the two
  -- screens genuinely say things differently, and pretending otherwise is how a
  -- shared interface turns into a shared implementation nobody can change.
  if self.skin == "Made in Heaven" then
    if self.status then
      self.status.Text = tostring(text)
      M.set(self.status, "TextTransparency", 1)
      M.to(self.status, "TextTransparency", 0, "base")
    end
    return self
  end
  local nextIdx = (self.statusIdx % 2) + 1
  local outLbl, inLbl = self.statusPair[self.statusIdx], self.statusPair[nextIdx]
  self.statusIdx, self.status = nextIdx, inLbl

  inLbl.Text = tostring(text)
  M.set(inLbl, "TextTransparency", 1)
  M.set(inLbl, "Position", self._below(self._statusY + self.S(0.008)))
  M.to(inLbl, "TextTransparency", 0, "base")
  M.to(inLbl, "Position", self._below(self._statusY), "expressive")

  M.to(outLbl, "TextTransparency", 1, "fast")
  M.to(outLbl, "Position", self._below(self._statusY - self.S(0.008)), "base")
  return self
end

function Loader:finish(after)
  if self.skin == "Made in Heaven" then
    -- A screen that fades out while its music keeps playing over the hub is the
    -- kind of thing nobody notices until it ships.
    self:say("ready")
    self:stopMIH()
    local g = self.gui
    if g then
      -- EVERY GuiObject, NOT JUST IMAGES AND TEXT.
      --
      -- The first version faded ImageLabels and TextLabels and left the bloom
      -- and the ray fan behind -- 14 discs and 28 rays, all plain Frames, all
      -- still lit over the hub after the screen was supposedly gone. Measured:
      -- 38 descendants still opaque with the loader "finished".
      for _, d in ipairs(g:GetDescendants()) do
        if d:IsA("ImageLabel") then
          M.to(d, "ImageTransparency", 1, "slow")
        elseif d:IsA("TextLabel") or d:IsA("TextButton") then
          M.to(d, "TextTransparency", 1, "fast")
          if d.BackgroundTransparency < 1 then
            M.to(d, "BackgroundTransparency", 1, "fast")
          end
        elseif d:IsA("GuiObject") then
          M.to(d, "BackgroundTransparency", 1, "slow")
        end
        if d:IsA("UIStroke") then M.to(d, "Transparency", 1, "slow") end
      end
      if self.card then
        M.to(self.card, "Size", UDim2.fromOffset(
          math.floor(self.card.AbsoluteSize.X * 0.94),
          math.floor(self.card.AbsoluteSize.Y * 0.94)), "slow")
      end

      -- DISABLED BEFORE DESTROYED, and destroyed on a generation-guarded delay.
      -- A ScreenGui that outlives its fade is invisible but still hit-testable;
      -- leaving one over the hub is a dead zone nobody can explain later.
      -- `after` IS A CALLBACK, NOT A DELAY. Aurora calls it once its fade has
      -- run, and it is what reveals the hub window -- so treating it as a
      -- number both threw ("arithmetic on function and number") and skipped the
      -- reveal entirely. Same contract here: fade, hand over, then clean up.
      task.delay(0.52, function()
        if after then L.try("loader.after", after) end
      end)
      task.delay(0.75, function()
        if g and g.Parent then g.Enabled = false end
      end)
      task.delay(1.3, function()
        pcall(function() g:Destroy() end)
        if L.Hub and L.Hub._loader == self then L.Hub._loader = nil end
      end)
    end
    return self
  end
  self:say("ready")
  self.pctSpring:to(100)

  -- THE CURVE STOPS WHEN LOADING STOPS, NOT WHEN ITS CYCLE ENDS. It is on a
  -- five second loop and loading rarely takes five seconds, so left alone it
  -- would be caught mid-morph -- a half-formed shape fading out, which reads as
  -- the screen being cut off rather than finishing. Asking it to resolve here,
  -- a beat BEFORE the fade starts, means it has come to rest on the circle by
  -- the time anything moves.
  if self.inf then self.inf:resolve() end

  task.delay(0.26, function()          -- one beat to read "ready" at 100%
    if not L.live() then return end
    self.leaving = true                -- the render loop lets go of the wordmark

    -- THE WINDOW COMES UP AS THE LOADER GOES DOWN. These used to be sequential:
    -- fade the loader for 0.52 s, THEN show the window -- so after "ready" the
    -- screen held a blurred game and nothing else for most of a second. The two
    -- are one handover, so they run on one clock.
    self:fade(1, false, "base")
    if after then L.try("loader.after", after) end

    -- derived from the token, not typed: a literal here is a third clock that
    -- drifts the moment anyone changes the motion profile
    local dur = select(1, M.resolve("base"))
    task.delay(dur + 0.08, function()
      if self.orb and self.orb.destroy then self.orb:destroy() end
      if self.inf then self.inf:destroy() end
      pcall(function() self.gui:Destroy() end)
    end)
  end)
  return self
end

-- MIH overrides only what differs. stage/say/flash all land on one line here,
-- because a six-stage checklist over a full-screen reveal is a checklist nobody
-- reads -- and fade/finish already work on self._fade, which it populates.
function Loader:isMIH() return self.skin == "Made in Heaven" end

-- MIH owns a sound and a drive loop, so its teardown has to do more than fade.
-- Loader:finish is shared, and a screen that fades out while its music keeps
-- playing over the hub is the kind of thing nobody notices until it ships.
function Loader:stopMIH()
  if self.conn then pcall(function() self.conn:Disconnect() end) self.conn = nil end
  -- THE PLAYERS HAVE THEIR OWN LOOPS. Disconnecting only the drive loop left
  -- the swirl advancing, and every frame it advanced it re-set that frame's
  -- ImageTransparency back to its resting value -- so the fade was being undone
  -- as fast as it was applied. One backdrop frame was still fully opaque over
  -- the hub with the loader "finished".
  for _, v in ipairs({ self.vid, self.swirl }) do
    if v then
      if v.pause then pcall(function() v:pause() end) end
      if v.conn then pcall(function() v.conn:Disconnect() end) end
    end
  end
  if self.sound then
    local snd = self.sound
    M.to(snd, "Volume", 0, "slow")
    task.delay(0.7, function() pcall(function() snd:Stop() end) end)
  end
end

-- ---------------------------------------------------------------- stand drive
--
-- `p` is progress through the clip, 0..1. Pressure is CUBED so the first half
-- stays sparse and the last quarter comes apart -- a linear ramp spends its
-- whole budget early and has nowhere left to go at the end.
function Loader:_driveStand(now, p)
  local S = self.stand
  if not (S and S.main and S.main.Parent) then return end

  local pressure = math.clamp((p - 0.14) / 0.76, 0, 1)
  pressure = pressure * pressure * pressure
  local hold = p >= 0.93

  self._burstUntil = self._burstUntil or 0
  self._nextBurst  = self._nextBurst or 0
  self._strobeAt   = self._strobeAt or 0
  self._jumpAt     = self._jumpAt or 0
  self._anchor     = self._anchor or { x = 0.5, y = 0.47, s = 1, face = 1 }

  local A = self._anchor
  local function reanchor()
    -- biased away from dead centre and kept off the lower third, so the clip
    -- underneath is never fully covered
    A.x = 0.18 + math.random() * 0.64
    A.y = 0.28 + math.random() * 0.26
    A.s = 0.5 + math.random() * (0.5 + pressure * 0.55)
    A.face = (math.random() < 0.5) and -1 or 1
  end

  local visible, tear
  if hold then
    -- the finale settles: centre, full size, and a steady shimmer instead of
    -- the random tear, so the last thing you see is legible
    visible, tear = true, 7 + math.sin(now * 26) * 6
    A.x, A.y, A.s, A.face = 0.5, 0.47, 1.0, 1
  else
    if now >= self._nextBurst then
      self._burstUntil = now + 0.07 + pressure * 0.30
      self._nextBurst  = self._burstUntil
        + (0.95 - pressure * 0.85) * (0.4 + math.random() * 0.7)
      reanchor()
      self._jumpAt = now + 0.05 + math.random() * 0.09
    end
    if now < self._burstUntil then
      if now >= self._strobeAt then
        self._strobeOn = not self._strobeOn
        self._strobeAt = now + (0.012 + math.random() * 0.030)  -- 1-2 frames @30
      end
      if now >= self._jumpAt then
        reanchor()
        self._jumpAt = now + 0.05 + math.random() * 0.10
      end
      visible = self._strobeOn
      tear = 5 + math.random() * (7 + pressure * 30)
    else
      visible = false
    end
  end

  S.holder.Position = UDim2.fromScale(A.x, A.y)

  if not visible then
    S.main.ImageTransparency, S.r.ImageTransparency, S.c.ImageTransparency = 1, 1, 1
    for _, b in ipairs(S.bloom) do b.f.BackgroundTransparency = 1 end
    for _, r in ipairs(S.rayList) do r.f.BackgroundTransparency = 1 end
    return
  end

  local a = hold and 0.04 or (0.06 + (1 - pressure) * 0.22)
  S.main.ImageTransparency = a
  S.r.ImageTransparency = a + 0.32
  S.c.ImageTransparency = a + 0.32

  local base = self.S and self.S(0.30) or 398
  local w, h = base * A.s, base * (620 / 398) * A.s
  S.main.Size = UDim2.fromOffset(w * A.face, h)
  S.r.Size    = UDim2.fromOffset(w * A.face, h)
  S.c.Size    = UDim2.fromOffset(w * A.face, h)

  -- ASYMMETRIC ON PURPOSE. Equal offsets in opposite directions cancel into
  -- something that merely looks embossed; unequal ones read as a signal tearing.
  local jx = (math.random() - 0.5) * tear * 0.7
  local jy = (math.random() - 0.5) * tear * 0.4
  S.r.Position    = UDim2.new(0.5, -tear + jx, 0.5, jy)
  S.c.Position    = UDim2.new(0.5, tear * 0.72 - jx, 0.5, -jy * 0.6)
  S.main.Position = UDim2.new(0.5, jx * 0.35, 0.5, jy * 0.35)

  local glow = hold and 1 or (0.45 + pressure * 0.55)
  local d0 = 300 * A.s
  for _, b in ipairs(S.bloom) do
    local d = d0 * (0.3 + b.k * 1.6)
    b.f.Size = UDim2.fromOffset(d, d)
    local fall = 1 - b.k
    b.f.BackgroundTransparency = 1 - glow * fall * fall * 0.45
  end

  S.rays.Rotation = (now * 26) % 360
  local reach = (150 + pressure * 90) * A.s
  for _, r in ipairs(S.rayList) do
    r.f.Position = UDim2.fromOffset(math.cos(r.a) * reach, math.sin(r.a) * reach)
    r.f.Size = UDim2.fromOffset(2, 220 * A.s)
    r.f.BackgroundTransparency = 1 - glow * 0.30
  end
end


end

do -- ==== lm_16_theme.lua ====
-- LUMEN :: THEME
-- Accent palettes, motion profiles, density and blur.

local L = getgenv().LUMEN
local T, M = L.T, L.Motion

local Theme = {}
L.Theme = Theme

-- ---------------------------------------------------------------- palettes
local rgb = Color3.fromRGB

Theme.palettes = {
  chrome = { name = "Chrome", accent = rgb(138, 176, 255), alt = rgb(196, 182, 255),
             deep = rgb(30, 44, 84) },
  ember  = { name = "Ember",  accent = rgb(255, 170, 92),  alt = rgb(255, 122, 122),
             deep = rgb(86, 44, 24) },
  mint   = { name = "Mint",   accent = rgb(94, 232, 190),  alt = rgb(140, 232, 255),
             deep = rgb(20, 74, 66) },
  orchid = { name = "Orchid", accent = rgb(206, 148, 255), alt = rgb(255, 148, 214),
             deep = rgb(64, 34, 90) },
  bone   = { name = "Bone",   accent = rgb(226, 228, 236), alt = rgb(180, 186, 204),
             deep = rgb(52, 55, 66) },
  -- Sampled from the Heaven footage: amber swirl, green type, bone-white reveal.
  heaven = { name = "Heaven", accent = rgb(224, 178, 92),  alt = rgb(150, 214, 150),
             deep = rgb(74, 52, 20) },
}
Theme.order = { "chrome", "ember", "mint", "orchid", "bone" }
Theme.current = "chrome"

function Theme.names()
  local out = {}
  for _, k in ipairs(Theme.order) do out[#out + 1] = Theme.palettes[k].name end
  return out
end

function Theme.keyFor(displayName)
  for _, k in ipairs(Theme.order) do
    if Theme.palettes[k].name == displayName then return k end
  end
  return "chrome"
end

-- Applies the colours only. Callers that need the UI to reflect it must rebuild.
function Theme.poke(key)
  local p = Theme.palettes[key] or Theme.palettes.chrome
  T.c.accent, T.c.accentAlt, T.c.accentDeep = p.accent, p.alt, p.deep
  Theme.current = key
  -- The reverse map is keyed by colour value, so it has to follow the accent.
  if T.reindex then T.reindex() end
end

function Theme.set(key, opts)
  opts = opts or {}
  if not Theme.palettes[key] then return false, "no palette " .. tostring(key) end
  Theme.poke(key)
  if L.Cfg then L.Cfg.set("theme", key) end

  -- Repainted in place: L.mk registered every palette-coloured property with the
  -- token it came from. Gradients need their own pass because a ColorSequence is
  -- not a Color3 and the registry cannot see them. A rebuild cost ~700 instances
  -- plus scroll positions, open popovers and the focus ring.
  if opts.rebuild ~= false then
    local painted = L.repaint and L.repaint() or 0
    local grads = L.A and L.A.repaintGradients and L.A.repaintGradients() or 0
    L.note("theme", string.format("%s -- repainted %d properties, %d gradients",
      Theme.palettes[key].name, painted, grads))
  end
  return true, (Theme.palettes[key].name .. " applied")
end

-- For changes a repaint cannot cover: density row metrics are read at
-- construction.
function Theme.rebuild()
  if not (L.Hub and L.Hub.window) then return false end
  local old = L.Hub.window
  local tab = old.active or 1
  local pos = old.shell and old.shell.Position
  local scale = old.scaleObj and old.scaleObj.Scale
  pcall(function() old.gui:Destroy() end)
  if old.dock then pcall(function() old.dock:Destroy() end) end

  local win = L.Hub.build()
  L.Hub.window = win
  if scale and win.scaleObj then win.scaleObj.Scale = scale end
  if pos then win.shell.Position = pos end
  win:show()
  if win.tabs[tab] then win:select(tab, true) end
  return true
end

-- ---------------------------------------------------------------- motion

-- Multipliers applied to every token as it is resolved. Measured through the
-- shipped spring at 2 kHz; t90 is when the value first reaches 90% of travel:
--
--     profile     dur   bnc |  base t90 / ov  |  slow t90 / ov  | expressive ov
--     Calm       1.40  0.35 |   238ms   0.0%  |   345ms   0.1%  |     0.4%
--     Silk       1.20  0.80 |   181ms   0.8%  |   259ms   1.0%  |     4.8%
--     Default    1.00  1.00 |   143ms   1.5%  |   204ms   2.0%  |     8.4%
--     Lively     0.72  1.60 |    89ms   5.4%  |   125ms   6.9%  |    26.2%
--
-- Silk is the default: the fastest profile that still clears 180 ms, at 0.8%
-- overshoot, with expressive left at 4.8% so the loader mark keeps its bounce.
Theme.motionProfiles = {
  Calm    = { dur = 1.40, bounce = 0.35 },
  Silk    = { dur = 1.20, bounce = 0.80 },
  -- Heaven mode's own pace, measured alongside the others:
  --     Heaven  0.80  0.75 |  base 122ms 0.6%  |  fast 73ms 0.6%
  -- Quicker than Silk, but at 0.6% overshoot rather than Lively's 5.4%.
  Heaven  = { dur = 0.80, bounce = 0.75 },
  Default = { dur = 1.00, bounce = 1.00 },
  Lively  = { dur = 0.72, bounce = 1.60 },
}
Theme.motionOrder = { "Calm", "Silk", "Default", "Lively", "Heaven" }
Theme.motion = "Silk"

-- Id the Config tab registers its profile picker under. This setting is stored
-- twice and both copies must be written together -- see setMotion.
Theme.MOTION_CTL = "config.motion.Animation profile"

function Theme.setMotion(name)
  local p = Theme.motionProfiles[name]
  if not p then return false, "no profile " .. tostring(name) end
  Theme.motion = name
  M.durScale, M.bounceScale = p.dur, p.bounce
  M.reprofile()

  -- The profile lives in two keys: Cfg "motion" and the Config picker's
  -- Cfg.features[MOTION_CTL]. Cfg.applyOnLoad restores the picker and fires its
  -- callback back into here with the old value, so writing only one key means a
  -- profile set from anywhere else reverts on the next execute. Write both.
  if L.Cfg then
    L.Cfg.set("motion", name)
    if L.Cfg.setFeat then pcall(L.Cfg.setFeat, Theme.MOTION_CTL, name) end
  end
  -- Move the visible control so the dropdown cannot show a stale profile.
  if L.C and L.C.find then
    local h = L.C.find(Theme.MOTION_CTL)
    if h and h.set then pcall(function() h:set(name, true) end) end
  end
  return true, name
end

-- ---------------------------------------------------------------- heaven
-- Heaven mode is a parameter set, not a second interface: it moves palette,
-- motion profile and loading screen together, and stores what it replaced so
-- turning it off restores the operator's own values.
Theme.HEAVEN = { palette = "heaven", motion = "Heaven", loader = "Made in Heaven" }
Theme.heavenOn = false

function Theme.setHeaven(on, silent)
  on = on and true or false
  local H = Theme.HEAVEN

  if on and not Theme.heavenOn then
    Theme._preHeaven = {
      palette = (L.Cfg and L.Cfg.data and L.Cfg.data.theme) or "chrome",
      motion  = Theme.motion,
      loader  = (L.Loader and L.Loader.skinName and L.Loader.skinName()) or nil,
    }
  end

  local want = on and H or (Theme._preHeaven or
    { palette = "chrome", motion = "Silk", loader = "Aurora" })

  Theme.heavenOn = on
  pcall(function() Theme.set(want.palette) end)
  pcall(function() Theme.setMotion(want.motion) end)
  if L.Loader and L.Loader.setSkin and want.loader then
    -- Loader may be absent on this install; then the next execute opens Aurora.
    pcall(L.Loader.setSkin, want.loader)
  end
  if L.Cfg then L.Cfg.set("heaven", on) end

  if not silent and L.Toast then
    if on then
      L.Toast.info("Made in Heaven", "Palette, motion and loading screen switched")
    else
      L.Toast.info("Heaven off", "Everything back to how you had it")
    end
  end
  return true
end

-- ---------------------------------------------------------------- density

Theme.densities = { Comfortable = 1.0, Compact = 0.82 }
Theme.densityOrder = { "Comfortable", "Compact" }
Theme.density = "Comfortable"

function Theme.setDensity(name)
  local d = Theme.densities[name]
  if not d then return false, "no density " .. tostring(name) end
  Theme.density = name
  T.dense = d
  if L.Cfg then L.Cfg.set("density", name) end
  -- Row heights are read at construction, so density needs a real rebuild.
  Theme.rebuild()
  return true, name
end

-- ---------------------------------------------------------------- blur

function Theme.setBlur(v)
  v = math.clamp(tonumber(v) or 16, 0, 40)
  L.Window.BLUR = v
  if L.Cfg then L.Cfg.set("blur", v) end
  if L.Hub and L.Hub.window and not L.Hub.window.hidden then
    L.A.blurTo(v, "base")
  end
  return true, string.format("blur %d", v)
end

-- ---------------------------------------------------------------- restore
if L.Cfg then
  local k = L.Cfg.data.theme
  if type(k) == "string" and Theme.palettes[k] then Theme.poke(k) end
  local dn = L.Cfg.data.density
  if type(dn) == "string" and Theme.densities[dn] then
    Theme.density = dn
    T.dense = Theme.densities[dn]
  end
  local bl = tonumber(L.Cfg.data.blur)
  if bl then L.Window.BLUR = math.clamp(bl, 0, 40) end
  local m = L.Cfg.data.motion
  if type(m) == "string" and Theme.motionProfiles[m] then
    Theme.motion = m
    local p = Theme.motionProfiles[m]
    M.durScale, M.bounceScale = p.dur, p.bounce
  end
  -- Only the flag is restored; the three values came from their own keys above.
  -- Re-applying the mode here would overwrite a palette changed while it was on.
  Theme.heavenOn = (L.Cfg.data.heaven == true)
end

end

do -- ==== lm_17_palette.lua ====
-- LUMEN :: COMMAND PALETTE
-- Ctrl+K, type, Enter. Tab is resolved lazily by walking up the ancestry, so
-- moving a control between tabs never leaves a stale entry. Match is subsequence.

local L = getgenv().LUMEN
local T, M, A = L.T, L.Motion, L.A
local mk = L.mk

local P = {}
L.Palette = P

P.entries = {}
P.open = false

-- ---------------------------------------------------------------- registry

function P.add(frame, name, hint, run)
  P.entries[#P.entries + 1] = {
    frame = frame, name = name or "?", hint = hint or "", run = run,
  }
end

function P.clear() P.entries = {} end

local function tabOf(entry)
  if entry._tab ~= nil then return entry._tab end
  local win = L.Hub and L.Hub.window
  local n = nil
  if win and entry.frame then
    local node = entry.frame
    while node and node.Parent do
      for i, t in ipairs(win.tabs) do
        if node == t.page then n = i break end
      end
      if n then break end
      node = node.Parent
    end
  end
  entry._tab = n or false
  return entry._tab
end

-- ---------------------------------------------------------------- matching

-- Returns nil for no match, otherwise a score (higher is better).
local function score(query, text)
  if query == "" then return 0 end
  local q, t = query:lower(), text:lower()
  local qi, s, streak = 1, 0, 0
  local prevWordStart = true
  for i = 1, #t do
    local c = t:sub(i, i)
    local isBoundary = (i == 1) or t:sub(i - 1, i - 1):match("[%s%-_/]") ~= nil
    if qi <= #q and c == q:sub(qi, qi) then
      streak = streak + 1
      s = s + 6 + streak * 3
      if isBoundary then s = s + 14 end        -- start of a word matters most
      if i <= 3 then s = s + 4 end             -- near the front of the label
      qi = qi + 1
    else
      streak = 0
    end
    prevWordStart = isBoundary
  end
  local _ = prevWordStart
  if qi <= #q then return nil end              -- not all of the query consumed
  return s - #t * 0.15                         -- prefer shorter, tighter labels
end

function P.search(query)
  local out = {}
  -- TYPE "reset" TO SEE WHAT IS NOT STOCK. Reset rides the palette because it
  -- costs no Instance, no connection, and no meaning stolen from C.pinnable's
  -- right-click -- and it reaches sliders and dropdowns, which have no row
  -- right-click at all. The entry list is the diff view, so there is no second
  -- surface to build. Carrying the control's own frame makes the existing
  -- activate path jump to its tab and flash the row before the value moves.
  local Cfg = L.Cfg
  if Cfg and Cfg.changedFromDefault and query:lower():sub(1, 3) == "res" then
    for _, d in ipairs(Cfg.changedFromDefault()) do
      local h = L.C and L.C.find and L.C.find(d.id)
      if h and h.frame then
        out[#out + 1] = { s = 1e6, e = {
          frame = h.frame,
          name = "Reset " .. tostring(h._label or d.id),
          hint = tostring(d.value) .. "  \226\134\146  " .. tostring(d.default),
          run = function() Cfg.resetFeat(d.id) end,
        } }
      end
    end
  end
  for _, e in ipairs(P.entries) do
    if e.frame and e.frame.Parent then
      local sc = score(query, e.name .. " " .. e.hint)
      if sc then out[#out + 1] = { e = e, s = sc } end
    end
  end
  table.sort(out, function(a, b)
    if a.s ~= b.s then return a.s > b.s end
    return a.e.name < b.e.name
  end)
  return out
end

-- ---------------------------------------------------------------- ui

local gui, root, box, listFrame, rows, sel, results

local function paintSel()
  for i, r in ipairs(rows) do
    local on = (i == sel)
    M.to(r.bg, "BackgroundTransparency", on and 0.86 or 1, "instant")
    M.to(r.name, "TextColor3", on and T.c.text or T.c.textDim, "instant")
  end
end

-- `animate` only on open: cascading per keystroke re-staggers eight rows on
-- every character and reads as lag, so search results snap.
local function render(list, animate)
  results = list
  if P._seq then P._seq:cancel() P._seq = nil end
  for _, r in ipairs(rows) do r.bg.Visible = false end

  local shown = {}
  for i = 1, math.min(#list, 8) do
    local r = rows[i]
    local e = list[i].e
    local ti = tabOf(e)
    local win = L.Hub and L.Hub.window
    r.bg.Visible = true
    r.name.Text = e.name
    r.hint.Text = (ti and win and win.tabs[ti] and win.tabs[ti].name or e.hint or "")
    r.entry = e
    shown[#shown + 1] = r
  end

  if animate and #shown > 0 then
    for _, r in ipairs(shown) do
      M.set(r.name, "TextTransparency", 1)
      M.set(r.hint, "TextTransparency", 1)
      M.set(r.name, "Position", UDim2.fromOffset(18, 0))
    end
    -- Cancellable, so a cascade still running after close cannot fade rows back in.
    P._seq = M.seq(shown, function(r)
      if not r.bg.Parent then return end
      M.to(r.name, "TextTransparency", 0, "base")
      M.to(r.hint, "TextTransparency", 0, "base")
      M.to(r.name, "Position", UDim2.fromOffset(10, 0), "base")
    end, { step = 0.028, cap = 0.2 })
  else
    for _, r in ipairs(shown) do
      M.set(r.name, "TextTransparency", 0)
      M.set(r.hint, "TextTransparency", 0)
      M.set(r.name, "Position", UDim2.fromOffset(10, 0))
    end
  end

  sel = (#list > 0) and 1 or 0
  paintSel()
end

local function activate(i)
  local item = results and results[i]
  if not item then return end
  local e = item.e
  P.hide()
  local ti = tabOf(e)
  local win = L.Hub and L.Hub.window
  if ti and win then win:select(ti) end
  -- Flash the row so the eye lands on the control that was searched for.
  task.delay(0.28, function()
    if not L.live() or not e.frame or not e.frame.Parent then return end
    local was = e.frame.BackgroundColor3
    M.set(e.frame, "BackgroundColor3", T.c.accentDeep)
    M.to(e.frame, "BackgroundColor3", was, "slow")
  end)
  if e.run then L.try("palette.run", e.run) end
end

function P.build()
  if gui and gui.Parent then return end
  gui = mk("ScreenGui", {
    Name = "LumenPalette", ResetOnSpawn = false, IgnoreGuiInset = true,
    ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 40,
  })
  gui.Parent = L.host()
  L.own(gui)
  mk("UIScale", { Scale = L.autoScale(), Parent = gui })

  local scrim = mk("Frame", {
    Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.c.scrim,
    BackgroundTransparency = 1, BorderSizePixel = 0, Parent = gui,
  })
  local hit = mk("TextButton", {
    Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "",
    AutoButtonColor = false, Parent = scrim,
  })
  hit.Activated:Connect(function() P.hide() end)
  P.scrim = scrim

  -- CanvasGroup, not Frame: a Frame has no single opacity clock, so only
  -- GroupTransparency fades plate, outline and text together.
  root = mk("CanvasGroup", {
    AnchorPoint = Vector2.new(0.5, 0),
    Position = UDim2.new(0.5, 0, 0.18, 0),
    Size = UDim2.fromOffset(520, 60),
    BackgroundColor3 = T.c.overlay, BorderSizePixel = 0,
    GroupTransparency = 0,
    Parent = gui,
  })
  L.corner(T.r.lg, root)
  L.stroke(T.c.lineStrong, 1, 0.25, root)
  A.shadow(nil, { Parent = gui, spread = 30, alpha = 0.4, ZIndex = 0 })
  P.root = root

  A.Icon.search(root, 16, T.c.textMute).Position = UDim2.fromOffset(18, 18)

  box = mk("TextBox", {
    Position = UDim2.fromOffset(44, 0), Size = UDim2.new(1, -60, 0, 52),
    BackgroundTransparency = 1, Text = "",
    PlaceholderText = "Search controls...",
    PlaceholderColor3 = T.c.textOff, TextColor3 = T.c.text,
    Font = T.font.body, TextSize = 15,
    TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
    Parent = root,
  })
  P.box = box

  listFrame = mk("Frame", {
    Position = UDim2.fromOffset(8, 54), Size = UDim2.new(1, -16, 0, 0),
    BackgroundTransparency = 1, Parent = root,
  })
  L.list(2, nil, listFrame)

  rows = {}
  for i = 1, 8 do
    local bg = mk("Frame", {
      Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = T.c.accent,
      BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false,
      LayoutOrder = i, Parent = listFrame,
    })
    L.corner(T.r.sm, bg)
    local nm = A.text({
      Text = "", font = T.font.medium, size = T.size.body, colour = T.c.textDim,
      Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -120, 1, 0),
      truncate = true, Parent = bg,
    })
    local hn = A.text({
      Text = "", font = T.font.mono, size = T.size.tiny, colour = T.c.textOff,
      align = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0.5),
      Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(100, 14),
      Parent = bg,
    })
    local btn = mk("TextButton", {
      Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "",
      AutoButtonColor = false, ZIndex = 3, Parent = bg,
    })
    btn.Activated:Connect(function() activate(i) end)
    btn.MouseEnter:Connect(function() sel = i paintSel() end)
    rows[i] = { bg = bg, name = nm, hint = hn }
  end

  box:GetPropertyChangedSignal("Text"):Connect(function()
    local list = P.search(box.Text)
    render(list)
    local h = 54 + math.min(#list, 8) * 36 + (#list > 0 and 8 or 0)
    M.to(root, "Size", UDim2.fromOffset(520, h), "base")
    M.to(listFrame, "Size", UDim2.new(1, -16, 0, math.min(#list, 8) * 36), "base")
  end)
end

function P.show()
  P.build()
  P.open = true
  gui.Enabled = true
  box.Text = ""
  render(P.search(""), true)
  M.set(root, "Position", UDim2.new(0.5, 0, 0.18, -14))
  A.groupSet(root, 1)
  M.set(P.scrim, "BackgroundTransparency", 1)
  M.to(P.scrim, "BackgroundTransparency", 0.42, "base")
  M.to(root, "Position", UDim2.new(0.5, 0, 0.18, 0), "slow")
  -- Fade is shorter than the slide, so the panel is legible before it lands.
  A.groupTo(root, 0, "base")
  task.defer(function() if P.open then box:CaptureFocus() end end)
end

function P.hide()
  if not P.open then return end
  P.open = false
  if P._seq then P._seq:cancel() P._seq = nil end
  M.to(P.scrim, "BackgroundTransparency", 1, "fast")
  M.to(root, "Position", UDim2.new(0.5, 0, 0.18, -10), "fast")
  A.groupTo(root, 1, "fast")
  pcall(function() box:ReleaseFocus() end)
  task.delay(0.3, function()
    if gui and not P.open then gui.Enabled = false end
  end)
end

function P.toggle() if P.open then P.hide() else P.show() end end

-- ---------------------------------------------------------------- keys
L.hold(L.UIS.InputBegan:Connect(function(i, typing)
  if not L.live() then return end
  local ctrl = L.UIS:IsKeyDown(Enum.KeyCode.LeftControl)
             or L.UIS:IsKeyDown(Enum.KeyCode.RightControl)
  if i.KeyCode == Enum.KeyCode.K and ctrl then P.toggle() return end
  if not P.open then return end
  -- These run while the TextBox has focus, so they cannot be gated on `typing`.
  if i.KeyCode == Enum.KeyCode.Escape then P.hide()
  elseif i.KeyCode == Enum.KeyCode.Down then
    if results and #results > 0 then sel = math.min(sel + 1, math.min(#results, 8)) paintSel() end
  elseif i.KeyCode == Enum.KeyCode.Up then
    if results and #results > 0 then sel = math.max(sel - 1, 1) paintSel() end
  elseif i.KeyCode == Enum.KeyCode.Return then
    activate(sel)
  end
  local _ = typing
end))

end


