  cascade     = { t = "number",  scope = "global", def = 0.035, min = 0, max = 0.12 },
  sweep       = { t = "boolean", scope = "global", def = true },
  spot        = { t = "boolean", scope = "global", def = true },
  -- which of Side.SIZES the player panel opens at
  sideSize    = { t = "number",  scope = "global", def = 2, min = 1, max = 3 },
