T.m = {
  instant    = { 0.10,  0.00 },   -- hover/press state layers: no overshoot
  fast       = { 0.18,  0.20 },   -- toggles and checkmarks; 1.5% overshoot
  base       = { 0.30,  0.20 },   -- the default: panels, the tab indicator
  slow       = { 0.44,  0.22 },   -- window entrance, tab content swap
  expressive = { 0.42,  0.38 },   -- the loader mark, 8% overshoot. Overshoot is
                                  -- set by bounce alone; at 0.58 duration it
                                  -- settled in 0.97 s and read as lag
  gentle     = { 0.32, -0.20 },   -- progress and meters, overdamped on purpose:
}                                 -- at 0.50 it took 1.14 s to settle

-- Material 3 easing curves, for the rare case a curve beats a spring (anything
-- that must land on an exact frame). Sampled by L.bezier in lm_03_motion.
--   https://m3.material.io/styles/motion/easing-and-duration/tokens-specs
T.ease = {
  standard            = { 0.20, 0.00, 0.00, 1.00 },
  standardDecelerate  = { 0.00, 0.00, 0.00, 1.00 },  -- entering the screen
  standardAccelerate  = { 0.30, 0.00, 1.00, 1.00 },  -- leaving the screen
  emphasizedDecelerate= { 0.05, 0.70, 0.10, 1.00 },  -- prominent entries
  emphasizedAccelerate= { 0.30, 0.00, 0.80, 0.15 },  -- prominent exits
  linear              = { 0.00, 0.00, 1.00, 1.00 },  -- indeterminate only
}

-- Delay between successive items in a list reveal.
T.stagger = 0.035

function T.motion(name)
  local m = T.m[name] or T.m.base
  return m[1], m[2]
end

-- ---- reverse map, for the repaint registry ---------------------------------
-- Which token a colour came from. L.mk consults this while building so palette
-- colours are remembered by name and can repaint in place. Reindex whenever the
-- accent moves.
local reverse = {}

function T.reindex()
  reverse = {}
  for name, v in pairs(T.c) do
    if typeof(v) == "Color3" then reverse[tostring(v)] = name end
  end
end

function T.tokenOf(colour)
  return reverse[tostring(colour)]
end

T.reindex()
end

do -- ==== lm_02_spring.lua ====
-- LUMEN :: SPRING
-- A damped spring solved in closed form, so it is exact at any frame rate and
-- cannot blow up when a frame hitches. Euler integration does both.
--
-- Parameterised by DURATION and BOUNCE (Apple's scheme) rather than stiffness
-- and damping, because duration and bounce are independent and the raw
-- constants are not -- changing stiffness alone changes both.
--
-- Spring.selftest() checks the maths; verify_spring.py runs it head-less.

local L = getgenv().LUMEN
local Spring = {}
Spring.__index = Spring
L.Spring = Spring

local TAU = math.pi * 2

-- exp(-x), guarded. x is always >= 0 here by construction, but a NaN dt or a
-- pathological tuning would otherwise poison every later frame silently.
local function negexp(x)
  if x ~= x then return 0 end     -- NaN
  if x <= 0 then return 1 end
  if x > 40 then return 0 end     -- underflows to zero anyway, skip the call
  return math.exp(-x)
end

-- Apple's duration/bounce -> stiffness/damping, mass = 1.
function Spring.params(duration, bounce)
  duration = math.max(tonumber(duration) or 0.3, 1e-3)
  bounce   = math.clamp(tonumber(bounce) or 0, -0.95, 0.95)
  local k = (TAU / duration) ^ 2
  local c
  if bounce >= 0 then
    c = (1 - bounce) * 2 * TAU / duration
  else
    c = 2 * TAU / (duration * (1 + bounce))
  end
  return k, c
end

function Spring.new(duration, bounce, initial)
  local self = setmetatable({}, Spring)
  self.k, self.c = Spring.params(duration, bounce)
  self.duration, self.bounce = duration or 0.3, bounce or 0
  self.value    = initial or 0
  self.target   = initial or 0
  self.velocity = 0
  return self
end

function Spring:retune(duration, bounce)
  self.k, self.c = Spring.params(duration, bounce)
  self.duration, self.bounce = duration, bounce
  return self
end

-- Retarget. VELOCITY IS DELIBERATELY UNTOUCHED -- that is the whole point.
function Spring:to(target)
  self.target = target
  return self
end

-- Teleport: value, target and velocity all reset. For initial state only; using
-- this where `to` belongs is what makes an interface feel like it is snapping.
function Spring:snap(value)
  self.value, self.target, self.velocity = value, value, 0
  return self
end

function Spring:impulse(v)
  self.velocity = self.velocity + v
  return self
end

-- Exact step of  y'' + c*y' + k*y = 0  where y = value - target.
function Spring:step(dt)
  if not dt or dt ~= dt or dt <= 0 then return self.value end
  if dt > 0.25 then dt = 0.25 end     -- a long hitch should not teleport the UI

  local g  = self.target
  local y0 = self.value - g
  local v0 = self.velocity
  local k, c = self.k, self.c

  -- already there and not moving: skip the transcendentals entirely
  if y0 == 0 and v0 == 0 then return self.value end

  local disc = c * c - 4 * k
  local x, v

  if disc < -1e-9 then
    -- UNDERDAMPED: decaying oscillation. This is every bounce > 0 token.
    local zeta = c * 0.5
    local wd   = math.sqrt(4 * k - c * c) * 0.5
    local e    = negexp(zeta * dt)
    local c1   = y0
    local c2   = (v0 + zeta * y0) / wd
    local cs, sn = math.cos(wd * dt), math.sin(wd * dt)
    x = e * (c1 * cs + c2 * sn)
    v = e * ((-zeta * c1 + wd * c2) * cs + (-zeta * c2 - wd * c1) * sn)

  elseif disc <= 1e-9 then
    -- CRITICALLY DAMPED: the bounce = 0 case, fastest arrival without overshoot.
    local zeta = c * 0.5
    local e    = negexp(zeta * dt)
    local a    = y0
    local b    = v0 + zeta * y0
    local pos  = a + b * dt
    x = e * pos
    v = e * (b - zeta * pos)

  else
    -- OVERDAMPED: two real roots, both negative. Every bounce < 0 token.
    local sq = math.sqrt(disc)
    local r1 = (-c + sq) * 0.5
    local r2 = (-c - sq) * 0.5
    local c2 = (r1 * y0 - v0) / (r1 - r2)
    local c1 = y0 - c2
    local e1, e2 = negexp(-r1 * dt), negexp(-r2 * dt)
    x = c1 * e1 + c2 * e2
    v = c1 * r1 * e1 + c2 * r2 * e2
  end

  self.value    = x + g
  self.velocity = v
  return self.value
end

-- Settling is judged on BOTH offset and velocity. Position alone is not enough:
-- a spring passing through its target at speed is momentarily at zero offset,
-- and a position-only test would park it there mid-flight.
function Spring:settled(epsP, epsV)
  return math.abs(self.value - self.target) <= (epsP or 1e-3)
     and math.abs(self.velocity)            <= (epsV or 1e-2)
end

function Spring:finish()
  self.value, self.velocity = self.target, 0
  return self.value
end

-- ---------------------------------------------------------------- self test
--
-- Runnable head-less under luau.exe with no Roblox API, so the maths can be
-- verified without a game client. Checks the three regimes behave as their names
-- claim, that stepping is genuinely frame-rate independent, and -- the one that
-- matters -- that retargeting carries velocity.
function Spring.selftest()
  local out, fail = {}, 0
  local function check(name, cond, detail)
    if cond then out[#out + 1] = "ok    " .. name .. (detail and ("  " .. detail) or "")
    else out[#out + 1] = "FAIL  " .. name .. "  " .. tostring(detail) fail = fail + 1 end
  end

  local function run(dur, bounce, steps, dt, target)
    local s = Spring.new(dur, bounce, 0)
    s:to(target or 1)
    local peak = 0
    for _ = 1, steps do
      s:step(dt)
      if s.value > peak then peak = s.value end
    end
    return s, peak
  end

  -- bounce 0 is critically damped: must never exceed its target
  local _, peak0 = run(0.3, 0, 400, 1 / 240)
  check("bounce 0 does not overshoot", peak0 <= 1.0005, string.format("peak=%.5f", peak0))

  -- positive bounce must overshoot
  local _, peakB = run(0.3, 0.4, 400, 1 / 240)
  check("bounce 0.4 overshoots", peakB > 1.02, string.format("peak=%.4f", peakB))

  -- negative bounce must not, and must be slower to arrive than critical
  local sN, peakN = run(0.3, -0.5, 400, 1 / 240)
  check("bounce -0.5 does not overshoot", peakN <= 1.0005, string.format("peak=%.5f", peakN))

  -- all regimes must actually converge
  local sC = run(0.3, 0, 600, 1 / 240)
  check("critical converges", sC:settled(1e-3, 1e-2), string.format("v=%.5f", sC.velocity))
  check("overdamped converges", sN:settled(1e-2, 1e-1), string.format("d=%.5f", 1 - sN.value))

  -- FRAME-RATE INDEPENDENCE: 240 fps and 30 fps must agree closely over the
  -- same elapsed time. Euler integration fails this badly.
  local a = Spring.new(0.3, 0.2, 0); a:to(1)
  for _ = 1, 240 do a:step(1 / 240) end
  local b = Spring.new(0.3, 0.2, 0); b:to(1)
  for _ = 1, 30 do b:step(1 / 30) end
  check("240fps matches 30fps", math.abs(a.value - b.value) < 0.01,
        string.format("%.5f vs %.5f", a.value, b.value))

  -- STABILITY: an absurd dt must not produce NaN or an explosion
  local s = Spring.new(0.05, 0.5, 0); s:to(1)
  for _ = 1, 20 do s:step(10) end
  check("huge dt stays finite", s.value == s.value and math.abs(s.value) < 10,
        string.format("v=%.4f", s.value))

  -- VELOCITY PRESERVATION: retarget mid-flight and the spring must still be
  -- moving. This is the property the whole framework is built on.
  local r = Spring.new(0.4, 0, 0)
  r:to(1)
  for _ = 1, 12 do r:step(1 / 240) end
  local vBefore = r.velocity
  r:to(0.5)                                   -- retarget while in motion
  check("retarget preserves velocity", math.abs(r.velocity - vBefore) < 1e-12,
        string.format("%.5f -> %.5f", vBefore, r.velocity))
  check("velocity was non-zero", vBefore > 0.05, string.format("%.5f", vBefore))

  -- and snap must NOT preserve it
  r:snap(0)
  check("snap clears velocity", r.velocity == 0)

  return table.concat(out, "\n"), fail
end

end

do -- ==== lm_03_motion.lua ====
-- LUMEN :: MOTION
-- One RenderStepped loop drives every animation in the framework.
--
-- Motion.to never resets velocity, so retargeting mid-flight keeps the speed it
-- already had; a tween restarts from a dead stop. Settled springs are dropped
-- from the loop, so idle costs nothing.

local L = getgenv().LUMEN
local T = L.T
local Spring = L.Spring

local Motion = {}
L.Motion = Motion

-- ---------------------------------------------------------------- colour space
--
-- Colour is sprung in linear space, not sRGB: gamma-encoded channels average to a
-- chalky, desaturated midpoint. Squaring in and square-rooting out is the cheap
-- gamma-2.0 approximation, two multiplies.
local function toLinear(v) return v * v end
local function toGamma(v) return math.sqrt(v < 0 and 0 or v) end

-- ---------------------------------------------------------------- kinds
--
-- Each animatable type is decomposed into scalars, sprung independently, and
-- reassembled. eps is (position, velocity) for the settle test.
local KINDS = {}

KINDS.number = {
  n = 1, eps = { 0.0015, 0.02 },
  dec = function(v, o) o[1] = v end,
  enc = function(o) return o[1] end,
}

KINDS.UDim2 = {
  n = 4, eps = { 0.002, 0.03 },
  dec = function(v, o)
    o[1], o[2], o[3], o[4] = v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset
  end,
  enc = function(o) return UDim2.new(o[1], o[2], o[3], o[4]) end,
}

KINDS.UDim = {
  n = 2, eps = { 0.002, 0.03 },
  dec = function(v, o) o[1], o[2] = v.Scale, v.Offset end,
  enc = function(o) return UDim.new(o[1], o[2]) end,
}

KINDS.Vector2 = {
  n = 2, eps = { 0.002, 0.03 },
  dec = function(v, o) o[1], o[2] = v.X, v.Y end,
  enc = function(o) return Vector2.new(o[1], o[2]) end,
}

KINDS.Color3 = {
  n = 3, eps = { 0.0008, 0.01 },
  dec = function(v, o)
    o[1], o[2], o[3] = toLinear(v.R), toLinear(v.G), toLinear(v.B)
  end,
  enc = function(o)
    return Color3.new(toGamma(o[1]), toGamma(o[2]), toGamma(o[3]))
  end,
}

local function kindOf(v)
  local t = typeof(v)
  return KINDS[t]
end

-- ---------------------------------------------------------------- track
local Track = {}
Track.__index = Track

local active, activeN = {}, 0
local byObject = setmetatable({}, { __mode = "k" })

local function wake(tr)
  if tr.awake or tr.dead then return end
  tr.awake = true
  activeN = activeN + 1
  active[activeN] = tr
  tr.slot = activeN
end

local function sleep(tr)
  if not tr.awake then return end
  tr.awake = false
  -- swap-remove: order is irrelevant and this keeps removal O(1)
  local last = active[activeN]
  active[tr.slot] = last
  if last then last.slot = tr.slot end
  active[activeN] = nil
  activeN = activeN - 1
  tr.slot = nil
  if tr.onSettle then L.try("motion.settle", tr.onSettle, tr) end
end

function Track:to(value)
  if self.dead then return self end
  local kd = self.kind
  kd.dec(value, self.tmp)
  for i = 1, kd.n do
    self.springs[i]:to(self.tmp[i])
  end
  self.goal = value
  wake(self)
  return self
end

function Track:snap(value)
  if self.dead then return self end
  local kd = self.kind
  kd.dec(value, self.tmp)
  for i = 1, kd.n do self.springs[i]:snap(self.tmp[i]) end
  self.goal = value
  self.last = nil
  self:write(value)
  sleep(self)
  return self
end

function Track:retune(token)
  self.token = token or self.token
  local d, b = Motion.resolve(token or self.token)
  for i = 1, self.kind.n do self.springs[i]:retune(d, b) end
  return self
end

function Track:impulse(v)
  for i = 1, self.kind.n do self.springs[i]:impulse(v) end
  wake(self)
  return self
end

function Track:write(value)
  if self.last == value then return end
  self.last = value
  L.uiWrite(self.obj,self.prop,value)
end

function Track:destroy()
  self.dead = true
  sleep(self)
  local m = byObject[self.obj]
  if m then m[self.prop] = nil end
end

-- ---------------------------------------------------------------- api

-- Accepts a token name ("base") or a raw { duration, bounce } pair. The profile
-- multipliers apply at resolve time, so one pair restyles every animation.
Motion.durScale, Motion.bounceScale = 1, 1

function Motion.resolve(token)
  local d, b
  if type(token) == "table" then d, b = token[1], token[2]
  else
    local m = T.m[token or "base"] or T.m.base
    d, b = m[1], m[2]
  end
  return d * Motion.durScale, math.clamp(b * Motion.bounceScale, -0.95, 0.95)
end

-- A Track builds its springs once, so a token change alone does nothing to what
-- is already on screen. Each track remembers its token so it can be retuned.
function Motion.reprofile()
  local n = 0
  for _, props in pairs(byObject) do
    for _, tr in pairs(props) do
      if not tr.dead and tr.token then
        tr:retune(tr.token)
        n = n + 1
      end
    end
  end
  return n
end

function Motion.track(obj, prop, token)
  local m = byObject[obj]
  if not m then m = {} byObject[obj] = m end
  local existing = m[prop]
  if existing and not existing.dead then
    if token then existing.token = token existing:retune(token) end
    return existing
  end

  local current = L.uiRead(obj,prop)
  local kd = kindOf(current)
  if not kd then
    L.fault("motion.kind", tostring(typeof(current)) .. " on " .. tostring(prop))
    return nil
  end

  local d, b = Motion.resolve(token)
  local tr = setmetatable({
    obj = obj, prop = prop, kind = kd, springs = {}, tmp = {},
    token = token or "base",
    goal = current, last = current, awake = false, dead = false,
  }, Track)

  kd.dec(current, tr.tmp)
  for i = 1, kd.n do tr.springs[i] = Spring.new(d, b, tr.tmp[i]) end
  m[prop] = tr
  return tr
end

-- Animate a property to a value, creating the track on first use.
function Motion.to(obj, prop, value, token)
  local tr = Motion.track(obj, prop, token)
  if tr then tr:to(value) end
  return tr
end

function Motion.set(obj, prop, value, token)
  local tr = Motion.track(obj, prop, token)
  if tr then tr:snap(value) end
  return tr
end

function Motion.stop(obj, prop)
  local m = byObject[obj]
  local tr = m and m[prop]
  if tr then tr:destroy() end
end

function Motion.stopAll(obj)
  local m = byObject[obj]
  if not m then return end
  for _, tr in pairs(m) do tr:destroy() end
  byObject[obj] = nil
end

-- ---------------------------------------------------------------- instrument
--
-- What the tokens do, measured through this exact spring code. `duration` is the
-- period parameter, not the settle time -- they are not the same number:
--
--     token         dur   bnc    t50ms  t90ms  t99ms  overshoot
--     instant      0.10  0.00       27     62    150      -0.0%
--     fast         0.18  0.20       44     86    249       1.5%
--     base         0.30  0.20       72    143    390       1.5%
--     slow         0.44  0.22      105    204    549       2.0%
--     expressive   0.42  0.38       92    161    510       8.4%
--     gentle       0.32 -0.20       99    264    568      -0.0%
--
-- Panels reach 90% of travel in 143 ms, a window entrance in 204 ms. Anything
-- that still feels instant is a property written directly instead of through
-- Motion, not a duration problem.

Motion.BUDGET = 0.002          -- 2 ms of main-thread work per frame

local perf = {
  cap = 240, i = 0, n = 0, ring = table.create(240, 0),
  frames = 0, over = 0, peak = 0, ema = 0,
}

local function record(elapsed)
  perf.frames = perf.frames + 1
  perf.i = perf.i % perf.cap + 1
  perf.ring[perf.i] = elapsed
  if perf.n < perf.cap then perf.n = perf.n + 1 end
  if elapsed > perf.peak then perf.peak = elapsed end
  if elapsed > Motion.BUDGET then perf.over = perf.over + 1 end
  -- EMA drives the degrade decision; a mean over all time reacts far too slowly.
  perf.ema = perf.ema + (elapsed - perf.ema) * 0.05
end

-- Percentiles are computed ON DEMAND, never per frame -- an instrument that
-- costs what it measures is not an instrument.
function Motion.perf()
  local n = perf.n
  if n == 0 then
    return { samples = 0, active = activeN }
  end
  local copy = table.create(n)
  for j = 1, n do copy[j] = perf.ring[j] end
  table.sort(copy)
  local sum = 0
  for j = 1, n do sum = sum + copy[j] end
  local function pct(q)
    local idx = math.clamp(math.ceil(q * n), 1, n)
    return copy[idx] * 1000
  end
  return {
    samples   = n,
    active    = activeN,
    avgMs     = (sum / n) * 1000,
    medianMs  = pct(0.50),
    p95Ms     = pct(0.95),
    worstMs   = copy[n] * 1000,
    peakMs    = perf.peak * 1000,
    budgetMs  = Motion.BUDGET * 1000,
    overPct   = perf.frames > 0 and (perf.over / perf.frames) * 100 or 0,
    frames    = perf.frames,
    quality   = Motion.quality,
  }
end

function Motion.resetPerf()
  perf.i, perf.n, perf.frames, perf.over, perf.peak, perf.ema = 0, 0, 0, 0, 0, 0
  return true
end

-- Measure a token's real response in-client, so the table above can be checked
-- on the machine that is actually complaining rather than trusted.
function Motion.measure(token, dt)
  local d, b = Motion.resolve(token)
  local s = Spring.new(d, b, 0)
  s:to(1)
  dt = dt or 1 / 1000
  local t, t50, t90, t99, peak = 0, nil, nil, nil, 0
  for _ = 1, math.floor(4 / dt) do
    s:step(dt) t = t + dt
    if s.value > peak then peak = s.value end
    if not t50 and s.value >= 0.50 then t50 = t end
    if not t90 and s.value >= 0.90 then t90 = t end
    if not t99 and math.abs(s.value - 1) <= 0.01 and math.abs(s.velocity) < 0.05 then
      t99 = t
    end
  end
  return { token = token, duration = d, bounce = b,
           t50ms = (t50 or 0) * 1000, t90ms = (t90 or 0) * 1000,
           t99ms = (t99 or 0) * 1000, overshootPct = (peak - 1) * 100 }
end

-- ---------------------------------------------------------------- degrade
--
-- Degrading means doing LESS WORK, never moving slower. Stretching durations
-- under load is the exact trick that makes an interface feel worse while
-- looking like it is trying to feel better -- the frames are still late, they
-- are just late for longer.
--
-- Hysteresis is not optional here: a single threshold flips quality on and off
-- every few frames right at the boundary, and a hub that keeps changing its own
-- animation style is worse than one that is simply slow.
Motion.quality = 1        -- 1 full, 0 minimal
Motion.autoDegrade = true

local degradeHold, recoverHold = 0, 0

local function judge()
  if not Motion.autoDegrade then return end
  if perf.ema > Motion.BUDGET then
    degradeHold, recoverHold = degradeHold + 1, 0
    if degradeHold > 60 and Motion.quality > 0 then
      Motion.quality = math.max(0, Motion.quality - 0.5)
      degradeHold = 0
      L.note("motion", string.format(
        "quality -> %.1f (ema %.2f ms over %.2f ms budget)",
        Motion.quality, perf.ema * 1000, Motion.BUDGET * 1000))
    end
  elseif perf.ema < Motion.BUDGET * 0.6 then
    recoverHold, degradeHold = recoverHold + 1, 0
    if recoverHold > 180 and Motion.quality < 1 then
      Motion.quality = math.min(1, Motion.quality + 0.5)
      recoverHold = 0
      L.note("motion", string.format("quality -> %.1f (recovered)", Motion.quality))
    end
  end
end

-- Features consult this before spending frames on something decorative. Weight
-- is how ornamental the animation is: 0 is structural and always runs, 1 is
-- pure decoration and is the first thing dropped.
function Motion.shouldAnimate(weight)
  return Motion.quality >= (weight or 0)
end

function Motion.stats()
  return { active = activeN, gen = L._gen, quality = Motion.quality }
end

-- ---------------------------------------------------------------- loop
local lastT = os.clock()

function Motion.step(dt)
  local i = 1
  while i <= activeN do
    local tr = active[i]
    if not tr or tr.dead then
      i = i + 1
    else
      local obj = tr.obj
      -- Drop tracks whose instance has left the tree. Checked only AFTER the
      -- object has been parented once, because a track is legitimately created
      -- during construction while Parent is still nil.
      if obj.Parent then tr.parented = true end
      if tr.parented and not obj.Parent then
        tr.dead = true
        sleep(tr)
      else
        local kd, sp, tmp = tr.kind, tr.springs, tr.tmp
        local settled = true
        local epsP, epsV = kd.eps[1], kd.eps[2]
        for j = 1, kd.n do
          local s = sp[j]
          s:step(dt)
          tmp[j] = s.value
          if settled and not s:settled(epsP, epsV) then settled = false end
        end
        if settled then
          for j = 1, kd.n do
            sp[j]:finish()
            tmp[j] = sp[j].value
          end
        end
        tr:write(kd.enc(tmp))
        if settled then sleep(tr) else i = i + 1 end
      end
    end
  end
end

function Motion.start()
  if Motion._on then return end
  Motion._on = true
  lastT = os.clock()
  -- RenderStepped so writes land before the frame is drawn; anything on
  -- Heartbeat is a frame late and shows up as UI lagging one frame behind the
  -- cursor during a drag.
  L.hold(L.RunService.RenderStepped:Connect(function(dt)
    if not L.live() then return end
    -- Two os.clock() calls a frame is far below the noise floor of what is being
    -- measured, and without them every claim about smoothness in this project is
    -- somebody's opinion.
    local t0 = os.clock()
    Motion.step(dt)
    record(os.clock() - t0)
    judge()
  end))
end

-- ---------------------------------------------------------------- curves
--
-- Springs cover almost everything, but not quite everything: an indeterminate
-- shimmer or a sweep that must land on an exact frame wants a real curve. These
-- are the Material 3 easing tokens, sampled properly.
--   https://m3.material.io/styles/motion/easing-and-duration/tokens-specs

local function bezierAxis(t, a, b)
  local mt = 1 - t
  return 3 * mt * mt * t * a + 3 * mt * t * t * b + t * t * t
end

-- cubic-bezier(x1,y1,x2,y2) evaluated at x. Newton-Raphson to invert x(t), with
-- a bisection fallback for the flat regions where the derivative vanishes and
-- Newton would otherwise wander off.
function L.bezier(name, x)
  local e = T.ease[name] or T.ease.standard
  local x1, y1, x2, y2 = e[1], e[2], e[3], e[4]
  x = math.clamp(x, 0, 1)
  if x == 0 or x == 1 then return x end

  local t = x
  for _ = 1, 6 do
    local cx = bezierAxis(t, x1, x2) - x
    if math.abs(cx) < 1e-5 then break end
    local mt = 1 - t
    local d = 3 * mt * mt * x1 + 6 * mt * t * (x2 - x1) + 3 * t * t * (1 - x2)
    if math.abs(d) < 1e-6 then
      local lo, hi = 0, 1
      for _ = 1, 20 do
        t = (lo + hi) * 0.5
        if bezierAxis(t, x1, x2) < x then lo = t else hi = t end
      end
      break
    end
    t = t - cx / d
  end
  return bezierAxis(math.clamp(t, 0, 1), y1, y2)
end

-- ---------------------------------------------------------------- helpers

-- Delay for item i of n in a cascade. Capped so a fifty-item list does not take
-- two seconds to finish revealing -- past about ten items the eye reads it as a
-- wave regardless, and the tail just feels slow.
function Motion.stagger(i, step)
  return math.min((i - 1) * (step or T.stagger), 0.34)
end

-- THE STAGGER PRIMITIVE.
--
-- `Motion.stagger` above only computes a delay; every caller then had to wire
-- its own task.delay, which is why almost nothing in the hub actually cascades
-- and why lists arrive all at once. Arriving all at once is most of what reads
-- as "basic" -- the eye gets no order to follow, so a list of twelve rows lands
-- as one flat event instead of a wave.
--
-- Cancellable, because a cascade that is still firing into a panel the user has
-- already closed will animate a dead tree and, worse, pop things back into view
-- after the close finished.
function Motion.seq(items, fn, opts)
  opts = opts or {}
  local step = opts.step or T.stagger or 0.03
  local cap  = opts.cap  or 0.34

  -- Under load the cascade COLLAPSES rather than slowing: the same work happens,
  -- it just stops being spread across frames. Spreading is what costs -- it is
  -- what keeps many tracks alive at once.
  if Motion.quality < 1 then step = step * Motion.quality end

  local h = { cancelled = false, pending = 0 }
  function h:cancel() self.cancelled = true return self end

  for i, item in ipairs(items) do
    local d = math.min((i - 1) * step, cap)
    if d <= 0 then
      if L.live() then L.try("motion.seq", fn, item, i) end
    else
      h.pending = h.pending + 1
      task.delay(d, function()
        h.pending = h.pending - 1
        if h.cancelled or not L.live() then return end
        L.try("motion.seq", fn, item, i)
      end)
    end
  end
  return h
end

-- The common case: animate one property across a list, in order.
function Motion.cascade(objs, prop, value, token, opts)
  return Motion.seq(objs, function(o)
    if o and o.Parent then Motion.to(o, prop, value, token) end
  end, opts)
end

function Motion.after(delay, fn)
  task.delay(delay, function()
    if L.live() then L.try("motion.after", fn) end
  end)
end

Motion.start()

end

do -- ==== lm_04_atoms.lua ====
-- LUMEN :: ATOMS
-- The primitives every control is built from: surfaces, text, shadows, glow,
-- grain, scrolling, hover/press states, tooltips.
--
-- Shadows and glows are pre-rendered images because Roblox has no box-shadow and
-- no radial gradient. Stacking circles to fake one always bands.

local L = getgenv().LUMEN
local T, M = L.T, L.Motion
local mk = L.mk

local A = {}
L.A = A

-- ---------------------------------------------------------------- surface

function A.surface(props)
  props = props or {}
  local e = T.elev[props.elev or 0]
  local f = mk("Frame", {
    BackgroundColor3 = props.fill or e.fill,
    BorderSizePixel = 0,
    Size = props.Size, Position = props.Position,
    AnchorPoint = props.AnchorPoint, LayoutOrder = props.LayoutOrder,
    Name = props.Name or "Surface",
    ClipsDescendants = props.clip,
    Parent = props.Parent,
  })
  L.corner(props.radius or T.r.md, f)
  if props.line ~= false then
    L.stroke(props.lineColour or e.line, 1, props.lineT or e.lineT, f)
  end
  -- One-pixel highlight along the top edge, and the whole elevation cue --
  -- Roblox has no box-shadow.
  if props.sheen then
    mk("Frame", {
      Size = UDim2.new(1, -(props.radius or T.r.md) * 2, 0, 1),
      Position = UDim2.new(0, props.radius or T.r.md, 0, 0),
      BackgroundColor3 = Color3.new(1, 1, 1),
      BackgroundTransparency = 0.92,
      BorderSizePixel = 0, ZIndex = 2,
      Parent = f,
    })
  end
  return f
end

-- Labels that asked to be truncated. Registered here rather than at each call
-- site so nothing has to remember: if a string can be cut short, it is
-- automatically eligible to be shown in full on hover. See A.truncatable below.
A.tips = {}

-- EXPLANATIONS, as distinct from truncations. A.tips exists so a label that had
-- to be cut short can still be read in full; this is the other half -- a control
-- whose PURPOSE is not obvious from its face. The panel pills are the clearest
-- case: "Goto", "Pick" and "Mark" are four characters each because a card is
-- narrow, and none of them says what it does.
--
-- Deliberately not wired to every control's `desc`: that text is already
-- rendered under the title, and a tooltip that repeats what is visible an inch
-- away is noise. This is for the things with nowhere to put an explanation.
A.hints = {}

-- PRUNED ON A CLOCK, not only when hovered. Both registries were swept inside
-- the hover test, so a window that is rebuilt while the pointer is elsewhere
-- left its labels on the list forever. Measured growing about twenty entries
-- per five panel cycles.
task.spawn(function()
  while true do
    task.wait(15)
    for i = #A.tips, 1, -1 do
      local l = A.tips[i]
      if not (l and l.Parent) then table.remove(A.tips, i) end
    end
    for i = #A.hints, 1, -1 do
      local h = A.hints[i]
      if not (h and h.obj and h.obj.Parent) then table.remove(A.hints, i) end
    end
  end
end)

-- `label` is optional and names the control; without one the card is a single
-- line, exactly as before. With one the card reads as a heading and a sentence,
-- which is the difference between a caption and an explanation.
function A.explain(obj, text, label)
  if not (obj and type(text) == "string" and text ~= "") then return obj end
  A.hints[#A.hints + 1] = { obj = obj, text = text, label = label }
  return obj
end

function A.text(props)
  local l = mk("TextLabel", {
    BackgroundTransparency = 1,
    Text = props.Text or "",
    TextColor3 = props.colour or T.c.text,
    Font = props.font or T.font.body,
    TextSize = props.size or T.size.body,
    TextXAlignment = props.align or Enum.TextXAlignment.Left,
    TextYAlignment = props.valign or Enum.TextYAlignment.Center,
    Size = props.Size or UDim2.fromScale(1, 1),
    Position = props.Position,
    AnchorPoint = props.AnchorPoint,
    LayoutOrder = props.LayoutOrder,
    TextTruncate = props.truncate and Enum.TextTruncate.AtEnd or Enum.TextTruncate.None,
    TextWrapped = props.wrap or false,
    RichText = props.rich or false,
    ZIndex = props.ZIndex or 1,
    Name = props.Name or "Text",
    Parent = props.Parent,
  })
  if props.autoSize then l.AutomaticSize = props.autoSize end
  if props.truncate and props.tip ~= false then A.tips[#A.tips + 1] = l end
  return l
end

function A.divider(parent, order)
  return mk("Frame", {
    Size = UDim2.new(1, 0, 0, 1),
    BackgroundColor3 = T.c.line,
    BackgroundTransparency = 0.4,
    BorderSizePixel = 0,
    LayoutOrder = order,
    Name = "Divider",
    Parent = parent,
  })
end

-- Vertical gradient used on the accent. Two stops of the SAME hue family, never
-- two unrelated colours -- a gradient between distant hues passes through a
-- third colour that belongs to no part of the palette.
-- Tracked separately from L.paints: a ColorSequence is not a Color3, so the
-- generic registry in L.mk cannot see it. These are rebuilt on a palette change.
--
-- NOT a weak table. An Instance held only by the Roblox tree is unreachable from
-- Lua's point of view, so weak keys let the entries be collected and the set was
-- empty by the time a repaint asked for it -- 0 gradients repainted while 526
-- plain properties worked. Held strongly and pruned on use instead.
A.accentGradients = {}

function A.accentGradient(parent, rotation)
  local g = mk("UIGradient", {
    Color = ColorSequence.new(T.c.accent, T.c.accentAlt),
    Rotation = rotation or 90,
    Parent = parent,
  })
  A.accentGradients[g] = true
  return g
end

function A.repaintGradients()
  local n = 0
  for g in pairs(A.accentGradients) do
    if g.Parent then
      g.Color = ColorSequence.new(T.c.accent, T.c.accentAlt)
      n = n + 1
    else
      A.accentGradients[g] = nil
    end
  end
  return n
end

-- ---------------------------------------------------------------- depth
--
-- ROBLOX HAS NO BOX-SHADOW AND NO RADIAL GRADIENT. That single fact is why every
-- dark Roblox hub looks flat, including every earlier version of this one. Both
-- fakes were tried here and both failed the same way: a radial falloff built
local getAsset = rawget(getgenv(), "getcustomasset") or rawget(getgenv(), "getsynasset")

-- RESOLVED ON FIRST USE, NOT AT LOAD. getcustomasset copies the file into the
-- content folder, so each call costs real milliseconds -- and resolving all
-- twelve sprites at module scope was most of the 306 ms this script blocked for
-- before the loading screen could draw its first frame. That is the freeze you
-- get the instant you execute. Nothing here is needed until something is built,
-- and by then we are inside a coroutine that yields.
local UI_DIR = "lumen_fx/ui"
local IMG_FILES = { shadow = "shadow.png", glow = "glow.png",
                    ring = "ring.png", grain = "grain.png",
                    flare = "flare.png", beam = "beam.png" }

local function resolveAsset(path)
  if type(getAsset) ~= "function" then return nil end
  local ok, present = pcall(isfile, path)
  if not ok or not present then return nil end
  local gok, id = pcall(getAsset, path)
  return gok and id or nil
end

-- Misses are remembered so a missing file is not re-resolved on every lookup.
-- But they must NOT be remembered forever: a pack can land mid-session, and a
-- permanent negative cache meant the sprite stayed missing until the next
-- execute even though the file was now on disk. A.forgetMisses() clears them.
local imgTried = {}
A.img = setmetatable({}, { __index = function(t, k)
  if imgTried[k] then return nil end
  imgTried[k] = true
  local id = IMG_FILES[k] and resolveAsset(UI_DIR .. "/" .. IMG_FILES[k])
  if id then rawset(t, k, id) end
  return id
end })

---Drop the negative cache so sprites installed since the last lookup resolve.
function A.forgetMisses()
  local n = 0
  for k in pairs(imgTried) do
    if rawget(A.img, k) == nil then imgTried[k] = nil n = n + 1 end
  end
  return n
end

function A.hasImages() return A.img.shadow ~= nil end

-- Soft drop shadow behind a panel. 9-slice, so it stretches to any size without
-- the blurred corners smearing -- Roblox scales only the centre of a sliced
-- image, which is exactly why the blur margin lives inside the slice border.
-- THE DARK BOX. Every one of them, and they were all this.
--
-- The sprite is nine-sliced at (72, 72, 120, 120): 72 px of border on each
-- side, so 144 px is the smallest element that still has room for the soft
-- falloff between its corners.
--
-- A toast's shadow renders at 404 x 137. One hundred and thirty-seven is less
-- than one hundred and forty-four, so vertically there is NO middle left --
-- Roblox squashes the two 72 px corner bands into each other and the gradient
-- collapses into a hard rectangle. At the toast's settled ImageTransparency of
-- 0.42 that is a 58%-opaque black block, slightly larger than the card, fading
-- in over ~0.3 s behind it. Which is exactly what it looked like: a dark box,
-- a beat late, that then goes away.
--
-- It was never a timing bug, which is why twice re-timing it changed nothing.
-- Every shadow in the hub comes through here, so every panel, toast and pin
-- small enough to trip the threshold had the same block behind it.
--
-- SliceScale shrinks the borders proportionally, so the corners always fit and
-- the falloff survives at any size. Bound to AbsoluteSize rather than computed
-- once: these elements are sprung, and a shadow that is correct only at its
-- resting size is wrong for the whole animation -- which is the part you
-- actually see.
local SLICE_PX = 72

function A.shadow(target, opts)
  if not A.img.shadow then return nil end
  opts = opts or {}
  local spread = opts.spread or 26
  local sh = mk("ImageLabel", {
    AnchorPoint = Vector2.new(0.5, 0.5),
    Position = UDim2.new(0.5, 0, 0.5, opts.lift or 6),
    Size = UDim2.new(1, spread * 2, 1, spread * 2),
    BackgroundTransparency = 1,
    Image = A.img.shadow,
    ImageTransparency = opts.alpha or 0.35,
    ImageColor3 = opts.colour or Color3.new(0, 0, 0),
    ScaleType = Enum.ScaleType.Slice,
    SliceCenter = Rect.new(SLICE_PX, SLICE_PX, 120, 120),
    ZIndex = (opts.ZIndex or 0),
    Name = "Shadow", Parent = opts.Parent or target.Parent,
  })

  local function fitSlice()
    if not sh.Parent then return end
    local s = sh.AbsoluteSize
    local smallest = math.min(s.X, s.Y)
    if smallest <= 0 then return end
    -- keep a sliver of middle rather than exactly zero, or the two corner
    -- bands meet and the seam reads as a line across the shadow
    local want = math.clamp(smallest / (SLICE_PX * 2.25), 0.2, 1)
    if math.abs(sh.SliceScale - want) > 0.01 then sh.SliceScale = want end
  end
  fitSlice()
  L.hold(sh:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitSlice))

  return sh
end

-- Real radial bloom. Replaces the stacked-circle version entirely.
function A.glow(parent, size, colour, opts)
  opts = opts or {}
  if not A.img.glow then return nil end
  return mk("ImageLabel", {
    AnchorPoint = Vector2.new(0.5, 0.5),
    Position = opts.Position or UDim2.fromScale(0.5, 0.5),
    Size = UDim2.fromOffset(size, size),
    BackgroundTransparency = 1,
    Image = A.img.glow,
    ImageColor3 = colour,
    ImageTransparency = opts.alpha or 0.72,
    ZIndex = opts.ZIndex or 1,
    Name = "Glow", Parent = parent,
  })
end

-- Chrome icon tiles, extracted from the reference render. These are real 3D
-- glass objects; nothing drawn from frames gets anywhere near this, and the
-- dispersion along their edges is the only place spectral colour appears.
-- lazy, for the same reason A.img is
local ICON_DIR = "lumen_fx/icons"
local iconTried = {}
A.icons = setmetatable({}, { __index = function(t, k)
  if iconTried[k] then return nil end
  iconTried[k] = true
  local id = resolveAsset(ICON_DIR .. "/" .. tostring(k) .. ".png")
  if id then rawset(t, k, id) end
  return id
end })

function A.chrome(parent, name, size, opts)
  opts = opts or {}
  local id = A.icons[name]
  if not id then return nil end
  return mk("ImageLabel", {
    Size = UDim2.fromOffset(size, size),
    Position = opts.Position,
    AnchorPoint = opts.AnchorPoint,
    BackgroundTransparency = 1,
    Image = id,
    ImageTransparency = opts.alpha or 0,
    ZIndex = opts.ZIndex or 2,
    Name = "Chrome", Parent = parent,
  })
end

-- Tiled grain. A big flat gradient in an 8-bit framebuffer bands; a couple of
-- levels of noise dither it away. Same reason film grain exists.
function A.grain(parent, alpha)
  if not A.img.grain then return nil end
  return mk("ImageLabel", {
    Size = UDim2.fromScale(1, 1),
    BackgroundTransparency = 1,
    Image = A.img.grain,
    ImageTransparency = alpha or 0.94,
    ScaleType = Enum.ScaleType.Tile,
    TileSize = UDim2.fromOffset(128, 128),
    ZIndex = 1,
    Name = "Grain", Parent = parent,
  })
end

-- Vertical wash across a surface. Two stops of the same colour at different
-- brightness, never two hues -- this is a light source, not a decoration.
function A.wash(parent, topLift, bottomDrop)
  return mk("UIGradient", {
    Color = ColorSequence.new(
      Color3.new(1, 1, 1),
      Color3.new(1 - (bottomDrop or 0.10), 1 - (bottomDrop or 0.10), 1 - (bottomDrop or 0.10))
    ),
    Transparency = NumberSequence.new(0),
    Rotation = 90,
    Offset = Vector2.new(0, topLift or 0),
    Parent = parent,
  })
end

-- A hairline that fades out at both ends. A full-width 1 px line reads as a
-- border; one that dissolves at the edges reads as a highlight catching light.
function A.hairline(parent, colour, y, alpha)
  local f = mk("Frame", {
    Position = UDim2.new(0, 0, 0, y or 0),
    Size = UDim2.new(1, 0, 0, 1),
    BackgroundColor3 = colour,
    BorderSizePixel = 0, ZIndex = 6,
    Parent = parent,
  })
  mk("UIGradient", {
    Transparency = NumberSequence.new({
      NumberSequenceKeypoint.new(0, 1),
      NumberSequenceKeypoint.new(0.5, alpha or 0.25),
      NumberSequenceKeypoint.new(1, 1),
    }),
    Parent = f,
  })
  return f
end

-- ---------------------------------------------------------------- world blur
--
-- The single largest visual upgrade available, and it costs one instance: blur
-- the 3D world while the hub is open. A crisp game behind a flat panel is
-- exactly what makes an overlay look pasted on; pushing the world out of focus
local Lighting = game:GetService("Lighting")

function A.worldBlur()
  if A._blur and A._blur.Parent then return A._blur end
  local b = Instance.new("BlurEffect")
  b.Name = "LumenBlur"
  b.Size = 0
  b.Enabled = true
  b.Parent = Lighting
  L.own(b)
  A._blur = b
  return b
end

function A.blurTo(size, token)
  local b = A.worldBlur()
  M.to(b, "Size", size, token or "slow")
end

-- ---------------------------------------------------------------- scrolling
--
-- SPRUNG SCROLLING. Roblox writes CanvasPosition in instant jumps on every wheel
-- notch, which is the one genuinely jerky thing left in the interface -- and it
-- cannot be eased, because the engine owns the property.
A._scrolls = setmetatable({}, { __mode = "k" })

-- THE WHEEL HAS TO BE SUNK, NOT JUST HANDLED.
local CAS = game:GetService("ContextActionService")
A._wheelGuards = {}

function A.addWheelGuard(fn)
  A._wheelGuards[#A._wheelGuards + 1] = fn
end

do
  local NAME = "LumenWheelSink"
  pcall(function() CAS:UnbindAction(NAME) end)
  CAS:BindActionAtPriority(NAME, function()
    for _, fn in ipairs(A._wheelGuards) do
      local ok, want = pcall(fn)
      if ok and want then return Enum.ContextActionResult.Sink end
    end
    return Enum.ContextActionResult.Pass
  end, false, Enum.ContextActionPriority.High.Value + 10, Enum.UserInputType.MouseWheel)

  L.hold({ Disconnect = function() pcall(function() CAS:UnbindAction(NAME) end) end })
end

local SCROLL_TOKEN = { 0.26, 0.0 }

function A.smoothScroll(scroll, opts)
  opts = opts or {}
  if A._scrolls[scroll] then return A._scrolls[scroll] end

  scroll.ScrollingEnabled = true
  local ctrl = { obj = scroll, target = scroll.CanvasPosition.Y }
  local speed = opts.speed or 96

  local function maxY()
    return math.max(scroll.AbsoluteCanvasSize.Y - scroll.AbsoluteWindowSize.Y, 0)
  end

  function ctrl:clamp()
    self.target = math.clamp(self.target, 0, maxY())
    return self.target
  end

  function ctrl:to(y, immediate)
    self.target = y
    self:clamp()
    local v = Vector2.new(0, self.target)
    if immediate then M.set(scroll, "CanvasPosition", v)
    else M.to(scroll, "CanvasPosition", v, SCROLL_TOKEN) end
  end

  function ctrl:reset()
    self.target = 0
    M.set(scroll, "CanvasPosition", Vector2.zero)
  end

  function ctrl:nudge(delta)
    self:to(self.target + delta)
  end

  scroll.InputChanged:Connect(function(i)
    if i.UserInputType ~= Enum.UserInputType.MouseWheel then return end
    -- Position.Z carries the notch direction: +1 up, -1 down
    ctrl:nudge(-i.Position.Z * speed)
  end)

  A._scrolls[scroll] = ctrl
  return ctrl
end

function A.scrollReset(scroll)
  local c = A._scrolls[scroll]
  if c then c:reset() else scroll.CanvasPosition = Vector2.zero end
end

function A.scroll(props)
  local s = mk("ScrollingFrame", {
    BackgroundTransparency = 1,
    BorderSizePixel = 0,
    Size = props.Size or UDim2.fromScale(1, 1),
    Position = props.Position,
    CanvasSize = UDim2.new(),
    AutomaticCanvasSize = Enum.AutomaticSize.Y,
    ScrollingDirection = Enum.ScrollingDirection.Y,
    ScrollBarThickness = props.bar or 2,
    ScrollBarImageColor3 = T.c.lineStrong,
    ScrollBarImageTransparency = 0.3,
    ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
    Name = props.Name or "Scroll",
    Parent = props.Parent,
  })
  if props.gap then L.list(props.gap, nil, s) end
  -- explicit > 0 test: `padding = 0` is TRUTHY in Lua, so the old check built
  -- a zero UIPadding and any padding the caller added afterwards became a
  -- second one on the same instance, which Roblox silently ignores.
  if props.padding and props.padding > 0 then
    L.pad(props.padding, props.padding, props.padding, props.padding, s)
  end
  -- AutomaticCanvasSize grows the canvas from zero, and CanvasPosition 0 against
  -- a zero-height canvas already counts as "the bottom" -- so a list can end up
  -- pinned to its own end as it fills. Deferring one frame and re-zeroing costs
  -- nothing and removes a genuinely baffling bug.
  task.defer(function()
    if s.Parent then s.CanvasPosition = Vector2.new(0, 0) end
  end)
  if props.smooth ~= false then A.smoothScroll(s) end
  return s
end

-- ---------------------------------------------------------------- icons
--
-- Every glyph is built from `bar`: a rounded rectangle, rotated. A chevron is
-- two bars at +/-45 degrees; a cross is two at +/-45 crossing; a check is two of
-- unequal length. All of it inherits colour from the token palette.
local Icon = {}
A.Icon = Icon

local function bar(parent, w, h, x, y, rot, colour, thickness)
  local b = mk("Frame", {
    AnchorPoint = Vector2.new(0.5, 0.5),
    Position = UDim2.fromOffset(x, y),
    Size = UDim2.fromOffset(w, h or thickness or 2),
    Rotation = rot or 0,
    BackgroundColor3 = colour,
    BorderSizePixel = 0,
    Parent = parent,
  })
  L.corner(999, b)
  return b
end

local function holder(parent, size, name)
  return mk("Frame", {
    Size = UDim2.fromOffset(size, size),
    BackgroundTransparency = 1,
    Name = name or "Icon",
    Parent = parent,
  })
end

-- direction: "right" | "left" | "up" | "down"
function Icon.chevron(parent, size, colour, direction)
  local h = holder(parent, size, "Chevron")
  local c = size / 2
  local arm = size * 0.30
  local rot = ({ right = 0, down = 90, left = 180, up = 270 })[direction or "right"]
  local inner = mk("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
                              Rotation = rot, Parent = h })
  bar(inner, arm, 1.6, c - arm * 0.18, c - arm * 0.35, 45, colour)
  bar(inner, arm, 1.6, c - arm * 0.18, c + arm * 0.35, -45, colour)
  -- `inner` is returned separately so callers can spring its Rotation: an
  -- expanding dropdown turns its chevron rather than swapping the glyph.
  return h, inner
end

function Icon.check(parent, size, colour)
  local h = holder(parent, size, "Check")
  local c = size / 2
  bar(h, size * 0.30, 1.8, c - size * 0.16, c + size * 0.10, 45, colour)
  bar(h, size * 0.52, 1.8, c + size * 0.09, c - size * 0.02, -45, colour)
  return h
end

function Icon.close(parent, size, colour)
  local h = holder(parent, size, "Close")
  local c = size / 2
  bar(h, size * 0.62, 1.6, c, c, 45, colour)
  bar(h, size * 0.62, 1.6, c, c, -45, colour)
  return h
end

function Icon.minus(parent, size, colour)
  local h = holder(parent, size, "Minus")
  bar(h, size * 0.62, 1.6, size / 2, size / 2, 0, colour)
  return h
end

function Icon.dot(parent, size, colour)
  local h = holder(parent, size, "Dot")
  bar(h, size * 0.34, size * 0.34, size / 2, size / 2, 0, colour)
  return h
end

function Icon.search(parent, size, colour)
  local h = holder(parent, size, "Search")
  local r = size * 0.30
  local ring = mk("Frame", {
    AnchorPoint = Vector2.new(0.5, 0.5),
    Position = UDim2.fromOffset(size * 0.44, size * 0.42),
    Size = UDim2.fromOffset(r * 2, r * 2),
    BackgroundTransparency = 1, Parent = h,
  })
  L.corner(999, ring)
  L.stroke(colour, 1.6, 0, ring)
  bar(h, size * 0.26, 1.6, size * 0.72, size * 0.72, 45, colour)
  return h
end

-- Three stacked bars of descending length. Reads as "list" / "menu" / "options".
function Icon.bars(parent, size, colour)
  local h = holder(parent, size, "Bars")
  bar(h, size * 0.62, 1.6, size * 0.5, size * 0.30, 0, colour)
  bar(h, size * 0.62, 1.6, size * 0.5, size * 0.50, 0, colour)
  bar(h, size * 0.40, 1.6, size * 0.4, size * 0.70, 0, colour)
  return h
end

function Icon.grip(parent, size, colour)
  local h = holder(parent, size, "Grip")
  for r = 0, 1 do
    for c = 0, 2 do
      bar(h, 2, 2, size * (0.36 + r * 0.28), size * (0.26 + c * 0.24), 0, colour)
    end
  end
  return h
end

-- A ring with a gap, used as the spinner. Rotating a gapped ring reads as motion
-- far better than a rotating solid, and needs no image.
function Icon.spinner(parent, size, colour)
  local h = holder(parent, size, "Spinner")
  local ring = mk("Frame", {
    Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = h,
  })
  L.corner(999, ring)
  local st = L.stroke(colour, 2, 0, ring)
  local grad = mk("UIGradient", {
    Transparency = NumberSequence.new({
      NumberSequenceKeypoint.new(0, 0),
      NumberSequenceKeypoint.new(0.55, 0.15),
      NumberSequenceKeypoint.new(1, 1),
    }),
    Parent = st,
  })
  return h, grad
end

-- ---------------------------------------------------------------- interaction

-- Adds a state layer and returns a controller. `hover` and `press` are the two
-- states every control shares; giving them one implementation is what makes the
-- whole framework feel like one product.
-- Puts `spot` exactly under the pointer, expressed in `frame`'s own coordinates.
--
-- The inset correction that used to live here was BACKWARDS, and it is now gone
-- entirely: `L.pointerIn` returns the cursor already in this frame's local,
-- pre-UIScale space. See the measurement in lm_00_core -- GetMouseLocation is
-- the inset-INCLUDED reading, so adding the inset to it (as this did) and then
-- subtracting an AbsolutePosition put the light 116 px below the pointer.
-- ONE FIXED SIZE CANNOT BE RIGHT FOR EVERY CONTROL, and this was 150 x 150 for
-- all of them. On a 26 px dock pill that is a wash of colour over the entire
-- button with no falloff visible anywhere -- there is no gradient left inside
-- the control, just a tinted pill. On a 520 px panel header it is a small dot
-- with a hard end to it. Neither reads as a light source.
--
-- The comment that used to sit on the ImageLabel said the glow was "wider than
-- the row is tall, so the falloff runs along the control". It was square. This
-- makes the comment true: the ellipse is sized from the control every time its
-- bounds change, tall enough to spill past the top and bottom edges (so the
-- falloff you see is horizontal, along the direction you actually move) and
-- never so wide that it stops being a highlight.
local function fitSpot(frame, spot, sc)
  local a = frame.AbsoluteSize
  if a.X < 1 or a.Y < 1 then return end
  local key = math.floor(a.X + 0.5) * 4096 + math.floor(a.Y + 0.5)
  if spot:GetAttribute("__fit") == key then return end
  spot:SetAttribute("__fit", key)
  local h = a.Y / math.max(sc, 0.01)              -- pre-UIScale local units
  local w = a.X / math.max(sc, 0.01)
  -- A POOL, NOT A WASH. The first pass at this scaled off the control and came
  -- out 185 x 119 on a 187 x 46 row -- a glow the size of the whole control,
  -- which is not a highlight, it is a second background. Sized to a little over
  -- the control's HEIGHT instead, so there is lit area and unlit area inside
  -- one row and the light has an edge you can actually see move.
  local gh = math.clamp(h * 1.25, 26, 84)
  local gw = math.clamp(gh * 1.9, 40, 150)
  spot.Size = UDim2.fromOffset(math.floor(gw), math.floor(gh))
end

-- TWO FRAMES OF LAG IS SMOOTH; A SPRING IS LOST.
--
-- The note that stood here said a cursor light has no business being animated,
-- and it was right about what it was describing: the position was going through
-- M.to -- a real spring, ~180 ms -- driven off MouseMoved, which fires less
-- often than the screen redraws. That light was permanently travelling to where
-- the pointer had just been, and between events it did not move at all.
--
-- This is a different quantity: a first-order approach evaluated EVERY frame,
-- with a time constant short enough to be smoothing rather than animation.
-- Worked out rather than eyeballed, at 60 fps (dt = 16.7 ms):
--
--   retention per frame  exp(-16.7/18) = 0.40    -- 60% of the error gone each frame
--   20 px step           7.9 -> 3.1 -> 1.2 -> 0.5 px   (settled in 4 frames, 67 ms)
--   steady-state lag     v * tau: 250 px/s -> 4.5 px, 800 px/s -> 14 px
--
-- The first draft used tau = 35 ms, where the error decays only 38% a frame and
-- a 26 px step needs nearly seven of them -- which is exactly the trailing the
-- note above complains about, just with a smaller constant. 18 ms removes the
-- per-frame jitter of raw pointer sampling and nothing else.
--
-- The distance is clamped too, so a hitch or a flick across the screen cannot
-- leave the light stranded: past MAX_LAG it stops interpolating and teleports.
-- 0.55 was loud enough to read as a coloured smear rather than as light on a
-- surface. At 0.74 the pool has an edge and the control underneath still shows
-- through it, which is the difference between lighting something and painting it.
local SPOT_REST = 0.74

local SPOT_TAU = 0.018
local SPOT_MAX_LAG = 14        -- local px; beyond this, snap rather than trail

function A.aimSpot(frame, spot, dt, h)
  if not (frame and spot and frame.Parent) then return end
  local sc = (L.Hub and L.Hub.window and L.Hub.window.scaleObj
              and L.Hub.window.scaleObj.Scale) or 1
  fitSpot(frame, spot, sc)
  local rel = L.pointerIn(frame, sc)
  local x, y = rel.X, rel.Y

  if h and dt and h.sx then
    local k = 1 - math.exp(-dt / SPOT_TAU)
    local nx = h.sx + (x - h.sx) * k
    local ny = h.sy + (y - h.sy) * k
    local dx, dy = x - nx, y - ny
    if (dx * dx + dy * dy) > (SPOT_MAX_LAG * SPOT_MAX_LAG) then
      nx, ny = x, y
    end
    h.sx, h.sy = nx, ny
    x, y = nx, ny
  elseif h then
    h.sx, h.sy = x, y                    -- first frame of a hover: no trail
  end
  spot.Position = UDim2.fromOffset(x, y)

  -- THE BORDER LIGHTS ON THE SIDE THE POINTER IS ON.
  --
  -- This is the part that stops it reading as a generic blob. A rim whose
  -- bright arc tracks the cursor is a surface catching a moving light; a rim
  -- that is always brightest at the top is a border with a gradient on it.
  -- Costs one Rotation write a frame.
  --
  -- A UIGradient at Rotation R runs along (cos R, sin R) with keypoint 0 on the
  -- far side, so putting the bright key (0.00) under the pointer at bearing
  -- theta means R = theta - 180.
  if h and h.rim then
    local a = frame.AbsoluteSize
    local cx, cy = a.X / (2 * sc), a.Y / (2 * sc)
    local vx, vy = x - cx, y - cy
    if (vx * vx + vy * vy) > 4 then
      h.rim.Rotation = math.deg(math.atan2(vy, vx)) - 180
    end
  end
end

-- ---------------------------------------------------------------- selection
--
-- ONE ANSWER TO "WHICH ONE IS CHOSEN", USED BY EVERY LIST.
--
-- The dropdown said it with a 0.86-transparent wash and accent text -- 14% of
-- an already dark colour, on a row 26 px tall. Against a busy page that is not
-- a state, it is a suggestion, and it looked broken rather than subtle. The
-- side panel and the command centre each had a third and fourth answer.
--
-- Three signals, because one is never enough on a dark surface: a fill you can
-- actually see, the accent on the text, and a bar down the leading edge that
-- has no other meaning anywhere in the interface. The bar is what makes it
-- unambiguous at a glance -- fills read as hover, bars read as chosen.
A.SEL_FILL  = 0.80          -- transparency of the selected row's wash
A.SEL_BAR_W = 3

function A.selectMark(frame)
  local bar = frame:FindFirstChild("SelBar")
  if bar then return bar end
  bar = mk("Frame", {
    AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
    Size = UDim2.new(0, A.SEL_BAR_W, 0, 0),
    BackgroundColor3 = T.c.accent, BorderSizePixel = 0,
    BackgroundTransparency = 0, ZIndex = (frame.ZIndex or 1) + 1,
    Name = "SelBar", Parent = frame,
  })
  L.corner(999, bar)
  return bar
end

-- `on` selects, and the label is optional for callers that colour their own.
function A.selectRow(frame, label, on, token)
  if not frame then return end
  token = token or "fast"
  local bar = A.selectMark(frame)
  M.to(frame, "BackgroundTransparency", on and A.SEL_FILL or 1, token)
  M.to(bar, "Size", UDim2.new(0, A.SEL_BAR_W, 0, on and 14 or 0), token)
  M.to(bar, "BackgroundTransparency", on and 0 or 1, token)
  if label then
    M.to(label, "TextColor3", on and T.c.accent or T.c.textDim, token)
  end
end

-- ---------------------------------------------------------------- chrome
--
-- A TRAVELLING HIGHLIGHT, BUILT BY SAMPLING RATHER THAN BY OFFSET.
--
-- The page titles sweep a UIGradient by animating its Offset from -1 to +1. A
-- UIGradient only defines colour over [0, 1] and CLAMPS outside it, so for a
-- large part of that cycle the bright band is not on the letters at all:
--
--   bright key sits at p = 0.34, appears at object x = 0.34 + offset
--   so it is inside the glyphs only for offset in [-0.34, 0.66]
--   -- one unit out of the two the sweep travels. Half the cycle is flat.
--
-- Which is why the titles spend as long looking like dark grey text as they do
-- looking like metal. Widening the range does not help; the highlight has to
-- LEAVE somewhere, and with a single gradient there is nowhere for it to go.
--
-- So the offset is abandoned and the gradient's colours are resampled instead.
-- The pattern below is defined in a wrapped space, sampled at fixed positions
-- across whatever slice of it a given label occupies, and rebuilt as the phase
-- advances. Nothing clamps, because the keys always span exactly [0, 1] -- and
-- because the pattern wraps, the highlight that leaves the right edge is the
-- same one arriving at the left. It never goes flat.
--
-- The slice is what lets a word split across several labels share ONE sweep:
-- give glyph i the slice [i/n, (i+1)/n] and the highlight crosses the word,
-- rather than five letters each flashing on their own.
A.CHROME = {
  __default = { rot =   8, speed = 0.16, warm = Color3.fromRGB(196, 182, 140) },
  Movement  = { rot =  22, speed = 0.30, warm = Color3.fromRGB(150, 196, 214) },
  Combat    = { rot =   0, speed = 0.11, warm = Color3.fromRGB(214, 150, 140), hard = true },
  Visuals   = { rot = -16, speed = 0.20, warm = Color3.fromRGB(178, 158, 214), prism = true },
  -- The loading screen had its own richer "Boot" preset here. It read as a
  -- different product from the page titles, so it uses __default like they do
  -- -- one preset, and the two cannot drift apart.
}

local STEEL  = Color3.fromRGB(120, 124, 132)
local BRIGHT = Color3.fromRGB(248, 249, 252)
local DARK   = Color3.fromRGB( 78,  82,  90)

-- The pattern is a wrapped ring: position 1 is the same place as position 0, so
-- the first and last colour MUST match or the seam shows as a dark bar.
function A.chromePattern(cfg)
  cfg = cfg or A.CHROME.__default
  if cfg.hard then
    return { {0.00, STEEL}, {0.38, STEEL}, {0.40, BRIGHT}, {0.52, cfg.warm},
             {0.54, DARK},  {0.72, STEEL}, {1.00, STEEL} }
  elseif cfg.prism then
    return { {0.00, STEEL}, {0.18, Color3.fromRGB(150, 196, 214)},
             {0.36, BRIGHT}, {0.50, cfg.warm},
             {0.64, Color3.fromRGB(214, 170, 150)}, {0.82, DARK},
             {1.00, STEEL} }
  end
  return { {0.00, STEEL}, {0.26, BRIGHT}, {0.38, cfg.warm}, {0.54, DARK},
           {0.72, Color3.fromRGB(236, 238, 242)}, {1.00, STEEL} }
end

local function patternAt(pat, t)
  t = t % 1
  for i = 1, #pat - 1 do
    local a, b = pat[i], pat[i + 1]
    if t >= a[1] and t <= b[1] then
      local span = b[1] - a[1]
      return a[2]:Lerp(b[2], span > 0 and (t - a[1]) / span or 0)
    end
  end
  return pat[#pat][2]
end

-- 20 is the ColorSequence keypoint ceiling, and a hard-cut preset wants every
-- one of them -- sampled coarsely the cut turns into a ramp.
local CHROME_SAMPLES = 20

function A.chromeSeq(pat, phase, a, b)
  a, b = a or 0, b or 1
  local keys = {}
  for i = 0, CHROME_SAMPLES - 1 do
    local x = i / (CHROME_SAMPLES - 1)
    keys[i + 1] = ColorSequenceKeypoint.new(x, patternAt(pat, (a + (b - a) * x) - phase))
  end
  return ColorSequence.new(keys)
end

-- ---------------------------------------------------------------- fading
--
-- STROKES ARE PART OF A FADE, AND LEAVING THEM OUT IS WHY THINGS LEAVE A LINE.
--
-- A panel that fades by walking BackgroundTransparency and TextTransparency
-- looks finished and is not: its UIStroke is still sitting at its resting value,
-- so a 1 px outline stays lit over whatever is underneath. On the tooltip that
-- reads as a dark line hanging in the air a beat after the text has gone --
-- reported as "a delayed dark string" and visible in the recordings.
--
-- One map, one walk, used everywhere something fades out as a unit.
A.FADE_PROP = {
  Frame = "BackgroundTransparency",
  ScrollingFrame = "BackgroundTransparency",
  TextLabel = "TextTransparency",
  TextButton = "TextTransparency",
  TextBox = "TextTransparency",
  ImageLabel = "ImageTransparency",
  ImageButton = "ImageTransparency",
  CanvasGroup = "GroupTransparency",
  UIStroke = "Transparency",
}

-- GROUPTRANSPARENCY DOES NOT COVER THE GROUP'S OWN UISTROKE.
--
-- This is the bug behind "the dark outline is still there and it lags". A
-- CanvasGroup composites its CHILDREN and fades that composite; a UIStroke
-- parented to the CanvasGroup itself is not one of those children, so it keeps
-- drawing at its own transparency for the entire fade. Measured on the live
-- window, held mid-fade:
--
--   root.GroupTransparency = 0.92   -- contents faded to almost nothing
--   root's UIStroke        = 0.30   -- a solid rounded outline, full strength
--
-- Which is a bright 1 px rectangle around an empty hole, drawn over the game,
-- for the whole duration of every hide -- and then snapped away by Visible =
-- false at the end, which is what reads as the delay.
--
-- lm_05_window even asserted the opposite in a comment: "Body, wash, stroke,
-- icons and text all leave through GroupTransparency." Everything in that list
-- is true except the stroke.
--
-- Use this anywhere a CanvasGroup is faded by hand.
function A.groupTo(group, alpha, token)
  if not group then return end
  M.to(group, "GroupTransparency", alpha, token)
  if group:GetAttribute("GiorgioFadeGroup") then return end
  for _, d in ipairs(group:GetChildren()) do
    if d:IsA("UIStroke") then
      local rest = L.strokeRest(d)
      M.to(d, "Transparency", rest + (1 - rest) * alpha, token)
    end
  end
end

-- Same, without animating: for the set-then-reveal pattern.
function A.groupSet(group, alpha)
  if not group then return end
  M.set(group, "GroupTransparency", alpha)
  if group:GetAttribute("GiorgioFadeGroup") then return end
  for _, d in ipairs(group:GetChildren()) do
    if d:IsA("UIStroke") then
      local rest = L.strokeRest(d)
      M.set(d, "Transparency", rest + (1 - rest) * alpha)
    end
  end
end

-- Rest values are captured ONCE and cached on the instance. Reading them again
-- mid-fade records "invisible" as the resting state and the thing never comes
-- back -- the same trap the row cascade and the dock pill both hit.
function A.fadeSet(root)
  if not root then return {} end
  local cached = root:GetAttribute("__fadeCached")
  if cached and A._fadeSets and A._fadeSets[root] then return A._fadeSets[root] end
  local parts = {}
  local function add(o)
    local p = A.FADE_PROP[o.ClassName]
    if not p then return end
    local ok, v = pcall(function() return o[p] end)
    if ok and type(v) == "number" and v < 1 then parts[#parts + 1] = { o, p, v } end
  end
  add(root)
  for _, d in ipairs(root:GetDescendants()) do add(d) end
  A._fadeSets = A._fadeSets or setmetatable({}, { __mode = "k" })
  A._fadeSets[root] = parts
  pcall(function() root:SetAttribute("__fadeCached", true) end)
  return parts
end

-- k = 0 is fully at rest, k = 1 is fully gone.
function A.fadeTo(root, k, token)
  for _, e in ipairs(A.fadeSet(root)) do
    if e[1].Parent then
      M.to(e[1], e[2], e[3] + (1 - e[3]) * k, token or "fast")
    end
  end
end

-- The one control currently under the pointer, driven by the shared loop below.
A._hover = nil
L.hold(L.RunService.RenderStepped:Connect(function(dt)
  local h = A._hover
  if h then A.aimSpot(h.frame, h.spot, dt, h) end
end))

function A.interactive(frame, opts)
  opts = opts or {}
  local radius = opts.radius or T.r.md

  -- THE HIGHLIGHT MUST BE THE SAME SHAPE AS THE THING IT HIGHLIGHTS, and the
  -- FRAME'S OWN CORNER IS THE SOURCE OF TRUTH -- not the radius passed in.
  --
  -- Everything added below is rounded: the hover wash, the sweep, the spotlight
  -- host. The press/focus edge is a UIStroke, and a UIStroke follows the corner
  -- of the frame it is parented to. Two ways that went wrong:
  --
  --   NO CORNER AT ALL. Controls built on A.surface carry one, but anything that
  --   did not -- most visibly the sidebar tabs -- got a SQUARE outline drawn
  --   around a rounded fill, sitting outside the frame in Border mode, so it read
  --   as a slightly larger box of the wrong shape.
  --
  --   A DIFFERENT CORNER. A caller passing a radius that disagrees with the one
  --   already on the frame produced a highlight that did not follow the edge it
  --   was highlighting. Trusting the argument here would leave that mismatch in
  --   place, so the frame wins and the argument is only a default.
  --
  -- Radii are read back as PIXELS. L.corner multiplies by the user's radius
  -- setting, so feeding a value that has already been scaled back through it
  -- would scale it twice.
  local existingCorner = frame:FindFirstChildOfClass("UICorner")
  if not existingCorner then
    existingCorner = L.corner(radius, frame)
  end
  local radiusPx = existingCorner.CornerRadius.Offset
  local function matchCorner(parent)
    return mk("UICorner", { CornerRadius = UDim.new(0, radiusPx), Parent = parent })
  end

  local layer = mk("Frame", {
    Size = UDim2.fromScale(1, 1),
    BackgroundColor3 = opts.layerColour or Color3.new(1, 1, 1),
    BackgroundTransparency = 1,
    BorderSizePixel = 0,
    ZIndex = (frame.ZIndex or 1) + 4,
    Name = "State",
    Parent = frame,
  })
  matchCorner(layer)

  -- ---- the fill rises from the bottom ---------------------------------
  --
  -- A flat tint over the whole control says "hovered" and nothing else. Light
  -- pooling at the base of a surface says the surface has a bottom -- which is
  -- the difference between a coloured rectangle and something that looks lit.
  -- Taken from the reference clip: the fill is strongest at the floor of the
  -- pill and gone by two thirds up, so the top edge stays dark for the rim to
  -- read against.
  local fillGrad = mk("UIGradient", {
    Rotation = 90,
    Transparency = NumberSequence.new({
      NumberSequenceKeypoint.new(0.00, 1.00),
      NumberSequenceKeypoint.new(0.34, 0.92),
      NumberSequenceKeypoint.new(0.72, 0.42),
      NumberSequenceKeypoint.new(1.00, 0.10),
    }),
    Parent = layer,
  })

  local btn = mk("TextButton", {
    Size = UDim2.fromScale(1, 1),
    BackgroundTransparency = 1,
    Text = "", AutoButtonColor = false,
    ZIndex = (frame.ZIndex or 1) + 5,
    Name = "Hit",
    Parent = frame,
  })

  -- ---- specular sweep -------------------------------------------------------
  --
  -- A HIGHLIGHT THAT TRAVELS, not a panel that lights up. Every Roblox hub
  -- brightens a row on hover, which communicates "the cursor is here" and
  -- nothing else. A band of light crossing the surface says the surface is made
  local sweepGrad
  local sweepOn = opts.sweep ~= false
                  and not (L.Cfg and L.Cfg.data.sweep == false)
  if sweepOn then
    local sweep = mk("Frame", {
      Size = UDim2.fromScale(1, 1),
      BackgroundColor3 = Color3.new(1, 1, 1),
      BorderSizePixel = 0,
      ZIndex = (frame.ZIndex or 1) + 3,
      Name = "Sweep", Parent = frame,
    })
    matchCorner(sweep)
    sweepGrad = mk("UIGradient", {
      Rotation = 16,
      Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0.00, 1),
        NumberSequenceKeypoint.new(0.40, 1),
        NumberSequenceKeypoint.new(0.50, 0.88),
        NumberSequenceKeypoint.new(0.60, 1),
        NumberSequenceKeypoint.new(1.00, 1),
      }),
      Offset = Vector2.new(-1.2, 0),
      Parent = sweep,
    })
  end

  -- ---- cursor spotlight -----------------------------------------------------
  --
  -- A GLOW THAT FOLLOWS THE POINTER, not one that lights the whole control. The
  -- reference clips both do the same thing: a soft radial bloom sits under the
  -- cursor and travels with it along the button, so the surface reads as lit
  -- from a moving source rather than as a state that toggled on.
  --
  -- Clipped by its own host rather than by `frame`: turning on ClipsDescendants
  -- on the control itself would also crop anything a caller has deliberately
  -- hung outside it, and several rows do exactly that.
  --
  -- A CANVASGROUP, BECAUSE ClipsDescendants CLIPS TO A RECTANGLE.
  --
  -- This was a Frame with ClipsDescendants and a matched UICorner, on the
  -- assumption that the corner rounds the clip region. It does not, and that is
  -- the source of the hard edges: bring the pointer near a rounded control and
  -- the glow stopped at the host's square bounds, drawing a straight edge
  -- across a corner that is meant to be curved.
  --
  -- Measured side by side on this client before changing it:
  --
  --   Frame + UICorner + ClipsDescendants   ->  SQUARE corners
  --   CanvasGroup + UICorner                ->  rounded
  --   oversized child in Frame + Clips      ->  square corner, the exact artifact
  --
  -- A CanvasGroup composites its children and THEN applies the corner, so the
  -- clip follows the curve. The usual objection to CanvasGroups -- that they
  -- resample glyphs and soften text -- does not apply here: this subtree holds
  -- one radial image and no type at all.
  local spot, spotHost
  local spotOn = opts.spot ~= false
                 and not (L.Cfg and L.Cfg.data.spot == false)
                 and A.img.glow ~= nil
  if spotOn then
    spotHost = mk("CanvasGroup", {
      Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
      GroupTransparency = 0, ZIndex = (frame.ZIndex or 1) + 2,
      Name = "SpotHost", Parent = frame,
    })
    matchCorner(spotHost)
    spot = mk("ImageLabel", {
      AnchorPoint = Vector2.new(0.5, 0.5),
      Position = UDim2.fromScale(0.5, 0.5),
      -- a placeholder only: fitSpot resizes this from the control's own bounds
      -- the first frame it is hovered, and again whenever those bounds change
      Size = UDim2.fromOffset(opts.spotSize or 150, opts.spotSize or 150),
      BackgroundTransparency = 1,
      Image = A.img.glow,
      ImageColor3 = opts.spotColour or T.c.accent,
      ImageTransparency = 1,
      ZIndex = (frame.ZIndex or 1) + 2,
      Name = "Spot", Parent = spotHost,
    })
  end

  local state = { hovered = false, pressed = false, enabled = true }

  -- A GRADIENT MULTIPLIES, SO ADDING ONE MADE THE HOVER DIMMER.
  --
  -- The fill gradient above does not add light to the wash, it scales it. At the
  -- old flat 0.94 the arithmetic works out as:
  --
  --   opacity           = 1 - 0.94                       = 0.060  (was uniform)
  --   with the gradient = 0.060 * (1 - 0.10) at the base = 0.054
  --                       0.060 * (1 - 1.00) at the top  = 0.000
  --
  -- So the "brighter" bottom edge was fractionally DARKER than the flat tint it
  -- replaced, and the top half lost its wash entirely -- a net loss of hover
  -- feedback, which is the opposite of the point. These are the levels that put
  -- the base meaningfully above the old flat value while still letting the top
  -- go dark for the rim to read against:
  --
  --   base 1 - 0.88 = 0.120, times 0.90 = 0.108   -- 1.8x the old wash
  --   top                                = 0.000   -- rim has something to sit on
  local HOVER = opts.hoverAlpha or 0.88
  local PRESS = opts.pressAlpha or 0.80

  -- PRESS FEEDBACK IS A STROKE WHEREVER A LAYOUT IS WATCHING.
  --
  -- The obvious move is to shrink the control slightly on press. Re-measured on
  -- a live client before touching this, because "a scale would break the layout"
  -- is the kind of claim that ages badly:
  --
  --   4 rows of 40 px in a UIListLayout, UIScale 0.90 on row 2
  --     row 2 AbsoluteSize.Y   40 -> 36
  --     rows 3 and 4 shift     -4 px each
  --
  -- So it is true, and it is true for any scale: at 0.985 the shift is only
  -- ~0.6 px, but it lands on every row below AND reverses on release, so a list
  -- twitches each time you click anything in it. An accent edge that flares and
  -- fades confirms the press without touching layout at all.
  --
  -- But most of what the reference clip shows are BUTTONS, not rows -- dock
  -- pills, header actions, the command centre -- and those have no layout to
  -- disturb. Those get the dip, because forty milliseconds of movement is most
  -- of what makes a button feel physical. The test is simply whether anything
  -- is currently positioning this frame for us.
  local edge = mk("UIStroke", {
    Color = T.c.accent, Thickness = 1.4, Transparency = 1,
    ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = frame,
  })

  -- Is something else positioning this frame? Two effects need the answer -- the
  -- press dip, which would shove siblings, and the bloom, which would spill onto
  -- them -- so it is worked out once here rather than in each.
  local governedBy = frame.Parent and (frame.Parent:FindFirstChildWhichIsA("UIListLayout")
                   or frame.Parent:FindFirstChildWhichIsA("UIGridLayout")
                   or frame.Parent:FindFirstChildWhichIsA("UITableLayout")) or nil
  local governed = governedBy ~= nil

  -- A UIScale changes the MEASURED size -- that is the whole reason a governed
  -- row reflows -- so scale an INNER node and leave the outer frame alone. The
  -- layout keeps measuring a frame that never changes; the content dips inside
  -- it. Two frames cannot host it: one that sizes itself to its children (a
  -- fromScale child contributes nothing to AutomaticSize, so the row collapses)
  -- and one running its own layout (that layout would be left positioning a
  -- single object). Both keep the stroke-only press they have today.
  local dip
  local pressScale
  if opts.dip ~= false then
    if not governed then
      pressScale = mk("UIScale", { Scale = 1, Parent = frame })
    elseif frame.AutomaticSize == Enum.AutomaticSize.None
       and not frame:FindFirstChildWhichIsA("UILayout") then
      dip = mk("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        BorderSizePixel = 0, ZIndex = frame.ZIndex or 1,
        Name = "Dip", Parent = frame,
      })
      pressScale = mk("UIScale", { Scale = 1, Parent = dip })
    end
  end

  -- ---- rim light and bloom --------------------------------------------
  --
  -- THE RIM IS WHAT SELLS IT. In the reference the pill has a bright thin arc
  -- along its TOP edge that fades away by the sides -- the specular you get when
  -- a light sits above a rounded, slightly glossy surface. A stroke of uniform
  -- brightness reads as a border; the same stroke with a vertical gradient
  -- reads as a lit edge, and it costs one UIGradient.
  --
  -- The bloom is a sibling INSIDE the frame rather than outside it, so a caller
  -- that reparents or destroys the control takes the glow with it. Oversized on
  -- purpose: it is meant to spill past the edge.
  local bloom
  local rimGrad = mk("UIGradient", {
    Rotation = 90,
    Transparency = NumberSequence.new({
      NumberSequenceKeypoint.new(0.00, 0.00),
      NumberSequenceKeypoint.new(0.30, 0.35),
      NumberSequenceKeypoint.new(1.00, 0.85),
    }),
    Parent = edge,
  })
  if A.img and A.img.glow then
    -- SPILLING IS RIGHT FOR A BUTTON AND WRONG FOR A ROW.
    --
    -- 1.9 of the host's height is a deliberate overshoot on something standing
    -- on its own -- a dock pill, a header action -- where there is nothing
    -- beside it to light up. Inside a list it is a leak. Measured on the nav
    -- rail: a 300x73 row grew a 403x139 bloom, +33 px past each edge into a
    -- 4 px gap, so hovering one row lit 29 px of the row above AND the row
    -- below. On a recording it reads as the glow following the cursor around
    -- the whole rail rather than sitting under it.
    --
    -- So the vertical overshoot is spent only where there is room for it: half
    -- the layout's own gap, and no more. The horizontal 1.34 is kept either way
    -- -- a vertical list has nothing to its left or right to contaminate.
    local yScale = 1.9
    if governed then
      local gap = 0
      pcall(function() gap = governedBy.Padding.Offset end)
      local h = frame.AbsoluteSize.Y
      local sc = (L.Hub and L.Hub.window and L.Hub.window.scaleObj
                  and L.Hub.window.scaleObj.Scale) or 1
      h = h / math.max(sc, 0.01)
      yScale = (h > 1) and math.clamp(1 + (gap * 0.5) / h, 1, 1.9) or 1
    end
    bloom = mk("ImageLabel", {
      AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
      Size = UDim2.fromScale(1.34, yScale), BackgroundTransparency = 1,
      Image = A.img.glow, ImageColor3 = opts.spotColour or T.c.accent,
      ImageTransparency = 1, ZIndex = math.max(1, (frame.ZIndex or 1) - 1),
      Name = "Bloom", Parent = frame,
    })
  end

  local function apply()
    local a = 1
    if state.enabled then
      if state.pressed then a = PRESS
      elseif state.hovered then a = HOVER end
    end
    M.to(layer, "BackgroundTransparency", a, "instant")
    -- these are the values at the TOP of the stroke; the rim gradient takes the
    -- sides and the base down from here, so a flat 0.78 read as almost nothing
    -- once it was in place
    M.to(edge, "Transparency",
      (state.enabled and state.pressed) and 0.20
      or (state.enabled and state.hovered) and 0.68 or 1, "instant")
    if spot then
      -- the light flares under the finger on press, then settles back
      local base = opts.spotAlpha or SPOT_REST
      M.to(spot, "ImageTransparency",
        (state.enabled and state.pressed) and math.max(0, base - 0.20)
        or (state.enabled and state.hovered) and base or 1, "fast")
    end

    local live = state.enabled and (state.hovered or state.pressed)
    if bloom then
      M.to(bloom, "ImageTransparency",
        state.pressed and 0.68 or (live and 0.82 or 1), "fast")
    end
    if rimGrad then
      -- the rim brightens toward uniform on press: a lit edge tipping to face
      -- the light, rather than a second colour appearing from nowhere
      M.to(rimGrad, "Offset", Vector2.new(0, state.pressed and 0.12 or 0), "fast")
    end
    if pressScale then
      M.to(pressScale, "Scale", state.pressed and 0.978 or 1, "fast")
    end
    if opts.onState then opts.onState(state) end
  end

  -- CENTRED ON THE POINTER, EXACTLY. Two different offsets have to cancel or the
  -- light sits away from the cursor instead of under it, and the first version
  -- got both wrong:
  --
  --   INSET.  Both directions of this were asserted in this file at different
  --           times and the sign was wrong. It is now measured once in
  --           lm_00_core and applied by L.pointerIn; do not re-derive it here.
  --   SCALE.  AbsolutePosition is real pixels, a UDim2 offset is pre-UIScale.
  --
  -- Read from GetMouseLocation rather than from MouseMoved's arguments, so there
  -- is one source of truth for where the pointer is and one correction applied
  -- to it. With AnchorPoint at 0.5 the bloom then centres on the cursor exactly.
  -- ONE FOLLOWER FOR THE WHOLE HUB, NOT ONE PER CONTROL.
  --
  -- Only one thing can be under the pointer at a time, so a RenderStepped per
  -- interactive control means ~60 connections firing every frame to have 59 of
  -- them return immediately. The hovered control publishes itself to A._hover
  -- and a single shared loop drives it -- which also means the follower can be
  -- pointed at a control from outside and its accuracy measured, instead of
  -- being reachable only by a real hand on a real mouse.
  -- SET, NOT TWEENED, AND EVERY FRAME.
  --
  -- The arithmetic below was already correct -- verified at (0, -1) px -- and the
  -- glow still did not sit on the cursor, because the position was going through
  -- M.to. That is a spring: it EASES toward the target, so the light was always
  -- travelling to where the pointer had just been. Worse, it was driven off
  -- MouseMoved, which fires less often than the screen redraws, so between
  -- events it did not move at all. A cursor light has no business being
  -- animated -- it is not going anywhere the pointer is not.
  --
  -- Both corrections now live in L.pointerIn, measured rather than reasoned
  -- about. The claim that once stood here -- that GetMouseLocation excludes the
  -- topbar inset -- was the bug, not the fix.
  local function moveSpot()
    if spot then A.aimSpot(frame, spot) end   -- no dt: snaps, for the enter frame
  end

  btn.MouseEnter:Connect(function()
    state.hovered = true
    -- fired on ENTER only, never held: a highlight that loops while the pointer
    -- rests is a busy row, and thirty of them is a page that will not sit still
    if sweepGrad and state.enabled then
      M.set(sweepGrad, "Offset", Vector2.new(-1.2, 0))
      M.to(sweepGrad, "Offset", Vector2.new(1.2, 0), "slow")
    end
    if spot and state.enabled then
      -- placed where the pointer entered BEFORE it is faded up, so the light
      -- never appears mid-flight from wherever it was last hovered
      moveSpot()
      M.to(spot, "ImageTransparency", opts.spotAlpha or SPOT_REST, "base")
      A._hover = { frame = frame, spot = spot, rim = rimGrad }
    end
    apply()
  end)
  btn.MouseLeave:Connect(function()
    state.hovered, state.pressed = false, false
    -- only surrender the follower if it is still ours: entering the next control
    -- fires before this leaves, and clearing unconditionally would kill the glow
    -- that just took over
    if A._hover and A._hover.spot == spot then A._hover = nil end
    if spot then M.to(spot, "ImageTransparency", 1, "base") end
    apply()
  end)
  btn.MouseButton1Down:Connect(function()
    if not state.enabled then return end
    state.pressed = true apply()
  end)
  btn.MouseButton1Up:Connect(function() state.pressed = false apply() end)
  btn.Activated:Connect(function()
    if not state.enabled then return end
    if opts.onClick then if L.Giorgio then L.Giorgio.sound("click",.35) end; L.try("atoms.click", opts.onClick) end
  end)

  -- ---- keep our overlays off the frame's own buttons -----------------------
  --
  -- Under ZIndexBehavior.Sibling the click is decided at the TOP level of this
  -- frame, not by the raw ZIndex under the cursor: every descendant rides in
  -- its parent's slot. So a button nested in a content frame loses to the Hit
  -- overlay above it no matter how high that button's own ZIndex is, and the
  -- container silently swallows the click. Lift any content branch that
  -- carries buttons of its own clear of the overlays. Transparent, inactive
  -- frames do not take input, so the container stays clickable in the gaps.
  local guard = (frame.ZIndex or 1) + 6
  -- FindFirstChildWhichIsA searches DESCENDANTS, so a child that is itself the
  -- input was missed: the slider's click-to-type readout is a childless
  -- TextButton and its entry -- like every input row's field -- is a TextBox.
  -- Both sat under the overlay and stopped responding.
  local function takesInput(o)
    return o:IsA("GuiButton") or o:IsA("TextBox")
       or o:FindFirstChildWhichIsA("GuiButton", true) ~= nil
       or o:FindFirstChildWhichIsA("TextBox", true) ~= nil
  end
  local lifted = false
  for _, child in ipairs(frame:GetChildren()) do
    if child:IsA("GuiObject") and child ~= layer and child ~= btn
       and child ~= dip and child ~= bloom
       and child.Name ~= "Sweep" and child.Name ~= "SpotHost" then
      if child.ZIndex < guard and takesInput(child) then
        child.ZIndex = guard
        lifted = true
      end
      -- the dip host takes the content; the overlays and the bloom stay put
      if dip then child.Parent = dip end
    end
  end
  -- A branch lifted INSIDE the host still rides in the host's slot, so the lift
  -- has to reach the host or the overlay goes straight back to swallowing it.
  if dip and lifted then dip.ZIndex = guard end

  return {
    button = btn, layer = layer, edge = edge, state = state,
    setEnabled = function(v)
      state.enabled = v and true or false
      apply()
    end,
  }
end

-- ---------------------------------------------------------------- tooltips
--
-- A LABEL CUT SHORT IS A PROMISE THE INTERFACE BROKE. Truncating is the right
do
  local tipGui, tipFrame, tipLbl, tipTitle
  local DWELL = 0.35            -- do not flash at every label swept past
  local shownFor, hoverSince, hovered = nil, 0, nil

  local function ensure()
    if tipFrame and tipFrame.Parent then return end
    tipGui = mk("ScreenGui", {
      Name = "LumenTip", ResetOnSpawn = false, IgnoreGuiInset = true,
      ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 60,
    })
    tipGui.Parent = L.host()
    L.own(tipGui)
    -- BUILT AT ITS RESTING VALUES, then faded out and hidden.
    --
    -- A.fadeSet captures rest ONCE, on first use, and ignores anything already
    -- sitting at full transparency. Building this card invisible and letting the
    -- first show() capture it therefore recorded "gone" as the resting state for
    -- every text layer in it -- the card would open with its stroke and its
    -- background and no words inside. Build it lit, snapshot it, then put it
    -- away.
    -- NO OUTLINE ON THE TOOLTIP. Asked for directly, and it was the right call.
    --
    -- A 1 px dark border is the single worst thing to fade. A filled background
    -- reads as gone by roughly 0.6 transparency; a thin dark line against a
    -- bright game world is still plainly a line at 0.85. So the card dissolves
    -- and leaves its own edge hanging in the air after it -- and that happens
    -- even though the stroke WAS in the fade set, on the same clock, as of P1.
    -- There is no timing fix available: the outline itself is the problem.
    --
    -- The card does not need one. It is a near-black panel drawn over whatever
    -- the game is rendering, and a soft shadow separates it far better than a
    -- border does -- while fading honestly, because an image's alpha is spread
    -- over area instead of concentrated in a hairline.
    --
    -- STRUCTURE, and it matters: a child ALWAYS draws above its parent's own
    -- background, so a shadow parented to the card would sit on top of it as a
    -- dark smear. The outer frame is therefore an empty container, and the
    -- shadow and the card are siblings inside it.
    tipFrame = mk("Frame", {
      BackgroundTransparency = 1, BorderSizePixel = 0,
      Size = UDim2.fromOffset(10, 24),
      Name = "Tip", Parent = tipGui,
    })
    mk("ImageLabel", {
      AnchorPoint = Vector2.new(0.5, 0.5),
      Position = UDim2.new(0.5, 0, 0.5, 4),
      Size = UDim2.new(1, 34, 1, 30),
      BackgroundTransparency = 1,
      Image = A.img.glow, ImageColor3 = Color3.new(0, 0, 0),
      ImageTransparency = 0.34, ZIndex = 1,
      Name = "TipShadow", Parent = tipFrame,
    })
    local card = mk("Frame", {
      Size = UDim2.fromScale(1, 1),
      BackgroundColor3 = T.c.overlay, BackgroundTransparency = 0,
      BorderSizePixel = 0, ZIndex = 2,
      Name = "TipCard", Parent = tipFrame,
    })
    L.corner(T.r.sm, card)
    tipTitle = A.text({
      Text = "", font = T.font.medium, size = T.size.micro, colour = T.c.text,
      align = Enum.TextXAlignment.Left, valign = Enum.TextYAlignment.Top,
      Size = UDim2.new(1, -20, 0, 14), ZIndex = 3,
      Position = UDim2.fromOffset(10, 8), tip = false, Parent = card,
    })
    tipLbl = A.text({
      Text = "", font = T.font.body, size = T.size.micro, colour = T.c.textDim,
      align = Enum.TextXAlignment.Left, valign = Enum.TextYAlignment.Top,
      Size = UDim2.new(1, -20, 0, 14), ZIndex = 3,
      Position = UDim2.fromOffset(10, 8), tip = false, Parent = card,
    })
    A.fadeSet(tipFrame)                -- rest snapshot, while it is still lit
    A.fadeTo(tipFrame, 1, "instant")
    tipFrame.Visible = false
  end

  -- TEXTBOUNDS IS THE WRONG PROPERTY, AND MEASURED IT IS EXACTLY BACKWARDS. On a
  -- label with TextTruncate.AtEnd, TextBounds reports the width of what was
  -- actually DRAWN -- which is by definition never wider than the box -- so
  -- `TextBounds.X > AbsoluteSize.X` cannot be true even once. A row reading
  -- "the game rewrote WalkSpeed 47 times in the l..." measured TextBounds 459
  -- inside a 494 box while its full string needs 697. The untruncated width has
  -- to be asked for separately, and TextService is the only thing that knows it.
  local TextService = game:GetService("TextService")
  local function truncated(l)
    if l.Text == "" or l.AbsoluteSize.X < 8 then return false end
    local ok, sz = pcall(function()
      return TextService:GetTextSize(l.Text, l.TextSize, l.Font,
                                     Vector2.new(9999, 100))
    end)
    return (ok and sz and sz.X > l.AbsoluteSize.X + 0.5) and true or false
  end

  -- A RECTANGLE TEST ALONE ASKS "WHERE IS IT", NEVER "CAN YOU SEE IT".
  --
  -- This is the tooltip explaining something that is not on your screen. Every
  -- registered label was tested by its AbsolutePosition and nothing else, and
  -- AbsolutePosition is perfectly real for a control on a tab you are not
  -- looking at -- pages are hidden by fading their CanvasGroup, NOT by setting
  -- Visible = false, so `l.Visible` is true and `l.TextTransparency` is still 0
  -- on every page at once. Eleven pages of controls were all live hit targets,
  -- stacked on the same coordinates.
  --
  -- Which is exactly what the recording shows: "Heavy rig showed 0 adjusted
  -- studs locally -- trying Teleport (clean)" -- a fling log line off the
  -- Activity page -- floating over the Config page under a pointer that had
  -- never been near it.
  --
  -- Three things make a label unreachable, and the rect test knows none of them:
  --
  --   an ancestor is Visible = false, or its ScreenGui is disabled
  --   an ancestor CanvasGroup is faded out          <- the inactive pages
  --   a clipping ancestor does not contain the point <- scrolled out of view
  --
  -- Walked once per candidate, and only for candidates the rectangle already
  -- accepted, so the cost lands on one or two objects rather than on hundreds.
  local function reachable(o, pt)
    local n = o
    while n and n ~= game do
      if n:IsA("GuiObject") then
        if not n.Visible then return false end
        -- a clipping ancestor is the only thing that can hide a child that is
        -- itself Visible, and a ScrollingFrame always clips
        if n.ClipsDescendants or n:IsA("ScrollingFrame") then
          local p, sz = n.AbsolutePosition, n.AbsoluteSize
          if pt.X < p.X or pt.X > p.X + sz.X
             or pt.Y < p.Y or pt.Y > p.Y + sz.Y then return false end
        end
        if (n:IsA("CanvasGroup") or n:GetAttribute("GiorgioFadeGroup")) and L.uiRead(n,"GroupTransparency") > 0.5 then return false end
      elseif n:IsA("ScreenGui") then
        if not n.Enabled then return false end
        return true
      end
      n = n.Parent
    end
    return true
  end

  local function under(pt)
    -- Rectangle tests first, measurement second. GetTextSize on every registered
    -- label at 10 Hz would be several hundred text measurements a second to
    -- decide one tooltip; only what the pointer is actually over gets measured.
    local hits, hints
    for i = #A.tips, 1, -1 do
      local l = A.tips[i]
      if not l.Parent then
        table.remove(A.tips, i)                 -- prune rebuilt windows
      elseif l.Visible and l.TextTransparency < 0.9 then
        local p, s = l.AbsolutePosition, l.AbsoluteSize
        if pt.X >= p.X and pt.X <= p.X + s.X and pt.Y >= p.Y and pt.Y <= p.Y + s.Y
           and reachable(l, pt) then
          hits = hits or {}
          hits[#hits + 1] = l
        end
      end
    end
    -- explicit explanations, which need no measurement: if the pointer is over
    -- it, it has something to say
    for i = #A.hints, 1, -1 do
      local h = A.hints[i]
      if not (h.obj and h.obj.Parent) then
        table.remove(A.hints, i)
      elseif h.obj.Visible then
        local p, s = h.obj.AbsolutePosition, h.obj.AbsoluteSize
        if s.X > 0 and pt.X >= p.X and pt.X <= p.X + s.X
           and pt.Y >= p.Y and pt.Y <= p.Y + s.Y
           and reachable(h.obj, pt) then
          hints = hints or {}
          hints[#hints + 1] = h
        end
      end
    end
    if hints then
      table.sort(hints, function(a, b) return (a.obj.ZIndex or 0) > (b.obj.ZIndex or 0) end)
      local h = hints[1]
      return { key = h.obj, text = h.text, label = h.label, src = h.obj }
    end

    if not hits then return nil end
    -- topmost first, so a value label wins over the row title stacked behind it
    table.sort(hits, function(a, b) return a.ZIndex > b.ZIndex end)
    for _, l in ipairs(hits) do
      if truncated(l) then return { key = l, text = l.Text, src = l } end
    end
    return nil
  end

  local function hide()
    if not tipFrame or not tipFrame.Visible then return end
    shownFor = nil
    -- the whole card, stroke included -- see A.fadeTo
    A.fadeTo(tipFrame, 1, "fast")
    M.after(0.22, function()
      if tipFrame and not shownFor then tipFrame.Visible = false end
    end)
  end

  local function show(l, pt)
    ensure()
    shownFor = l.key or l
    tipLbl.Text = l.text or ""
    tipTitle.Text = l.label or ""
    tipTitle.Visible = (l.label ~= nil and l.label ~= "")

    -- SCALED BY HAND, NOT BY A UISCALE. Everything here is positioned and
    -- measured in absolute pixels; a UIScale on the host would silently
    -- multiply all of it and put the tooltip in the wrong place at the wrong
    -- size. Scaling the one font instead keeps the arithmetic honest and still
    -- matches the rest of the interface at 1.6x.
    local win = L.Hub and L.Hub.window
    local sc = (win and win.scaleObj and win.scaleObj.Scale) or L.autoScale()
    tipLbl.TextSize = math.max(9, math.floor(T.size.micro * sc + 0.5))

    -- SIZED FROM THE FULL STRING, measured in the TOOLTIP's own font -- not from
    -- the source label's TextBounds, which is the truncated width and would size
    -- the tooltip to exactly the space that was too small in the first place.
    -- (It did: a 697 px string got a 475 px tooltip, clipping the text the
    -- tooltip existed to reveal.)
    local vp = L.viewport()
    local maxW = math.floor(vp.X * 0.6)
    local pad = math.ceil(8 * sc)
    -- MEASURE THE STRING THIS TOOLTIP IS ACTUALLY SHOWING.
    --
    -- `under()` hands back a plain descriptor, `{ key = ..., text = ... }` --
    -- never an Instance. So `l.Text` was always nil, GetTextSize always threw,
    -- and the fallback then read `l.AbsoluteSize.X` off the same plain table:
    --
    --     attempt to index nil with 'X'
    --
    -- Every hint tooltip in the interface hit it, on every hover. The text is
    -- already on `tipLbl`; measure that, and fall back to the frame we have.
    tipTitle.TextSize = tipLbl.TextSize
    local body  = tipLbl.Text
    local head  = tipTitle.Visible and tipTitle.Text or nil
    local padY  = math.ceil(7 * sc)
    local gapY  = math.ceil(2 * sc)

    local function widthOf(str, lbl)
      if not str or str == "" then return 0 end
      local ok, z = pcall(function()
        return TextService:GetTextSize(str, lbl.TextSize, lbl.Font,
                                       Vector2.new(9999, 200))
      end)
      return (ok and z) and z.X or (#str * lbl.TextSize * 0.55)
    end

    -- the card is as wide as its widest line, never wider than the cap
    local w = pad * 2 + math.ceil(math.max(widthOf(body, tipLbl),
                                           widthOf(head, tipTitle)))
    local lineH = math.ceil(tipLbl.TextSize * 1.35)
    local bodyH = lineH

    -- past the cap it wraps instead of clipping, because a tooltip that runs off
    -- the screen has reproduced the original problem in a larger font
    if w > maxW then
      w = maxW
      tipLbl.TextWrapped = true
      local okw, wz = pcall(function()
        return TextService:GetTextSize(body, tipLbl.TextSize, tipLbl.Font,
                                       Vector2.new(maxW - pad * 2, 9999))
      end)
      bodyH = (okw and wz) and math.ceil(wz.Y) or lineH
    else
      tipLbl.TextWrapped = false
    end

    local headH = head and lineH or 0
    local h = padY * 2 + headH + (head and gapY or 0) + bodyH
    tipTitle.Position = UDim2.fromOffset(pad, padY)
    tipTitle.Size     = UDim2.new(1, -pad * 2, 0, headH)
    tipLbl.Position   = UDim2.fromOffset(pad, padY + headH + (head and gapY or 0))
    tipLbl.Size       = UDim2.new(1, -pad * 2, 0, bodyH)
    -- a lone line is the message, so it gets the message colour; under a heading
    -- it is supporting text and steps back
    tipLbl.TextColor3 = head and T.c.textDim or T.c.text
    tipFrame.Size = UDim2.fromOffset(w, h)

    -- Positioned in tipGui's own space. The claim that used to stand here --
    -- that GetMouseLocation is measured below the topbar -- is false; it is the
    -- inset-INCLUDED reading, so adding the inset to it dropped every tooltip
    -- 58 px. L.pointerOffset asks tipGui which space it is in and answers in
    -- that space, so this stays correct if the ScreenGui's flags ever change.
    -- IT BELONGS TO THE CONTROL, NOT TO THE POINTER.
    --
    -- A card pinned 14 px right and 20 px down from the cursor is a cursor
    -- accessory: it slides around under the hand, it covers whatever is to the
    -- lower right, and it never quite points at the thing it is describing. The
    -- reference does the opposite -- the card sits centred just above the
    -- control and stays put while the pointer moves inside it, so it reads as
    -- that control speaking.
    --
    -- The pointer is still the fallback, for anything that reports no rect.
    local anchor = L.pointerOffset(tipGui)
    local gap = math.ceil(8 * sc)
    local x, y, from
    local src = l.src
    if src and src.Parent and src.AbsoluteSize.X > 0 then
      -- AbsolutePosition is inset-EXCLUDED; tipGui ignores the inset, so the
      -- offset between the two spaces has to be put back. L.pointerOffset
      -- already answers in tipGui's space, and L.pointer() in AbsolutePosition
      -- space, so their difference IS that offset -- no second inset call, and
      -- it stays right if the ScreenGui's flags ever change.
      local shift = anchor - L.pointer()
      local p, sz = src.AbsolutePosition + shift, src.AbsoluteSize
      x = p.X + sz.X * 0.5 - w * 0.5
      y = p.Y - h - gap
      from = y + math.ceil(6 * sc)            -- rises into place
      if y < 6 then                            -- no room above: sit below it
        y = p.Y + sz.Y + gap
        from = y - math.ceil(6 * sc)           -- and drops into place
      end
    else
      x = anchor.X + 14
      y = anchor.Y + 20
      if y + h > vp.Y - 6 then y = anchor.Y - h - 10 end
      from = y + 6
    end
    x = math.clamp(x, 6, math.max(vp.X - w - 6, 6))
    y = math.clamp(y, 6, math.max(vp.Y - h - 6, 6))

    -- Snap to the start of the travel, THEN reveal. Setting Position with M.to
    -- from wherever the last tooltip happened to be would fly the card across
    -- the screen between two unrelated controls.
    M.to(tipFrame, "Position", UDim2.fromOffset(x, math.floor(from)), "instant")
    tipFrame.Visible = true
    M.to(tipFrame, "Position", UDim2.fromOffset(x, y), "base")
    A.fadeTo(tipFrame, 0, "fast")
  end

  local acc = 0
  L.hold(L.RunService.Heartbeat:Connect(function(dt)
    if not L.live() then return end
    acc = acc + dt
    if acc < 0.1 then return end                -- 10 Hz is under human notice
    acc = 0
    local win = L.Hub and L.Hub.window
    if (not win) or (win.hidden and #A.hints == 0)
       or (#A.tips == 0 and #A.hints == 0) then
      if hovered then hovered = nil hide() end
      return
    end
    -- INSET-EXCLUDED, because `under` tests against AbsolutePosition. This used
    -- to pass GetMouseLocation straight in, which is the inset-INCLUDED value,
    -- so the tooltip hit test was 58 px below the label it was testing: rows
    -- claimed the pointer while it was still over the row above them.
    local pt = L.pointer()
    local l = under(pt)
    local key = l and l.key or nil
    if key ~= hovered then
      hovered, hoverSince = key, os.clock()
      if shownFor and shownFor ~= key then hide() end
    elseif l and not shownFor and (os.clock() - hoverSince) >= DWELL then
      show(l, pt)
    end
  end))
end

end

do -- ==== lm_19_focus.lua ====
-- LUMEN :: FOCUS
-- Keyboard navigation. Tab walks the page, arrows move and adjust, Enter
-- activates, [ and ] change tab, Escape or a click leaves.
-- CAS never receives Tab, Escape or the brackets (CoreGui claims them first), so
-- UIS drives and CAS is only used to sink keys.

local L = getgenv().LUMEN
local T, M, A = L.T, L.Motion, L.A
local mk = L.mk
local CAS = game:GetService("ContextActionService")

local F = {}
L.Focus = F

F.items = {}
F.current = nil
F.active = false

local ACTION = "LumenFocusNav"
local EDGE_PAD = 14          -- breathing room when scrolling a control into view

-- ---------------------------------------------------------------- registry

-- spec: { activate = fn, adjust = fn(dir), radius = n, label = s }
function F.register(frame, spec)
  spec = spec or {}
  spec.frame = frame
  F.items[#F.items + 1] = spec
  return spec
end

function F.reset()
  F.items, F.current, F.active = {}, nil, false
end

-- ---------------------------------------------------------------- ring

-- Roblox applies only one UIStroke per instance and A.interactive already owns
-- it, so the ring needs its own frame or hovering away erases it.
local function ringOf(spec)
  if spec._ring and spec._ring.Parent then return spec._ring end
  local f = spec.frame
  local ring = mk("Frame", {
    Size = UDim2.fromScale(1, 1),
    BackgroundTransparency = 1,
    ZIndex = (f.ZIndex or 1) + 6,
    Name = "FocusRing", Parent = f,
  })
  L.corner(spec.radius or T.r.md, ring)
  spec._ringStroke = L.stroke(T.c.accent, 1.6, 1, ring)
  spec._ring = ring
  return ring
end

local function paintRing(spec, on)
  if not spec or not spec.frame or not spec.frame.Parent then return end
  ringOf(spec)
  if spec._ringStroke then
    M.to(spec._ringStroke, "Transparency", on and 0.1 or 1, "fast")
  end
end

-- ---------------------------------------------------------------- page scope

local function activeTab()
  local win = L.Hub and L.Hub.window
  if not win or win.hidden then return nil end
  return win.tabs[win.active], win
end

local function inside(node, page)
  while node do
    if node == page then return true end
    node = node.Parent
  end
  return false
end

-- Also prunes: a theme change rebuilds the window, so dead specs must be dropped
-- or the registry grows on every rebuild.
local function visibleItems()
  local tab = activeTab()
  if not tab then return {} end
  local out, keep = {}, {}
  for _, s in ipairs(F.items) do
    if s.frame and s.frame.Parent then
      keep[#keep + 1] = s
      -- a veiled control is still Visible and still on the page; skipping it
      -- here is what stops Tab landing on something whose click is refused
      if s.frame.Visible ~= false and not s.frame:GetAttribute("lmDisabled")
         and inside(s.frame, tab.page) then
        out[#out + 1] = s
      end
    end
  end
  F.items = keep
  return out
end

F.visibleItems = visibleItems

-- ---------------------------------------------------------------- movement

local function scrollIntoView(spec)
  local tab = activeTab()
  local body = tab and tab.body
  if not body or not spec.frame.Parent then return end
  local ctrl = A._scrolls and A._scrolls[body]
  if not ctrl then return end

  -- position within the canvas, not on screen: the canvas is what scrolls
  local rel = (spec.frame.AbsolutePosition.Y - body.AbsolutePosition.Y)
              + body.CanvasPosition.Y
  local h, viewH = spec.frame.AbsoluteSize.Y, body.AbsoluteWindowSize.Y
  local top = body.CanvasPosition.Y
  local want = top
  if rel - EDGE_PAD < top then
    want = rel - EDGE_PAD
  elseif rel + h + EDGE_PAD > top + viewH then
    want = rel + h + EDGE_PAD - viewH
  end
  if math.abs(want - top) > 0.5 then ctrl:to(math.max(want, 0)) end
end

function F.focus(spec)
  if F.current and F.current ~= spec then paintRing(F.current, false) end
  F.current = spec
  if spec then
    paintRing(spec, true)
    scrollIntoView(spec)
  end
end

function F.blur()
  if F.current then paintRing(F.current, false) end
  F.current = nil
end

function F.step(dir)
  local list = visibleItems()
  if #list == 0 then F.blur() return false end
  local i = 0
  for k, s in ipairs(list) do if s == F.current then i = k break end end
  i = i + dir
  if i < 1 then i = #list elseif i > #list then i = 1 end   -- wrap
  F.focus(list[i])
  return true
end

-- ---------------------------------------------------------------- keys

local function driving()
  if not L.live() then return false end
  local win = L.Hub and L.Hub.window
  if not win or win.hidden then return false end
  -- the palette is a modal and owns the keyboard while it is up
  if L.Palette and L.Palette.open then return false end
  -- a focused text box wins: sinking Space and the arrows would break typing
  local box = L.UIS:GetFocusedTextBox()
  if box then return false end
  return true, win
end

local PASS, SINK = Enum.ContextActionResult.Pass, Enum.ContextActionResult.Sink

local function shift()
  return L.UIS:IsKeyDown(Enum.KeyCode.LeftShift)
      or L.UIS:IsKeyDown(Enum.KeyCode.RightShift)
end

-- Probed at priority 3000 (above every CoreScript binding): these are the only
-- keys ContextActionService actually receives.
local USED = {
  [Enum.KeyCode.Up] = true, [Enum.KeyCode.Down] = true,
  [Enum.KeyCode.Left] = true, [Enum.KeyCode.Right] = true,
  [Enum.KeyCode.Return] = true, [Enum.KeyCode.Space] = true,
}

local function suspended()
  local cur = F.current
  return cur and cur.suspend and cur.suspend()
end

CAS:BindActionAtPriority(ACTION, function(_, state, input)
  if state ~= Enum.UserInputState.Begin then return PASS end
  if not F.active or suspended() or not driving() then return PASS end
  if not USED[input.KeyCode] then return PASS end
  -- Left/Right only belong to us when the focused control can use them
  if (input.KeyCode == Enum.KeyCode.Left or input.KeyCode == Enum.KeyCode.Right)
     and not (F.current and F.current.adjust) then
    return PASS
  end
  if (input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.Space)
     and not (F.current and F.current.activate) then
    return PASS
  end
  return SINK
end, false, Enum.ContextActionPriority.High.Value,
  Enum.KeyCode.Up, Enum.KeyCode.Down, Enum.KeyCode.Left,
  Enum.KeyCode.Right, Enum.KeyCode.Return, Enum.KeyCode.Space)

-- ---- the driver ------------------------------------------------------------
-- `gameProcessedEvent` is already true for Tab, so an `if typing then return end`
-- guard would drop every Tab press.
L.hold(L.UIS.InputBegan:Connect(function(input, gameProcessed)
  if gameProcessed then return end
  local ok, win = driving()
  if not ok then return end
  local k = input.KeyCode

  if not F.active then
    -- enters keyboard mode, and only while the pointer is over the window
    if k == Enum.KeyCode.Tab and win:_pointerInside() then
      F.active = true
      F.step(shift() and -1 or 1)
    end
    return
  end

  -- a control can ask for the raw keyboard back (the keybind chip, while recording)
  if suspended() then return end

  if k == Enum.KeyCode.Escape then
    -- Escape never reaches CAS, so it cannot be sunk at any priority and the
    -- Roblox menu opens either way. Handling it at least releases the ring.
    F.blur()
    F.active = false

  elseif k == Enum.KeyCode.Tab then
    F.step(shift() and -1 or 1)

  elseif k == Enum.KeyCode.Down then F.step(1)
  elseif k == Enum.KeyCode.Up   then F.step(-1)

  elseif k == Enum.KeyCode.LeftBracket or k == Enum.KeyCode.RightBracket then
    local n = win.active + (k == Enum.KeyCode.RightBracket and 1 or -1)
    if n < 1 then n = #win.tabs elseif n > #win.tabs then n = 1 end
    win:select(n)
    F.blur()
    task.defer(function() if F.active then F.step(1) end end)

  elseif k == Enum.KeyCode.Left or k == Enum.KeyCode.Right then
    local s = F.current
    if s and s.adjust then
      L.try("focus.adjust", s.adjust, k == Enum.KeyCode.Right and 1 or -1)
    end

  elseif k == Enum.KeyCode.Return or k == Enum.KeyCode.Space then
    local s = F.current
    if s and s.activate then L.try("focus.activate", s.activate) end
  end
end))

-- Unbind on teardown, or a reloaded hub leaves the old handler holding Tab.
-- L.teardown only knows how to call :Disconnect(), hence the fake connection.
L.hold({ Disconnect = function() pcall(function() CAS:UnbindAction(ACTION) end) end })

-- Clicking anywhere means the user went back to pointing, so drop the ring.
L.hold(L.UIS.InputBegan:Connect(function(i, gameProcessed)
  if gameProcessed then return end
  if not L.live() or not F.active then return end
  if i.UserInputType == Enum.UserInputType.MouseButton1
  or i.UserInputType == Enum.UserInputType.Touch then
    F.blur()
    F.active = false
  end
end))

end

do -- ==== lm_05_window.lua ====
-- LUMEN :: WINDOW
-- The panel: header, nav, pages, drag, resize, minimise.
--
-- Two coordinate systems meet here. The window sits under a UIScale, so Position
-- OFFSETS are pre-scale units while the mouse reports real pixels. Anything
-- mixing the two must convert, and the drag does it as a delta from the grab
-- point so the constant offset cancels.

local L = getgenv().LUMEN
local T, M, A = L.T, L.Motion, L.A
local mk = L.mk

local Window = {}
Window.__index = Window
L.Window = Window

-- read per construction so a density change takes effect on rebuild
local HEADER, SIDEBAR, TAB_H

Window.BLUR = 16

-- ---------------------------------------------------------------- mark
function Window.mark(parent, size)
  local h = mk("Frame", {
    Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1,
    Name = "Mark", Parent = parent,
  })
  local outer = mk("Frame", {
    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
    Size = UDim2.fromOffset(size * 0.72, size * 0.72), Rotation = 45,
    BackgroundColor3 = T.c.accent, BorderSizePixel = 0, Parent = h,
  })
  L.corner(size * 0.18, outer)
  A.accentGradient(outer, 135)
  local inner = mk("Frame", {
    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
    Size = UDim2.fromOffset(size * 0.28, size * 0.28), Rotation = 45,
    BackgroundColor3 = T.c.surface, BorderSizePixel = 0, ZIndex = 3, Parent = h,
  })
  L.corner(size * 0.08, inner)
  return h
end

-- ---------------------------------------------------------------- construct

function Window.new(opts)
  opts = opts or {}
  HEADER, SIDEBAR, TAB_H = T.px("header"), T.px("sidebar"), T.px("tab")
  local self = setmetatable({}, Window)
  self.tabs, self.active = {}, nil
  self.width  = opts.width or 680
  self.height = opts.height or 430
  self.minW, self.minH = 660, 430
  self.cascade = (L.Cfg and tonumber(L.Cfg.data.cascade)) or 0.035

  -- geometry is remembered across sessions; a tool that forgets where you put it
  -- makes you re-place it every launch
  local g = L.Cfg and L.Cfg.data.geom
  if type(g) == "table" and tonumber(g.w) and tonumber(g.h) then
    local vp = L.viewport()
    self.width  = math.clamp(tonumber(g.w), self.minW, math.max(vp.X - 40, self.minW))
    self.height = math.clamp(tonumber(g.h), self.minH, math.max(vp.Y - 40, self.minH))
    self._restorePos = (tonumber(g.x) and tonumber(g.y))
      and UDim2.fromOffset(tonumber(g.x), tonumber(g.y)) or nil
  end

  local gui = mk("ScreenGui", {
    Name = opts.guiName or "Lumen", ResetOnSpawn = false,
    ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true,
    DisplayOrder = 10,
  })
  gui.Parent = L.host()
  L.own(gui)
  self.gui = gui
  -- a saved scale wins over the auto-fit; nil means "fit this screen"
  local savedScale = L.Cfg and tonumber(L.Cfg.data.scale)
  self.scaleObj = mk("UIScale", { Scale = savedScale or L.autoScale(), Parent = gui })

  self.scrim = mk("Frame", {
    Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.c.scrim,
    BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 1,
    Name = "Scrim", Parent = gui,
  })

  local shell = mk("Frame", {
    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
    Size = UDim2.fromOffset(self.width, self.height),
    BackgroundTransparency = 1, ZIndex = 2, Name = "Shell", Parent = gui,
  })
  self.shell = shell

  -- MEASURE ALWAYS, INCLUDING ON RESTORE.
  --
  -- Collapse the scale term before anything can drag it: Position starts as
  -- fromScale(0.5,0.5) but _saveGeom records only offsets, so a drag would
  -- persist numbers relative to a term nobody stored. Measured, not derived --
  -- one sample at offset zero pins the constant. Two frames, still hidden.
  --
  -- The restore path used to skip all of this and assign the saved offset
  -- straight in. It is a RAW OFFSET IN LOCAL UNITS, recorded under whatever
  -- UIScale and viewport that session happened to have, so on any other screen
  -- it lands somewhere else entirely. Measured on 2560x1369 at scale 1.6: a
  -- saved offset of (134, 5), centre-anchored, put AbsolutePosition at
  -- (-314, -510) -- three quarters of the window above and left of the screen,
  -- with the title bar off the top, so it could not even be dragged back.
  --
  -- Width and height were already clamped to the viewport above. Position was
  -- the one piece of remembered geometry still trusting the old session.
  task.spawn(function()
    L.RunService.Heartbeat:Wait()
    if not shell.Parent then return end
    shell.Position = UDim2.fromOffset(0, 0)
    L.RunService.Heartbeat:Wait()
    if not shell.Parent then return end
    local k = shell.AbsolutePosition
    local sc = (self.scaleObj and self.scaleObj.Scale) or 1
    local vp = L.viewport()
    local sz = shell.AbsoluteSize

    local want
    if self._restorePos then
      -- where that saved offset actually lands on THIS screen
      want = Vector2.new(self._restorePos.X.Offset * sc + k.X,
                         self._restorePos.Y.Offset * sc + k.Y)
    else
      -- centre it PROPERLY. fromScale(0.5,0.5) was landing 59 px high, because
      -- AbsolutePosition and ScreenGui space disagree about the topbar inset --
      -- so the window used to open slightly above the middle of the screen.
      want = Vector2.new(vp.X / 2 - sz.X / 2, vp.Y / 2 - sz.Y / 2)
    end

    -- Keep it reachable. A window larger than the screen is pinned to the
    -- top-left corner rather than centred, because the title bar has to stay
    -- on screen -- it is the only handle for moving it.
    local M_ = 8
    local function fit(v, size, limit)
      if size >= limit then return math.clamp(v, limit - size, 0) end
      return math.clamp(v, M_, limit - size - M_)
    end
    want = Vector2.new(fit(want.X, sz.X, vp.X), fit(want.Y, sz.Y, vp.Y))
    shell.Position = UDim2.fromOffset((want.X - k.X) / sc, (want.Y - k.Y) / sc)
  end)

  -- real drop shadow, in the SHELL so it sits outside the panel bounds
  -- HELD, NOT FIRE-AND-FORGET. This was created and never referenced again, so
  -- hide() faded the panel while the shadow stayed at full opacity until
  -- shell.Visible flipped 0.34 s later -- a black rounded rectangle hanging in
  -- the air after the window had gone.
  self.shadowSpread = 34
  self.shadow = A.shadow(nil, {
    Parent = shell, spread = self.shadowSpread, alpha = 0.34, lift = 10, ZIndex = 3 })
  self.shadowRest = (L.Cfg and tonumber(L.Cfg.data.shadow)) or 0.34

  local root = mk("CanvasGroup", {
    Name = "Window", AnchorPoint = Vector2.new(0.5, 0.5),
    Position = UDim2.fromScale(0.5, 0.5),
    Size = UDim2.fromOffset(self.width, self.height),
    BackgroundTransparency = 1, BorderSizePixel = 0,
    GroupTransparency = 1, ZIndex = 5, Parent = shell,
  })
  L.corner(T.r.lg, root)
  L.stroke(T.c.lineStrong, 1, 0.3, root)
  self.root = root

  local bg = mk("Frame", {
    Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.c.surface,
    BorderSizePixel = 0, ZIndex = 0, Name = "Body", Parent = root,
  })
  L.corner(T.r.lg, bg)
  self.body = bg

  -- accent light bleeding from the top edge
  local wash = mk("Frame", {
    Size = UDim2.new(1, 0, 0, 260), BackgroundColor3 = T.c.accent,
    BorderSizePixel = 0, ZIndex = 0, Name = "Wash", Parent = root,
  })
  self.wash = wash
  mk("UIGradient", {
    Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.925),
      NumberSequenceKeypoint.new(1, 1),
    }), Rotation = 90, Parent = wash,
  })

  -- ANIMATED BACKDROP. A blurred bloom has no high-frequency detail, so it is
  -- rendered at 320x200 and stretched across the whole panel with no visible
  -- loss -- the entire 48-frame loop is under half a megabyte. Sits at a resting
  -- transparency rather than opaque, so it lights the surface instead of
  -- becoming it.
  self.bgVid = L.Video and L.Video.new(bg, {
    folder = "lumen_fx/bg", prefix = "bg", count = 48, fps = 16, loop = true,
    Size = UDim2.fromScale(1, 1), Position = UDim2.fromScale(0.5, 0.5),
    -- 0.30 put the loop at 70% opacity and turned the whole panel blue-purple,
    -- which contradicts the entire near-black premise. At 0.86 it reads as light
    -- moving under the surface and you only notice it when it moves.
    ZIndex = 0, rest = 0.86,
  })
  if not (L.Cfg and L.Cfg.data.grain == false) then A.grain(bg, 0.955) end
  -- (the snap hint used to live here: a full-panel accent wash flashed on every
  -- edge snap. It went with the snapping itself -- see Window:_drag.)

  -- Native rounded pinstripe edges carry the window boundary.

  -- ---- header ---------------------------------------------------------
  local header = mk("Frame", {
    Size = UDim2.new(1, 0, 0, HEADER), BackgroundTransparency = 1,
    Name = "Header", Parent = root,
  })
  self.header = header

  -- The orb from the loading screen, small and strided. Same footage, so the
  -- window and the loader are unmistakably the same product.
  local orbHolder = mk("Frame", {
    Position = UDim2.fromOffset(20, HEADER / 2 - 21),
    Size = UDim2.fromOffset(42, 42), BackgroundTransparency = 1,
    Name = "OrbMark", Parent = header,
  })
  -- FULL SEQUENCE, NO STRIDE. `stride` divides the playback rate to preserve the
  -- loop duration, so stride 6 was running this at 5 fps while the loading screen
  local orbVid = L.Video and L.Video.new(orbHolder, {
    -- 5..96 is this sequence's loop -- 92 frames, the half-rate copy of the
    -- full Saturn's 183. The remaining frames of the folder do not close.
    folder = "lumen_fx/saturn_s", prefix = "sms", first = 5, count = 92, fps = 15, size = 42,
    Position = UDim2.fromScale(0.5, 0.5), ZIndex = 2, loop = true,
  })
  A.glow(orbHolder, 104, T.c.accent, { alpha = 0.80, ZIndex = 1 })
  if not orbVid then Window.mark(orbHolder, 42) end
  self.orbVid = orbVid

  -- LIQUID CHROME WORDMARK DISABLED. The hub name is set in code via the
  -- LUMEN_HUB_NAME variable at the top of this file; the text label always shows.
  local wm = nil
  self.wordVid = nil
  self._name = opts.title or getgenv().LUMEN_HUB_NAME or ""
  self._defaultName = self._name
  local function displayName()
    return self._name ~= "" and self._name or "Untitled"
  end
  self._displayName = displayName
  self.titleLbl = A.text({
    Text = L.track(displayName(), 1),
    font = T.font.display, size = T.size.title,
    colour = self._name ~= "" and T.c.text or T.c.textOff,
    Position = UDim2.fromOffset(78, 22),
    Size = UDim2.fromOffset(320, 20), Parent = header,
    Name = "Title",
  })
  self.titleLbl.Visible = true
  self.searchHint = A.text({
    Text = "CTRL K", font = T.font.mono, size = T.size.tiny, colour = T.c.textOff,
    align = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0.5),
    Position = UDim2.new(1, -190, 0.5, 0), Size = UDim2.fromOffset(60, 14),
    Parent = header,
  })
  self.subtitleLbl = A.text({
    Text = opts.subtitle or "", font = T.font.mono, size = T.size.tiny,
    colour = T.c.textOff, Position = UDim2.fromOffset(78, 44),
    Size = UDim2.fromOffset(360, 12), Parent = header,
  })

  local function chromeBtn(x, draw, onClick)
    local b = mk("Frame", {
      AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, x, 0.5, 0),
      Size = UDim2.fromOffset(30, 30), BackgroundColor3 = T.c.hover,
      BackgroundTransparency = 1, BorderSizePixel = 0, Parent = header,
    })
    L.corner(T.r.sm + 2, b)
    local g = draw(b, 16, T.c.textMute)
    g.AnchorPoint = Vector2.new(0.5, 0.5)
    g.Position = UDim2.fromScale(0.5, 0.5)
    A.interactive(b, { radius = T.r.sm + 2, onClick = onClick,
                       hoverAlpha = 0.9, pressAlpha = 0.82 })
  end
  chromeBtn(-16, A.Icon.close, function() self:hide() end)
  chromeBtn(-50, A.Icon.minus, function() self:minimise() end)

  local pill = mk("Frame", {
    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -88, 0.5, 0),
    Size = UDim2.fromOffset(88, 28), BackgroundColor3 = T.c.raised,
    BorderSizePixel = 0, Parent = header,
  })
  L.corner(999, pill)
  L.stroke(T.c.line, 1, 0.3, pill)
  local pdot = mk("Frame", {
    AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 11, 0.5, 0),
    Size = UDim2.fromOffset(6, 6), BackgroundColor3 = T.c.ok,
    BorderSizePixel = 0, Parent = pill,
  })
  L.corner(999, pdot)
  self.pingLbl = A.text({
    Text = "-- ms", font = T.font.mono, size = T.size.tiny, colour = T.c.textDim,
    Position = UDim2.fromOffset(23, 0), Size = UDim2.new(1, -28, 1, 0), Parent = pill,
  })
  self.statusDot = pdot

  -- ---- health chip ------------------------------------------------------
  --
  -- HIDDEN WHILE THERE IS NOTHING TO SAY. A permanent "all good" badge is
  -- decoration: it trains you to stop reading it, so on the day it finally does
  -- say something you stopped looking weeks ago. This exists only when a claim
  -- the interface already made has since failed -- which is the only moment an
  -- indicator earns the space it takes.
  local health = mk("Frame", {
    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -258, 0.5, 0),
    Size = UDim2.fromOffset(118, 26), BackgroundColor3 = T.c.raised,
    BackgroundTransparency = 1, BorderSizePixel = 0,
    Visible = false, Name = "Health", Parent = header,
  })
  L.corner(999, health)
  local healthStroke = L.stroke(T.c.warn, 1, 1, health)
  local hdot = mk("Frame", {
    AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 11, 0.5, 0),
    Size = UDim2.fromOffset(6, 6), BackgroundColor3 = T.c.warn,
    BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 2, Parent = health,
  })
  L.corner(999, hdot)
  local hlbl = A.text({
    Text = "", font = T.font.mono, size = T.size.tiny, colour = T.c.warn,
    Position = UDim2.fromOffset(23, 0), Size = UDim2.new(1, -30, 1, 0),
    ZIndex = 2, Parent = health,
  })
  hlbl.TextTransparency = 1
  A.interactive(health, { radius = 999, onClick = function()
    if self.onHealth then L.try("window.onHealth", self.onHealth) end
  end })
  self.healthChip = health

  -- SAMPLED, NOT PUSHED. There is no event that means "a feature stopped
  -- working" -- that is precisely why it goes unnoticed -- so health is derived
  -- and polled, at a rate no one can distinguish from instant.
  local shownState
  task.spawn(function()
    while L.live() and health.Parent do
      local state, nf, nc = L.health()
      if state ~= shownState then
        shownState = state
        if state == "ok" then
          M.to(health, "BackgroundTransparency", 1, "fast")
          M.to(hlbl, "TextTransparency", 1, "fast")
          M.to(healthStroke, "Transparency", 1, "fast")
          M.to(hdot, "BackgroundTransparency", 1, "fast")
          -- hidden only after it has faded, so the chip stops eating clicks in
          -- the middle of the header -- which is also the window's drag handle
          M.after(0.3, function()
            if health.Parent and shownState == "ok" then health.Visible = false end
          end)
        else
          local col = (state == "fault") and T.c.bad or T.c.warn
          hdot.BackgroundColor3, hlbl.TextColor3, healthStroke.Color = col, col, col
          health.Visible = true
          M.to(health, "BackgroundTransparency", 0.06, "fast")
          M.to(hlbl, "TextTransparency", 0, "fast")
          M.to(healthStroke, "Transparency", 0.4, "fast")
          M.to(hdot, "BackgroundTransparency", 0, "fast")
        end
      end
      -- WORST FIRST, BUT NEVER AT THE COST OF HIDING THE REST. Showing only the
      -- fault count while two features were also contested meant fixing the
      -- fault made the chip vanish and took the contested features with it --
      -- the indicator would have gone quiet with the hub still lying.
      if state == "fault" then
        hlbl.Text = nc > 0
          and string.format("%d fault  +%d", nf, nc)
          or string.format("%d fault%s", nf, nf == 1 and "" or "s")
      elseif state ~= "ok" then
        hlbl.Text = string.format("%d contested", nc)
      end
      task.wait(0.4)
    end
  end)

  mk("Frame", {
    Position = UDim2.fromOffset(0, HEADER), Size = UDim2.new(1, 0, 0, 1),
    BackgroundColor3 = T.c.line, BackgroundTransparency = 0.35,
    BorderSizePixel = 0, Parent = root,
  })

  -- ---- sidebar --------------------------------------------------------
  -- THE SIDEBAR IS A TINT, NOT A SLAB. Painting it an opaque darker colour cut
  -- it out of the panel entirely: the bloom loop, the grain and the top accent
  -- wash all stopped at its edge, so it read as a black rectangle glued to a lit
  -- one. Semi-transparent black over the same body lets every one of those pass
  -- underneath, and it is still visibly recessed.
  local side = mk("Frame", {
    Position = UDim2.fromOffset(0, HEADER + 1),
    Size = UDim2.new(0, SIDEBAR, 1, -(HEADER + 1)),
    BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.42,
    BorderSizePixel = 0,
    Name = "Sidebar", Parent = root,
  })
  local seam = mk("Frame", {
    Position = UDim2.new(1, -1, 0, 0), Size = UDim2.new(0, 1, 1, 0),
    BackgroundColor3 = T.c.accent, BorderSizePixel = 0, Parent = side,
  })
  mk("UIGradient", {
    Transparency = NumberSequence.new({
      NumberSequenceKeypoint.new(0, 0.55),
      NumberSequenceKeypoint.new(0.55, 0.90),
      NumberSequenceKeypoint.new(1, 1),
    }),
    Rotation = 90, Parent = seam,
  })

  -- Scrolls once the tabs outgrow the sidebar. Ten tabs do not fit a shortened
  -- window, and a tab you cannot reach is a feature you do not have.
  self.navHolder = mk("ScrollingFrame", {
    Position = UDim2.fromOffset(12, 14), Size = UDim2.new(1, -24, 1, -84),
    BackgroundTransparency = 1, BorderSizePixel = 0,
    CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
    ScrollBarThickness = 2, ScrollBarImageColor3 = T.c.lineStrong,
    ScrollBarImageTransparency = 0.4, ScrollingDirection = Enum.ScrollingDirection.Y,
    ElasticBehavior = Enum.ElasticBehavior.Never,
    Name = "Nav", Parent = side,
  })

  -- indicator sits BEHIND the rows, in the same coordinate space
  self.pill = mk("Frame", {
    Size = UDim2.new(1, 0, 0, TAB_H), Position = UDim2.fromOffset(0, 0),
    BackgroundColor3 = T.c.accent, BackgroundTransparency = 0.82,
    BorderSizePixel = 0, Visible = false, Name = "Indicator",
    Parent = self.navHolder,
  })
  L.corner(T.r.md, self.pill)
  mk("UIGradient", {
    Transparency = NumberSequence.new({
      NumberSequenceKeypoint.new(0, 0),
      NumberSequenceKeypoint.new(1, 1),
    }), Parent = self.pill,
  })

  self.pillBar = mk("Frame", {
    Size = UDim2.fromOffset(3, TAB_H * 0.45),
    Position = UDim2.fromOffset(-12, TAB_H * 0.275),
    BackgroundColor3 = T.c.accent, BorderSizePixel = 0, Visible = false,
    Name = "IndicatorEdge", Parent = self.navHolder,
  })
  L.corner(999, self.pillBar)
  A.accentGradient(self.pillBar, 90)

  -- AutomaticSize, not fromScale(1,1): inside a scrolling frame a full-height
  -- child pins the canvas to the viewport and nothing ever scrolls.
  self.navList = mk("Frame", {
    Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
    BackgroundTransparency = 1, Name = "NavItems", Parent = self.navHolder,
  })
  L.list(2, nil, self.navList)
  self._navOrder, self._navY, self._sections = 0, {}, {}
  self._navCursor = 0

  -- sidebar footer
  local foot = mk("Frame", {
    AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 12, 1, -14),
    Size = UDim2.new(1, -24, 0, 42), BackgroundTransparency = 1,
    Name = "Footer", Parent = side,
  })
  mk("Frame", {
    Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = T.c.line,
    BackgroundTransparency = 0.4, BorderSizePixel = 0, Parent = foot,
  })
  -- THE PLAYER'S ACTUAL HEADSHOT. This was a gradient placeholder I never went
  -- back and filled. `rbxthumb://` resolves a user thumbnail without a web
  -- request or a yield -- GetUserThumbnailAsync would block the build for a
  -- round trip, and this is the same image.
  local av = mk("ImageLabel", {
    Position = UDim2.fromOffset(0, 13), Size = UDim2.fromOffset(28, 28),
    BackgroundColor3 = T.c.raised, BorderSizePixel = 0,
    Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=48&h=48", L.LP.UserId),
    Parent = foot,
  })
  L.corner(T.r.sm + 1, av)
  L.stroke(T.c.lineStrong, 1, 0.45, av)
  self.avatar = av
  A.text({
    Text = L.LP.Name, font = T.font.medium, size = T.size.micro,
    colour = T.c.textDim, Position = UDim2.fromOffset(36, 13),
    Size = UDim2.new(1, -38, 0, 13), truncate = true, Parent = foot,
  })
  self.footState = A.text({
    Text = "connected", font = T.font.mono, size = T.size.tiny,
    colour = T.c.textOff, Position = UDim2.fromOffset(36, 27),
    Size = UDim2.new(1, -38, 0, 12), Parent = foot,
  })

  task.spawn(function()
    local Stats = game:GetService("Stats")
    while L.live() and foot.Parent do
      local ok, v = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
      end)
      local ms = (ok and type(v) == "number") and math.floor(v) or -1
      self.pingLbl.Text = (ms >= 0) and (ms .. " ms") or "offline"
      M.to(pdot, "BackgroundColor3",
        (ms < 0 and T.c.textOff) or (ms < 120 and T.c.ok)
        or (ms < 260 and T.c.warn) or T.c.bad, "base")
      task.wait(2)
    end
  end)

  -- ---- content --------------------------------------------------------
  self.content = mk("Frame", {
    Position = UDim2.fromOffset(SIDEBAR + 1, HEADER + 1),
    Size = UDim2.new(1, -(SIDEBAR + 1), 1, -(HEADER + 1)),
    BackgroundTransparency = 1, ClipsDescendants = true,
    Name = "Content", Parent = root,
  })

  -- THE SATURN, AS A BACKGROUND OBJECT. It appeared here once by accident when
  -- two sequences collided on the same basename, stretched edge to edge. It read
  -- well, so it is back on purpose: sized to the panel rather than filling it,
  -- anchored right and allowed to bleed off the edge so it behaves like a hero
  -- object the content sits over, and held well back in opacity so it never
  -- competes with a value the user is trying to read.
  self.heroVid = L.Video and (not (L.Cfg and L.Cfg.data.heroArt == false)) and L.Video.new(self.content, {
    folder = "lumen_fx/saturn", prefix = "sat", first = 68, count = 183, fps = 30,
    size = math.floor(self.height * 0.46),
    -- pulled inside the edge and dropped low, so the ring reads as an object
    -- the content sits over rather than a crop artefact, and it clears the cards
    Position = UDim2.new(1, -58, 1, -48),
    ZIndex = 0, rest = 0.84, loop = true,
  })

  -- ---- the background behind the pages ----------------------------------
  --
  -- THIS IS WHERE THE BACKGROUND STYLES BELONG, and I built them for the
  -- loading screen first, which was a misread: a loading screen is on for four
  -- seconds and this is what you look at for the rest of the session.
  --
  -- The lattice used to carry a note saying it was static ON PURPOSE, because
  -- "a wave running behind live controls is noise rather than atmosphere". That
  -- judgement still holds and it is why Nebula -- static -- stays the default.
  -- It is an argument for a good default, though, not for having no choice.
  --
  -- Sized to the VIEWPORT rather than the window: the panel can be resized, and
  -- a lattice built to the old size would run out of dots the moment it grew.
  -- Content clips, so the overspill costs nothing.
  do
    local vp = L.viewport()
    local gw, gh = 0, 0 -- supplied pinstripe footage replaces the lattice
    local sp = 30
    local host = mk("Frame", {
      Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 0,
      Name = "Lattice", Parent = self.content,
    })
    self.bgDots, self.bgBase = {}, 0.93
    local cols = math.floor(gw / sp)
    local rows = math.floor(gh / sp)
    for x = 0, cols do
      for y = 0, rows do
        local d = mk("Frame", {
          Position = UDim2.fromOffset(x * sp + 14, y * sp + 12),
          Size = UDim2.fromOffset(2, 2),
          BackgroundColor3 = Color3.fromRGB(150, 170, 210),
          BackgroundTransparency = 0.93,
          BorderSizePixel = 0, ZIndex = 0, Parent = host,
        })
        self.bgDots[#self.bgDots + 1] =
          { obj = d, u = x / math.max(cols, 1), v = y / math.max(rows, 1) }
      end
    end

    -- The iridescent field, off unless the style asks for it. Five very large,
    -- very soft, very transparent colour discs drifting through one another --
    -- overlap does the blending, and because each is bigger than the panel you
    -- never see an edge, only the colour changing where two of them cross.
    -- Behind the lattice and well under the content in opacity.
    self.bgFields = {}
    if A.img and A.img.glow then
      local fieldHost = mk("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 0,
        Visible = false, Name = "Fields", Parent = self.content,
      })
      self.bgFieldHost = fieldHost
      local SPEC = {
        { c = Color3.fromRGB( 92, 128, 255), sx = 0.30, sy = 0.20, rx = 0.017, ry = 0.011, sz = 1.10 },
        { c = Color3.fromRGB(186, 108, 255), sx = 0.26, sy = 0.27, rx = 0.012, ry = 0.021, sz = 0.88 },
        { c = Color3.fromRGB( 88, 220, 220), sx = 0.29, sy = 0.22, rx = 0.022, ry = 0.009, sz = 0.96 },
        { c = Color3.fromRGB(255, 150, 120), sx = 0.20, sy = 0.24, rx = 0.010, ry = 0.016, sz = 0.74 },
        { c = Color3.fromRGB(120, 160, 255), sx = 0.33, sy = 0.17, rx = 0.007, ry = 0.019, sz = 1.24 },
      }
      for i, f in ipairs(SPEC) do
        local d = math.floor(self.width * f.sz)
        self.bgFields[i] = { spec = f, phase = i * 1.7, obj = mk("ImageLabel", {
          AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
          Size = UDim2.fromOffset(d, d), BackgroundTransparency = 1,
          Image = A.img.glow, ImageColor3 = f.c, ImageTransparency = 0.88,
          ZIndex = 0, Name = "Field" .. i, Parent = fieldHost,
        }) }
      end
    end
  end

  -- ---- background style --------------------------------------------------
  --
  -- One setting drives this and the loading screen, so the product has a look
  -- rather than two unrelated ones.
  function self:applyBackground(name)
    name = name or (L.Backdrop and L.Backdrop.styleName()) or "Nebula"
    self.bgStyle = name
    local aurora    = (name == "Aurora")
    local particles = (name == "Particles")
    local plain     = (name == "Plain")

    if self.bgFieldHost then self.bgFieldHost.Visible = aurora end
    -- the hero object is scenery: it belongs to the styles that want scenery
    if self.heroVid and self.heroVid.frameObj then
      self.heroVid.frameObj.Visible = not (plain or aurora)
    end
    -- Aurora lifts the lattice a little so the colour does not read as flat
    -- wallpaper; Plain drops it entirely
    self.bgBase = aurora and 0.955 or 0.93
    for _, d in ipairs(self.bgDots or {}) do
      d.obj.Visible = not plain
      d.obj.BackgroundTransparency = self.bgBase
      if not particles then d.obj.Size = UDim2.fromOffset(2, 2) end
    end
    self:_bgCull()
    return self
  end

  -- THE LATTICE IS BUILT TO THE VIEWPORT AND THE PANEL IS SMALLER THAN THAT.
  --
  -- Deliberately so -- the window resizes, and a lattice built to the old size
  -- would run out of dots the moment it grew. But the wave was walking all of
  -- them, and measured on a 958 x 931 panel only 992 of 3956 were inside it:
  -- three quarters of the work went to dots the content frame clips away. It
  -- showed up exactly where you would expect, in the tail rather than the
  -- median:
  --
  --   Nebula      median 6.11 ms   p95  8.68 ms
  --   Particles   median 6.20 ms   p95 17.44 ms   <- a dropped frame
  --   Aurora      median 6.07 ms   p95  8.16 ms
  --
  -- So the animated subset is resolved once per size change instead of per
  -- frame. Rebuilt on resize because the panel is resizable and a stale list
  -- would leave a rectangle of dead dots after it grew.
  function self:_bgCull()
    local c = self.content
    if not (c and self.bgDots) then return end
    local w, h = c.AbsoluteSize.X, c.AbsoluteSize.Y
    self._bgCullSize = Vector2.new(w, h)
    local live = {}
    for i = 1, #self.bgDots do
      local d = self.bgDots[i]
      local p = d.obj.Position
      if p.X.Offset <= w + 24 and p.Y.Offset <= h + 24 then live[#live + 1] = d end
    end
    self.bgActive = live
  end

  -- One clock for every animated nav icon. Advancing only the active and hovered
  -- ones keeps four of the five sequences completely still at rest.
  self._iconT = 0
  L.hold(L.RunService.RenderStepped:Connect(function(dt)
    if not L.live() or self.hidden then return end
    self._iconT = self._iconT + dt

    -- BACKGROUND. Only whichever style is live does any work, and the whole
    -- thing is skipped while the window is hidden by the guard above.
    if self.bgStyle == "Aurora" and self.bgFields then
      local t = self._iconT
      for i = 1, #self.bgFields do
        local fd = self.bgFields[i]
        local sp = fd.spec
        fd.obj.Position = UDim2.fromScale(
          0.5 + math.sin(t * sp.rx * 6.283 + fd.phase) * sp.sx,
          0.5 + math.cos(t * sp.ry * 6.283 + fd.phase * 1.31) * sp.sy)
        fd.obj.ImageTransparency = 0.88 + math.sin(t * 0.11 + fd.phase) * 0.05
      end
    elseif self.bgStyle == "Particles" and self.bgActive then
      -- 30 Hz: this touches every dot, and at 60 it is the single most
      -- expensive thing on an otherwise idle window for no visible gain
      self._bgAcc = (self._bgAcc or 0) + dt
      if self._bgAcc >= 1 / 30 then
        self._bgAcc = 0
        -- a resize invalidates the culled list, and the panel is resizable
        local cs = self.content and self.content.AbsoluteSize
        if cs and self._bgCullSize and (cs - self._bgCullSize).Magnitude > 8 then
          self:_bgCull()
        end
        local t, base = self._iconT, self.bgBase
        local live = self.bgActive
        for i = 1, #live do
          local d = live[i]
          local w = math.sin((d.u * 3.1 + d.v * 1.7) * 3.14159 - t * 0.85)
                  + math.sin((d.u * 1.3 - d.v * 2.9) * 3.14159 - t * 0.55)
          local k = math.clamp((w + 2) / 4, 0, 1)
          k = k * k * k                       -- most of the field stays quiet
          d.obj.BackgroundTransparency = base - (base - 0.62) * k
          local sz = 2 + math.floor(k * 2.4)
          if d.sz ~= sz then
            d.sz = sz
            d.obj.Size = UDim2.fromOffset(sz, sz)
          end
        end
      end
    end

    local f = math.floor(self._iconT * 12) + 1
    -- the chrome page title rides the same clock, at its own rate
    local tf = math.floor(self._iconT * 20) + 1
    local act = self.tabs[self.active]
    -- THE SWEEP RIDES THE WINDOW CLOCK, and only for the page you are looking
    -- at. Left to itself every page would animate its own gradient forever,
    -- including the ten nobody has open -- which is exactly the problem the old
    -- sequence solved with manual playback, kept here for the same reason.
    if act and act.titleGrad then
      -- SECONDS, NOT THE FRAME INDEX. This first shipped reading `tf`, which is
      -- the 20 fps counter the old image sequence stepped through -- so the
      -- sweep advanced twenty times a second instead of once, and math.floor
      -- quantised it into 20 visible steps on top. At speed 0.16 that is 1.6
      -- full passes per second and at Movement's 0.30 it is three: a strobe,
      -- not a shimmer. Caught on video.
      --
      -- Driven from the raw clock it is one pass every 2/speed seconds --
      -- 12.5 s at the default, which is slow enough to read as light moving
      -- across metal rather than as the title flashing.
      local sp = act.titleGrad:GetAttribute("Speed") or 0.16
      -- one full pass every 2/speed seconds, unchanged from the offset version
      -- so the measured 12.5 s at the default still holds -- but the pattern
      -- wraps, so there is no dead half of the cycle to sit through.
      local phase = (self._iconT * sp * 0.5) % 1
      -- Rebuilding 20 keypoints on every frame is needless allocation for a
      -- highlight that takes twelve seconds to cross a word. 24 Hz is far under
      -- the threshold where that reads as stepped. NOTE this throttles how often
      -- the colours are rebuilt, NOT the phase -- quantising the phase is what
      -- turned this into a strobe last time, and it is a different quantity.
      self._titleAcc = (self._titleAcc or 1) + dt
      if self._titleAcc >= 1 / 24 then
        self._titleAcc = 0
        act.titleGrad.Color = A.chromeSeq(act.titlePattern
                                          or A.chromePattern(A.CHROME.__default), phase)
      end
    end
    for i, t in ipairs(self.tabs) do
      if t.iconVid then
        local live = (i == self.active) or (i == self._hover)
        if live then
          t.iconVid:setFrame(f)
          t.iconVid.rest = (i == self.active) and 0 or 0.1
        else
          t.iconVid.rest = 0.5
        end
      end
    end
  end))

  -- while the pointer is over the hub, the wheel belongs to the hub
  A.addWheelGuard(function()
    return (not self.hidden) and self.root.Visible and self:_pointerInside()
  end)

  -- POPOVER LAYER. A dropdown cannot render inside the page: the content frame
  -- clips, and the page scrolls, so an expanding list is both cut off and
  -- dragged around by the scroll under it. This sits on the window root, above
  -- everything, clipped by nothing.
  self.overlay = mk("Frame", {
    Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
    ZIndex = 30, Name = "Overlay", Parent = root,
  })

  self:_resize()
  self:_drag()
  self:_hotkeys(opts.toggleKey)

  -- ---- minimised dock -------------------------------------------------
  local dock = mk("Frame", {
    AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, -60),
    Size = UDim2.fromOffset(142, 36), BackgroundColor3 = T.c.overlay,
    BorderSizePixel = 0, Name = "Dock", Parent = gui,
  })
  L.corner(999, dock)
  local dockStroke = L.stroke(T.c.lineStrong, 1, 0.3, dock)

  -- A HALO THAT BREATHES, so the pill reads as the one live thing on screen
  -- while everything else is gone. It sits behind the pill and outside it, which
  -- is the only way to glow without washing out the mark sitting on top.
  local dockGlow = A.img and A.img.glow and mk("ImageLabel", {
    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
    Size = UDim2.new(1, 74, 1, 58), BackgroundTransparency = 1,
    Image = A.img.glow, ImageColor3 = T.c.accent, ImageTransparency = 0.82,
    ZIndex = 0, Name = "DockGlow", Parent = dock,
  })

  -- a small halo of its own, drifting around the mark. The pill's glow says
  -- "this is here"; this one says the mark is alive while nothing else is.
  local orbGlow = A.img and A.img.glow and mk("ImageLabel", {
    AnchorPoint = Vector2.new(0.5, 0.5),
    Position = UDim2.fromOffset(22, 18), Size = UDim2.fromOffset(46, 46),
    BackgroundTransparency = 1, Image = A.img.glow,
    ImageColor3 = T.c.accent, ImageTransparency = 0.72,
    ZIndex = 1, Name = "OrbGlow", Parent = dock,
  })

  -- the Saturn, not the drawn diamond: the same mark the loader and the header
  -- already use, so the minimised state is recognisably the same product
  local dockOrb = L.Video and L.Video.new(dock, {
    folder = "lumen_fx/saturn_s", prefix = "sms", first = 5, count = 92,
    fps = 15, size = 24, loop = true,
    Position = UDim2.fromOffset(22, 18), ZIndex = 2,
  })
  if not dockOrb then Window.mark(dock, 20).Position = UDim2.fromOffset(10, 8) end

  local dockLbl = A.text({
    Text = self._name ~= "" and self._name or "Untitled", font = T.font.strong, size = T.size.label,
    colour = T.c.textDim, Position = UDim2.fromOffset(38, 0),
    Size = UDim2.new(1, -48, 1, 0), Parent = dock,
  })
  self.dockLbl = dockLbl

  A.interactive(dock, {
    radius = 999, onClick = function() self:restore() end,
    onState = function(st)
      -- the whole pill answers the cursor: the halo swells, the edge lights up
      -- and the wordmark brightens, all on one token so it reads as one object
      M.to(dockStroke, "Color", st.hovered and T.c.accent or T.c.lineStrong, "fast")
      M.to(dockStroke, "Transparency", st.hovered and 0.05 or 0.3, "fast")
      M.to(dockLbl, "TextColor3", st.hovered and T.c.text or T.c.textDim, "fast")
      if dockGlow then
        M.to(dockGlow, "Size",
          st.hovered and UDim2.new(1, 104, 1, 80) or UDim2.new(1, 74, 1, 58), "base")
      end
      self._dockHover = st.hovered
    end,
  })

  -- One loop for the halo. A spring cannot express a cycle -- it settles by
  -- definition -- so the breathing is a cosine, and hovering only shifts the
  -- band it breathes within rather than interrupting it.
  if dockGlow then
    self._dockT = 0
    L.hold(L.RunService.RenderStepped:Connect(function(dt)
      if not L.live() or not dock.Parent then return end
      if dock.Position.Y.Offset < -20 then return end     -- parked offscreen
      self._dockT = self._dockT + dt
      local puls = 0.5 + 0.5 * math.cos(self._dockT * 2.1)
      local lo = self._dockHover and 0.52 or 0.74
      local hi = self._dockHover and 0.72 or 0.90
      dockGlow.ImageTransparency = hi - (hi - lo) * puls

      -- the mark's own halo drifts around it on a slower, offset cycle, so the
      -- two glows never breathe in step and the pill does not read as one pulse
      if orbGlow then
        local a = self._dockT * 0.75
        orbGlow.Position = UDim2.fromOffset(22 + math.cos(a) * 2.6,
                                            18 + math.sin(a * 1.3) * 2.2)
        local p2 = 0.5 + 0.5 * math.cos(self._dockT * 1.55 + 1.1)
        orbGlow.ImageTransparency = (self._dockHover and 0.50 or 0.66)
                                    + 0.16 * p2
      end
    end))
  end

  self.dock, self.dockGlow, self.dockOrb, self.orbGlow =
    dock, dockGlow, dockOrb, orbGlow

  -- the pinned-feature strip lives beside the pill, as a CHILD of it, so it
  -- inherits every minimise and restore rather than chasing them
  if L.Pins and L.Pins.attach then L.try("pins.attach", L.Pins.attach, dock) end

  -- last, because it reaches into the hero video and the lattice, both of which
  -- have to exist first
  L.try("window.background", function() self:applyBackground() end)

  return self
end

-- ---------------------------------------------------------------- nav

-- A group heading in the sidebar. Five flat entries read as a list; two groups
-- of two or three read as a structure.
function Window:navSection(name)
  local h = mk("Frame", {
    Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1,
    LayoutOrder = self._navOrder, Name = "NavSection", Parent = self.navList,
  })
  self._navOrder = self._navOrder + 1
  self._navCursor = self._navCursor + 26 + 2
  A.text({
    Text = L.track(string.upper(name or ""), 1),
    font = T.font.medium, size = T.size.nano,
    colour = T.c.textOff, Position = UDim2.fromOffset(12, 12),
    Size = UDim2.new(1, -14, 0, 12), Parent = h,
  })
  self._sections[#self._sections + 1] = h
  self._pendingSection = name
  return h
end

function Window:tab(opts)
  opts = opts or {}
  local index = #self.tabs + 1

  local btn = mk("Frame", {
    Size = UDim2.new(1, 0, 0, TAB_H), BackgroundTransparency = 1,
    LayoutOrder = self._navOrder, Name = "Tab_" .. (opts.name or index),
    Parent = self.navList,
  })
  self._navOrder = self._navOrder + 1
  local navY = self._navCursor
  self._navCursor = self._navCursor + TAB_H + 2

  -- ANIMATED CHROME TILE. The reference icons are not stills -- the objects turn.
  -- Each is a 48-frame loop at 96 px, which is near 1:1 at the 30 px display size
  -- and costs 1.7 MB per icon.
  --
  -- ONLY THE ACTIVE AND HOVERED ONES RUN. Five sequences turning at once is
  -- noise, and it makes the nav compete with the page for attention. A resting
  -- tab holds a single frame, which costs nothing.
  local glyph, iconVid, isChrome
  if opts.chrome then
    iconVid = L.Video and L.Video.new(btn, {
      folder = "lumen_fx/icons_anim", prefix = opts.chrome, count = 48, fps = 12,
      size = 30, Position = UDim2.fromOffset(8 + 15, TAB_H / 2), ZIndex = 2,
      manual = true, loop = true,
    })
    if iconVid then
      glyph = iconVid.frameObj
      isChrome = true
    end
  end
  if not glyph and opts.chrome then
    glyph = A.chrome(btn, opts.chrome, 30, {
      Position = UDim2.fromOffset(8, TAB_H / 2 - 15), ZIndex = 2 })
    isChrome = glyph ~= nil
  end
  if not glyph then
    local iconFn = A.Icon[opts.icon or "dot"] or A.Icon.dot
    glyph = iconFn(btn, 16, T.c.textMute)
    glyph.Position = UDim2.fromOffset(12, TAB_H / 2 - 8)
  end

  -- Same derivation as every other two-part row in this project: the name's box
  -- ends where the number's begins, plus a gap. It used to reserve `1, -76`
  -- while the number occupied the last 32 px, so the two overlapped by 4 px on
  -- every tab -- invisible only because the name truncates first.
  local NAV_X, NUM_W, NUM_RIGHT, NUM_GAP = 48, 20, 12, 8
  local label = A.text({
    Text = opts.name or ("Tab " .. index), font = T.font.medium,
    size = T.size.body, colour = T.c.textMute,
    Position = UDim2.fromOffset(NAV_X, 0),
    Size = UDim2.new(1, -(NAV_X + NUM_W + NUM_RIGHT + NUM_GAP), 1, 0),
    truncate = true, Parent = btn,
  })
  -- the number key that selects it, stated rather than hidden in a help screen
  A.text({
    Text = tostring(index), font = T.font.mono, size = T.size.tiny,
    colour = T.c.textOff, align = Enum.TextXAlignment.Right,
    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -NUM_RIGHT, 0.5, 0),
    Size = UDim2.fromOffset(NUM_W, 12), Parent = btn,
  })

  local page = mk("Frame", {
    Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false,
    Name = "Page_" .. (opts.name or index), Parent = self.content,
  })

  -- Heading lives OUTSIDE the CanvasGroup so it renders natively.
  --
  -- THREE TIERS, WIDE APART. The reference gets its hierarchy from RANGE: a tiny
  -- wide-tracked eyebrow, then a large title, then a small dim line. Sizes only
  local head = mk("Frame", {
    Size = UDim2.new(1, 0, 0, 88), BackgroundTransparency = 1,
    Name = "Heading", Parent = page,
  })
  local eyebrow = A.text({
    Text = L.track(string.upper(self._pendingSection or "SECTION"), 1),
    font = T.font.medium, size = T.size.nano, colour = T.c.textOff,
    Position = UDim2.fromOffset(24, 16), Size = UDim2.new(1, -48, 0, 12),
    Parent = head,
  })
  local titleLbl = A.text({
    Text = opts.name or "", font = T.font.display, size = T.size.display,
    colour = T.c.text,
    Position = UDim2.fromOffset(24, 30), Size = UDim2.new(1, -48, 0, 28),
    Parent = head,
  })

  -- ---- chrome title -----------------------------------------------------
  --
  -- THIS USED TO BE A 36-FRAME IMAGE SEQUENCE, and the reason given was:
  -- "Roblox cannot fill text with a gradient, mask an image to glyphs, or
  -- animate a reflection across a TextLabel". The first of those is false and
  -- has been for years -- a UIGradient parented to a TextLabel tints its
  -- glyphs. Verified on this client with a side-by-side probe and a screenshot
  -- before any of this was written.
  --
  -- What that assumption cost:
  --   * only SIX words existed. Movement, Combat, Visuals, AI and Config fell
  --     back to flat white, because nobody had run the generator for them.
  --   * the frames were baked at a 96 px glyph. Expand the window past the
  --     scale that assumed and the title is an UPSCALED BITMAP -- which is the
  --     "text goes soft when I resize" complaint, and it could not be fixed by
  --     any amount of care at the call site.
  --   * about 490 ms of the window build, by the old comment's own measurement.
  --
  -- Rendering it live costs one UIGradient per page and is resolution
  -- independent, so it is sharp at any window size and any DPI, and every tab
  -- gets one for free -- including tabs that do not exist yet.
  local titleGrad, titlePattern
  do
    -- PER-PAGE CHARACTER, from one engine -- now shared with the loading screen.
    -- See A.CHROME / A.chromeSeq in atoms for why the sweep resamples the
    -- gradient's colours instead of sliding its Offset. Short version: Offset
    -- clamps, so half of every cycle had the highlight outside the letters and
    -- the title just sat there as dark grey text.
    local cfg = A.CHROME[opts.name or ""] or A.CHROME.__default
    titlePattern = A.chromePattern(cfg)
    titleGrad = mk("UIGradient", {
      Color = A.chromeSeq(titlePattern, 0),
      Rotation = cfg.rot,
      Parent = titleLbl,
    })
    titleGrad:SetAttribute("Speed", cfg.speed)
  end

  local sub = A.text({
    Text = opts.desc or "", font = T.font.body, size = T.size.micro,
    colour = T.c.textMute, Position = UDim2.fromOffset(24, 60),
    Size = UDim2.new(1, -48, 0, 14), Parent = head,
  })
  -- (object, property) pairs, not bare labels: the heading is no longer all
  -- text -- the chrome title fades on GroupTransparency -- and a fade list that
  -- assumes TextTransparency would silently skip whatever is not a label.
  local heads = {
    { eyebrow,  "TextTransparency" },
    { titleLbl, "TextTransparency" },
    { sub,      "TextTransparency" },
  }

  local grp = mk("CanvasGroup", {
    Position = UDim2.fromOffset(0, 88), Size = UDim2.new(1, 0, 1, -88),
    BackgroundTransparency = 1, GroupTransparency = 1,
    ClipsDescendants = true,          -- or the scroll runs up under the heading
    Parent = page,
  })

  local scroll = A.scroll({ Parent = grp, gap = T.gap.md, Name = "PageScroll" })
  L.pad(4, 24, 24, 24, scroll)

  local tab = { index = index, name = opts.name, button = btn, label = label,
                glyph = glyph, chrome = isChrome, iconVid = iconVid,
                page = page, group = grp, head = head, heads = heads,
                titleGrad = titleGrad, titlePattern = titlePattern,
                body = scroll, sub = sub, navY = navY, window = self }

  A.interactive(btn, {
    radius = T.r.md, hoverAlpha = 0.97, pressAlpha = 0.95,
    onClick = function() self:select(index) end,
    -- The chrome tile grows and brightens under the pointer. Springs, so moving
    -- quickly along the nav makes each icon catch and release rather than
    -- snapping between two states.
    onState = function(st)
      if not isChrome then return end
      local on = (self.active == index)
      local big = st.hovered and 34 or 30
      M.to(glyph, "Size", UDim2.fromOffset(big, big), "fast")
      self._hover = st.hovered and index or (self._hover == index and nil or self._hover)
      if not on and not iconVid then
        M.to(glyph, "ImageTransparency", st.hovered and 0.12 or 0.5, "fast")
      end
    end,
  })

  if L.Palette then
    L.Palette.add(page, opts.name or ("Tab " .. index), opts.desc or "")
  end
  self.tabs[index] = tab
  self._navY[index] = nil
  if index == 1 then self:select(1, true) end
  return tab
end

function Window:select(index, immediate)
  local tab = self.tabs[index]
  if not tab or self.active == index then return end
  -- A popover belongs to the page that opened it; leaving that page must take it
  -- with you, or it hangs over the new one. Closed through its OWNER, not by
  -- destroying the overlay behind its back -- doing that left the dropdown still
  -- flagged open, so its next click closed nothing and it read as broken.
  if L.C and L.C.closePopovers then L.C.closePopovers() end
  if self.overlay then
    for _, d in ipairs(self.overlay:GetChildren()) do pcall(function() d:Destroy() end) end
  end
  local prev = self.active and self.tabs[self.active]
  self.active = index

  local y = tab.navY
  self.pill.Visible, self.pillBar.Visible = true, true
  local setter = immediate and M.set or M.to
  setter(self.pill, "Position", UDim2.fromOffset(0, y), "base")
  setter(self.pillBar, "Position", UDim2.fromOffset(-12, y + TAB_H * 0.275), "base")

  for i, t in ipairs(self.tabs) do
    local on = (i == index)
    M.to(t.label, "TextColor3", on and T.c.text or T.c.textMute, "fast")
    if t.chrome then
      -- brightness, not hue. Tinting a rendered chrome object toward the accent
      -- flattens every reflection in it.
      if t.iconVid then
        t.iconVid.rest = on and 0 or 0.5
        local cur = t.iconVid.labels[t.iconVid.shown]
        if cur then M.to(cur, "ImageTransparency", t.iconVid.rest, "fast") end
      else
        M.to(t.glyph, "ImageTransparency", on and 0 or 0.5, "fast")
      end
    else
      for _, d in ipairs(t.glyph:GetDescendants()) do
        if d:IsA("Frame") then
          M.to(d, "BackgroundColor3", on and T.c.accent or T.c.textMute, "fast")
        elseif d:IsA("UIStroke") then
          M.to(d, "Color", on and T.c.accent or T.c.textMute, "fast")
        end
      end
    end
  end

  if prev and prev ~= tab then
    local old = prev
    A.groupTo(old.group, 1, "fast")
    M.to(old.group, "Position", UDim2.fromOffset(0, 98), "fast")
    -- the heading leaves with the body it belongs to, or the two pages' titles
    -- sit on top of each other for the whole handover
    if old.heads then
      for _, h in ipairs(old.heads) do M.to(h[1], h[2], 1, "fast") end
      M.to(old.head, "Position", UDim2.fromOffset(0, 10), "fast")
    end
    -- DERIVED FROM THE TOKEN, NOT TYPED. 0.18 was the "fast" duration at scale
    -- 1.0 and nothing else -- on the Calm profile that token runs 1.4x longer,
    -- so the page was hidden 71% of the way through its own fade and the swap
    -- popped. Motion.resolve applies the live profile scale, so this tracks
    -- whatever the user picked.
    local fadeOut = select(1, M.resolve("fast"))
    task.delay(fadeOut + 0.04, function()
      if L.live() and self.active ~= old.index then old.page.Visible = false end
    end)
  end

  -- the chrome title for this page is built the first time it is opened

  tab.page.Visible = true
  if immediate then
    A.groupSet(tab.group, 0)
    M.set(tab.group, "Position", UDim2.fromOffset(0, 88))
    if tab.heads then
      M.set(tab.head, "Position", UDim2.fromOffset(0, 0))
      for _, h in ipairs(tab.heads) do M.set(h[1], h[2], 0) end
    end
  else
    M.set(tab.group, "Position", UDim2.fromOffset(0, 102))
    A.groupSet(tab.group, 1)
    A.groupTo(tab.group, 0, "base")
    M.to(tab.group, "Position", UDim2.fromOffset(0, 88), "slow")
    if tab.heads then
      M.set(tab.head, "Position", UDim2.fromOffset(0, 14))
      for _, h in ipairs(tab.heads) do M.set(h[1], h[2], 1) end
      M.to(tab.head, "Position", UDim2.fromOffset(0, 0), "slow")
      for _, h in ipairs(tab.heads) do M.to(h[1], h[2], 0, "base") end
    end
  end
  -- Return to the top. AutomaticCanvasSize grows the canvas AFTER the one-shot
  -- reset in A.scroll, so a page built later can end up scrolled with its first
  -- heading clipped above the viewport.
  -- reset through the controller: writing CanvasPosition alone would leave the
  -- spring still aiming at the old offset and it would scroll straight back
  A.scrollReset(tab.body)
  task.defer(function()
    if tab.body.Parent then A.scrollReset(tab.body) end
  end)

  -- deferred so the rows have been laid out and can be sorted by where they
  -- actually sit; skipped on the programmatic path, where nobody is watching
  if not immediate then
    task.defer(function()
      if L.live() and self.active == index then self:_cascade(tab) end
    end)
  end

  -- ONLY A TAB THE USER CHOSE IS WORTH REMEMBERING. This wrote on every select,
  -- including the `self:select(1, true)` that Window:tab fires while the nav is
  -- still being built -- so construction overwrote the saved tab with 1 before
  -- anything had a chance to read it back, and "reopen where you left off" could
  -- never have worked no matter how it was restored. `immediate` is true for
  -- exactly the programmatic paths (construction and restore) and false for the
  -- click handler, which makes it the intent flag this needs.
  if L.Cfg and not immediate then L.Cfg.set("tab", index) end
  if self.onTab then L.try("window.onTab", self.onTab, tab) end
end

-- ---------------------------------------------------------------- chrome

function Window:show(transitionGen)
  if transitionGen then
    if self._transitionGen ~= transitionGen then return self end
  else
    self._transitionGen = (self._transitionGen or 0) + 1
    transitionGen = self._transitionGen
  end
  self.hidden = false
  self.shell.Visible, self.root.Visible = true, true
  A.groupSet(self.root, 1)
  M.set(self.root, "Size", UDim2.fromOffset(self.width * 0.95, self.height * 0.95))
  -- Restore authored child alpha before the shared group clock starts.
  if self.body then M.set(self.body, "BackgroundTransparency", 0) end
  if self.wash then M.set(self.wash, "BackgroundTransparency", 0) end
  local fadeDur = select(1, M.resolve("base"))
  local fadeToken = { fadeDur, 0 }
  A.groupTo(self.root, 0, fadeToken)
  M.to(self.root, "Size", UDim2.fromOffset(self.width, self.height), "slow")
  if self.shadow then
    local sp = (self.shadowSpread or 34) * 2
    M.set(self.shadow, "ImageTransparency", 1)
    M.set(self.shadow, "Size", UDim2.new(0.97, sp, 0.97, sp))
    M.to(self.shadow, "ImageTransparency", self.shadowRest, fadeToken)
    M.to(self.shadow, "Size", UDim2.new(1, sp, 1, sp), "slow")
  end
  -- The root CanvasGroup is the one opacity clock. Animating the body again
  -- multiplied two fades, so the outline/text appeared a few frames before the
  -- dark plate in recordings. Restore child resting alpha synchronously.
  M.to(self.dock, "Position", Window.DOCK_OUT, "base")
  A.blurTo(Window.BLUR, "slow")
  M.to(self.scrim, "BackgroundTransparency", 0.5, fadeToken)
  return self
end

function Window:hide(token, keepDock, transitionGen)
  token = token or "fast"
  if transitionGen then
    if self._transitionGen ~= transitionGen then return self end
  else
    self._transitionGen = (self._transitionGen or 0) + 1
    transitionGen = self._transitionGen
  end
  self.hidden = true
  -- an open menu must not be waiting for you when the window comes back
  if L.C and L.C.closePopovers then L.C.closePopovers() end
  -- The drawer lives inside the shell, so it would be carried and squashed by
  -- the morph. It is handed its own window instead and becomes draggable, and
  -- comes back when this one does.
  if L.Side and L.Side.open and L.Side.detach then L.Side.detach() end
  -- ONE TOKEN FOR EVERY OUTGOING PROPERTY. The panel was leaving on `fast` while
  -- the scrim and blur left on `base`, so the dimming lingered after the window
  -- had already gone. Anything that arrives together has to leave together.
  local dur = select(1, M.resolve(token))
  local opacityToken = { dur, 0 }
  A.groupTo(self.root, 1, opacityToken)
  M.to(self.root, "Size", UDim2.fromOffset(self.width * 0.97, self.height * 0.97), token)
  -- Shadow geometry is outside the root group, so it receives the exact same
  -- duration explicitly. A shorter shadow/plate clock produced the dark edge
  -- lead visible in the minimise recording.
  if self.shadow then
    local sp = (self.shadowSpread or 34) * 2
    M.to(self.shadow, "ImageTransparency", 1, opacityToken)
    M.to(self.shadow, "Size", UDim2.new(0.97, sp, 0.97, sp), token)
  end

  -- Body, wash, icons and text leave through GroupTransparency. THE STROKE
  -- DOES NOT -- it is parented to the CanvasGroup rather than being one of
  -- the children the group composites, so it kept drawing at its resting 0.30
  -- for the whole hide: a solid rounded outline around an empty rectangle,
  -- snapped away only by Visible = false at the very end. A.groupTo carries
  -- the stroke with the group. Their authored resting values stay intact for
  -- an interruption-safe restore.
  if self.body then M.set(self.body, "BackgroundTransparency", 0) end
  if self.wash then M.set(self.wash, "BackgroundTransparency", 0) end
  A.blurTo(0, token)
  M.to(self.scrim, "BackgroundTransparency", 1, opacityToken)

  -- THE DOCK LEAVES TOO. It is the one drawn thing outside the root CanvasGroup
  -- that hide() never touched -- an opaque 227x58 bar parked just off the top
  -- edge. Anything the group fade cannot reach has to be faded by name, or it
  -- outlives the window that owned it.
  -- minimise owns the dock while the genie runs, so it opts out of this
  if not keepDock then M.to(self.dock, "Position", Window.DOCK_OUT, token) end

  -- DERIVED, NOT TYPED. 0.30 was the `fast` duration at scale 1.0 and nothing
  -- else: on the Calm profile the fade needs 0.35 s, so the window was switched
  -- off 15% before it finished fading and popped. Third instance of this exact
  -- bug in the project -- a literal that silently mirrors a motion token.
  task.delay(dur + 0.06, function()
    if L.live() and self.hidden and self._transitionGen == transitionGen then
      self.root.Visible, self.shell.Visible = false, false
    end
  end)
  return self
end

-- Everything on `o` that is currently drawn, with the value it rests at.
local function drawnParts(o, into)
  into = into or {}
  for _, p in ipairs({ "BackgroundTransparency", "TextTransparency",
                       "ImageTransparency", "Transparency" }) do
    local ok, v = pcall(function() return o[p] end)
    if ok and type(v) == "number" and v < 1 then into[#into + 1] = { o, p, v } end
  end
  return into
end

function Window:minimise()
  if self._morphBusy then return end
  self._transitionGen = (self._transitionGen or 0) + 1
  local transitionGen = self._transitionGen
  self._morphBusy = true

  -- THE PILL IS PLACED FIRST AND REVEALED LAST. Putting it at its resting spot
  -- immediately but invisible means the genie has a real target to measure, and
  -- fading it up as the bands land makes the stack look like it BECAME the
  -- pill rather than pulling up alongside one that was already there.
  M.stop(self.dock, "Position")
  self.dock.Position = Window.DOCK_IN

  -- CAPTURED ONCE, EVER. minimise() sets these to transparent and restore() has
  -- to put them back; re-reading them per minimise meant the second one sampled
  -- a dock the first had already hidden, recorded "invisible" as its resting
  -- state, and the pill never appeared again. Same trap as the row cascade.
  if not self._dockParts then
    local parts = drawnParts(self.dock)
    -- BOTH pin bars, not just the right-hand one. Pins now fill left as well as
    -- right, and each strip is its own CanvasGroup -- so treating only the
    -- first as a single unit left the left-hand chips being walked
    -- element-by-element, revealing on their own clocks while the right side
    -- faded as one.
    local pinBars = (L.Pins and L.Pins.bars) or (L.Pins and L.Pins.bar and { L.Pins.bar }) or {}
    local function isBar(x)
      for _, b in ipairs(pinBars) do if x == b then return b end end
      return nil
    end
    local function insideBar(x)
      for _, b in ipairs(pinBars) do
        if b and x:IsDescendantOf(b) then return true end
      end
      return false
    end
    for _, x in ipairs(self.dock:GetDescendants()) do
      local b = isBar(x)
      if b then
        parts[#parts + 1] = { b, "GroupTransparency", L.uiRead(b,"GroupTransparency") }
      elseif not insideBar(x) then
        drawnParts(x, parts)
      end
    end
    self._dockParts = parts
  end
  local pill = self._dockParts
  for _, e in ipairs(pill) do M.set(e[1], e[2], 1) end

  -- THE SATURN HAS TO BE PAUSED, NOT JUST HIDDEN. It runs its own playback loop,
  -- which re-shows the current frame the instant it advances -- so walking the
  -- pill's parts hid it for a sixteenth of a second and then it came straight
  -- back, leaving the logo hanging alone at the pill's destination while the
  -- morph was still travelling. Caught on video: a Saturn floating in the sky
  -- above a curve that had not arrived yet.
  if self.dockOrb then
    self.dockOrb:pause()
    for _, lb in ipairs(self.dockOrb.labels) do lb.ImageTransparency = 1 end
  end

  local function revealAt(p)
    if self._transitionGen ~= transitionGen then return end
    local a = math.clamp((p - 0.78) / 0.22, 0, 1)
    a = a * a * (3 - 2 * a)
    for _, e in ipairs(pill) do
      if e[1].Parent then L.uiWrite(e[1],e[2],1 + (e[3] - 1) * a) end
    end
  end
  self:_morph(function()
    if self._transitionGen ~= transitionGen then return end
    revealAt(1)
    self._morphBusy = false
    if self.dockOrb then self.dockOrb:play() end
  end, revealAt)

  -- the real panel goes at once: the proxy is what the eye is following
  self:hide("fast", true, transitionGen)
end

function Window:restore()
  self._transitionGen = (self._transitionGen or 0) + 1
  local transitionGen = self._transitionGen
  -- put the detached drawer back where it belongs before anything animates
  if L.Side and L.Side.detached and L.Side.reattach then
    task.defer(function()
      if self._transitionGen == transitionGen then L.try("side.reattach", L.Side.reattach) end
    end)
  end
  -- CANCEL ANY GENIE STILL IN FLIGHT. _morphBusy is otherwise only cleared when
  -- the animation finishes, so restoring part-way through left it set and the
  -- NEXT minimise returned immediately and did nothing -- a dead button with no
  -- error to explain it. Reopening the window is an explicit "stop that".
  self._morphBusy = false
  local stale = L.host():FindFirstChild("LumenMorph")
  if stale then pcall(function() stale:Destroy() end) end

  -- and hand the pill its opacity back, or the next minimise has nothing to
  -- reveal: minimise() is what set these to 1, so restore() is what must undo it
  if self._dockParts then
    for _, e in ipairs(self._dockParts) do
      if e[1].Parent then M.set(e[1], e[2], e[3]) end
    end
  end
  if self.dockOrb then self.dockOrb:play() end

  M.to(self.dock, "Position", Window.DOCK_OUT, "base")
  self:show(transitionGen)
end

-- TWO THINGS THE HOTKEY COULD REASONABLY MEAN, so it is a setting rather than a
-- decision made for everyone. Hiding drops the window instantly and brings it
-- straight back -- fastest, and nothing is left on screen. Minimising runs the
-- morph down to the dock pill, which takes longer but leaves a visible handle
-- and reads as the window going somewhere rather than blinking out.
--
-- Minimise is the default because the pill is the discoverable way back: hide
-- leaves nothing on screen, so anyone who forgets the key has lost the hub.
function Window:toggle()
  local wantMinimise = not (L.Cfg and L.Cfg.data.toggleAction == "Hide")

  -- minimise routes through hide, so `hidden` already covers "parked on the
  -- pill" as well as "gone" -- one branch brings it back from either
  if self.hidden then
    self:restore()
    return
  end
  if wantMinimise and self.minimise then
    self:minimise()
  else
    self:hide()
  end
end

function Window:subtitle(text)
  if self.subtitleLbl then self.subtitleLbl.Text = tostring(text) end
end

-- Rename the hub. An empty name shows the "Untitled" placeholder instead of the
-- old hardcoded "LUMEN" wordmark. Updates the header title, the minimised dock
-- pill, and persists the choice in config.
function Window:rename(text)
  text = tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
  self._name = text
  local disp = text ~= "" and text or "Untitled"
  if self.titleLbl then
    self.titleLbl.Text = L.track(disp, 1)
    self.titleLbl.TextColor3 = text ~= "" and T.c.text or T.c.textOff
    self.titleLbl.Visible = true
  end
  if self.dockLbl then self.dockLbl.Text = disp end
  if L.Cfg then L.Cfg.set("hubName", text) end
  L.note("ui.rename", "hub renamed to " .. (text ~= "" and text or "(untitled)"))
  if text ~= "" and L.Toast and L.Toast.push then
    L.try("toast.rename", function()
      L.Toast.push({ body = "Renamed to \"" .. text .. "\"", kind = "ok", title = "UI" })
    end)
  end
  return text
end

-- ---------------------------------------------------------------- input

-- Persist where and how big the window is, debounced by Cfg.
function Window:_saveGeom()
  if not L.Cfg then return end
  local p, sz = self.shell.Position, self.root.Size
  L.Cfg.set("geom", {
    x = math.floor(p.X.Offset), y = math.floor(p.Y.Offset),
    w = math.floor(sz.X.Offset), h = math.floor(sz.Y.Offset),
  })
end

-- EDGE SNAPPING IS GONE, AND SO IS THE CODE FOR IT. It pulled the window to
-- places the cursor was not, and its confirmation flash -- a half-transparent
-- accent wash over the entire panel -- fired again every time a snap line was
-- crossed, which is what read as the window flickering blue while being
-- dragged. A drag is the one interaction that should have no opinions.

-- The minimise pill's two positions, named once. They were typed out at four
-- call sites with three different motion tokens between them, which is how the
-- dock ended up leaving on a different clock from the window it belongs to.
Window.DOCK_OUT = UDim2.new(0.5, 0, 0, -60)
Window.DOCK_IN  = UDim2.new(0.5, 0, 0, 18)

-- ---------------------------------------------------------------- morph
--
-- Minimising does not shrink the window, it REDRAWS it as a line and folds that
-- line away: the panel's outline contracts to a circle, the circle folds into an
-- infinity, and the infinity spins down into the pill.
--
-- Roblox has no vector paths, so the curve is a string of small frames placed on
-- it each frame. Two bits of maths do all the work and neither needs a lookup
-- table:
--
--   SUPERELLIPSE for the outline. |x/a|^n + |y/b|^n = 1 is an ellipse at n = 2
--   and approaches a rectangle as n grows. Sweeping the exponent turns the
--   window's rounded rectangle into a circle in one continuous family -- there
--   is no rectangle-to-circle interpolation to hand-write.
--
--   GERONO LEMNISCATE for the fold. A circle is (cos t, sin t); the figure-eight
--   is (cos t, sin t cos t). Only Y differs, so the morph is a single lerp on
--   one coordinate: y = sin t * (1 + m(cos t - 1)). At m = 0 it is exactly a
--   circle, at m = 1 exactly an infinity, and every value between is a clean
--   in-between rather than an approximation.

local MORPH_SEGS = 60
local MORPH_TOK  = { 0.95, -0.10 }   -- one long overdamped sweep, no bounce

-- The morph's bloom, as a fraction of the SHORTER viewport axis. 0.62 keeps it
-- clearly a glow around the panel rather than a wash across the display; the
-- uncapped version reached 2256 px on a 2560x1369 screen.
local MORPH_GLOW_CAP = 0.62
-- The span, in pixels, at which the bloom emits its full authored opacity.
-- Larger glows are faded in proportion so the light delivered stays even.
local MORPH_GLOW_REF = 620

-- 0..1 with eased ends, over an arbitrary window of the timeline
local function ramp(p, from, to)
  if to <= from then return p >= to and 1 or 0 end
  local t = math.clamp((p - from) / (to - from), 0, 1)
  return t * t * (3 - 2 * t)
end

function Window:_morph(onDone, onProgress)
  local dock = self.dock
  local r = { x = self.root.AbsolutePosition.X, y = self.root.AbsolutePosition.Y,
              w = self.root.AbsoluteSize.X,     h = self.root.AbsoluteSize.Y }
  local d = { x = dock.AbsolutePosition.X, y = dock.AbsolutePosition.Y,
              w = dock.AbsoluteSize.X,     h = dock.AbsoluteSize.Y }
  if r.w < 4 or d.w < 4 then if onDone then onDone() end return 0 end

  -- own ScreenGui, no UIScale: everything below is raw screen pixels, which is
  -- the only space the window rect and the dock rect are both measured in
  local gui = mk("ScreenGui", {
    Name = "LumenMorph", ResetOnSpawn = false, IgnoreGuiInset = true,
    ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 12,
  })
  gui.Parent = L.host()

  local probe = mk("Frame", { Size = UDim2.fromOffset(1, 1),
    Position = UDim2.fromOffset(0, 0), BackgroundTransparency = 1, Parent = gui })
  L.RunService.Heartbeat:Wait()
  if not gui.Parent then return 0 end
  local k = probe.AbsolutePosition
  probe:Destroy()

  local glow = A.img and A.img.glow and mk("ImageLabel", {
    AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(r.w, r.h),
    BackgroundTransparency = 1, Image = A.img.glow,
    ImageColor3 = T.c.accent, ImageTransparency = 0.86,
    ZIndex = 1, Parent = gui,
  })

  local dotW = math.max(3, math.floor(r.h / 150))
  local segs = {}
  for i = 1, MORPH_SEGS do
    local s = mk("Frame", {
      AnchorPoint = Vector2.new(0.5, 0.5),
      Size = UDim2.fromOffset(dotW, dotW),
      BackgroundColor3 = T.c.text, BorderSizePixel = 0,
      ZIndex = 3, Name = "Seg", Parent = gui,
    })
    L.corner(999, s)
    segs[i] = s
  end

  local ar, br = r.w / 2, r.h / 2
  local R = math.min(r.w, r.h) * 0.30          -- radius of the circle stage
  local cx0, cy0 = r.x + ar, r.y + br
  local cx1, cy1 = d.x + d.w / 2, d.y + d.h / 2

  -- RESOLVED, NOT RAW. This built its spring straight from MORPH_TOK while the
  -- timeout below took the same token THROUGH Motion.resolve, so the two
  -- disagreed about how long the morph lasts the moment any motion profile was
  -- active: under a slower profile the spring finished early and the morph sat
  -- waiting, and under a faster one the timeout cut it off mid-flight. It also
  -- meant the minimise was the one animation in the hub that ignored the motion
  -- profile entirely -- which is exactly why it still felt snappy after the
  -- profile was corrected.
  local morphDur, morphBounce = M.resolve(MORPH_TOK)
  local spring = L.Spring.new(morphDur, morphBounce, 0)
  spring:to(1)

  local conn
  conn = L.RunService.RenderStepped:Connect(function(dt)
    if not gui.Parent then if conn then conn:Disconnect() end return end
    local p = math.clamp(spring:step(dt), 0, 1)
    if onProgress then L.try("window.morphProgress", onProgress, p) end

    local toCircle = ramp(p, 0.00, 0.42)   -- rectangle outline -> circle
    local toInf    = ramp(p, 0.30, 0.72)   -- circle -> infinity
    local away     = ramp(p, 0.62, 1.00)   -- shrink and travel to the pill
    local fade     = ramp(p, 0.80, 1.00)

    local scale = 1 - 0.86 * away
    local cx = cx0 + (cx1 - cx0) * away
    local cy = cy0 + (cy1 - cy0) * away
    local rot = p * 2.6                     -- radians; the fold turns as it goes

    -- exponent sweeps 8 (near-rectangular) down to 2 (a true ellipse)
    local n = 8 - 6 * toCircle
    local cosR, sinR = math.cos(rot), math.sin(rot)

    for i, s in ipairs(segs) do
      local t = (i - 1) / MORPH_SEGS * math.pi * 2
      local ct, st = math.cos(t), math.sin(t)

      -- outline of the panel, as a superellipse
      local ex = (ct >= 0 and 1 or -1) * math.abs(ct) ^ (2 / n)
      local ey = (st >= 0 and 1 or -1) * math.abs(st) ^ (2 / n)
      local rx, ry = ar * ex, br * ey

      -- the symbol: circle at toInf 0, infinity at toInf 1
      local ix = R * ct
      local iy = R * st * (1 + toInf * (ct - 1))

      local x = rx + (ix - rx) * toCircle
      local y = ry + (iy - ry) * toCircle
      x, y = x * scale, y * scale
      local px = cx + x * cosR - y * sinR
      local py = cy + x * sinR + y * cosR

      s.Position = UDim2.fromOffset(px - k.X, py - k.Y)
      s.BackgroundTransparency = fade

      -- a brighter head runs round the curve, so the line reads as drawn
      -- rather than as a ring of dots sitting still
      local head = ((i / MORPH_SEGS) + p * 1.7) % 1
      local lit = head < 0.14 and (1 - head / 0.14) or 0
      s.BackgroundColor3 = T.c.text:Lerp(T.c.accent, 1 - lit * 0.85)
      local sz = dotW * (1 + lit * 1.25) * (0.5 + 0.5 * scale)
      s.Size = UDim2.fromOffset(math.max(sz, 1), math.max(sz, 1))
    end

    if glow then
      -- WHAT THE EYE READS IS AREA x OPACITY, NOT OPACITY.
      --
      -- This was r.w * scale * 1.5 at a flat 0.80. r is the whole window rect,
      -- so on a 1507x1139 panel the first frame drew a 2256x1704 glow -- larger
      -- than a 2560x1369 screen -- in a ScreenGui at DisplayOrder 12, i.e. over
      -- the game and over the hub. On a dark game that is a bloom. On a bright
      -- one it is a screen-wide wash with a soft edge, which is what a user
      -- photographed and reasonably called the visuals leaking.
      --
      -- Two changes. The size is capped against the VIEWPORT, so a bigger panel
      -- or a bigger monitor cannot turn a local bloom into full-bleed. And the
      -- opacity now falls as the glow grows, holding the total light roughly
      -- constant -- a big soft glow and a small tight one deliver the same
      -- amount of light, which is the thing that was actually wrong.
      local vp = L.viewport()
      local cap = math.min(vp.X, vp.Y) * MORPH_GLOW_CAP
      local gw = math.min(r.w * scale * 1.5, cap)
      local gh = math.min(r.h * scale * 1.5, cap)
      glow.Position = UDim2.fromOffset(cx - k.X, cy - k.Y)
      glow.Size = UDim2.fromOffset(gw, gh)

      local opaque = 1 - (0.80 + 0.20 * fade)          -- what it used to emit
      local span = math.max(math.sqrt(gw * gh), 1)
      opaque = opaque * math.clamp(MORPH_GLOW_REF / span, 0.30, 1)
      glow.ImageTransparency = 1 - opaque
    end
  end)

  local total = morphDur + 0.12          -- one source of truth with the spring
  task.delay(total, function()
    if conn then conn:Disconnect() end
    pcall(function() gui:Destroy() end)
    if onDone then onDone() end
  end)
  return total
end


-- ---------------------------------------------------------------- cascade
--
-- Rows arrive one after another instead of the page appearing all at once.
--
-- It has to be an opacity stagger, not a slide: the page uses a UIListLayout,
-- which owns child Position outright, so anything moved is snapped straight back.

local FADE_PROP = {
  Frame = "BackgroundTransparency", TextLabel = "TextTransparency",
  TextButton = "TextTransparency", ImageLabel = "ImageTransparency",
  UIStroke = "Transparency",
}

-- Every part of a row that is currently drawn, with the value it rests at.
local function rowParts(row)
  local parts = {}
  local function add(o)
    local p = FADE_PROP[o.ClassName]
    if not p then return end
    local v = o[p]
    -- already invisible at rest: fading it changes nothing and costs a spring
    if type(v) == "number" and v < 1 then parts[#parts + 1] = { o, p, v } end
  end
  add(row)
  for _, d in ipairs(row:GetDescendants()) do add(d) end
  return parts
end

function Window:_cascade(tab)
  if not self.cascade or self.cascade <= 0 then return end

  -- REST VALUES ARE CAPTURED ONCE, EVER. Reading them at cascade time looks
  -- right until you change tabs twice quickly: the second pass samples rows the
  -- first pass has already faded, records "invisible" as their resting state,
  -- and settles them there. The page comes back permanently blank.
  if not tab._cascadeParts then
    local rows = {}
    for _, c in ipairs(tab.body:GetChildren()) do
      if c:IsA("GuiObject") then rows[#rows + 1] = c end
    end
    -- sorted by where they actually sit: LayoutOrder is 0 for most of these, so
    -- child order would not match reading order
    table.sort(rows, function(a, b) return a.AbsolutePosition.Y < b.AbsolutePosition.Y end)
    local parts = {}
    for i, row in ipairs(rows) do
      if i > 12 then break end        -- past the fold nobody sees the stagger
      parts[i] = rowParts(row)
    end
    tab._cascadeParts = parts
  end

  -- CANCELLABLE. This used to fan out one bare M.after per element, which
  -- nothing could call back: switch tabs twice quickly and the first page's
  -- cascade kept firing into a page you had already left, fading rows back in
  -- underneath the new one. M.seq hands back a handle, so starting a cascade
  -- cancels the one before it.
  if self._cascadeSeq then self._cascadeSeq:cancel() end
  for _, group in ipairs(tab._cascadeParts) do
    for _, e in ipairs(group) do
      if e[1].Parent then M.set(e[1], e[2], 1) end
    end
  end
  self._cascadeSeq = M.seq(tab._cascadeParts, function(group)
    for _, e in ipairs(group) do
      if e[1].Parent then M.to(e[1], e[2], e[3], "base") end
    end
  end, { step = self.cascade, cap = 0.34 })
end

-- MOMENTUM ON RELEASE, because a window that stops dead the instant you let go
-- feels like a decal being repositioned rather than an object being moved. The
-- drag itself stays absolutely direct -- one-to-one with the cursor, no easing,
-- no lag, because anything else makes it feel broken -- and the glide happens
-- only after the button comes up.
--
-- The throw is measured from the last few frames of actual pointer motion, not
-- from the total drag, so flicking it and then pausing before release does
-- nothing: you get the momentum you were carrying at the moment you let go.
function Window:_drag()
  local dragging, startAbs, startOffset, startMouse
  local lastPos, lastT, vel = nil, nil, Vector2.new(0, 0)

  self.header.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
      or i.UserInputType == Enum.UserInputType.Touch then
      -- double click the header to maximise / restore
      local now = os.clock()
      if self._lastHeaderClick and now - self._lastHeaderClick < 0.32 then
        self._lastHeaderClick = nil
        self:maximise()
        return
      end
      self._lastHeaderClick = now
      dragging = true
      -- the shell is anchored at its centre, so its centre in screen pixels is
      startAbs = self.shell.AbsolutePosition + self.shell.AbsoluteSize / 2
      startOffset = Vector2.new(self.shell.Position.X.Offset,
                                self.shell.Position.Y.Offset)
      startMouse = i.Position
      lastPos, lastT, vel = i.Position, os.clock(), Vector2.new(0, 0)
      M.stop(self.shell, "Position")
    end
  end)

  L.hold(L.UIS.InputChanged:Connect(function(i)
    if not dragging then return end
    if i.UserInputType == Enum.UserInputType.MouseMovement
      or i.UserInputType == Enum.UserInputType.Touch then
      -- THE WHOLE DRAG LIVES IN REAL SCREEN PIXELS, AND CONVERTS ONCE AT THE END.
      --
      -- The window sits under a UIScale, so a Position OFFSET is in pre-scale
      local sc = (self.scaleObj and self.scaleObj.Scale) or 1
      local d = i.Position - startMouse
      local px, py = startAbs.X + d.X, startAbs.Y + d.Y

      -- the only rule left: keep a grabbable strip on screen, so the window can
      -- always be dragged back rather than lost off an edge
      local vp = L.viewport()
      local hw, hh = self.shell.AbsoluteSize.X / 2, self.shell.AbsoluteSize.Y / 2
      local KEEP = 90
      px = math.clamp(px, -hw + KEEP, vp.X + hw - KEEP)
      py = math.clamp(py, -hh + KEEP, vp.Y + hh - KEEP)

      -- carry the pointer's own speed, smoothed, so one stuttering frame does
      -- not decide the throw
      local now = os.clock()
      if lastPos and lastT and now > lastT then
        local dt = now - lastT
        if dt > 0.002 then
          local inst = Vector2.new((i.Position.X - lastPos.X) / dt,
                                   (i.Position.Y - lastPos.Y) / dt)
          vel = vel:Lerp(inst, 0.4)
          lastPos, lastT = i.Position, now
        end
      end

      M.stop(self.shell, "Position")
      self.shell.Position = UDim2.fromOffset(
        startOffset.X + (px - startAbs.X) / sc,
        startOffset.Y + (py - startAbs.Y) / sc)
    end
  end))

  L.hold(L.UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
      or i.UserInputType == Enum.UserInputType.Touch then
      if dragging then
        dragging = false

        -- GLIDE. A spring toward a point a fraction of a second ahead along the
        -- release velocity: overdamped, so it slides and settles rather than
        -- overshooting and bouncing back, which would read as elastic rather
        -- than heavy. Skipped entirely below a threshold so a careful
        -- repositioning lands exactly where it was put.
        local speed = vel.Magnitude
        if speed > 220 and L.Cfg and L.Cfg.data.dragGlide ~= false then
          local sc = (self.scaleObj and self.scaleObj.Scale) or 1
          local carry = math.clamp(speed / 4200, 0, 1) * 0.16
          local vp = L.viewport()
          local hw = self.shell.AbsoluteSize.X / 2
          local hh = self.shell.AbsoluteSize.Y / 2
          local KEEP = 90
          local absNow = self.shell.AbsolutePosition + self.shell.AbsoluteSize / 2
          local tx = math.clamp(absNow.X + vel.X * carry, -hw + KEEP, vp.X + hw - KEEP)
          local ty = math.clamp(absNow.Y + vel.Y * carry, -hh + KEEP, vp.Y + hh - KEEP)
          local cur = self.shell.Position
          M.to(self.shell, "Position", UDim2.fromOffset(
            cur.X.Offset + (tx - absNow.X) / sc,
            cur.Y.Offset + (ty - absNow.Y) / sc), "gentle")
          M.after(0.42, function() self:_saveGeom() end)
        else
          self:_saveGeom()
        end
        vel = Vector2.new(0, 0)
      end
    end
  end))
end

-- ---------------------------------------------------------------- resize

function Window:_resize()
  local grip = mk("Frame", {
    AnchorPoint = Vector2.new(1, 1),
    Position = UDim2.new(1, -3, 1, -3),
    Size = UDim2.fromOffset(18, 18),
    BackgroundTransparency = 1, ZIndex = 20,
    Name = "Grip", Parent = self.root,
  })
  -- three short diagonals, the universal resize affordance
  for i = 0, 2 do
    local bar = mk("Frame", {
      AnchorPoint = Vector2.new(1, 1),
      Position = UDim2.new(1, -i * 5, 1, 0),
      Size = UDim2.fromOffset(1, 12 - i * 4),
      Rotation = 45,
      BackgroundColor3 = T.c.textOff, BorderSizePixel = 0,
      ZIndex = 21, Parent = grip,
    })
    local _ = bar
  end
  local hit = mk("TextButton", {
    Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "",
    AutoButtonColor = false, ZIndex = 22, Parent = grip,
  })
  self.grip = grip

  local sizing, startSize, startMouse
  hit.MouseButton1Down:Connect(function()
    sizing = true
    startSize = self.root.Size
    startMouse = L.UIS:GetMouseLocation()
    M.to(grip, "BackgroundTransparency", 1, "instant")
  end)

  L.hold(L.UIS.InputChanged:Connect(function(i)
    if not sizing then return end
    if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end
    local m = L.UIS:GetMouseLocation()
    local sc = (self.scaleObj and self.scaleObj.Scale) or 1
    local vp = L.viewport()
    -- the drag happens in screen pixels; the size is authored in unscaled units,
    local dw = (m.X - startMouse.X) / sc
    local dh = (m.Y - startMouse.Y) / sc
    local w = math.clamp(startSize.X.Offset + dw * 2, self.minW, (vp.X - 24) / sc)
    local h = math.clamp(startSize.Y.Offset + dh * 2, self.minH, (vp.Y - 24) / sc)
    self.width, self.height = math.floor(w), math.floor(h)
    self.root.Size = UDim2.fromOffset(self.width, self.height)
    self.shell.Size = UDim2.fromOffset(self.width, self.height)
    M.stop(self.root, "Size")
  end))

  L.hold(L.UIS.InputEnded:Connect(function(i)
    if (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) and sizing then
      sizing = false
      self:_saveGeom()
    end
  end))
end

function Window:maximise()
  local vp = L.viewport()
  local sc = (self.scaleObj and self.scaleObj.Scale) or 1
  if self._maxed then
    local g = self._preMax
    if g then
      M.to(self.root, "Size", UDim2.fromOffset(g.w, g.h), "slow")
      M.to(self.shell, "Position", g.pos, "slow")
      self.shell.Size = UDim2.fromOffset(g.w, g.h)
      self.width, self.height = g.w, g.h
    end
    self._maxed = false
  else
    self._preMax = { w = self.width, h = self.height, pos = self.shell.Position }
    local w = math.floor((vp.X - 48) / sc)
    local h = math.floor((vp.Y - 48) / sc)
    self.width, self.height = w, h
    M.to(self.root, "Size", UDim2.fromOffset(w, h), "slow")
    M.to(self.shell, "Position", UDim2.fromScale(0.5, 0.5), "slow")
    self.shell.Size = UDim2.fromOffset(w, h)
    self._maxed = true
  end
  task.delay(0.5, function() if L.live() then self:_saveGeom() end end)
  return self._maxed
end

function Window:_pointerInside()
  -- INSET-EXCLUDED, to match AbsolutePosition. This used to read
  -- GetMouseLocation, which is the inset-INCLUDED value, so the test was 58 px
  -- out -- the window counted the pointer as inside while it was still above
  -- the title bar, and stopped counting it 58 px before the bottom edge.
  local m = L.pointer()
  local p, sz = self.root.AbsolutePosition, self.root.AbsoluteSize
  return m.X >= p.X and m.X <= p.X + sz.X and m.Y >= p.Y and m.Y <= p.Y + sz.Y
end

function Window:_hotkeys(key)
  self.toggleKey = key or (L.Cfg and L.Cfg.keyCode()) or Enum.KeyCode.RightControl
  local NUM = {
    [Enum.KeyCode.One] = 1, [Enum.KeyCode.Two] = 2, [Enum.KeyCode.Three] = 3,
    [Enum.KeyCode.Four] = 4, [Enum.KeyCode.Five] = 5, [Enum.KeyCode.Six] = 6,
  }
  L.hold(L.UIS.InputBegan:Connect(function(i, typing)
    if typing or not L.live() then return end
    if i.KeyCode == self.toggleKey then self:toggle() return end
    -- ONLY WHILE THE POINTER IS OVER THE WINDOW. 1-5 is the Roblox tool hotbar;
    -- binding them globally means every weapon swap in a game also changes tab.
    local n = NUM[i.KeyCode]
    if n and not self.hidden and self.tabs[n] and self:_pointerInside() then
      self:select(n)
    end
  end))
end

end

do -- ==== lm_06_controls.lua ====
-- LUMEN :: CONTROLS
-- Toggle, slider, segmented, dropdown, keybind, input, buttons, log view.
--
-- Every control is the same row shape, so a new one inherits the right padding,
-- hover feel and disabled state for free.
--
-- A control never claims a state it did not reach: if its callback throws or
-- returns false, it puts itself back.

local L = getgenv().LUMEN
local T, M, A = L.T, L.Motion, L.A
local mk = L.mk

local C = {}
L.C = C

-- EVERY OPEN POPOVER, SO SOMETHING ELSE CAN SHUT IT.
--
-- Leaving a tab used to destroy the overlay's children directly, which removed
-- the menu from the screen but left the dropdown that owned it still believing
-- it was open -- so the next click on it ran the close path against a destroyed
-- frame and did nothing visible. The control looked dead until you clicked it
-- twice. Closing through the owner keeps the state and the pixels in agreement.
--
-- A plain list, pruned on use: weak keys cannot track this, because the frame is
-- an Instance held by the Roblox tree and would be collected out from under us.
C._pops = {}

-- Controls by their persistence id, so anything that changes a setting from
-- outside its own row can move the visible control too. Theme.setMotion has
-- called C.find since it was written and it has never existed, so that call has
-- been silently doing nothing -- which is how a dropdown ends up showing a
-- profile that is not the one running.
-- STRONG VALUES, PRUNED BY FRAME LIVENESS. Weak values could never work here:
-- every register() call site is fire-and-forget, so nothing else in Lua holds
-- the api and the collector took live controls at random.
C._reg = {}
C._regN = 0

-- The L._insts test from L.prune, applied to the frame each api carries.
function C.prune()
  local kept, n = {}, 0
  for id, h in pairs(C._reg) do
    local ok, parent = pcall(function() return h.frame and h.frame.Parent end)
    if ok and parent ~= nil then kept[id] = h n = n + 1 end
  end
  C._reg, C._regN = kept, n
  return n
end

function C.find(id)
  local h = C._reg[id]
  if h and h.frame and h.frame.Parent then return h end
  if h then C._reg[id] = nil C._regN = C._regN - 1 end
  return nil
end

local function register(opts, api)
  if not (opts and api) then return api end

  -- THE CONTRACT GOES ON EVERY CONTROL, not the one that happened to get it.
  -- register is the last line of every constructor, so the api is finished and
  -- the frame exists -- nothing else in this file is true of all of them. It
  -- sits above the id check on purpose: a control with no id still gets to be
  -- disabled and to declare a dependency.
  if api.frame and not api.setEnabled then
    api._label = api._label or opts.text or opts._id
    api.setEnabled = function(on, why)
      if api._ix then api._ix.setEnabled(on) end
      C.setEnabled(api, on, why)
    end
    C.dependent(api, opts)
  end

  -- Controls that never persist have no _id. Derive the id bindPersist would
  -- have used rather than leaving them unfindable, but do NOT write it back:
  -- C.pinnable reads opts._id as permission to persist a pin.
  local id = opts._id or (C.autoId and C.autoId(opts))
  if not id then return api end
  if C._reg[id] == nil then
    C._regN = C._regN + 1
    -- A rebuild re-registers the same ids, so growth past the watermark means
    -- genuinely new ones; sweep the retired generation instead of carrying it.
    if C._regN > 256 then C.prune() end
  end
  C._reg[id] = api
  return api
end

-- teardown destroys the frames; the table would otherwise outlive them
L.cleanup(function() C._reg, C._regN = {}, 0 end)

function C.closePopovers(instant)
  local kept = {}
  for _, p in ipairs(C._pops) do
    if p.frame and p.frame.Parent then
      kept[#kept + 1] = p
      L.try("popover.close", p.close, instant)
    end
  end
  C._pops = kept
  return #kept
end

-- read at construction, not captured at load -- see T.px
local function ROWH() return T.px("row") end

-- Register a control as a keyboard focus stop. Order of registration is order of
-- construction, which is top-to-bottom on the page, so Tab already moves the way
-- the eye does without anyone maintaining a tab-index.
--
-- A CONTROL WITH NO KEYBOARD BEHAVIOUR IS NOT A STOP. Tabbing onto something
-- that ignores every key is worse than skipping it: the ring stops somewhere
-- inert and the keyboard appears to have broken.
local function focusable(frame, spec)
  if not L.Focus or not frame then return nil end
  return L.Focus.register(frame, spec)
end

-- ---------------------------------------------------------------- scaffolding

local function row(parent, opts)
  local f = A.surface({
    Parent = parent, elev = 1, radius = T.r.md, sheen = true,
    Size = UDim2.new(1, 0, 0, opts.height or ROWH()),
    Name = "Row",
  })
  f.AutomaticSize = opts.grow and Enum.AutomaticSize.Y or Enum.AutomaticSize.None

  local hasDesc = opts.desc and opts.desc ~= ""
  A.text({
    Text = opts.text or "",
    font = T.font.medium, size = T.size.body, colour = T.c.text,
    Position = UDim2.fromOffset(12, hasDesc and 7 or 0),
    Size = hasDesc and UDim2.new(1, -(opts.rightRoom or 80), 0, 15)
                   or UDim2.new(1, -(opts.rightRoom or 80), 1, 0),
    truncate = true, Parent = f,
  })
  if hasDesc then
    A.text({
      Text = opts.desc,
      font = T.font.body, size = T.size.micro, colour = T.c.textMute,
      Position = UDim2.fromOffset(12, 23),
      Size = UDim2.new(1, -(opts.rightRoom or 80), 0, 13),
      truncate = true, Parent = f,
    })
  end
  -- Self-registration. The control does not know or care which tab it is in --
  -- the palette walks up from this frame when it needs to know, so moving a
  -- control between tabs never leaves a stale entry behind.
  if L.Palette and opts.text then
    L.Palette.add(f, opts.text, opts.desc or "")
  end
  return f
end

-- ---------------------------------------------------------------- static

-- ---------------------------------------------------------------- persistence
--
-- EVERY CONTROL SAVES ITSELF. Before this, a setting survived a reload only if
-- somebody had also declared it in Cfg.SCHEMA by hand -- which covered the
-- twenty interface preferences and none of the hundred-odd controls in the
-- feature tabs. Aim FOV, hitbox size, fling power, every dropdown: rebuilt from
-- source defaults on every execute.
--
-- Rather than add an id to a hundred call sites, the id is derived from where
-- the control sits: the owning module sets a context with C.ctx, C.section
-- tracks the group, and the control's own label finishes it -- "combat.fling.
-- Launch power". Stable across rebuilds because all three come from source, and
-- unique because no two controls in one section share a label. An explicit
-- opts.id always wins if a call site wants to pin one down.
C._ctx, C._section = "hub", ""

-- id -> the default the SOURCE gave the control. Rebuilt at construction every
-- execute, never stored: a saved default outlives the code that changed it, and
-- a stale default is worse than none -- it makes a wrong value look correct.
C._def = {}

function C.ctx(name)
  C._ctx = tostring(name or "hub")
  C._section = ""
  return C
end

local function autoId(opts)
  if type(opts.id) == "string" and opts.id ~= "" then return opts.id end
  local label = opts.text or opts.placeholder
  if type(label) ~= "string" or label == "" then return nil end
  return C._ctx .. "." .. C._section .. "." .. label
end

-- Resolves the saved value into opts.default and wraps opts.callback so the new
-- value is written back. Mutating opts is deliberate: every call site builds it
-- inline, and the alternative is threading two return values through six
-- constructors that each read opts.default in several places.
local function bindPersist(opts)
  if opts.persist == false then return end
  local Cfg = L.Cfg
  if not (Cfg and Cfg.feat and Cfg.setFeat) then return end
  local id = autoId(opts)
  if not id then return end
  opts._id = id

  -- THE CONTROL IS THE SCHEMA. Everything needed to validate this id is already
  -- in opts -- it is the same data the constructor below builds the widget from.
  -- Harvesting it here rather than declaring it in lm_15 is the difference
  -- between 104 declarations somebody maintains and none. The fallbacks match
  -- C.slider's own, so a spec can never be tighter than the control it describes.
  if Cfg.declare then
    local spec
    if type(opts.min) == "number" or type(opts.max) == "number" then
      spec = { t = "number", min = opts.min or 0, max = opts.max or 100 }
    elseif type(opts.items) == "table" and opts.items[1] ~= nil then
      local set, ok = {}, true
      for _, it in ipairs(opts.items) do
        if type(it) == "string" then set[it] = true else ok = false end
      end
      -- a control's own default is legal by definition, even if a call site
      -- forgot to put it in the list
      if ok then
        if type(opts.default) == "string" then set[opts.default] = true end
        spec = { t = "string", enum = set }
      end
    else
      local d = type(opts.default)
      if d == "boolean" or d == "string" or d == "number" then spec = { t = d } end
    end
    if spec then Cfg.declare(id, spec) end
  end

  local sourceDefault = opts.default
  -- THE ONE MOMENT id -> default EXISTS. opts.default becomes the saved value
  -- below and the source fact is gone for the rest of the session.
  if sourceDefault ~= nil then C._def[id] = sourceDefault end
  local saved = Cfg.feat(id, nil)
  local restored

  -- only accept a stored value of the same shape the control expects, so a
  -- hand-edited file cannot hand a slider a string
  if saved ~= nil and (sourceDefault == nil or type(saved) == type(sourceDefault)) then
    -- A STORED **ON** IS REMEMBERED BUT NOT RE-APPLIED. See Cfg.ARM_SAFE: the
    -- only booleans that come back armed are the ones that cannot act on their
    -- own (appearance sub-options, anti-AFK). Everything else starts off, so
    -- executing the hub never leaves something already running.
    --
    -- Numbers, strings and a stored `false` skip this entirely -- a slider
    -- cannot switch anything on by itself, and restoring an OFF is a no-op.
    local allowed = true
    if Cfg.NO_APPLY and Cfg.NO_APPLY[id] then
      -- A number that writes straight to the character. Same surprise as a
      -- switch coming back on, so it gets the same answer.
      allowed = false
    elseif type(saved) == "boolean" and saved and Cfg.restorable then
      allowed = Cfg.restorable(id)
    end
    if allowed then
      opts.default = saved
      restored = saved
    end
  end

  -- LIVE VALUES, NOT THE STORE, are what opts.when reads -- ARM_SAFE above can
  -- leave disk holding a `true` for a switch that came back off. Notifying here
  -- is also what covers a dependency built AFTER its dependent.
  C._live[id] = opts.default
  C.notify(id)

  local cb = opts.callback

  -- ANYTHING THAT CAME BACK ARMED GETS RECORDED. Restoring switched-on features
  -- is only reasonable if the operator can see what was restored and undo it in
  -- one click; without that it is the old silent-rearm bug with better
  -- intentions. The ledger is what buys the denylist in lm_15_config.
  if restored == true and Cfg.noteRestored then
    Cfg.noteRestored(id, restored, cb)
  end

  opts.callback = function(v)
    local r, why
    if cb then r, why = cb(v) end
    -- C.toggle reverts on an explicit false, so a refused change must not be
    -- the one that gets written to disk
    if r ~= false then
      Cfg.setFeat(id, v)
      if C._live[id] ~= v then C._live[id] = v C.notify(id) end
    end
    return r
  end

  -- RESTORING THE KNOB IS NOT RESTORING THE SETTING. The control now shows the
  -- saved value, but the feature module still holds whatever its source default
  -- was -- so the panel would read 7250 while the engine used 3000, which is
  -- worse than not saving at all. Push it through the original callback once,
  -- deferred so the page has finished building first, and using `cb` rather
  -- than the wrapper so restoring does not write the value straight back.
  if restored ~= nil and restored ~= sourceDefault and cb then
    task.defer(function() L.try("cfg.restore", cb, restored) end)
  end
end

C.bindPersist = bindPersist
C.autoId = autoId

-- A refusal is an answer, not a crash. `false[, why]` back from a callback means
-- the feature declined, so the control has to put the visible value back --
-- otherwise the knob, the disk and the engine hold three different numbers and
-- the next launch looks like the hub lost the setting. Returns ok, why.
local function commitValue(kind, opts, v, quiet)
  if not opts.callback then return true end
  local label = kind .. ":" .. tostring(opts.text or opts.placeholder or "?")
  local ran, res, why = L.try(label, opts.callback, v)
  if ran and res ~= false then return true end
  why = why or (ran and "Did not engage." or "Threw while applying.")
  if ran then L.log("refused", label, why) end   -- refused, not broken: fault log stays clean
  if not quiet and L.Toast then
    L.Toast.warn(tostring(opts.text or "Setting"), tostring(why))
  end
  return false, why
end

C.commitValue = commitValue

-- ------------------------------------------------------- enabled + dependency
--
-- ONE VEIL RATHER THAN FIFTEEN DISABLED PATHS. A.interactive returns a
-- setEnabled, but it reaches exactly one constructor; the other fourteen bury
-- their input in track, pill, popover and TextBox children that share no shape.
-- A scrim parented to the row sits above all of them.
--
-- Transparency, not a new colour token: a T.c.disabled would have to be painted
-- on every label, knob, stroke and gradient inside each control -- six
-- instances in the slider alone -- which is the per-constructor work this is
-- meant to delete, and lm_16_theme would need a swap entry for it. A scrim in
-- the page ground colour washes the whole row at once and follows any theme.
local VEIL_A = 0.42

function C.setEnabled(api, on, why)
  local f = api and api.frame
  if not f then return end
  on = on and true or false
  api._why = (not on) and (why or "Not available yet.") or nil

  local v = f:FindFirstChild("Veil")
  if on and not v then return end
  if not v then
    -- clear of A.interactive's Hit overlay at frame.ZIndex + 5 and the content
    -- lift at + 6; under Sibling behaviour it cannot escape its own row
    v = mk("TextButton", {
      Name = "Veil", Text = "", AutoButtonColor = false, Active = true,
      Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.c.surface,
      BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false,
      ZIndex = (f.ZIndex or 1) + 20, Parent = f,
    })
    local rc = f:FindFirstChildOfClass("UICorner")
    mk("UICorner", {
      CornerRadius = rc and rc.CornerRadius or UDim.new(0, T.r.md), Parent = v,
    })
    -- SAY WHY ON HOVER, TOAST IT ON CLICK: the segmented locked pattern, the
    -- only unavailable state in this library nobody reads as a bug. A.explain
    -- freezes its text, so keep the hint entry to retarget it.
    A.explain(v, api._why or "Not available yet.", tostring(api._label or ""))
    api._hint = A.hints[#A.hints]
    v.MouseButton1Click:Connect(function()
      if L.Toast then
        L.Toast.info(tostring(api._label or "Unavailable"),
                     tostring(api._why or "Not available yet."))
      end
    end)
  end
  if api._hint then api._hint.text = api._why or "Not available yet." end

  f:SetAttribute("lmDisabled", (not on) or nil)
  -- a fully transparent GuiButton still eats clicks, so enabling hides it
  -- rather than fading it out
  if on then
    v.Visible = false
    M.set(v, "BackgroundTransparency", 1)
  elseif not v.Visible then
    M.set(v, "BackgroundTransparency", 1)
    v.Visible = true
    M.to(v, "BackgroundTransparency", VEIL_A, "fast")
  end
end

-- opts.when: what a control needs before it means anything. A string is a
-- bindPersist auto-id ("combat.aim.Aim assist"); a function is called as-is.
-- Declared once at the call site instead of a setEnabled fan-out hand-written
-- into every owning module's callback.
C._deps, C._any, C._live = {}, {}, {}

local function met(when)
  if type(when) == "function" then
    local ok, val = pcall(when)
    return ok and val ~= nil and val ~= false
  end
  -- NOT Cfg.feat: ARM_SAFE can leave the store holding a `true` for a switch
  -- that deliberately came back off, and a dependent follows the knob. A
  -- numeric id is satisfied by 0, so point `when` at a toggle.
  local val = C._live[when]
  return val ~= nil and val ~= false
end

local function applyDep(e)
  local f = e.api.frame
  if not (f and f.Parent) then return false end     -- rebuilt page: drop it
  e.api.setEnabled(met(e.when), e.why)
  return true
end

local function sweepAny()
  for i = #C._any, 1, -1 do
    if not applyDep(C._any[i]) then table.remove(C._any, i) end
  end
end

function C.notify(id)
  local list = C._deps[id]
  if list then
    for i = #list, 1, -1 do
      if not applyDep(list[i]) then table.remove(list, i) end
    end
  end
  -- A function dependency cannot be keyed by id, so it is re-read on any
  -- change -- at most once a frame, or dragging a slider would run every
  -- predicate in the hub sixty times a second.
  if #C._any > 0 and not C._anyQueued then
    C._anyQueued = true
    task.defer(function() C._anyQueued = false sweepAny() end)
  end
end

function C.dependent(api, opts)
  local w = opts.when
  if w == nil then return end
  local e = {
    api = api, when = w,
    why = opts.whyDisabled or (type(w) == "string"
      and ("Turn on " .. (string.match(w, "[^.]+$") or w) .. " first.")
      or "Not available yet."),
  }
  if type(w) == "string" then
    local l = C._deps[w]
    if not l then l = {} C._deps[w] = l end
    l[#l + 1] = e
  else
    C._any[#C._any + 1] = e
  end
  applyDep(e)                    -- the state at construction, before first paint
end

-- ---------------------------------------------------------------- pinnable
--
-- Registers a built control with L.Pins and makes the row itself the pin
-- affordance: RIGHT-CLICK ANY ROW TO PIN IT. A dedicated pin glyph on every
-- control would have to be drawn, positioned and kept clear of the value
-- readout on six different row layouts; the secondary click is already unused
-- everywhere in the hub and costs one connection.
function C.pinnable(frame, opts, spec)
  local id = opts._id
  if not (id and L.Pins and frame) then return end
  spec.label = opts.text or id
  spec.ctx = C._ctx
  L.Pins.register(id, spec)

  local btn = frame:FindFirstChild("Hit")
  if not btn then return end
  btn.MouseButton2Click:Connect(function()
    local Cfg = L.Cfg
    if not (Cfg and Cfg.setPin) then return end
    local now = Cfg.pinned(id)
    Cfg.setPin(id, not now)
    if L.Toast then
      L.Toast.info(now and "Unpinned" or "Pinned",
        tostring(opts.text or id) ..
        (now and " removed from the dock." or " added to the dock strip."))
    end
  end)
end

-- `shown` overrides only what is PAINTED. `text` still sets C._section, which
-- is half of every id underneath, so a section can be relabelled or moved to
-- another tab without orphaning a single saved value.
function C.section(parent, text, shown)
  C._section = tostring(text or "")
  local h = mk("Frame", {
    Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1,
    Name = "Section", Parent = parent,
  })
  A.text({
    Text = L.track(string.upper(shown or text or ""), 1),
    font = T.font.medium, size = T.size.nano, colour = T.c.textOff,
    Position = UDim2.fromOffset(2, 12), Size = UDim2.new(1, -4, 0, 14),
    Parent = h,
  })
  return h
end

function C.paragraph(parent, text)
  local f = A.surface({
    Parent = parent, elev = 1, radius = T.r.md,
    Size = UDim2.new(1, 0, 0, 0), Name = "Paragraph",
  })
  f.AutomaticSize = Enum.AutomaticSize.Y
  L.pad(12, 12, 12, 12, f)
  A.text({
    Text = text or "", wrap = true,
    font = T.font.body, size = T.size.label, colour = T.c.textDim,
    valign = Enum.TextYAlignment.Top,
    Size = UDim2.new(1, 0, 0, 0), autoSize = Enum.AutomaticSize.Y,
    Parent = f,
  })
  return f
end

-- ---------------------------------------------------------------- tiles
--
-- A row of small metric cards. Numbers get the mono face and the accent; their
-- captions get the muted face. Keeping the figure and its label in different
-- weights is what lets the eye read a row of these at a glance instead of
-- parsing each one.
function C.tiles(parent, items, opts)
  opts = opts or {}
  local n = math.max(#items, 1)
  local holder = mk("Frame", {
    Size = UDim2.new(1, 0, 0, opts.height or 62),
    BackgroundTransparency = 1, Name = "Tiles", Parent = parent,
  })
  local gap = T.gap.md
  local layout = L.list(gap, Enum.FillDirection.Horizontal, holder)
  layout.VerticalAlignment = Enum.VerticalAlignment.Center

  local api = { frame = holder, cells = {} }
  for i, item in ipairs(items) do
    local cell = A.surface({
      Parent = holder, elev = 1, radius = T.r.md, sheen = true,
      -- width is scale-based minus its share of the gaps, so the row fills
      -- exactly regardless of how many tiles are passed
      Size = UDim2.new(1 / n, -(gap * (n - 1)) / n, 1, 0),
      Name = "Tile", LayoutOrder = i,
    })
    A.text({
      Text = string.upper(item.label or ""),
      font = T.font.medium, size = T.size.tiny, colour = T.c.textOff,
      Position = UDim2.fromOffset(12, 12), Size = UDim2.new(1, -24, 0, 12),
      truncate = true, Parent = cell,
    })
    local val = A.text({
      Text = tostring(item.value or "-"),
      font = T.font.mono, size = T.size.head,
      colour = item.colour or T.c.accent,
      Position = UDim2.fromOffset(12, 28), Size = UDim2.new(1, -24, 0, 18),
      truncate = true, Parent = cell,
    })
    api.cells[item.key or i] = val
  end

  -- ROLL THE NUMBER rather than swapping it. A figure that jumps reads as a
  -- readout being overwritten; one that travels reads as a value changing.
  --
  -- Only plain "number" or "number unit" rolls. "29/35" and "0:24" are two
  -- numbers and a clock -- interpolating either produces nonsense on the way.
  local rolls = {}

  function api:set(key, text, colour)
    local lbl = self.cells[key]
    if not lbl then return end
    if colour then M.to(lbl, "TextColor3", colour, "fast") end
    text = tostring(text)

    local num, unit = text:match("^%s*(%-?%d+)%s*(%a*)%s*$")
    if not L.Cfg or L.Cfg.data.rollNumbers == false or not num then
      rolls[key] = nil
      lbl.Text = text
      return
    end
    local target = tonumber(num)
    local r = rolls[key]
    if not r then
      -- first value is not a change, so it appears rather than counting up
      rolls[key] = { spring = L.Spring.new(0.55, -0.2, target), unit = unit, lbl = lbl }
      lbl.Text = text
      return
    end
    r.unit, r.lbl = unit, lbl
    r.spring:to(target)
  end

  task.spawn(function()
    while L.live() and holder.Parent do
      local dt = L.RunService.Heartbeat:Wait()
      for _, r in pairs(rolls) do
        if not r.spring:settled(0.5, 2) then
          local v = r.spring:step(dt)
          r.lbl.Text = string.format("%d%s%s", v + 0.5,
                                     r.unit ~= "" and " " or "", r.unit)
        end
      end
    end
  end)

  return api
end

-- ---------------------------------------------------------------- actions
--
-- A row of small pills, not a stack of full-width bars. A button that spans the
-- whole column reads as the most important thing on the page; three of them
-- stacked read as a page made entirely of alarms. The reference uses compact
-- pills for exactly this reason -- weight is spent on the one primary action and
-- nothing else.
function C.actions(parent, items)
  local holder = mk("Frame", {
    Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1,
    Name = "Actions", Parent = parent,
  })
  local lay = L.list(T.gap.sm, Enum.FillDirection.Horizontal, holder)
  lay.VerticalAlignment = Enum.VerticalAlignment.Center

  local api = { frame = holder }
  for i, item in ipairs(items) do
    -- width follows the label: TextBounds after a frame, so the pill hugs its
    -- text instead of every action being the same arbitrary size
    local w = 22 + #tostring(item.text) * 7
    local f = A.surface({
      Parent = holder, elev = item.primary and 1 or 1, radius = T.r.pill,
      Size = UDim2.fromOffset(w, 32), Name = "Pill", LayoutOrder = i,
      fill = item.primary and T.c.accent or nil,
      line = not item.primary,
    })
    if item.primary then A.accentGradient(f, 100) end
    A.text({
      Text = item.text, font = T.font.medium, size = T.size.label,
      colour = item.primary and T.c.accentInk or T.c.textDim,
      align = Enum.TextXAlignment.Center, Parent = f,
    })
    A.interactive(f, {
      radius = T.r.pill,
      layerColour = item.primary and Color3.new(0, 0, 0) or Color3.new(1, 1, 1),
      hoverAlpha = item.primary and 0.9 or 0.95,
      pressAlpha = item.primary and 0.8 or 0.9,
      onClick = function() if item.callback then item.callback() end end,
    })
    -- each pill is its own stop: a row of three actions is three decisions
    focusable(f, {
      radius = T.r.pill, label = item.text,
      activate = function() if item.callback then item.callback() end end,
    })
    -- Buttons are pinnable too, which is most of the point: "Open player panel"
    -- is a thing you want one click away, and it is not a setting so nothing
    -- else in this file would ever have given it an id.
    C.pinnable(f, { _id = "action." .. C._ctx .. "." .. tostring(item.text),
                    text = item.text }, {
      kind = "action",
      run = function() if item.callback then item.callback() end end,
    })
  end
  return api
end

-- ---------------------------------------------------------------- button

function C.button(parent, opts)
  opts = opts or {}
  local f = A.surface({
    Parent = parent, elev = 1, radius = T.r.md,
    Size = UDim2.new(1, 0, 0, (opts.desc and opts.desc ~= "") and 48 or 38), Name = "Button",
    fill = opts.primary and T.c.accent or nil,
    line = not opts.primary,
  })
  if opts.primary then A.accentGradient(f, 90) end

  if opts.desc and opts.desc ~= "" then
    A.text({
      Text = opts.text or "Button",
      font = T.font.strong, size = T.size.body,
      colour = opts.primary and T.c.accentInk or T.c.text,
      align = Enum.TextXAlignment.Center,
      Position = UDim2.fromOffset(0, 7), Size = UDim2.new(1, 0, 0, 17),
      Parent = f,
    })
    A.text({
      Text = opts.desc,
      font = T.font.body, size = T.size.micro,
      colour = opts.primary and T.c.accentInk or T.c.textMute,
      align = Enum.TextXAlignment.Center,
      Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 14),
      truncate = true, Parent = f,
    })
  else
    A.text({
      Text = opts.text or "Button",
      font = T.font.strong, size = T.size.body,
      colour = opts.primary and T.c.accentInk or T.c.text,
      align = Enum.TextXAlignment.Center,
      Parent = f,
    })
  end

  local api = {}
  local ix = A.interactive(f, {
    radius = T.r.md,
    layerColour = opts.primary and Color3.new(0, 0, 0) or Color3.new(1, 1, 1),
    hoverAlpha = opts.primary and 0.9 or 0.95,
    pressAlpha = opts.primary and 0.8 or 0.90,
    onClick = function() if opts.callback then opts.callback() end end,
  })
  api.frame, api._ix = f, ix
  register(opts, api)
  focusable(f, {
    radius = T.r.md, label = opts.text,
    activate = function() if opts.callback then opts.callback() end end,
  })
  return api
end

-- ---------------------------------------------------------------- toggle

function C.toggle(parent, opts)
  opts = opts or {}
  bindPersist(opts)
  local state = opts.default and true or false
  local f = row(parent, { text = opts.text, desc = opts.desc, rightRoom = 68 })

  local track = mk("Frame", {
    AnchorPoint = Vector2.new(1, 0.5),
    Position = UDim2.new(1, -12, 0.5, 0),
    Size = UDim2.fromOffset(38, 21),
    BackgroundColor3 = T.c.active,
    BorderSizePixel = 0, ZIndex = 2,
    Parent = f,
  })
  L.corner(999, track)
  local trackStroke = L.stroke(T.c.lineStrong, 1, 0.4, track)

  -- The "on" state is a GRADIENT, not a flat accent. A UIGradient tints whatever
  -- BackgroundColor3 it sits on, so it cannot be faded in and out on the track
  -- itself without also dragging the off-state colour through it -- hence a
  -- separate fill layer whose transparency is what actually animates.
  local fill = mk("Frame", {
    Size = UDim2.fromScale(1, 1),
    BackgroundColor3 = Color3.new(1, 1, 1),
    BackgroundTransparency = 1,
    BorderSizePixel = 0, ZIndex = 2, Parent = track,
  })
  L.corner(999, fill)
  A.accentGradient(fill, 0)

  local knob = mk("Frame", {
    AnchorPoint = Vector2.new(0, 0.5),
    Position = UDim2.new(0, 3, 0.5, 0),
    Size = UDim2.fromOffset(15, 15),
    BackgroundColor3 = T.c.textDim,
    BorderSizePixel = 0, ZIndex = 3,
    Parent = track,
  })
  L.corner(999, knob)

  local api = {}
  local function paint(immediate)
    local tok = immediate and nil or "fast"
    local pos = UDim2.new(0, state and 20 or 3, 0.5, 0)
    local setter = immediate and M.set or M.to
    setter(knob, "Position", pos, tok)
    setter(fill, "BackgroundTransparency", state and 0 or 1, tok)
    setter(knob, "BackgroundColor3", state and T.c.accentInk or T.c.textDim, tok)
    setter(trackStroke, "Transparency", state and 1 or 0.4, tok)
  end

  -- A CONTROL MAY NOT CLAIM A STATE IT NEVER REACHED. This used to paint the new
  -- state and fire the callback with no interest in the answer, so a feature
  function api:set(v, silent)
    v = v and true or false
    if v == state then return end
    state = v
    paint(false)
    if silent or not opts.callback then return end

    -- labelled with the control's own text: "toggle.cb" in a fault list tells
    -- you a toggle broke but not which one, which is barely better than silence
    local label = "toggle:" .. tostring(opts.text or "?")
    local ran, res, why = L.try(label, opts.callback, state)
    if ran and res ~= false then return end

    state = not state
    paint(false)
    if ran then                       -- refused, not broken: the fault log stays clean
      L.log("refused", label, why or "did not engage")
    end
    if L.Toast and state == false then
      L.Toast.warn(tostring(opts.text or "Feature"),
                   tostring(why or (ran and "Did not engage." or "Threw while starting.")))
    end
  end
  function api:get() return state end

  A.interactive(f, { radius = T.r.md, onClick = function() api:set(not state) end })
  -- Enter flips it; Left and Right set it outright, so a keyboard user can force
  -- a known state instead of toggling and having to look to find out which way
  -- it went.
  focusable(f, {
    radius = T.r.md, label = opts.text,
    activate = function() api:set(not state) end,
    adjust = function(dir) api:set(dir > 0) end,
  })
  paint(true)
  api.frame = f
  register(opts, api)
  -- pinnable: the strip drives THIS api, so a pinned switch and the switch in
  -- the tab are one object and cannot drift apart
  C.pinnable(f, opts, {
    kind = "toggle",
    get = function() return api:get() end,
    set = function(v) api:set(v) end,
  })
  return api
end

-- ---------------------------------------------------------------- segmented

-- Three or four mutually exclusive choices, all visible at once. A dropdown
-- hides the options behind a click and gives no sense of where the current one
-- sits in the range; a segmented control shows the whole scale.
function C.segmented(parent, opts)
  opts = opts or {}
  bindPersist(opts)
  local items = opts.items or {}
  local value = opts.default or items[1]

  -- CELLS ARE MEASURED, NOT ASSUMED. Every cell used to be exactly 54 px wide
  -- and the bar 38 + n*54, both independent of what the labels actually said.
  -- That fitted "Calm" and "Default" and clipped "Comfortable" to "Comfortab"
  -- while the selected pill overhung the panel edge -- and the control it broke
  -- was Density, which is itself the thing that changes text size. The one
  -- control most able to invalidate a hardcoded width was the one relying on it.
  local CELL_PAD, GAP, BAR_PAD, MIN_CELL = 16, 3, 3, 44
  local TextService = game:GetService("TextService")
  local function widthOf(s)
    local ok, sz = pcall(function()
      return TextService:GetTextSize(s, T.size.micro, T.font.medium,
                                     Vector2.new(4096, 100))
    end)
    if ok and sz then return math.ceil(sz.X) end
    return #s * math.ceil(T.size.micro * 0.62)      -- generous, so it clips last
  end

  local widths, total = {}, 0
  for i, item in ipairs(items) do
    widths[i] = math.max(widthOf(tostring(item)) + CELL_PAD, MIN_CELL)
    total = total + widths[i]
  end
  local barW = total + GAP * math.max(#items - 1, 0) + BAR_PAD * 2

  -- the row reserves what the bar actually needs, so a long option pushes the
  local f = row(parent, { text = opts.text, desc = opts.desc, rightRoom = barW + 24 })

  local bar = mk("Frame", {
    AnchorPoint = Vector2.new(1, 0.5),
    Position = UDim2.new(1, -12, 0.5, 0),
    Size = UDim2.fromOffset(barW, 26),
    BackgroundColor3 = T.c.overlay, BorderSizePixel = 0, ZIndex = 2, Parent = f,
  })
  L.corner(T.r.sm + 2, bar)
  L.stroke(T.c.line, 1, 0.35, bar)
  L.pad(3, 3, 3, 3, bar)
  local lay = L.list(3, Enum.FillDirection.Horizontal, bar)
  lay.VerticalAlignment = Enum.VerticalAlignment.Center

  local api, cells = {}, {}
  local function paint()
    for _, c in ipairs(cells) do
      local on = (c.value == value)
      M.to(c.pill, "BackgroundTransparency", on and 0 or 1, "fast")
      M.to(c.label, "TextColor3",
        on and T.c.accentInk
        or (c.locked and T.c.textOff or T.c.textMute), "fast")
    end
  end

  for i, item in ipairs(items) do
    local cell = mk("Frame", {
      Size = UDim2.fromOffset(widths[i], 20), BackgroundTransparency = 1,
      LayoutOrder = i, ZIndex = 3, Parent = bar,
    })
    local pill = mk("Frame", {
      Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.c.accent,
      BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 3, Parent = cell,
    })
    L.corner(T.r.sm, pill)
    A.accentGradient(pill, 135)
    local lbl = A.text({
      Text = tostring(item), font = T.font.medium, size = T.size.micro,
      colour = T.c.textMute, align = Enum.TextXAlignment.Center,
      ZIndex = 4, Parent = cell,
    })
    -- A LOCKED OPTION STILL HAS TO SAY WHY, or it reads as a bug.
    --
    -- Hiding an option the user has already seen is worse than showing it
    -- unavailable: they go looking for the thing that vanished. So it stays in
    -- the bar, visibly out of reach, and says what it is waiting for the moment
    -- the pointer touches it.
    local why = opts.locked and opts.locked[item]
    if why then
      A.explain(cell, why, tostring(item))
      A.interactive(cell, { radius = T.r.sm, hoverAlpha = 0.97, spot = false,
        onClick = function()
          L.Toast.info(tostring(item), why)
        end })
    else
      A.interactive(cell, { radius = T.r.sm, hoverAlpha = 0.95,
        onClick = function() api:set(item) end })
    end
    cells[#cells + 1] = { pill = pill, label = lbl, value = item, locked = why }
  end

  function api:set(v, silent)
    if v == value then return end
    local prev = value
    value = v
    paint()
    if silent then return end
    if not commitValue("segmented", opts, v) then
      value = prev
      paint()
    end
  end
  function api:get() return value end

  -- ONE STOP FOR THE WHOLE CONTROL, not one per cell. The cells are a single
  -- choice shown in full; making each its own stop would mean four Tab presses
  -- to cross one setting, and the ring would say "this option" when what is
  -- actually selected is the row.
  focusable(f, {
    radius = T.r.md, label = opts.text,
    adjust = function(dir)
      local i = 1
      for k, item in ipairs(items) do if item == value then i = k break end end
      -- step OVER locked options rather than stopping on one: arrowing into a
      -- dead end feels like the control broke
      local j = i
      repeat
        j = math.clamp(j + dir, 1, #items)
        if not (opts.locked and opts.locked[items[j]]) then api:set(items[j]) return end
      until j <= 1 or j >= #items
    end,
    activate = function()                       -- Enter cycles forward, wrapping
      local i = 1
      for k, item in ipairs(items) do if item == value then i = k break end end
      for step = 1, #items do
        local j = ((i - 1 + step) % #items) + 1
        if not (opts.locked and opts.locked[items[j]]) then api:set(items[j]) return end
      end
    end,
  })

  paint()
  api.frame = f
  register(opts, api)
  return api
end

-- ---------------------------------------------------------------- slider

function C.slider(parent, opts)
  opts = opts or {}
  bindPersist(opts)
  local min   = opts.min or 0
  local max   = opts.max or 100
  local step  = opts.step or 1
  local value = math.clamp(opts.default or min, min, max)

  local f = row(parent, { text = opts.text, desc = opts.desc,
                          rightRoom = 150, height = 50 })

  local readout = A.text({
    Text = "", font = T.font.mono, size = T.size.micro, colour = T.c.accent,
    align = Enum.TextXAlignment.Right,
    AnchorPoint = Vector2.new(1, 0),
    Position = UDim2.new(1, -12, 0, 8), Size = UDim2.fromOffset(60, 13),
    ZIndex = 2, Parent = f,
  })

  -- ---- typed entry ----------------------------------------------------
  --
  -- A SLIDER CANNOT EXPRESS AN EXACT NUMBER. Dragging to precisely 137 on a
  -- 16..250 track is roughly a one-pixel target, and the keyboard route added in
  -- Wave 3 is 121 key presses. The readout was already showing the value, so it
  -- becomes the place you can also type it -- the number and the field for the
  -- number are the same object, which is the only version nobody has to discover.
  local entry = mk("TextBox", {
    AnchorPoint = Vector2.new(1, 0),
    Position = UDim2.new(1, -12, 0, 4), Size = UDim2.fromOffset(64, 20),
    BackgroundColor3 = T.c.active, BackgroundTransparency = 1,
    Text = "", TextColor3 = T.c.accent, Font = T.font.mono,
    TextSize = T.size.micro, TextXAlignment = Enum.TextXAlignment.Right,
    ClearTextOnFocus = false, Visible = false, ZIndex = 4, Name = "Entry",
    Parent = f,
  })
  L.corner(T.r.sm, entry)
  L.pad(0, 6, 0, 6, entry)
  local entryStroke = L.stroke(T.c.accent, 1, 0.35, entry)

  local hitReadout = mk("TextButton", {
    AnchorPoint = Vector2.new(1, 0),
    Position = UDim2.new(1, -10, 0, 4), Size = UDim2.fromOffset(68, 20),
    BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
    ZIndex = 3, Name = "ReadoutHit", Parent = f,
  })

  local track = mk("Frame", {
    AnchorPoint = Vector2.new(1, 1),
    Position = UDim2.new(1, -12, 1, -12),
    Size = UDim2.fromOffset(132, 4),
    BackgroundColor3 = T.c.active,
    BorderSizePixel = 0, ZIndex = 2,
    Parent = f,
  })
  L.corner(999, track)

  local fill = mk("Frame", {
    Size = UDim2.fromScale(0, 1),
    BackgroundColor3 = T.c.accent,
    BorderSizePixel = 0, ZIndex = 3,
    Parent = track,
  })
  L.corner(999, fill)
  A.accentGradient(fill, 0)

  local knob = mk("Frame", {
    AnchorPoint = Vector2.new(0.5, 0.5),
    Position = UDim2.fromScale(0, 0.5),
    Size = UDim2.fromOffset(11, 11),
    BackgroundColor3 = T.c.text,
    BorderSizePixel = 0, ZIndex = 4,
    Parent = track,
  })
  L.corner(999, knob)

  local hit = mk("TextButton", {
    AnchorPoint = Vector2.new(0.5, 0.5),
    Position = UDim2.fromScale(0.5, 0.5),
    Size = UDim2.new(1, 20, 0, 22),
    BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
    ZIndex = 5, Parent = track,
  })

  -- ---- the curve ---------------------------------------------------------
  --
  -- A LINEAR SLIDER OVER A WIDE RANGE IS NOT A CONTROL, IT IS A LOTTERY.
  -- "Launch power" ran 500 to 250,000 across about 130 pixels: every pixel was
  -- roughly nineteen hundred units, so the low half of the range -- where most
  -- of the useful values live -- could not be aimed at at all, and lowering the
  -- floor or raising the ceiling only makes that worse.
  --
  -- `curve = "log"` spends slider travel proportionally instead: equal distance
  -- for equal RATIO, so 1->10 takes as much room as 100,000->1,000,000. That is
  -- the only way one control can offer both fine tuning at the bottom and
  -- millions at the top, which is exactly what these settings need.
  --
  -- Quantisation follows the curve too: snapping a logarithmic value to a fixed
  -- linear step would put every stop at the bottom and none at the top.
  local logCurve = (opts.curve == "log")
  local logLo, logSpan
  if logCurve then
    logLo = math.log(math.max(min, 1e-4))
    logSpan = math.log(math.max(max, min + 1e-3)) - logLo
    if logSpan <= 0 then logCurve = false end
  end

  local function toAlpha(v)
    if logCurve then
      return math.clamp((math.log(math.max(v, 1e-4)) - logLo) / logSpan, 0, 1)
    end
    return (max > min) and math.clamp((v - min) / (max - min), 0, 1) or 0
  end

  local function fromAlpha(a)
    a = math.clamp(a, 0, 1)
    if logCurve then return math.exp(logLo + a * logSpan) end
    return min + a * (max - min)
  end

  local api = {}
  local function quantise(v)
    v = math.clamp(v, min, max)
    if logCurve then
      -- significant figures rather than a fixed step: 1.2, then 12, then 120,
      -- so the readout stays legible across five orders of magnitude
      local mag = math.floor(math.log10(math.max(math.abs(v), 1e-4)))
      local q = 10 ^ math.max(mag - 2, -3)
      v = math.floor(v / q + 0.5) * q
    elseif step > 0 then
      v = math.floor((v - min) / step + 0.5) * step + min
    end
    return math.clamp(v, min, max)
  end

  local function paint(immediate)
    local a = toAlpha(value)
    -- 1,250,000 rather than 1250000: past four digits the eye cannot count
    -- zeroes, and these ranges now reach seven
    local shown
    if math.abs(value) >= 10000 then
      local whole = string.format("%d", math.floor(value + 0.5))
      local sep = whole:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
      shown = sep
    else
      shown = tostring(L.round(value, 3))
    end
    readout.Text = opts.suffix and (shown .. opts.suffix) or shown
    if immediate then
      M.set(fill, "Size", UDim2.fromScale(a, 1))
      M.set(knob, "Position", UDim2.fromScale(a, 0.5))
    else
      -- `gentle` is overdamped on purpose: a slider fill that springs PAST the
      -- value the readout already shows looks like a bug, not like polish.
      M.to(fill, "Size", UDim2.fromScale(a, 1), "gentle")
      M.to(knob, "Position", UDim2.fromScale(a, 0.5), "gentle")
    end
  end

  local dragging, dragRefused = false, nil
  local lastGood = value

  function api:set(v, silent)
    local nv = quantise(v)
    if nv == value then return end
    local prev = value
    value = nv
    paint(false)
    if silent then return end
    -- MID-DRAG A REVERT WOULD FIGHT THE POINTER: the knob snaps back, the next
    -- mouse-move refuses again, and that is a toast per frame. A drag is one
    -- gesture, so it records the refusal and settles once on release.
    if dragging then
      local ok, why = commitValue("slider", opts, value, true)
      if ok then lastGood, dragRefused = value, nil else dragRefused = why end
      return
    end
    if commitValue("slider", opts, value) then
      lastGood = value
    else
      value = prev
      paint(false)
    end
  end
  function api:get() return value end
  local function fromX(px)
    -- IGNORE ANY POINTER MATH BEFORE THE TRACK IS LAID OUT. A slider on a tab
    -- that is active at load (the persisted tab) exists a frame or two before
    -- Roblox gives it a real AbsoluteSize. Until then AbsoluteSize.X is 0, the
    -- max(...,1) floor makes the divisor 1, and any stray Activated turns a
    -- 900px mouse X into a=900 -> clamp to 1 -> the slider SLAMS to its maximum.
    -- That is what was quietly pinning fling power to max on load. No real drag
    -- can happen on a zero-width track, so there is nothing to lose by waiting.
    local w = track.AbsoluteSize.X
    if w < 8 then return end
    local a = (px - track.AbsolutePosition.X) / w
    api:set(fromAlpha(a))
  end

  hit.MouseButton1Down:Connect(function()
    dragging = true
    M.to(knob, "Size", UDim2.fromOffset(14, 14), "fast")
  end)
  hit.InputChanged:Connect(function(i)
    if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
      fromX(i.Position.X)
    end
  end)
  L.hold(L.UIS.InputChanged:Connect(function(i)
    if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
      or i.UserInputType == Enum.UserInputType.Touch) then
      fromX(i.Position.X)
    end
  end))
  L.hold(L.UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
      or i.UserInputType == Enum.UserInputType.Touch then
      if dragging then
        dragging = false
        M.to(knob, "Size", UDim2.fromOffset(11, 11), "fast")
        if dragRefused then
          local why = dragRefused
          dragRefused = nil
          if value ~= lastGood then value = lastGood paint(false) end
          if L.Toast then L.Toast.warn(tostring(opts.text or "Setting"), tostring(why)) end
        end
      end
    end
  end))
  -- A CLICK ON A SLIDER IS, BY DEFINITION, ON THE SLIDER.
  --
  -- Activated used to be trusted outright and the mouse X mapped straight onto
  -- the track. That is unsound whenever the track has not been placed yet: a
  -- fresh row reports its real width a frame before Roblox resolves its
  -- position, so AbsoluteSize.X is 132 while AbsolutePosition.X is still 0, and
  -- (900 - 0) / 132 clamps to 1 -- the slider would jump to its maximum from a
  -- click nowhere near it.
  --
  -- Requiring the pointer to actually be over the track closes that off. This
  -- is defence, not a bug fix: the max-value readings that prompted it turned
  -- out to be a stale global left by a silently-failing obfuscated build, not
  -- this code path.
  hit.Activated:Connect(function()
    local w = track.AbsoluteSize.X
    if w < 8 then return end
    local x0 = track.AbsolutePosition.X
    -- X-only, and the inset is vertical on every current platform, so this was
    -- never visibly wrong -- but it is read through the same helper as the rest
    -- so it cannot rot if a platform ever reports a horizontal inset.
    local mx = L.pointer().X
    -- hit is 20px wider than the track on each side, so allow that much slack
    if mx < x0 - 24 or mx > x0 + w + 24 then return end
    fromX(mx)
  end)

  local function closeEntry(commit)
    if not entry.Visible then return end
    if commit then
      -- accepts "137", "137.5", " 137 " and rejects the rest rather than
      -- silently resolving a typo to 0, which would look like the slider moved
      -- on its own
      local n = tonumber((entry.Text:gsub("%s", "")))
      if n then
        api:set(n)
      elseif entry.Text ~= "" and L.Toast then
        L.Toast.warn(opts.text or "Value",
          string.format("'%s' is not a number -- left at %s.", entry.Text, tostring(value)))
      end
    end
    entry.Visible = false
    readout.Visible = true
    pcall(function() entry:ReleaseFocus() end)
  end

  local function openEntry()
    readout.Visible = false
    entry.Visible = true
    entry.Text = tostring(L.round(value, 2))
    M.set(entry, "BackgroundTransparency", 1)
    M.to(entry, "BackgroundTransparency", 0.4, "fast")
    entry:CaptureFocus()
    pcall(function() entry.CursorPosition = #entry.Text + 1 entry.SelectionStart = 1 end)
  end

  hitReadout.Activated:Connect(openEntry)
  entry.FocusLost:Connect(function(enter) closeEntry(enter) end)
  -- Escape abandons the edit. Without it the only way out of a half-typed value
  -- is to commit it, and the engine takes Escape before anything can sink it, so
  -- this listener is the whole mechanism.
  L.hold(L.UIS.InputBegan:Connect(function(i, gameProcessed)
    if gameProcessed then return end
    if entry.Visible and i.KeyCode == Enum.KeyCode.Escape then closeEntry(false) end
  end))
  local _ = entryStroke

  -- One step per press, ten with Shift. A slider whose only keyboard speed is
  -- one step makes a 16..250 range a 234-press job, and one that always jumps
  -- coarsely cannot be aimed -- so the modifier picks which you wanted.
  focusable(f, {
    radius = T.r.md, label = opts.text,
    suspend = function() return entry.Visible end,
    activate = openEntry,          -- Enter on a focused slider types the value
    adjust = function(dir)
      local mult = (L.UIS:IsKeyDown(Enum.KeyCode.LeftShift)
                 or L.UIS:IsKeyDown(Enum.KeyCode.RightShift)) and 10 or 1
      if logCurve then
        -- a fixed step is meaningless on a ratio scale; move along the track
        api:set(fromAlpha(toAlpha(value) + dir * 0.02 * mult))
      else
        api:set(value + dir * (step > 0 and step or 1) * mult)
      end
    end,
  })

  -- Hover wash, rim and pointer spotlight, same as the toggle above it. Wired
  -- last on purpose: the guard inside A.interactive lifts the track, the readout
  -- button and the entry box clear of the full-size Hit overlay, and it can only
  -- lift children that already exist.
  A.interactive(f, { radius = T.r.md })

  paint(true)
  api.frame = f
  register(opts, api)
  return api
end

-- ---------------------------------------------------------------- dropdown
--
-- A POPOVER, NOT AN INLINE EXPANSION.

local DD_ROW, DD_MAX, DD_FILTER_AT = 32, 232, 8
-- geometry of the closed row: left padding, the value label's width and its
-- distance from the right edge (clearing the chevron), and the gap the title
-- must leave before the value starts
local DD_PAD, DD_VAL_W, DD_VAL_RIGHT, DD_GAP = 12, 160, 32, 10

local function overlayLayer()
  local w = L.Hub and L.Hub.window
  return w and w.overlay
end

function C.dropdown(parent, opts)
  opts = opts or {}
  -- MULTI-SELECT (WindUI's `Multi = true`). The selection is a set of items; the
  -- callback receives an ARRAY of the chosen items in list order, and it is
  -- persisted as a JSON string because the config store only holds scalars.
  local multi = opts.multi and true or false
  local items = opts.items or {}
  local value, sel, popts = nil, {}, opts
  local function listOf()
    local out = {}
    for _, it in ipairs(items) do if sel[it] then out[#out + 1] = it end end
    return out
  end
  local function labelOf()
    if not multi then return tostring(value or "None") end
    local l = listOf()
    if #l == 0 then return tostring(opts.placeholder or "None") end
    local parts = {}
    for i, it in ipairs(l) do parts[i] = tostring(it) end
    return table.concat(parts, ", ")
  end
  if multi then
    local def = {}
    if type(opts.default) == "table" then
      for _, x in ipairs(opts.default) do def[#def + 1] = x end
    elseif opts.default ~= nil then
      def[1] = opts.default
    end
    local okE, encoded = pcall(L.Http.JSONEncode, L.Http, def)
    popts = {
      text = opts.text, id = opts.id, persist = opts.persist, desc = opts.desc,
      default = okE and encoded or "[]",
      callback = function(js)
        local ok, l = pcall(L.Http.JSONDecode, L.Http, js)
        if not ok or type(l) ~= "table" then return false, "Bad selection." end
        if opts.callback then return opts.callback(l) end
      end,
    }
    bindPersist(popts)
    local okD, saved = pcall(L.Http.JSONDecode, L.Http, popts.default)
    if okD and type(saved) == "table" then
      for _, x in ipairs(saved) do sel[x] = true end
    end
  else
    bindPersist(opts)
    value = opts.default
  end
  local open, pop, rows, filterBox, shadow = false, nil, {}, nil, nil

  local f = A.surface({
    Parent = parent, elev = 1, radius = T.r.md,
    Size = UDim2.new(1, 0, 0, ROWH()), Name = "Dropdown",
  })

  A.text({
    Text = opts.text or "Select",
    font = T.font.medium, size = T.size.body, colour = T.c.text,
    Position = UDim2.fromOffset(DD_PAD, 0),
    -- DERIVED, NOT GUESSED. The title used to reserve `1, -150` while the value
    -- label occupied the last 192 px, so the two boxes overlapped by ~42 px --
    -- measured at 86 px on screen at 1.6x scale. Both truncate, so short titles
    -- hid it, but a long one drew straight through the value it sits beside.
    -- Every number below comes from the same four constants, so the two boxes
    -- cannot drift apart again.
    Size = UDim2.new(1, -(DD_PAD + DD_VAL_W + DD_VAL_RIGHT + DD_GAP), 1, 0),
    truncate = true, Parent = f,
  })

  local valueLbl = A.text({
    Text = labelOf(),
    font = T.font.body, size = T.size.label, colour = T.c.textDim,
    align = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0),
    Position = UDim2.new(1, -DD_VAL_RIGHT, 0, 0),
    Size = UDim2.fromOffset(DD_VAL_W, ROWH()),
    truncate = true, ZIndex = 2, Parent = f,
  })

  local _, chevInner = A.Icon.chevron(f, 14, T.c.textMute, "down")
  local chev = chevInner.Parent
  chev.Position = UDim2.new(1, -26, 0, ROWH() / 2 - 7)
  chev.ZIndex = 2

  local api = {}

  local function paintRows()
    for _, r in ipairs(rows) do
      -- one shared treatment, so a chosen row looks the same here, in the
      -- player panel and in the command centre -- see A.selectRow
      local on
      if multi then on = sel[r.value] == true else on = (r.value == value) end
      A.selectRow(r.frame, r.label, on, "fast")
      if r.check then r.check.Visible = on end
    end
  end

  function api:set(v, silent)
    if multi then
      -- a table replaces the whole selection; a single item flips just that one
      local prev = sel
      local nxt = {}
      if type(v) == "table" then
        for _, x in ipairs(v) do nxt[x] = true end
      elseif v ~= nil then
        for k in pairs(prev) do nxt[k] = true end
        nxt[v] = (not prev[v]) or nil
      end
      sel = nxt
      valueLbl.Text = labelOf()
      paintRows()
      if silent then return end
      local ok, js = pcall(L.Http.JSONEncode, L.Http, listOf())
      if not commitValue("dropdown", popts, ok and js or "[]") then
        sel = prev
        valueLbl.Text = labelOf()
        paintRows()
      end
      return
    end
    local prev = value
    value = v
    valueLbl.Text = labelOf()
    paintRows()
    if silent then return end
    if not commitValue("dropdown", opts, v) then
      value = prev
      valueLbl.Text = labelOf()
      paintRows()
    end
  end
  function api:get() if multi then return listOf() end return value end

  -- WindUI Dropdown:Refresh(values). Swaps the list, drops selections that no
  -- longer exist, and rebuilds the open menu in place if it is showing.
  function api:refresh(newItems)
    items = type(newItems) == "table" and newItems or {}
    local have = {}
    for _, it in ipairs(items) do have[it] = true end
    if multi then
      for k in pairs(sel) do if not have[k] then sel[k] = nil end end
    elseif value ~= nil and not have[value] then
      value = nil
    end
    valueLbl.Text = labelOf()
    if api.isOpen and api.isOpen() then
      api.close(true)
      api.open()
    end
  end
  api.setItems = api.refresh

  -- THE STACKING SHADOW. The drop shadow was created anonymously --
  -- `A.shadow(nil, { Parent = layer })` -- and only `pop` was ever destroyed, so
  -- every open left another full-strength shadow behind on the overlay. Measured:
  -- five open/close cycles, five orphaned Shadow ImageLabels, each one darkening
  -- the page again. Held by reference now and torn down with the menu it belongs
  -- to.
  local function closePop(instant)
    if not open then return end
    open = false
    M.to(chevInner, "Rotation", 0, "base")
    local p, s = pop, shadow
    pop, shadow = nil, nil
    if s then
      if instant then pcall(function() s:Destroy() end)
      else
        M.to(s, "ImageTransparency", 1, "fast")
        task.delay(0.28, function() pcall(function() s:Destroy() end) end)
      end
    end
    if p and instant then
      -- DISPLACED, NOT DISMISSED. Closing normally leaves the old menu on the
      -- overlay for 0.28 s while it collapses -- which is fine on its own, and
      -- is a stack of two opaque menus when the next one is already opening on
      -- top of it. That is the bug in the recording: a four-item Method list
      -- showing five rows, the extra one belonging to Aim at.
      pcall(function() p:Destroy() end)
      p = nil
    end
    if p then
      M.to(p, "Size", UDim2.fromOffset(p.Size.X.Offset, 0), "fast")
      -- A.fadeTo, not a bare background fade. This popover collapses to zero
      -- HEIGHT as it closes, so an un-faded UIStroke does not merely linger --
      -- it becomes a literal horizontal line sitting where the list used to be.
      A.fadeTo(p, 1, "fast")
      task.delay(0.28, function() pcall(function() p:Destroy() end) end)
    end
    rows = {}
  end
  api.close = closePop

  local function build()
    local layer = overlayLayer()
    if not layer then return end
    local win = L.Hub.window
    local sc = (win.scaleObj and win.scaleObj.Scale) or 1

    -- absolute geometry, converted into the overlay's own space
    local originAbs = layer.AbsolutePosition
    local fAbs, fSize = f.AbsolutePosition, f.AbsoluteSize
    local x = (fAbs.X - originAbs.X) / sc
    local yBelow = (fAbs.Y + fSize.Y - originAbs.Y) / sc + 4
    local width = fSize.X / sc

    -- rows can be taller than the plain-text default when the caller draws more
    -- into them (a headshot needs room a name does not)
    local ROWPX = opts.rowHeight or DD_ROW
    local showFilter = opts.search == true or (opts.search ~= false and #items >= DD_FILTER_AT)
    local listH = math.min(#items * ROWPX + 8, opts.maxHeight or DD_MAX)
    local fullH = listH + (showFilter and 34 or 0)

    -- FLIPPING UP IS NOT ENOUGH ON ITS OWN, and this is the bug the recording
    -- caught: with 32 players in the server the menu is at its full height, and
    -- flipping it above a row near the bottom put its top at a negative Y. It
    -- drew over the title bar and off the top of the window, filter box clipped.
    --
    -- So the menu is clamped into the CONTENT region -- below the header, not
    -- merely inside the window -- and if it still cannot fit, it is shortened
    -- rather than allowed to overhang. It scrolls, so shorter costs nothing.
    local panelH = win.root.AbsoluteSize.Y / sc
    local top = 8
    local content = win.root:FindFirstChild("Content")
    if content then
      top = (content.AbsolutePosition.Y - originAbs.Y) / sc + 6
    end
    local bottom = panelH - 8

    local avail = bottom - top
    if fullH > avail then
      fullH = math.max(DD_ROW + 8, avail)
      listH = fullH - (showFilter and 34 or 0)
    end

    local flip = (yBelow + fullH) > bottom
    local y = flip and ((fAbs.Y - originAbs.Y) / sc - fullH - 4) or yBelow
    y = math.clamp(y, top, math.max(top, bottom - fullH))

    pop = mk("Frame", {
      Position = UDim2.fromOffset(x, y),
      Size = UDim2.fromOffset(width, 0),
      BackgroundColor3 = T.c.overlay, BackgroundTransparency = 0,
      BorderSizePixel = 0,
      ClipsDescendants = true, ZIndex = 31, Name = "Popover", Parent = layer,
    })
    L.corner(T.r.md, pop)
    L.stroke(T.c.lineStrong, 1, 0.25, pop)

    -- Sized and placed to follow the menu, and kept so closePop can remove it.
    -- It cannot be parented to `pop` itself: pop clips its descendants, which
    -- would cut the shadow off at exactly the edge it needs to spill past.
    shadow = A.shadow(nil, { Parent = layer, spread = 22, alpha = 1, ZIndex = 30 })
    if shadow then
      shadow.AnchorPoint = Vector2.new(0, 0)
      shadow.Position = UDim2.fromOffset(x - 22, y - 22 + 6)
      shadow.Size = UDim2.fromOffset(width + 44, fullH + 44)
      M.to(shadow, "ImageTransparency", 0.42, "base")
    end

    -- A DEFENSIVE SWEEP, because one orphan is invisible and ten are not. If any
    -- shadow ever outlives its menu again, the next open clears it rather than
    -- letting the page get darker every time.
    for _, c in ipairs(layer:GetChildren()) do
      if c ~= shadow and c.Name == "Shadow" then pcall(function() c:Destroy() end) end
    end

    M.to(pop, "Size", UDim2.fromOffset(width, fullH), "base")

    local listTop = 0
    if showFilter then
      filterBox = mk("TextBox", {
        Position = UDim2.fromOffset(8, 6), Size = UDim2.fromOffset(width - 16, 24),
        BackgroundColor3 = T.c.raised, BorderSizePixel = 0,
        Text = "", PlaceholderText = "Filter " .. #items .. " items",
        PlaceholderColor3 = T.c.textOff, TextColor3 = T.c.text,
        Font = T.font.body, TextSize = T.size.micro,
        TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
        ZIndex = 32, Parent = pop,
      })
      L.corner(T.r.sm, filterBox)
      L.pad(0, 8, 0, 8, filterBox)
      listTop = 34
    end

    local scroll = A.scroll({
      Parent = pop, gap = 2,
      Size = UDim2.new(1, -8, 0, listH - 8),
      Position = UDim2.fromOffset(4, listTop + 4),
      Name = "DDList",
    })
    scroll.ZIndex = 32

    rows = {}
    for i, item in ipairs(items) do
      local r = mk("Frame", {
        Size = UDim2.new(1, -4, 0, ROWPX - 2), LayoutOrder = i,
        BackgroundColor3 = T.c.accent, BackgroundTransparency = 1,
        BorderSizePixel = 0, ZIndex = 32, Parent = scroll,
      })
      L.corner(T.r.sm, r)
      local lbl = A.text({
        Text = opts.labelFor and opts.labelFor(item) or tostring(item),
        font = T.font.body, size = T.size.label,
        colour = T.c.textDim, Position = UDim2.fromOffset(opts.textInset or 10, 0),
        Size = UDim2.new(1, -((opts.textInset or 10) + 10), 1, 0),
        truncate = true, ZIndex = 33, Parent = r,
      })
      A.interactive(r, {
        radius = T.r.sm, hoverAlpha = 0.94,
        onClick = function()
          if not multi and opts.allowNone and value == item then
            api:set(nil)                       -- WindUI AllowNone: click again to clear
          else
            api:set(item)
          end
          if not multi then closePop() end
        end,
      })
      local chk
      if multi then                         -- tick on the right of a chosen row
        chk = A.Icon.check(r, 14, T.c.accent)
        chk.AnchorPoint = Vector2.new(1, 0.5)
        chk.Position = UDim2.new(1, -8, 0.5, 0)
        chk.ZIndex = 34
        chk.Visible = false
      end
      rows[#rows + 1] = { frame = r, label = lbl, value = item, check = chk }
      -- the caller may hang anything it likes on the row (a headshot, a
      -- distance) without this control needing to know what a player is
      if opts.decorate then L.try("dropdown.decorate", opts.decorate, r, item, i) end

      -- STAGGERED ENTRANCE. Thirty rows appearing at once is a block of text
      -- arriving; the same thirty arriving over a fifth of a second reads as a
      -- list being dealt. Capped so a 32-player server does not take a second
      -- to finish dealing.
      -- TEXT ONLY, DELIBERATELY. Fading the row's images too looked right until
      -- the headshots landed: the avatar starts invisible and fades itself in
      -- when the thumbnail returns from the network, so the stagger captured
      -- "invisible" as its rest value and, if the image arrived first, animated
      -- it straight back to nothing. Cached thumbnails lost that race every
      -- time. Anything a decorator draws now owns its own entrance.
      if opts.stagger ~= false then
        for _, d in ipairs(r:GetDescendants()) do
          if d:IsA("TextLabel") then
            local rest = d.TextTransparency
            d.TextTransparency = 1
            M.after(math.min(i, 14) * 0.018, function()
              if d.Parent then M.to(d, "TextTransparency", rest, "base") end
            end)
          end
        end
      end
    end
    paintRows()

    if filterBox then
      filterBox:GetPropertyChangedSignal("Text"):Connect(function()
        local q = string.lower(filterBox.Text)
        local shown = 0
        for _, r in ipairs(rows) do
          local hit = (q == "") or string.find(string.lower(tostring(r.value)), q, 1, true) ~= nil
          r.frame.Visible = hit
          if hit then shown = shown + 1 end
        end
        -- capped by what actually fits, not by DD_MAX: re-deriving from the
        -- constant here would undo the clamp above the moment you typed
        local h = math.min(shown * ROWPX + 8, listH)
        M.to(pop, "Size", UDim2.fromOffset(width, h + 34), "fast")
        M.to(scroll, "Size", UDim2.new(1, -8, 0, h - 8), "fast")
        -- a shorter menu may now sit lower than it needs to; keep it in bounds
        local ny = math.clamp(pop.Position.Y.Offset, top, math.max(top, bottom - (h + 34)))
        if math.abs(ny - pop.Position.Y.Offset) > 0.5 then
          M.to(pop, "Position", UDim2.fromOffset(x, ny), "fast")
        end
      end)
      task.defer(function() if open and filterBox then filterBox:CaptureFocus() end end)
    end
  end

  local function openPop()
    if open then return end
    -- EVERY OTHER MENU GOES FIRST, and goes instantly.
    --
    -- Each dropdown already closed itself on a click outside, which mostly
    -- worked -- but only mostly: the click that opens the next menu can land
    -- inside the OLD menu's rectangle, and that path treats it as a click on
    -- itself and stays open. Two lists then sit on the overlay together, which
    -- is why the recording shows items from one dropdown under another.
    -- Asking directly is both cheaper and correct.
    C.closePopovers(true)
    open = true
    M.to(chevInner, "Rotation", 180, "base")
    build()
  end

  api.open = openPop
  C._pops[#C._pops + 1] = { frame = f, close = closePop }

  local head = mk("TextButton", {
    Size = UDim2.new(1, 0, 0, ROWH()), BackgroundTransparency = 1,
    Text = "", AutoButtonColor = false, ZIndex = 3, Parent = f,
  })
  head.Activated:Connect(function()
    if open then closePop() else openPop() end
  end)

  -- close on a click anywhere else, and on Escape
  L.hold(L.UIS.InputBegan:Connect(function(i, typing)
    if not open then return end
    if i.KeyCode == Enum.KeyCode.Escape then closePop() return end
    if typing then return end
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
      -- INSET-EXCLUDED: every comparison below is against an AbsolutePosition,
      -- and GetMouseLocation is measured in the other space. Mixing them left
      -- this 58 px out on the Y axis, so the dropdown thought the pointer had
      -- left while it was still over the bottom of the list.
      local m = L.pointer()
      local inTrigger = m.X >= f.AbsolutePosition.X and m.X <= f.AbsolutePosition.X + f.AbsoluteSize.X
        and m.Y >= f.AbsolutePosition.Y and m.Y <= f.AbsolutePosition.Y + f.AbsoluteSize.Y
      local inPop = false
      if pop then
        local pa, ps = pop.AbsolutePosition, pop.AbsoluteSize
        inPop = m.X >= pa.X and m.X <= pa.X + ps.X and m.Y >= pa.Y and m.Y <= pa.Y + ps.Y
      end
      if not inTrigger and not inPop then closePop() end
    end
  end))

  paintRows()
  api.frame = f
  register(opts, api)
  -- drivable from code, not only by clicking: needed for tests, and for any
  -- caller that wants to open a chooser in response to something else
  api.open, api.toggle = openPop, function()
    if open then closePop() else openPop() end
  end
  api.isOpen = function() return open end

  -- Enter opens the popover; Left and Right change the selection without opening
  -- it at all, which is faster than open-arrow-arrow-Enter for a short list.
  focusable(f, {
    radius = T.r.md, label = opts.text,
    activate = function() if open then closePop() else openPop() end end,
    adjust = function(dir)
      if multi or #items == 0 then return end
      local i = 1
      for k, it in ipairs(items) do if it == api:get() then i = k break end end
      api:set(items[math.clamp(i + dir, 1, #items)])
    end,
  })
  return api
end

-- ---------------------------------------------------------------- keybind

function C.keybind(parent, opts)
  opts = opts or {}
  local key = opts.default
  local listening = false

  local f = row(parent, { text = opts.text, desc = opts.desc, rightRoom = 110 })

  local chip = A.surface({
    Parent = f, elev = 2, radius = T.r.sm,
    Size = UDim2.fromOffset(78, 24), Name = "Chip",
  })
  chip.AnchorPoint = Vector2.new(1, 0.5)
  chip.Position = UDim2.new(1, -12, 0.5, 0)
  chip.ZIndex = 2

  local lbl = A.text({
    Text = key and key.Name or "None",
    font = T.font.mono, size = T.size.micro, colour = T.c.textDim,
    align = Enum.TextXAlignment.Center, ZIndex = 3, Parent = chip,
  })

  local api = {}
  local function paint()
    lbl.Text = listening and "press..." or (key and key.Name or "None")
    M.to(lbl, "TextColor3", listening and T.c.accent or T.c.textDim, "fast")
  end

  function api:set(k, silent)
    key = k
    paint()
    if not silent and opts.callback then L.try("keybind.cb", opts.callback, k) end
  end
  function api:get() return key end

  -- L.Binds is told we are listening, or pressing F to bind fly to F would also
  -- fire fly on the way past -- the key would toggle the feature and record
  -- itself in the same keystroke.
  local function listen(on)
    listening = on
    if L.Binds then L.Binds.capturing = on end
    paint()
  end

  A.interactive(chip, { radius = T.r.sm, onClick = function() listen(true) end })

  if typing then return end
  L.hold(L.UIS.InputBegan:Connect(function(i, typing)
    if not listening or not L.live() then return end
    if i.UserInputType ~= Enum.UserInputType.Keyboard then return end
    listen(false)
    -- Escape CLEARS rather than binding. A UI that lets you bind Escape and
    -- then needs Escape to get out of the menu has trapped you.
    if i.KeyCode == Enum.KeyCode.Escape then api:set(nil) else api:set(i.KeyCode) end
  end))

  -- `suspend` HANDS THE KEYBOARD BACK. While this control is listening it needs
  -- the raw keys -- including the very ones focus navigation claims. Without it
  -- you could never bind Tab, an arrow or Enter, because the navigator would
  -- sink each of them before this control ever saw it.
  focusable(f, {
    radius = T.r.md, label = opts.text,
    suspend = function() return listening end,
    activate = function() listen(true) end,
  })

  paint()
  api.frame = f
  register(opts, api)
  return api
end

-- ---------------------------------------------------------------- input

function C.input(parent, opts)
  opts = opts or {}
  bindPersist(opts)
  local f = row(parent, { text = opts.text, desc = opts.desc, rightRoom = 170 })

  local box = mk("TextBox", {
    AnchorPoint = Vector2.new(1, 0.5),
    Position = UDim2.new(1, -12, 0.5, 0),
    Size = UDim2.fromOffset(146, 26),
    BackgroundColor3 = T.c.overlay,
    BorderSizePixel = 0,
    Text = opts.default or "",
    PlaceholderText = opts.placeholder or "",
    PlaceholderColor3 = T.c.textOff,
    TextColor3 = T.c.text,
    Font = T.font.body, TextSize = T.size.label,
    TextXAlignment = Enum.TextXAlignment.Left,
    ClearTextOnFocus = false,
    ZIndex = 2, Parent = f,
  })
  L.corner(T.r.sm, box)
  L.pad(0, 8, 0, 8, box)
  local st = L.stroke(T.c.lineStrong, 1, 0.4, box)

  box.Focused:Connect(function() M.to(st, "Color", T.c.accent, "fast") M.to(st, "Transparency", 0.1, "fast") end)
  box.FocusLost:Connect(function(enter)
    M.to(st, "Color", T.c.lineStrong, "fast")
    M.to(st, "Transparency", 0.4, "fast")
    if enter and opts.callback then L.try("input.cb", opts.callback, box.Text) end
  end)

  -- An input row read as dead beside the toggle above it. The guard lifts the
  -- box clear of the Hit overlay so the field still takes the caret, and the
  -- overlay gives the dead space beside a 146 px field a job it never had.
  A.interactive(f, { radius = T.r.md, onClick = function() box:CaptureFocus() end })

  local api = { frame = f, box = box }
  function api:get() return box.Text end
  function api:set(v) box.Text = tostring(v or "") end
  register(opts, api)
  return api
end

-- ---------------------------------------------------------------- textarea
--
-- Full width and several lines tall, for text nobody can write in 146 pixels.
-- MultiLine TextBoxes do not wrap on their own, so TextWrapped is not optional
-- here -- without it a long prompt runs off the right edge and simply vanishes.
function C.textarea(parent, opts)
  opts = opts or {}
  local lines = opts.lines or 4
  local h = 10 + 16 + (lines * 16) + 10

  local f = A.surface({
    Parent = parent, elev = 1, radius = T.r.md,
    Size = UDim2.new(1, 0, 0, h), Name = "TextArea",
  })
  if opts.text then
    A.text({
      Text = opts.text,
      font = T.font.medium, size = T.size.micro, colour = T.c.textMute,
      Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -24, 0, 13),
      truncate = true, Parent = f,
    })
  end

  local box = mk("TextBox", {
    Position = UDim2.fromOffset(10, opts.text and 26 or 10),
    Size = UDim2.new(1, -20, 1, opts.text and -36 or -20),
    BackgroundColor3 = T.c.overlay, BorderSizePixel = 0,
    Text = opts.default or "", PlaceholderText = opts.placeholder or "",
    PlaceholderColor3 = T.c.textOff, TextColor3 = T.c.text,
    Font = T.font.body, TextSize = T.size.label,
    TextXAlignment = Enum.TextXAlignment.Left,
    TextYAlignment = Enum.TextYAlignment.Top,
    MultiLine = true, ClearTextOnFocus = false, TextWrapped = true,
    ZIndex = 2, Parent = f,
  })
  L.corner(T.r.sm, box)
  L.pad(6, 8, 6, 8, box)
  local st = L.stroke(T.c.lineStrong, 1, 0.4, box)
  box.Focused:Connect(function()
    M.to(st, "Color", T.c.accent, "fast") M.to(st, "Transparency", 0.1, "fast")
  end)
  box.FocusLost:Connect(function()
    M.to(st, "Color", T.c.lineStrong, "fast") M.to(st, "Transparency", 0.4, "fast")
  end)

  local api = { frame = f, box = box }
  function api:get() return box.Text end
  function api:set(v) box.Text = tostring(v or "") end
  register(opts, api)
  return api
end

-- ---------------------------------------------------------------- output
--
-- Read-only prose of unknown length: a model's answer, an error body. Grows with
-- its content and scrolls past a ceiling, because the one thing it must never do
-- is silently clip the end of an answer.
function C.output(parent, opts)
  opts = opts or {}
  local maxH = opts.maxHeight or 260

  local f = A.surface({
    Parent = parent, elev = 0, radius = T.r.md, line = true,
    Size = UDim2.new(1, 0, 0, 64), Name = "Output",
  })

  local scroll = mk("ScrollingFrame", {
    Position = UDim2.fromOffset(10, 10), Size = UDim2.new(1, -20, 1, -20),
    BackgroundTransparency = 1, BorderSizePixel = 0,
    ScrollBarThickness = 3, ScrollBarImageColor3 = T.c.lineStrong,
    ScrollBarImageTransparency = 0.3,
    CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
    ZIndex = 2, Parent = f,
  })

  local label = A.text({
    Text = opts.default or "", font = opts.mono and T.font.mono or T.font.body,
    size = T.size.label, colour = T.c.textMute,
    Size = UDim2.new(1, -6, 0, 20), wrap = true,
    Parent = scroll,
  })
  label.TextYAlignment = Enum.TextYAlignment.Top

  -- MEASURED WITH GetTextSize, NOT LEFT TO AutomaticSize. Three separate things
  -- went wrong before this, and the third is why the whole approach changed:
  --
  -- 1. UNITS. AbsoluteSize is real screen pixels, a UDim2 Y offset is pre-UIScale
  --    units. Mixing them multiplied every card by the scale -- measured at 1.6.
  -- 2. TIMING. One deferred frame is not enough for a wrapped label to settle.
  -- 3. TextBounds IS THE RENDERED HEIGHT, AND IT DEADLOCKS. Measured live on the
  --    free-keys card: 490 characters over 14 lines reported TextBounds.Y = 43
  --    while GetTextSize said 224. AutomaticSize faithfully followed the wrong
  --    number, so the label never grew, so its AbsoluteSize never changed, so
  --    nothing ever re-fired the resize. It sat there clipped forever.
  --
  -- GetTextSize asks what the text NEEDS at a given width, which is the question
  -- actually being asked, and it answers before anything is laid out.
  local TS = game:GetService("TextService")
  local function fit()
    if not label.Parent then return end
    local win = L.Hub and L.Hub.window
    local sc = (win and win.scaleObj and win.scaleObj.Scale) or 1
    local w = label.AbsoluteSize.X / sc
    if w < 20 then return end            -- not laid out yet; the signal will call back
    local textH = TS:GetTextSize(label.Text, label.TextSize, label.Font,
                                 Vector2.new(w, 100000)).Y
    if math.abs(label.Size.Y.Offset - textH) >= 1 then
      label.Size = UDim2.new(1, -6, 0, textH)
    end
    local want = math.clamp(textH + 20, 56, maxH)
    if math.abs(f.Size.Y.Offset - want) < 1 then return end
    M.to(f, "Size", UDim2.new(1, 0, 0, want), "fast")
  end
  -- watched on the SCROLL, not the label: the label's size is what fit() writes,
  -- so listening there would retrigger itself
  scroll:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)

  local api = { frame = f, label = label, scroll = scroll }
  function api:set(text, colour)
    label.Text = tostring(text or "")
    label.TextColor3 = colour or T.c.textMute
    fit()
  end
  function api:get() return label.Text end
  api:set(opts.default or "")
  return api
end

-- ---------------------------------------------------------------- text dots
--
-- A status line whose trailing dots animate while the words hold still. The
-- point is that the COPY stays ordinary text -- animating the whole string makes
-- a label look like it is malfunctioning, whereas animating only the appended
-- marks reads as "still working".
--
-- The dots are separate labels rather than characters appended to the string,
-- because rewriting `Text` every frame reflows the label and makes the words
-- themselves jitter by a pixel. Each dot runs the same pulse on its own phase.
function C.textDots(parent, opts)
  opts = opts or {}
  local count = opts.count or 3
  local period = opts.duration or 1.30      -- one full pass over all the dots
  local stagger = opts.delay or (period / (count + 1))
  local size = opts.size or T.size.label
  local font = opts.font or T.font.body
  local colour = opts.colour or T.c.textMute

  local holder = mk("Frame", {
    BackgroundTransparency = 1, Name = "TextDots",
    Size = opts.Size or UDim2.new(1, 0, 0, size + 6),
    Position = opts.Position, ZIndex = opts.ZIndex or 2, Parent = parent,
  })

  local label = A.text({
    Text = opts.text or "Thinking", font = font, size = size, colour = colour,
    Size = UDim2.new(1, 0, 1, 0), ZIndex = (opts.ZIndex or 2) + 1, Parent = holder,
  })

  -- measured, never assumed: TextBounds is the RENDERED width and lies whenever
  -- the label truncates, so the dots would stack on top of the last glyph
  local TS = game:GetService("TextService")
  local dots, dotW = {}, 0
  local function layout()
    local w = TS:GetTextSize(label.Text, size, font, Vector2.new(1e5, 1e5)).X
    dotW = TS:GetTextSize(".", size, font, Vector2.new(1e5, 1e5)).X
    for i, d in ipairs(dots) do
      d.Position = UDim2.fromOffset(w + 1 + (i - 1) * (dotW + 1), 0)
    end
  end

  for i = 1, count do
    dots[i] = A.text({
      Text = ".", font = font, size = size, colour = colour,
      Size = UDim2.fromOffset(12, size + 6), ZIndex = (opts.ZIndex or 2) + 1,
      Parent = holder,
    })
    dots[i].TextXAlignment = Enum.TextXAlignment.Left
  end
  layout()

  local conn, t0 = nil, os.clock()
  local api = { frame = holder, label = label }

  function api:setText(s)
    label.Text = tostring(s or "")
    layout()
  end
  function api:setColour(c)
    label.TextColor3 = c
    for _, d in ipairs(dots) do d.TextColor3 = c end
  end

  function api:start()
    if conn then return end
    t0 = os.clock()
    conn = L.hold(L.RunService.RenderStepped:Connect(function()
      if not holder.Parent then return end
      local now = os.clock() - t0
      for i, d in ipairs(dots) do
        -- phase 0..1 per dot, offset so they light in sequence
        local ph = ((now - (i - 1) * stagger) / period) % 1
        -- a short bright pass, then a long rest: the same shape as the CSS
        -- keyframes this is modelled on (peak early, settle back)
        local a
        if ph < 0.30 then
          a = ph / 0.30
        elseif ph < 0.62 then
          a = 1 - (ph - 0.30) / 0.32
        else
          a = 0
        end
        d.TextTransparency = 0.78 - 0.78 * a
        d.Position = UDim2.fromOffset(d.Position.X.Offset, -math.floor(a * 2 + 0.5))
      end
    end))
  end

  function api:stop()
    if conn then conn:Disconnect() conn = nil end
    for _, d in ipairs(dots) do
      d.TextTransparency = 0.78
      d.Position = UDim2.fromOffset(d.Position.X.Offset, 0)
    end
  end

  function api:destroy()
    api:stop()
    pcall(function() holder:Destroy() end)
  end

  if opts.autoStart ~= false then api:start() end
  return api
end

-- ---------------------------------------------------------------- log view
--
-- The activity log, rendered. This is the receipt for everything else in Wave 1:
-- an indicator that says "2 contested" is only worth trusting if you can open it
-- and read WHAT is contested and WHEN it stopped holding.
function C.logView(parent, opts)
  opts = opts or {}
  local MAX = opts.max or 80
  local ROW = 20

  local KINDC = {
    fault   = T.c.bad,     refused = T.c.warn,  ok = T.c.ok,
    note    = T.c.textMute, user   = T.c.textDim,
  }

  local holder = mk("Frame", {
    Size = UDim2.new(1, 0, 0, opts.height or 286),
    BackgroundColor3 = T.c.overlay, BackgroundTransparency = 0.4,
    BorderSizePixel = 0, Parent = parent,
  })
  L.corner(T.r.md, holder)
  L.stroke(T.c.line, 1, 0.55, holder)

  local scroll = A.scroll({ Parent = holder, gap = 1, padding = 10 })

  local empty = A.text({
    Text = "Nothing logged yet.", font = T.font.mono, size = T.size.tiny,
    colour = T.c.textOff, align = Enum.TextXAlignment.Center,
    AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
    Size = UDim2.new(1, -20, 0, 16), Parent = holder,
  })

  -- MEASURED, NOT PICKED. The clock column was 52 px wide and "23:56:39" needs
  -- 56 at this font and size, so every row lost the last digit of its seconds --
  -- with no truncation set, so there was not even an ellipsis to hint at it.
  -- Deriving the width from the widest real timestamp cannot drift when the mono
  -- font or the tiny size changes.
  -- Widening the clock pushes every column after it, so the whole row is derived
  -- from one chain. Hardcoding the next offset is how the old 52 survived: each
  -- number looked right on its own.
  local CLOCK_W = math.ceil(game:GetService("TextService")
    :GetTextSize("00:00:00", T.size.tiny, T.font.mono, Vector2.new(1e5, 1e5)).X) + 4
  local GAP, KIND_W, SRC_W = 4, 52, 132
  local KIND_X = CLOCK_W + GAP
  local SRC_X  = KIND_X + KIND_W + GAP
  local MSG_X  = SRC_X + SRC_W + GAP

  local function mkRow(e, order)
    local r = mk("Frame", {
      Size = UDim2.new(1, 0, 0, ROW), BackgroundTransparency = 1,
      LayoutOrder = order, Parent = scroll,
    })
    local col = KINDC[e.kind] or T.c.textMute
    A.text({ Text = e.at, font = T.font.mono, size = T.size.tiny, colour = T.c.textOff,
             Size = UDim2.fromOffset(CLOCK_W, ROW), Parent = r })
    A.text({ Text = e.kind, font = T.font.mono, size = T.size.tiny, colour = col,
             Position = UDim2.fromOffset(KIND_X, 0), Size = UDim2.fromOffset(52, ROW),
             Parent = r })
    -- 132, not 94: sources are qualified ("toggle:Infinite jump"), and a column
    -- that clips them to "toggle:Infinit..." identifies the KIND of control that
    -- failed while hiding WHICH ONE -- the single fact the row exists to carry.
    A.text({ Text = e.src, font = T.font.mono, size = T.size.tiny, colour = T.c.textDim,
             Position = UDim2.fromOffset(SRC_X, 0), Size = UDim2.fromOffset(SRC_W, ROW),
             truncate = true, Parent = r })
    local msg = A.text({ Text = e.text, font = T.font.body, size = T.size.micro,
             colour = T.c.textMute, Position = UDim2.fromOffset(MSG_X, 0),
             Size = UDim2.new(1, -(MSG_X + 42), 0, ROW), truncate = true, Parent = r })
    local cnt = A.text({ Text = e.n > 1 and ("x" .. e.n) or "",
             font = T.font.mono, size = T.size.tiny, colour = col,
             align = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0),
             Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(38, ROW),
             Parent = r })
    return r, cnt, msg
  end

  local seenSeq, topCnt, topEntry, dropLbl = -1, nil, nil, nil

  local function rebuild()
    for _, c in ipairs(scroll:GetChildren()) do
      if c:IsA("Frame") or (c:IsA("TextLabel") and c.Name ~= "Layout") then c:Destroy() end
    end
    local logs = L.logs
    empty.Visible = #logs == 0
    local shown = math.min(#logs, MAX)
    local order = 0
    for i = #logs, #logs - shown + 1, -1 do
      order = order + 1
      local r, cnt = mkRow(logs[i], order)
      if i == #logs then topCnt, topEntry = cnt, logs[i] end
    end
    -- NO SILENT TRUNCATION. A list that quietly stops at 80 reads as "that is
    -- everything that happened", which is a worse lie than the ones this wave
    -- set out to remove.
    if #logs > shown then
      dropLbl = A.text({
        Text = string.format("... %d older entr%s not shown (%d kept in memory)",
                             #logs - shown, (#logs - shown) == 1 and "y" or "ies", #logs),
        font = T.font.mono, size = T.size.tiny, colour = T.c.textOff,
        Size = UDim2.new(1, 0, 0, ROW), LayoutOrder = order + 1, Parent = scroll,
      })
    end
  end

  local function refresh()
    if L._logSeq ~= seenSeq then
      seenSeq = L._logSeq
      rebuild()
    elseif topCnt and topEntry and topCnt.Parent then
      -- only the newest entry can collapse, so nothing else can have changed
      topCnt.Text = topEntry.n > 1 and ("x" .. topEntry.n) or ""
    end
  end

  refresh()
  task.spawn(function()
    while L.live() and holder.Parent do
      L.try("logview.refresh", refresh)
      task.wait(0.5)
    end
  end)

  return { frame = holder, scroll = scroll, refresh = refresh }
end


-- ============================================================================
-- WINDUI PARITY CONTROLS
-- The elements WindUI ships that this library did not have: Checkbox,
-- Colorpicker, Code, Divider, Space, ProgressBar, Tag.  (Multi-select Dropdown
-- lives inside C.dropdown as `multi = true`, Toggle{Type="Checkbox"} routes to
-- C.checkbox from the public wrapper.)
--
-- Written against the same scaffolding as everything above: `row`, `register`,
-- `bindPersist`, `commitValue`, `focusable` and the overlay layer are all the
-- ones the existing controls use, so these inherit persistence, keyboard focus,
-- the palette and the disabled veil without any special casing.
-- ============================================================================

-- ---------------------------------------------------------------- checkbox
function C.checkbox(parent, opts)
  opts = opts or {}
  bindPersist(opts)
  local state = opts.default and true or false
  local f = row(parent, { text = opts.text, desc = opts.desc, rightRoom = 48 })

  local box = mk("Frame", {
    AnchorPoint = Vector2.new(1, 0.5),
    Position = UDim2.new(1, -12, 0.5, 0),
    Size = UDim2.fromOffset(20, 20),
    BackgroundColor3 = T.c.active, BorderSizePixel = 0, ZIndex = 2, Parent = f,
  })
  L.corner(T.r.sm, box)
  local boxStroke = L.stroke(T.c.lineStrong, 1, 0.4, box)

  -- same trick as the toggle: the accent gradient lives on its own fill layer
  -- so its transparency can animate without dragging the off colour with it
  local fill = mk("Frame", {
    Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1),
    BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 2, Parent = box,
  })
  L.corner(T.r.sm, fill)
  A.accentGradient(fill, 0)

  local tick = A.Icon.check(box, 14, T.c.accentInk)
  tick.AnchorPoint = Vector2.new(0.5, 0.5)
  tick.Position = UDim2.fromScale(0.5, 0.5)
  tick.ZIndex = 3
  tick.Visible = state

  local api = {}
  local function paint(immediate)
    local tok = (not immediate) and "fast" or nil
    local setter = immediate and M.set or M.to
    setter(fill, "BackgroundTransparency", state and 0 or 1, tok)
    setter(boxStroke, "Transparency", state and 1 or 0.4, tok)
    tick.Visible = state
  end

  function api:set(v, silent)
    v = v and true or false
    if v == state then return end
    state = v
    paint(false)
    if silent then return end
    if not commitValue("checkbox", opts, state) then
      state = not state
      paint(false)
    end
  end
  function api:get() return state end

  A.interactive(f, { radius = T.r.md, onClick = function() api:set(not state) end })
  focusable(f, {
    radius = T.r.md, label = opts.text,
    activate = function() api:set(not state) end,
    adjust = function(dir) api:set(dir > 0) end,
  })
  paint(true)
  api.frame = f
  register(opts, api)
  C.pinnable(f, opts, {
    kind = "toggle",
    get = function() return api:get() end,
    set = function(v) api:set(v) end,
  })
  return api
end

