T.elev = {
  [0] = { fill = T.c.surface, line = T.c.lineSoft,   lineT = 0.55 },
  [1] = { fill = T.c.raised,  line = T.c.line,       lineT = 0.50 },
  [2] = { fill = T.c.overlay, line = T.c.lineStrong, lineT = 0.45 },
}

