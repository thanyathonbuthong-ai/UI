  -- it no longer has a module for.
  autoGames = { t = "table",   scope = "global" },

  -- EVERY CONTROL IN THE HUB, keyed by a stable id. Until this existed the
  -- schema had to name each setting individually, so the only settings that
  -- survived a reload were the ones somebody remembered to declare -- which was
  -- the twenty listed above and none of the hundred in the feature tabs. Aim
  -- FOV, hitbox size, fling power, walk speed, every dropdown: all of it was
  -- rebuilt from source defaults on every execute.
  --
  -- One free-form table instead, written by lm_06_controls whenever a control
  -- changes and read back when it is built. No `fields`: the set of controls is
  -- whatever the tabs happen to contain, and validating that here would mean
  -- editing this file every time a feature gains a slider.
  --
  -- GLOBAL, and this was wrong before. It was place-scoped on the theory that
  -- tuning belongs to a game -- but the effect was that every setting you
  -- touched applied only to the game you happened to be standing in, so joining
