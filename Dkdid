  -- Update the slider from a screen position (works with mouse and touch)
  local function UpdateSlider(Pos)
    local Outer = Slider.SliderOuter
    local Px = math.clamp((Pos.X - Outer.AbsolutePosition.X) / math.max(Outer.AbsoluteSize.X, 1), 0, 1)
    local ScaledValue = Px * (Info.Maximum - Info.Minimum) + Info.Minimum
    local RoundedValue = Utilities:Round(ScaledValue, Info.Incrementation)
    local FinalValue = math.clamp(RoundedValue, Info.Minimum, Info.Maximum)
    local Fill = (FinalValue - Info.Minimum) / (Info.Maximum - Info.Minimum)

    Utilities:Tween(Outer.SliderInner, 0.09, {Size = UDim2.new(Fill, 0, 1, 0)})
    if Info.Flag then
        library.Flags[Info.Flag] = FinalValue
    end
    Outer.SliderValueText.Text = StepFormat:format(FinalValue)..Info.Postfix
    task.spawn(Info.Callback, FinalValue)
  end

  Slider.SliderOuter.SliderButton.InputBegan:Connect(function(Input)
    if not Utilities:IsPress(Input) then return end

    -- stop the list from scrolling while the finger slides the bar
    Left.ScrollingEnabled = false
    Right.ScrollingEnabled = false

    UpdateSlider(Input.Position)

    Utilities:Drag(Input, UpdateSlider, function()
        Left.ScrollingEnabled = true
        Right.ScrollingEnabled = true
    end)
  end)
  end

