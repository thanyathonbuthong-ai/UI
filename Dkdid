        Size = UDim2.new(0, 70, 0, 20),
        Position = UDim2.new(0, 150, 0, 170),
        BackgroundColor3 = CurrentColor,
        ClipsDescendants = true,
        ZIndex = 50001
      }, {
        Utilities:Create("UIStroke", { Color = Colors.AccentDivider }),
        Utilities:Create("UICorner", { CornerRadius = UDim.new(0, 4) })
      })
    })

    local SVSquare = Popup.SVSquare
    local SVThumb = SVSquare.SVThumb
    local HueBar = Popup.HueBar
    local HueThumb = HueBar.HueThumb

    local function UpdateColor()
      CurrentColor = Color3.fromHSV(H, S, V)
      CP.PreviewBox.BackgroundColor3 = CurrentColor
      Popup.PreviewSwatch.BackgroundColor3 = CurrentColor
      if Info.Flag then library.Flags[Info.Flag] = CurrentColor end
      task.spawn(Info.Callback, CurrentColor)
    end

    local function PositionThumbs()
      local w = math.max(SVSquare.AbsoluteSize.X, 1)
      local h = math.max(SVSquare.AbsoluteSize.Y, 1)
      local hh = math.max(HueBar.AbsoluteSize.Y, 1)
      SVThumb.Position = UDim2.new(0, S * w, 0, (1 - V) * h)
      HueThumb.Position = UDim2.new(.5, 0, 0, (1 - H) * hh)
    end

    SVSquare.InputBegan:Connect(function(Input)
      if not Utilities:IsPress(Input) then return end
      local function move(Pos)
        local w = math.max(SVSquare.AbsoluteSize.X, 1)
        local h = math.max(SVSquare.AbsoluteSize.Y, 1)
        local x = math.clamp(Pos.X - SVSquare.AbsolutePosition.X, 0, w)
        local y = math.clamp(Pos.Y - SVSquare.AbsolutePosition.Y, 0, h)
        S = x / w
        V = 1 - y / h
        SVThumb.Position = UDim2.new(0, x, 0, y)
        UpdateColor()
      end
      move(Input.Position)
      Utilities:Drag(Input, move)
    end)

    HueBar.InputBegan:Connect(function(Input)
      if not Utilities:IsPress(Input) then return end
      local function move(Pos)
        local h = math.max(HueBar.AbsoluteSize.Y, 1)
        local y = math.clamp(Pos.Y - HueBar.AbsolutePosition.Y, 0, h)
        H = 1 - y / h
        HueThumb.Position = UDim2.new(.5, 0, 0, y)
        SVSquare.BackgroundColor3 = Color3.fromHSV(H, 1, 1)
        UpdateColor()
      end
      move(Input.Position)
      Utilities:Drag(Input, move)
    end)

    Popup.CPTitleBar.InputBegan:Connect(function(Input)
      if not Utilities:IsPress(Input) then return end
      local StartPos = Input.Position
      local StartUDim = Popup.Position
      Utilities:Drag(Input, function(Pos)
        local Delta = Pos - StartPos
        Popup.Position = UDim2.new(StartUDim.X.Scale, StartUDim.X.Offset + Delta.X, StartUDim.Y.Scale, StartUDim.Y.Offset + Delta.Y)
      end)
    end)

    Popup.CPClose.MouseButton1Click:Connect(function()
      Popup.Visible = false
    end)

    CP.PreviewBox.CPButton.MouseButton1Click:Connect(function()
      for _, p in pairs(Window:GetChildren()) do
        if p.Name == "ColorPopup" and p ~= Popup then p.Visible = false end
      end
      Popup.Visible = not Popup.Visible
      if Popup.Visible then
        task.wait()
        PositionThumbs()
      end
    end)

    if Info.Flag then library.Flags[Info.Flag] = CurrentColor end

    function CPTable:Set(color)
      if typeof(color) ~= "Color3" then return end
      H, S, V = Color3.toHSV(color)
      CurrentColor = color
      CP.PreviewBox.BackgroundColor3 = color
      Popup.PreviewSwatch.BackgroundColor3 = color
      SVSquare.BackgroundColor3 = Color3.fromHSV(H, 1, 1)
      if Popup.Visible then PositionThumbs() end
      if Info.Flag then library.Flags[Info.Flag] = color end
    end
    function CPTable:Get()
      return CurrentColor
    end
    return CPTable
  end

