        }),
        Utilities:Create("TextButton", {
          Name = "KeyButton",
          Size = UDim2.new(1, 0, 1, 0),
          BackgroundTransparency = 1,
          Text = ""
        })
      }),
      Utilities:Create("TextLabel", {
        Name = "KeybindText",
        Text = Info.Text,
        TextSize = 13,
        Font = Enum.Font.SourceSansBold,
        RichText = true,
        Size = UDim2.new(.4, -9, 0, 14),
        Position = UDim2.new(.6, 9, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = Colors.PrimaryText,
        BackgroundTransparency = 1
      })
    })
    SizeX:GetPropertyChangedSignal("Value"):Connect(function()
      Keybind.Size = UDim2.new(0, ColumnWidth(), 0, 21)
    end)
    local KeyText = Keybind.KeyBox.KeyText
    Keybind.KeyBox.MouseEnter:Connect(function()
      Utilities:Tween(Keybind.KeyBox, .125, { BackgroundColor3 = Colors.Hovering })
    end)
    Keybind.KeyBox.MouseLeave:Connect(function()
      Utilities:Tween(Keybind.KeyBox, .125, { BackgroundColor3 = Colors.Secondary })
    end)
    Keybind.KeyBox.KeyButton.MouseButton1Click:Connect(function()
      if Picking then return end
      Picking = true
      KeyText.Text = "..."
      KeyText.TextColor3 = Colors.Accent
      ListenConn = UserInputService.InputBegan:Connect(function(Input)
        local chosen = nil
        if Input.UserInputType == Enum.UserInputType.Keyboard then
          chosen = Input.KeyCode.Name
        elseif Input.UserInputType == Enum.UserInputType.MouseButton1 then
          chosen = "MouseLeft"
        elseif Input.UserInputType == Enum.UserInputType.MouseButton2 then
          chosen = "MouseRight"
        elseif Input.UserInputType == Enum.UserInputType.Touch then
          return
        end
        if chosen then
          Picking = false
          CurrentKey = chosen
          KeyText.Text = chosen
          KeyText.TextColor3 = Colors.PrimaryText
          if Info.Flag then library.Flags[Info.Flag] = chosen end
          if ListenConn then ListenConn:Disconnect(); ListenConn = nil end
        end
      end)
    end)
    UserInputService.InputBegan:Connect(function(Input)
      if Picking or not CurrentKey then return end
      local fire = false
      if Input.UserInputType == Enum.UserInputType.Keyboard and Input.KeyCode.Name == CurrentKey then
        fire = true
      elseif Input.UserInputType == Enum.UserInputType.MouseButton1 and CurrentKey == "MouseLeft" then
        fire = true
      elseif Input.UserInputType == Enum.UserInputType.MouseButton2 and CurrentKey == "MouseRight" then
        fire = true
      end
      if fire then task.spawn(Info.Callback, CurrentKey) end
    end)
    if Info.Default and Info.Flag then library.Flags[Info.Flag] = Info.Default end
    function KeybindTable:Set(key)
      CurrentKey = key
      KeyText.Text = key or "None"
      KeyText.TextColor3 = key and Colors.PrimaryText or Colors.TertiaryText
    end
    function KeybindTable:Get()
      return CurrentKey
    end
    return KeybindTable
  end

  --// MultiToggle (WindUI-style multi-select buttons in a row) //--
  function SectionTable:MultiToggle(Info)
    Info.Text = Info.Text or "Options"
    Info.List = Info.List or {}
    Info.Default = Info.Default or {}
    Info.Flag = Info.Flag or nil
    Info.Callback = Info.Callback or function() end
    if type(Info.Default) ~= "table" then Info.Default = { Info.Default } end
    local Selected = {}
    for _, v in pairs(Info.Default) do
      if not table.find(Selected, v) then table.insert(Selected, v) end
    end
    local MTTable = {}
    local MT = Utilities:Create("Frame", {
      Name = "MultiToggle",
      Parent = SectionContainer,
      Size = UDim2.new(0, ColumnWidth(), 0, 21),
      BackgroundTransparency = 1
    }, {
      Utilities:Create("TextLabel", {
        Name = "MTText",
        Text = Info.Text,
        TextSize = 13,
        Font = Enum.Font.SourceSansBold,
        RichText = true,
        Size = UDim2.new(.35, 0, 0, 14),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = Colors.PrimaryText,
        BackgroundTransparency = 1
      }),
      Utilities:Create("Frame", {
        Name = "MTButtons",
        Size = UDim2.new(.65, -4, 0, 14),
        Position = UDim2.new(.35, 4, 0, 0),
        BackgroundTransparency = 1,
        ClipsDescendants = true
      }, {
        Utilities:Create("UIListLayout", {
          FillDirection = Enum.FillDirection.Horizontal,
          Padding = UDim.new(0, 4),
          VerticalAlignment = Enum.VerticalAlignment.Center
        })
      })
    })
    SizeX:GetPropertyChangedSignal("Value"):Connect(function()
      MT.Size = UDim2.new(0, ColumnWidth(), 0, 21)
    end)
    local function Fire()
      if Info.Flag then library.Flags[Info.Flag] = Selected end
      task.spawn(Info.Callback, Selected)
    end
    for _, opt in pairs(Info.List) do
      local isOn = table.find(Selected, opt) ~= nil
      local btnW = math.clamp(#tostring(opt) * 7 + 14, 26, 120)
      local btn = Utilities:Create("Frame", {
        Name = "MTBtn",
        Parent = MT.MTButtons,
        BackgroundColor3 = isOn and Colors.Accent or Colors.Secondary,
        Size = UDim2.new(0, btnW, 0, 14),
        ClipsDescendants = true
      }, {
        Utilities:Create("UIStroke", { Color = isOn and Colors.DarkerAccent or Colors.AccentDivider }),
        Utilities:Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
        Utilities:Create("TextLabel", {
          Name = "MTBtnText",
          Text = opt,
          BackgroundTransparency = 1,
          Size = UDim2.new(1, 0, 1, 0),
          TextSize = 12,
          Font = Enum.Font.SourceSansBold,
          TextColor3 = isOn and Colors.AccentText or Colors.PrimaryText,
          TextXAlignment = Enum.TextXAlignment.Center,
          RichText = true
        }),
        Utilities:Create("TextButton", {
          Name = "MTBtnButton",
          Size = UDim2.new(1, 0, 1, 0),
          BackgroundTransparency = 1,
          Text = ""
        })
      })
      btn.MTBtnButton.MouseButton1Click:Connect(function()
        local idx = table.find(Selected, opt)
        if idx then
          table.remove(Selected, idx)
          Utilities:Tween(btn, .125, { BackgroundColor3 = Colors.Secondary })
          Utilities:Tween(btn.UIStroke, .125, { Color = Colors.AccentDivider })
          Utilities:Tween(btn.MTBtnText, .125, { TextColor3 = Colors.PrimaryText })
        else
          table.insert(Selected, opt)
          Utilities:Tween(btn, .125, { BackgroundColor3 = Colors.Accent })
          Utilities:Tween(btn.UIStroke, .125, { Color = Colors.DarkerAccent })
          Utilities:Tween(btn.MTBtnText, .125, { TextColor3 = Colors.AccentText })
        end
        Fire()
      end)
    end
    Fire()
    function MTTable:Get()
      return Selected
    end
    function MTTable:Clear()
      for i = #Selected, 1, -1 do table.remove(Selected, i) end
      Fire()
    end
    return MTTable
  end

