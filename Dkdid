        DropdownTable:Toggle(State)
    end)

    DropIndex = DropIndex - 1

    return DropdownTable
  end

  --// Input (WindUI-style text box, touch friendly) //--
  function SectionTable:Input(Info)
    Info.Text = Info.Text or "Input"
    Info.Flag = Info.Flag or nil
    Info.Default = Info.Default or ""
    Info.Placeholder = Info.Placeholder or "Enter text..."
    Info.Callback = Info.Callback or function() end
    local InputTable = {}
    local Placeholding = Info.Default == ""
    local Input = Utilities:Create("Frame", {
      Name = "Input",
      Parent = SectionContainer,
      Size = UDim2.new(0, ColumnWidth(), 0, 21),
      BackgroundTransparency = 1
    }, {
      Utilities:Create("Frame", {
        Name = "InputBox",
        BackgroundColor3 = Colors.Secondary,
        Size = UDim2.new(.6, 3, 0, 14),
        ClipsDescendants = true
      }, {
        Utilities:Create("UIStroke", { Color = Colors.AccentDivider }),
        Utilities:Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
        Utilities:Create("TextBox", {
          Name = "InputField",
          Size = UDim2.new(1, -8, 1, 0),
          Position = UDim2.new(0, 4, 0, 0),
          BackgroundTransparency = 1,
          Text = Placeholding and Info.Placeholder or Info.Default,
          TextColor3 = Placeholding and Colors.SecondaryText or Colors.PrimaryText,
          TextSize = 13,
          Font = Enum.Font.SourceSansBold,
          TextXAlignment = Enum.TextXAlignment.Left,
          ClearTextOnFocus = false
        })
      }),
      Utilities:Create("TextLabel", {
        Name = "InputText",
        Text = Info.Text,
        TextSize = 13,
        Font = Enum.Font.SourceSansBold,
        RichText = true,
        Size = UDim2.new(.4, -9, 0, 14),
        Position = UDim2.new(.6, 9, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = Colors.PrimaryText,
        BackgroundTransparency = 1
      })
    })
    SizeX:GetPropertyChangedSignal("Value"):Connect(function()
      Input.Size = UDim2.new(0, ColumnWidth(), 0, 21)
    end)
    local Field = Input.InputBox.InputField
    Input.InputBox.MouseEnter:Connect(function()
      Utilities:Tween(Input.InputBox, .125, { BackgroundColor3 = Colors.Hovering })
    end)
    Input.InputBox.MouseLeave:Connect(function()
      Utilities:Tween(Input.InputBox, .125, { BackgroundColor3 = Colors.Secondary })
    end)
    Field.Focused:Connect(function()
      if Placeholding then
        Field.Text = ""
        Placeholding = false
      end
      Field.TextColor3 = Colors.PrimaryText
      Utilities:Tween(Input.InputBox.UIStroke, .125, { Color = Colors.Accent })
    end)
    local function Submit()
      local val = Field.Text
      if val == "" then
        Placeholding = true
        Field.Text = Info.Placeholder
        Field.TextColor3 = Colors.SecondaryText
      end
      if Info.Flag then library.Flags[Info.Flag] = (Placeholding and "" or val) end
      task.spawn(Info.Callback, Placeholding and "" or val)
    end
    Field.FocusLost:Connect(function(enterPressed)
      Utilities:Tween(Input.InputBox.UIStroke, .125, { Color = Colors.AccentDivider })
      if enterPressed then Submit() end
    end)
    if not Placeholding and Info.Flag then library.Flags[Info.Flag] = Info.Default end
    function InputTable:Set(str)
      Placeholding = false
      Field.Text = str or ""
      Field.TextColor3 = Colors.PrimaryText
    end
    function InputTable:Get()
      return Placeholding and "" or Field.Text
    end
    return InputTable
  end

