        })
      }),
      Utilities:Create("Frame", {
        Name = "HueBar",
        Size = UDim2.new(0, 14, 0, 130),
        Position = UDim2.new(0, 150, 0, 34),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        ZIndex = 50001
      }, {
        Utilities:Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
