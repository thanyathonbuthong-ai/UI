    return Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch
  end

  -- Works for both mouse and touch.
  -- BeganInput = the InputObject that started the drag
  -- OnMove(position: Vector3) is called while dragging, OnEnd() when released
  function Utilities:Drag(BeganInput, OnMove, OnEnd)
    local IsTouchInput = BeganInput.UserInputType == Enum.UserInputType.Touch
    local MoveConn, EndConn

    MoveConn = UserInputService.InputChanged:Connect(function(Input)
        if (IsTouchInput and Input == BeganInput) or (not IsTouchInput and Input.UserInputType == Enum.UserInputType.MouseMovement) then
            OnMove(Input.Position)
        end
    end)

    EndConn = UserInputService.InputEnded:Connect(function(Input)
        if Input == BeganInput or (not IsTouchInput and Input.UserInputType == Enum.UserInputType.MouseButton1) then
            MoveConn:Disconnect()
            EndConn:Disconnect()
            if OnEnd then
                OnEnd()
            end
        end
    end)
  end

