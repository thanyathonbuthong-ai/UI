  -- Resize with mouse or finger
  local function Resize(Pos)
    local Cam = workspace.CurrentCamera.ViewportSize
    local X = math.clamp(Pos.X - Window.Main.AbsolutePosition.X, 250, math.max(250, math.min(1300, Cam.X)))
    local Y = math.clamp(Pos.Y - Window.Main.AbsolutePosition.Y, 165, math.max(165, math.min(730, Cam.Y)))
    
    SizeX.Value = X
    SizeY.Value = Y

    Utilities:Tween(Window.Main, .05, {Size = UDim2.new(0, X, 0, Y)})

    ResizeTabs()
  end

