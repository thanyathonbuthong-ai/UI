          Name = "KeyText",
          Text = CurrentKey or "None",
          Size = UDim2.new(1, 0, 1, 0),
          BackgroundTransparency = 1,
          TextSize = 13,
          Font = Enum.Font.SourceSansBold,
          TextColor3 = CurrentKey and Colors.PrimaryText or Colors.TertiaryText,
