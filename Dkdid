    Info.Title = Info.Title or nil
    Info.Duration = Info.Duration or 5
    Info.Color = Info.Color or Colors.Accent
    local NotifyHolder = Window:FindFirstChild("NotifyHolder")
    if not NotifyHolder then
      NotifyHolder = Utilities:Create("Frame", {
        Name = "NotifyHolder",
        Parent = Window,
        Size = UDim2.new(0, 230, 0, 0),
