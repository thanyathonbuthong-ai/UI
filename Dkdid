          Padding = UDim.new(0, 6),
          SortOrder = Enum.SortOrder.LayoutOrder
        })
      })
    end
    local displayText = Info.Title and (Info.Title .. "\n" .. Info.Text) or Info.Text
    local Note = Utilities:Create("Frame", {
      Name = "Note",
      Parent = NotifyHolder,
      Size = UDim2.new(1, 0, 0, 0),
      AutomaticSize = Enum.AutomaticSize.Y,
      BackgroundColor3 = Colors.Secondary,
      BackgroundTransparency = 1,
      ZIndex = 60001,
      ClipsDescendants = true
    }, {
      Utilities:Create("UIStroke", { Color = Info.Color }),
      Utilities:Create("UICorner", { CornerRadius = UDim.new(0, 6) }),
      Utilities:Create("Frame", {
        Name = "AccentBar",
        Size = UDim2.new(0, 3, 1, 0),
        BackgroundColor3 = Info.Color,
        ZIndex = 60002
      }),
      Utilities:Create("TextLabel", {
        Name = "NoteText",
        Text = displayText,
        Size = UDim2.new(1, -16, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Position = UDim2.new(0, 12, 0, 6),
        BackgroundTransparency = 1,
        TextSize = 13,
        Font = Enum.Font.SourceSansBold,
        TextColor3 = Colors.PrimaryText,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        RichText = true,
        ZIndex = 60002
      })
    })
    Utilities:Tween(Note, .2, { BackgroundTransparency = 0 })
    task.delay(Info.Duration, function()
      if not Note.Parent then return end
      Utilities:Tween(Note, .3, { BackgroundTransparency = 1 })
      if Note:FindFirstChild("NoteText") then Utilities:Tween(Note.NoteText, .3, { TextTransparency = 1 }) end
      if Note:FindFirstChild("UIStroke") then Utilities:Tween(Note.UIStroke, .3, { Transparency = 1 }) end
      if Note:FindFirstChild("AccentBar") then Utilities:Tween(Note.AccentBar, .3, { BackgroundTransparency = 1 }) end
      task.wait(.35)
      if Note.Parent then Note:Destroy() end
    end)
  end
  
