		b.TextSize = 12
		b.TextColor3 = THEME.text
		b.AutoButtonColor = true
		b.ZIndex = 12
		b.Parent = parent
		corner(b, 6)
		mkstroke(b, THEME.stroke, 1, 0.3)
		b.MouseButton1Click:Connect(cb)
		return b
	end

	local listLbl = line(c, "Configs: (none)", THEME.dim)
	local function refreshList()
		local names = listConfigs()
		if #names == 0 then
			listLbl.Text = "Configs: (none)"
		else
			listLbl.Text = "Configs: " .. table.concat(names, ", ")
			if selectedConfig == "" then selectedConfig = names[1] end
		end
	end

	mkBtn(c, "Save Config", Color3.fromRGB(40, 80, 50), function()
		local name = nameBox.Text ~= "" and nameBox.Text or selectedConfig
		if name == "" then name = "default" end
		local ok, err = saveConfig(name)
		if configStatusLbl then
			configStatusLbl.Text = ok and ("Saved: " .. name) or ("Save failed: " .. tostring(err))
			configStatusLbl.TextColor3 = ok and THEME.green or THEME.red
		end
		selectedConfig = name
		refreshList()
	end)

	mkBtn(c, "Load Config", Color3.fromRGB(40, 50, 90), function()
		local name = nameBox.Text ~= "" and nameBox.Text or selectedConfig
		if name == "" then
			if configStatusLbl then configStatusLbl.Text = "Type a config name first" end
			return
		end
		local ok, err = loadConfig(name)
		if configStatusLbl then
			configStatusLbl.Text = ok and ("Loaded: " .. name .. " (re-open toggles to refresh UI)") or ("Load failed: " .. tostring(err))
			configStatusLbl.TextColor3 = ok and THEME.green or THEME.red
		end
	end)

	mkBtn(c, "Delete Config", Color3.fromRGB(90, 35, 45), function()
		local name = nameBox.Text ~= "" and nameBox.Text or selectedConfig
		if name == "" then return end
		deleteConfig(name)
		if configStatusLbl then
			configStatusLbl.Text = "Deleted: " .. name
			configStatusLbl.TextColor3 = THEME.gold
		end
		if selectedConfig == name then selectedConfig = "" end
		nameBox.Text = ""
		refreshList()
	end)

	mkBtn(c, "Refresh List", THEME.card, function()
		refreshList()
		if configStatusLbl then
			configStatusLbl.Text = "List refreshed"
			configStatusLbl.TextColor3 = THEME.dim
		end
	end)

	configStatusLbl = line(c, "Ready", THEME.dim)
	refreshList()
end

