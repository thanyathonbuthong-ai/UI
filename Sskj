local function updateScale()
	local cam = Workspace.CurrentCamera
	if not cam then return end
	local vx = cam.ViewportSize.X
	local scale
	if vx < 500 then scale = math.clamp(vx / 1100, 0.5, 0.78)
	elseif vx < 900 then scale = math.clamp(vx / 1300, 0.62, 0.85)
	else scale = math.clamp(vx / 1750, 0.75, 1.05) end
