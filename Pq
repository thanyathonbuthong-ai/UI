		Connect(Row.MouseButton1Click, function()
			if not Panel then Build() end

			Apply(true)
			Sink.Visible = true
			Tween(Sink, .2, { BackgroundTransparency = .55 })
		end)

		function Object:Set(New: Color3, NewTransparency: number?, Silent: boolean?)
			if New then H, S, V = New:ToHSV() end
			if NewTransparency then A = NewTransparency end
			Apply(Silent)
		end

		function Object:Get() return Color3.fromHSV(H, S, V), A end

		table.insert(Custom, function()
			if Panel then
				Panel.BackgroundColor3 = Theme.Secondary
				HexBox.BackgroundColor3 = Theme.Interactables
				HexBox.TextColor3 = Theme.Title
				if AlphaBack then AlphaBack.BackgroundColor3 = Theme.Interactables end
			end
		end)

