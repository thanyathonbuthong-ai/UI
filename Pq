			FontFace = TitleRef.FontFace,
			TextSize = 12,
			TextColor3 = Theme.Title,
			Parent = Row,
		})
		Corner(Copy, 5)

		Connect(Copy.MouseButton1Click, function()
			local Clip = setclipboard or toclipboard or set_clipboard

			if Clip then
				Clip(Code)
				Options:Notify({ Title = "Copied", Description = "Code copied to clipboard", Duration = 1.5 })
			end
		end)

		table.insert(Custom, function()
			Holder.BackgroundColor3 = Theme.Interactables
			CodeText.TextColor3 = Theme.Title
