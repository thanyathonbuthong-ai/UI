			Copy.TextColor3 = Theme.Title
		end)

		return { Instance = Row, Destroy = function() Destroy(Row) end }
	end

	--// ------------------------------------------------------------------
	--// Image   (rbxassetid or http(s) url when the executor supports it)
	--// ------------------------------------------------------------------
	function Options:AddImage(Settings: { Image: string, AspectRatio: string?, Height: number?, Radius: number?, Tab: Instance })
		local Source = Settings.Image

		if type(Source) == "string" and Source:find("^https?://") and writefile and getcustomasset then
			local Ok, Result = pcall(function()
				local Hash = 0
				for Index = 1, #Source do
					Hash = (Hash * 31 + Source:byte(Index)) % 1000000007
				end

				local File = "uilib_img_" .. Hash .. ".png"
				if not (isfile and isfile(File)) then
					writefile(File, game:HttpGet(Source))
				end

				return getcustomasset(File)
			end)

			if Ok then Source = Result end
		end

		local Picture = Instance.new("ImageLabel")
		SetProperty(Picture, {
			Name = "Outline", --// harmless name: stops SetTheme from recolouring the picture
			Image = Source or "",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScaleType = Enum.ScaleType.Crop,
			Size = UDim2.new(RowWidth.Scale, RowWidth.Offset, 0, Settings.Height or 140),
			Parent = Settings.Tab,
		})
		Corner(Picture, Settings.Radius or 8)

		local Width, Height = (Settings.AspectRatio or ""):match("(%d+):(%d+)")
		if Width and Height then
			Picture.Size = UDim2.new(RowWidth.Scale, RowWidth.Offset, 0, 0)

			local Ratio = Instance.new("UIAspectRatioConstraint")
			Ratio.AspectRatio = tonumber(Width) / tonumber(Height)
			Ratio.DominantAxis = Enum.DominantAxis.Width
			Ratio.Parent = Picture
		end

		return Picture
	end

	--// ------------------------------------------------------------------
	--// Popup / Dialog
	--// Options:Popup({ Title, Content, Buttons = { { Title, Variant = "Primary"|"Tertiary", Callback } } })
	--// ------------------------------------------------------------------
	function Options:Popup(Settings: { Title: string, Content: string, Buttons: {} })
		Settings = Settings or {}

		local Sink = NewSink()
		local Panel = Instance.new("Frame")
		SetProperty(Panel, {
			Name = "PopupPanel",
			Active = true,
			AnchorPoint = Vector2.new(.5, .5),
			Position = UDim2.fromScale(.5, .5),
			Size = UDim2.fromOffset(300, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = Theme.Secondary,
			BorderSizePixel = 0,
			Parent = Sink,
		})
		Corner(Panel, 8)
		Stroke(Panel)

		local Pad = Instance.new("UIPadding")
		Pad.PaddingLeft, Pad.PaddingRight, Pad.PaddingTop, Pad.PaddingBottom = UDim.new(0, 14), UDim.new(0, 14), UDim.new(0, 14), UDim.new(0, 14)
		Pad.Parent = Panel

		local List = Instance.new("UIListLayout")
		List.SortOrder = Enum.SortOrder.LayoutOrder
		List.Padding = UDim.new(0, 8)
		List.Parent = Panel

		local PopupTitle = Label(Panel, "Title", Settings.Title or "", TitleRef, Theme.Title)
		SetProperty(PopupTitle, { Size = UDim2.new(1, 0, 0, 20), TextSize = TitleRef.TextSize + 2, LayoutOrder = 1 })

		local Content = Label(Panel, "Description", Settings.Content or Settings.Description or "", DescRef, Theme.Description)
		SetProperty(Content, {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			TextTruncate = Enum.TextTruncate.None,
			TextYAlignment = Enum.TextYAlignment.Top,
			LayoutOrder = 2,
		})

		local Object = {}
		function Object:Close() Destroy(Sink) end

		for Index, Info in ipairs(Settings.Buttons or {}) do
			local Primary = Info.Variant == "Primary"
			local Button = Instance.new("TextButton")
			SetProperty(Button, {
				Name = Info.Title or "Button",
				LayoutOrder = 2 + Index,
				Size = UDim2.new(1, 0, 0, 32),
				BackgroundColor3 = (Primary and Accent) or Theme.Interactables,
				BorderSizePixel = 0,
				Text = Info.Title or "",
				FontFace = TitleRef.FontFace,
				TextSize = 13,
				TextColor3 = (Primary and Color3.new(1, 1, 1)) or Theme.Title,
				Parent = Panel,
			})
			Corner(Button, 5)

			Connect(Button.MouseButton1Click, function()
				if Info.Callback then Info.Callback() end
				Object:Close()
			end)
		end

		Elevate(Sink, 99)
		Tween(Sink, .2, { BackgroundTransparency = .55 })

		return Object
	end

