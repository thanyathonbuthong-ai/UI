	function Options:AddKeybind(Settings: { Title: string, Description: string, Tab: Instance, Callback: any }) 
		local Dropdown = Clone(Components["Keybind"]);
		local Title, Description = Options:GetLabels(Dropdown);
		local Bind = Dropdown["Main"].Options;
		
		local Mouse = { Enum.UserInputType.MouseButton1, Enum.UserInputType.MouseButton2, Enum.UserInputType.MouseButton3 }; 
		local Types = { 
			["Mouse"] = "Enum.UserInputType.MouseButton", 
			["Key"] = "Enum.KeyCode." 
		}
		
		Connect(Dropdown.MouseButton1Click, function()
			local Time = tick();
			local Detect, Finished
			
			SetProperty(Bind, { Text = "..." });
			Detect = Connect(game.UserInputService.InputBegan, function(Key, Focused) 
				local InputType = (Key.UserInputType);
				
				if not Finished and not Focused then
					Finished = (true)
					
					if table.find(Mouse, InputType) then
						Settings.Callback(Key);
						SetProperty(Bind, {
							Text = tostring(InputType):gsub(Types.Mouse, "MB")
						})
					elseif InputType == Enum.UserInputType.Keyboard then
						Settings.Callback(Key);
						SetProperty(Bind, {
							Text = tostring(Key.KeyCode):gsub(Types.Key, "")
						})
					end
				end 
			end)
		end)

		Animations:Component(Dropdown);
		SetProperty(Title, { Text = Settings.Title });
		SetProperty(Description, { Text = Settings.Description });
		SetProperty(Dropdown, {
			Name = Settings.Title,
			Parent = Settings.Tab,
			Visible = true,
		})
	end

	--// Dropdown
	--// Single : Callback(value)            (same as before)
	--// Multi  : Multi = true  ->  Callback({ value1, value2, ... })
	--// Extras : Default = "A" | { "A", "B" },  AllowNone = true,  Options may be a list { "A", "B" } or a dictionary { Name = value }
	function Options:AddDropdown(Settings: { Title: string, Description: string, Options: {}, Tab: Instance, Callback: any, Multi: boolean?, AllowNone: boolean?, Default: any }) 
		local Dropdown = Clone(Components["Dropdown"]);
		local Title, Description = Options:GetLabels(Dropdown);
		local Text = Dropdown["Main"].Options;

		local Multi = Settings.Multi == true
		local Entries, Chosen, Current = {}, {}, nil

		--// Ordered list of entries (list -> keeps order, dictionary -> sorted by name)
		if #Settings.Options > 0 then
			for _, Option in ipairs(Settings.Options) do
				table.insert(Entries, { Name = tostring(Option), Value = Option })
			end
		else
			for Name, Option in next, Settings.Options do
				table.insert(Entries, { Name = tostring(Name), Value = Option })
			end

			table.sort(Entries, function(A, B) return A.Name < B.Name end)
		end

		local function Pick(Value)
			for _, Entry in ipairs(Entries) do
				if Entry.Name == tostring(Value) or Entry.Value == Value then
					return Entry
				end
			end
		end

		local function Count()
			local Total = 0
			for _ in next, Chosen do Total = Total + 1 end
			return Total
		end

		local function Values()
			local List = {}

			for _, Entry in ipairs(Entries) do
				if Chosen[Entry.Name] then table.insert(List, Entry.Value) end
			end

			return List
		end

		local function Refresh()
			if Multi then
				local Names = {}

				for _, Entry in ipairs(Entries) do
					if Chosen[Entry.Name] then table.insert(Names, Entry.Name) end
				end

				Text.TextTruncate = Enum.TextTruncate.AtEnd
				Text.Text = (#Names > 0 and table.concat(Names, ", ")) or "None"
			end
		end

		--// Default selection (does not fire the callback)
		if Settings.Default ~= nil then
			local Defaults = (type(Settings.Default) == "table" and Settings.Default) or { Settings.Default }

			for _, Value in ipairs(Defaults) do
				local Entry = Pick(Value)

				if Entry then
					if Multi then
						Chosen[Entry.Name] = true
					else
						Current = Entry
						Text.Text = Entry.Name
					end
				end
			end
		end

		Refresh()

		local Opened --// the list that is currently open (nil = closed)

		local function CloseList()
			local Example = Opened
			if not Example then return end

			Opened = nil
			Tween(BG, .25, { BackgroundTransparency = 1 });

			task.spawn(function()
				Animations:Close(Example);
				task.wait(2)
				Destroy(Example);
			end)
		end

		Connect(Dropdown.MouseButton1Click, function()
			--// press again = close
			if Opened then
				CloseList()
				return
			end

			local Example = Clone(Examples["DropdownExample"]);
			local Buttons = Example["Top"]["Buttons"];
			Opened = Example

			Tween(BG, .25, { BackgroundTransparency = 0.6 });
			SetProperty(Example, { Parent = Window });
			Animations:Open(Example, 0, true)

			for Index, Button in next, Buttons:GetChildren() do
				if Button:IsA("TextButton") then
					Animations:Component(Button, true)

					Connect(Button.MouseButton1Click, CloseList)
				end
			end

			for _, Entry in ipairs(Entries) do
				local Name, Option = Entry.Name, Entry.Value
				local Button = Clone(Examples["DropdownButtonExample"]);
				local Title, Description = Options:GetLabels(Button);
				local Selected = Button["Value"];

				SetProperty(Title, { Text = Name });
				SetProperty(Button, { Parent = Example.ScrollingFrame, Visible = true });
				Destroy(Description);

				if Multi then
					--// check mark on the right side of selected items
					local Mark = Instance.new("TextLabel")
					SetProperty(Mark, {
						Name = "Check",
						AnchorPoint = Vector2.new(1, .5),
						Position = UDim2.new(1, -12, .5, 0),
						Size = UDim2.fromOffset(18, 18),
						BackgroundTransparency = 1,
						Text = "✓",
						Font = Enum.Font.GothamBold,
						TextSize = 16,
						TextColor3 = Accent,
						Visible = Chosen[Name] == true,
						Parent = Button,
					})

					local function Paint()
						Mark.Visible = Chosen[Name] == true
						Tween(Button, .2, { BackgroundColor3 = (Chosen[Name] and Theme.Interactables) or Theme.Component });
					end

					Paint()

					Connect(Button.InputBegan, function()
						if not Chosen[Name] then
							Tween(Button, .2, { BackgroundColor3 = Color(Theme.Component, 5, Setup.ThemeMode) });
						end
					end)

					Connect(Button.InputEnded, Paint)

					Connect(Button.MouseButton1Click, function()
						if Chosen[Name] then
							if not Settings.AllowNone and Count() <= 1 then return end
							Chosen[Name] = nil
						else
							Chosen[Name] = true
						end

						Paint()
						Refresh()

						if Settings.Callback then Settings.Callback(Values()) end
					end)
				else
					Animations:Component(Button);

					Connect(Button.MouseButton1Click, function() 
						local NewValue = not Selected.Value 

						if NewValue then
							Tween(Button, .25, { BackgroundColor3 = Theme.Interactables });
							Settings.Callback(Option)
							Text.Text = Name
							Current = Entry

							for _, Others in next, Example:GetChildren() do
								if Others:IsA("TextButton") and Others ~= Button then
									Others.BackgroundColor3 = Theme.Component
								end
							end
						else
							Tween(Button, .25, { BackgroundColor3 = Theme.Component });
						end

						Selected.Value = NewValue
						CloseList()
					end)
				end
			end
		end)

		Animations:Component(Dropdown);
		SetProperty(Title, { Text = Settings.Title });
		SetProperty(Description, { Text = Settings.Description });
		SetProperty(Dropdown, {
			Name = Settings.Title,
			Parent = Settings.Tab,
			Visible = true,
		})

		local Object = { Instance = Dropdown }

		function Object:Get()
			if Multi then return Values() end
			return Current and Current.Value
		end

		function Object:Set(Value, Silent)
			if Multi then
				Chosen = {}

				for _, Item in ipairs((type(Value) == "table" and Value) or { Value }) do
					local Entry = Pick(Item)
					if Entry then Chosen[Entry.Name] = true end
				end

				Refresh()
				if not Silent and Settings.Callback then Settings.Callback(Values()) end
			else
				local Entry = Pick(Value)

				if Entry then
					Current = Entry
					Text.Text = Entry.Name
					if not Silent and Settings.Callback then Settings.Callback(Entry.Value) end
				end
			end
		end

		return Object
	end

	function Options:AddSlider(Settings: { Title: string, Description: string, MaxValue: number, AllowDecimals: boolean, DecimalAmount: number, Tab: Instance, Callback: any }) 
		local Slider = Clone(Components["Slider"]);
		local Title, Description = Options:GetLabels(Slider);

		local Main = Slider["Slider"];
		local Amount = Main["Main"].Input;
		local Slide = Main["Slide"];
		local Fire = Slide["Fire"];
		local Fill = Slide["Highlight"];
		local Circle = Fill["Circle"];

		local Active = false
		local Value = 0
		
		local SetNumber = function(Number)
			if Settings.AllowDecimals then
				local Power = 10 ^ (Settings.DecimalAmount or 2)
				Number = math.floor(Number * Power + 0.5) / Power
			else
				Number = math.round(Number)
			end
			
			return Number
		end

		local Update = function(Number)
			local Scale = (Player.Mouse.X - Slide.AbsolutePosition.X) / Slide.AbsoluteSize.X			
			Scale = (Scale > 1 and 1) or (Scale < 0 and 0) or Scale
			
			if Number then
				Number = (Number > Settings.MaxValue and Settings.MaxValue) or (Number < 0 and 0) or Number
			end
			
			Value = SetNumber(Number or (Scale * Settings.MaxValue))
			Amount.Text = Value
			Fill.Size = UDim2.fromScale((Number and Number / Settings.MaxValue) or Scale, 1)
			Settings.Callback(Value)
		end

		local Activate = function()
			Active = true

			repeat task.wait()
				Update()
			until not Active
		end
		
		Connect(Amount.FocusLost, function() 
			Update(tonumber(Amount.Text) or 0)
		end)

		Connect(Fire.MouseButton1Down, Activate)
		Connect(Services.Input.InputEnded, function(Input) 
			if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
				Active = false
			end
		end)

		Fill.Size = UDim2.fromScale(Value, 1);
		Animations:Component(Slider);
		SetProperty(Title, { Text = Settings.Title });
		SetProperty(Description, { Text = Settings.Description });
		SetProperty(Slider, {
			Name = Settings.Title,
			Parent = Settings.Tab,
			Visible = true,
		})
	end

