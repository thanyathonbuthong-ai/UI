		local BoxHeight = math.min(Lines * 16 + 12, Settings.MaxHeight or 180)

		local Row, _, _, Bottom = NewRow(Settings, 0, 70, true)
		Bottom = math.max(Bottom, 38)
		Row.Size = UDim2.new(RowWidth.Scale, RowWidth.Offset, 0, Bottom + BoxHeight + 12)

		local Holder = Instance.new("ScrollingFrame")
		SetProperty(Holder, {
			Name = "CodeHolder",
			Position = UDim2.fromOffset(14, Bottom),
			Size = UDim2.new(1, -28, 0, BoxHeight),
			BackgroundColor3 = Theme.Interactables,
