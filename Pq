			BorderSizePixel = 0,
			Size = (InGroup and UDim2.fromOffset(Amount, 1)) or UDim2.new(RowWidth.Scale, RowWidth.Offset, 0, Amount),
			Parent = Settings.Tab,
		})

		return Space
	end

