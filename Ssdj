local function baseElement(parent, name, height)
	local f = new("Frame", {
		Name = name,
		BorderSizePixel = 0,
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0.9,
		Size = UDim2.new(1, -26, 0, height),
	}, parent)
	corner(f, 7)
	local s = stroke(f)
	return f, s
end

local function commonFunctions(frame, uiStroke, label, field)
	local t = {
		frame;
		setOutlineColor = function(c) uiStroke.Color = c end;
		setBackgroundColor = function(c) frame.BackgroundColor3 = c end;
		setTransparency = function(n) frame.BackgroundTransparency = n end;
		destroy = function() frame:Destroy() end;
	}
	if label then
		t.setText = function(txt) label.Text = txt end
		t.getText = function() return label.Text end
	end
	return t
end

