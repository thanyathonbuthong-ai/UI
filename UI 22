--[[
================================================================================
  SlicedUI Library v1.0
  ---------------------------------------------------------------------------
  Standalone UI library extracted & refactored from the "Slicedz / Sticky"
  script UI. Dark-red theme, draggable + resizable windows, tab system,
  toggles, buttons, sliders, dropdowns, keybinds, text inputs, labels,
  sections, and toast notifications.

  Usage:
      local SlicedUI = loadstring(game:HttpGet("..."))()
      local Window = SlicedUI:CreateWindow({ Name = "My Hub" })
      local Tab = Window:CreateTab("Main")
      Tab:CreateToggle({ Name = "Auto Farm", Default = false, Callback = function(v) end })
      Tab:CreateButton({ Name = "Kill All", Callback = function() end })
      Tab:CreateSlider({ Name = "Speed", Min = 16, Max = 200, Default = 50, Callback = function(v) end })
      Tab:CreateDropdown({ Name = "Target", Options = {"A","B","C"}, Callback = function(v) end })
      Tab:CreateKeybind({ Name = "Menu Key", Default = "LeftControl", Callback = function(v) end })
      Tab:CreateInput({ Name = "Value", PlaceholderText = "0", Callback = function(v) end })
      Tab:CreateLabel("Hello world")
      Tab:CreateSection("Player")
      SlicedUI:Notify("Title", "Description text")
================================================================================
]]

local SlicedUI = {}
SlicedUI.__index = SlicedUI

