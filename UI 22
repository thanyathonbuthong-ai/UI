-- RebornUI.lua
-- Reborn-inspired reusable Roblox UI library
-- Soft pastel light-blue theme, touch-friendly window, draggable floating toggle.
-- Use in experiences you own or are authorized to develop.

local RebornUI = {}
RebornUI.__index = RebornUI

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

local Theme = {
    bg = Color3.fromRGB(240, 246, 252),
    panel = Color3.fromRGB(225, 235, 245),
    card = Color3.fromRGB(255, 255, 255),
    stroke = Color3.fromRGB(190, 210, 230),
    accent = Color3.fromRGB(120, 180, 235),
    accentBright = Color3.fromRGB(80, 150, 220),
    accentDim = Color3.fromRGB(205, 225, 245),
    text = Color3.fromRGB(45, 60, 80),
    dim = Color3.fromRGB(120, 140, 165),
    off = Color3.fromRGB(200, 215, 230),
    green = Color3.fromRGB(100, 200, 160),
}

local function create(className, props, parent)
    local obj = Instance.new(className)
    for k, v in pairs(props or {}) do obj[k] = v end
    obj.Parent = parent
    return obj
end

local function corner(obj, radius)
    create("UICorner", {CornerRadius = UDim.new(0, radius or 8)}, obj)
end

local function outline(obj, color, thickness, transparency)
    return create("UIStroke", {
        Color = color or Theme.stroke,
        Thickness = thickness or 1.2,
        Transparency = transparency or 0.2,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, obj)
end

local function tween(obj, props, duration)
    TweenService:Create(obj, TweenInfo.new(duration or 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function textLabel(parent, text, size, color)
    return create("TextLabel", {
        BackgroundTransparency = 1,
        Text = tostring(text or ""),
        TextSize = size or 13,
        TextColor3 = color or Theme.text,
        Font = Enum.Font.SourceSansBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
    }, parent)
end

local function getGuiParent()
    local ok, hui = pcall(function()
        if type(gethui) == "function" then return gethui() end
    end)
    if ok and typeof(hui) == "Instance" then return hui end
    local ok2, core = pcall(function() return game:GetService("CoreGui") end)
    if ok2 and typeof(core) == "Instance" then return core end
    return LocalPlayer:WaitForChild("PlayerGui")
end

local function makeDraggable(handle, target)
    local dragging, dragInput, startPos, startPointer
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startPointer = input.Position
            startPos = target.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input == dragInput or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - startPointer
            target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

function RebornUI.CreateWindow(options)
    options = options or {}
    local self = setmetatable({}, RebornUI)
    self.Title = options.Title or "REBORN"
    self.Size = options.Size or UDim2.fromOffset(640, 430)
    self.Tabs = {}
    self.CurrentTab = nil
    self.Collapsed = false
    self.Destroyed = false
    self.Theme = options.Theme or Theme

    local parent = options.Parent or getGuiParent()
    local old = parent:FindFirstChild(options.GuiName or "RebornLibrary")
    if old then old:Destroy() end

    self.Gui = create("ScreenGui", {
        Name = options.GuiName or "RebornLibrary",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = options.DisplayOrder or 1000,
    }, parent)

    self.Main = create("Frame", {
        Name = "Main",
        Size = self.Size,
        Position = UDim2.new(0.5, -self.Size.X.Offset/2, 0.5, -self.Size.Y.Offset/2),
        BackgroundColor3 = self.Theme.bg,
        BorderSizePixel = 0,
        Active = true,
    }, self.Gui)
    corner(self.Main, 12)
    outline(self.Main, self.Theme.stroke, 1.5, 0)

    self.Top = create("Frame", {
        Name = "TopBar", Size = UDim2.new(1, 0, 0, 38),
        BackgroundColor3 = self.Theme.panel, BorderSizePixel = 0,
    }, self.Main)
    corner(self.Top, 12)
    create("Frame", {
        Size = UDim2.new(1, 0, 0, 10), Position = UDim2.new(0,0,1,-10),
        BackgroundColor3 = self.Theme.panel, BorderSizePixel = 0,
    }, self.Top)

    local dot = create("Frame", {
        Size = UDim2.fromOffset(10,10), Position = UDim2.new(0,12,0.5,-5),
        BackgroundColor3 = self.Theme.accentBright, BorderSizePixel = 0,
    }, self.Top)
    corner(dot, 5)

    local title = textLabel(self.Top, self.Title, 15, self.Theme.text)
    title.Position = UDim2.new(0, 28, 0, 0)
    title.Size = UDim2.new(1, -100, 1, 0)

    self.CollapseButton = create("TextButton", {
        Size = UDim2.fromOffset(26,24), Position = UDim2.new(1,-32,0.5,-12),
        BackgroundColor3 = self.Theme.card, Text = "–", TextColor3 = self.Theme.text,
        TextSize = 16, Font = Enum.Font.SourceSansBold, AutoButtonColor = false,
    }, self.Top)
    corner(self.CollapseButton, 6)
    outline(self.CollapseButton, self.Theme.stroke, 1, 0.3)

    self.Nav = create("Frame", {
        Name = "TabBar", Size = UDim2.new(1,-20,0,32), Position = UDim2.new(0,10,1,-38),
        BackgroundColor3 = self.Theme.panel, BorderSizePixel = 0,
    }, self.Main)
    corner(self.Nav, 8)
    outline(self.Nav, self.Theme.stroke, 1, 0.3)
    create("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0,6),
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        VerticalAlignment = Enum.VerticalAlignment.Center,
    }, self.Nav)

    self.Content = create("Frame", {
        Name = "Content", Size = UDim2.new(1,-20,1,-86), Position = UDim2.new(0,10,0,44),
        BackgroundTransparency = 1,
    }, self.Main)

    self.FloatButton = create("TextButton", {
        Name = "RebornFloatButton", Size = UDim2.fromOffset(44,44),
        Position = UDim2.new(0.04,0,0.25,0), BackgroundColor3 = self.Theme.panel,
        Text = options.FloatText or "R", TextColor3 = self.Theme.accentBright,
        TextSize = 17, Font = Enum.Font.SourceSansBold, Active = true, AutoButtonColor = false,
    }, self.Gui)
    corner(self.FloatButton, 22)
    outline(self.FloatButton, self.Theme.accent, 1.5, 0)

    self.FloatButton.Activated:Connect(function()
        self.Main.Visible = not self.Main.Visible
    end)
    makeDraggable(self.Top, self.Main)
    makeDraggable(self.FloatButton, self.FloatButton)

    self.CollapseButton.Activated:Connect(function()
        self.Collapsed = not self.Collapsed
        self.Content.Visible = not self.Collapsed
        self.Nav.Visible = not self.Collapsed
        self.CollapseButton.Text = self.Collapsed and "+" or "–"
        tween(self.Main, {Size = UDim2.new(self.Size.X.Scale, self.Size.X.Offset, self.Size.Y.Scale,
            self.Collapsed and 38 or self.Size.Y.Offset)}, 0.18)
    end)

    self._rightShift = UIS.InputBegan:Connect(function(input, processed)
        if not processed and input.KeyCode == Enum.KeyCode.RightShift then
            self.Main.Visible = not self.Main.Visible
        end
    end)

    function self:SetVisible(value) self.Main.Visible = value and true or false end
    function self:Toggle() self.Main.Visible = not self.Main.Visible end
    function self:Destroy()
        if self.Destroyed then return end
        self.Destroyed = true
        if self._rightShift then self._rightShift:Disconnect() end
        if self.Gui then self.Gui:Destroy() end
    end

    return self
end

function RebornUI:CreateTab(name)
    assert(not self.Destroyed, "Window has been destroyed")
    name = tostring(name or ("Tab" .. (#self.Tabs + 1)))
    local tab = {Name = name, Sections = {}}
    tab.Button = create("TextButton", {
        Name = name .. "Tab", Size = UDim2.new(0.15,0,0,24),
        BackgroundColor3 = self.Theme.card, Text = name:upper(),
        TextColor3 = self.Theme.dim, TextSize = 10,
        Font = Enum.Font.SourceSansBold, AutoButtonColor = false,
    }, self.Nav)
    corner(tab.Button, 6)
    outline(tab.Button, self.Theme.stroke, 1, 0.4)
    tab.Page = create("ScrollingFrame", {
        Name = name .. "Page", Size = UDim2.fromScale(1,1),
        BackgroundColor3 = self.Theme.panel, BorderSizePixel = 0,
        ScrollBarThickness = 3, ScrollBarImageColor3 = self.Theme.accent,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
    }, self.Content)
    corner(tab.Page, 8)
    outline(tab.Page, self.Theme.stroke, 1, 0.3)
    create("UIPadding", {
        PaddingTop = UDim.new(0,8), PaddingBottom = UDim.new(0,8),
        PaddingLeft = UDim.new(0,8), PaddingRight = UDim.new(0,8),
    }, tab.Page)
    create("UIListLayout", {Padding = UDim.new(0,8), SortOrder = Enum.SortOrder.LayoutOrder}, tab.Page)

    function tab:CreateSection(titleText)
        local section = {Name = titleText or "Section"}
        section.Frame = create("Frame", {
            Name = "Section", Size = UDim2.new(1,-2,0,40),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = self.Theme and self.Theme.card or Theme.card,
            BorderSizePixel = 0,
        }, tab.Page)
        corner(section.Frame, 8)
        outline(section.Frame, Theme.stroke, 1, 0.35)
        local heading = textLabel(section.Frame, section.Name, 13, Theme.text)
        heading.Position = UDim2.new(0,10,0,4)
        heading.Size = UDim2.new(1,-20,0,22)
        local body = create("Frame", {
            Name = "Controls", Position = UDim2.new(0,8,0,30),
            Size = UDim2.new(1,-16,0,0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
        }, section.Frame)
        create("UIListLayout", {Padding = UDim.new(0,6), SortOrder = Enum.SortOrder.LayoutOrder}, body)
        create("UIPadding", {PaddingBottom = UDim.new(0,8)}, body)
        section.Body = body

        local function row(labelText, height)
            local b = create("TextButton", {
                Size = UDim2.new(1,0,0,height or 30), BackgroundColor3 = Theme.card,
                Text = "", AutoButtonColor = false,
            }, body)
            corner(b, 6)
            local st = outline(b, Theme.stroke, 1, 0.4)
            local label = textLabel(b, labelText, 11, Theme.text)
            label.Position = UDim2.new(0,9,0,0)
            label.Size = UDim2.new(1,-18,1,0)
            return b, label, st
        end

        function section:CreateLabel(text)
            local holder = create("Frame", {Size = UDim2.new(1,0,0,25), BackgroundTransparency = 1}, body)
            local lbl = textLabel(holder, text, 11, Theme.dim)
            lbl.Size = UDim2.fromScale(1,1)
            return {SetText = function(_, v) lbl.Text = tostring(v) end}
        end

        function section:CreateButton(text, callback)
            local b = row(text, 30)
            b.Activated:Connect(function() if callback then callback() end end)
            b.MouseEnter:Connect(function() tween(b, {BackgroundColor3 = Theme.accentDim}) end)
            b.MouseLeave:Connect(function() tween(b, {BackgroundColor3 = Theme.card}) end)
            return {Button = b}
        end

        function section:CreateToggle(text, default, callback)
            local value = default and true or false
            local b, lbl, st = row(text, 30)
            lbl.Size = UDim2.new(1,-48,1,0)
            local switch = create("Frame", {
                Size = UDim2.fromOffset(28,15), Position = UDim2.new(1,-36,0.5,-7.5),
                BackgroundColor3 = value and Theme.accentBright or Theme.off, BorderSizePixel = 0,
            }, b)
            corner(switch, 8)
            local knob = create("Frame", {
                Size = UDim2.fromOffset(11,11),
                Position = value and UDim2.new(1,-13,0.5,-5.5) or UDim2.new(0,2,0.5,-5.5),
                BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0,
            }, switch)
            corner(knob, 6)
            local function refresh(animate)
                tween(switch, {BackgroundColor3 = value and Theme.accentBright or Theme.off})
                tween(knob, {Position = value and UDim2.new(1,-13,0.5,-5.5) or UDim2.new(0,2,0.5,-5.5)})
                st.Color = value and Theme.accentBright or Theme.stroke
            end
            b.Activated:Connect(function()
                value = not value
                refresh(true)
                if callback then callback(value) end
            end)
            return {
                GetValue = function() return value end,
                SetValue = function(_, v) value = v and true or false; refresh(true); if callback then callback(value) end end,
            }
        end

        function section:CreateSlider(text, min, max, default, callback)
            min, max = min or 0, max or 100
            local value = math.clamp(default or min, min, max)
            local holder = create("Frame", {Size = UDim2.new(1,0,0,54), BackgroundColor3 = Theme.card}, body)
            corner(holder, 6); outline(holder, Theme.stroke, 1, 0.4)
            local lbl = textLabel(holder, text, 11, Theme.text)
            lbl.Position = UDim2.new(0,9,0,3); lbl.Size = UDim2.new(1,-18,0,20)
            local val = textLabel(holder, tostring(value), 11, Theme.accentBright)
            val.TextXAlignment = Enum.TextXAlignment.Right
            val.Position = UDim2.new(0,9,0,3); val.Size = UDim2.new(1,-18,0,20)
            local rail = create("Frame", {Position = UDim2.new(0,10,0,32), Size = UDim2.new(1,-20,0,7), BackgroundColor3 = Theme.off}, holder)
            corner(rail, 4)
            local fill = create("Frame", {Size = UDim2.new((value-min)/math.max(max-min,1),0,1,0), BackgroundColor3 = Theme.accentBright}, rail)
            corner(fill, 4)
            local knob = create("Frame", {Size = UDim2.fromOffset(13,13), AnchorPoint = Vector2.new(0.5,0.5), Position = UDim2.new((value-min)/math.max(max-min,1),0,0.5,0), BackgroundColor3 = Theme.accentBright}, rail)
            corner(knob, 7)
            local dragging = false
            local function setFromX(x)
                local alpha = math.clamp((x - rail.AbsolutePosition.X) / rail.AbsoluteSize.X, 0, 1)
                value = math.floor(min + (max-min)*alpha + 0.5)
                fill.Size = UDim2.new(alpha,0,1,0); knob.Position = UDim2.new(alpha,0,0.5,0)
                val.Text = tostring(value)
                if callback then callback(value) end
            end
            rail.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; setFromX(input.Position.X) end
            end)
            UIS.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then setFromX(input.Position.X) end
            end)
            UIS.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
            end)
            return {GetValue = function() return value end, SetValue = function(_, v) value = math.clamp(v,min,max); setFromX(rail.AbsolutePosition.X + rail.AbsoluteSize.X*((value-min)/math.max(max-min,1))) end}
        end

        function section:CreateDropdown(text, items, callback)
            items = items or {}
            local selected = items[1]
            local expanded = false
            local b, lbl = row(text .. ": " .. tostring(selected or "Select"), 30)
            local list = create("Frame", {
                Size = UDim2.new(1,0,0,0), AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundColor3 = Theme.panel, Visible = false,
            }, body)
            corner(list, 6); outline(list, Theme.stroke, 1, 0.4)
            create("UIListLayout", {Padding = UDim.new(0,3)}, list)
            local function choose(item)
                selected = item; lbl.Text = text .. ": " .. tostring(item)
                list.Visible = false; expanded = false
                if callback then callback(item) end
            end
            for _, item in ipairs(items) do
                local option = create("TextButton", {Size = UDim2.new(1,0,0,27), BackgroundColor3 = Theme.card, Text = tostring(item), TextColor3 = Theme.text, TextSize = 11, Font = Enum.Font.SourceSansBold, AutoButtonColor = false}, list)
                corner(option, 5)
                option.Activated:Connect(function() choose(item) end)
            end
            b.Activated:Connect(function() expanded = not expanded; list.Visible = expanded end)
            return {GetValue = function() return selected end, SetValue = function(_, item) choose(item) end}
        end

        function section:CreateTextbox(text, placeholder, callback)
            local holder = create("Frame", {Size = UDim2.new(1,0,0,54), BackgroundColor3 = Theme.card}, body)
            corner(holder, 6); outline(holder, Theme.stroke, 1, 0.4)
            local lbl = textLabel(holder, text, 11, Theme.text)
            lbl.Position = UDim2.new(0,9,0,2); lbl.Size = UDim2.new(1,-18,0,20)
            local input = create("TextBox", {
                Position = UDim2.new(0,8,0,25), Size = UDim2.new(1,-16,0,23),
                BackgroundColor3 = Theme.panel, Text = "", PlaceholderText = placeholder or "Enter text...",
                PlaceholderColor3 = Theme.dim, TextColor3 = Theme.text, TextSize = 11,
                Font = Enum.Font.SourceSans, ClearTextOnFocus = false,
            }, holder)
            corner(input, 5)
            create("UIPadding", {PaddingLeft = UDim.new(0,7), PaddingRight = UDim.new(0,7)}, input)
            input.FocusLost:Connect(function(enterPressed) if callback then callback(input.Text, enterPressed) end end)
            return {GetValue = function() return input.Text end, SetValue = function(_, v) input.Text = tostring(v) end}
        end

        table.insert(tab.Sections, section)
        return section
    end

    tab.Button.Activated:Connect(function() self:SelectTab(name) end)
    table.insert(self.Tabs, tab)
    if not self.CurrentTab then self:SelectTab(name) end
    return tab
end

function RebornUI:SelectTab(name)
    for _, tab in ipairs(self.Tabs) do
        local active = tab.Name == name
        tab.Page.Visible = active
        tab.Button.BackgroundColor3 = active and self.Theme.accentDim or self.Theme.card
        tab.Button.TextColor3 = active and self.Theme.accentBright or self.Theme.dim
    end
    self.CurrentTab = name
end

return RebornUI
