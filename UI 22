    do local g = Instance.new("UIGradient"); g.Color = ColorSequence.new(theme.Accent, theme.Accent); g.Transparency = NumberSequence.new(0.2, 0.85); g.Parent = div end

    -- Content area (paged)
    local contentFrame = Instance.new("Frame")
    contentFrame.Name = "PagedContent"
    contentFrame.Position = UDim2.new(0, 13, 0, 72)
    contentFrame.Size = UDim2.new(1, -128, 1, -86)
    contentFrame.BackgroundTransparency = 1
    contentFrame.ZIndex = 2
    contentFrame.Parent = frame
    self.ContentFrame = contentFrame

    -- Side tab rail
    local tabRail = Instance.new("Frame"); tabRail.Name = "TabRail"; tabRail.ZIndex = 8
    tabRail.Position = UDim2.new(1, -100, 0, 72); tabRail.Size = UDim2.new(0, 88, 1, -86)
    tabRail.BackgroundTransparency = 1; tabRail.Parent = frame
    self.TabRail = tabRail
    local tabBg = Instance.new("Frame"); tabBg.Size = UDim2.new(1, 0, 1, 0); tabBg.BackgroundColor3 = Color3.fromRGB(5, 5, 7)
    tabBg.BackgroundTransparency = 0.15; tabBg.BorderSizePixel = 0; tabBg.Parent = tabRail
    Instance.new("UICorner", tabBg).CornerRadius = UDim.new(0, 10)

    -- Tab highlight (animated)
    local tabHL = Instance.new("Frame"); tabHL.ZIndex = 8; tabHL.Size = UDim2.new(0.999991, 0, 0, 30)
    tabHL.BackgroundColor3 = theme.Accent; tabHL.BackgroundTransparency = 0.82; tabHL.BorderSizePixel = 0; tabHL.Parent = tabRail
    Instance.new("UICorner", tabHL).CornerRadius = UDim.new(0, 7)
    do local s = Instance.new("UIStroke"); s.Color = theme.Accent; s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Parent = tabHL end
    self.TabHL = tabHL

    -- Notification frame
    local notifFrame = Instance.new("Frame"); notifFrame.Position = UDim2.new(1, -262, 1, -396)
    notifFrame.Size = UDim2.new(0, 250, 0, 380); notifFrame.BackgroundTransparency = 1; notifFrame.Parent = gui
    do local l = Instance.new("UIListLayout"); l.Padding = UDim.new(0, 8); l.VerticalAlignment = Enum.VerticalAlignment.Bottom; l.SortOrder = Enum.SortOrder.LayoutOrder; l.Parent = notifFrame end
    self.NotifFrame = notifFrame

    -- Minimized pill
    local minPill = Instance.new("Frame"); minPill.Visible = false; minPill.Active = true; minPill.ZIndex = 40
    minPill.Position = UDim2.new(0, 24, 0.35, 0); minPill.Size = UDim2.new(0, 140, 0, 40)
    minPill.BackgroundColor3 = Color3.fromRGB(5, 5, 7); minPill.BackgroundTransparency = 0.02; minPill.BorderSizePixel = 0; minPill.Parent = gui
    Instance.new("UICorner", minPill).CornerRadius = UDim.new(0, 12)
    do
        local s = Instance.new("UIStroke"); s.Color = Color3.fromRGB(55, 57, 63); s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Transparency = 0.55; s.Parent = minPill
        local l = Instance.new("TextLabel"); l.Size = UDim2.new(1, 0, 1, 0); l.BackgroundTransparency = 1; l.Text = title; l.TextColor3 = theme.Accent; l.TextSize = 14; l.Font = Enum.Font.GothamBlack; l.Parent = minPill
        local b = Instance.new("TextButton"); b.ZIndex = 41; b.Size = UDim2.new(1, 0, 1, 0); b.BackgroundTransparency = 1; b.Text = ""; b.AutoButtonColor = false; b.Parent = minPill
        b.MouseButton1Click:Connect(function() minPill.Visible = false; frame.Visible = true end)
    end
    self.MinPill = minPill

    -- Tab switching
    self.CurrentTab = nil
    function self:SwitchTab(name)
        if self.CurrentTab == name then return end
        self.CurrentTab = name
        for tabName, tab in pairs(self.Tabs) do tab.Page.Visible = (tabName == name) end
        for tabName, btn in pairs(self.TabButtons) do
            local act = (tabName == name)
            btn.TextColor3 = act and theme.TEXT_WHITE or theme.TEXT_DIM
            btn.BackgroundTransparency = act and 0 or 0.28
            local st = btn:FindFirstChildOfClass("UIStroke")
            if st then st.Color = act and theme.Accent or theme.CARD_STROKE end
        end
        local ab = self.TabButtons[name]
        if ab then
            TweenService:Create(tabHL, TWEEN_MED, { Position = UDim2.new(ab.Position.X.Scale, ab.Position.X.Offset, ab.Position.Y.Scale, ab.Position.Y.Offset) }):Play()
        end
    end

    -- Minimize
    local function minimize() frame.Visible = false; minPill.Visible = true end
    minBtn.MouseButton1Click:Connect(minimize)
    self.Minimize = minimize
    self.Restore = function() minPill.Visible = false; frame.Visible = true end
    self.Toggle = function()
        if frame.Visible then minimize() else minPill.Visible = false; frame.Visible = true end
    end

    -- Dragging
    H.makeDrag(header, frame)
    H.makeDrag(minPill, minPill)

    -- Hide/show toggle key
    UserInputService.InputBegan:Connect(function(inp, gpe)
        if gpe then return end
        if inp.UserInputType == Enum.UserInputType.Keyboard and inp.KeyCode == toggleKey and not KeyListen.active then
            self:Toggle()
        end
    end)

    -- Intro animation
    frame.BackgroundTransparency = 1
    frame.Size = UDim2.new(0, width, 0, 0)
    task.defer(function()
        TweenService:Create(frame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(width, height), BackgroundTransparency = 0
        }):Play()
    end)

    return self
end

--// Create a tab on the window (auto-positioned in side rail)
function Window:CreateTab(name, tabText)
    tabText = tabText or name
    local order = #self.Tabs + 1
    local tab = Tab.new(self, name, order, order == 1)
    self.Tabs[name] = tab

    -- Tab button in rail
    local btn = Instance.new("TextButton")
    btn.Name = "Tab_" .. name
    btn.ZIndex = 9
    btn.Size = UDim2.new(1, 0, 0, 30)
    btn.Position = UDim2.new(0, 0, 0, (order - 1) * 40)
    btn.BackgroundColor3 = Color3.fromRGB(18, 19, 23)
    btn.BackgroundTransparency = (order == 1) and 0 or 0.28
    btn.BorderSizePixel = 0
    btn.Text = tabText
    btn.TextColor3 = (order == 1) and self.Theme.TEXT_WHITE or self.Theme.TEXT_DIM
    btn.TextSize = 9
    btn.Font = Enum.Font.GothamBold
    btn.AutoButtonColor = false
    btn.Parent = self.TabRail
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 7)
    local s = Instance.new("UIStroke"); s.Color = (order == 1) and self.Theme.Accent or self.Theme.CARD_STROKE
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Transparency = 0.25; s.Parent = btn
    self.TabButtons[name] = btn

    btn.MouseButton1Click:Connect(function() self:SwitchTab(name) end)

    if order == 1 then
        self.CurrentTab = name
        self.TabHL.Position = btn.Position
    end
    return tab
end

--// Notification (per-window, but Library:Notify uses first window or global)
function Window:Notify(text, duration)
    duration = duration or 3
    local theme = self.Theme
    local n = Instance.new("Frame"); n.Size = UDim2.new(1, 0, 0, 36); n.BackgroundColor3 = Color3.fromRGB(5, 5, 7); n.BackgroundTransparency = 0.05; n.BorderSizePixel = 0; n.Parent = self.NotifFrame
    Instance.new("UICorner", n).CornerRadius = UDim.new(0, 10)
    local ns = Instance.new("UIStroke"); ns.Color = theme.Accent; ns.Transparency = 0.5; ns.Parent = n
    local nl = Instance.new("TextLabel"); nl.Size = UDim2.new(1, -16, 1, 0); nl.Position = UDim2.new(0, 8, 0, 0)
    nl.BackgroundTransparency = 1; nl.Text = text; nl.TextColor3 = theme.TEXT_PRIMARY; nl.TextSize = 11; nl.Font = Enum.Font.GothamBold
    nl.TextXAlignment = Enum.TextXAlignment.Left; nl.Parent = n
    task.delay(duration, function()
        TweenService:Create(n, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
        TweenService:Create(nl, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
        TweenService:Create(ns, TweenInfo.new(0.4), { Transparency = 1 }):Play()
        task.delay(0.45, function() n:Destroy() end)
    end)
end

--// Global notify (attaches to most recently created window, or creates one)
Library._windows = {}
function Library:Notify(text, duration)
    local w = self._windows[#self._windows]
    if w then w:Notify(text, duration) end
end

local origCreateWindow = Library.CreateWindow
function Library:CreateWindow(opts)
    local w = origCreateWindow(self, opts)
    table.insert(self._windows, w)
    return w
end

return Library
