		ls.Thickness = 1; ls.Color = Theme.LockStrokeOff; ls.Transparency = 0.3
		self.Locked = false
		local function refreshLock()
			lockBtn.Text = self.Locked and "UNLOCK" or "LOCK"
			lockBtn.BackgroundColor3 = self.Locked and Theme.LockBgLocked or Theme.LockBg
			ls.Color = self.Locked and Theme.LockStrokeOn or Theme.LockStrokeOff
			ls.Transparency = self.Locked and 0.55 or 0.2
		end
		lockBtn.MouseButton1Click:Connect(function()
			self.Locked = not self.Locked
			refreshLock()
			if self.OnLockChanged then self.OnLockChanged(self.Locked) end
		end)
		refreshLock()
	end

	-- Close button
	local closeBtn
	if self.ShowClose then
		closeBtn = new("TextButton", {
			Name = "Close",
			Size = UDim2.new(0, 28, 0, 28),
			Position = UDim2.new(1, -36, 0.5, -14),
			BackgroundColor3 = Theme.CloseBg,
			BorderSizePixel = 0,
			Text = "X",
			TextColor3 = Theme.TextWhite,
			Font = Enum.Font.GothamBold,
			TextSize = 18,
			AutoButtonColor = true,
			ZIndex = 8,
			Parent = topBar,
		})
		new("UICorner", { CornerRadius = UDim.new(0, 7), Parent = closeBtn })
		local cs = Instance.new("UIStroke", closeBtn)
		cs.Thickness = 1; cs.Color = Theme.CloseStroke; cs.Transparency = 0.3
	end

	-- Tabs bar
	local tabsBar = new("Frame", {
		Name = "Tabs",
		Size = UDim2.new(1, -16, 0, 32),
		Position = UDim2.new(0, 8, 0, 52),
		BackgroundTransparency = 1,
		ZIndex = 5,
		Active = true,
		Parent = main,
	})
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = tabsBar,
	})
	self.TabsBar = tabsBar

	-- Content area
	local content = new("Frame", {
		Name = "Content",
		Size = UDim2.new(1, -16, 1, -96),
		Position = UDim2.new(0, 8, 0, 88),
		BackgroundTransparency = 1,
		ZIndex = 4,
		Active = true,
		ClipsDescendants = true,
		Parent = main,
	})
	self.Content = content

	-- Float button (shown when window closed)
	local floatBtn = new("Frame", {
		Name = "FloatButton",
		Size = UDim2.new(0, 52, 0, 52),
		Position = UDim2.new(0, 18, 0.5, -26),
		BackgroundColor3 = Theme.BgMain,
		BackgroundTransparency = 0.15,
		BorderSizePixel = 0,
		Visible = false,
		Active = true,
		ZIndex = 40,
		Parent = gui,
	})
	new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = floatBtn })
	addShimmerStroke(floatBtn, 1.4)
	local floatImage = new("ImageButton", {
		Size = UDim2.new(1, -8, 1, -8),
		Position = UDim2.new(0, 4, 0, 4),
		BackgroundTransparency = 1,
		Image = self.Logo,
		ScaleType = Enum.ScaleType.Fit,
		ZIndex = 41,
		Parent = floatBtn,
	})
	self.FloatButton = floatBtn

	local floatDragged = false
	floatImage.MouseButton1Click:Connect(function()
		if floatDragged then floatDragged = false; return end
		mainClip.Visible = true
		floatBtn.Visible = false
		if self.OnOpen then self.OnOpen() end
	end)

	if closeBtn then
		closeBtn.MouseButton1Click:Connect(function()
			mainClip.Visible = false
			floatBtn.Visible = true
			if self.OnClose then self.OnClose() end
		end)
	end

	-- Draggable setup
	loadPosition(mainClip, self.PosFile, centerPos())
	makeDraggable(mainClip, topBar, self.PosFile, function() return self.Locked end)
	loadPosition(floatBtn, self.FloatFile, UDim2.new(0, 18, 0.5, -26))
	makeDraggable(floatBtn, floatBtn, self.FloatFile)

	-- Track float drag vs click
	local floatDownPos
	floatImage.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			floatDownPos = input.Position
		end
	end)
	floatImage.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 and floatDownPos then
			if (input.Position - floatDownPos).Magnitude > 5 then
				floatDragged = true
			end
		end
	end)

	return self
end

function Window:SetScale(scale)
	self.Scale = scale
	self.UIScale.Scale = scale
end

function Window:SelectTab(name)
	for tabName, scroll in pairs(self.TabFrames) do
		scroll.Visible = (tabName == name)
	end
	for _, child in ipairs(self.TabsBar:GetChildren()) do
		if child:IsA("TextButton") then
			local active = child.Name == name
			child.BackgroundTransparency = active and 0.15 or 0.55
			child.BackgroundColor3 = active and Theme.TabActive or Theme.TabIdle
			child.TextColor3 = active and Theme.TextWhite or Theme.TextMuted
			local stroke = child:FindFirstChildWhichIsA("UIStroke")
			if stroke then
				stroke.Color = active and Theme.AccentPurple or Theme.TabStrokeIdle
				stroke.Thickness = active and 1.4 or 1
			end
		end
	end
end

function Window:CreateTab(tabName)
	local tab = setmetatable({
		Name = tabName,
		Window = self,
		Elements = {},
	}, { __index = Library._Tab })

	-- ScrollingFrame content
	local scroll = new("ScrollingFrame", {
		Name = tabName,
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Scrollbar,
		ScrollBarImageTransparency = 0.3,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Visible = false,
		Active = true,
		ZIndex = 4,
		Parent = self.Content,
	})
	new("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = scroll,
	})
	new("UIPadding", {
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 16),
		PaddingLeft = UDim.new(0, 2),
		PaddingRight = UDim.new(0, 6),
		Parent = scroll,
	})
	tab.Scroll = scroll
	self.TabFrames[tabName] = scroll

	-- Tab button
	local order = #self.Tabs + 1
	local btn = new("TextButton", {
		Name = tabName,
		Size = UDim2.new(0, 76, 1, 0),
		BackgroundColor3 = Theme.TabIdle,
		BackgroundTransparency = 0.4,
		BorderSizePixel = 0,
		Text = tabName,
		TextColor3 = Theme.TextMuted,
		Font = Enum.Font.GothamBold,
		TextSize = 10.5,
		AutoButtonColor = true,
		LayoutOrder = order,
		ZIndex = 6,
		Parent = self.TabsBar,
	})
	new("UICorner", { CornerRadius = UDim.new(0, 7), Parent = btn })
	new("UIStroke", {
		Color = Theme.TabStrokeIdle,
		Thickness = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = btn,
	})
	btn.MouseButton1Click:Connect(function()
		self:SelectTab(tabName)
	end)
	tab.Button = btn
	table.insert(self.Tabs, tab)

	if order == 1 then
		self:SelectTab(tabName)
	end

	return tab
end

-- Tab / element API ----------------------------------------------------------
Library._Tab = {}
local Tab = Library._Tab

function Tab:AddSection(text)
	layoutOrderCounter = layoutOrderCounter + 1
	local section = new("Frame", {
		Name = "Section_" .. text,
		ZIndex = 4,
		Size = UDim2.new(1, -6, 0, 20),
		BackgroundTransparency = 1,
		LayoutOrder = layoutOrderCounter,
		Parent = self.Scroll,
	})
	local indicator = new("Frame", {
		Name = "Indicator",
