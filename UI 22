    return { Get = function() return currentKey end, Set = function(k) currentKey = k; kb.Text = prettyKeyName(k) end }, r
end

--// Spacer / divider
function Tab:Spacer(height)
    local r = Instance.new("Frame"); r.Size = UDim2.new(1, 0, 0, height or 8); r.BackgroundTransparency = 1; r.Parent = self.Page
    return r
end

