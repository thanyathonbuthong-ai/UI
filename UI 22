--//==========================================================================
local function confirmDialog(screenGui, titleText, onYes)
    local overlay = Instance.new("ScreenGui")
    overlay.Name = "PulseConfirm_" .. HttpService:GenerateGUID(false)
    overlay.ResetOnSpawn = false
    overlay.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    overlay.DisplayOrder = 999
    overlay.IgnoreGuiInset = true
    pcall(function() if syn and syn.protect_gui then syn.protect_gui(overlay) end end)
    overlay.Parent = PlayerGui

    local backdrop = Instance.new("Frame")
    backdrop.Size = UDim2.new(1,0,1,0)
    backdrop.BackgroundColor3 = Color3.fromRGB(0,0,0)
    backdrop.BackgroundTransparency = 0.45
    backdrop.BorderSizePixel = 0
    backdrop.Parent = overlay

    local dialog = Instance.new("Frame")
    dialog.AnchorPoint = Vector2.new(0.5, 0.5)
    dialog.Position = UDim2.new(0.5, 0, 0.5, 0)
    dialog.Size = UDim2.new(0, 280, 0, 120)
    dialog.BackgroundColor3 = Color3.fromRGB(22,22,26)
    dialog.BorderSizePixel = 0
    dialog.Parent = overlay
    corner(dialog, 14)
    gradientStroke(dialog, Theme.white, 1.1, 0.18)

    local msg = Instance.new("TextLabel")
    msg.AnchorPoint = Vector2.new(0.5, 0)
    msg.Position = UDim2.new(0.5, 0, 0, 16)
    msg.Size = UDim2.new(1, -28, 0, 50)
    msg.BackgroundTransparency = 1
    msg.Text = titleText
    msg.TextColor3 = Color3.fromRGB(245,245,255)
    msg.TextStrokeColor3 = Color3.fromRGB(0,0,0)
    msg.TextStrokeTransparency = 0.4
    msg.TextSize = 13
    msg.Font = FONT_BOLD
    msg.TextWrapped = true
    msg.TextXAlignment = Enum.TextXAlignment.Center
    msg.Parent = dialog

    local function mkBtn(name, text, xAnchor, xPos, bg, txtColor, strokeCol, strokeTrans)
        local b = Instance.new("TextButton")
        b.Name = name
        b.AnchorPoint = Vector2.new(xAnchor, 1)
        b.Position = UDim2.new(0.5, xPos, 1, -14)
        b.Size = UDim2.new(0, 108, 0, 30)
        b.BackgroundColor3 = bg
        b.BorderSizePixel = 0
        b.Text = text
        b.TextColor3 = txtColor
        b.TextSize = 13
        b.Font = FONT_TITLE
        b.AutoButtonColor = false
        b.Parent = dialog
        corner(b, 8)
        gradientStroke(b, strokeCol, 1, strokeTrans)
        b.MouseEnter:Connect(function() tween(b, { BackgroundTransparency = 0.1 }) end)
        b.MouseLeave:Connect(function() tween(b, { BackgroundTransparency = 0 }) end)
        return b
    end

    local yes = mkBtn("Yes", "Yes", 1, -6,  Color3.fromRGB(232,232,238), Color3.fromRGB(0,0,0), Theme.white, 0.18)
    local no  = mkBtn("No",  "No",  0,  6,  Color3.fromRGB(38,38,44),    Color3.fromRGB(245,245,255), Theme.strokeSoft, 0.45)

    local closed = false
    local function close()
        if closed then return end
        closed = true
        tween(overlay, {}, TWEEN_INFO)
        overlay:Destroy()
    end
    yes.Activated:Connect(function() playClick(); close(); if onYes then onYes() end end)
    no.Activated:Connect(function() playClick(); close() end)
end

