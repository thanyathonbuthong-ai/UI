function Library:CreateWindow(options)
	options = options or {}
	local self = setmetatable({}, Window)

	self.Name       = options.Name or "HYPERION"
	self.Logo       = options.Logo or "rbxassetid://138799625480080"
	self.Background = options.Background or "rbxassetid://110499809323243"
	self.Width      = options.Width or 340
	self.Height     = options.Height or 480
	self.Scale      = options.Scale or 0.6
	self.Badge      = options.Badge          -- e.g. "DUELS" (nil to hide)
	self.ShowLock   = options.ShowLock ~= false
	self.ShowClose  = options.ShowClose ~= false
	self.PosFile    = options.PositionFile   -- e.g. "MyUIPos.txt" (nil = no save)
	self.FloatFile  = options.FloatFile      -- float button position file
	self.Tabs       = {}
	self.TabFrames  = {}
	self._closed    = false

	-- ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = options.GuiName or (self.Name .. "UI")
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = options.DisplayOrder or 60
	gui.Enabled = true
	pcall(function()
		if syn and syn.protect_gui then syn.protect_gui(gui) end
	end)
	if not pcall(function() gui.Parent = game:GetService("CoreGui") end) then
		gui.Parent = PlayerGui
	end
	self.Gui = gui

	local function centerPos()
		return UDim2.new(0.5, -(self.Width * self.Scale) / 2, 0.5, -(self.Height * self.Scale) / 2)
	end

	-- MainClip (draggable container)
	local mainClip = new("Frame", {
		Name = "MainClip",
		Size = UDim2.new(0, self.Width, 0, self.Height),
		Position = centerPos(),
		BackgroundColor3 = Theme.BgMain,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Active = true,
		Visible = true,
		Parent = gui,
	})
	new("UICorner", { CornerRadius = UDim.new(0, 14), Parent = mainClip })
	addShimmerStroke(mainClip, 1.6)
	self.UIScale = new("UIScale", { Scale = self.Scale, Parent = mainClip })
	self.MainClip = mainClip

	-- Main body
	local main = new("Frame", {
		Name = "Main",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = Theme.BgMain,
		BorderSizePixel = 0,
		Active = true,
		Parent = mainClip,
	})
	new("UICorner", { CornerRadius = UDim.new(0, 14), Parent = main })

	-- Background image
	new("ImageLabel", {
		Name = "BackgroundAsset",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Image = self.Background,
		ImageTransparency = 0.42,
		ScaleType = Enum.ScaleType.Crop,
		ZIndex = 1,
		Parent = main,
	})

	-- TopBar
	local topBar = new("Frame", {
		Name = "TopBar",
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundColor3 = Theme.TopBar,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		ZIndex = 5,
		Active = true,
		Parent = main,
	})
	new("UICorner", { CornerRadius = UDim.new(0, 14), Parent = topBar })
	-- square off the bottom of the rounded topbar
	new("Frame", {
		Size = UDim2.new(1, 0, 0, 14),
		Position = UDim2.new(0, 0, 1, -14),
		BackgroundColor3 = Theme.TopBar,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = topBar,
	})
	self.TopBar = topBar

	-- Logo + title
	new("ImageLabel", {
		Name = "TitleLogo",
		Size = UDim2.new(0, 26, 0, 26),
		Position = UDim2.new(0, 12, 0.5, -13),
		BackgroundTransparency = 1,
		Image = self.Logo,
		ScaleType = Enum.ScaleType.Fit,
		ZIndex = 6,
		Parent = topBar,
	})
	local title = new("TextLabel", {
		Name = "Title",
		Size = UDim2.new(0, 140, 0, 26),
		Position = UDim2.new(0, 44, 0.5, -13),
		BackgroundTransparency = 1,
		Text = string.upper(self.Name),
		TextColor3 = Theme.TextWhite,
		Font = Enum.Font.GothamBlack,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 7,
		Parent = topBar,
	})
