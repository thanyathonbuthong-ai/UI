-- Position persistence (optional, uses writefile/readfile when available)
local function savePosition(frame, fileName)
	if not fileName or not isfile or not writefile then return end
	pcall(function()
		local p = frame.Position
		writefile(fileName, string.format("%.4f,%.1f,%.4f,%.1f",
			p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset))
	end)
end

local function loadPosition(frame, fileName, fallback)
	if fileName and isfile and readfile and pcall(function() return isfile(fileName) end) and isfile(fileName) then
		local data = pcall(function() return readfile(fileName) end)
		if type(data) == "string" and data ~= "" then
			local parts = {}
			for m in string.gmatch(data, "[^,]+") do table.insert(parts, m) end
			if #parts >= 4 then
				local xs, xo, ys, yo = tonumber(parts[1]), tonumber(parts[2]), tonumber(parts[3]), tonumber(parts[4])
				if xs and xo and ys and yo
					and xs >= 0 and xs <= 1 and ys >= 0 and ys <= 1
					and math.abs(xo) < 100000 and math.abs(yo) < 100000 then
					frame.Position = UDim2.new(xs, xo, ys, yo)
					return
				end
			end
		end
	end
	if fallback then frame.Position = fallback end
end

local function makeDraggable(frame, handle, fileName, lockCheck)
	local dragging = false
	local startInput, startPos

	local function endDrag()
		if not dragging then return end
		savePosition(frame, fileName)
		dragging = false
	end

	handle.InputBegan:Connect(function(input)
		if dragging then return end
		if lockCheck and lockCheck() then return end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		dragging = true
		startInput = input.Position
		startPos = frame.Position
	end)
	handle.InputEnded:Connect(endDrag)

	UserInput.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local delta = input.Position - startInput
		frame.Position = UDim2.new(
			startPos.X.Scale, startPos.X.Offset + delta.X,
			startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end)
	UserInput.InputEnded:Connect(endDrag)
end

