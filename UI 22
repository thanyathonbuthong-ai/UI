--[[
================================================================================
  Hyperion UI Library
  Reconstructed from the deobfuscated "HyperionVS" script UI.
  Dark purple theme, animated shimmer borders, gradient card strokes,
  draggable window, tab system, toggle / button / textbox / keybind / section.

  Usage (as a ModuleScript):
      local Library = require(game.ReplicatedStorage.HyperionUI)
      local Window = Library:CreateWindow({ Name = "My Hub", ... })
      local Tab = Window:CreateTab("MAIN")
      Tab:AddSection("Section")
      Tab:AddButton("Button", function() print("clicked") end)
      Tab:AddToggle("Toggle", false, function(state) print(state) end)
      Tab:AddTextBox("Text", "default", function(value) print(value) end)
      Tab:AddKeybind("Keybind", Enum.KeyCode.Unknown, function(key) print(key) end)
      Tab:AddBigButton("Big Button", function() end)

  Or loadstring-friendly: the module returns the Library table, so you can also
  paste it into a loadstring wrapper and call Library:CreateWindow directly.
================================================================================
]]

