--[[
================================================================================
  SpaceHub UI Library
  Reusable Roblox UI library extracted & refactored from the "Space Hub" script.
  Design language: dark modern card UI with side-rail tabs, accent glow,
  smooth tweens, keybind support, notifications, and draggable/minimizable window.

  Usage (executor / loadstring):
      local Library = loadstring(game:HttpGet("https://your-host/SpaceHubUI.lua"))()

      local Window = Library:CreateWindow({
          Title    = "Space Hub",
          Subtitle = "discord.gg/space-hub",
          Accent   = Color3.fromRGB(255, 255, 255),  -- optional
          ToggleKey = Enum.KeyCode.RightControl,      -- optional, hide/show
      })

      local Tab = Window:CreateTab("Main")
      Tab:Section("SPEED CONFIGURATION")
      Tab:Toggle({ Name = "Carry Mode", Default = false, Keybind = Enum.KeyCode.Q,
          Callback = function(v) print("Carry", v) end })
      Tab:Button({ Name = "Insta Reset", Keybind = Enum.KeyCode.I,
          Callback = function() print("reset") end })
      Tab:Slider({ Name = "Radius", Min = 0, Max = 100, Default = 62, Decimals = 0,
          Callback = function(v) print("radius", v) end })
      Tab:Input({ Name = "Normal Speed", Default = "59.5",
          Callback = function(v) print("speed", v) end })
      Tab:Dropdown({ Name = "Animation Pack", Options = {"Off","Korblox","Headless"},
          Callback = function(v) print(v) end })
      Tab:Cycle({ Name = "Sky", Options = {"Off","Stars","Sunset","Night"},
          Callback = function(i, v) print(i, v) end })
      Tab:Mode({ Left = "NORMAL", Right = "SEMI",
          Callback = function(isLeft) print(isLeft) end })
      Tab:Keybind({ Name = "Drop Brainrot", Default = Enum.KeyCode.H,
          Callback = function(key) print(key) end })

      Library:Notify("Space Hub loaded!", 4)
================================================================================
]]

