-- Internal state -------------------------------------------------------------
local shimmerGradients = {}  -- UIGradients rotated every frame for shimmer
local layoutOrderCounter = 0

-- Start the shimmer rotation loop once
task.spawn(function()
	while true do
		RunService.Heartbeat:Wait()
		for i = #shimmerGradients, 1, -1 do
			local g = shimmerGradients[i]
			if g and g.Parent then
				g.Rotation = (g.Rotation + 2) % 360
			else
				table.remove(shimmerGradients, i)
			end
		end
	end
end)

-- Low-level helpers ----------------------------------------------------------
local function applyProps(instance, props)
	for k, v in pairs(props) do
		if k ~= "Parent" then
			instance[k] = v
		end
	end
	if props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

local function new(className, props)
	return applyProps(Instance.new(className), props)
end

local function tween(instance, time, props, style)
	local info = TweenInfo.new(time, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(instance, info, props):Play()
end

-- Static purple gradient stroke (cards, rows, inputs)
local function applyPurpleGradient(stroke)
	local g = Instance.new("UIGradient")
	g.Color = PurpleGradient.Color
	g.Rotation = PurpleGradient.Rotation
	g.Transparency = PurpleGradient.Transparency
	g.Parent = stroke
	return g
end

-- Animated white shimmer stroke (window border, float button)
local function addShimmerStroke(parent, thickness)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = thickness or 1.5
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = Theme.TextWhite
	stroke.Parent = parent
	local g = Instance.new("UIGradient")
	g.Color = ShimmerGradient
	g.Parent = stroke
	table.insert(shimmerGradients, g)
	return stroke
end

-- Card style: rounded corner + purple gradient stroke
local function addCardStyle(parent, cornerRadius, thickness)
	new("UICorner", { CornerRadius = UDim.new(0, cornerRadius or 7), Parent = parent })
	local stroke = new("UIStroke", {
		Color = Theme.TextWhite,
		Thickness = thickness or 1.25,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
	applyPurpleGradient(stroke)
	return stroke
end

