local Tab = {}
Tab.__index = Tab

function Tab.new(window, name, order, visible)
    local self = setmetatable({}, Tab)
    self.Window = window
    self.Helpers = window.Helpers
    self.Theme = window.Theme

    local p = Instance.new("ScrollingFrame")
    p.Name = name .. "_Page"
    p.Visible = visible ~= false
    p.LayoutOrder = order
    p.Size = UDim2.new(1, 0, 1, 0)
    p.BackgroundTransparency = 1
    p.BorderSizePixel = 0
    p.ScrollBarThickness = 2
    p.ScrollBarImageColor3 = self.Theme.Accent
    p.CanvasSize = UDim2.new(0, 0, 0, 0)
    p.Parent = window.ContentFrame
    local l = Instance.new("UIListLayout"); l.Padding = UDim.new(0, 7); l.SortOrder = Enum.SortOrder.LayoutOrder; l.Parent = p
    local pd = Instance.new("UIPadding"); pd.PaddingBottom = UDim.new(0, 10); pd.PaddingRight = UDim.new(0, 4); pd.Parent = p
    self.Helpers.autoCanvas(p)
    self.Page = p
    return self
end

--// Section header
function Tab:Section(text)
    local H, theme = self.Helpers, self.Theme
    local r = Instance.new("Frame"); r.Size = UDim2.new(1, 0, 0, 24); r.BackgroundTransparency = 1; r.Parent = self.Page
    local b = Instance.new("Frame"); b.Position = UDim2.new(0, 0, 0.5, -6); b.Size = UDim2.new(0, 3, 0, 13)
    b.BackgroundColor3 = theme.Accent; b.BorderSizePixel = 0; b.Parent = r
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 2)
    local l = Instance.new("TextLabel"); l.Position = UDim2.new(0, 12, 0, 0); l.Size = UDim2.new(1, -12, 1, 0)
    l.BackgroundTransparency = 1; l.Text = text; l.TextColor3 = theme.TEXT_SECTION; l.TextSize = 11
    l.Font = Enum.Font.GothamBold; l.TextXAlignment = Enum.TextXAlignment.Left; l.Parent = r
    return r
end

--// Toggle (pill switch) with optional keybind + expandable sub-rows
function Tab:Toggle(opts)
    local H, theme = self.Helpers, self.Theme
    local label, def, keybind, hasExpand, cb = opts.Name, opts.Default or false, opts.Keybind, opts.Expand, opts.Callback
    local h = keybind and 44 or 46
    local r = Instance.new("Frame"); r.ClipsDescendants = true; r.Size = UDim2.new(1, 0, 0, h)
    r.BackgroundColor3 = theme.ROW_BG; r.BackgroundTransparency = 0.03; r.BorderSizePixel = 0; r.Parent = self.Page; H.cardStyle(r)
    local bar = H.accentBar(r, def)
    local lw = keybind and UDim2.new(1, -120, 1, 0) or UDim2.new(1, -74, 1, 0)
    if hasExpand then lw = UDim2.new(1, -108, 1, 0) end
    local l = Instance.new("TextLabel"); l.Position = UDim2.new(0, 14, 0, 0); l.Size = lw; l.BackgroundTransparency = 1
    l.Text = label; l.TextColor3 = theme.TEXT_PRIMARY; l.TextSize = 14; l.Font = Enum.Font.GothamMedium
    l.TextXAlignment = Enum.TextXAlignment.Left; l.Parent = r

    local tb = Instance.new("TextButton"); tb.Position = UDim2.new(1, -54, 0.5, -11); tb.Size = UDim2.new(0, 44, 0, 22)
    tb.BackgroundColor3 = def and theme.Accent or theme.TOGGLE_OFF; tb.BorderSizePixel = 0; tb.Text = ""; tb.AutoButtonColor = false; tb.Parent = r
    Instance.new("UICorner", tb).CornerRadius = UDim.new(0, 11)
    local knob = Instance.new("Frame"); knob.Size = UDim2.new(0, 16, 0, 16); knob.BorderSizePixel = 0
    knob.Position = def and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
    knob.BackgroundColor3 = def and theme.KNOB_ON or theme.TOGGLE_KNOB; knob.Parent = tb
    Instance.new("UICorner", knob)

    local state = def
    local api = {}
    local function set(v)
        state = v
        TweenService:Create(tb, TWEEN_FAST, { BackgroundColor3 = v and theme.Accent or theme.TOGGLE_OFF }):Play()
        TweenService:Create(knob, TWEEN_FAST, { Position = v and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8), BackgroundColor3 = v and theme.KNOB_ON or theme.TOGGLE_KNOB }):Play()
        TweenService:Create(bar, TWEEN_FAST, { BackgroundTransparency = v and 0 or 1 }):Play()
        bar.BackgroundColor3 = theme.Accent
    end
    api.Set = set
    api.Get = function() return state end
    tb.MouseButton1Click:Connect(function()
        local nextState = not state
        set(nextState)
        if cb then task.spawn(cb, nextState) end
    end)

    if keybind then
        local currentKey = keybind
        local kb = H.smallBtn({ Parent = r, Pos = UDim2.new(1, -104, 0.5, -11), Size = UDim2.new(0, 40, 0, 23), Text = prettyKeyName(keybind), Z = 4 })
        kb.MouseButton1Click:Connect(function()
            startKeyListen(kb, function(newKey)
                currentKey = newKey
                kb.Text = prettyKeyName(newKey)
                if opts.KeybindCallback then task.spawn(opts.KeybindCallback, newKey) end
            end)
        end)
        -- fire keybind when pressed globally
        UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == currentKey and not KeyListen.active then
                local nextState = not state
                set(nextState)
                if cb then task.spawn(cb, nextState) end
            end
        end)
    end

    local expandRows
    if hasExpand then
        expandRows = {}; local exp = false
        local eb = H.smallBtn({ Parent = r, Pos = UDim2.new(1, -90, 0.5, -11), Size = UDim2.new(0, 26, 0, 22),
            Text = "^", Col = theme.Accent, Bg = Color3.fromRGB(24, 18, 23), SC = theme.Accent, ST = 1.2, STr = 0.15 })
        eb.MouseButton1Click:Connect(function()
            exp = not exp; eb.Text = exp and "v" or "^"
            for _, rr in ipairs(expandRows) do rr.Visible = exp end
        end)
        api.AddExpandRow = function(rowFrame) table.insert(expandRows, rowFrame); rowFrame.Visible = false; return rowFrame end
    end

    return api, r
end

--// Button (action) with optional keybind
function Tab:Button(opts)
    local H, theme = self.Helpers, self.Theme
    local label, keybind, cb = opts.Name, opts.Keybind, opts.Callback
    local r = Instance.new("Frame"); r.ClipsDescendants = true; r.Size = UDim2.new(1, 0, 0, 42)
    r.BackgroundColor3 = theme.ROW_BG; r.BackgroundTransparency = 0.03; r.BorderSizePixel = 0; r.Parent = self.Page; H.cardStyle(r)
    local btn = Instance.new("TextButton"); btn.Size = UDim2.new(1, -56, 1, 0); btn.BackgroundTransparency = 1
    btn.Text = label; btn.TextColor3 = theme.TEXT_PRIMARY; btn.TextSize = 14; btn.Font = Enum.Font.GothamBold; btn.Parent = r
    local bar = H.accentBar(r, false)
    local function fire()
        bar.BackgroundColor3 = theme.Accent
        TweenService:Create(bar, TWEEN_FAST, { BackgroundTransparency = 0 }):Play()
        task.delay(0.3, function() TweenService:Create(bar, TWEEN_FAST, { BackgroundTransparency = 1 }):Play() end)
        if cb then task.spawn(cb) end
    end
    btn.MouseButton1Click:Connect(fire)
    if keybind then
        local kb = H.smallBtn({ Parent = r, Pos = UDim2.new(1, -50, 0.5, -11), Size = UDim2.new(0, 40, 0, 23), Text = prettyKeyName(keybind), Z = 3 })
        local currentKey = keybind
        kb.MouseButton1Click:Connect(function()
            startKeyListen(kb, function(newKey)
                currentKey = newKey
                kb.Text = prettyKeyName(newKey)
                if opts.KeybindCallback then task.spawn(opts.KeybindCallback, newKey) end
            end)
        end)
        UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == currentKey and not KeyListen.active then fire() end
        end)
    end
    return { Fire = fire }, r
end

--// Slider (horizontal drag) with live value label
function Tab:Slider(opts)
    local H, theme = self.Helpers, self.Theme
    local label, min, max, def, decimals, cb = opts.Name, opts.Min or 0, opts.Max or 100, opts.Default or opts.Min or 0, opts.Decimals or 0, opts.Callback
    local r = Instance.new("Frame"); r.ClipsDescendants = true; r.Size = UDim2.new(1, 0, 0, 48)
    r.BackgroundColor3 = theme.ROW_BG; r.BackgroundTransparency = 0.03; r.BorderSizePixel = 0; r.Parent = self.Page; H.cardStyle(r)
    H.accentBar(r, false)
    local l = Instance.new("TextLabel"); l.Position = UDim2.new(0, 13, 0, 4); l.Size = UDim2.new(1, -80, 0, 18)
    l.BackgroundTransparency = 1; l.Text = label; l.TextColor3 = theme.TEXT_PRIMARY; l.TextSize = 13
    l.Font = Enum.Font.GothamMedium; l.TextXAlignment = Enum.TextXAlignment.Left; l.Parent = r
    local valLbl = Instance.new("TextLabel"); valLbl.Position = UDim2.new(1, -70, 0, 4); valLbl.Size = UDim2.new(0, 58, 0, 18)
    valLbl.BackgroundTransparency = 1; valLbl.Text = tostring(def); valLbl.TextColor3 = theme.Accent; valLbl.TextSize = 12
    valLbl.Font = Enum.Font.GothamBold; valLbl.TextXAlignment = Enum.TextXAlignment.Right; valLbl.Parent = r

    local track = Instance.new("Frame"); track.Position = UDim2.new(0, 13, 0, 30); track.Size = UDim2.new(1, -26, 0, 6)
    track.BackgroundColor3 = theme.TOGGLE_OFF; track.BorderSizePixel = 0; track.Parent = r
    Instance.new("UICorner", track).CornerRadius = UDim.new(0, 3)
    local fill = Instance.new("Frame"); fill.Size = UDim2.new(0, 0, 1, 0); fill.BackgroundColor3 = theme.Accent; fill.BorderSizePixel = 0; fill.Parent = track
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 3)
    local knob = Instance.new("Frame"); knob.AnchorPoint = Vector2.new(0.5, 0.5); knob.Position = UDim2.new(0, 0, 0.5, 0); knob.Size = UDim2.new(0, 14, 0, 14)
    knob.BackgroundColor3 = theme.TEXT_WHITE; knob.BorderSizePixel = 0; knob.Parent = track
    Instance.new("UICorner", knob)

    local value = def
    local dragging = false
    local function updateFromInput(inputPos)
        local rel = math.clamp((inputPos.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        value = min + (max - min) * rel
        value = math.floor(value * 10 ^ decimals + 0.5) / 10 ^ decimals
        if decimals <= 0 then value = math.floor(value + 0.5) end
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        valLbl.Text = tostring(value)
        if cb then task.spawn(cb, value) end
    end
    local hitbox = Instance.new("TextButton"); hitbox.Size = UDim2.new(1, 0, 1, 0); hitbox.BackgroundTransparency = 1; hitbox.Text = ""; hitbox.AutoButtonColor = false; hitbox.ZIndex = 5; hitbox.Parent = r
    hitbox.MouseButton1Down:Connect(function()
        dragging = true
        updateFromInput(UserInputService:GetMouseLocation())
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            updateFromInput(i.Position)
        end
    end)
    -- init
    do
        local rel = math.clamp((def - min) / (max - min), 0, 1)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
    end

    local api = {}
    api.Set = function(v)
        value = math.clamp(v, min, max)
        local rel = (value - min) / (max - min)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        valLbl.Text = tostring(value)
    end
    api.Get = function() return value end
    return api, r
end

--// Text input (textbox)
function Tab:Input(opts)
    local H, theme = self.Helpers, self.Theme
    local label, def, cb = opts.Name, opts.Default or "", opts.Callback
    local r = Instance.new("Frame"); r.ClipsDescendants = true; r.Size = UDim2.new(1, 0, 0, 44)
    r.BackgroundColor3 = theme.ROW_BG; r.BackgroundTransparency = 0.03; r.BorderSizePixel = 0; r.Parent = self.Page; H.cardStyle(r)
    local l = Instance.new("TextLabel"); l.Position = UDim2.new(0, 13, 0, 0); l.Size = UDim2.new(1, -84, 1, 0)
    l.BackgroundTransparency = 1; l.Text = label; l.TextColor3 = theme.TEXT_PRIMARY; l.TextSize = 13
    l.Font = Enum.Font.GothamMedium; l.TextXAlignment = Enum.TextXAlignment.Left; l.Parent = r
    local bx = Instance.new("TextBox"); bx.Position = UDim2.new(1, -66, 0.5, -12); bx.Size = UDim2.new(0, 56, 0, 25)
    bx.BackgroundColor3 = theme.BTN_BG; bx.BorderSizePixel = 0; bx.Text = def; bx.TextColor3 = theme.Accent
    bx.TextSize = 13; bx.Font = Enum.Font.GothamBold; bx.Parent = r
    Instance.new("UICorner", bx).CornerRadius = UDim.new(0, 6)
    local s = Instance.new("UIStroke"); s.Color = theme.CARD_STROKE; s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Transparency = 0.5; s.Parent = bx
    bx.FocusLost:Connect(function(enterPressed)
        if cb then task.spawn(cb, bx.Text, enterPressed) end
    end)
    return { Set = function(v) bx.Text = v end, Get = function() return bx.Text end }, r
end

--// Dropdown (expandable option list)
function Tab:Dropdown(opts)
    local H, theme = self.Helpers, self.Theme
    local label, options, def, cb = opts.Name, opts.Options or {}, opts.Default or (opts.Options and opts.Options[1]) or "", opts.Callback
    local r = Instance.new("Frame"); r.ClipsDescendants = true; r.Size = UDim2.new(1, 0, 0, 44)
    r.BackgroundColor3 = theme.ROW_BG; r.BackgroundTransparency = 0.03; r.BorderSizePixel = 0; r.Parent = self.Page; H.cardStyle(r)
    local l = Instance.new("TextLabel"); l.Position = UDim2.new(0, 13, 0, 0); l.Size = UDim2.new(0.45, 0, 0, 44); l.BackgroundTransparency = 1
    l.Text = label; l.TextColor3 = theme.TEXT_PRIMARY; l.TextSize = 13; l.Font = Enum.Font.GothamMedium; l.TextXAlignment = Enum.TextXAlignment.Left; l.Parent = r
    local dd = H.smallBtn({ Parent = r, Pos = UDim2.new(1, -130, 0, 8), Size = UDim2.new(0, 120, 0, 27), Text = def .. "  v", Col = theme.TEXT_PRIMARY, TS = 11, CR = 7, SC = theme.CARD_STROKE, STr = 0.45 })
    local ca = Instance.new("Frame"); ca.Position = UDim2.new(0, 13, 0, 44); ca.Size = UDim2.new(1, -26, 0, 0); ca.BackgroundTransparency = 1; ca.Parent = r
    local lay = Instance.new("UIListLayout"); lay.Padding = UDim.new(0, 4); lay.SortOrder = Enum.SortOrder.LayoutOrder; lay.Parent = ca
    local exp = false
    local api = {}
    local function buildOptions()
        for _, c in ipairs(ca:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
        for i, opt in ipairs(options) do
            local ob = H.smallBtn({ Parent = ca, Size = UDim2.new(1, 0, 0, 24), Text = opt, Col = theme.TEXT_DIM, TS = 11, CR = 6 })
            ob.MouseButton1Click:Connect(function()
                dd.Text = opt .. "  v"
                exp = false
                TweenService:Create(r, TWEEN_MED, { Size = UDim2.new(1, 0, 0, 44) }):Play()
                if cb then task.spawn(cb, opt, i) end
            end)
        end
    end
    buildOptions()
    dd.MouseButton1Click:Connect(function()
        exp = not exp
        local targetH = exp and (44 + lay.AbsoluteContentSize.Y + 10) or 44
        TweenService:Create(r, TWEEN_MED, { Size = UDim2.new(1, 0, 0, targetH) }):Play()
    end)
    api.SetOptions = function(newOpts) options = newOpts; buildOptions() end
    api.Refresh = buildOptions
    return api, r
end

--// Cycle / arrow selector (< value >)
function Tab:Cycle(opts)
    local H, theme = self.Helpers, self.Theme
    local label, options, cb = opts.Name, opts.Options or { "Off" }, opts.Callback
    if typeof(options) == "string" then options = { options } end
    local idx = 1
    local r = Instance.new("Frame"); r.ClipsDescendants = true; r.Size = UDim2.new(1, 0, 0, 44)
    r.BackgroundColor3 = theme.ROW_BG; r.BackgroundTransparency = 0.03; r.BorderSizePixel = 0; r.Parent = self.Page; H.cardStyle(r)
    local l = Instance.new("TextLabel"); l.Position = UDim2.new(0, 13, 0, 0); l.Size = UDim2.new(0.43, 0, 0, 44); l.BackgroundTransparency = 1
    l.Text = label; l.TextColor3 = theme.TEXT_PRIMARY; l.TextSize = 13; l.Font = Enum.Font.GothamMedium; l.TextXAlignment = Enum.TextXAlignment.Left; l.Parent = r
    local la = H.smallBtn({ Parent = r, Pos = UDim2.new(1, -174, 0, 8), Size = UDim2.new(0, 29, 0, 27), Text = "<", Col = theme.TEXT_PRIMARY, TS = 13, CR = 7, SC = theme.CARD_STROKE, STr = 0.45 })
    local vl = Instance.new("TextLabel"); vl.Position = UDim2.new(1, -141, 0, 8); vl.Size = UDim2.new(0, 102, 0, 27)
    vl.BackgroundColor3 = theme.BTN_BG; vl.BorderSizePixel = 0; vl.Text = options[1]; vl.TextColor3 = theme.TEXT_PRIMARY; vl.TextSize = 10; vl.Font = Enum.Font.GothamBold; vl.Parent = r
    Instance.new("UICorner", vl).CornerRadius = UDim.new(0, 7)
    local vs = Instance.new("UIStroke"); vs.Color = theme.CARD_STROKE; vs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; vs.Transparency = 0.45; vs.Parent = vl
    local ra = H.smallBtn({ Parent = r, Pos = UDim2.new(1, -35, 0, 8), Size = UDim2.new(0, 29, 0, 27), Text = ">", Col = theme.TEXT_PRIMARY, TS = 13, CR = 7, SC = theme.CARD_STROKE, STr = 0.45 })
    local function upd()
        vl.Text = options[idx]
        if cb then task.spawn(cb, idx, options[idx]) end
    end
    la.MouseButton1Click:Connect(function() idx = idx - 1; if idx < 1 then idx = #options end; upd() end)
    ra.MouseButton1Click:Connect(function() idx = idx + 1; if idx > #options then idx = 1 end; upd() end)
    return { Get = function() return idx, options[idx] end, Set = function(i) idx = ((i - 1) % #options) + 1; vl.Text = options[idx] end }, r
end

--// Mode selector (2-way pill, LEFT | RIGHT)
function Tab:Mode(opts)
    local H, theme = self.Helpers, self.Theme
    local lt, rt, cb, defLeft = opts.Left or "LEFT", opts.Right or "RIGHT", opts.Callback, (opts.Default ~= false)
    local r = Instance.new("Frame"); r.ClipsDescendants = true; r.Size = UDim2.new(1, 0, 0, 36)
    r.BackgroundColor3 = theme.ROW_BG; r.BackgroundTransparency = 0.03; r.BorderSizePixel = 0; r.Parent = self.Page; H.cardStyle(r)
    local sl = Instance.new("Frame"); sl.ZIndex = 2; sl.Position = defLeft and UDim2.new(0, 4, 0, 4) or UDim2.new(0.5, 2, 0, 4); sl.Size = UDim2.new(0.5, -6, 1, -8)
    sl.BackgroundColor3 = theme.Accent; sl.BorderSizePixel = 0; sl.Parent = r
    Instance.new("UICorner", sl).CornerRadius = UDim.new(0, 7)
    local lb = Instance.new("TextButton"); lb.ZIndex = 3; lb.Size = UDim2.new(0.5, 0, 1, 0); lb.BackgroundTransparency = 1; lb.BorderSizePixel = 0
    lb.Text = lt; lb.TextColor3 = defLeft and theme.TEXT_WHITE or theme.TEXT_DIM; lb.TextSize = 11; lb.Font = Enum.Font.GothamBold; lb.AutoButtonColor = false; lb.Parent = r
    local rb = Instance.new("TextButton"); rb.ZIndex = 3; rb.Position = UDim2.new(0.5, 0, 0, 0); rb.Size = UDim2.new(0.5, 0, 1, 0); rb.BackgroundTransparency = 1; rb.BorderSizePixel = 0
    rb.Text = rt; rb.TextColor3 = defLeft and theme.TEXT_DIM or theme.TEXT_WHITE; rb.TextSize = 11; rb.Font = Enum.Font.GothamBold; rb.AutoButtonColor = false; rb.Parent = r
    local left = defLeft
    local function setM(l)
        left = l
        TweenService:Create(sl, TWEEN_FAST, { Position = l and UDim2.new(0, 4, 0, 4) or UDim2.new(0.5, 2, 0, 4) }):Play()
        lb.TextColor3 = l and theme.TEXT_WHITE or theme.TEXT_DIM
        rb.TextColor3 = l and theme.TEXT_DIM or theme.TEXT_WHITE
        if cb then task.spawn(cb, l) end
    end
    lb.MouseButton1Click:Connect(function() setM(true) end)
    rb.MouseButton1Click:Connect(function() setM(false) end)
    return { Get = function() return left end, Set = setM }, r
end

--// Keybind-only row
function Tab:Keybind(opts)
    local H, theme = self.Helpers, self.Theme
    local label, key, cb = opts.Name, opts.Default, opts.Callback
    local r = Instance.new("Frame"); r.ClipsDescendants = true; r.Size = UDim2.new(1, 0, 0, 44)
    r.BackgroundColor3 = theme.ROW_BG; r.BackgroundTransparency = 0.03; r.BorderSizePixel = 0; r.Parent = self.Page; H.cardStyle(r)
    local l = Instance.new("TextLabel"); l.Position = UDim2.new(0, 13, 0, 0); l.Size = UDim2.new(0.45, 0, 0, 44); l.BackgroundTransparency = 1
    l.Text = label; l.TextColor3 = theme.TEXT_PRIMARY; l.TextSize = 13; l.Font = Enum.Font.GothamMedium; l.TextXAlignment = Enum.TextXAlignment.Left; l.Parent = r
    local kb = H.smallBtn({ Parent = r, Pos = UDim2.new(1, -130, 0.5, -12), Size = UDim2.new(0, 120, 0, 25), Text = key and prettyKeyName(key) or "None", Col = theme.TEXT_DIM, TS = 11, CR = 6 })
    local currentKey = key
    kb.MouseButton1Click:Connect(function()
        startKeyListen(kb, function(newKey)
            currentKey = newKey
