local KEY_DISPLAY_ALIASES = {
    ["Space"] = "Spacebar", ["LeftControl"] = "L-Ctrl", ["RightControl"] = "R-Ctrl",
    ["LeftShift"] = "L-Shift", ["RightShift"] = "R-Shift", ["LeftAlt"] = "L-Alt",
