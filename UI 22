		Parent = knob,
	})
	new("UICorner", { CornerRadius = UDim.new(0, 4), Parent = shine })
	new("TextButton", {
		Name = "ToggleClick",
		ZIndex = 100,
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = toggleArea,
	})

	local state = not not default
	local element = { Row = row, State = state }

	function element:Set(value)
		state = not not value
		element.State = state
		if state then
			track.BackgroundTransparency = 0
			track.BackgroundColor3 = Theme.ToggleOn
			tween(knob, 0.12, { Position = UDim2.new(1, -16, 0.5, -6) })
		else
			track.BackgroundTransparency = 0.2
			track.BackgroundColor3 = Theme.TextWhite
			tween(knob, 0.12, { Position = UDim2.new(0, 3, 0.5, -6) })
		end
	end

	toggleArea.MouseButton1Click:Connect(function()
		element:Set(not state)
		if callback then callback(state) end
	end)

	element:Set(state)
	return element
end

function Tab:AddKeybind(name, default, callback)
	local row = makeRow(name, self.Scroll)
	addRowLabel(row, name, 11)

	local currentKey = default or Enum.KeyCode.Unknown
	local function keyText()
		if currentKey and currentKey ~= Enum.KeyCode.Unknown then
			return currentKey.Name
		end
		return "?"
	end

	local btn = new("TextButton", {
		Name = "KeybindBtn",
		ZIndex = 7,
		Position = UDim2.new(1, -82, 0.5, -12),
		Size = UDim2.new(0, 72, 0, 24),
		BackgroundColor3 = Theme.BgSecondary,
		BackgroundTransparency = 0.18,
		BorderSizePixel = 0,
		Text = keyText(),
		TextColor3 = Theme.TextWhite,
		TextSize = 10,
		Font = Enum.Font.GothamBold,
		AutoButtonColor = false,
		Parent = row,
	})
	addCardStyle(btn, 7, 1.25)

	local listening = false
	local conn
	local element = { Row = row, Key = currentKey }

	local function stopListen()
		listening = false
		if conn then conn:Disconnect(); conn = nil end
		btn.Text = keyText()
	end

	btn.MouseButton1Click:Connect(function()
		if listening then
			stopListen()
			return
		end
		listening = true
		btn.Text = "..."
		conn = UserInput.InputBegan:Connect(function(input, gameProcessed)
			if not listening or gameProcessed then return end
			local t = input.UserInputType
			if t ~= Enum.UserInputType.Keyboard
				and t ~= Enum.UserInputType.Gamepad1
				and t ~= Enum.UserInputType.Gamepad2
				and t ~= Enum.UserInputType.Gamepad3
				and t ~= Enum.UserInputType.Gamepad4 then return end
			if input.KeyCode == Enum.KeyCode.Unknown then return end
			if conn then conn:Disconnect(); conn = nil end
			if input.KeyCode == Enum.KeyCode.Escape then
				stopListen()
				return
			end
			currentKey = input.KeyCode
			element.Key = currentKey
			listening = false
			btn.Text = keyText()
			if callback then callback(currentKey) end
		end)
	end)

	function element:Set(key)
		currentKey = key
		element.Key = key
		btn.Text = keyText()
	end

	return element
end

