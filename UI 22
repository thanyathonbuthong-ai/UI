local Window = {}
Window.__index = Window

function Library:CreateWindow(opts)
    opts = opts or {}
    local self = setmetatable({}, Window)
    self.Tabs = {}
    self.TabButtons = {}

    -- theme
    local theme = {}
    for k, v in pairs(DEFAULT_THEME) do theme[k] = v end
    if opts.Accent then theme.Accent = opts.Accent end
    self.Theme = theme
    local H = makeHelpers(theme)
    self.Helpers = H

    local title = opts.Title or "Space Hub"
    local subtitle = opts.Subtitle or ""
    local toggleKey = opts.ToggleKey or Enum.KeyCode.RightControl
    local width, height = getResponsivePanelSize(opts.Width or 420, opts.Height or 528)

    -- ScreenGui
    local gui = Instance.new("ScreenGui")
