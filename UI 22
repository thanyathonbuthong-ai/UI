                if o.Callback then pcall(o.Callback, state) end
            end
            function api:Get() return state end
            click.Activated:Connect(function() api:Set(not state) end)
            if state then
                -- apply initial visuals without callback
                knob.Position = UDim2.new(1,-16,0.5,-6)
