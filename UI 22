            local round = o.Round or 0
            local row, label = baseRow(o.Name or "Slider", 44)
            label.Size = UDim2.new(1, -70, 0, 16)
            label.Position = UDim2.new(0, 12, 0, 3)

            local valLbl = Instance.new("TextLabel")
            valLbl.BackgroundTransparency = 1
            valLbl.Size = UDim2.new(0, 56, 0, 16)
            valLbl.Position = UDim2.new(1, -66, 0, 3)
            valLbl.Text = tostring(cur)
            valLbl.TextColor3 = Theme.white
            valLbl.Font = FONT_SEMI
            valLbl.TextSize = 11
            valLbl.TextXAlignment = Enum.TextXAlignment.Right
            valLbl.ZIndex = 6
            valLbl.Parent = row

            local trackBg = Instance.new("TextButton")
            trackBg.Text = ""
            trackBg.AutoButtonColor = false
            trackBg.BackgroundColor3 = Theme.inputBg
            trackBg.BackgroundTransparency = 0.2
            trackBg.BorderSizePixel = 0
            trackBg.Size = UDim2.new(1, -24, 0, 6)
            trackBg.Position = UDim2.new(0, 12, 1, -12)
            trackBg.ZIndex = 5
            trackBg.Parent = row
            corner(trackBg, 3)

            local fill = Instance.new("Frame")
            fill.BackgroundColor3 = Theme.accent
            fill.BorderSizePixel = 0
            fill.Size = UDim2.new((cur - minV) / (maxV - minV), 0, 1, 0)
            fill.ZIndex = 6
            fill.Parent = trackBg
            corner(fill, 3)
            table.insert(tab.Window._AccentRefs, fill)

            local knobS = Instance.new("TextButton")
            knobS.BackgroundColor3 = Theme.white
            knobS.BorderSizePixel = 0
            knobS.AutoButtonColor = false
            knobS.Text = ""
            knobS.Size = UDim2.new(0, 12, 0, 12)
            knobS.AnchorPoint = Vector2.new(0.5, 0.5)
            knobS.Position = UDim2.new((cur - minV)/(maxV-minV), 0, 0.5, 0)
            knobS.ZIndex = 7
            knobS.Parent = trackBg
            corner(knobS, 999)
            gradientStroke(knobS, Theme.strokeSoft, 1, 0.3)

            local dragging = false
            local function update(input)
                local rel = (input.Position.X - trackBg.AbsolutePosition.X) / trackBg.AbsoluteSize.X
                rel = math.clamp(rel, 0, 1)
                cur = minV + rel * (maxV - minV)
                if round > 0 then cur = math.floor(cur / round + 0.5) * round else cur = math.floor(cur + 0.5) end
                local pct = (cur - minV) / (maxV - minV)
                fill.Size = UDim2.new(pct, 0, 1, 0)
                knobS.Position = UDim2.new(pct, 0, 0.5, 0)
                valLbl.Text = tostring(cur)
                if o.Callback then pcall(o.Callback, cur) end
            end
            knobS.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true; playClick()
                end
            end)
            trackBg.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; update(input) end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                    update(input)
                end
            end)

            local api = {}
            function api:Set(v)
                cur = math.clamp(v, minV, maxV)
                local pct = (cur - minV) / (maxV - minV)
                tween(fill, { Size = UDim2.new(pct, 0, 1, 0) })
                tween(knobS, { Position = UDim2.new(pct, 0, 0.5, 0) })
                valLbl.Text = tostring(cur)
            end
            function api:Get() return cur end
            return api
        end

        --//-------- Dropdown --------//
        function tab:AddDropdown(o)
            o = o or {}
            local values = o.Values or {}
            local selected = o.Default or values[1]
            local open = false
            local row, label = baseRow(o.Name or "Dropdown")
            local btn = inputBox(row, 72, tostring(selected) .. "  ?")
            btn.Text = tostring(selected) .. "  ?"

            row.AutomaticSize = Enum.AutomaticSize.Y
            row.ClipsDescendants = true
            local list = Instance.new("Frame")
            list.Name = "DropdownList"
            list.BackgroundColor3 = Theme.row2
            list.BackgroundTransparency = 0.05
            list.BorderSizePixel = 0
            list.ClipsDescendants = true
            list.Size = UDim2.new(1, 0, 0, 0)
            list.Position = UDim2.new(0, 0, 0, 36)
            list.ZIndex = 8
            list.Visible = true
            list.Parent = row
            corner(list, 9)
            gradientStroke(list, Theme.strokeSoft, 1, 0.4)
            local lpad = Instance.new("UIPadding")
            lpad.PaddingTop = UDim.new(0,4); lpad.PaddingBottom = UDim.new(0,4)
            lpad.PaddingLeft = UDim.new(0,4); lpad.PaddingRight = UDim.new(0,4)
            lpad.Parent = list
            local llayout = Instance.new("UIListLayout")
            llayout.Padding = UDim.new(0, 3)
            llayout.SortOrder = Enum.SortOrder.LayoutOrder
            llayout.Parent = list
            local listButtons = {}

            local function buildList()
                for _, b in ipairs(listButtons) do b:Destroy() end
                listButtons = {}
                for i, v in ipairs(values) do
                    local b = Instance.new("TextButton")
                    b.BackgroundColor3 = Theme.inputBg
                    b.BackgroundTransparency = (tostring(v) == tostring(selected)) and 0 or 0.3
                    b.BorderSizePixel = 0
                    b.Size = UDim2.new(1, 0, 0, 24)
                    b.Text = tostring(v)
                    b.TextColor3 = (tostring(v) == tostring(selected)) and Theme.accent or Theme.textDim
                    b.Font = FONT_SEMI
                    b.TextSize = 11
                    b.AutoButtonColor = false
                    b.LayoutOrder = i
                    b.ZIndex = 9
                    b.Parent = list
                    corner(b, 6)
                    b.MouseEnter:Connect(function() tween(b, { BackgroundTransparency = 0.1 }) end)
                    b.MouseLeave:Connect(function() tween(b, { BackgroundTransparency = (tostring(v)==tostring(selected)) and 0 or 0.3 }) end)
                    b.Activated:Connect(function()
                        playClick()
                        selected = v
                        btn.Text = tostring(v) .. "  ?"
                        if o.Callback then pcall(o.Callback, v) end
                        buildList()
                        open = false
                        tween(list, { Size = UDim2.new(1, 0, 0, 0) })
                    end)
                    table.insert(listButtons, b)
                end
            end
            buildList()

            btn.Activated:Connect(function()
                playClick()
                open = not open
                if open then
                    local h = #values * 27 + 10
                    tween(list, { Size = UDim2.new(1, 0, 0, h) })
                else
                    tween(list, { Size = UDim2.new(1, 0, 0, 0) })
                end
            end)

            local api = {}
            function api:Set(v) selected = v; btn.Text = tostring(v).."  ?"; buildList() end
            function api:Get() return selected end
            function api:Refresh(newVals) values = newVals; if not table.find(values, selected) then selected = values[1] end; buildList() end
            return api
        end

        --//-------- Textbox / Input --------//
        function tab:AddTextbox(o)
            o = o or {}
            local row, label = baseRow(o.Name or "Textbox")
            local box = Instance.new("TextBox")
            box.BackgroundColor3 = Theme.inputBg
            box.BackgroundTransparency = 0.18
            box.BorderSizePixel = 0
            box.Size = UDim2.new(0, 72, 0, 24)
            box.Position = UDim2.new(1, -82, 0.5, -12)
            box.Text = tostring(o.Default or "")
            box.PlaceholderText = o.Placeholder or ""
            box.PlaceholderColor3 = Theme.textDim
            box.TextColor3 = Theme.white
            box.TextSize = 11
            box.Font = FONT_SEMI
            box.ClearTextOnFocus = false
            box.ZIndex = 6
            box.Parent = row
            corner(box, 7)
            gradientStroke(box, Theme.strokeSoft, 1, 0.45)
            box.FocusLost:Connect(function(ep)
                if o.Callback then pcall(o.Callback, box.Text, ep) end
            end)
            local api = {}
            function api:Set(t) box.Text = t end
            function api:Get() return box.Text end
            return api
        end

        --//-------- Keybind --------//
        function tab:AddKeybind(o)
            o = o or {}
            local key = o.Default
            local listening = false
            local row, label = baseRow(o.Name or "Keybind")
            local btn = inputBox(row, 60, key and tostring(key.Name) or "None")
            local function kn(k)
                if not k then return "None" end
                return tostring(k):gsub("Enum.KeyCode.", "")
            end
            btn.Activated:Connect(function()
                playClick()
                listening = true
                btn.Text = "..."
            end)
            UserInputService.InputBegan:Connect(function(input, gp)
                if gp then return end
                if listening and input.UserInputType == Enum.UserInputType.Keyboard then
                    listening = false
                    key = input.KeyCode
                    btn.Text = kn(key)
                    if o.Callback then pcall(o.Callback, key) end
                elseif not listening and key and input.KeyCode == key and not gp then
                    if o.Callback then pcall(o.Callback, key) end
                end
            end)
            local api = {}
            function api:Set(k) key = k; btn.Text = kn(k) end
            function api:Get() return key end
            return api
        end

        --//-------- ColorPicker --------//
        function tab:AddColorPicker(o)
            o = o or {}
            local color = o.Default or Theme.accent
            local row, label = baseRow(o.Name or "Color")
            local swatch = Instance.new("TextButton")
            swatch.BackgroundColor3 = color
            swatch.BorderSizePixel = 0
            swatch.Size = UDim2.new(0, 28, 0, 20)
            swatch.Position = UDim2.new(1, -38, 0.5, -10)
            swatch.Text = ""
            swatch.AutoButtonColor = false
            swatch.ZIndex = 6
            swatch.Parent = row
            corner(swatch, 6)
            gradientStroke(swatch, Theme.strokeSoft, 1, 0.4)

            local pickerOpen = false
            row.AutomaticSize = Enum.AutomaticSize.Y
            row.ClipsDescendants = true
            local picker = Instance.new("Frame")
            picker.BackgroundColor3 = Theme.row2
            picker.BackgroundTransparency = 0.05
            picker.BorderSizePixel = 0
            picker.Size = UDim2.new(1, 0, 0, 0)
            picker.Position = UDim2.new(0, 0, 0, 36)
            picker.ClipsDescendants = true
            picker.Visible = true
            picker.ZIndex = 10
            picker.Parent = row
            corner(picker, 10)
            gradientStroke(picker, Theme.strokeSoft, 1, 0.4)
            local ppad = Instance.new("UIPadding")
            ppad.PaddingTop=UDim.new(0,8); ppad.PaddingBottom=UDim.new(0,8)
            ppad.PaddingLeft=UDim.new(0,10); ppad.PaddingRight=UDim.new(0,10)
            ppad.Parent = picker

            local hueBar = Instance.new("TextButton")
            hueBar.Text = ""
            hueBar.AutoButtonColor = false
            hueBar.Size = UDim2.new(1, 0, 0, 14)
            hueBar.BorderSizePixel = 0
            hueBar.ZIndex = 11
            hueBar.Parent = picker
            corner(hueBar, 7)
            local hg = Instance.new("UIGradient")
            hg.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(255,0,0)),
                ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255,255,0)),
                ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0,255,0)),
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0,255,255)),
                ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0,0,255)),
                ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255,0,255)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(255,0,0)),
            })
            hg.Parent = hueBar
            local hueKnob = Instance.new("TextButton")
            hueKnob.Size = UDim2.new(0, 10, 0, 18)
            hueKnob.AnchorPoint = Vector2.new(0.5, 0.5)
            hueKnob.Position = UDim2.new(0, 0, 0.5, 0)
            hueKnob.BackgroundColor3 = Theme.white
            hueKnob.BorderSizePixel = 0
            hueKnob.AutoButtonColor = false
            hueKnob.Text = ""
            hueKnob.ZIndex = 12
            hueKnob.Parent = hueBar
            corner(hueKnob, 4)

            local satVal = Instance.new("TextButton")
            satVal.Text = ""
            satVal.AutoButtonColor = false
            satVal.Size = UDim2.new(1, 0, 0, 80)
            satVal.Position = UDim2.new(0, 0, 0, 26)
            satVal.BorderSizePixel = 0
            satVal.ZIndex = 11
            satVal.Parent = picker
            corner(satVal, 8)
            local svGrad = Instance.new("UIGradient")
            svGrad.Rotation = 90
            svGrad.Color = ColorSequence.new(Color3.fromRGB(255,255,255), Color3.fromRGB(0,0,0))
            svGrad.Parent = satVal
            local svOverlay = Instance.new("Frame")
            svOverlay.Size = UDim2.new(1,0,1,0)
            svOverlay.BackgroundColor3 = Color3.fromRGB(255,0,0)
            svOverlay.BorderSizePixel = 0
            svOverlay.ZIndex = 11
            svOverlay.Parent = satVal
            corner(svOverlay, 8)
            local svOG = Instance.new("UIGradient")
            svOG.Color = ColorSequence.new(Color3.fromRGB(255,0,0), Color3.fromRGB(255,0,0))
            svOG.Transparency = NumberSequence.new(0, 1)
            svOG.Parent = svOverlay
            local svKnob = Instance.new("TextButton")
            svKnob.Size = UDim2.new(0, 12, 0, 12)
            svKnob.AnchorPoint = Vector2.new(0.5, 0.5)
            svKnob.Position = UDim2.new(1, 0, 0, 0)
            svKnob.BackgroundColor3 = Theme.white
            svKnob.BorderSizePixel = 0
            svKnob.AutoButtonColor = false
            svKnob.Text = ""
            svKnob.ZIndex = 13
            svKnob.Parent = satVal
            corner(svKnob, 999)
            gradientStroke(svKnob, Theme.stroke, 1.2, 0.2)

            local h, s, v = Color3.toHSV(color)
            hueKnob.Position = UDim2.new(h, 0, 0.5, 0)
            svKnob.Position = UDim2.new(s, 0, 1 - v, 0)

            local function applyColor()
                color = Color3.fromHSV(h, s, v)
                swatch.BackgroundColor3 = color
                svOverlay.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                if o.Callback then pcall(o.Callback, color) end
            end

            local hueDrag, svDrag = false, false
            hueBar.InputBegan:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 then hueDrag=true end end)
            satVal.InputBegan:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 then svDrag=true end end)
            UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType==Enum.UserInputType.MouseButton1 then hueDrag=false; svDrag=false end
            end)
            UserInputService.InputChanged:Connect(function(inp)
                if hueDrag then
                    h = math.clamp((inp.Position.X - hueBar.AbsolutePosition.X)/hueBar.AbsoluteSize.X, 0, 0.999)
                    hueKnob.Position = UDim2.new(h, 0, 0.5, 0)
                    applyColor()
                elseif svDrag then
                    s = math.clamp((inp.Position.X - satVal.AbsolutePosition.X)/satVal.AbsoluteSize.X, 0, 1)
                    v = 1 - math.clamp((inp.Position.Y - satVal.AbsolutePosition.Y)/satVal.AbsoluteSize.Y, 0, 1)
                    svKnob.Position = UDim2.new(s, 0, 1 - v, 0)
                    applyColor()
                end
            end)

            swatch.Activated:Connect(function()
                playClick()
                pickerOpen = not pickerOpen
                if pickerOpen then
                    tween(picker, { Size = UDim2.new(1, 0, 0, 124) })
                else
                    tween(picker, { Size = UDim2.new(1, 0, 0, 0) })
                end
            end)

            local api = {}
            function api:Set(c)
                color = c; h,s,v = Color3.toHSV(c)
                hueKnob.Position = UDim2.new(h,0,0.5,0)
                svKnob.Position = UDim2.new(s,0,1-v,0)
                swatch.BackgroundColor3 = c
            end
            function api:Get() return color end
            return api
        end

        return tab
    end

    -- default UI toggle keybind (RightShift)
    local uiKey = Enum.KeyCode.RightShift
    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == uiKey then
            Main.Visible = not Main.Visible
            if not Main.Visible then MiniFrame.Visible = false end
        end
    end)

    task.defer(function()
        self:Notify({ Title = self.Name, Content = "Loaded successfully", Duration = 4 })
    end)

    return self
end

