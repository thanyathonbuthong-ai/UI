    function self:SetTab(name)
        self.ActiveTab = name
        for pName, page in pairs(self.Pages) do
            page.Visible = (pName == name)
        end
        local idx = 0
        for i, tName in ipairs(self._TabOrder) do
            local btn = self.TabButtons[tName]
            local on = (tName == name)
            if btn then
                tween(btn, {
                    TextColor3 = on and Theme.white or Color3.fromRGB(170,170,180),
                    BackgroundTransparency = on and 0.28 or 0.72,
                })
                local st = btn:FindFirstChildOfClass("UIStroke")
                if st then
                    tween(st, { Transparency = on and 0.05 or 0.52,
                                Color = on and Color3.fromRGB(245,245,255) or Theme.stroke })
                end
            end
            if tName == name then idx = i - 1 end
        end
        TweenService:Create(TabGlowPill, TWEEN_SLOW, {
            Position = UDim2.new(Tabs.Position.X.Scale, Tabs.Position.X.Offset,
                                 Tabs.Position.Y.Scale, Tabs.Position.Y.Offset + idx * 42),
        }):Play()
    end
