        for tabName, page in pairs(self.Pages) do
            local matched = false
            for _, child in ipairs(page:GetChildren()) do
                if child:IsA("GuiObject") and not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
                    local lbl = child:FindFirstChild("Label") or child:FindFirstChildOfClass("TextLabel")
                    local txt = string.lower(child.Name .. " " .. (lbl and lbl.Text or ""))
                    local isMatch = (q == "") or (string.find(txt, q, 1, true) ~= nil)
                    child.Visible = isMatch
