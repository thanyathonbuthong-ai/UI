--//==========================================================================
--// Helpers
--//==========================================================================
local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = parent
    return c
end

-- Signature Pulse stroke: UIStroke + UIGradient with a transparency number-sequence
-- that fades at the edges and brightens in the middle -> "glowing border" look.
local function gradientStroke(parent, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Color = color or Theme.stroke
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0.35
    s.Parent = parent
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0,   Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(160, 160, 170)),
        ColorSequenceKeypoint.new(1,   Color3.fromRGB(255, 255, 255)),
    })
    g.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0,   0.55),
        NumberSequenceKeypoint.new(0.5, 0.10),
        NumberSequenceKeypoint.new(1,   0.55),
    })
    g.Parent = s
    return s, g
end

local function tween(obj, props, info)
    local a = TweenService:Create(obj, info or TWEEN_INFO, props)
    a:Play()
    return a
end

local function addGradientText(label, c1, c2)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new(c1 or Theme.white, c2 or Color3.fromRGB(170, 170, 178))
    g.Parent = label
    return g
end

local function makeDraggable(frame, dragTarget)
    dragTarget = dragTarget or frame
    local dragging, dragStart, startPos = false, nil, nil
    dragTarget.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

local function playClick()
    pcall(function()
        local s = Instance.new("Sound")
        s.SoundId = "rbxassetid://9105926814"
        s.Volume = 0.4
        s.Parent = game:GetService("CoreGui")
        s:Play()
        game:GetService("Debris"):AddItem(s, 1)
    end)
end

--//==========================================================================
--// Notify (toast stack, top-right)
--//==========================================================================
local NotifyHolder
local function ensureNotifyHolder(screenGui)
    if NotifyHolder and NotifyHolder.Parent then return NotifyHolder end
    local h = Instance.new("Frame")
    h.Name = "PulseNotifyHolder"
    h.BackgroundTransparency = 1
    h.AnchorPoint = Vector2.new(1, 0)
    h.Position = UDim2.new(1, -12, 0, 12)
    h.Size = UDim2.new(0, 300, 1, -24)
    h.Parent = screenGui
    local l = Instance.new("UIListLayout")
    l.Padding = UDim.new(0, 8)
    l.SortOrder = Enum.SortOrder.LayoutOrder
    l.VerticalAlignment = Enum.VerticalAlignment.Top
    l.HorizontalAlignment = Enum.HorizontalAlignment.Right
    l.Parent = h
    NotifyHolder = h
    return h
end

local function pushNotify(screenGui, opts)
    local holder = ensureNotifyHolder(screenGui)
    local n = Instance.new("Frame")
    n.Name = "Notify_" .. HttpService:GenerateGUID(false)
    n.BackgroundColor3 = Theme.bg
    n.BackgroundTransparency = 0.05
    n.BorderSizePixel = 0
    n.Size = UDim2.new(1, 0, 0, 0)
    n.AutomaticSize = Enum.AutomaticSize.Y
    n.LayoutOrder = os.clock()
    n.Parent = holder
    corner(n, 12)
    gradientStroke(n, Theme.stroke, 1.1, 0.25)

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 10); pad.PaddingBottom = UDim.new(0, 10)
    pad.PaddingLeft = UDim.new(0, 12); pad.PaddingRight = UDim.new(0, 12)
    pad.Parent = n

    local accentBar = Instance.new("Frame")
    accentBar.Name = "AccentBar"
    accentBar.BackgroundColor3 = Theme.accent
    accentBar.BorderSizePixel = 0
    accentBar.Size = UDim2.new(0, 3, 1, -10)
    accentBar.Position = UDim2.new(0, 4, 0.5, 0)
    accentBar.AnchorPoint = Vector2.new(0, 0.5)
    accentBar.Parent = n
    corner(accentBar, 3)

    local title = Instance.new("TextLabel")
    title.BackgroundTransparency = 1
    title.Text = opts.Title or "Notification"
    title.TextColor3 = Theme.white
    title.Font = FONT_BOLD
    title.TextSize = 13
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Size = UDim2.new(1, -16, 0, 16)
    title.Position = UDim2.new(0, 12, 0, 0)
    title.TextStrokeColor3 = Color3.fromRGB(0,0,0)
    title.TextStrokeTransparency = 0.4
    title.Parent = n

    local content = Instance.new("TextLabel")
    content.BackgroundTransparency = 1
    content.Text = opts.Content or ""
    content.TextColor3 = Theme.textDim
    content.Font = FONT_MED
    content.TextSize = 11
    content.TextWrapped = true
    content.TextXAlignment = Enum.TextXAlignment.Left
    content.AutomaticSize = Enum.AutomaticSize.Y
    content.Size = UDim2.new(1, -16, 0, 14)
    content.Position = UDim2.new(0, 12, 0, 18)
    content.Parent = n

    n.BackgroundTransparency = 1
    tween(n, { BackgroundTransparency = 0.05 }, TWEEN_SLOW)
    task.delay((opts.Duration or 4), function()
        tween(n, { BackgroundTransparency = 1, Position = n.Position + UDim2.new(0, 40, 0, 0) }, TWEEN_SLOW)
        for _, d in ipairs({ title, content, accentBar }) do
            tween(d, { TextTransparency = 1, BackgroundTransparency = 1 }, TWEEN_SLOW)
        end
        task.wait(0.3)
        n:Destroy()
    end)
end

