    --================================================================================
    --  PARAGRAPH (multi-line text)
    --================================================================================
    function tab:CreateParagraph(lines)
        tab.Order = tab.Order + 1
        local text = table.concat(lines or {}, "\n")
        local lbl = Instance.new("TextLabel")
        lbl.BackgroundTransparency = 1
        lbl.Size = UDim2.new(1, 0, 0, 20 * #(lines or {1}))
        lbl.Font = FONT_REGULAR
        lbl.TextSize = 11
        lbl.Text = text
        lbl.TextWrapped = true
        lbl.TextColor3 = Theme.DIM
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.TextYAlignment = Enum.TextYAlignment.Top
        lbl.LayoutOrder = tab.Order
        lbl.Parent = Inner
        local obj = {}
        function obj:SetText(t) lbl.Text = t end
        function obj:Destroy() lbl:Destroy() end
        return obj
    end

    return tab
end

--// Tab selection (called internally)
function SlicedUI:SelectTab(tab)
    for _, t in ipairs(self.Tabs) do
        t.Page.Visible = (t == tab)
        if t.TabBtn then
            if t == tab then
                t.TabBtn.BackgroundColor3 = Theme.GREEN1
                t.TabBtn.TextColor3 = Theme.GREEN_TEXT
            else
                t.TabBtn.BackgroundColor3 = Theme.OFF_BG
                t.TabBtn.TextColor3 = Theme.OFF_TEXT
            end
        end
    end
end

--// Window: toggle visibility
function SlicedUI:Toggle()
    self.Main.Visible = not self.Main.Visible
end
function SlicedUI:Show() self.Main.Visible = true end
function SlicedUI:Hide() self.Main.Visible = false end

--// Window: destroy
function SlicedUI:Destroy()
    if self.ScreenGui then pcall(function() self.ScreenGui:Destroy() end) end
end

--// Bind a toggle key to show/hide the window
function SlicedUI:BindToggleKey(keyName)
    keyName = NormalizeKeyName(keyName, "RightShift")
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.UserInputType == Enum.UserInputType.Keyboard
        and input.KeyCode.Name == keyName then
            self:Toggle()
        end
    end)
end

return SlicedUI
