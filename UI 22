    ["Slash"] = "/", ["Backslash"] = "\\", ["LeftBracket"] = "[", ["RightBracket"] = "]",
    ["Minus"] = "-", ["Equals"] = "=", ["Semicolon"] = ";", ["Quote"] = "'",
