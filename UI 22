--[[
================================================================================
  PulseUI Library v1.0  ( reconstructed & polished from "Pulse Hub" UI design )
--------------------------------------------------------------------------------
  Full standalone UI Library in the exact aesthetic of the Pulse Duel hub:
    - Deep dark theme (10,10,12) + signature gradient-glow UIStroke
    - Gotham font family, gradient title text, animated star-field header
    - Vertical tab bar with tweening accent glow-pill
    - Side identity card (avatar / name / status)
    - Search bar, minimize pill, lock / panic / close buttons
    - Toggle (knob+shine), Button, Slider, Dropdown, Textbox, Keybind,
      ColorPicker, Section, Label, Paragraph, Notify, Confirm dialog
    - Draggable, hover tweens, accent color theming, config save/load

  Usage:
    local PulseUI = loadstring(game:HttpGet("<raw-url-of-this-file>"))()
    local Window = PulseUI:CreateWindow({ Name = "My Hub", Discord = "discord.gg/mine" })
    local Tab = Window:CreateTab("Main")
    Tab:AddToggle({ Name = "Auto Farm", Default = false, Callback = function(v) print(v) end })
    Tab:AddButton({ Name = "Execute", Callback = function() print("click") end })
    Tab:AddSlider({ Name = "Speed", Min = 16, Max = 200, Default = 16, Callback = function(v) end })
    Tab:AddDropdown({ Name = "Mode", Values = {"A","B","C"}, Default = "A", Callback = function(v) end })
    Tab:AddTextbox({ Name = "Input", Default = "", Placeholder = "type...", Callback = function(v) end })
    Tab:AddKeybind({ Name = "Toggle UI", Default = Enum.KeyCode.RightShift, Callback = function() end })
    Tab:AddColorPicker({ Name = "Accent", Default = Color3.fromRGB(255,60,172), Callback = function(c) end })
    Tab:AddSection("Combat")
    Tab:AddLabel("Hello world")
    Tab:AddParagraph("Info", "This is a paragraph line.")
    Window:Notify({ Title = "Loaded", Content = "Welcome", Duration = 5 })
    Window:SetAccent(Color3.fromRGB(80,255,140))
================================================================================
]]

