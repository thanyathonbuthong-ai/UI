-- Dropdown
function Section:AddDropdown(opts)
	opts = opts or {}
	local row = self:_row(26, true)
	local obj = makeObj(opts, row, "Dropdown")
	local multi = opts.Multi == true
	obj.Options = opts.Options or {}
	obj.Value = multi and {} or nil

	local header = Create("Frame", { Parent = row, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 26), LayoutOrder = 1 })
	local label = newText({ Parent = header, Size = UDim2.new(0.42, 0, 1, 0), Text = opts.Name or "Dropdown" })
	bind(label, { TextColor3 = "Text" })

	local btn = Create("TextButton", {
		Parent = header, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.new(0.56, 0, 0, 22), AutoButtonColor = false, Text = "",
	})
	bind(btn, { BackgroundColor3 = "Element" })
	corner(btn, 5)
	stroke(btn)
	local valueLabel = newText({
		Parent = btn, Size = UDim2.new(1, -22, 1, 0), Position = UDim2.fromOffset(8, 0),
		Text = "None", TextTruncate = Enum.TextTruncate.AtEnd, TextSize = 12,
	})
	bind(valueLabel, { TextColor3 = "Text" })
	local arrow = newText({
		Parent = btn, Size = UDim2.fromOffset(16, 22), Position = UDim2.new(1, -18, 0, 0),
		Text = "v", TextXAlignment = Enum.TextXAlignment.Center, TextSize = 11,
	})
	bind(arrow, { TextColor3 = "Light Accent" })

	local list = Create("Frame", {
		Parent = row, BackgroundTransparency = 1, Visible = false, LayoutOrder = 2,
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
	})
	listLayout(list, 2)
	local buttons = {}

	local function isSelected(name)
		if multi then
			return table.find(obj.Value, name) ~= nil
		end
		return obj.Value == name
	end

	local function refresh()
		for name, b in pairs(buttons) do
			b.TextColor3 = isSelected(name) and Library.Theme.Accent or Library.Theme.Text
			b.Font = isSelected(name) and Enum.Font.GothamBold or Enum.Font.GothamMedium
		end
		if multi then
			valueLabel.Text = (#obj.Value > 0) and table.concat(obj.Value, ", ") or "None"
		else
			valueLabel.Text = obj.Value ~= nil and tostring(obj.Value) or "None"
		end
	end
	table.insert(Library._refreshers, refresh)

	function obj:Set(v, silent)
		if multi then
			local new = {}
			for _, name in ipairs(type(v) == "table" and v or {}) do
				if table.find(self.Options, name) then
					table.insert(new, name)
				end
			end
			self.Value = new
		else
			self.Value = (v ~= nil and table.find(self.Options, v)) and v or nil
		end
		refresh()
		setFlag(self, self.Value)
		if not silent and opts.Callback then
			task.spawn(opts.Callback, self.Value)
		end
	end
	function obj:Get()
		return self.Value
	end
	function obj:Serialize()
		return self.Value
	end
	function obj:Deserialize(v)
		self:Set(v)
	end

	local function build()
		for _, b in pairs(buttons) do
			b:Destroy()
		end
		buttons = {}
		for i, name in ipairs(obj.Options) do
			local b = Create("TextButton", {
				Parent = list, Size = UDim2.new(1, 0, 0, 24), AutoButtonColor = false,
				Text = tostring(name), Font = Enum.Font.GothamMedium, TextSize = 12, LayoutOrder = i,
			})
			bind(b, { BackgroundColor3 = "Element" })
			corner(b, 4)
			buttons[name] = b
			b.MouseButton1Click:Connect(function()
				if multi then
					local cur = { table.unpack(obj.Value) }
					local idx = table.find(cur, name)
					if idx then
						table.remove(cur, idx)
					else
						table.insert(cur, name)
					end
					obj:Set(cur)
				else
					obj:Set(name)
					list.Visible = false
					arrow.Text = "v"
				end
			end)
		end
		refresh()
	end

	function obj:SetOptions(newOptions)
		self.Options = newOptions
		build()
		self:Set(self.Value, true)
	end

	btn.MouseButton1Click:Connect(function()
		list.Visible = not list.Visible
		arrow.Text = list.Visible and "^" or "v"
	end)

	build()
	obj:Set(opts.Default, true)
	return obj
end

