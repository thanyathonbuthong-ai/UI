-- Keybind  (Mode: "Press" | "Toggle" | "Hold")
function Section:AddKeybind(opts)
	opts = opts or {}
	local row = self:_row(26)
	local obj = makeObj(opts, row, "Keybind")
	local mode = opts.Mode or "Press"
	obj.Value = opts.Default
	obj.State = false
	local listening = false

	local label = newText({ Parent = row, Size = UDim2.new(1, -80, 1, 0), Text = opts.Name or "Keybind" })
	bind(label, { TextColor3 = "Text" })

	local btn = Create("TextButton", {
		Parent = row, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(72, 20), AutoButtonColor = false, Text = "",
	})
	bind(btn, { BackgroundColor3 = "Element" })
	corner(btn, 5)
	stroke(btn)
	local keyLabel = newText({
		Parent = btn, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center,
		Text = "None", TextSize = 12,
	})
	bind(keyLabel, { TextColor3 = "Light Accent" })

	local function render()
		keyLabel.Text = listening and "..." or (obj.Value and obj.Value.Name or "None")
	end

	function obj:Set(key, silent)
		self.Value = key
		setFlag(self, key and key.Name or "None")
		render()
		if not silent and opts.ChangedCallback then
			task.spawn(opts.ChangedCallback, key)
		end
	end
	function obj:Get()
		return self.Value
	end
	function obj:Serialize()
		return self.Value and self.Value.Name or "None"
	end
	function obj:Deserialize(v)
		self:Set(Enum.KeyCode[v])
	end

	btn.MouseButton1Click:Connect(function()
		if listening then
			return
		end
		listening = true
		render()
		local conn
		conn = UIS.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Keyboard then
				conn:Disconnect()
				listening = false
				if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
					obj:Set(nil)
				else
					obj:Set(input.KeyCode)
				end
			end
		end)
	end)

	Library:_connect(UIS.InputBegan, function(input, gp)
		if gp or listening or not obj.Value or input.KeyCode ~= obj.Value then
			return
		end
		if mode == "Toggle" then
			obj.State = not obj.State
			if opts.Callback then
				task.spawn(opts.Callback, obj.State)
			end
		elseif mode == "Hold" then
			obj.State = true
			if opts.Callback then
				task.spawn(opts.Callback, true)
			end
		elseif opts.Callback then
			task.spawn(opts.Callback)
		end
	end)
	Library:_connect(UIS.InputEnded, function(input)
		if mode == "Hold" and obj.Value and input.KeyCode == obj.Value then
			obj.State = false
			if opts.Callback then
				task.spawn(opts.Callback, false)
			end
		end
	end)

	obj:Set(obj.Value, true)
	return obj
end

-- ColorPicker
function Section:AddColorPicker(opts)
	opts = opts or {}
	local row = self:_row(26, true)
	local obj = makeObj(opts, row, "ColorPicker")
	local h, s, v = (opts.Default or Color3.fromRGB(255, 255, 255)):ToHSV()

	local header = Create("Frame", { Parent = row, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 26), LayoutOrder = 1 })
	local label = newText({ Parent = header, Size = UDim2.new(1, -50, 1, 0), Text = opts.Name or "Color" })
	bind(label, { TextColor3 = "Text" })
	local swatch = Create("TextButton", {
		Parent = header, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(40, 18), AutoButtonColor = false, Text = "",
	})
	corner(swatch, 4)
	stroke(swatch)

	local panel = Create("Frame", {
		Parent = row, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 120), Visible = false, LayoutOrder = 2,
	})
	local sv = Create("TextButton", {
		Parent = panel, Size = UDim2.new(1, -26, 1, 0), AutoButtonColor = false, Text = "", ClipsDescendants = true,
	})
	corner(sv, 4)
	local white = Create("Frame", { Parent = sv, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1) })
	Create("UIGradient", { Parent = white, Transparency = NumberSequence.new(0, 1) })
	local black = Create("Frame", { Parent = sv, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0) })
	Create("UIGradient", { Parent = black, Rotation = 90, Transparency = NumberSequence.new(1, 0) })
	local svCursor = Create("Frame", {
		Parent = sv, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(10, 10),
		BackgroundTransparency = 1, ZIndex = 5,
	})
	corner(svCursor, 5)
	Create("UIStroke", { Parent = svCursor, Color = Color3.new(1, 1, 1), Thickness = 2 })

	local hue = Create("TextButton", {
		Parent = panel, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, 18, 1, 0), AutoButtonColor = false, Text = "", BackgroundColor3 = Color3.new(1, 1, 1),
	})
	corner(hue, 4)
	local seq = {}
	for i = 0, 6 do
		table.insert(seq, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 1, 1)))
	end
	Create("UIGradient", { Parent = hue, Rotation = 90, Color = ColorSequence.new(seq) })
	local hueCursor = Create("Frame", {
		Parent = hue, AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.new(1, 0, 0, 3), ZIndex = 5,
		BackgroundColor3 = Color3.new(1, 1, 1),
	})
	Create("UIStroke", { Parent = hueCursor, Color = Color3.new(0, 0, 0), Thickness = 1 })

	local function update(silent)
		local c = Color3.fromHSV(h, s, v)
		obj.Value = c
		swatch.BackgroundColor3 = c
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svCursor.Position = UDim2.fromScale(s, 1 - v)
		hueCursor.Position = UDim2.fromScale(0, h)
		setFlag(obj, c)
		if not silent and opts.Callback then
			task.spawn(opts.Callback, c)
		end
	end

	function obj:Set(color, silent)
		h, s, v = color:ToHSV()
		update(silent)
	end
	function obj:Get()
		return self.Value
	end
	function obj:Serialize()
		local c = self.Value
		return { math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) }
	end
	function obj:Deserialize(t)
		self:Set(Color3.fromRGB(t[1], t[2], t[3]))
	end

	trackDrag(sv, function(pos)
		s = math.clamp((pos.X - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
		v = 1 - math.clamp((pos.Y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
		update()
	end)
	trackDrag(hue, function(pos)
		h = math.clamp((pos.Y - hue.AbsolutePosition.Y) / math.max(hue.AbsoluteSize.Y, 1), 0, 0.999)
		update()
	end)
	swatch.MouseButton1Click:Connect(function()
		panel.Visible = not panel.Visible
	end)

	update(true)
	return obj
end

