local function newBody(parent)
	local scroll = Create("ScrollingFrame", {
		Parent = parent, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
		ScrollBarThickness = 3, AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(), ScrollingDirection = Enum.ScrollingDirection.Y,
		Visible = false,
	})
	bind(scroll, { ScrollBarImageColor3 = "Accent" })
	local function column(pos)
		local f = Create("Frame", {
			Parent = scroll, BackgroundTransparency = 1, Position = pos,
			Size = UDim2.new(0.5, -9, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		})
		listLayout(f, 12)
		return f
	end
	return { Frame = scroll, Left = column(UDim2.new(0, 0, 0, 0)), Right = column(UDim2.new(0.5, 3, 0, 0)), _n = 0, _order = 0 }
end

local function newSection(body, opts)
	opts = opts or {}
	local side = opts.Side
	local col
	if side == "Right" or side == 2 then
		col = body.Right
	elseif side == "Left" or side == 1 then
		col = body.Left
	else
		body._n = body._n + 1
		col = (body._n % 2 == 1) and body.Left or body.Right
	end
	body._order = body._order + 1

	local frame = Create("Frame", {
		Parent = col, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = body._order,
	})
	bind(frame, { BackgroundColor3 = "Inline" })
	corner(frame, 6)
	stroke(frame, "Border", 0.35)
	padding(frame, 10, 10, 10, 10)
	listLayout(frame, 8)

	local title = newText({
		Parent = frame, Size = UDim2.new(1, 0, 0, 16), Text = opts.Name or "Section",
		Font = Enum.Font.GothamBold, LayoutOrder = 0,
	})
	bind(title, { TextColor3 = "Light Accent" })

	return setmetatable({ Frame = frame, _order = 0 }, Section)
end

local Page = {}
Page.__index = Page

function Page:_ensureBody()
	if not self.Body then
		self.Body = newBody(self.Bodies)
		self.Body.Frame.Visible = (#self.SubPages == 0)
	end
	return self.Body
end

function Page:AddSection(opts)
	return newSection(self:_ensureBody(), opts)
end

function Page:_selectSub(sub)
	if self.Body then
		self.Body.Frame.Visible = false
	end
	for _, s in ipairs(self.SubPages) do
		local active = (s == sub)
		s.Body.Frame.Visible = active
		s.Underline.Visible = active
		s.Button.TextTransparency = active and 0 or 0.4
	end
end

function Page:AddSubPage(opts)
	opts = opts or {}
	if not self.SubBar then
		self.SubBar = Create("Frame", {
			Parent = self.Container, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30),
		})
		Create("UIListLayout", {
			Parent = self.SubBar, FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 16),
			SortOrder = Enum.SortOrder.LayoutOrder,
		})
		self.Bodies.Position = UDim2.fromOffset(0, 38)
		self.Bodies.Size = UDim2.new(1, 0, 1, -38)
	end
	local sub = { Page = self }
	sub.Body = newBody(self.Bodies)
	sub.Button = Create("TextButton", {
		Parent = self.SubBar, BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0), Text = opts.Name or "SubPage", Font = Enum.Font.GothamBold,
		TextSize = 13, AutoButtonColor = false, LayoutOrder = #self.SubPages + 1,
	})
	bind(sub.Button, { TextColor3 = "Text" })
	sub.Underline = Create("Frame", {
		Parent = sub.Button, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 2), Visible = false,
	})
	bind(sub.Underline, { BackgroundColor3 = "Accent" })
	function sub:AddSection(o)
		return newSection(self.Body, o)
	end
	table.insert(self.SubPages, sub)
	sub.Button.MouseButton1Click:Connect(function()
		self:_selectSub(sub)
	end)
	if #self.SubPages == 1 then
		self:_selectSub(sub)
	end
	return sub
end

