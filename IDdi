		Parent = page.Container, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
	})

	table.insert(self.Pages, page)
	btn.MouseButton1Click:Connect(function()
		self:SelectPage(page)
	end)
	if #self.Pages == 1 then
		self:SelectPage(page)
	end
	return page
end

function Window:SetOpen(open)
	if self.Open == open then
		return
	end
	self.Open = open
	local main = self.Main
	if open then
		main.Visible = true
		tween(main, self.FadeSpeed, { GroupTransparency = 0 })
	else
		tween(main, self.FadeSpeed, { GroupTransparency = 1 })
		task.delay(self.FadeSpeed, function()
			if not self.Open then
				main.Visible = false
			end
		end)
	end
end

function Window:Toggle()
	self:SetOpen(not self.Open)
end

function Window:SetToggleKey(key)
	self.ToggleKey = key
end

function Window:Destroy()
	self.Main:Destroy()
end

-- หน้า Settings สำเร็จรูป: ธีม, ปุ่มเปิด/ปิดเมนู, config, unload
function Window:BuildSettings()
	local page = self:AddPage({ Name = "Settings" })

	local ui = page:AddSection({ Name = "Interface", Side = "Left" })
	ui:AddDropdown({
		Name = "Theme", Options = Library.ThemeOrder, Default = Library.ThemeName, NoSave = false,
		Flag = "__Theme", Callback = function(name) Library:SetTheme(name) end,
	})
	ui:AddKeybind({
		Name = "Menu key", Default = self.ToggleKey, Mode = "Press", Flag = "__MenuKey", NoSave = true,
		ChangedCallback = function(key)
			if key then
				self:SetToggleKey(key)
			end
		end,
	})
	ui:AddButton({ Name = "Unload UI", Callback = function() Library:Unload() end })

	local cfg = page:AddSection({ Name = "Config", Side = "Right" })
	local nameInput = cfg:AddTextInput({ Name = "Config name", Placeholder = "default", Flag = "__CfgName", NoSave = true })
	local list = cfg:AddDropdown({ Name = "Configs", Options = Library:ListConfigs(), Flag = "__CfgList", NoSave = true })
	cfg:AddButton({
		Name = "Save",
		Callback = function()
			local n = nameInput:Get() ~= "" and nameInput:Get() or list:Get() or "default"
			local ok, err = Library:SaveConfig(n)
			Library:Notify({ Title = "Config", Content = ok and ("Saved: " .. n) or tostring(err), Duration = 3 })
			list:SetOptions(Library:ListConfigs())
		end,
	})
	cfg:AddButton({
		Name = "Load",
		Callback = function()
			local n = list:Get() or nameInput:Get()
			local ok, err = Library:LoadConfig(n or "")
			Library:Notify({ Title = "Config", Content = ok and ("Loaded: " .. n) or tostring(err), Duration = 3 })
		end,
	})
	cfg:AddButton({ Name = "Refresh list", Callback = function() list:SetOptions(Library:ListConfigs()) end })
	return page
end

