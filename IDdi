	local content = Create("Frame", {
		Parent = main, BackgroundTransparency = 1, Position = UDim2.fromOffset(181, 45),
		Size = UDim2.new(1, -181, 1, -45),
	})
	padding(content, pagePadding, pagePadding, pagePadding, pagePadding)
	win._content = content

	-- drag window (delta based)
	local startMouse, startPos
	trackDrag(top, function(pos, began)
		if began then
			startMouse, startPos = pos, main.Position
		elseif startMouse then
			local d = pos - startMouse
			main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)

	-- resize handle (2x12 + 12x2 accent lines, เหมือนในสคริปต์ต้นฉบับ)
	local hLine = Create("Frame", {
		Parent = main, AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1, 1),
		Size = UDim2.fromOffset(12, 2), ZIndex = 50,
	})
	local vLine = Create("Frame", {
		Parent = main, AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1, 1),
		Size = UDim2.fromOffset(2, 12), ZIndex = 50,
	})
	bind(hLine, { BackgroundColor3 = "Accent" })
	bind(vLine, { BackgroundColor3 = "Accent" })
	local grip = Create("TextButton", {
		Parent = main, AnchorPoint = Vector2.new(1, 1), Position = UDim2.fromScale(1, 1),
		Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 1, Text = "", ZIndex = 51, AutoButtonColor = false,
	})
	local minSize = opts.MinSize or Vector2.new(520, 360)
	local startSize
	trackDrag(grip, function(pos, began)
		if began then
			startMouse, startSize = pos, main.AbsoluteSize
		elseif startMouse then
			local d = pos - startMouse
			local maxV = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or Vector2.new(4000, 4000)
			main.Size = UDim2.fromOffset(
				math.clamp(startSize.X + d.X, minSize.X, maxV.X),
				math.clamp(startSize.Y + d.Y, minSize.Y, maxV.Y)
			)
		end
	end)

	-- toggle key
	self:_connect(UIS.InputBegan, function(input, gp)
		if not gp and input.KeyCode == win.ToggleKey then
			win:Toggle()
		end
	end)

	tween(main, win.FadeSpeed, { GroupTransparency = 0 })
	table.insert(self.Windows, win)
	return win
end

return Library
