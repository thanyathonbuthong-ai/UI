local function copyTable(t)
	local c = {}
	for k, v in pairs(t) do
		c[k] = v
	end
	return c
end

Library.Theme = copyTable(Library.Themes.Default)
local themed = setmetatable({}, { __mode = "k" }) -- [Instance] = { Property = ThemeKey }

-- ───────────────────────────── Helpers ─────────────────────────────
local function Create(class, props, children)
	local inst = Instance.new(class)
	if inst:IsA("GuiObject") then
		inst.BorderSizePixel = 0
	end
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then
			parent = v
		else
			inst[k] = v
		end
	end
	for _, c in ipairs(children or {}) do
		c.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function bind(inst, map)
	themed[inst] = map
	for prop, key in pairs(map) do
		inst[prop] = Library.Theme[key]
	end
	return inst
end

local function corner(parent, r)
	return Create("UICorner", { CornerRadius = UDim.new(0, r), Parent = parent })
end

local function stroke(parent, key, transparency)
	local s = Create("UIStroke", {
		Thickness = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Transparency = transparency or 0,
		Parent = parent,
	})
	bind(s, { Color = key or "Border" })
	return s
end

local function padding(parent, t, r, b, l)
	return Create("UIPadding", {
		PaddingTop = UDim.new(0, t), PaddingRight = UDim.new(0, r),
		PaddingBottom = UDim.new(0, b), PaddingLeft = UDim.new(0, l),
		Parent = parent,
	})
end

local function listLayout(parent, pad)
	return Create("UIListLayout", {
		Padding = UDim.new(0, pad or 0),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = parent,
	})
end

local function newText(props)
	props.BackgroundTransparency = 1
	props.Font = props.Font or Enum.Font.GothamMedium
	props.TextSize = props.TextSize or 13
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	return Create("TextLabel", props)
end

local function hitButton(parent)
	return Create("TextButton", {
		Parent = parent, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
		Text = "", AutoButtonColor = false, ZIndex = (parent.ZIndex or 1) + 2,
	})
end

local function tween(inst, t, props, style)
	local tw = TS:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function round(n, inc)
	if not inc or inc <= 0 then
		return n
	end
	local v = math.floor(n / inc + 0.5) * inc
	return tonumber(string.format("%.4f", v))
end

local function pointer(input)
	-- ScreenGui ใช้ IgnoreGuiInset = true จึงต้องบวก inset เข้าไปให้ตรงกับ AbsolutePosition
	local inset = GuiService:GetGuiInset()
	return Vector2.new(input.Position.X, input.Position.Y) + inset
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
end

function Library:_connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(self._connections, c)
	return c
end

local function trackDrag(button, fn)
	local dragging = false
	button.InputBegan:Connect(function(input)
		if isPress(input) then
			dragging = true
			fn(pointer(input), true)
		end
	end)
	Library:_connect(UIS.InputChanged, function(input)
		if dragging and isMove(input) then
			fn(pointer(input), false)
		end
	end)
	Library:_connect(UIS.InputEnded, function(input)
		if isPress(input) then
			dragging = false
		end
	end)
end

local function guiParent()
	if typeof(gethui) == "function" then
		local ok, res = pcall(gethui)
		if ok and res then
			return res
		end
	end
	local ok = pcall(function()
		local t = Instance.new("Folder")
		t.Parent = CoreGui
		t:Destroy()
	end)
	if ok then
		return CoreGui
	end
	return Players.LocalPlayer:WaitForChild("PlayerGui")
end

function Library:_getGui()
	if self._gui and self._gui.Parent then
		return self._gui
	end
	local gui = Create("ScreenGui", {
		Name = "UILibrary", ResetOnSpawn = false, IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 1000,
	})
	pcall(function()
		if syn and syn.protect_gui then
			syn.protect_gui(gui)
		end
	end)
	gui.Parent = guiParent()
	self._gui = gui
	return gui
end

-- ───────────────────────────── Theme API ─────────────────────────────
function Library:SetTheme(theme)
	if type(theme) == "string" then
		if not self.Themes[theme] then
			return
		end
		self.ThemeName = theme
		theme = self.Themes[theme]
	end
	for k, v in pairs(theme) do
		self.Theme[k] = v
	end
	for inst, map in pairs(themed) do
		for prop, key in pairs(map) do
			pcall(function()
				inst[prop] = self.Theme[key]
			end)
		end
	end
	for _, fn in ipairs(self._refreshers) do
		pcall(fn)
	end
end

function Library:AddTheme(name, theme)
	local base = copyTable(self.Themes.Default)
	for k, v in pairs(theme) do
		base[k] = v
	end
	self.Themes[name] = base
	table.insert(self.ThemeOrder, name)
end

-- ───────────────────────────── Notifications ─────────────────────────────
function Library:Notify(opts)
	if type(opts) == "string" then
		opts = { Content = opts }
	end
	opts = opts or {}
	local gui = self:_getGui()
	local holder = self._notifyHolder
	if not holder or not holder.Parent then
		holder = Create("Frame", {
			Name = "Notifications", Parent = gui, BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 16),
			Size = UDim2.fromOffset(280, 0), AutomaticSize = Enum.AutomaticSize.Y,
		})
		Create("UIListLayout", {
			Parent = holder, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
		})
		self._notifyHolder = holder
	end

	local duration = opts.Duration or 4
	local card = Create("CanvasGroup", {
		Parent = holder, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		GroupTransparency = 1,
	})
	bind(card, { BackgroundColor3 = "Background" })
	corner(card, 6)
	stroke(card, "Border")

	local inner = Create("Frame", {
		Parent = card, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	})
	padding(inner, 9, 10, 13, 14)
	listLayout(inner, 3)

	local bar = Create("Frame", { Parent = card, Size = UDim2.new(0, 3, 1, 0), ZIndex = 3 })
	bind(bar, { BackgroundColor3 = "Accent" })

	local title = newText({
		Parent = inner, Size = UDim2.new(1, 0, 0, 16), Text = opts.Title or "Notification",
		Font = Enum.Font.GothamBold, LayoutOrder = 1,
	})
	bind(title, { TextColor3 = "Light Accent" })

	if opts.Content and opts.Content ~= "" then
		local body = newText({
			Parent = inner, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
			Text = opts.Content, TextWrapped = true, TextSize = 12, Font = Enum.Font.Gotham,
			TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 2,
		})
		bind(body, { TextColor3 = "Text" })
	end

	local progress = Create("Frame", {
		Parent = card, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 2), ZIndex = 3,
	})
	bind(progress, { BackgroundColor3 = "Accent" })

	tween(card, 0.2, { GroupTransparency = 0 })
	tween(progress, duration, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)

	task.delay(duration, function()
		if card.Parent then
			tween(card, 0.25, { GroupTransparency = 1 })
			task.wait(0.28)
			card:Destroy()
		end
	end)
end

-- ───────────────────────────── Config ─────────────────────────────
function Library:_cfgPath(name)
	return self.Folder .. "/" .. name .. ".json"
end

function Library:SaveConfig(name)
	if not writefile then
		return false, "writefile ไม่รองรับ"
	end
	pcall(function()
		if makefolder and not (isfolder and isfolder(self.Folder)) then
			makefolder(self.Folder)
		end
	end)
	local data = {}
	for flag, opt in pairs(self.Options) do
		if opt.Serialize and not opt.NoSave then
			data[flag] = opt:Serialize()
		end
	end
	writefile(self:_cfgPath(name), HttpService:JSONEncode(data))
	return true
end

function Library:LoadConfig(name)
	if not (readfile and isfile and isfile(self:_cfgPath(name))) then
		return false, "ไม่พบไฟล์ config"
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(self:_cfgPath(name)))
	end)
	if not ok then
		return false, "ไฟล์ config เสีย"
	end
	for flag, value in pairs(data) do
		local opt = self.Options[flag]
		if opt and opt.Deserialize then
			pcall(opt.Deserialize, opt, value)
		end
	end
	return true
end

function Library:ListConfigs()
	local out = {}
	if listfiles and isfolder and isfolder(self.Folder) then
		for _, path in ipairs(listfiles(self.Folder)) do
			local name = path:match("([^/\\]+)%.json$")
			if name then
				table.insert(out, name)
			end
		end
	end
	table.sort(out)
	return out
end

function Library:Unload()
	for _, c in ipairs(self._connections) do
		pcall(function()
			c:Disconnect()
		end)
	end
	self._connections = {}
	self._refreshers = {}
	self.Flags = {}
	self.Options = {}
	if self._gui then
		self._gui:Destroy()
		self._gui = nil
		self._notifyHolder = nil
	end
	self.Windows = {}
end

-- ───────────────────────────── Elements ─────────────────────────────
local Section = {}
Section.__index = Section

local function setFlag(obj, value)
	if obj.Flag then
		Library.Flags[obj.Flag] = value
	end
end

local function makeObj(opts, row, kind)
	local obj = { Row = row, Type = kind, Flag = opts.Flag, NoSave = opts.NoSave }
	function obj:SetVisible(v)
		row.Visible = v
	end
	function obj:Destroy()
		if self.Flag then
			Library.Options[self.Flag] = nil
			Library.Flags[self.Flag] = nil
		end
		row:Destroy()
	end
	if opts.Flag then
		Library.Options[opts.Flag] = obj
	end
	return obj
end

function Section:_row(height, auto)
	self._order = self._order + 1
	local row = Create("Frame", {
		Parent = self.Frame, BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, height), LayoutOrder = self._order,
	})
	if auto then
		row.AutomaticSize = Enum.AutomaticSize.Y
		listLayout(row, 6)
	end
	return row
end

-- Toggle
function Section:AddToggle(opts)
	opts = opts or {}
	local row = self:_row(26)
	local obj = makeObj(opts, row, "Toggle")
	obj.Value = opts.Default == true

	local label = newText({ Parent = row, Size = UDim2.new(1, -30, 1, 0), Text = opts.Name or "Toggle" })
	bind(label, { TextColor3 = "Text" })

	local box = Create("Frame", {
		Parent = row, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(18, 18),
	})
	bind(box, { BackgroundColor3 = "Element" })
	corner(box, 4)
	stroke(box)
	local fill = Create("Frame", {
		Parent = box, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(0, 0),
	})
	bind(fill, { BackgroundColor3 = "Accent" })
	corner(fill, 3)

	function obj:Set(v, silent)
		v = not not v
		self.Value = v
		tween(fill, 0.12, { Size = v and UDim2.fromOffset(12, 12) or UDim2.fromOffset(0, 0) })
		setFlag(self, v)
		if not silent and opts.Callback then
			task.spawn(opts.Callback, v)
		end
	end
	function obj:Get()
		return self.Value
	end
	function obj:Serialize()
		return self.Value
	end
	function obj:Deserialize(v)
		self:Set(v)
	end

	hitButton(row).MouseButton1Click:Connect(function()
		obj:Set(not obj.Value)
	end)
	obj:Set(obj.Value, true)
	return obj
end

-- Slider
function Section:AddSlider(opts)
	opts = opts or {}
	local min, max, inc = opts.Min or 0, opts.Max or 100, opts.Increment or 1
	local row = self:_row(40)
	local obj = makeObj(opts, row, "Slider")
	obj.Value = math.clamp(opts.Default or min, min, max)

	local label = newText({ Parent = row, Size = UDim2.new(0.7, 0, 0, 18), Text = opts.Name or "Slider" })
	bind(label, { TextColor3 = "Text" })
	local valueLabel = newText({
		Parent = row, Size = UDim2.new(0.3, 0, 0, 18), Position = UDim2.fromScale(0.7, 0),
		TextXAlignment = Enum.TextXAlignment.Right, Text = "",
	})
	bind(valueLabel, { TextColor3 = "Light Accent" })

	local track = Create("Frame", { Parent = row, Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 6) })
	bind(track, { BackgroundColor3 = "Element" })
	corner(track, 3)
	stroke(track)
	local fill = Create("Frame", { Parent = track, Size = UDim2.fromScale(0, 1) })
	bind(fill, { BackgroundColor3 = "Accent" })
	corner(fill, 3)

	function obj:Set(v, silent)
		v = math.clamp(round(v, inc), min, max)
		self.Value = v
		local pct = (max == min) and 0 or (v - min) / (max - min)
		tween(fill, 0.06, { Size = UDim2.fromScale(pct, 1) })
		valueLabel.Text = tostring(v) .. (opts.Suffix or "")
		setFlag(self, v)
		if not silent and opts.Callback then
			task.spawn(opts.Callback, v)
		end
	end
	function obj:Get()
		return self.Value
	end
	function obj:Serialize()
		return self.Value
	end
	function obj:Deserialize(v)
		self:Set(tonumber(v) or min)
	end

	local hit = Create("TextButton", {
		Parent = row, BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
		Position = UDim2.fromOffset(0, 20), Size = UDim2.new(1, 0, 0, 18),
	})
	trackDrag(hit, function(pos)
		local pct = math.clamp((pos.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		obj:Set(min + (max - min) * pct)
	end)
	obj:Set(obj.Value, true)
	return obj
end

-- Button
function Section:AddButton(opts)
	opts = opts or {}
	local row = self:_row(28)
	local obj = makeObj(opts, row, "Button")
	local btn = Create("TextButton", {
		Parent = row, Size = UDim2.fromScale(1, 1), AutoButtonColor = false,
		Text = opts.Name or "Button", Font = Enum.Font.GothamMedium, TextSize = 13,
	})
	bind(btn, { BackgroundColor3 = "Element", TextColor3 = "Text" })
	corner(btn, 5)
	stroke(btn)

	btn.MouseEnter:Connect(function()
		tween(btn, 0.12, { BackgroundColor3 = Library.Theme.Border })
	end)
	btn.MouseLeave:Connect(function()
		tween(btn, 0.12, { BackgroundColor3 = Library.Theme.Element })
	end)
	btn.MouseButton1Click:Connect(function()
		btn.BackgroundColor3 = Library.Theme.Accent
		tween(btn, 0.25, { BackgroundColor3 = Library.Theme.Element })
		if opts.Callback then
			task.spawn(opts.Callback)
		end
	end)
	function obj:SetText(t)
		btn.Text = t
	end
	return obj
end

