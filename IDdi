local Window = {}
Window.__index = Window

function Window:SelectPage(page)
	for _, p in ipairs(self.Pages) do
		local active = (p == page)
		p.Container.Visible = active
		p.Indicator.Visible = active
		p.Button.BackgroundTransparency = active and 0 or 1
		p.Label.TextTransparency = active and 0 or 0.35
	end
	self.CurrentPage = page
end

function Window:AddPage(opts)
	opts = opts or {}
	local page = setmetatable({ Window = self, SubPages = {}, Name = opts.Name }, Page)

	local btn = Create("TextButton", {
		Parent = self._tabList, Size = UDim2.new(1, 0, 0, 32), AutoButtonColor = false, Text = "",
		BackgroundTransparency = 1, LayoutOrder = #self.Pages + 1,
	})
	bind(btn, { BackgroundColor3 = "Element" })
	corner(btn, 6)
	local indicator = Create("Frame", {
		Parent = btn, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(3, 14), Visible = false,
	})
	bind(indicator, { BackgroundColor3 = "Accent" })
	corner(indicator, 2)

	local textX = 12
	if opts.Icon then
		local icon = Create("ImageLabel", {
			Parent = btn, BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 12, 0.5, 0), Size = UDim2.fromOffset(16, 16), Image = opts.Icon,
		})
		bind(icon, { ImageColor3 = "Image" })
		textX = 36
	end
