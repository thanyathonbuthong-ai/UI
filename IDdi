		Parent = btn, Position = UDim2.fromOffset(textX, 0), Size = UDim2.new(1, -textX, 1, 0),
		Text = opts.Name or "Page", TextTransparency = 0.35,
	})
	bind(label, { TextColor3 = "Text" })

