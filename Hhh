--------------------------------------------------------------------------------
-- Small utilities
--------------------------------------------------------------------------------

local function newSignal()
    local handlers = {}
    local sig = {}
    function sig:Connect(fn)
        local h = { fn = fn }
        table.insert(handlers, h)
        return {
            Disconnect = function()
                local i = table.find(handlers, h)
                if i then table.remove(handlers, i) end
            end,
        }
    end
    function sig:Fire(...)
        for _, h in ipairs(table.clone(handlers)) do
            task.spawn(h.fn, ...)
        end
    end
    return sig
end
Library.NewSignal = newSignal

local function track(conn)
    table.insert(Library._conns, conn)
    return conn
end

local function tween(inst, props, time, style)
    local tw = TweenService:Create(inst, TweenInfo.new(time or 0.15, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

local function isPress(input)
    return input.UserInputType == MB1 or input.UserInputType == TOUCH
end

local function bind(inst, prop, token)
    inst[prop] = Library.Theme[token]
    local list = Library._bindings[token]
    if not list then
        list = {}
        Library._bindings[token] = list
    end
    table.insert(list, { inst, prop })
end

local DEFAULTS = {
    Frame = { BorderSizePixel = 0 },
    CanvasGroup = { BorderSizePixel = 0 },
    ImageLabel = { BorderSizePixel = 0, BackgroundTransparency = 1 },
    ScrollingFrame = { BorderSizePixel = 0, BackgroundTransparency = 1 },
    TextLabel = { BorderSizePixel = 0, BackgroundTransparency = 1, FontFace = FONT_REG, TextSize = 15, Text = "", TextXAlignment = Enum.TextXAlignment.Left },
    TextButton = { BorderSizePixel = 0, AutoButtonColor = false, FontFace = FONT_REG, TextSize = 15, Text = "" },
    TextBox = { BorderSizePixel = 0, FontFace = FONT_REG, TextSize = 14, Text = "", ClearTextOnFocus = false },
}
local TEXT_CLASSES = { TextLabel = true, TextButton = true, TextBox = true }

-- make(class, props, parent). props.Bind = { Property = "ThemeToken" }
local function make(class, props, parent)
    local inst = Instance.new(class)
    local defaults = DEFAULTS[class]
    if defaults then
        for k, v in pairs(defaults) do inst[k] = v end
    end
    local binds = props and props.Bind
    if props then
        for k, v in pairs(props) do
            if k ~= "Bind" then inst[k] = v end
        end
    end
    if TEXT_CLASSES[class] and not (props and props.TextColor3) and not (binds and binds.TextColor3) then
        bind(inst, "TextColor3", "TextColor")
    end
    if binds then
        for prop, token in pairs(binds) do bind(inst, prop, token) end
    end
    if parent then inst.Parent = parent end
    return inst
end

local function corner(parent, radius)
    return make("UICorner", { CornerRadius = UDim.new(0, radius or 6) }, parent)
end

local function stroke(parent, token, thickness)
    return make("UIStroke", {
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Bind = { Color = token or "Outline" },
    }, parent)
end

local function padding(parent, l, t, r, b)
    return make("UIPadding", {
        PaddingLeft = UDim.new(0, l or 0), PaddingTop = UDim.new(0, t or 0),
        PaddingRight = UDim.new(0, r or 0), PaddingBottom = UDim.new(0, b or 0),
    }, parent)
end

local function list(parent, dir, gap, props)
    local l = make("UIListLayout", {
        FillDirection = dir or Enum.FillDirection.Vertical,
        Padding = UDim.new(0, gap or 0),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, nil)
    if props then
        for k, v in pairs(props) do l[k] = v end
    end
    l.Parent = parent
    return l
end

local function gradient(parent, tokens, rotation)
    local g = make("UIGradient", { Rotation = rotation or 90 }, parent)
    local function apply()
        local n = #tokens
        local kps = {}
        if n == 1 then
            kps[1] = ColorSequenceKeypoint.new(0, Library.Theme[tokens[1]])
            kps[2] = ColorSequenceKeypoint.new(1, Library.Theme[tokens[1]])
        else
            for i, t in ipairs(tokens) do
                kps[i] = ColorSequenceKeypoint.new((i - 1) / (n - 1), Library.Theme[t])
            end
        end
        g.Color = ColorSequence.new(kps)
    end
    apply()
    table.insert(Library._gradients, { apply = apply, tokens = tokens })
    return g
end

local function ripple(button, radius)
    local holder = make("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ClipsDescendants = true }, button)
    if radius then corner(holder, radius) end
    button.InputBegan:Connect(function(input)
        if not isPress(input) then return end
        local sc = Library._scale
        local abs, size = button.AbsolutePosition, button.AbsoluteSize
        local x, y = (input.Position.X - abs.X) / sc, (input.Position.Y - abs.Y) / sc
        local d = math.max(size.X, size.Y) / sc * 2.2
        local r = make("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x, y),
            Size = UDim2.fromOffset(0, 0), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.84,
        }, holder)
        corner(r, 999)
        tween(r, { Size = UDim2.fromOffset(d, d), BackgroundTransparency = 1 }, 0.45)
        task.delay(0.5, function() r:Destroy() end)
    end)
end

-- Drag helper: calls onMove(position) on press and while the pointer moves.
local function dragger(obj, onMove)
    obj.InputBegan:Connect(function(input)
        if not isPress(input) then return end
        onMove(input.Position)
        local move, up
        move = UIS.InputChanged:Connect(function(i)
            if i.UserInputType == MOVE or i.UserInputType == TOUCH then onMove(i.Position) end
        end)
        up = UIS.InputEnded:Connect(function(i)
            if isPress(i) then
                move:Disconnect()
                up:Disconnect()
            end
        end)
    end)
end

local function makeDraggable(handle, target)
    handle.InputBegan:Connect(function(input)
        if not isPress(input) then return end
        local start, startPos = input.Position, target.Position
        local move, up
        move = UIS.InputChanged:Connect(function(i)
            if i.UserInputType == MOVE or i.UserInputType == TOUCH then
                local d = i.Position - start
                target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end)
        up = UIS.InputEnded:Connect(function(i)
            if isPress(i) then
                move:Disconnect()
                up:Disconnect()
            end
        end)
    end)
end

local function commit(obj, o, silent)
    if o.Flag then Library.Flags[o.Flag] = obj.Value end
    if not silent then
        if o.Callback then task.spawn(o.Callback, obj.Value) end
        obj.Changed:Fire(obj.Value)
    end
end

local function register(obj, o, kind)
    obj.Kind = kind
    obj.Changed = newSignal()
    function obj:OnChanged(fn)
        self.Changed:Connect(fn)
        return self
    end
    if o.Flag then
        Library.Options[o.Flag] = obj
        Library.Flags[o.Flag] = obj.Value
    end
end

--------------------------------------------------------------------------------
-- Theme
--------------------------------------------------------------------------------

function Library:SetTheme(token, color)
    if self.Theme[token] == nil or typeof(color) ~= "Color3" then return end
    self.Theme[token] = color
    for _, b in ipairs(self._bindings[token] or {}) do
        pcall(function() b[1][b[2]] = color end)
    end
    for _, g in ipairs(self._gradients) do
        if table.find(g.tokens, token) then pcall(g.apply) end
    end
end

--------------------------------------------------------------------------------
-- Root GUI / overlay / tooltip / popups / notifications
--------------------------------------------------------------------------------

local function guiParent()
    local ok, h = pcall(function() return genv.gethui and genv.gethui() end)
    if ok and h then return h end
    if pcall(function() return CoreGui.Name end) then return CoreGui end
    return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local function matchesKey(input, key)
    if key.EnumType == Enum.KeyCode then
        return input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == key
    end
    return input.UserInputType == key
end

function Library:_UpdateScale()
    local cam = workspace.CurrentCamera
    if not cam then return end
    local vp, d = cam.ViewportSize, self.Metrics.DesignSize
    local s = math.clamp(math.min(vp.X / (d.X + 40), vp.Y / (d.Y + 40)), 0.45, 1)
    self._scale = s
    for _, u in ipairs(self._scales) do u.Scale = s end
end

function Library:_Init()
    if self._gui then return end

    local gui = make("ScreenGui", {
        Name = HttpService:GenerateGUID(false),
        ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = 100, IgnoreGuiInset = false,
    })
    pcall(function() if genv.syn and genv.syn.protect_gui then genv.syn.protect_gui(gui) end end)
    gui.Parent = guiParent()
    self._gui = gui

    -- Overlay: popups + tooltip live here (same scale as windows).
    local overlay = make("Frame", { Name = "Overlay", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 50 }, gui)
    local ovScale = make("UIScale", {}, overlay)
    table.insert(self._scales, ovScale)
    self._overlay = overlay

    -- Notifications (bottom-right).
    local holder = make("Frame", {
        Name = "Notifications", BackgroundTransparency = 1, Position = UDim2.new(1, -16, 0, 16),
        AnchorPoint = Vector2.new(1, 0), Size = UDim2.new(0, 290, 1, -32), ZIndex = 80,
    }, gui)
    list(holder, nil, 8, { VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Right })
    self._notifHolder = holder

    -- Tooltip.
    local tip = make("Frame", {
        Name = "Tooltip", Visible = false, AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.fromOffset(0, 0),
        ZIndex = 100, Bind = { BackgroundColor3 = "ElementBackground" },
    }, overlay)
    corner(tip, 5)
    stroke(tip)
    padding(tip, 8, 5, 8, 5)
    make("UISizeConstraint", { MaxSize = Vector2.new(260, math.huge) }, tip)
    self._tip = tip
    self._tipText = make("TextLabel", {
        AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.fromOffset(0, 0), TextSize = 13, TextWrapped = true, ZIndex = 101,
    }, tip)
    self._tipToken = 0

    self:_UpdateScale()
    local cam = workspace.CurrentCamera
    if cam then track(cam:GetPropertyChangedSignal("ViewportSize"):Connect(function() self:_UpdateScale() end)) end

    -- Close popup when pressing outside of it.
    track(UIS.InputBegan:Connect(function(input)
        local p = self._popup
        if p and isPress(input) then
            local pos = input.Position
            local function inside(g)
                local a, s = g.AbsolutePosition, g.AbsoluteSize
                return pos.X >= a.X and pos.X <= a.X + s.X and pos.Y >= a.Y and pos.Y <= a.Y + s.Y
            end
            if not inside(p.frame) and not inside(p.anchor) then self:_ClosePopup() end
        end
    end))

    -- Keybinds + window toggle key.
    track(UIS.InputBegan:Connect(function(input, processed)
        if UIS:GetFocusedTextBox() then return end
        for _, w in ipairs(self._windows) do
            if w.ToggleKey and not processed and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == w.ToggleKey then
                w:Toggle()
            end
        end
        for _, kb in ipairs(self._keybinds) do
            if kb.Key and not kb._listening and kb.Mode ~= "Pick" and kb.Mode ~= "Always" and matchesKey(input, kb.Key) then
                if kb.Mode == "Toggle" then
                    kb:_Trigger(not (kb.Toggle and kb.Toggle.Value or kb.Active))
                elseif kb.Mode == "Hold" then
                    kb:_Trigger(true)
                end
            end
        end
    end))
    track(UIS.InputEnded:Connect(function(input)
        for _, kb in ipairs(self._keybinds) do
            if kb.Key and kb.Mode == "Hold" and matchesKey(input, kb.Key) then kb:_Trigger(false) end
        end
    end))
end

-- Popups (dropdown lists, color picker) --------------------------------------

function Library:_ClosePopup()
    local p = self._popup
    if not p then return end
    self._popup = nil
    p.frame:Destroy()
    if p.onClose then pcall(p.onClose) end
end

function Library:_OpenPopup(anchor, size, build, onClose)
    self:_ClosePopup()
    local sc = self._scale
    local abs, asz = anchor.AbsolutePosition, anchor.AbsoluteSize
    local frame = make("Frame", {
        Size = UDim2.fromOffset(size.X, size.Y), ZIndex = 60, Bind = { BackgroundColor3 = "ElementBackground" },
    }, self._overlay)
    corner(frame, 6)
    stroke(frame)

    local vp = workspace.CurrentCamera.ViewportSize
    local x, y = abs.X, abs.Y + asz.Y + 4
    if x + size.X * sc > vp.X - 8 then x = vp.X - 8 - size.X * sc end
    if y + size.Y * sc > vp.Y - 8 then y = abs.Y - 4 - size.Y * sc end
    frame.Position = UDim2.fromOffset(x / sc, y / sc)

    self._popup = { frame = frame, anchor = anchor, onClose = onClose }
    build(frame)
    return frame
end

function Library:_IsPopupOpen(anchor)
    return self._popup ~= nil and self._popup.anchor == anchor
end

-- Tooltip ---------------------------------------------------------------------

local function moveTip()
    local m = UIS:GetMouseLocation() - GuiService:GetGuiInset()
    local sc = Library._scale
    Library._tip.Position = UDim2.fromOffset(m.X / sc + 14, m.Y / sc + 18)
end

local function tooltip(obj, text)
    if not text or text == "" then return end
    obj.MouseEnter:Connect(function()
        Library._tipToken += 1
        local token = Library._tipToken
        task.delay(0.4, function()
            if Library._tipToken == token and not Library.Unloaded then
                Library._tipText.Text = text
                moveTip()
                Library._tip.Visible = true
            end
        end)
    end)
    obj.MouseMoved:Connect(function()
        if Library._tip.Visible then moveTip() end
    end)
    obj.MouseLeave:Connect(function()
        Library._tipToken += 1
        Library._tip.Visible = false
    end)
end

-- Notifications ---------------------------------------------------------------

function Library:Notify(o)
    self:_Init()
    if type(o) == "string" then o = { Text = o } end
    local duration = o.Duration or 4

    local item = make("CanvasGroup", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, GroupTransparency = 1,
        Bind = { BackgroundColor3 = "ElementBackground" },
    }, self._notifHolder)
    corner(item, 6)
    stroke(item)
    make("Frame", { Size = UDim2.new(0, 3, 1, 0), Bind = { BackgroundColor3 = "Accent" } }, item)

    local content = make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, item)
    padding(content, 15, 10, 10, 12)
    list(content, nil, 3)
    if o.Title then
        make("TextLabel", {
            Size = UDim2.new(1, 0, 0, 18), Text = o.Title, FontFace = FONT_SEMI, TextSize = 15, LayoutOrder = 1,
        }, content)
    end
    make("TextLabel", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Text = o.Text or "",
        TextSize = 14, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 2,
    }, content)

    local bar = make("Frame", {
        AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 2),
        Bind = { BackgroundColor3 = "Accent" },
    }, item)

    tween(item, { GroupTransparency = 0 }, 0.25)
    tween(bar, { Size = UDim2.new(0, 0, 0, 2) }, duration, Enum.EasingStyle.Linear)
    task.delay(duration, function()
        if item.Parent then
            tween(item, { GroupTransparency = 1 }, 0.25)
            task.wait(0.3)
            item:Destroy()
        end
    end)
end

--------------------------------------------------------------------------------
-- Keybind / Color (shared by toggles and standalone rows)
--------------------------------------------------------------------------------

local KEY_SHORT = {
    MouseButton1 = "M1", MouseButton2 = "M2", MouseButton3 = "M3", LeftShift = "LShift", RightShift = "RShift",
    LeftControl = "LCtrl", RightControl = "RCtrl", LeftAlt = "LAlt", RightAlt = "RAlt", Backspace = "Bksp",
    Return = "Enter", Escape = "Esc",
}
local function keyName(key)
    if not key then return "None" end
    return KEY_SHORT[key.Name] or key.Name
end

local function makeKeybind(parent, o, order)
    local kb = {
        Key = o.Default, Mode = o.Mode or "Toggle", Active = false, Toggle = o.Toggle,
        Value = nil, KeyChanged = newSignal(), _listening = false,
    }
    kb.Value = kb.Active

    local btn = make("TextButton", {
        Size = UDim2.fromOffset(0, 20), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = order or 1,
        Text = keyName(kb.Key), TextSize = 12, Bind = { BackgroundColor3 = "ToggleBackgroundUnselected" },
    }, parent)
    corner(btn, 4)
    stroke(btn)
    padding(btn, 8, 0, 8, 0)
    make("UISizeConstraint", { MinSize = Vector2.new(40, 20) }, btn)

    function kb:_Trigger(state)
        if self.Toggle then
            self.Toggle:Set(state)
        else
            self.Active = state
            self.Value = state
            if o.Flag then Library.Flags[o.Flag] = state end
            if o.Callback then task.spawn(o.Callback, state) end
            self.Changed:Fire(state)
        end
    end

    function kb:SetKey(key, silent)
        self.Key = key
        btn.Text = keyName(key)
        if not silent then self.KeyChanged:Fire(key) end
    end

    function kb:SetMode(mode)
        self.Mode = mode
        if mode == "Always" then self:_Trigger(true) end
    end

    register(kb, o, "Keybind")
    function kb:Serialize()
        return { Key = self.Key and self.Key.Name, Type = self.Key and tostring(self.Key.EnumType), Mode = self.Mode }
    end
    function kb:Load(data)
        if type(data) ~= "table" then return end
        if data.Key and data.Type and Enum[data.Type] and Enum[data.Type][data.Key] then
            self:SetKey(Enum[data.Type][data.Key])
        else
            self:SetKey(nil)
        end
        if data.Mode then self:SetMode(data.Mode) end
    end

    btn.Activated:Connect(function()
        if kb._listening then return end
        kb._listening = true
        btn.Text = "..."
        local c
        c = UIS.InputBegan:Connect(function(input)
            local key
            if input.UserInputType == Enum.UserInputType.Keyboard then
                key = input.KeyCode
                if key == Enum.KeyCode.Escape or key == Enum.KeyCode.Backspace then key = false end
            elseif input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then
                key = input.UserInputType
            else
                return
            end
            c:Disconnect()
            kb._listening = false
            kb:SetKey(key or nil)
        end)
    end)

    if kb.Mode ~= "Pick" then
        btn.MouseButton2Click:Connect(function()
            local modes = { "Toggle", "Hold", "Always" }
            local i = table.find(modes, kb.Mode) or 1
            kb:SetMode(modes[i % #modes + 1])
            Library:Notify({ Text = "Keybind mode: " .. kb.Mode, Duration = 1.5 })
        end)
    end

    table.insert(Library._keybinds, kb)
    if kb.Mode == "Always" then kb:_Trigger(true) end
    return kb
end

local function makeColor(parent, o, order)
    local col = { Value = o.Default or Color3.new(1, 1, 1) }
    local h, s, v = col.Value:ToHSV()

    local sw = make("TextButton", {
        Size = UDim2.fromOffset(28, 16), LayoutOrder = order or 1, BackgroundColor3 = col.Value,
    }, parent)
    corner(sw, 4)
    stroke(sw)

    register(col, o, "Color")
    local refresh -- set while popup is open

    function col:Set(color, silent)
        if typeof(color) ~= "Color3" then return end
        self.Value = color
        h, s, v = color:ToHSV()
        sw.BackgroundColor3 = color
        if refresh then refresh() end
        commit(self, o, silent)
    end
    function col:Serialize()
        local c = self.Value
        return { math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) }
    end
    function col:Load(data)
        if type(data) == "table" and #data == 3 then self:Set(Color3.fromRGB(data[1], data[2], data[3])) end
    end

    local function pushHSV()
        col.Value = Color3.fromHSV(h, s, v)
        sw.BackgroundColor3 = col.Value
        commit(col, o, false)
    end

    sw.Activated:Connect(function()
        if Library:_IsPopupOpen(sw) then
            Library:_ClosePopup()
            return
        end
        Library:_OpenPopup(sw, Vector2.new(196, 184), function(frame)
            local svBox = make("TextButton", {
                Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(176, 110), BackgroundColor3 = Color3.fromHSV(h, 1, 1),
            }, frame)
            corner(svBox, 4)
            local white = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1) }, svBox)
            corner(white, 4)
            make("UIGradient", { Transparency = NumberSequence.new(0, 1) }, white)
            local black = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0) }, svBox)
            corner(black, 4)
            make("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }, black)
            local cursor = make("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(10, 10), BackgroundTransparency = 1, ZIndex = 3,
            }, svBox)
            corner(cursor, 999)
            make("UIStroke", { Thickness = 2, Color = Color3.new(1, 1, 1), ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, cursor)

            local hueBar = make("TextButton", {
                Position = UDim2.fromOffset(10, 128), Size = UDim2.fromOffset(176, 12), BackgroundColor3 = Color3.new(1, 1, 1),
            }, frame)
            corner(hueBar, 4)
            local kps = {}
            for i = 0, 6 do kps[i + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 1, 1)) end
            make("UIGradient", { Color = ColorSequence.new(kps) }, hueBar)
            local hueCursor = make("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(4, 16), Position = UDim2.fromScale(h, 0.5),
                BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 3,
            }, hueBar)
            corner(hueCursor, 2)

            local hex = make("TextBox", {
                Position = UDim2.fromOffset(10, 150), Size = UDim2.fromOffset(176, 24), Text = "#" .. col.Value:ToHex(),
                TextSize = 13, Bind = { BackgroundColor3 = "ToggleBackgroundUnselected" },
            }, frame)
            corner(hex, 4)
            stroke(hex)

            refresh = function()
                svBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                cursor.Position = UDim2.fromScale(s, 1 - v)
                hueCursor.Position = UDim2.fromScale(h, 0.5)
                if not hex:IsFocused() then hex.Text = "#" .. col.Value:ToHex() end
            end
            refresh()

            dragger(svBox, function(pos)
                s = math.clamp((pos.X - svBox.AbsolutePosition.X) / svBox.AbsoluteSize.X, 0, 1)
                v = 1 - math.clamp((pos.Y - svBox.AbsolutePosition.Y) / svBox.AbsoluteSize.Y, 0, 1)
                pushHSV()
                refresh()
            end)
            dragger(hueBar, function(pos)
                h = math.clamp((pos.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
                pushHSV()
                refresh()
            end)
            hex.FocusLost:Connect(function()
                local ok, c = pcall(Color3.fromHex, hex.Text)
                if ok and c then col:Set(c) else hex.Text = "#" .. col.Value:ToHex() end
            end)
        end, function() refresh = nil end)
    end)

    return col
end

