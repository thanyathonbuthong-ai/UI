local Section = {}
Section.__index = Section

function Section:_RowBase(height)
    self._order += 1
    local row = make("Frame", {
        Name = "Row", BackgroundTransparency = 1, LayoutOrder = self._order,
        Size = UDim2.new(1, 0, 0, height or Library.Metrics.RowHeight),
    }, self.Frame)
    return row
end

-- Row with label (flex) on the left and an auto-sized container on the right.
function Section:_Row(labelText, tip, height)
    local row = self:_RowBase(height)
    list(row, Enum.FillDirection.Horizontal, 8, { VerticalAlignment = Enum.VerticalAlignment.Center })
    local lbl = make("TextLabel", {
        Size = UDim2.new(0, 0, 1, 0), Text = labelText or "", TextSize = Library.Metrics.RowTextSize,
        TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 0,
    }, row)
    pcall(function() make("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill }, lbl) end)
    local right = make("Frame", {
        BackgroundTransparency = 1, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = 1,
    }, row)
    list(right, Enum.FillDirection.Horizontal, 8, {
        HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Center,
    })
    tooltip(row, tip)
    return row, lbl, right
end

local function rowApi(obj, row, lbl)
    function obj:SetLabel(t)
        if lbl then lbl.Text = t end
        return self
    end
    function obj:SetVisible(b)
        row.Visible = b
        return self
    end
    function obj:Destroy()
        row:Destroy()
    end
end

-- Toggle ----------------------------------------------------------------------

function Section:AddToggle(o)
    o = o or {}
    local row, lbl, right = self:_Row(o.Label or "Toggle", o.Tooltip)
    local obj = { Value = o.Default == true, Row = row, _right = right, _nextOrder = 1 }

    local track_ = make("Frame", {
        Size = UDim2.fromOffset(32, 20), BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = 100,
    }, right)
    gradient(track_, { "ToggleBackgroundUnselected", "GradientDark" }, 90)
    corner(track_, 10)
    local fill = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Bind = { BackgroundColor3 = "Accent" } }, track_)
    corner(fill, 10)
    local knob = make("Frame", {
        Size = UDim2.fromOffset(16, 16), Position = UDim2.fromOffset(3, 2), Bind = { BackgroundColor3 = "ToggleCircleUnselected" },
    }, track_)
    corner(knob, 8)

    local function visuals(animate)
        local on = obj.Value
        local pos = on and UDim2.fromOffset(13, 2) or UDim2.fromOffset(3, 2)
        local knobColor = on and Color3.new(1, 1, 1) or Library.Theme.ToggleCircleUnselected
        local transp = on and 0 or 1
        if animate then
            tween(fill, { BackgroundTransparency = transp })
            tween(knob, { Position = pos, BackgroundColor3 = knobColor })
        else
            fill.BackgroundTransparency, knob.Position, knob.BackgroundColor3 = transp, pos, knobColor
        end
    end
    visuals(false)

    register(obj, o, "Toggle")
    function obj:Set(v, silent)
        v = v and true or false
        if v == self.Value then return end
        self.Value = v
        visuals(true)
        commit(self, o, silent)
    end
    function obj:Serialize() return self.Value end
    function obj:Load(d) if type(d) == "boolean" then self:Set(d, false) end end
    rowApi(obj, row, lbl)

    row.InputBegan:Connect(function(input)
        if isPress(input) then obj:Set(not obj.Value) end
    end)

    function obj:AddKeybind(ko)
        ko = ko or {}
        ko.Toggle = self
        self._nextOrder += 1
        return makeKeybind(self._right, ko, self._nextOrder)
    end
    function obj:AddColor(co)
        self._nextOrder += 1
        return makeColor(self._right, co or {}, self._nextOrder)
    end
    return obj
end

-- Slider ----------------------------------------------------------------------

function Section:AddSlider(o)
    o = o or {}
    local min, max = o.Min or 0, o.Max or 100
    local inc = o.Increment or 1
    local suffix = o.Suffix or ""
    local decimals = 0
    do
        local str = tostring(inc)
        local dot = str:find("%.")
        if dot then decimals = #str - dot end
    end
    local function round(x)
        x = math.floor(x / inc + 0.5) * inc
        return tonumber(string.format("%." .. decimals .. "f", math.clamp(x, min, max)))
    end

    local row = self:_RowBase(40)
    tooltip(row, o.Tooltip)
    local lbl = make("TextLabel", {
        Size = UDim2.new(1, -70, 0, 20), Text = o.Label or "Slider", TextSize = Library.Metrics.RowTextSize, TextTruncate = Enum.TextTruncate.AtEnd,
    }, row)
    local valueLbl = make("TextLabel", {
        AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(70, 20),
        TextXAlignment = Enum.TextXAlignment.Right, TextSize = 14, Bind = { TextColor3 = "Unselected" },
    }, row)
    local trackBtn = make("TextButton", { Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1 }, row)
    local trackBar = make("Frame", {
        AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = Color3.new(1, 1, 1),
    }, trackBtn)
    gradient(trackBar, { "ToggleBackgroundUnselected", "GradientDark" }, 90)
    corner(trackBar, 3)
    stroke(trackBar)
    local fill = make("Frame", { Size = UDim2.fromScale(0, 1), Bind = { BackgroundColor3 = "Accent" } }, trackBar)
    corner(fill, 3)
    local thumb = make("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = Color3.new(1, 1, 1),
    }, trackBar)
    corner(thumb, 6)

    local obj = { Value = round(o.Default or min), Row = row }
    local function visuals(animate)
        local a = (max == min) and 0 or (obj.Value - min) / (max - min)
        valueLbl.Text = string.format("%." .. decimals .. "f", obj.Value) .. suffix
        if animate then
            tween(fill, { Size = UDim2.fromScale(a, 1) }, 0.08)
            tween(thumb, { Position = UDim2.fromScale(a, 0.5) }, 0.08)
        else
            fill.Size, thumb.Position = UDim2.fromScale(a, 1), UDim2.fromScale(a, 0.5)
        end
    end
    visuals(false)

    register(obj, o, "Slider")
    function obj:Set(x, silent)
        if type(x) ~= "number" then return end
        x = round(x)
        if x == self.Value then return end
        self.Value = x
        visuals(true)
        commit(self, o, silent)
    end
    function obj:Serialize() return self.Value end
    function obj:Load(d) self:Set(d) end
    rowApi(obj, row, lbl)

    dragger(trackBtn, function(pos)
        local a = math.clamp((pos.X - trackBar.AbsolutePosition.X) / trackBar.AbsoluteSize.X, 0, 1)
        obj:Set(min + a * (max - min))
    end)
    return obj
end

-- Dropdown (single / multi) ---------------------------------------------------

function Section:AddDropdown(o)
    o = o or {}
    local multi = o.Multi == true
    local row, lbl, right = self:_Row(o.Label or "Dropdown", o.Tooltip)
    local obj = { Options = o.Options or {}, Multi = multi, Row = row }
    obj.Value = multi and {} or nil

    local btn = make("TextButton", {
        Size = UDim2.fromOffset(o.Width or 140, Library.Metrics.ControlHeight), LayoutOrder = 100, TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
        Bind = { BackgroundColor3 = "ToggleBackgroundUnselected" },
    }, right)
    corner(btn, 5)
    stroke(btn)
    padding(btn, 8, 0, 22, 0)
    make("TextLabel", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 18, 0.5, 0), Size = UDim2.fromOffset(14, 14),
        Text = "▾", TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center, Bind = { TextColor3 = "Unselected" },
    }, btn)

    local function display()
        if multi then
            local picked = {}
            for _, name in ipairs(obj.Options) do
                if obj.Value[name] then table.insert(picked, tostring(name)) end
            end
            btn.Text = #picked > 0 and table.concat(picked, ", ") or (o.Placeholder or "None")
        else
            btn.Text = obj.Value ~= nil and tostring(obj.Value) or (o.Placeholder or "None")
        end
    end

    local rebuild -- repopulates the open popup
    register(obj, o, "Dropdown")

    function obj:Set(v, silent)
        if multi then
            local map = {}
            if type(v) == "table" then
                for k, val in pairs(v) do
                    if type(k) == "number" then map[val] = true elseif val then map[k] = true end
                end
            end
            self.Value = map
        else
            if v ~= nil and not table.find(self.Options, v) then return end
            self.Value = v
        end
        display()
        if rebuild then rebuild() end
        commit(self, o, silent)
    end
    function obj:SetOptions(opts)
        self.Options = opts
        if multi then
            for k in pairs(self.Value) do
                if not table.find(opts, k) then self.Value[k] = nil end
            end
        elseif self.Value ~= nil and not table.find(opts, self.Value) then
            self.Value = nil
        end
        display()
        if rebuild then rebuild() end
    end
    function obj:Serialize()
        if not multi then return self.Value end
        local out = {}
        for _, name in ipairs(self.Options) do
            if self.Value[name] then table.insert(out, name) end
        end
        return out
    end
    function obj:Load(d) self:Set(d, false) end
    rowApi(obj, row, lbl)

    if o.Default ~= nil then
        if multi then
            local map = {}
            for _, name in ipairs(o.Default) do map[name] = true end
            obj.Value = map
        elseif table.find(obj.Options, o.Default) then
            obj.Value = o.Default
        end
        if o.Flag then Library.Flags[o.Flag] = obj.Value end
    end
    display()

    btn.Activated:Connect(function()
        if Library:_IsPopupOpen(btn) then
            Library:_ClosePopup()
            return
        end
        local rows = #obj.Options
        local height = math.min(rows, 7) * 24 + 8
        local width = math.max(btn.AbsoluteSize.X / Library._scale, 120)
        Library:_OpenPopup(btn, Vector2.new(width, math.max(height, 32)), function(frame)
            local scroll = make("ScrollingFrame", {
                Size = UDim2.fromScale(1, 1), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
                ScrollBarThickness = 3, ZIndex = 61, Bind = { ScrollBarImageColor3 = "Accent" },
            }, frame)
            padding(scroll, 4, 4, 4, 4)
            list(scroll, nil, 0)
            rebuild = function()
                for _, c in ipairs(scroll:GetChildren()) do
                    if c:IsA("TextButton") then c:Destroy() end
                end
                for i, name in ipairs(obj.Options) do
                    local selected = multi and obj.Value[name] or (not multi and obj.Value == name)
                    local item = make("TextButton", {
                        Size = UDim2.new(1, -4, 0, 24), LayoutOrder = i, Text = tostring(name), TextSize = 14, ZIndex = 62,
                        TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
                        BackgroundColor3 = Library.Theme.TabButtonSelected,
                        TextColor3 = selected and Library.Theme.Accent or Library.Theme.TextColor,
                    }, scroll)
                    corner(item, 4)
                    padding(item, 8, 0, 8, 0)
                    item.MouseEnter:Connect(function() tween(item, { BackgroundTransparency = 0.5 }, 0.1) end)
                    item.MouseLeave:Connect(function() tween(item, { BackgroundTransparency = 1 }, 0.1) end)
                    item.Activated:Connect(function()
                        if multi then
                            local map = table.clone(obj.Value)
                            map[name] = not map[name] or nil
                            obj:Set(map)
                        else
                            obj:Set(name)
                            Library:_ClosePopup()
                        end
                    end)
                end
            end
            rebuild()
        end, function() rebuild = nil end)
    end)
    return obj
end

function Section:AddMultiDropdown(o)
    o = o or {}
    o.Multi = true
    return self:AddDropdown(o)
end

-- TextBox ---------------------------------------------------------------------

function Section:AddTextBox(o)
    o = o or {}
    local row, lbl, right = self:_Row(o.Label or "Text", o.Tooltip)
    local obj = { Value = o.Default or "", Row = row }
    local box = make("TextBox", {
        Size = UDim2.fromOffset(o.Width or 140, Library.Metrics.ControlHeight), LayoutOrder = 100, Text = obj.Value,
        PlaceholderText = o.Placeholder or "", TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, ClipsDescendants = true,
        Bind = { BackgroundColor3 = "ToggleBackgroundUnselected", PlaceholderColor3 = "Unselected" },
    }, right)
    corner(box, 5)
    stroke(box)
    padding(box, 8, 0, 8, 0)

    register(obj, o, "TextBox")
    function obj:Set(t, silent)
        t = tostring(t)
        if o.Numeric then
            t = t:gsub("[^%d%.%-]", "")
        end
        self.Value = t
        box.Text = t
        commit(self, o, silent)
    end
    function obj:Serialize() return self.Value end
    function obj:Load(d) if d ~= nil then self:Set(d, false) end end
    rowApi(obj, row, lbl)

    box.FocusLost:Connect(function()
        obj:Set(box.Text)
    end)
    return obj
end

