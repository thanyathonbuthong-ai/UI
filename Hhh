--------------------------------------------------------------------------------
-- Page / containers / tabs
--------------------------------------------------------------------------------

local Container = {}
Container.__index = Container

function Container:AddSection(o)
    o = o or {}
    local M = Library.Metrics
    local colIndex = o.Column
    if colIndex ~= 1 and colIndex ~= 2 then
        colIndex = (self._count[1] <= self._count[2]) and 1 or 2
    end
    self._count[colIndex] += 1

    local frame = make("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Color3.new(1, 1, 1),
        LayoutOrder = self._count[colIndex],
    }, self.Columns[colIndex])
    gradient(frame, { "GradientTop", "GradientMid", "GradientDark" }, 90)
    corner(frame, 6)
    stroke(frame)
    padding(frame, M.SectionPadding, M.SectionPadding, M.SectionPadding, M.SectionPadding)
    list(frame, nil, M.ElementGap)

    if o.Name then
        make("TextLabel", {
            Size = UDim2.new(1, 0, 0, 20), Text = o.Name, FontFace = FONT_SEMI, TextSize = M.TitleSize, LayoutOrder = 0,
        }, frame)
    end

    local sec = setmetatable({ Frame = frame, _order = 0 }, Section)
    return sec
end

local Page = {}
Page.__index = Page

function Page:_NewContainer(visible)
    local M = Library.Metrics
    local scroll = make("ScrollingFrame", {
        Size = UDim2.new(1, -M.PageInset * 2, 1, 0), Position = UDim2.fromOffset(M.PageInset, 0),
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 3,
        ScrollingDirection = Enum.ScrollingDirection.Y, Visible = visible, Bind = { ScrollBarImageColor3 = "Accent" },
    }, self.Frame)
    local cols = make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, scroll)
    list(cols, Enum.FillDirection.Horizontal, M.ColumnGap)
    local columns = {}
    for i = 1, 2 do
        local c = make("Frame", {
            BackgroundTransparency = 1, Size = UDim2.new(0.5, -M.ColumnGap / 2, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = i,
        }, cols)
        list(c, nil, M.ColumnGap)
        columns[i] = c
    end
    local container = setmetatable({ Scroll = scroll, Columns = columns, _count = { 0, 0 } }, Container)
    table.insert(self._containers, container)
    self:_Relayout()
    return container
end

function Page:_Relayout()
    local M = Library.Metrics
    local top = M.PageHeader + (#self.Tabs > 0 and M.SubTabsHeight or 0)
    for _, c in ipairs(self._containers) do
        c.Scroll.Position = UDim2.new(0, M.PageInset, 0, top)
        c.Scroll.Size = UDim2.new(1, -M.PageInset * 2, 1, -(top + M.PageInset))
    end
    self.TabBar.Visible = #self.Tabs > 0
end

function Page:AddSection(o)
    if not self._default then
        self._default = self:_NewContainer(#self.Tabs == 0)
    end
    return self._default:AddSection(o)
end

function Page:SelectTab(tab)
    for _, t in ipairs(self.Tabs) do
        local on = t == tab
        t.Container.Scroll.Visible = on
        tween(t.Label, { TextColor3 = on and Library.Theme.TextColor or Library.Theme.Unselected })
        tween(t.Underline, { BackgroundTransparency = on and 0 or 1 })
    end
    if self._default then self._default.Scroll.Visible = false end
end

function Page:AddTab(name)
    local M = Library.Metrics
    local container = self:_NewContainer(false)
    local btn = make("TextButton", {
        Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, LayoutOrder = #self.Tabs + 1,
    }, self.TabBar)
    padding(btn, 4, 0, 4, 0)
    local label = make("TextLabel", {
        Size = UDim2.new(0, 0, 1, -4), AutomaticSize = Enum.AutomaticSize.X, Text = name, TextSize = 16, FontFace = FONT_SEMI,
        Bind = { TextColor3 = "Unselected" },
    }, btn)
    local underline = make("Frame", {
        AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 2),
        BackgroundTransparency = 1, Bind = { BackgroundColor3 = "Accent" },
    }, btn)
    local tab = { Name = name, Container = container, Label = label, Underline = underline }
    table.insert(self.Tabs, tab)
    function tab:AddSection(o) return container:AddSection(o) end
    btn.Activated:Connect(function() self:SelectTab(tab) end)
    self:_Relayout()
    if #self.Tabs == 1 then self:SelectTab(tab) end
    return tab
end

--------------------------------------------------------------------------------
-- Window
--------------------------------------------------------------------------------

local Window = {}
Window.__index = Window

function Window:Toggle()
    self.Main.Visible = not self.Main.Visible
    if not self.Main.Visible then Library:_ClosePopup() end
end

function Window:SetVisible(b)
    self.Main.Visible = b
    if not b then Library:_ClosePopup() end
end

function Window:Select(page)
    for _, p in ipairs(self.Pages) do
        local on = p == page
        p.Frame.Visible = on
        tween(p._btn, { BackgroundTransparency = on and 0.35 or 1 })
        tween(p._indicator, { BackgroundTransparency = on and 0 or 1 })
        tween(p._text, { TextColor3 = on and Library.Theme.TextColor or Library.Theme.Unselected })
        if p._icon then tween(p._icon, { ImageColor3 = on and Library.Theme.Accent or Library.Theme.Unselected }) end
    end
    self.Selected = page
    Library:_ClosePopup()
end

function Window:AddPage(po)
    po = po or {}
    local M = Library.Metrics
    local page = setmetatable({
        Name = po.Name or "Page", Tabs = {}, _containers = {}, Window = self,
    }, Page)

    -- Rail button
    local btn = make("TextButton", {
        Size = UDim2.new(1, -16, 0, M.TabSize), LayoutOrder = #self.Pages + 1, BackgroundTransparency = 1,
        Bind = { BackgroundColor3 = "TabButtonSelected" },
    }, self._tabsHolder)
    corner(btn, 6)
    ripple(btn, 6)
    local indicator = make("Frame", {
        AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(0, 3, 0.5, 0),
        BackgroundTransparency = 1, Bind = { BackgroundColor3 = "Accent" },
    }, btn)
    corner(indicator, 2)
    local icon
    if po.Icon then
        icon = make("ImageLabel", {
            AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.fromOffset(26, 26),
            Image = po.Icon, Bind = { ImageColor3 = "Unselected" },
        }, btn)
    end
    local text = make("TextLabel", {
        AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Size = UDim2.new(1, -6, 0, 16),
        Text = page.Name, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center, Bind = { TextColor3 = "Unselected" },
    }, btn)
    if not icon then
        text.AnchorPoint, text.Position, text.Size, text.TextSize = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), UDim2.new(1, -6, 1, 0), 14
    end
    page._btn, page._indicator, page._icon, page._text = btn, indicator, icon, text

    -- Page frame
    local frame = make("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false }, self._content)
    page.Frame = frame
    local header = make("Frame", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, M.PageHeader),
    }, frame)
    make("TextLabel", {
        Position = UDim2.fromOffset(M.PageInset, 20), Size = UDim2.new(1, -M.PageInset * 2, 0, 24),
        Text = page.Name, FontFace = FONT_SEMI, TextSize = 18,
    }, header)
    if po.Description then
        make("TextLabel", {
            Position = UDim2.fromOffset(M.PageInset, 46), Size = UDim2.new(1, -M.PageInset * 2, 0, 18),
            Text = po.Description, TextSize = 13, Bind = { TextColor3 = "Unselected" },
        }, header)
    end
    makeDraggable(header, self.Main)

    page.TabBar = make("Frame", {
        BackgroundTransparency = 1, Position = UDim2.fromOffset(M.PageInset, M.PageHeader - 6),
        Size = UDim2.new(1, -M.PageInset * 2, 0, M.SubTabsHeight - 6), Visible = false,
    }, frame)
    list(page.TabBar, Enum.FillDirection.Horizontal, 16)

    btn.Activated:Connect(function() self:Select(page) end)
    table.insert(self.Pages, page)
    if #self.Pages == 1 then self:Select(page) end
    return page
end

-- Ready-made settings page: theme colours, configs, menu key, unload.
function Window:AddSettingsPage()
    local page = self:AddPage({ Name = "Settings", Description = "Theme, configs and menu options" })

    local theme = page:AddSection({ Name = "Theme", Column = 1 })
    local items = {
        { "Accent", "Accent" }, { "Outline", "Outline" }, { "Background", "Background" },
        { "ElementBackground", "Element Background" }, { "TextColor", "Text" }, { "Unselected", "Unselected" },
        { "TabButtonSelected", "Selected Tab" }, { "ToggleCircleUnselected", "Toggle Circle" },
        { "ToggleBackgroundUnselected", "Toggle Background" },
    }
    for _, it in ipairs(items) do
        theme:AddColor({ Label = it[2], Default = Library.Theme[it[1]], Callback = function(c) Library:SetTheme(it[1], c) end })
    end

    local cfg = page:AddSection({ Name = "Configuration", Column = 2 })
    local nameBox = cfg:AddTextBox({ Label = "Name", Placeholder = "default" })
    local configs = cfg:AddDropdown({ Label = "Configs", Options = Library:ListConfigs(), Placeholder = "Select..." })
    cfg:AddButton({ Label = "Save", Callback = function()
        local name = nameBox.Value ~= "" and nameBox.Value or configs.Value
        if not name or name == "" then return Library:Notify({ Title = "Config", Text = "Enter a config name first." }) end
        local ok, err = Library:SaveConfig(name)
        Library:Notify({ Title = "Config", Text = ok and ("Saved '" .. name .. "'") or tostring(err) })
        configs:SetOptions(Library:ListConfigs())
    end })
    cfg:AddButton({ Label = "Load", Callback = function()
        local name = configs.Value
        if not name then return Library:Notify({ Title = "Config", Text = "Select a config first." }) end
        local ok, err = Library:LoadConfig(name)
        Library:Notify({ Title = "Config", Text = ok and ("Loaded '" .. name .. "'") or tostring(err) })
    end })
    cfg:AddButton({ Label = "Refresh list", Callback = function() configs:SetOptions(Library:ListConfigs()) end })

    local menu = page:AddSection({ Name = "Menu", Column = 2 })
    local kb = menu:AddKeybind({ Label = "Toggle key", Default = self.ToggleKey, Mode = "Pick" })
    kb.KeyChanged:Connect(function(k) self.ToggleKey = k end)
    menu:AddButton({ Label = "Unload", Callback = function() Library:Unload() end })
    return page
end

function Library:CreateWindow(o)
    o = o or {}
    self:_Init()
    local M = self.Metrics
    local win = setmetatable({ Pages = {}, Title = o.Title or "KICIA", ToggleKey = o.ToggleKey or Enum.KeyCode.RightShift }, Window)

    local main = make("Frame", {
        Name = "Window", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(o.Width or M.DesignSize.X, o.Height or M.DesignSize.Y),
        BackgroundColor3 = Color3.new(1, 1, 1), ClipsDescendants = true,
    }, self._gui)
    gradient(main, { "GradientTop", "GradientMid", "GradientDark", "GradientDeep" }, 90)
    corner(main, 8)
    stroke(main)
    local scale = make("UIScale", { Scale = self._scale }, main)
    table.insert(self._scales, scale)
    win.Main = main

    -- Rail
    local rail = make("Frame", { Size = UDim2.new(0, M.RailWidth, 1, 0), Bind = { BackgroundColor3 = "ElementBackground" } }, main)
    make("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, 1, 1, 0), Bind = { BackgroundColor3 = "Outline" } }, rail)
    local railHeader = make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, M.RailHeader) }, rail)
    if o.Logo then
        make("ImageLabel", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(48, 37), Image = o.Logo,
        }, railHeader)
    else
        make("TextLabel", {
            Size = UDim2.fromScale(1, 1), Text = win.Title, FontFace = FONT_SEMI, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Center,
        }, railHeader)
    end
    makeDraggable(railHeader, main)

    win._tabsHolder = make("Frame", {
        BackgroundTransparency = 1, Position = UDim2.fromOffset(0, M.RailTabsTop), Size = UDim2.new(1, 0, 1, -M.RailTabsTop),
    }, rail)
    list(win._tabsHolder, nil, M.TabGap, { HorizontalAlignment = Enum.HorizontalAlignment.Center })

    win._content = make("Frame", {
        BackgroundTransparency = 1, Position = UDim2.fromOffset(M.RailWidth, 0), Size = UDim2.new(1, -M.RailWidth, 1, 0), ClipsDescendants = true,
    }, main)

    table.insert(self._windows, win)
    return win
end

--------------------------------------------------------------------------------
-- Config save / load
--------------------------------------------------------------------------------

function Library:GetConfig()
    local data = {}
    for flag, opt in pairs(self.Options) do
        if opt.Serialize then data[flag] = opt:Serialize() end
    end
    return data
end

function Library:SetConfig(data)
    for flag, value in pairs(data) do
        local opt = self.Options[flag]
        if opt and opt.Load then pcall(opt.Load, opt, value) end
    end
end

local function configPath(name)
    return Library.Folder .. "/" .. name .. ".json"
end

function Library:ListConfigs()
    local out = {}
    if not (genv.isfolder and genv.listfiles) then return out end
    pcall(function()
        if not genv.isfolder(self.Folder) then return end
        for _, path in ipairs(genv.listfiles(self.Folder)) do
            local name = path:match("([^/\\]+)%.json$")
            if name then table.insert(out, name) end
        end
    end)
    table.sort(out)
    return out
end

function Library:SaveConfig(name)
    if not genv.writefile then return false, "writefile is not available" end
    local ok, err = pcall(function()
        if genv.makefolder and genv.isfolder and not genv.isfolder(self.Folder) then genv.makefolder(self.Folder) end
        genv.writefile(configPath(name), HttpService:JSONEncode(self:GetConfig()))
    end)
    return ok, err
end

function Library:LoadConfig(name)
    if not (genv.readfile and genv.isfile) then return false, "readfile is not available" end
    if not genv.isfile(configPath(name)) then return false, "config not found" end
    local ok, data = pcall(function() return HttpService:JSONDecode(genv.readfile(configPath(name))) end)
    if not ok then return false, "invalid config file" end
    self:SetConfig(data)
    return true
end

--------------------------------------------------------------------------------
-- Unload
--------------------------------------------------------------------------------

Library.OnUnload = newSignal()

function Library:Unload()
    if self.Unloaded then return end
    self.Unloaded = true
    self.OnUnload:Fire()
    for _, c in ipairs(self._conns) do pcall(function() c:Disconnect() end) end
    if self._gui then self._gui:Destroy() end
    if genv.KiciaUI == self then genv.KiciaUI = nil end
end

genv.KiciaUI = Library
return Library
