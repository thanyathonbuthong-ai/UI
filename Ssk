	local function Label(Parent, Name, Text, Ref, TextColour)
		local Text_ = Instance.new("TextLabel")
		SetProperty(Text_, {
			Name = Name,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Text = Text or "",
			FontFace = Ref.FontFace,
			TextSize = Ref.TextSize,
			TextColor3 = TextColour,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = Parent,
		})
		return Text_
	end

	--// Mouse position in the same space as AbsolutePosition
	local function MousePosition()
		local Position = Services.Input:GetMouseLocation()
		local Inset = (Screen.IgnoreGuiInset and Vector2.new(0, 0)) or GuiService:GetGuiInset()
		return Position - Inset
	end

	--// Calls OnMove(X, Y) every frame while the pointer is held on Frame
	local function Track(Frame, OnMove)
		Connect(Frame.InputBegan, function(Input)
			if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
				local Active = true
				local Ender
				Ender = Connect(Services.Input.InputEnded, function(End)
					if End.UserInputType == Enum.UserInputType.MouseButton1 or End.UserInputType == Enum.UserInputType.Touch then
						Active = false
						Ender:Disconnect()
					end
				end)

				task.spawn(function()
					repeat
						local Position = MousePosition()
						OnMove(Position.X, Position.Y)
						task.wait()
					until not Active
				end)
			end
		end)
	end

	--// Makes every descendant render above the window (works for both ZIndexBehaviors)
	local function Elevate(Root, Base)
		Root.ZIndex = Base

		for _, Descendant in next, Root:GetDescendants() do
			if Descendant:IsA("GuiObject") then
				local Depth, Parent = 0, Descendant

				while Parent ~= Root do
					Depth = Depth + 1
					Parent = Parent.Parent
				end

				Descendant.ZIndex = Base + Depth
			end
		end
	end

	--// Dark click-blocking layer used behind pop-ups
	local function NewSink()
		local Sink = Instance.new("TextButton")
		SetProperty(Sink, {
			Name = "ModalSink",
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			Parent = Window,
		})
		return Sink
	end

	--// Standard row (same look as Button / Toggle etc.)
	--// Returns Row, Title, Description, BottomY (y where free space starts when TopAligned)
	local function NewRow(Settings, Height, WidgetWidth, TopAligned)
		local Row = Instance.new("TextButton")
		SetProperty(Row, {
			Name = Settings.Title or "Element",
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = Theme.Component,
			BorderSizePixel = 0,
			Size = UDim2.new(RowWidth.Scale, RowWidth.Offset, 0, Height or RowHeight),
		})

		local HasCorner = false
		for _, Child in next, Template:GetChildren() do
			if Child:IsA("UICorner") or Child:IsA("UIStroke") then
				if Child:IsA("UICorner") then HasCorner = true end
				Clone(Child).Parent = Row
			end
		end
		if not HasCorner then Corner(Row, 6) end

		--// "Labels" frame keeps the existing theme code working for this row
		local Labels = Instance.new("Frame")
		SetProperty(Labels, { Name = "Labels", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = Row })

		local Desc = Settings.Description or Settings.Desc
		local HasDesc = Desc ~= nil and Desc ~= ""
		local HasTitle = Settings.Title ~= nil and Settings.Title ~= ""
		local Reserve = (WidgetWidth or 0) + 28

		local Title = Label(Labels, "Title", Settings.Title, TitleRef, Theme.Title)
		local Description = Label(Labels, "Description", Desc, DescRef, Theme.Description)
		Description.Visible = HasDesc
		Title.Visible = HasTitle

		local Bottom = 10

		if TopAligned then
			SetProperty(Title, { Position = UDim2.fromOffset(14, 10), Size = UDim2.new(1, -Reserve, 0, 18) })
			SetProperty(Description, { Position = UDim2.fromOffset(14, HasTitle and 28 or 10), Size = UDim2.new(1, -Reserve, 0, 14) })
			if HasTitle then Bottom = 32 end
			if HasDesc then Bottom = Bottom + 18 end
		else
			if HasDesc then
				SetProperty(Title, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 14, .5, 1), Size = UDim2.new(1, -Reserve, 0, 18) })
				SetProperty(Description, { Position = UDim2.new(0, 14, .5, 2), Size = UDim2.new(1, -Reserve, 0, 14) })
			else
				SetProperty(Title, { AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 14, .5, 0), Size = UDim2.new(1, -Reserve, 0, 18) })
			end
		end

		Animations:Component(Row)
		Row.Parent = Settings.Tab

		return Row, Title, Description, Bottom
	end

	--// "Locked" overlay (WindUI: Locked = true, LockedTitle = "...")
	local function AddLock(Row, Settings)
		local Lock = Instance.new("TextButton")
		SetProperty(Lock, {
			Name = "LockedOverlay",
			AutoButtonColor = false,
			BackgroundColor3 = Theme.Primary,
			BackgroundTransparency = .35,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 5,
			Visible = Settings.Locked == true,
			Text = Settings.LockedTitle or "",
			TextSize = 13,
			FontFace = TitleRef.FontFace,
			TextColor3 = Theme.Title,
			Parent = Row,
		})
		Corner(Lock, 6)

		table.insert(Custom, function()
			Lock.BackgroundColor3 = Theme.Primary
			Lock.TextColor3 = Theme.Title
		end)

		return Lock
	end

	local function BaseObject(Row, Overlay)
		local Object = { Instance = Row }

		function Object:Lock() Overlay.Visible = true end
		function Object:Unlock() Overlay.Visible = false end
		function Object:Destroy() Destroy(Row) end

		return Object
	end

	--// ------------------------------------------------------------------
	--// Checkbox   (also: AddToggle{ Type = "Checkbox" })
	--// ------------------------------------------------------------------
	function Options:AddCheckbox(Settings: { Title: string, Description: string, Default: boolean, Locked: boolean, LockedTitle: string, Tab: Instance, Callback: any })
		local Row = NewRow(Settings, nil, 34)
		local Object = BaseObject(Row, AddLock(Row, Settings))
		local Value = (Settings.Default or Settings.Value) == true

		local Box = Instance.new("Frame")
		SetProperty(Box, {
			Name = "Box",
			AnchorPoint = Vector2.new(1, .5),
			Position = UDim2.new(1, -14, .5, 0),
			Size = UDim2.fromOffset(22, 22),
			BorderSizePixel = 0,
			Parent = Row,
		})
		Corner(Box, 5)

		local Check = Instance.new("TextLabel")
		SetProperty(Check, {
			Name = "Check",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Text = "✓",
			Font = Enum.Font.GothamBold,
			TextSize = 15,
			TextColor3 = Color3.fromRGB(255, 255, 255),
			Parent = Box,
		})

		local function Paint(Animate)
			local Fill = (Value and Theme.Checkbox) or Theme.Interactables

			if Animate then
				Tween(Box, .15, { BackgroundColor3 = Fill })
				Tween(Check, .15, { TextTransparency = (Value and 0) or 1 })
			else
				Box.BackgroundColor3 = Fill
				Check.TextTransparency = (Value and 0) or 1
			end
		end

		function Object:Set(New, Silent)
			Value = New and true or false
			Paint(true)

			if not Silent and Settings.Callback then
				Settings.Callback(Value)
			end
		end

		function Object:Get() return Value end

		Connect(Row.MouseButton1Click, function()
			Object:Set(not Value)
		end)

		Paint(false)
		table.insert(Custom, function() Paint(false) end)

		return Object
	end

