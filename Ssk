--// Animations [Window]
function Animations:Open(Window: CanvasGroup, Transparency: number, UseCurrentSize: boolean)
	local Original = (UseCurrentSize and Window.Size) or Setup.Size
	local Multiplied = Multiply(Original, 1.1)
	local Shadow = Window:FindFirstChildOfClass("UIStroke")


	SetProperty(Shadow, { Transparency = 1 })
	SetProperty(Window, {
		Size = Multiplied,
		GroupTransparency = 1,
		Visible = true,
	})

	Tween(Shadow, .25, { Transparency = 0.5 })
	Tween(Window, .25, {
		Size = Original,
		GroupTransparency = Transparency or 0,
	})
end

function Animations:Close(Window: CanvasGroup)
	local Original = Window.Size
	local Multiplied = Multiply(Original, 1.1)
	local Shadow = Window:FindFirstChildOfClass("UIStroke")

	SetProperty(Window, {
		Size = Original,
	})

	Tween(Shadow, .25, { Transparency = 1 })
	Tween(Window, .25, {
		Size = Multiplied,
		GroupTransparency = 1,
	})

	task.wait(.25)
	Window.Size = Original
	Window.Visible = false
end


function Animations:Component(Component: any, Custom: boolean)	
	Connect(Component.InputBegan, function() 
		if Custom then
			Tween(Component, .25, { Transparency = .85 });
		else
			Tween(Component, .25, { BackgroundColor3 = Color(Theme.Component, 5, Setup.ThemeMode) });
		end
	end)

	Connect(Component.InputEnded, function() 
		if Custom then
			Tween(Component, .25, { Transparency = 1 });
		else
			Tween(Component, .25, { BackgroundColor3 = Theme.Component });
		end
	end)
end

--// Library [Window]

function Library:CreateWindow(Settings: { Title: string, Size: UDim2, Transparency: number, MinimizeKeybind: Enum.KeyCode?, Blurring: boolean, Theme: string })
	local Window = Clone(Screen:WaitForChild("Main"));
	local Sidebar = Window:FindFirstChild("Sidebar");
	local Holder = Window:FindFirstChild("Main");
	local BG = Window:FindFirstChild("BackgroundShadow");
	local Tab = Sidebar:FindFirstChild("Tab");

	--// Make the sidebar tab list scrollable (mouse wheel / finger drag) so every tab can be reached
	do
		local Old = Tab
		local Scroll = Old

		if not Old:IsA("ScrollingFrame") then
			Scroll = Instance.new("ScrollingFrame")
			SetProperty(Scroll, {
				Name = Old.Name,
				AnchorPoint = Old.AnchorPoint,
				Position = Old.Position,
				Size = Old.Size,
				BackgroundColor3 = Old.BackgroundColor3,
				BackgroundTransparency = Old.BackgroundTransparency,
				BorderSizePixel = 0,
				LayoutOrder = Old.LayoutOrder,
				ZIndex = Old.ZIndex,
				ClipsDescendants = true,
			})

			--// an auto-sized frame can never scroll, so give it a fixed height (the rest of the sidebar)
			if Old.AutomaticSize ~= Enum.AutomaticSize.None then
				Scroll.Size = UDim2.new(Old.Size.X.Scale, Old.Size.X.Offset, 1 - Old.Position.Y.Scale, -Old.Position.Y.Offset - 6)
			end

			for _, Child in next, Old:GetChildren() do
				Child.Parent = Scroll
			end

			Scroll.Parent = Old.Parent
			Destroy(Old)
		end

		SetProperty(Scroll, {
			Active = true,
			ScrollingEnabled = true,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(0, 0, 0, 0),
			ScrollBarThickness = 2,
			ScrollBarImageColor3 = Theme.Interactables,
			ScrollBarImageTransparency = 0,
			VerticalScrollBarInset = Enum.ScrollBarInset.None,
			ElasticBehavior = Enum.ElasticBehavior.Never,
		})

		Tab = Scroll
	end

	local Options = {};
	local Examples = {};
	local Opened = true;
	local Maximized = false;
	local BlurEnabled = false
	local Accent = Theme.Highlight --// highlight colour (WindUI "Primary"), updated by SetTheme
	local Custom = {} --// re-theme callbacks for code-built elements
	local LastTabOrder = 0 --// LayoutOrder of the newest tab (used by AddTabDivider)
	local SyncButton = function() end --// replaced by the open/close button below
	local TabChosen = false --// becomes true once any tab was opened (by script or by click)
	local TabCount = 0

	for Index, Example in next, Window:GetDescendants() do
		if Example.Name:find("Example") and not Examples[Example.Name] then
			Examples[Example.Name] = Example
		end
	end

	--// UI Blur & More
	Drag(Window);
	Resizeable(Window, Vector2.new(411, 271), Vector2.new(9e9, 9e9));
	Setup.Transparency = Settings.Transparency or 0

	--// Start small like WindUI (580 x 460) and always fit inside the screen.
	--// CreateWindow({ KeepSize = true }) uses the given Size as it is (still fitted to the screen).
	do
		local View = Screen.AbsoluteSize
		if View.X < 1 or View.Y < 1 then View = workspace.CurrentCamera.ViewportSize end

		local Wanted = Settings.Size or UDim2.fromOffset(580, 460)
		local Width = Wanted.X.Scale * View.X + Wanted.X.Offset
		local Height = Wanted.Y.Scale * View.Y + Wanted.Y.Offset

		if not Settings.KeepSize then
			Width, Height = math.min(Width, 580), math.min(Height, 460)
		end

		Width, Height = math.min(Width, View.X * .9), math.min(Height, View.Y * .9)
		Width = math.max(Width, math.min(411, View.X * .9)) --// 411 x 271 = smallest the window can be resized to
		Height = math.max(Height, math.min(271, View.Y * .9))

		Settings.Size = UDim2.fromOffset(math.floor(Width), math.floor(Height))
	end

	Setup.Size = Settings.Size
	do
		local Picked = ResolveTheme(Settings.Theme or Setup.ThemeName)
		if Settings.Theme and not Picked then warn("[UI LIB]: theme '" .. tostring(Settings.Theme) .. "' doesn't exist, using Dark") end

		Theme = Picked or ThemePresets.Dark
		Setup.ThemeName = Theme.Name or "Custom"
		Setup.ThemeMode = (Theme.Light and "Light") or "Dark"
	end

	if Settings.Blurring then
		Blurs[Settings.Title] = Blur.new(Window, 5)
		BlurEnabled = true
	end

	if Settings.MinimizeKeybind then
		Setup.Keybind = Settings.MinimizeKeybind
	end

	--// WindUI triggers: Window:OnOpen(fn) / Window:OnClose(fn) / Window:OnDestroy(fn)
	local Triggers = { Open = {}, Close = {}, Destroy = {} }
	local function Fire(Kind)
		for _, Callback in ipairs(Triggers[Kind]) do task.spawn(Callback) end
	end

	--// Animate
	local Close = function()
		if Opened then
			if BlurEnabled then
				Blurs[Settings.Title].root.Parent = nil
			end

			Opened = false
			SyncButton()
			Animations:Close(Window)
			Window.Visible = false
			Fire("Close")
		else
			Animations:Open(Window, Setup.Transparency)
			Opened = true
			SyncButton()
			Fire("Open")

			if BlurEnabled then
				Blurs[Settings.Title].root.Parent = workspace.CurrentCamera
			end
		end
	end

	for Index, Button in next, Sidebar.Top.Buttons:GetChildren() do
		if Button:IsA("TextButton") then
			local Name = Button.Name
			Animations:Component(Button, true)

			Connect(Button.MouseButton1Click, function() 
				if Name == "Close" then
					Close()
				elseif Name == "Maximize" then
					if Maximized then
						Maximized = false
						Tween(Window, .15, { Size = Setup.Size });
					else
						Maximized = true
						Tween(Window, .15, { Size = UDim2.fromScale(1, 1), Position = UDim2.fromScale(0.5, 0.5 )});
					end
				elseif Name == "Minimize" then
					Opened = false
					Window.Visible = false
					SyncButton()
					Fire("Close")

					if BlurEnabled and Blurs[Settings.Title] then
						Blurs[Settings.Title].root.Parent = nil
					end
				end
			end)
		end
	end

	Services.Input.InputBegan:Connect(function(Input, Focused) 
		if (Input == Setup.Keybind or Input.KeyCode == Setup.Keybind) and not Focused then
			Close()
		end
	end)

	--// Tab Functions

	function Options:SetTab(Name: string)
		TabChosen = true

		for Index, Button in next, Tab:GetChildren() do
			if Button:IsA("TextButton") then
				local Opened, SameName = Button.Value, (Button.Name == Name);
				local Padding = Button:FindFirstChildOfClass("UIPadding");

				if SameName and not Opened.Value then
					--// scroll the sidebar so the selected tab is visible
					task.defer(function()
						if Tab:IsA("ScrollingFrame") and Tab.AbsoluteWindowSize.Y > 0 then
							local Top = Button.AbsolutePosition.Y - Tab.AbsolutePosition.Y + Tab.CanvasPosition.Y
							local Bottom = Top + Button.AbsoluteSize.Y + 6

							if Top < Tab.CanvasPosition.Y then
								Tween(Tab, .2, { CanvasPosition = Vector2.new(0, math.max(Top - 6, 0)) })
							elseif Bottom > Tab.CanvasPosition.Y + Tab.AbsoluteWindowSize.Y then
								Tween(Tab, .2, { CanvasPosition = Vector2.new(0, Bottom - Tab.AbsoluteWindowSize.Y) })
							end
						end
					end)

					Tween(Padding, .25, { PaddingLeft = UDim.new(0, 25) });
					Tween(Button, .25, { BackgroundTransparency = 0.9, Size = UDim2.new(1, -15, 0, 30) });
					SetProperty(Opened, { Value = true });
				elseif not SameName and Opened.Value then
					Tween(Padding, .25, { PaddingLeft = UDim.new(0, 20) });
					Tween(Button, .25, { BackgroundTransparency = 1, Size = UDim2.new(1, -44, 0, 30) });
					SetProperty(Opened, { Value = false });
				end
			end
		end

		for Index, Main in next, Holder:GetChildren() do
			if Main:IsA("CanvasGroup") then
				local Opened, SameName = Main.Value, (Main.Name == Name);
				local Scroll = Main:FindFirstChild("ScrollingFrame");

				if SameName and not Opened.Value then
					Opened.Value = true
					Main.Visible = true

					Tween(Main, .3, { GroupTransparency = 0 });
					Tween(Scroll["UIPadding"], .3, { PaddingTop = UDim.new(0, 5) });

				elseif not SameName and Opened.Value then
					Opened.Value = false

					Tween(Main, .15, { GroupTransparency = 1 });
					Tween(Scroll["UIPadding"], .15, { PaddingTop = UDim.new(0, 15) });	

					task.delay(.2, function()
						Main.Visible = false
					end)
				end
			end
		end
	end

	local SectionStates = {} --// [SectionName] = { Opened = bool, Arrow = TextLabel }

	--// show / hide every tab button that belongs to a category
	local function PaintSection(Name: string, Animate: boolean?)
		local State = SectionStates[Name]
		if not State then return end

		for _, Info in next, StoredInfo["Tabs"] do
			if Info.Section == Name and Info[1] then
				Info[1].Visible = State.Opened
			end
		end

		if Animate then
			Tween(State.Arrow, .2, { Rotation = (State.Opened and 90) or 0 })
		else
			State.Arrow.Rotation = (State.Opened and 90) or 0
		end
	end

	--// Options:ToggleSection("Name", true/false/nil)
	function Options:ToggleSection(Name: string, Opened: boolean?)
		local State = SectionStates[Name]
		if not State then return end

		if Opened == nil then Opened = not State.Opened end
		State.Opened = Opened
		PaintSection(Name, true)
	end

	function Options:AddTabSection(Settings: { Name: string, Order: number, Opened: boolean? })
		local Example = Examples["SectionExample"];
		local Section = Clone(Example);

		StoredInfo["Sections"][Settings.Name] = (Settings.Order);
		SetProperty(Section, { 
			Parent = Example.Parent,
			Text = Settings.Name,
			Name = Settings.Name,
			LayoutOrder = Settings.Order,
			Visible = true
		});

		--// arrow on the right side of the category title
		local Arrow = Instance.new("TextLabel")
		SetProperty(Arrow, {
			Name = "Arrow",
			AnchorPoint = Vector2.new(1, .5),
			Position = UDim2.new(1, -8, .5, 0),
			Size = UDim2.fromOffset(20, 20),
			BackgroundTransparency = 1,
			Text = "›",
			Font = Enum.Font.GothamBold,
			TextSize = 22,
			TextColor3 = Theme.Icon,
			ZIndex = Section.ZIndex + 1,
			Parent = Section,
		})

		--// the whole title row is the open / close button
		local Hit = Instance.new("TextButton")
		SetProperty(Hit, {
			Name = "Toggle",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			ZIndex = Section.ZIndex + 2,
			Parent = Section,
		})

		SectionStates[Settings.Name] = { Opened = Settings.Opened ~= false, Arrow = Arrow }
		PaintSection(Settings.Name, false)

		Connect(Hit.MouseButton1Click, function()
			Options:ToggleSection(Settings.Name)
		end)

		table.insert(Custom, function() Arrow.TextColor3 = Theme.Icon end)
	end

	function Options:AddTab(Settings: { Title: string, Icon: string, Section: string? })
		if StoredInfo["Tabs"][Settings.Title] then 
			error("[UI LIB]: A tab with the same name has already been created") 
		end 

		local Example, MainExample = Examples["TabButtonExample"], Examples["MainExample"];
		local Section = StoredInfo["Sections"][Settings.Section];
		local Main = Clone(MainExample);
		local Tab = Clone(Example);

		if not Settings.Icon then
			Destroy(Tab["ICO"]);
		else
			SetProperty(Tab["ICO"], { Image = ResolveIcon(Settings.Icon) or Settings.Icon });
		end

		TabCount = TabCount + 1
		StoredInfo["Tabs"][Settings.Title] = { Tab, Order = TabCount, Section = Settings.Section }
		SetProperty(Tab["TextLabel"], { Text = Settings.Title });

		SetProperty(Main, { 
			Parent = MainExample.Parent,
			Name = Settings.Title;
		});

		SetProperty(Tab, { 
			Parent = Example.Parent,
			LayoutOrder = Section or #StoredInfo["Sections"] + 1,
			Name = Settings.Title;
			Visible = not (SectionStates[Settings.Section] and not SectionStates[Settings.Section].Opened);
		});

		LastTabOrder = Tab.LayoutOrder

		--// First run: open the first tab automatically (the one at the top of the sidebar).
		--// Deferred so every AddTab of the script has run; skipped if the script / user already picked a tab.
		task.defer(function()
			if TabChosen then return end

			local BestName, BestOrder, BestCreated
			for Name, Info in next, StoredInfo["Tabs"] do
				if not Info.Locked then
					local Order = Info[1].LayoutOrder

					if not BestName or Order < BestOrder or (Order == BestOrder and Info.Order < BestCreated) then
						BestName, BestOrder, BestCreated = Name, Order, Info.Order
					end
				end
			end

			if BestName then Options:SetTab(BestName) end
		end)

		Tab.MouseButton1Click:Connect(function()
			local Info = StoredInfo["Tabs"][Tab.Name]
			if Info and Info.Locked then return end --// LockTab

			Options:SetTab(Tab.Name);
		end)

		return Main.ScrollingFrame
	end
	
	--// Notifications
	
	function Options:Notify(Settings: { Title: string, Description: string, Duration: number }) 
		local Notification = Clone(Components["Notification"]);
		local Title, Description = Options:GetLabels(Notification);
		local Timer = Notification["Timer"];
		
		SetProperty(Title, { Text = Settings.Title });
		SetProperty(Description, { Text = Settings.Description or Settings.Content });
		SetProperty(Notification, {
			Parent = Screen["Frame"],
		})
		
		task.spawn(function() 
			local Duration = Settings.Duration or 2
			local Wait = task.wait;
			
			Animations:Open(Notification, Setup.Transparency, true); Tween(Timer, Duration, { Size = UDim2.new(0, 0, 0, 4) });
			Wait(Duration);
			Animations:Close(Notification);
			Wait(1);
			Notification:Destroy();
		end)
	end

	--// Component Functions

	function Options:GetLabels(Component)
		local Labels = Component:FindFirstChild("Labels")

		return Labels.Title, Labels.Description
	end

	--// Puts an icon on the left or right edge of a row and keeps the labels clear of it (WindUI: Icon / IconAlign / InputIcon)
	local function SideIcon(Row, Icon, Left, Name)
		local Image = ResolveIcon(Icon) or Icon
		if type(Image) ~= "string" or Image == "" then return end

		local Pic = Instance.new("ImageLabel")
		SetProperty(Pic, {
			Name = Name or "ButtonIcon",
			AnchorPoint = Vector2.new(Left and 0 or 1, .5),
			Position = UDim2.new(Left and 0 or 1, Left and 12 or -12, .5, 0),
			Size = UDim2.fromOffset(18, 18),
			BackgroundTransparency = 1,
			Image = Image,
			ImageColor3 = Theme.Icon,
			Parent = Row,
		})

		if Left then
			local Labels = Row:FindFirstChild("Labels")

			if Labels then
				local Pad = Labels:FindFirstChildOfClass("UIPadding")

				if not Pad then
					Pad = Instance.new("UIPadding")
					Pad.Parent = Labels
				end

				Pad.PaddingLeft = UDim.new(0, Pad.PaddingLeft.Offset + 30)
			end
		end

		return Pic
	end

	function Options:AddSection(Settings: { Name: string, Tab: Instance }) 
		local Section = Clone(Components["Section"]);
		SetProperty(Section, {
			Text = Settings.Name or Settings.Title,
			Parent = Settings.Tab,
			Visible = true,
		})

		--// WindUI: TextXAlignment = "Left" | "Center" | "Right"
		if Settings.TextXAlignment then
			pcall(function() Section.TextXAlignment = Enum.TextXAlignment[Settings.TextXAlignment] end)
		end

		local Object = { Instance = Section }

		function Object:SetTitle(Text) Section.Text = Text end
		function Object:Destroy() Destroy(Section) end

		return Object
	end
	
	function Options:AddButton(Settings: { [string]: any }) 
		local Button = Clone(Components["Button"]);
		local Title, Description = Options:GetLabels(Button);
		local Fill --// only used when Color is given

		Connect(Button.MouseButton1Click, function()
			if Settings.Callback then Settings.Callback() end
		end)
		Animations:Component(Button)
		SetProperty(Title, { Text = Settings.Title });
		SetProperty(Description, { Text = Settings.Description });
		SetProperty(Button, {
			Name = Settings.Title,
			Parent = Settings.Tab,
			Visible = true,
		})

		--// Coloured button (WindUI: Color = Color3)
		if Settings.Color then
			Button.BackgroundTransparency = 1

			Fill = Instance.new("Frame")
			SetProperty(Fill, {
				Name = "ColorFill",
				Size = UDim2.fromScale(1, 1),
				BackgroundColor3 = Settings.Color,
				BorderSizePixel = 0,
				ZIndex = 0,
				Parent = Button,
			})

			local Rounded = false
			for _, Child in next, Button:GetChildren() do
				if Child:IsA("UICorner") then
					Clone(Child).Parent = Fill
					Rounded = true
				end
			end
			if not Rounded then
				local Round = Instance.new("UICorner")
				Round.CornerRadius = UDim.new(0, 6)
				Round.Parent = Fill
			end

			Connect(Button.InputBegan, function() Tween(Fill, .2, { BackgroundTransparency = .15 }) end)
			Connect(Button.InputEnded, function() Tween(Fill, .2, { BackgroundTransparency = 0 }) end)
		end

		--// Icon (rbxassetid / Lucide name).  WindUI: IconAlign = "Right" (default) | "Left"
		if Settings.Icon and Settings.Icon ~= "" then
			SideIcon(Button, Settings.Icon, Settings.IconAlign == "Left", "ButtonIcon")
		end

		--// WindUI: Justify = "Between" (default) | "Left" | "Center" | "Right"
		do
			local Align = ({ Center = Enum.TextXAlignment.Center, Right = Enum.TextXAlignment.Right })[Settings.Justify]

			if Align then
				Title.TextXAlignment = Align
				Description.TextXAlignment = Align
			end
		end

		local Object = { Instance = Button }

		--// WindUI: Button:Highlight()
		function Object:Highlight()
			local Target = Fill or Button
			local Base = (Fill and Settings.Color) or Theme.Component

			Tween(Target, .15, { BackgroundColor3 = Accent })
			task.delay(.45, function()
				Tween(Target, .3, { BackgroundColor3 = Base })
			end)
		end

		function Object:SetTitle(Text) Title.Text = Text end
		function Object:SetDesc(Text) Description.Text = Text end

		return Object
	end

	function Options:AddInput(Settings: { [string]: any }) 
		if Settings.Type == "Textarea" then return Options:AddTextarea(Settings) end

		local Input = Clone(Components["Input"]);
		local Title, Description = Options:GetLabels(Input);
		local TextBox = Input["Main"]["Input"];

		if Settings.Default or Settings.Value then TextBox.Text = tostring(Settings.Default or Settings.Value) end
		if Settings.Placeholder then TextBox.PlaceholderText = Settings.Placeholder end
		if Settings.ClearTextOnFocus ~= nil then TextBox.ClearTextOnFocus = Settings.ClearTextOnFocus end

		Connect(Input.MouseButton1Click, function() 
			TextBox:CaptureFocus()
		end)

		Connect(TextBox.FocusLost, function() 
			if Settings.Callback then Settings.Callback(TextBox.Text) end
		end)

		Animations:Component(Input)
		SetProperty(Title, { Text = Settings.Title });
		SetProperty(Description, { Text = Settings.Description });
		SetProperty(Input, {
			Name = Settings.Title,
			Parent = Settings.Tab,
			Visible = true,
		})

		--// WindUI: InputIcon = "search" (icon in front of the title)
		if Settings.InputIcon and Settings.InputIcon ~= "" then
			SideIcon(Input, Settings.InputIcon, true, "InputIcon")
		end

		local Object = { Instance = Input }

		function Object:Get() return TextBox.Text end
