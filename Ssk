		Elevate(Root, 200)
		Hit.ZIndex = 999

		--// size follows the content
		local function Fit()
			local Width = Row.AbsoluteSize.X / math.max(Scaler.Scale, .01)
			Root.Size = UDim2.fromOffset(math.max(Width, 60), BarHeight)
		end
		Connect(Row:GetPropertyChangedSignal("AbsoluteSize"), Fit)

		local function IsMobile() return Services.Input.TouchEnabled and not Services.Input.KeyboardEnabled end

		--// icon: Lucide name or image id.  Returns true when an icon is shown
		local function ApplyIcon()
			local Image, Themed = ResolveIcon(Config.Icon)

			if not Image then
				IconImage.Visible = false
				return false
			end

			if Config.IconThemed ~= nil then Themed = Config.IconThemed end

			IconImage.Image = Image
			IconImage:SetAttribute("NoTheme", not Themed)
			IconImage.ImageColor3 = (Themed and Theme.Icon) or Color3.new(1, 1, 1)
			IconImage.Visible = true

			return true
		end

		--// switch follows the window state, exactly like a Toggle (on = Theme.Toggle, white knob)
		local function Paint(Animate)
			local TrackColour = (Opened and Theme.Toggle) or Theme.Interactables
			local KnobColour = (Opened and Color3.fromRGB(255, 255, 255)) or Theme.Primary
			local KnobPosition = (Opened and UDim2.new(1, -17, .5, 0)) or UDim2.new(0, 3, .5, 0)

			if Animate then
				Tween(Switch, .2, { BackgroundColor3 = TrackColour })
				Tween(Knob, .2, { BackgroundColor3 = KnobColour, Position = KnobPosition })
			else
				Switch.BackgroundColor3 = TrackColour
				Knob.BackgroundColor3 = KnobColour
				Knob.Position = KnobPosition
			end
		end

		--// show / hide with the same pop animation as the window
		local Shown = false
		local function Refresh()
			local Want = Config.Enabled and (not Config.OnlyMobile or IsMobile()) and not (Config.HideWhenOpen and Opened)

			if Want and not Shown then
				Shown = true
				Root.Visible = true
				Scaler.Scale = Config.Scale * .9
				Tween(Root, .25, { GroupTransparency = 0 })
				Tween(Scaler, .25, { Scale = Config.Scale })
			elseif not Want and Shown then
				Shown = false
				Tween(Root, .2, { GroupTransparency = 1 })
				Tween(Scaler, .2, { Scale = Config.Scale * .9 })

				task.delay(.22, function()
					if not Shown then Root.Visible = false end
				end)
			end
		end

		--// keep the button inside the screen after a drag.
		--// The top limit reaches the real top edge of the screen (over the Roblox top bar area), so it can be dragged higher.
		local function Clamp()
			local View = Screen.AbsoluteSize
			local Size, Place = Root.AbsoluteSize, Root.AbsolutePosition
			local Inset = (Screen.IgnoreGuiInset and 0) or GuiService:GetGuiInset().Y
			local MinY = -Inset + 4
			local X = math.clamp(Place.X, 0, math.max(View.X - Size.X, 0))
			local Y = math.clamp(Place.Y, MinY, math.max(View.Y - Size.Y, MinY))

			if math.abs(X - Place.X) > .5 or math.abs(Y - Place.Y) > .5 then
				local Now = Root.Position
				Tween(Root, .2, { Position = UDim2.new(Now.X.Scale, Now.X.Offset + (X - Place.X), Now.Y.Scale, Now.Y.Offset + (Y - Place.Y)) })
			end
		end

		--// tap = toggle window, move finger / mouse = drag
		local Busy = false
		local function Press()
			if Busy then return end
			Busy = true
			task.delay(.4, function() Busy = false end)
			task.spawn(Close)
		end

		local Tracked, StartInput, StartPosition, Dragged

		Connect(Hit.InputBegan, function(Input)
			if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
				Tracked, StartInput, StartPosition, Dragged = Input, Input.Position, Root.Position, false
				Tween(Scaler, .1, { Scale = Config.Scale * .96 })

				local Ender
				Ender = Connect(Input.Changed, function()
					if Input.UserInputState == Enum.UserInputState.End then
						Ender:Disconnect()

						if Tracked == Input then
							Tracked = nil
							Tween(Scaler, .12, { Scale = Config.Scale })

							if Dragged then Clamp() else Press() end
						end
					end
				end)
			end
		end)

		Connect(Services.Input.InputChanged, function(Input)
			if not Tracked or not Config.Draggable then return end

			if Input == Tracked or Input.UserInputType == Enum.UserInputType.MouseMovement then
				local Delta = Vector2.new(Input.Position.X - StartInput.X, Input.Position.Y - StartInput.Y)

				if not Dragged and Delta.Magnitude < 8 then return end

				Dragged = true
				Root.Position = UDim2.new(StartPosition.X.Scale, StartPosition.X.Offset + Delta.X, StartPosition.Y.Scale, StartPosition.Y.Offset + Delta.Y)
			end
		end)

		--// hover: same feedback as the other components (Component colour gets a bit lighter / darker)
		Connect(Hit.MouseEnter, function()
			Tween(Inner, .25, { BackgroundColor3 = Color(Theme.Component, 5, Setup.ThemeMode) })
			Tween(Edge, .25, { Transparency = .25 })
		end)
		Connect(Hit.MouseLeave, function()
			Tween(Inner, .25, { BackgroundColor3 = Theme.Component })
			Tween(Edge, .25, { Transparency = .5 })
		end)

		--// ---- public api ----
		local function ApplyColours()
			Root.BackgroundColor3 = Theme.Primary
			Inner.BackgroundColor3 = Theme.Component
			InnerEdge.Color = Theme.Outline
			Divider.BackgroundColor3 = Theme.Outline
			TitleLabel.TextColor3 = Theme.Title
			MoveIcon.ImageColor3 = Theme.Icon

			if Config.Color then
				Edge.Color = Color3.new(1, 1, 1)
				Gradient.Color = Config.Color
				Gradient.Enabled = true
			else
				Edge.Color = Theme.Shadow
				Gradient.Enabled = false
			end
		end

		function OpenButton:Edit(Info)
			if type(Info) ~= "table" then return OpenButton end

			for Key, Value in next, Info do
				if Key == "Color" and typeof(Value) == "Color3" then
					Value = ColorSequence.new(Value)
				end

				Config[Key] = Value
			end

			local HasIcon = ApplyIcon()
			local IconOnly = Config.OnlyIcon and HasIcon

			TitleLabel.Text = tostring(Config.Title or "")
			TitleLabel.Visible = not IconOnly
			InnerPad.PaddingLeft = UDim.new(0, (IconOnly and 9) or 12)
			InnerPad.PaddingRight = UDim.new(0, (IconOnly and 9) or 12)

			Grip.Visible = Config.Draggable ~= false
			Divider.Visible = Config.Draggable ~= false
			Switch.Visible = Config.ShowState ~= false

			Round.CornerRadius = Config.CornerRadius
			InnerRound.CornerRadius = UDim.new(Config.CornerRadius.Scale, math.max(Config.CornerRadius.Offset - 4, 0))
			Edge.Thickness = Config.StrokeThickness
			Scaler.Scale = Config.Scale
			if Info.Position then Root.Position = Info.Position end

			ApplyColours()
			Paint(false)
			Refresh()
			Fit()

			return OpenButton
		end

		function OpenButton:Show() Config.Enabled = true Refresh() end
		function OpenButton:Hide() Config.Enabled = false Refresh() end
		function OpenButton:SetTitle(Text) return OpenButton:Edit({ Title = Text }) end
		function OpenButton:SetIcon(Image) return OpenButton:Edit({ Icon = Image }) end
		function OpenButton:SetScale(Number) return OpenButton:Edit({ Scale = Number }) end
		function OpenButton:Destroy() Shown = false Destroy(Root) end
		OpenButton.Instance = Root

		SyncButton = function()
			Paint(true)
			Refresh()
		end

		table.insert(Custom, function()
			ApplyColours()
			ApplyIcon()
			Paint(false)
		end)

		local UserConfig = type(WindowSettings.OpenButton) == "table" and WindowSettings.OpenButton or {}
		OpenButton:Edit(UserConfig)

		--// First run: sit centred just ABOVE the window (unless OpenButton.Position was given)
		function OpenButton:PlaceAboveWindow(Gap)
			local View = Screen.AbsoluteSize
			if View.X < 1 or View.Y < 1 then View = workspace.CurrentCamera.ViewportSize end

			local Size = Setup.Size or Window.Size
			local Width = Size.X.Scale * View.X + Size.X.Offset
			local Height = Size.Y.Scale * View.Y + Size.Y.Offset
			local Place, Anchor = Window.Position, Window.AnchorPoint

			local CenterX = Place.X.Scale * View.X + Place.X.Offset + (.5 - Anchor.X) * Width
			local Top = Place.Y.Scale * View.Y + Place.Y.Offset - Anchor.Y * Height
			local Y = math.max(Top - (Gap or 10) - BarHeight / 2, BarHeight / 2 + 6)

			Root.Position = UDim2.fromOffset(CenterX, Y)
		end

		if not UserConfig.Position then
			OpenButton:PlaceAboveWindow()
		end

	end

