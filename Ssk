	local HttpService = GetService(game, "HttpService")
	local WindowSettings = Settings

	--// ------------------------------------------------------------------
	--// Tag  (small badge next to the 3 window dots, auto-scrolls when too many)
	--// Options:Tag({ Title = "v1.0", Color = Color3, TextColor = Color3 })
	--// ------------------------------------------------------------------
	local TagHolder

	function Options:Tag(Info: { Title: string, Color: Color3?, TextColor: Color3? })
		Info = Info or {}

		if not TagHolder then
			local TopBar = Sidebar:FindFirstChild("Top")
			local DotsFrame = TopBar and TopBar:FindFirstChild("Buttons")
			local Bounds = TopBar or Sidebar
			local HolderHeight = 24

			--// scrolling strip: when the tags are too long it scrolls sideways instead of overflowing
			TagHolder = Instance.new("ScrollingFrame")
			SetProperty(TagHolder, {
				Name = "Tags",
				AnchorPoint = Vector2.new(0, 0.5),
				Size = UDim2.fromOffset(0, HolderHeight),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Active = true,
				ClipsDescendants = true,
				ScrollingDirection = Enum.ScrollingDirection.X,
				AutomaticCanvasSize = Enum.AutomaticSize.X,
				CanvasSize = UDim2.new(0, 0, 0, 0),
				ScrollBarThickness = 0,
				ElasticBehavior = Enum.ElasticBehavior.Never,
				ZIndex = 5,
				Parent = Bounds,
			})

			local Layout = Instance.new("UIListLayout")
			SetProperty(Layout, {
				FillDirection = Enum.FillDirection.Horizontal,
				VerticalAlignment = Enum.VerticalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Padding = UDim.new(0, 4),
				Parent = TagHolder,
			})

			--// mouse wheel scrolls the tags sideways
			Connect(TagHolder.InputChanged, function(Input)
				if Input.UserInputType == Enum.UserInputType.MouseWheel then
					local Max = math.max(TagHolder.AbsoluteCanvasSize.X - TagHolder.AbsoluteSize.X, 0)
					local Next = TagHolder.CanvasPosition.X - Input.Position.Z * 24
					TagHolder.CanvasPosition = Vector2.new(math.clamp(Next, 0, Max), 0)
				end
			end)

			local function Place()
				local Content = Layout.AbsoluteContentSize.X
				local BoundsLeft = Bounds.AbsolutePosition.X
				local BoundsRight = BoundsLeft + Bounds.AbsoluteSize.X

				--// no dots found -> strip along the bottom of the sidebar
				if not (TopBar and DotsFrame) then
					TagHolder.AnchorPoint = Vector2.new(0, 1)
					TagHolder.Position = UDim2.new(0, 10, 1, -10)
					TagHolder.Size = UDim2.fromOffset(math.min(Content, math.max(Bounds.AbsoluteSize.X - 20, 0)), HolderHeight)
					return
				end

				--// bounds of the real dot buttons (the Buttons frame itself can be wider than the dots)
				local Left, Right, Mid = math.huge, -math.huge, nil

				for _, Dot in next, DotsFrame:GetChildren() do
					if Dot:IsA("GuiObject") and Dot.Visible then
						Left = math.min(Left, Dot.AbsolutePosition.X)
						Right = math.max(Right, Dot.AbsolutePosition.X + Dot.AbsoluteSize.X)
						Mid = Dot.AbsolutePosition.Y + Dot.AbsoluteSize.Y / 2
					end
				end

				if not Mid then return end

				local Y = Mid - Bounds.AbsolutePosition.Y
				local RoomRight = BoundsRight - Right - 6 - 8

				--// room after the dots; if the dots sit on the right, use the room before them
				if RoomRight < 40 then
					local RoomLeft = math.max(Left - BoundsLeft - 6 - 8, 0)
					TagHolder.AnchorPoint = Vector2.new(1, 0.5)
					TagHolder.Position = UDim2.fromOffset(Left - BoundsLeft - 6, Y)
					TagHolder.Size = UDim2.fromOffset(math.min(Content, RoomLeft), HolderHeight)
				else
					TagHolder.AnchorPoint = Vector2.new(0, 0.5)
					TagHolder.Position = UDim2.fromOffset(Right - BoundsLeft + 6, Y)
					TagHolder.Size = UDim2.fromOffset(math.min(Content, RoomRight), HolderHeight)
				end
			end

			Place()
			Connect(Layout:GetPropertyChangedSignal("AbsoluteContentSize"), Place)
			Connect(Bounds:GetPropertyChangedSignal("AbsoluteSize"), Place)
			Connect(Bounds:GetPropertyChangedSignal("AbsolutePosition"), Place)

			if DotsFrame then
				Connect(DotsFrame:GetPropertyChangedSignal("AbsolutePosition"), Place)
				Connect(DotsFrame:GetPropertyChangedSignal("AbsoluteSize"), Place)
			end

			task.defer(Place)

			--// auto scroll: when the tags do not fit, glide to the end, pause, glide back (pauses while hovered / touched)
			local SCROLL_SPEED = 30 --// pixels per second
			local SCROLL_PAUSE = 1.2 --// seconds to rest at each end
			local Paused, Direction, Resting = false, 1, 0

			Connect(TagHolder.MouseEnter, function() Paused = true end)
			Connect(TagHolder.MouseLeave, function() Paused = false end)
			Connect(TagHolder.InputBegan, function(Input)
				if Input.UserInputType == Enum.UserInputType.Touch then Paused = true end
			end)
			Connect(TagHolder.InputEnded, function(Input)
				if Input.UserInputType == Enum.UserInputType.Touch then Paused = false end
			end)

			Connect(Services.Run.Heartbeat, function(Delta)
				if Paused or not TagHolder.Parent then return end

				local Max = TagHolder.AbsoluteCanvasSize.X - TagHolder.AbsoluteSize.X
				if Max <= 1 then
					if TagHolder.CanvasPosition.X ~= 0 then TagHolder.CanvasPosition = Vector2.zero end
					return
				end

				if Resting > 0 then
					Resting = Resting - Delta
					return
				end

				local Next = TagHolder.CanvasPosition.X + SCROLL_SPEED * Delta * Direction

				if Next >= Max then
					Next, Direction, Resting = Max, -1, SCROLL_PAUSE
				elseif Next <= 0 then
					Next, Direction, Resting = 0, 1, SCROLL_PAUSE
				end

				TagHolder.CanvasPosition = Vector2.new(Next, 0)
			end)
		end

		local Pill = Instance.new("Frame")
		SetProperty(Pill, {
			Name = "Tag",
			Size = UDim2.fromOffset(0, 0),
			AutomaticSize = Enum.AutomaticSize.XY,
			BackgroundColor3 = Info.Color or Theme.Interactables,
			BorderSizePixel = 0,
			ZIndex = 5,
			Parent = TagHolder,
		})
		Corner(Pill, 99)

		local Pad = Instance.new("UIPadding")
		Pad.PaddingLeft, Pad.PaddingRight, Pad.PaddingTop, Pad.PaddingBottom = UDim.new(0, 8), UDim.new(0, 8), UDim.new(0, 3), UDim.new(0, 3)
		Pad.Parent = Pill

		local Text = Instance.new("TextLabel")
		SetProperty(Text, {
			Name = "TagText",
			Size = UDim2.fromOffset(0, 0),
			AutomaticSize = Enum.AutomaticSize.XY,
			BackgroundTransparency = 1,
			Text = Info.Title or "",
			FontFace = DescRef.FontFace,
			TextSize = 12,
			TextColor3 = Info.TextColor or Color3.new(1, 1, 1),
			ZIndex = 6,
			Parent = Pill,
		})

		return {
			Instance = Pill,
			SetTitle = function(_, NewText) Text.Text = NewText end,
			Destroy = function() Destroy(Pill) end,
		}
	end

	--// ------------------------------------------------------------------
	--// Video  (rbxassetid / url via getcustomasset). Tap to pause / play.
	--// ------------------------------------------------------------------
	function Options:AddVideo(Info: { Video: string, Height: number?, Looped: boolean?, Volume: number?, AutoPlay: boolean?, Radius: number?, Tab: Instance })
		local Source = Info.Video

		if type(Source) == "string" and Source:find("^https?://") and writefile and getcustomasset then
			local Ok, Result = pcall(function()
				local Hash = 0
				for Index = 1, #Source do
					Hash = (Hash * 31 + Source:byte(Index)) % 1000000007
				end

				local File = "uilib_vid_" .. Hash .. ".webm"
				if not (isfile and isfile(File)) then
					writefile(File, game:HttpGet(Source))
				end

				return getcustomasset(File)
			end)

			if Ok then Source = Result end
		end

		local Player_ = Instance.new("VideoFrame")
		SetProperty(Player_, {
			Name = "Video",
			Video = Source or "",
			Looped = Info.Looped ~= false,
			Volume = Info.Volume or .5,
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
			Size = UDim2.new(RowWidth.Scale, RowWidth.Offset, 0, Info.Height or 160),
			Parent = Info.Tab,
		})
		Corner(Player_, Info.Radius or 8)

		Connect(Player_.InputBegan, function(Input)
			if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
				if Player_.Playing then Player_:Pause() else Player_:Play() end
			end
		end)

		if Info.AutoPlay ~= false then Player_:Play() end

		return Player_
	end

	--// ------------------------------------------------------------------
	--// Wrap every element: WindUI-style aliases (Desc / Content / Values / Value),
	--// Locked + LockedTitle + :Lock() / :Unlock() on ALL of them, and Flag registration
	--// ------------------------------------------------------------------
	local Flags = {}
	Options.Flags = Flags

	--// every element created through the wrapped Add* functions (for LockAll / GetElements ...)
	local Elements = {}

	for _, Name in ipairs({
		"AddButton", "AddInput", "AddToggle", "AddKeybind", "AddDropdown",
		"AddSlider", "AddParagraph", "AddCheckbox", "AddTextarea", "AddColorpicker", "AddCode",
	}) do
		local Original = Options[Name]

		Options[Name] = function(Self, Info)
			Info = Info or {}

			if Info.Description == nil then Info.Description = Info.Desc or Info.Content end

			if Name == "AddDropdown" then
				Info.Options = Info.Options or Info.Values or {}
				if Info.Default == nil then Info.Default = Info.Value end
			end

			local Object = Original(Self, Info)

			if type(Object) == "table" then
				if Object.Instance and not Object.Lock then
					local Overlay = AddLock(Object.Instance, Info)

					function Object:Lock() Overlay.Visible = true end
					function Object:Unlock() Overlay.Visible = false end
					function Object:Destroy() Destroy(Object.Instance) end
				end

				--// WindUI: Element:SetTitle(text) / Element:SetDesc(text) on every element
				if Object.Instance and not Object.SetTitle then
					function Object:SetTitle(Text)
						local Ok, T = pcall(Options.GetLabels, Options, Object.Instance)
						if Ok and T then
							T.Text = tostring(Text or "")
							T.Visible = true
						end
					end
				end

				if Object.Instance and not Object.SetDesc then
					function Object:SetDesc(Text)
						local Ok, T, D = pcall(Options.GetLabels, Options, Object.Instance)
						if not (Ok and D) then return end

						local Show = Text ~= nil and tostring(Text) ~= ""
						D.Text = tostring(Text or "")

						--// row was built without a description: move the title up and put the description under it
						if Show and not D.Visible and T and T.AnchorPoint.Y == .5 then
							T.AnchorPoint = Vector2.new(0, 1)
							T.Position = UDim2.new(T.Position.X.Scale, T.Position.X.Offset, .5, 1)
							D.Position = UDim2.new(T.Position.X.Scale, T.Position.X.Offset, .5, 2)
							D.Size = UDim2.new(T.Size.X.Scale, T.Size.X.Offset, 0, 14)
						end

						D.Visible = Show
					end
				end

				if Object.Instance then
					function Object:IsLocked()
						local Overlay = Object.Instance:FindFirstChild("LockedOverlay")
						return Overlay ~= nil and Overlay.Visible
					end

					table.insert(Elements, Object)
				end

				if Info.Flag and Object.Get then
					Flags[Info.Flag] = Object
				end
			end

			return Object
		end
	end

	--// ------------------------------------------------------------------
	--// WindUI: Window:LockAll() / UnlockAll() / GetLocked() / GetUnlocked() / GetElements()
	--// ------------------------------------------------------------------
	local function Alive()
		local List = {}

		for _, Object in ipairs(Elements) do
			if Object.Instance and Object.Instance.Parent then table.insert(List, Object) end
		end

		Elements = List
		return List
	end

	function Options:GetElements() return table.clone(Alive()) end

	function Options:GetLockedElements()
		local List = {}
		for _, Object in ipairs(Alive()) do if Object:IsLocked() then table.insert(List, Object) end end
		return List
	end

	function Options:GetUnlockedElements()
		local List = {}
		for _, Object in ipairs(Alive()) do if not Object:IsLocked() then table.insert(List, Object) end end
		return List
	end

	function Options:LockAll()
		for _, Object in ipairs(Alive()) do if Object.Lock then Object:Lock() end end
	end

	function Options:UnlockAll()
		for _, Object in ipairs(Alive()) do if Object.Unlock then Object:Unlock() end end
	end

	--// ------------------------------------------------------------------
	--// Config:  give elements a Flag = "name", then
	--//   Options:SaveConfig("name")  Options:LoadConfig("name")
	--//   Options:GetConfigs()        Options:DeleteConfig("name")
	--// ------------------------------------------------------------------
	local ConfigRoot = tostring(WindowSettings.Folder or WindowSettings.Title or "UILibrary")
	local ConfigFolder = ConfigRoot .. "/configs"

	local function FileSupport()
		return writefile and readfile and isfile and makefolder and isfolder
	end

	local function ConfigPath(Name)
		return ConfigFolder .. "/" .. tostring(Name or "default") .. ".json"
	end

	function Options:SaveConfig(Name: string?)
		if not FileSupport() then
			warn("[UI LIB]: your executor has no file functions - can't save config")
			return false
		end

		local Data = {}

		for Flag, Object in next, Flags do
			local Ok, Value = pcall(function()
				if Object.Save then return Object:Save() end
				return Object:Get()
			end)

			if Ok and Value ~= nil then Data[Flag] = Value end
		end

		if not isfolder(ConfigRoot) then makefolder(ConfigRoot) end
		if not isfolder(ConfigFolder) then makefolder(ConfigFolder) end

		writefile(ConfigPath(Name), HttpService:JSONEncode(Data))
		return true
	end

	function Options:LoadConfig(Name: string?)
		if not FileSupport() or not isfile(ConfigPath(Name)) then return false end

		local Ok, Data = pcall(function()
			return HttpService:JSONDecode(readfile(ConfigPath(Name)))
		end)
		if not Ok or type(Data) ~= "table" then return false end

		for Flag, Value in next, Data do
			local Object = Flags[Flag]

			if Object then
				pcall(function()
					if Object.Load then Object:Load(Value) else Object:Set(Value) end
				end)
			end
		end

		return true
	end

	function Options:GetConfigs()
		local List = {}

		if FileSupport() and isfolder(ConfigFolder) and listfiles then
			for _, Path in ipairs(listfiles(ConfigFolder)) do
				local Name = tostring(Path):match("([^/\\]+)%.json$")
				if Name then table.insert(List, Name) end
			end
		end

		return List
	end

	function Options:DeleteConfig(Name: string?)
		if FileSupport() and delfile and isfile(ConfigPath(Name)) then
			delfile(ConfigPath(Name))
			return true
		end

		return false
	end

	--// ------------------------------------------------------------------
	--// Collapsible section  (WindUI: Section with Opened / children)
	--//   local Content, Section = Options:AddCollapsible({ Title = "Group", Description = "...", Opened = true, Tab = Tab })
	--//   Options:AddButton({ Tab = Content, ... })	  --> elements go INSIDE Content
	--//   Section:Open()  Section:Close()  Section:Toggle()  Section:SetTitle("x")  Section:SetDesc("x")
	--// ------------------------------------------------------------------
	function Options:AddCollapsible(Settings: { Title: string, Description: string, Opened: boolean?, Tab: Instance })
		Settings = Settings or {}

		local Parent = Settings.Tab
		local ParentLayout = Parent and Parent:FindFirstChildOfClass("UIListLayout")
		local Gap = (ParentLayout and ParentLayout.Padding.Offset) or 6
		if Gap < 4 then Gap = 6 end

		local Wrap = Instance.new("Frame")
		SetProperty(Wrap, {
			Name = "Collapsible",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(RowWidth.Scale, RowWidth.Offset, 0, 0),
			Parent = Parent,
		})

		local WrapLayout = Instance.new("UIListLayout")
		SetProperty(WrapLayout, {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, Gap),
			Parent = Wrap,
		})

		local Header, HeaderTitle, HeaderDesc = NewRow({
			Title = Settings.Title,
			Description = Settings.Description or Settings.Desc,
			Tab = Wrap,
		}, nil, 24)
		Header.LayoutOrder = 0

		local Arrow = Instance.new("TextLabel")
		SetProperty(Arrow, {
			Name = "Arrow",
			AnchorPoint = Vector2.new(1, .5),
			Position = UDim2.new(1, -14, .5, 0),
			Size = UDim2.fromOffset(20, 20),
			BackgroundTransparency = 1,
			Text = "›",
			Font = Enum.Font.GothamBold,
			TextSize = 22,
			TextColor3 = Theme.Icon,
			Parent = Header,
		})

		local Content = Instance.new("Frame")
		SetProperty(Content, {
			Name = "Content",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(1, 0, 0, 0),
			LayoutOrder = 1,
			Parent = Wrap,
		})

		local ContentLayout = Instance.new("UIListLayout")
		SetProperty(ContentLayout, {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, Gap),
			Parent = Content,
		})

		local Opened = Settings.Opened ~= false
		local Object = { Instance = Wrap, Content = Content }

		local function Paint(Animate)
			Content.Visible = Opened

			if Animate then
				Tween(Arrow, .2, { Rotation = (Opened and 90) or 0 })
			else
				Arrow.Rotation = (Opened and 90) or 0
			end
		end

		function Object:Open() Opened = true Paint(true) end
		function Object:Close() Opened = false Paint(true) end
		function Object:Toggle() Opened = not Opened Paint(true) end
		function Object:IsOpen() return Opened end
		function Object:SetTitle(Text) HeaderTitle.Text = Text end
		function Object:SetDesc(Text) HeaderDesc.Text = Text HeaderDesc.Visible = Text ~= "" end
		function Object:Destroy() Destroy(Wrap) end

		Connect(Header.MouseButton1Click, function() Object:Toggle() end)

		Paint(false)
		table.insert(Custom, function() Arrow.TextColor3 = Theme.Icon end)

		return Content, Object
	end

	--// ------------------------------------------------------------------
	--// Tab helpers (WindUI: Tab:Select / Tab:Lock / Tab:Divider)
	--// ------------------------------------------------------------------
	function Options:SelectTab(Name: string) Options:SetTab(Name) end

	function Options:LockTab(Name: string, Locked: boolean?)
		local Info = StoredInfo["Tabs"][Name]
		if not Info then return end

		Locked = Locked ~= false
		Info.Locked = Locked

		local Button = Info[1]
		local Text = Button:FindFirstChild("TextLabel")
		local Icon = Button:FindFirstChild("ICO")

		if Text then Tween(Text, .2, { TextTransparency = (Locked and .6) or 0 }) end
		if Icon then Tween(Icon, .2, { ImageTransparency = (Locked and .6) or 0 }) end
	end

