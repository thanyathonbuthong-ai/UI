	--// Put elements side by side:  local G = Options:AddGroup({ Tab = Tab }) ; Options:AddButton({ Tab = G, ... })
	function Options:AddGroup(Settings: { Tab: Instance, Gap: number? })
		Settings = Settings or {}
		local Gap = Settings.Gap or 6
		local Order = 0

		local Group = Instance.new("Frame")
		SetProperty(Group, {
			Name = "Group",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(RowWidth.Scale, RowWidth.Offset, 0, 0),
			Parent = Settings.Tab,
		})

		local Layout = Instance.new("UIListLayout")
		SetProperty(Layout, {
			FillDirection = Enum.FillDirection.Horizontal,
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Top,
			Padding = UDim.new(0, Gap),
			Parent = Group,
		})

		local function Refit()
			local Items = {}

			for _, Child in next, Group:GetChildren() do
				if Child:IsA("GuiObject") and Child.Name ~= "Space" then
					table.insert(Items, Child)
				end
			end

			local Count = #Items
			if Count == 0 then return end

			for _, Child in next, Items do
				Child.Size = UDim2.new(1 / Count, -math.ceil(Gap * (Count - 1) / Count), Child.Size.Y.Scale, Child.Size.Y.Offset)
			end
		end

		Connect(Group.ChildAdded, function(Child)
			if Child:IsA("GuiObject") then
				Order = Order + 1
				Child.LayoutOrder = Order
				task.defer(Refit)
			end
		end)

		Connect(Group.ChildRemoved, function()
			task.defer(Refit)
		end)

		return Group
	end

