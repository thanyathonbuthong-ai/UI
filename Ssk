local ThemePresets = {}

local function ToColor(Value)
	if typeof(Value) == "Color3" then return Value end

	if type(Value) == "string" then
		local Ok, Result = pcall(Color3.fromHex, Value)
		if Ok then return Result end
	end
end

local function Brightness(Colour)
	return Colour.R * .299 + Colour.G * .587 + Colour.B * .114
end

--// WindUI theme  ->  the colour slots this library paints with
local function BuildTheme(Info, Name)
	local Base = WindThemes.Dark
	local function Get(Key) return ToColor(Info[Key]) or ToColor(Base[Key]) end

	local Back, Text, Dialog, Placeholder = Get("Background"), Get("Text"), Get("Dialog"), Get("Placeholder")

	return {
		Name = Name or Info.Name or "Custom",
		Light = Brightness(Back) > .6,

		--// Frames
		Primary = Back,                           --// window
		Secondary = Back:Lerp(Dialog, .55),       --// content area
		Component = Dialog:Lerp(Text, .05),       --// elements (button, toggle ...)
		Interactables = Dialog:Lerp(Text, .12),   --// switches, slider track, inputs

		--// Text
		Tab = Text,
		Title = Text,
		Description = Text:Lerp(Placeholder, .35),

		--// Outlines
		Shadow = Back:Lerp(Text, .2),
		Outline = Back:Lerp(Text, .1),

		--// Image
		Icon = Get("Icon"),

		--// WindUI colours
		Accent = Get("Accent"),
		Dialog = Dialog,
		Text = Text,
		Placeholder = Placeholder,
		Background = Back,
		Button = Get("Button"),
		Toggle = Get("Toggle"),
		Slider = Get("Slider"),
		Checkbox = Get("Checkbox"),
		Highlight = Get("Primary"),
	}
end

local function RegisterTheme(Info)
	assert(type(Info) == "table" and type(Info.Name) == "string", "[UI LIB]: AddTheme needs a table with a Name")

	ThemePresets[Info.Name] = BuildTheme(Info, Info.Name)
	if not table.find(ThemeOrder, Info.Name) then table.insert(ThemeOrder, Info.Name) end

	return ThemePresets[Info.Name]
end

for Name, Info in next, WindThemes do
	ThemePresets[Name] = BuildTheme(Info, Name)
end

local Theme = ThemePresets[Setup.ThemeName] or ThemePresets.Dark

--// accepts a theme name, a WindUI style table or a table that already uses this library's slots
local function ResolveTheme(Value)
	if type(Value) == "string" then
		return ThemePresets[Value]
	elseif type(Value) == "table" then
		if Value.Secondary and Value.Component then
			local Copy = table.clone(Value)

			for Key, Default in next, Theme do
				if Copy[Key] == nil then Copy[Key] = Default end
			end

			return Copy
		end

		return BuildTheme(Value, Value.Name or "Custom")
	end
end

