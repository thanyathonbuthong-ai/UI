    -- ═══════════ CONFIG MANAGER (Flag) ═══════════
    local Folder = Args.Folder or "PremiumLib"
    local CfgDir = Folder .. "/configs"
    local function HasFS() return writefile and readfile and isfile and isfolder and makefolder end
    local function Serialize(name, e)
        if name == "Colorpicker" then
            local c = e.Value
            return { __color = { c.R, c.G, c.B }, a = e.Transparency }
        end
        return e.Value
    end
    local function ApplyValue(name, e, v)
        if name == "Colorpicker" then
            if type(v) == "table" and v.__color then e:Set(Color3.new(v.__color[1], v.__color[2], v.__color[3]), v.a) end
        elseif name == "Dropdown" then e:Select(v)
        else e:Set(v) end
    end
    local CM = {}
    function CM:Config(name)
        local Path = CfgDir .. "/" .. name .. ".json"
        local C = { Name = name }
        function C:Save()
            if not HasFS() then return false, "no filesystem" end
            local data = {}
            for flag, f in pairs(Flags) do
                local ok, v = pcall(Serialize, f.Name, f.Element)
                if ok then data[flag] = v end
            end
            if not isfolder(Folder) then makefolder(Folder) end
            if not isfolder(CfgDir) then makefolder(CfgDir) end
            writefile(Path, HttpService:JSONEncode(data))
            return true
        end
        function C:Load()
            if not HasFS() or not isfile(Path) then return false, "not found" end
            local ok, data = pcall(function() return HttpService:JSONDecode(readfile(Path)) end)
            if not ok or type(data) ~= "table" then return false, "invalid file" end
            for flag, v in pairs(data) do
                local f = Flags[flag]
                if f then pcall(ApplyValue, f.Name, f.Element, v) end
            end
            return true
        end
        function C:Delete()
            if delfile and isfile and isfile(Path) then delfile(Path) return true end
            return false
        end
        return C
    end
    function CM:AllConfigs()
        local names = {}
        if listfiles and isfolder and isfolder(CfgDir) then
            for _, path in ipairs(listfiles(CfgDir)) do
                local n = path:match("([^/\\]+)%.json$")
                if n then table.insert(names, n) end
            end
        end
        return names
    end
    Window.ConfigManager = CM
    Window.Flags = Flags

    function Window:Destroy()
        for _, f in ipairs(DestroyCbs) do pcall(f) end
        for _, c in ipairs(Connections) do c:Disconnect() end
        table.clear(Connections)
        Gui:Destroy()
        ToggleGui:Destroy()
    end

    return Window
end

return Library
