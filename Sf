        -- ตัวแก้ธีมสำเร็จรูป: พรีเซ็ต + เลือกสีทุกจุด + ไล่สี (Hot/Title/Background) + Copy/Import
        function Obj:ThemeEditor(A)
            A = A or {}
            local UseFlags = A.Flag ~= false
            local function FlagOf(n) if UseFlags then return "Theme_" .. n end end
            local Syncing = true
            local Pickers, Groups = {}, {}
            local g_rot
            local Root = Obj:Section({ Title = A.Title or "Theme Editor", Box = true, Opened = A.Opened ~= false })

            local function Derive(key)
                if key == "Hot" then
                    return { THEME.PRIMARY, THEME.PRIMARY:Lerp(THEME.SECONDARY, 0.5), THEME.SECONDARY }
                elseif key == "Title" then
                    return { Color3.fromRGB(245, 248, 255), THEME.PRIMARY, THEME.SECONDARY }
                end
                return { THEME.BG_PANEL, THEME.BG_PANEL:Lerp(THEME.BG_DEEP, 0.5), THEME.BG_DEEP }
            end

            local function SyncFromTheme()
                Syncing = true
                for k, pk in pairs(Pickers) do pk:Set(THEME[k]) end
                local T = Library:GetTheme()
                for key, g in pairs(Groups) do
                    local pts = T[key]
                    g.On = pts ~= nil
                    g.OnToggle:Set(g.On)
                    if pts then
                        local n = #pts
                        g.Three = n >= 3
                        g.ThreeToggle:Set(g.Three)
                        g.Stops = { pts[1][2], pts[math.ceil(n / 2)][2], pts[n][2] }
                    else
                        g.Stops = Derive(key)
                    end
                    for i = 1, 3 do g.Pick[i]:Set(g.Stops[i]) end
                end
                if g_rot then g_rot:Set(Library.BgRotation) end
                Syncing = false
            end

            local PresetDrop = Root:Dropdown({
                Title = "Preset", Desc = "เลือกธีมสำเร็จรูป (จะรีเซ็ตสีที่แก้เอง)", Values = Library:GetThemes(), Value = Library.CurrentTheme,
                Callback = function(name)
                    if Library:SetTheme(name) then SyncFromTheme() end
                end,
            })

            local ColorDefs = {
                { "Accent", { { "PRIMARY", "Primary" }, { "SECONDARY", "Secondary" }, { "GLOW", "Glow / Border" } } },
                { "Background", { { "BG_DEEP", "Window dark" }, { "BG_PANEL", "Window / Panel" }, { "BG_ROW", "Row" }, { "BG_HOVER", "Hover" }, { "BG_INPUT", "Input" } } },
                { "Text & Lines", { { "TEXT_BRIGHT", "Text bright" }, { "TEXT_DIM", "Text dim" }, { "STROKE_DARK", "Stroke" } } },
            }
            for _, grp in ipairs(ColorDefs) do
                local S = Root:Section({ Title = grp[1], Opened = grp[1] == "Accent" })
                for _, d in ipairs(grp[2]) do
                    local key = d[1]
                    Pickers[key] = S:Colorpicker({
                        Title = d[2], Default = THEME[key], Flag = FlagOf(key),
                        Callback = function(c) if not Syncing then Library:SetColors({ [key] = c }) end end,
                    })
                end
            end

            local GSec = Root:Section({ Title = "Gradients", Opened = false })
            local function MakeGroup(Label, Key, Desc)
                local g = { On = false, Three = true, Stops = Derive(Key), Pick = {} }
                local function Push()
                    if Syncing then return end
                    if not g.On then Library:SetColors({ [Key] = false }) return end
                    local list = g.Three and { g.Stops[1], g.Stops[2], g.Stops[3] } or { g.Stops[1], g.Stops[3] }
                    Library:SetColors({ [Key] = list })
                end
                GSec:Section(Label)
                g.OnToggle = GSec:Toggle({
                    Title = "Custom " .. Label, Desc = Desc, Type = "Switch", Value = false, Flag = FlagOf(Key .. "_On"),
                    Callback = function(v) g.On = v; Push() end,
                })
                g.ThreeToggle = GSec:Toggle({
                    Title = "3 stops", Desc = "ปิด = ไล่สี 2 จุด (ต้น-ปลาย)", Type = "Switch", Value = true, Flag = FlagOf(Key .. "_3"),
                    Callback = function(v) g.Three = v; Push() end,
                })
                local names = { "Start", "Middle", "End" }
                for i = 1, 3 do
                    g.Pick[i] = GSec:Colorpicker({
                        Title = names[i], Default = g.Stops[i], Flag = FlagOf(Key .. "_" .. i),
                        Callback = function(c) g.Stops[i] = c; Push() end,
                    })
                end
                Groups[Key] = g
            end
            MakeGroup("Accent gradient", "Hot", "ปุ่ม สวิตช์ แถบ Slider และการ์ดแท็บ")
            MakeGroup("Title gradient", "Title", "ตัวอักษรหัวข้อและชื่อหน้าต่าง")
            MakeGroup("Background gradient", "Background", "พื้นหลังหน้าต่างและกล่อง Dialog")
            g_rot = GSec:Slider({
                Title = "Background angle", Desc = "องศาการไล่สีของพื้นหลัง", Step = 5, Flag = FlagOf("BgRot"),
                Value = { Min = 0, Max = 360, Default = Library.BgRotation },
                Callback = function(v) if not Syncing then Library:SetColors({ BackgroundRotation = v }) end end,
            })

            Root:Button({
                Title = "Reset theme", Desc = "กลับเป็น Premium", Text = "Reset",
                Callback = function() PresetDrop:Select("Premium") end,
            })
            Root:Button({
                Title = "Copy theme", Desc = "คัดลอกธีมเป็นโค้ด Lua", Text = "Copy",
                Callback = function()
                    local code = Library:ExportTheme()
                    if setclipboard then pcall(setclipboard, code) end
                    Library:Notify({ Title = "Theme", Content = setclipboard and "คัดลอกธีมแล้ว" or "executor นี้ไม่รองรับ setclipboard", Duration = 3 })
                end,
            })
            Root:Input({
                Title = "Import theme", Desc = "วางโค้ดธีมที่ Copy ไว้แล้วกด Enter", Placeholder = "{ PRIMARY = ... }",
                Callback = function(text)
                    if text == "" then return end
                    if Library:ImportTheme(text) then
                        SyncFromTheme()
                        Library:Notify({ Title = "Theme", Content = "นำเข้าธีมแล้ว", Duration = 3 })
                    else
                        Library:Notify({ Title = "Theme", Content = "โค้ดธีมไม่ถูกต้อง", Duration = 3 })
                    end
                end,
            })

            Syncing = false
            return { Root = Root, Sync = SyncFromTheme }
        end

        -- ลงทะเบียน Flag (ConfigManager) และรายการ element (LockAll)
        for _, name in ipairs({ "Toggle", "Slider", "Dropdown", "Input", "Keybind", "Colorpicker" }) do
            local orig = Obj[name]
            Obj[name] = function(self, A)
                local e = orig(self, A)
                if type(A) == "table" and A.Flag then Flags[A.Flag] = { Element = e, Name = name } end
                table.insert(AllElements, e)
                return e
            end
        end
        for _, name in ipairs({ "Button", "Paragraph", "Code" }) do
            local orig = Obj[name]
            Obj[name] = function(self, A)
                local e = orig(self, A)
                table.insert(AllElements, e)
                return e
            end
        end
    end

