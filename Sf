local Custom = { Hot = nil, Title = nil, Background = nil } -- รายการจุดไล่สี {{t, color}, ...}

local function Normalize(list)
    if type(list) ~= "table" or #list < 2 then return nil end
    local out = {}
    if typeof(list[1]) == "Color3" then
        for i, c in ipairs(list) do out[i] = { (i - 1) / (#list - 1), c } end
    else
        for i, st in ipairs(list) do out[i] = { st[1], st[2] } end
        table.sort(out, function(x, y) return x[1] < y[1] end)
    end
    out[1][1] = 0
    out[#out][1] = 1
    return out
end

local function ToSeq(pts)
    local kp = {}
    for i, pt in ipairs(pts) do kp[i] = ColorSequenceKeypoint.new(math.clamp(pt[1], 0, 1), pt[2]) end
    return ColorSequence.new(kp)
end

local function BuildHot()
    if Custom.Hot then return ToSeq(Custom.Hot) end
    return ColorSequence.new{ ColorSequenceKeypoint.new(0, THEME.PRIMARY), ColorSequenceKeypoint.new(1, THEME.SECONDARY) }
end
local function BuildTitle()
    if Custom.Title then return ToSeq(Custom.Title) end
    return ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(245, 248, 255)),
        ColorSequenceKeypoint.new(0.6, THEME.PRIMARY),
        ColorSequenceKeypoint.new(1, THEME.SECONDARY),
    }
end
local function BuildBg()
    if Custom.Background then return ToSeq(Custom.Background) end
    return ColorSequence.new{ ColorSequenceKeypoint.new(0, THEME.BG_PANEL), ColorSequenceKeypoint.new(1, THEME.BG_DEEP) }
end
local function GradientHot() return BuildHot() end
local function GradientTitle() return BuildTitle() end
local function GradientBg() return BuildBg() end

local function SeqEq(x, y)
    local kx, ky = x.Keypoints, y.Keypoints
    if #kx ~= #ky then return false end
    for i = 1, #kx do
        if kx[i].Time ~= ky[i].Time or kx[i].Value ~= ky[i].Value then return false end
    end
    return true
end

-- ทำให้แต่ละคีย์มีค่าสีไม่ซ้ำกัน (ต่างกันระดับที่ตาไม่เห็น) เพื่อให้ไล่แทนสีตามค่าได้ไม่ชนกัน
local function Unique(key, c)
    local e = (KeyOrder[key] or 12) * 0.0004
    local bl = c.B + e
    if bl > 1 then bl = c.B - e end
    return Color3.new(c.R, c.G, bl)
end

local function ApplyTheme(t, reset)
    local oldHot, oldTitle, oldBg = BuildHot(), BuildTitle(), BuildBg()
    if reset then
        Custom.Hot, Custom.Title, Custom.Background = nil, nil, nil
        Library.BgRotation = 135
    end
    local swaps = {}
    for k in pairs(KeyOrder) do
        local v = t[k]
        if typeof(v) == "Color3" then
            local nv = Unique(k, v)
            if nv ~= THEME[k] then
                table.insert(swaps, { THEME[k], nv })
                THEME[k] = nv
            end
        end
    end
    for _, g in ipairs({ "Hot", "Title", "Background" }) do
        local v = t[g]
        if v == false then Custom[g] = nil
        elseif type(v) == "table" then Custom[g] = Normalize(v) or Custom[g] end
    end
    if type(t.BackgroundRotation) == "number" then Library.BgRotation = t.BackgroundRotation end
    local newHot, newTitle, newBg = BuildHot(), BuildTitle(), BuildBg()

    local function Remap(c)
        for _, sw in ipairs(swaps) do if c == sw[1] then return sw[2] end end
        return c
    end
    for _, Gui in ipairs(Library._Guis) do
        if Gui.Parent then
            for _, d in ipairs(Gui:GetDescendants()) do
                if d:IsA("UIGradient") then
                    local cur = d.Color
                    if SeqEq(cur, oldBg) then
                        d.Color = newBg
                        d.Rotation = Library.BgRotation
                    elseif SeqEq(cur, oldHot) then
                        d.Color = newHot
                    elseif SeqEq(cur, oldTitle) then
                        d.Color = newTitle
                    else
                        local nk, changed = {}, false
                        for i, kp in ipairs(cur.Keypoints) do
                            local n = Remap(kp.Value)
                            if n ~= kp.Value then changed = true end
                            nk[i] = ColorSequenceKeypoint.new(kp.Time, n)
                        end
                        if changed then d.Color = ColorSequence.new(nk) end
                    end
                elseif d:IsA("UIStroke") then
                    local n = Remap(d.Color)
                    if n ~= d.Color then d.Color = n end
                elseif d:IsA("GuiObject") then
                    local n = Remap(d.BackgroundColor3)
                    if n ~= d.BackgroundColor3 then d.BackgroundColor3 = n end
                    if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                        n = Remap(d.TextColor3)
                        if n ~= d.TextColor3 then d.TextColor3 = n end
                        if d:IsA("TextBox") then
                            n = Remap(d.PlaceholderColor3)
                            if n ~= d.PlaceholderColor3 then d.PlaceholderColor3 = n end
                        end
                    elseif d:IsA("ImageLabel") or d:IsA("ImageButton") then
                        n = Remap(d.ImageColor3)
                        if n ~= d.ImageColor3 then d.ImageColor3 = n end
                    end
                    if d:IsA("ScrollingFrame") then
                        n = Remap(d.ScrollBarImageColor3)
                        if n ~= d.ScrollBarImageColor3 then d.ScrollBarImageColor3 = n end
                    end
                end
            end
        end
    end
end

local function MergeDefaults(t)
    local merged = {}
    for k, v in pairs(Defaults) do merged[k] = v end
    for k, v in pairs(t) do merged[k] = v end
    return merged
end

-- ตั้งธีมทั้งชุด: ชื่อพรีเซ็ต หรือ table (ส่วนที่ไม่ระบุจะกลับเป็นค่าเริ่มต้น)
function Library:SetTheme(nameOrTable)
    local t = nameOrTable
    if type(nameOrTable) == "string" then
        t = Themes[nameOrTable]
        if not t then return false end
        Library.CurrentTheme = nameOrTable
    elseif type(nameOrTable) == "table" then
        Library.CurrentTheme = "Custom"
    else
        return false
    end
    ApplyTheme(MergeDefaults(t), true)
    return true
end
function Library:ResetTheme() return Library:SetTheme("Premium") end

-- แก้เฉพาะจุด (รวมการเรียกหลายครั้งใน 1 เฟรมให้เหลือรอบเดียว) instant = true เพื่อใช้ทันที
local PendingColors, PendingScheduled = nil, false
function Library:SetColors(t, instant)
    if instant then ApplyTheme(t, false) return end
    PendingColors = PendingColors or {}
    for k, v in pairs(t) do PendingColors[k] = v end
    if not PendingScheduled then
        PendingScheduled = true
        task.defer(function()
            PendingScheduled = false
            local pc = PendingColors
            PendingColors = nil
            if pc then ApplyTheme(pc, false) end
        end)
    end
end

function Library:GetTheme()
    local out = {}
    for k in pairs(KeyOrder) do out[k] = THEME[k] end
    out.Hot, out.Title, out.Background = Custom.Hot, Custom.Title, Custom.Background
    out.BackgroundRotation = Library.BgRotation
    return out
end

local function ColorToStr(c)
    return string.format("Color3.fromRGB(%d, %d, %d)", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end
function Library:ExportTheme()
    local lines = { "{" }
    for _, k in ipairs(Library.ColorKeys) do
        table.insert(lines, string.format("    %s = %s,", k, ColorToStr(THEME[k])))
    end
    for _, g in ipairs({ "Hot", "Title", "Background" }) do
        if Custom[g] then
            local parts = {}
            for _, pt in ipairs(Custom[g]) do
                table.insert(parts, string.format("{ %.3f, %s }", pt[1], ColorToStr(pt[2])))
            end
            table.insert(lines, string.format("    %s = { %s },", g, table.concat(parts, ", ")))
        end
    end
    table.insert(lines, string.format("    BackgroundRotation = %d,", math.floor(Library.BgRotation + 0.5)))
    table.insert(lines, "}")
    return table.concat(lines, "\n")
end

-- นำเข้าจากข้อความ Lua (ผลของ ExportTheme) ต้องมี loadstring
function Library:ImportTheme(text)
    local fn = loadstring and loadstring("return " .. tostring(text))
    if not fn then return false end
    local ok, t = pcall(fn)
    if not ok or type(t) ~= "table" then return false end
    return Library:SetTheme(t)
end

