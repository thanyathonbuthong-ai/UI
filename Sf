function Library:_Dialog(Scale, A)
    A = A or {}
    local Gui = Library:Create("ScreenGui", {
        Name = "PremiumLibDialog", Parent = Library:Parent(), ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
