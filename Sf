        function Obj:Slider(A)
            local Callback = A.Callback or function() end
            local VA = A.Value
            local Min, Max, Default
            if type(VA) == "table" then
                Min, Max, Default = VA.Min or 0, VA.Max or 100, VA.Default
            else
                Min, Max, Default = A.Min or 0, A.Max or 100, VA
            end
            Default = Default or Min
            local Step = A.Step or (10 ^ -(A.Rounding or 0))
            local Dec = 0
            do
                local s = string.format("%.6f", Step)
                s = s:gsub("0+$", "")
                s = s:gsub("%.$", "")
                local d = s:match("%.(%d+)")
                Dec = d and #d or 0
            end

            local Rows = Library:NewRows(Container, A.Title, A.Desc, A.Icon)
            local Left = Rows.Vectorize.Left.Text
            local Right = Rows.Vectorize.Right
            local Holder = Library:Create("Frame", { Name = "Slider", Parent = Right, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(0, 170, 0, 20) })
            local ValueLabel = Library:Create("TextBox", {
                Parent = Holder, AnchorPoint = Vector2.new(1, 0.5), BackgroundTransparency = 1, Position = UDim2.new(1, 0, 0.5, 0),
                Size = UDim2.new(0, 40, 1, 0), Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = THEME.TEXT_BRIGHT,
                TextXAlignment = Enum.TextXAlignment.Right, Text = "", ClearTextOnFocus = true,
            })
            local Track = Library:Create("Frame", {
                Name = "Track", Parent = Holder, AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = THEME.BG_INPUT, BorderSizePixel = 0,
                Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(1, -48, 0, 6),
            })
            Library:Corner(Track, 999)
            Library:Stroke(Track, THEME.STROKE_DARK, 1, 0.55)
            local Fill = Library:Create("Frame", { Parent = Track, BackgroundColor3 = THEME.PRIMARY, BorderSizePixel = 0, Size = UDim2.new(0, 0, 1, 0) })
            Library:Corner(Fill, 999)
            Library:Create("UIGradient", { Parent = Fill, Color = GradientHot() })
            local Knob = Library:Create("Frame", {
                Parent = Track, AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0,
                Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(0, 12, 0, 12), ZIndex = 2,
            })
            Library:Corner(Knob, 999)
            local Hit = Library:Create("TextButton", {
                Parent = Track, AnchorPoint = Vector2.new(0, 0.5), BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0.5, 0),
                Size = UDim2.new(1, 0, 0, 22), Text = "", ZIndex = 5,
            })

            local Data = { Title = A.Title, Desc = A.Desc, Value = Default, Min = Min, Max = Max, Locked = A.Locked or false, Instance = Rows }
            local function SetValue(v, fire)
                v = Data.Min + math.floor((v - Data.Min) / Step + 0.5) * Step
                v = math.clamp(v, Data.Min, Data.Max)
                v = tonumber(string.format("%." .. Dec .. "f", v))
                Data.Value = v
                local alpha = (Data.Max == Data.Min) and 0 or (v - Data.Min) / (Data.Max - Data.Min)
                TweenService:Create(Fill, TweenInfo.new(0.08), { Size = UDim2.new(alpha, 0, 1, 0) }):Play()
                TweenService:Create(Knob, TweenInfo.new(0.08), { Position = UDim2.new(alpha, 0, 0.5, 0) }):Play()
                ValueLabel.Text = tostring(v)
                if fire then Callback(v) end
            end
            BindDrag(Hit, function(input)
                if IsDropdownOpen() then return end
                local a = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                SetValue(Data.Min + (Data.Max - Data.Min) * a, true)
            end, function(on) Scroll.ScrollingEnabled = not on end)
            SetValue(Default, false)
            ValueLabel.FocusLost:Connect(function()
                local n = tonumber(ValueLabel.Text)
                if n then SetValue(n, true) else ValueLabel.Text = tostring(Data.Value) end
            end)

            local SetLock = Library:Lockable(Rows, A.Locked)
            local S = Library:Common(Data, Rows, Left.Title, Left.Desc, SetLock)
            S.Value = function(v) SetValue(v, true) end
            function Data:Set(v) SetValue(v, true) end
            function Data:SetMax(v) Data.Max = v; SetValue(Data.Value, false) end
            function Data:SetMin(v) Data.Min = v; SetValue(Data.Value, false) end
            return Library:Proxy(Data, S)
        end

