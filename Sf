-- ═════════ KEY SYSTEM ═════════
-- Library:KeySystem({ Title, Note, Key = "abc" | {"a","b"}, Validator = function(k) return true end,
--                     SaveKey = true, Folder = "PremiumLib", Url = "https://...", Callback = function(k) end })
-- คืนค่า true เมื่อใส่คีย์ถูก / false เมื่อกดปิด (ฟังก์ชันจะรอจนกว่าผู้ใช้จะตอบ)
function Library:KeySystem(A)
    A = A or {}
    local Keys = A.Key
    if type(Keys) == "string" then Keys = { Keys } end
    local Folder = A.Folder or "PremiumLib"
    local File = Folder .. "/key.txt"
    local function HasFS() return writefile and readfile and isfile and isfolder and makefolder end
    local function Valid(k)
        if A.Validator then
            local ok, r = pcall(A.Validator, k)
            return ok and r == true
        end
        if Keys then
            for _, v in ipairs(Keys) do if tostring(v) == k then return true end end
        end
        return false
    end
    if A.SaveKey and HasFS() and isfile(File) then
        local ok, saved = pcall(readfile, File)
        if ok and Valid(saved) then
            if A.Callback then pcall(A.Callback, saved) end
            return true
        end
    end

    local Gui = Library:Create("ScreenGui", {
        Name = "PremiumLibKey", Parent = Library:Parent(), ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true, DisplayOrder = 70,
    })
    Library:Create("UIScale", { Parent = Gui, Scale = Mobile and 1 or 1.2 })
    local Overlay = Library:Create("TextButton", {
        Parent = Gui, BackgroundColor3 = Color3.fromRGB(0, 0, 0), BackgroundTransparency = 0.35, BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0), Text = "", AutoButtonColor = false,
    })
    local Card = Library:Create("Frame", {
        Parent = Overlay, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, 300, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = THEME.BG_PANEL, BorderSizePixel = 0,
    })
    Library:Corner(Card, 14)
    local CardStroke = Library:Stroke(Card, THEME.GLOW, 1.5, 0.35)
    Library:Create("UIGradient", { Parent = Card, Rotation = Library.BgRotation, Color = GradientBg() })
    Library:Create("UIPadding", { Parent = Card, PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 14), PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16) })
    Library:Create("UIListLayout", { Parent = Card, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder })

    local T = Library:Create("TextLabel", {
        Parent = Card, BackgroundTransparency = 1, LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 22), Font = Enum.Font.GothamBold,
        TextSize = 15, TextColor3 = THEME.PRIMARY, Text = tostring(A.Title or "Key System"), TextXAlignment = Enum.TextXAlignment.Left,
    })
    Library:Create("UIGradient", { Parent = T, Color = GradientTitle(), Rotation = 90 })
    Library:Create("TextLabel", {
        Parent = Card, BackgroundTransparency = 1, LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = Color3.fromRGB(180, 188, 205), TextWrapped = true, RichText = true,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Text = tostring(A.Note or "กรุณาใส่คีย์เพื่อดำเนินการต่อ"),
    })
    local Box = Library:Create("Frame", { Parent = Card, LayoutOrder = 3, BackgroundColor3 = THEME.BG_INPUT, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 30) })
    Library:Corner(Box, 8)
    local BoxStroke = Library:Stroke(Box, THEME.STROKE_DARK, 1, 0.55)
    local TB = Library:Create("TextBox", {
        Parent = Box, BackgroundTransparency = 1, Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -20, 1, 0),
        Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = THEME.TEXT_BRIGHT, PlaceholderColor3 = THEME.TEXT_DIM,
        PlaceholderText = "Enter key...", Text = "", ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left,
    })
    local Row = Library:Create("Frame", { Parent = Card, LayoutOrder = 4, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28) })
    Library:Create("UIListLayout", {
        Parent = Row, FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right,
        Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center,
    })

    local Done, Result = false, false
    local function MakeBtn(Text, Variant, Order, Cb)
        local B = Library:Create("TextButton", {
            Parent = Row, LayoutOrder = Order, Size = UDim2.new(0, 0, 0, 28), AutomaticSize = Enum.AutomaticSize.X,
            BackgroundColor3 = Variant == "Primary" and THEME.PRIMARY or THEME.BG_ROW, BackgroundTransparency = Variant == "Tertiary" and 1 or 0,
            BorderSizePixel = 0, AutoButtonColor = false, Font = Enum.Font.GothamBold, TextSize = 12, Text = Text,
            TextColor3 = Variant == "Primary" and Color3.fromRGB(0, 20, 30) or THEME.TEXT_BRIGHT,
        })
        Library:Create("UIPadding", { Parent = B, PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14) })
        Library:Corner(B, 10)
        if Variant == "Primary" then Library:Create("UIGradient", { Parent = B, Color = GradientHot(), Rotation = 45 })
        elseif Variant == "Secondary" then Library:Stroke(B, THEME.STROKE_DARK, 1, 0.4) end
        B.MouseButton1Click:Connect(Cb)
    end

    local function Submit()
        local k = (TB.Text:gsub("%s+", ""))
        if Valid(k) then
            if A.SaveKey and HasFS() then
                pcall(function()
                    if not isfolder(Folder) then makefolder(Folder) end
                    writefile(File, k)
                end)
            end
            Result, Done = true, true
            Gui:Destroy()
            if A.Callback then task.spawn(A.Callback, k) end
        else
            BoxStroke.Color = Color3.fromRGB(255, 80, 90)
            BoxStroke.Transparency = 0
            task.delay(1.2, function()
                if BoxStroke.Parent then BoxStroke.Color = THEME.STROKE_DARK; BoxStroke.Transparency = 0.55 end
            end)
            Library:Notify({ Title = "Invalid key", Content = "คีย์ไม่ถูกต้อง กรุณาลองใหม่", Duration = 3 })
        end
    end

    if A.Url then
        MakeBtn("Get Key", "Secondary", 1, function()
            if setclipboard then pcall(setclipboard, A.Url) end
            Library:Notify({ Title = "Copied", Content = "คัดลอกลิงก์แล้ว", Duration = 2 })
        end)
    end
    MakeBtn("Close", "Tertiary", 2, function()
        Result, Done = false, true
        Gui:Destroy()
    end)
    MakeBtn("Submit", "Primary", 3, Submit)
    TB.FocusLost:Connect(function(enter) if enter then Submit() end end)

    while not Done do task.wait(0.1) end
    return Result
end

