--// Library:DestroyAll()  ->  removes EVERYTHING: every window, open button, pop-up, notification, blur,
--// all connections (keybinds, heartbeat loops, tag scrolling ...) and the ScreenGui itself.
function Library:DestroyAll()
	for _, Win in ipairs(table.clone(OpenWindows)) do
		pcall(function() Win:Destroy() end)
	end
	table.clear(OpenWindows)

	for _, Connection in ipairs(AllConnections) do
		pcall(function() Connection:Disconnect() end)
	end
	table.clear(AllConnections)

	for _, Item in next, Blurs do
		pcall(function() if Item.root then Item.root:Destroy() end end)
	end
	table.clear(Blurs)

	pcall(function() Destroy(NotifyGui) end)
	pcall(function() Destroy(Screen) end)
end

--// ---------------------------------------------------------------
--// Fonts (like WindUI:SetFont)
--//   Library:SetFont("rbxassetid://12187365364")   a font family asset id (rbxassetid / plain number / rbxasset:// json path)
--//   Library:SetFont(Enum.Font.Gotham)  Library:SetFont("Ubuntu")  Library:SetFont(Font.new("rbxassetid://..."))
--//   CreateWindow({ Font = ... })   Window:SetFont(...)   Library:GetFont()   Library:SetFont(nil) -> back to the default fonts
--//   Bold / regular weights of every label are kept, only the family changes.
--// ---------------------------------------------------------------
local CurrentFamily --// nil = template fonts
local FontHooked = false
local FontSkip = { Arrow = true, Check = true, Mark = true }

local function FamilyOf(Value)
	if typeof(Value) == "Font" then return Value.Family end
	if typeof(Value) == "EnumItem" and Value.EnumType == Enum.Font then return Font.fromEnum(Value).Family end

	if type(Value) == "number" then return "rbxassetid://" .. tostring(math.floor(Value)) end

	if type(Value) == "string" and Value ~= "" then
		local Ok, Item = pcall(function() return Enum.Font[Value] end)
		if Ok and Item then return Font.fromEnum(Item).Family end

		if Value:match("^%d+$") then return "rbxassetid://" .. Value end
		return Value --// rbxassetid://.. / rbxasset://.. / a getcustomasset() path
	end
end

local function PaintFont(Object)
	if not CurrentFamily then return end
	if not (Object:IsA("TextLabel") or Object:IsA("TextButton") or Object:IsA("TextBox")) then return end
	if FontSkip[Object.Name] then return end
	if Object.Font == Enum.Font.Code or Object.Font == Enum.Font.RobotoMono then return end --// code blocks stay monospaced

	local Old = Object.FontFace
	if Old.Family == CurrentFamily then return end

	pcall(function() Object.FontFace = Font.new(CurrentFamily, Old.Weight, Old.Style) end)
end

local function PaintFontAll()
	for _, Root in ipairs({ Screen, NotifyGui }) do
		for _, Object in next, Root:GetDescendants() do PaintFont(Object) end
	end
end

function Library:SetFont(Value)
	if Value == nil or Value == false then
		warn("[UI LIB]: SetFont(nil) only affects elements created afterwards - re-run the script for the original fonts")
		CurrentFamily = nil
		return true
	end

	local Family = FamilyOf(Value)
	if not Family then
		warn("[UI LIB]: SetFont needs a font asset id, an Enum.Font, a Font or a font name")
		return false
	end

	CurrentFamily = Family

	if not FontHooked then
		FontHooked = true
		--// every element created later (and every notification) gets the font too
		Connect(Screen.DescendantAdded, PaintFont)
		Connect(NotifyGui.DescendantAdded, PaintFont)
	end

	PaintFontAll()

	for _, Win in ipairs(OpenWindows) do
		pcall(function() Win:_RefitFont() end)
	end

	return true
end

function Library:GetFont() return CurrentFamily end
Library.Themes = ThemePresets
function Library:GetTheme(Name) return ThemePresets[Name] end
function Library:GetCurrentTheme() return Setup.ThemeName end
function Library:SetTheme(Info)
	local Done = false

	for _, Win in ipairs(OpenWindows) do
		local Ok, Result = pcall(function() return Win:SetTheme(Info) end)
		Done = (Ok and Result) or Done
	end

	--// no window yet: remember it, the next CreateWindow uses it
	if not Done then
		local Found = ResolveTheme(Info)

		if Found then
			PendingTheme = Found
			Theme = Found
			Setup.ThemeName = Found.Name or Setup.ThemeName
			Setup.ThemeMode = (Found.Light and "Light") or "Dark"
			Done = true
		end
	end

	return Done
end
