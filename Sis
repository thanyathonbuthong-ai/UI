			Corner(Black, 4)
			local BlackGradient = Instance.new("UIGradient")
			BlackGradient.Rotation = 90
			BlackGradient.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
			BlackGradient.Parent = Black

			Cursor = Instance.new("Frame")
			SetProperty(Cursor, { Name = "Cursor", AnchorPoint = Vector2.new(.5, .5), Size = UDim2.fromOffset(12, 12), BackgroundTransparency = 1, Parent = SV })
			Corner(Cursor, 6)
			local CursorStroke = Instance.new("UIStroke")
			CursorStroke.Name = "CursorStroke"
			CursorStroke.Color = Color3.new(1, 1, 1)
			CursorStroke.Thickness = 2
			CursorStroke.Parent = Cursor

			Track(SV, function(X, Y)
				S = math.clamp((X - SV.AbsolutePosition.X) / SV.AbsoluteSize.X, 0, 1)
				V = 1 - math.clamp((Y - SV.AbsolutePosition.Y) / SV.AbsoluteSize.Y, 0, 1)
				Apply()
			end)

			--// Hue bar
			local Hue = Instance.new("Frame")
			SetProperty(Hue, { Name = "Hue", Position = UDim2.fromOffset(12, 160), Size = UDim2.new(1, -24, 0, 14), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = Panel })
			Corner(Hue, 4)
			local HueGradient = Instance.new("UIGradient")
			local Keys = {}
			for Step = 0, 6 do
				table.insert(Keys, ColorSequenceKeypoint.new(Step / 6, Color3.fromHSV(Step / 6, 1, 1)))
			end
			HueGradient.Color = ColorSequence.new(Keys)
			HueGradient.Parent = Hue

			HueHandle = Instance.new("Frame")
			SetProperty(HueHandle, { Name = "Handle", AnchorPoint = Vector2.new(.5, .5), Size = UDim2.new(0, 4, 1, 6), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = Hue })
			Corner(HueHandle, 2)

			Track(Hue, function(X)
				H = math.clamp((X - Hue.AbsolutePosition.X) / Hue.AbsoluteSize.X, 0, 1)
				Apply()
			end)

			--// Transparency bar (only when Transparency was given)
			if HasAlpha then
				AlphaBack = Instance.new("Frame")
				SetProperty(AlphaBack, { Name = "AlphaBack", Position = UDim2.fromOffset(12, 182), Size = UDim2.new(1, -24, 0, 14), BackgroundColor3 = Theme.Interactables, BorderSizePixel = 0, Parent = Panel })
				Corner(AlphaBack, 4)

				AlphaFill = Instance.new("Frame")
				SetProperty(AlphaFill, { Name = "AlphaFill", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromHSV(H, S, V), BorderSizePixel = 0, Parent = AlphaBack })
				Corner(AlphaFill, 4)
				local AlphaGradient = Instance.new("UIGradient")
				AlphaGradient.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
				AlphaGradient.Parent = AlphaFill

				AlphaHandle = Instance.new("Frame")
				SetProperty(AlphaHandle, { Name = "Handle", AnchorPoint = Vector2.new(.5, .5), Size = UDim2.new(0, 4, 1, 6), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = AlphaBack })
				Corner(AlphaHandle, 2)

				Track(AlphaBack, function(X)
					A = math.clamp((X - AlphaBack.AbsolutePosition.X) / AlphaBack.AbsoluteSize.X, 0, 1)
					Apply()
				end)
			end

			--// Hex + Done
			local HexY = (HasAlpha and 206) or 184

			HexBox = Instance.new("TextBox")
			SetProperty(HexBox, {
				Name = "HexBox",
				Position = UDim2.fromOffset(12, HexY),
				Size = UDim2.new(1, -90, 0, 26),
				BackgroundColor3 = Theme.Interactables,
				BorderSizePixel = 0,
				ClearTextOnFocus = false,
				FontFace = DescRef.FontFace,
				TextSize = 13,
				TextColor3 = Theme.Title,
				PlaceholderText = "#FFFFFF",
				Text = "",
				Parent = Panel,
			})
			Corner(HexBox, 5)

			Connect(HexBox.FocusLost, function()
				local Ok, Parsed = pcall(Color3.fromHex, HexBox.Text)

				if Ok and Parsed then
					H, S, V = Parsed:ToHSV()
				end

				Apply()
			end)

			local Done = Instance.new("TextButton")
			SetProperty(Done, {
				Name = "Done",
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -12, 0, HexY),
				Size = UDim2.fromOffset(64, 26),
				BackgroundColor3 = Accent,
				BorderSizePixel = 0,
				AutoButtonColor = true,
				Text = "Done",
				FontFace = TitleRef.FontFace,
				TextSize = 13,
				TextColor3 = Color3.new(1, 1, 1),
				Parent = Panel,
			})
			Corner(Done, 5)
			Animations:Press(Done, .9)
			Connect(Done.MouseButton1Click, Close)

			Elevate(Sink, 99)
		end

		Animations:Press(Row, .975)

		Connect(Row.MouseButton1Click, function()
			if not Panel then Build() end

			Apply(true)
			Sink.Visible = true
			Tween(Sink, .2, { BackgroundTransparency = .55 })
		end)

		function Object:Set(New: Color3, NewTransparency: number?, Silent: boolean?)
			if New then H, S, V = New:ToHSV() end
			if NewTransparency then A = NewTransparency end
			Apply(Silent)
		end

		function Object:Get() return Color3.fromHSV(H, S, V), A end

		table.insert(Custom, function()
			if Panel then
				Panel.BackgroundColor3 = Theme.Secondary
				HexBox.BackgroundColor3 = Theme.Interactables
				HexBox.TextColor3 = Theme.Title
				if AlphaBack then AlphaBack.BackgroundColor3 = Theme.Interactables end
			end
		end)

		function Object:Save() return { Color = "#" .. Color3.fromHSV(H, S, V):ToHex(), Alpha = A } end
		function Object:Load(Data)
			if type(Data) == "table" and Data.Color then
				local Ok, Parsed = pcall(Color3.fromHex, Data.Color)
				if Ok then Object:Set(Parsed, Data.Alpha) end
			end
		end

		Apply(true)
		return Object
	end

