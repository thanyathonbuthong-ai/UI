	--// ------------------------------------------------------------------
	--// Colorpicker  (HSV box + hue bar + optional transparency + hex)
	--// Callback(Color3, Transparency)
	--// ------------------------------------------------------------------
	function Options:AddColorpicker(Settings: { Title: string, Description: string, Default: Color3, Transparency: number?, Locked: boolean, LockedTitle: string, Tab: Instance, Callback: any })
		local Row = NewRow(Settings, nil, 52)
		local Object = BaseObject(Row, AddLock(Row, Settings))

		local Default = Settings.Default or Color3.fromRGB(255, 255, 255)
		local H, S, V = Default:ToHSV()
		local HasAlpha = Settings.Transparency ~= nil
		local A = Settings.Transparency or 0

		local Preview = Instance.new("Frame")
		SetProperty(Preview, {
			Name = "Preview",
			AnchorPoint = Vector2.new(1, .5),
			Position = UDim2.new(1, -14, .5, 0),
			Size = UDim2.fromOffset(40, 22),
			BackgroundColor3 = Default,
			BackgroundTransparency = A,
			BorderSizePixel = 0,
			Parent = Row,
		})
		Corner(Preview, 5)
		Stroke(Preview)

		local Sink, Panel, SV, Cursor, HueHandle, AlphaBack, AlphaFill, AlphaHandle, HexBox

		local function Apply(Silent)
			local Picked = Color3.fromHSV(H, S, V)
			Preview.BackgroundColor3 = Picked
			Preview.BackgroundTransparency = A

			if Panel then
				SV.BackgroundColor3 = Color3.fromHSV(H, 1, 1)
				Cursor.Position = UDim2.fromScale(S, 1 - V)
				HueHandle.Position = UDim2.fromScale(H, .5)
				HexBox.Text = "#" .. Picked:ToHex()

				if HasAlpha then
					AlphaFill.BackgroundColor3 = Picked
					AlphaHandle.Position = UDim2.fromScale(A, .5)
				end
			end

			if not Silent and Settings.Callback then
				Settings.Callback(Picked, A)
			end
		end

		local function Close()
			if Sink then
				Sink.Visible = false
				Sink.BackgroundTransparency = 1
			end
		end

		local function Build()
			Sink = NewSink()
			Sink.Visible = false
			Connect(Sink.MouseButton1Click, Close)

			local PanelHeight = (HasAlpha and 246) or 224
			Panel = Instance.new("Frame")
			SetProperty(Panel, {
				Name = "ColorpickerPanel",
				Active = true, --// swallow clicks so the sink doesn't close the panel
				AnchorPoint = Vector2.new(.5, .5),
