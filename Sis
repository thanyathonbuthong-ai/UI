			--// Saturation / Value box
			SV = Instance.new("Frame")
			SetProperty(SV, { Name = "SV", Position = UDim2.fromOffset(12, 32), Size = UDim2.new(1, -24, 0, 120), BorderSizePixel = 0, Parent = Panel })
			Corner(SV, 4)

			local White = Instance.new("Frame")
