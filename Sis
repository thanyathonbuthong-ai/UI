				AnchorPoint = Vector2.new(.5, .5),
				Position = UDim2.fromScale(.5, .5),
				Size = UDim2.fromOffset(16, 16),
				BackgroundTransparency = 1,
				Image = Image,
				ImageColor3 = Theme.Title,
				ZIndex = 22,
				Parent = Control,
			})
			Icon:SetAttribute("NoTheme", true)
			table.insert(Custom, function() Icon.ImageColor3 = Theme.Title end)

