	function Options:AddSlider(Settings: { [string]: any }) 
		local Slider = Clone(Components["Slider"]);
		local Title, Description = Options:GetLabels(Slider);

		local Main = Slider["Slider"];
		local Amount = Main["Main"].Input;
		local Slide = Main["Slide"];
		local Fire = Slide["Fire"];
		local Fill = Slide["Highlight"];
		local Circle = Fill["Circle"];

		PaintSliderTrack(Slide)
		PaintSliderFill(Fill)
		PaintSliderHandle(Circle)

		--// Accepts the old style (MaxValue) and WindUI style (Value = { Min, Max, Default }, Step)
		local Range = (type(Settings.Value) == "table" and Settings.Value) or {}
		local Min = Settings.MinValue or Settings.Min or Range.Min or 0
		local Max = Settings.MaxValue or Settings.Max or Range.Max or 100
		local Step = Settings.Step

		local Active = false
		local Value = Min

		--// WindUI: IsTextbox = false hides the number box, IsTooltip = true shows the value above the handle
		if Settings.IsTextbox == false then Main["Main"].Visible = false end

		local Tip
		if Settings.IsTooltip then
			Tip = Instance.new("TextLabel")
			SetProperty(Tip, {
				Name = "Tooltip",
				AnchorPoint = Vector2.new(.5, 1),
				Position = UDim2.new(.5, 0, 0, -6),
				Size = UDim2.fromOffset(40, 20),
				BackgroundColor3 = Theme.Primary,
				TextColor3 = Theme.Title,
				Font = Enum.Font.GothamMedium,
				TextSize = 12,
				Visible = false,
				ZIndex = 10,
				Parent = Circle,
			})

			local Round = Instance.new("UICorner")
			Round.CornerRadius = UDim.new(0, 5)
			Round.Parent = Tip
		end
		
		local SetNumber = function(Number)
			if Step and Step > 0 then
				Number = math.floor((Number - Min) / Step + 0.5) * Step + Min
				Number = math.floor(Number * 1e6 + 0.5) / 1e6
			elseif Settings.AllowDecimals then
				local Power = 10 ^ (Settings.DecimalAmount or 2)
				Number = math.floor(Number * Power + 0.5) / Power
			else
				Number = math.round(Number)
			end
			
			return math.clamp(Number, Min, Max)
		end

		local Update = function(Number, Silent)
			local Scale = (Player.Mouse.X - Slide.AbsolutePosition.X) / Slide.AbsoluteSize.X			
			Scale = math.clamp(Scale, 0, 1)

			Value = SetNumber(Number or (Min + Scale * (Max - Min)))
			Amount.Text = tostring(Value)
			if Tip then Tip.Text = tostring(Value) end
			Fill.Size = UDim2.fromScale((Value - Min) / math.max(Max - Min, 1e-9), 1)

			if not Silent and Settings.Callback then
				Settings.Callback(Value)
			end
		end

		local Activate = function()
			Active = true
			if Tip then Tip.Visible = true end

			repeat task.wait()
				Update()
			until not Active

			if Tip then Tip.Visible = false end
		end
		
		Connect(Amount.FocusLost, function() 
			Update(tonumber(Amount.Text) or Value)
		end)

		Connect(Fire.MouseButton1Down, Activate)
		Connect(Services.Input.InputEnded, function(Input) 
			if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
				Active = false
			end
		end)

		Animations:Component(Slider);
		SetProperty(Title, { Text = Settings.Title });
		SetProperty(Description, { Text = Settings.Description });
		SetProperty(Slider, {
			Name = Settings.Title,
			Parent = Settings.Tab,
			Visible = true,
		})

		Update(Settings.Default or Range.Default or Min, true)

		local Object = { Instance = Slider }

		function Object:Get() return Value end
		function Object:Set(Number, Silent) Update(tonumber(Number) or Value, Silent) end

		--// WindUI: Slider:SetMin(n) / Slider:SetMax(n)
		function Object:SetMin(Number) Min = tonumber(Number) or Min Update(Value, true) end
		function Object:SetMax(Number) Max = tonumber(Number) or Max Update(Value, true) end

		return Object
	end

	function Options:AddParagraph(Settings: { [string]: any }) 
		local Paragraph = Clone(Components["Paragraph"]);
		local Title, Description = Options:GetLabels(Paragraph);

		SetProperty(Title, { Text = Settings.Title });
		SetProperty(Description, { Text = Settings.Description });
		SetProperty(Paragraph, {
			Parent = Settings.Tab,
			Visible = true,
		})

		--// WindUI: Buttons = { { Title = "OK", Icon = "check", Color = Color3, Callback = function() end }, ... }
		--// (shown side by side right under the paragraph)
		if type(Settings.Buttons) == "table" and #Settings.Buttons > 0 then
			local Row = Options:AddGroup({ Tab = Settings.Tab })

			for _, Info in ipairs(Settings.Buttons) do
				Options:AddButton({
					Tab = Row,
					Title = Info.Title or Info.Name,
					Icon = Info.Icon,
					Color = Info.Color,
					Callback = Info.Callback,
				})
			end
		end

		local Object = { Instance = Paragraph }

		function Object:SetTitle(Text) Title.Text = Text end
		function Object:SetDesc(Text) Description.Text = Text end

		return Object
	end

