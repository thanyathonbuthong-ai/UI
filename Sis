		end

		--// 1) minimize
		local Minimize = NewControl("Minimize", 1, false)
		NewIcon(Minimize, "minus")

		--// 2) fullscreen (icon is drawn: one square = enter, two squares = restore)
		local Fullscreen = NewControl("Fullscreen", 2, false)
		local Squares = {}

		local function NewSquare(Name)
			local Box = Instance.new("Frame")
			SetProperty(Box, {
				Name = Name,
				AnchorPoint = Vector2.new(.5, .5),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ZIndex = 22,
				Parent = Fullscreen,
			})

			local Rounded = Instance.new("UICorner")
			Rounded.CornerRadius = UDim.new(0, 2)
			Rounded.Parent = Box

			local Line = Instance.new("UIStroke")
			SetProperty(Line, { Name = "CtrlStroke", Thickness = 1.5, Color = Theme.Title, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = Box })

			table.insert(Custom, function() Line.Color = Theme.Title end)
			table.insert(Squares, Box)

			return Box
		end

		local Front, Back = NewSquare("CtrlFront"), NewSquare("CtrlBack")

		local function DrawFullscreenIcon(IsMax)
			if IsMax then
				Front.Size, Front.Position = UDim2.fromOffset(8, 8), UDim2.new(.5, -2, .5, 2)
				Back.Size, Back.Position = UDim2.fromOffset(8, 8), UDim2.new(.5, 2, .5, -2)
				Back.Visible = true
			else
				Front.Size, Front.Position = UDim2.fromOffset(11, 11), UDim2.fromScale(.5, .5)
				Back.Visible = false
			end
		end

		DrawFullscreenIcon(false)

		local SavedPosition
		DoFullscreen = function()
			if Maximized then
				Maximized = false
				DrawFullscreenIcon(false)
				Tween(Window, .4, { Size = Setup.Size, Position = SavedPosition or Window.Position }, Smooth)
			else
				Maximized = true
				SavedPosition = Window.Position
				DrawFullscreenIcon(true)
				Tween(Window, .4, { Size = UDim2.fromScale(1, 1), Position = UDim2.fromScale(.5, .5) }, Smooth)
			end
		end
		Connect(Fullscreen.MouseButton1Click, function() DoFullscreen() end)

		--// 3) close
		local CloseButton = NewControl("Close", 3, true)
		NewIcon(CloseButton, "x")

		Connect(Minimize.MouseButton1Click, function()
			if Opened then Close() end
		end)

		Connect(CloseButton.MouseButton1Click, function()
			if Settings.CloseDialog == false then
				Library:DestroyAll()
				return
			end

			Options:Popup({
				Title = Settings.CloseTitle or "Delete UI",
				Content = Settings.CloseContent or "Do you want to close this window? Everything will be deleted and you will need to run the script again to open it.",
				Buttons = {
					{ Title = "Cancel" },
					{ Title = "Delete All", Variant = "Primary", Callback = function() Library:DestroyAll() end },
				},
			})
		end)

		--// ---------------------------------------------------------------
		--// Control style:  "Buttons" (WindUI: minimize / fullscreen / close, top-right)
		--//                 "Dots"    (the original three colour dots)
		--// CreateWindow({ ControlStyle = "Dots" })   Window:SetControlStyle("Buttons")   Window:GetControlStyle()
		--// ---------------------------------------------------------------
		--// ---------------------------------------------------------------
		--// Top bar  (right of the sidebar, same height as the control buttons)
		--//   "Dots"    -> visible filled bar, tags live inside it and can be as long as the window is wide
		--//   "Buttons" -> invisible, only holds the tags and stops before [ minimize ][ fullscreen ][ close ]
		--// ---------------------------------------------------------------
		TopBarFrame = Instance.new("Frame")
		SetProperty(TopBarFrame, {
			Name = "WindowTopBar",
			Position = UDim2.fromOffset(0, 4),
			Size = UDim2.fromOffset(0, 28),
			BackgroundColor3 = Theme.Interactables,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			ZIndex = 15,
			Parent = Window,
		})

		local TopBarCorner = Instance.new("UICorner")
		TopBarCorner.CornerRadius = UDim.new(0, 8)
		TopBarCorner.Parent = TopBarFrame

		local function LayoutTopBar()
			if not TopBarFrame or not TopBarFrame.Parent then return end

			local WindowX, WindowW = Window.AbsolutePosition.X, Window.AbsoluteSize.X
			local Left = Sidebar.AbsolutePosition.X + Sidebar.AbsoluteSize.X - WindowX + 8
			local Right = WindowW - 8

			if ControlStyle == "Buttons" and Bar.AbsoluteSize.X > 0 then
				Right = Bar.AbsolutePosition.X - WindowX - 8 --// stop before the control buttons
			end

			TopBarFrame.Position = UDim2.fromOffset(Left, 4)
			TopBarFrame.Size = UDim2.fromOffset(math.max(Right - Left, 0), 28)
		end

		Connect(Window:GetPropertyChangedSignal("AbsoluteSize"), LayoutTopBar)
		Connect(Window:GetPropertyChangedSignal("AbsolutePosition"), LayoutTopBar)
		Connect(Sidebar:GetPropertyChangedSignal("AbsoluteSize"), LayoutTopBar)
		Connect(Bar:GetPropertyChangedSignal("AbsoluteSize"), LayoutTopBar)
		Connect(Bar:GetPropertyChangedSignal("AbsoluteSize"), function() RefitTitle() end)
		table.insert(Custom, function() TopBarFrame.BackgroundColor3 = Theme.Interactables end)

		local Aliases = {
			buttons = "Buttons", button = "Buttons", windui = "Buttons", modern = "Buttons", icons = "Buttons",
			dots = "Dots", dot = "Dots", mac = "Dots", classic = "Dots", circles = "Dots",
		}

		local function ApplyStyle(Style)
			local ShowButtons = Style == "Buttons"
			ControlStyle = Style

			Bar.Visible = ShowButtons
			if TitleLabel then TitleLabel.Visible = ShowTitle end

			for Dot, Original in next, DotVisible do
				if Dot.Parent then Dot.Visible = (not ShowButtons) and Original end
			end

			DrawFullscreenIcon(Maximized)

			--// the top bar exists in both styles, so the tab content always starts below it
			CurrentInset = ControlsInset
			TopBarFrame.BackgroundTransparency = 1 --// no filled band: nothing that looks like a divider line
			LayoutTopBar()
			for _, Info in ipairs(TabScrolls) do
				if Info.Scroll.Parent then PlaceScroll(Info) end
			end

			FitTitle()
			RefreshTags()
			task.defer(function() FitTitle() RefreshTags() end)
		end

		function Options:SetControlStyle(Style)
			local Key = Aliases[tostring(Style):lower()]

			if not Key then
				warn("[UI LIB]: control style '" .. tostring(Style) .. "' doesn't exist - use \"Buttons\" or \"Dots\"")
				return false
			end

			ApplyStyle(Key)
			return true
		end

		function Options:GetControlStyle() return ControlStyle end

		ApplyStyle(Aliases[tostring(Settings.ControlStyle or "Buttons"):lower()] or "Buttons")

		--// ---------------------------------------------------------------
		--// Divider lines of the template (sidebar header underline, sidebar | content split ...)
		--// are hidden, like WindUI's clean header.   CreateWindow({ ShowDividers = true }) keeps them.
		--// CreateWindow({ DebugDividers = true }) prints what was hidden.
		--// ---------------------------------------------------------------
		if Settings.ShowDividers ~= true then
			local LineNames = { underline = true, line = true, divider = true, separator = true, border = true, seperator = true }
			local Hidden = {}

			local function IsThin(Obj)
				local Size = Obj.Size
				return (Size.Y.Scale == 0 and Size.Y.Offset <= 2) or (Size.X.Scale == 0 and Size.X.Offset <= 2)
			end

			local function Scan(Parent)
				if not Parent then return end

				for _, Obj in next, Parent:GetChildren() do
					if Obj:IsA("Frame") and Obj ~= TopBarFrame and Obj.Name ~= "WindowControls" and Obj.Name ~= "BackgroundShadow" then
						if LineNames[Obj.Name:lower()] or (IsThin(Obj) and #Obj:GetChildren() == 0) then
							Obj.Visible = false
							table.insert(Hidden, Obj:GetFullName())
						end
					elseif Obj:IsA("UIStroke") and Parent ~= Window and Obj.Name ~= "Outline" then
						--// stroke drawn around the sidebar / its header
						Obj.Enabled = false
						table.insert(Hidden, Obj:GetFullName())
					end
				end
			end

			Scan(Window)
			Scan(Sidebar)
			Scan(Sidebar:FindFirstChild("Top"))
			Scan(Holder)

			if Settings.DebugDividers then print("[UI LIB]: hidden divider objects:\n" .. table.concat(Hidden, "\n")) end
		end
	end

