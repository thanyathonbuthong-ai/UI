	--// background picture behind the content (WindUI: SetBackgroundImage / SetBackgroundImageTransparency)
	local BackgroundPicture
	function Options:SetBackgroundImage(Image, Transparency)
		if not Image or Image == "" then
			if BackgroundPicture then BackgroundPicture:Destroy() BackgroundPicture = nil end
			return
		end

		if not BackgroundPicture then
			BackgroundPicture = Instance.new("ImageLabel")
			SetProperty(BackgroundPicture, {
				Name = "Outline", --// harmless name so SetTheme never recolours the picture
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ScaleType = Enum.ScaleType.Crop,
				ZIndex = 0,
				Parent = Holder,
			})
			Corner(BackgroundPicture, 10)
		end

		BackgroundPicture.Image = tostring(Image)
		BackgroundPicture.ImageTransparency = tonumber(Transparency) or .6
	end
	function Options:SetBackgroundImageTransparency(Value)
