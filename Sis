	--// Tab Functions

	function Options:SetTab(Name: string)
		TabChosen = true

		for Index, Button in next, Tab:GetChildren() do
			if Button:IsA("TextButton") then
				local Opened, SameName = Button.Value, (Button.Name == Name);
				local Padding = Button:FindFirstChildOfClass("UIPadding");

				if SameName and not Opened.Value then
					--// scroll the sidebar so the selected tab is visible
					task.defer(function()
						if Tab:IsA("ScrollingFrame") and Tab.AbsoluteWindowSize.Y > 0 then
							local Top = Button.AbsolutePosition.Y - Tab.AbsolutePosition.Y + Tab.CanvasPosition.Y
							local Bottom = Top + Button.AbsoluteSize.Y + 6

							if Top < Tab.CanvasPosition.Y then
								Tween(Tab, .4, { CanvasPosition = Vector2.new(0, math.max(Top - 6, 0)) }, Smooth)
							elseif Bottom > Tab.CanvasPosition.Y + Tab.AbsoluteWindowSize.Y then
								Tween(Tab, .4, { CanvasPosition = Vector2.new(0, Bottom - Tab.AbsoluteWindowSize.Y) }, Smooth)
							end
						end
					end)

					Tween(Padding, .45, { PaddingLeft = UDim.new(0, 25) }, Smooth);
					Tween(Button, .45, { BackgroundTransparency = 0.9, Size = UDim2.new(1, -15, 0, 30) }, Smooth);
					SetProperty(Opened, { Value = true });
				elseif not SameName and Opened.Value then
					Tween(Padding, .4, { PaddingLeft = UDim.new(0, 20) }, Smooth);
					Tween(Button, .4, { BackgroundTransparency = 1, Size = UDim2.new(1, -44, 0, 30) }, Smooth);
					SetProperty(Opened, { Value = false });
				end
			end
		end

		for Index, Main in next, Holder:GetChildren() do
			if Main:IsA("CanvasGroup") then
				local Opened, SameName = Main.Value, (Main.Name == Name);
				local Scroll = Main:FindFirstChild("ScrollingFrame");

				if SameName and not Opened.Value then
					Opened.Value = true

					--// start slightly lower + transparent, then glide up into place
					if not Main.Visible then
						Main.GroupTransparency = 1
						Scroll["UIPadding"].PaddingTop = UDim.new(0, 12)
					end
					Main.Visible = true

					Tween(Main, .45, { GroupTransparency = 0 }, Smooth);
					Tween(Scroll["UIPadding"], .5, { PaddingTop = UDim.new(0, 5) }, Smooth);

				elseif not SameName and Opened.Value then
					Opened.Value = false

					Tween(Main, .18, { GroupTransparency = 1 }, SmoothIn);
					Tween(Scroll["UIPadding"], .2, { PaddingTop = UDim.new(0, 8) }, SmoothIn);

					task.delay(.2, function()
						--// only hide if the user did not switch back to this tab meanwhile (fixes flicker)
						if not Opened.Value then
							Main.Visible = false
						end
					end)
				end
			end
		end
	end

	local SectionStates = {} --// [SectionName] = { Opened = bool, Arrow = TextLabel }

	--// show / hide every tab button that belongs to a category
	local function PaintSection(Name: string, Animate: boolean?)
		local State = SectionStates[Name]
		if not State then return end

		for _, Info in next, StoredInfo["Tabs"] do
			if Info.Section == Name and Info[1] then
				Info[1].Visible = State.Opened
			end
		end

		if Animate then
			Tween(State.Arrow, .35, { Rotation = (State.Opened and 90) or 0 }, Smooth)
		else
			State.Arrow.Rotation = (State.Opened and 90) or 0
		end
	end

	--// Options:ToggleSection("Name", true/false/nil)
	function Options:ToggleSection(Name: string, Opened: boolean?)
		local State = SectionStates[Name]
		if not State then return end

		if Opened == nil then Opened = not State.Opened end
		State.Opened = Opened
		PaintSection(Name, true)
	end

	--// Category in the sidebar. The name is optional (like WindUI):
	--//   Window:AddTabSection({ Name = "Main", Order = 1 })    -> category with a title (+ arrow to open / close it)
	--//   Window:AddTabSection({ Order = 2 })                   -> no title: just a gap that separates groups of tabs
	--//   local Group = Window:AddTabSection({ Order = 2 })     -> use  Section = Group  in AddTab (or Section = Group.Name)
	--//   Divider = true  -> thin line on the category (works with or without a title);  default = no line
	local SectionCount = 0

	function Options:AddTabSection(Settings: { Name: string?, Title: string?, Order: number, Opened: boolean? })
		Settings = Settings or {}
		SectionCount = SectionCount + 1

		local Title = Settings.Title or Settings.Name
		local HasTitle = Title ~= nil and tostring(Title) ~= ""
		Title = HasTitle and tostring(Title) or ""

		local Key = Settings.Id or (HasTitle and Title) or ("__section" .. SectionCount)
		local Order = Settings.Order or SectionCount

		local Example = Examples["SectionExample"];
		local Section = Clone(Example);

		--// Divider = true draws a thin line (at the top of the category, or in the gap of a title-less one)
		--// Divider = false / nil: no line.     Group:SetDivider(true / false) changes it later.
		local Line
		local function SetDivider(On)
			if On and not Line then
				Line = Instance.new("Frame")
				SetProperty(Line, {
					Name = "SectionDivider",
					AnchorPoint = Vector2.new(.5, HasTitle and 0 or .5),
					Position = UDim2.new(.5, 0, HasTitle and 0 or .5, 0),
					Size = UDim2.new(1, -20, 0, 1),
					BackgroundColor3 = Theme.Outline,
					BackgroundTransparency = .65,
					BorderSizePixel = 0,
					ZIndex = Section.ZIndex + 1,
					Parent = Section,
				})
			elseif not On and Line then
				Line:Destroy()
				Line = nil
			end
		end

		table.insert(Custom, function() if Line then Line.BackgroundColor3 = Theme.Outline end end)

		StoredInfo["Sections"][Key] = Order
		SetProperty(Section, { 
			Parent = Example.Parent,
			Text = Title,
			Name = Key,
			LayoutOrder = Order,
			Visible = true
		});

		--// no title: a thin gap, no arrow, nothing to click (the tabs are always shown)
		if not HasTitle then
			Section.Size = UDim2.new(Section.Size.X.Scale, Section.Size.X.Offset, 0, 8)
			SectionStates[Key] = { Opened = true, Arrow = Instance.new("TextLabel") }
			SetDivider(Settings.Divider == true)

			return { Name = Key, Key = Key, Instance = Section, SetDivider = function(_, On) SetDivider(On) end }
		end

		--// arrow on the right side of the category title
		local Arrow = Instance.new("TextLabel")
		SetProperty(Arrow, {
			Name = "Arrow",
			AnchorPoint = Vector2.new(1, .5),
			Position = UDim2.new(1, -8, .5, 0),
			Size = UDim2.fromOffset(20, 20),
			BackgroundTransparency = 1,
			Text = "›",
			Font = Enum.Font.GothamBold,
			TextSize = 22,
			TextColor3 = Theme.Icon,
			ZIndex = Section.ZIndex + 1,
			Parent = Section,
		})

		--// the whole title row is the open / close button
		local Hit = Instance.new("TextButton")
		SetProperty(Hit, {
			Name = "Toggle",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			ZIndex = Section.ZIndex + 2,
			Parent = Section,
		})

		SectionStates[Key] = { Opened = Settings.Opened ~= false, Arrow = Arrow }
		PaintSection(Key, false)

		Connect(Hit.MouseButton1Click, function()
			Options:ToggleSection(Key)
		end)

		table.insert(Custom, function() Arrow.TextColor3 = Theme.Icon end)

		SetDivider(Settings.Divider == true)

		return { Name = Key, Key = Key, Instance = Section, SetDivider = function(_, On) SetDivider(On) end }
	end

	function Options:AddTab(Settings: { Title: string, Icon: string, Section: string? })
		if StoredInfo["Tabs"][Settings.Title] then 
			error("[UI LIB]: A tab with the same name has already been created") 
		end 

		if type(Settings.Section) == "table" then Settings.Section = Settings.Section.Key or Settings.Section.Name end

		local Example, MainExample = Examples["TabButtonExample"], Examples["MainExample"];
		local Section = StoredInfo["Sections"][Settings.Section];
		local Main = Clone(MainExample);
		local Tab = Clone(Example);

		if not Settings.Icon then
			Destroy(Tab["ICO"]);
		else
			SetProperty(Tab["ICO"], { Image = ResolveIcon(Settings.Icon) or Settings.Icon });
		end

		TabCount = TabCount + 1
		StoredInfo["Tabs"][Settings.Title] = { Tab, Order = TabCount, Section = Settings.Section }
		SetProperty(Tab["TextLabel"], { Text = Settings.Title });

		SetProperty(Main, { 
			Parent = MainExample.Parent,
			Name = Settings.Title;
		});

		SetProperty(Tab, { 
			Parent = Example.Parent,
			LayoutOrder = Section or #StoredInfo["Sections"] + 1,
			Name = Settings.Title;
			Visible = not (SectionStates[Settings.Section] and not SectionStates[Settings.Section].Opened);
		});

		LastTabOrder = Tab.LayoutOrder

		--// First run: open the first tab automatically (the one at the top of the sidebar).
		--// Deferred so every AddTab of the script has run; skipped if the script / user already picked a tab.
		task.defer(function()
			if TabChosen then return end

			local BestName, BestOrder, BestCreated
			for Name, Info in next, StoredInfo["Tabs"] do
				if not Info.Locked then
					local Order = Info[1].LayoutOrder

					if not BestName or Order < BestOrder or (Order == BestOrder and Info.Order < BestCreated) then
						BestName, BestOrder, BestCreated = Name, Order, Info.Order
					end
				end
			end

			if BestName then Options:SetTab(BestName) end
		end)

		--// smooth hover + press squish on the sidebar tab buttons
		do
			local Selected = Tab:FindFirstChild("Value")

			Tab.InputBegan:Connect(function(Input)
				if Input.UserInputType == Enum.UserInputType.MouseMovement and Selected and not Selected.Value then
					Tween(Tab, .3, { BackgroundTransparency = .94 }, Smooth)
				end
			end)

			Tab.InputEnded:Connect(function(Input)
				if Input.UserInputType == Enum.UserInputType.MouseMovement and Selected and not Selected.Value then
					Tween(Tab, .4, { BackgroundTransparency = 1 }, Smooth)
				end
			end)

		end

		Tab.MouseButton1Click:Connect(function()
			local Info = StoredInfo["Tabs"][Tab.Name]
			if Info and Info.Locked then return end --// LockTab

			Options:SetTab(Tab.Name);
		end)

		--// keep tab content clear of the top-right window controls (only in "Buttons" style)
		do
			local Scroll = Main.ScrollingFrame
			local Info = { Scroll = Scroll, Position = Scroll.Position, Size = Scroll.Size }

			table.insert(TabScrolls, Info)
			PlaceScroll(Info)
		end

		return Main.ScrollingFrame
	end
	
	--// Notifications
	
	function Options:Notify(Settings: { Title: string, Description: string, Duration: number }) 
		local Notification = Clone(Components["Notification"]);
		local Title, Description = Options:GetLabels(Notification);
		local Timer = Notification["Timer"];
		
		SetProperty(Title, { Text = Settings.Title });
		SetProperty(Description, { Text = Settings.Description or Settings.Content });
		SetProperty(Notification, {
			Parent = NotifyFrame or NotifyGui,
		})

		--// always above everything else (also when ZIndexBehavior is Global)
		Notification.ZIndex = 5000
		for _, Descendant in next, Notification:GetDescendants() do
			if Descendant:IsA("GuiObject") then Descendant.ZIndex = 5000 + math.min(Descendant.ZIndex, 50) end
		end
		
		task.spawn(function() 
			local Duration = Settings.Duration or 2
			local Wait = task.wait;
			
			Animations:Open(Notification, Setup.Transparency, true); Tween(Timer, Duration, { Size = UDim2.new(0, 0, 0, 4) });
			Wait(Duration);
			Animations:Close(Notification);
			Wait(1);
			Notification:Destroy();
		end)
	end

	--// Component Functions

	function Options:GetLabels(Component)
		local Labels = Component:FindFirstChild("Labels")

		return Labels.Title, Labels.Description
	end

	--// Puts an icon on the left or right edge of a row and keeps the labels clear of it (WindUI: Icon / IconAlign / InputIcon)
	local function SideIcon(Row, Icon, Left, Name)
		local Image = ResolveIcon(Icon) or Icon
		if type(Image) ~= "string" or Image == "" then return end

		local Pic = Instance.new("ImageLabel")
		SetProperty(Pic, {
			Name = Name or "ButtonIcon",
			AnchorPoint = Vector2.new(Left and 0 or 1, .5),
			Position = UDim2.new(Left and 0 or 1, Left and 12 or -12, .5, 0),
			Size = UDim2.fromOffset(18, 18),
			BackgroundTransparency = 1,
			Image = Image,
			ImageColor3 = Theme.Icon,
			Parent = Row,
		})

		if Left then
			local Labels = Row:FindFirstChild("Labels")

			if Labels then
				local Pad = Labels:FindFirstChildOfClass("UIPadding")

				if not Pad then
					Pad = Instance.new("UIPadding")
					Pad.Parent = Labels
				end

				Pad.PaddingLeft = UDim.new(0, Pad.PaddingLeft.Offset + 30)
			end
		end

		return Pic
	end

