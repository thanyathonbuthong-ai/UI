		Connect(Hit.MouseEnter, function()
			Tween(Inner, .25, { BackgroundColor3 = Color(Theme.Component, 5, Setup.ThemeMode) })
			Tween(Edge, .25, { Transparency = .25 })
		end)
		Connect(Hit.MouseLeave, function()
