	function Options:AddKeybind(Settings: { [string]: any }) 
		local Dropdown = Clone(Components["Keybind"]);
		local Title, Description = Options:GetLabels(Dropdown);
		local Bind = Dropdown["Main"].Options;
		
		local Mouse = { Enum.UserInputType.MouseButton1, Enum.UserInputType.MouseButton2, Enum.UserInputType.MouseButton3 }; 
		local Types = { 
			["Mouse"] = "Enum.UserInputType.MouseButton", 
			["Key"] = "Enum.KeyCode." 
		}

		local Current --// e.g. "G" or "MB2"

		--// Loads a saved / default bind from its name (does not wait for input)
		local function FromName(Name)
			Name = tostring(Name)
			local Number = Name:match("^MB(%d)$")

			if Number then
				return { UserInputType = Enum.UserInputType["MouseButton" .. Number], KeyCode = Enum.KeyCode.Unknown }
			end

			local Ok, Code = pcall(function() return Enum.KeyCode[Name] end)
			if Ok and Code then
				return { UserInputType = Enum.UserInputType.Keyboard, KeyCode = Code }
			end
		end
		
		Animations:Press(Dropdown, .975)

		Connect(Dropdown.MouseButton1Click, function()
			if Settings.CanChange == false then return end --// WindUI: CanChange = false -> key can't be rebound

			local Detect, Finished
			
			SetProperty(Bind, { Text = "..." });
			Detect = Connect(game.UserInputService.InputBegan, function(Key, Focused) 
				local InputType = (Key.UserInputType);
				
				if not Finished and not Focused then
					if table.find(Mouse, InputType) then
						Finished = true
						Current = (tostring(InputType):gsub(Types.Mouse, "MB"))
					elseif InputType == Enum.UserInputType.Keyboard then
						Finished = true
						Current = (tostring(Key.KeyCode):gsub(Types.Key, ""))
					end

					if Finished then
						Detect:Disconnect()
						SetProperty(Bind, { Text = Current });
						if Settings.Callback then Settings.Callback(Key) end
					end
				end 
			end)
		end)

		Animations:Component(Dropdown);
		SetProperty(Title, { Text = Settings.Title });
		SetProperty(Description, { Text = Settings.Description });
		SetProperty(Dropdown, {
			Name = Settings.Title,
			Parent = Settings.Tab,
			Visible = true,
		})

		local Object = { Instance = Dropdown }

		function Object:Get() return Current end
		function Object:Set(Name, Silent)
			local Fake = FromName(Name)

			if Fake then
				Current = tostring(Name)
				SetProperty(Bind, { Text = Current })
				if not Silent and Settings.Callback then Settings.Callback(Fake) end
			end
		end

		if Settings.Default or Settings.Value then
			Object:Set(Settings.Default or Settings.Value, true)
		end

		return Object
	end

	--// Dropdown
	--// Single : Callback(value)   -> tap the selected item again to un-select (Callback(nil))
	--// Multi  : Multi = true      -> Callback({ value1, value2, ... })  (empty list when nothing is selected)
	--// Nothing needs to be selected: AllowNone defaults to true (set AllowNone = false to force one choice)
	--// Nothing is selected at the start unless Default = "A" | { "A", "B" } is given
	--// Options may be a list { "A", "B" } or a dictionary { Name = value }; Placeholder = text shown when empty
	function Options:AddDropdown(Settings: { [string]: any }) 
		local Dropdown = Clone(Components["Dropdown"]);
		local Title, Description = Options:GetLabels(Dropdown);
		local Text = Dropdown["Main"].Options;

		local Multi = Settings.Multi == true
		local AllowNone = Settings.AllowNone ~= false
		local Empty = Settings.Placeholder or "None"
		local Entries, Chosen = {}, {} --// Chosen[Name] = true

		Settings.Options = Settings.Options or Settings.Values or {}

		--// Builds Entries from a list / dictionary.
		--// An entry may also be a table (WindUI style):
		--//   { Title = "A", Desc = "...", Icon = "rbxassetid://..", Value = any, Callback = function(v) end }
		--//   { Type = "Divider" }
		local function Build(List)
			Entries = {}

			local function Add(Name, Option)
				if type(Option) == "table" and Option.Type == "Divider" then
					table.insert(Entries, { Divider = true, Name = "__divider" .. (#Entries + 1) })
				elseif type(Option) == "table" and (Option.Title or Option.Name) then
					local Label_ = tostring(Option.Title or Option.Name)

					table.insert(Entries, {
						Name = Label_,
						Value = (Option.Value ~= nil and Option.Value) or Label_,
						Desc = Option.Desc or Option.Description,
						Icon = Option.Icon,
						Callback = Option.Callback,
						Locked = Option.Locked == true, --// WindUI: { Title = "..", Locked = true }
					})
				else
					table.insert(Entries, { Name = tostring(Name), Value = Option })
				end
			end

			--// Ordered list of entries (list -> keeps order, dictionary -> sorted by name)
			if #List > 0 then
				for _, Option in ipairs(List) do
					Add(Option, Option)
				end
			else
				local Sorted = {}

				for Name, Option in next, List do
					table.insert(Sorted, { Name = tostring(Name), Option = Option })
				end

				table.sort(Sorted, function(A, B) return A.Name < B.Name end)

				for _, Item in ipairs(Sorted) do
					Add(Item.Name, Item.Option)
				end
			end
		end

		Build(Settings.Options)

		local function Pick(Value)
			if Value == nil or Value == false or Value == "" then return nil end

			for _, Entry in ipairs(Entries) do
				if Entry.Value == Value or Entry.Name == tostring(Value) then
					return Entry
				end
			end

			--// WindUI: Value = 1  ->  the 1st item of the list (dividers are not counted)
			if type(Value) == "number" then
				local Count = 0

				for _, Entry in ipairs(Entries) do
					if not Entry.Divider then
						Count = Count + 1
						if Count == Value then return Entry end
					end
				end
			end
		end

		local function Selected() --// ordered list of chosen entries
			local List = {}

			for _, Entry in ipairs(Entries) do
				if Chosen[Entry.Name] then table.insert(List, Entry) end
			end

			return List
		end

		local function Values()
			local List = {}
			for _, Entry in ipairs(Selected()) do table.insert(List, Entry.Value) end
			return List
		end

		local function Refresh()
			local Names = {}
			for _, Entry in ipairs(Selected()) do table.insert(Names, Entry.Name) end

			Text.TextTruncate = Enum.TextTruncate.AtEnd
			Text.Text = (#Names > 0 and table.concat(Names, ", ")) or Empty
		end

		local function Fire()
			if not Settings.Callback then return end

			if Multi then
				Settings.Callback(Values())
			else
				local Entry = Selected()[1]
				Settings.Callback(Entry and Entry.Value)
			end
		end

		--// Applies a selection from outside / Default. Nil, false, "" or {} = select nothing.
		local function Apply(Value)
			Chosen = {}

			local List = (type(Value) == "table" and Value) or { Value }

			for _, Item in ipairs(List) do
				local Entry = Pick(Item)

				if Entry then
					Chosen[Entry.Name] = true
					if not Multi then break end
				end
			end

			Refresh()
		end

		Apply(Settings.Default ~= nil and Settings.Default or Settings.Value)

		local Opened --// the list that is currently open (nil = closed)
		local OpenedAt = 0

		--// Only counts a real tap: finger/mouse must not move (so scrolling the list
		--// never selects anything) and not within 0.3s after the list opened.
		local function OnTap(Button, Handler)
			local Start

			Connect(Button.InputBegan, function(Input)
				if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
					Start = Input.Position
				end
			end)

			Connect(Button.InputEnded, function(Input)
				if (Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch) and Start then
					local Moved = (Input.Position - Start).Magnitude
					Start = nil

					if Moved < 12 and (tick() - OpenedAt) > .3 then
						Handler()
					end
				end
			end)
		end

		local function CloseList()
			local Example = Opened
			if not Example then return end

			Opened = nil
			Tween(BG, .25, { BackgroundTransparency = 1 });

			task.spawn(function()
				Animations:Close(Example);
				task.wait(2)
				Destroy(Example);
			end)
		end

		Animations:Press(Dropdown, .975)

		Connect(Dropdown.MouseButton1Click, function()
			--// press again = close
			if Opened then
				CloseList()
				return
			end

			local Example = Clone(Examples["DropdownExample"]);
			local Buttons = Example["Top"]["Buttons"];
			Opened = Example
			OpenedAt = tick()

			Tween(BG, .25, { BackgroundTransparency = 0.6 });
			SetProperty(Example, { Parent = Window });
			Animations:Open(Example, 0, true)

			for _, Button in next, Buttons:GetChildren() do
				if Button:IsA("TextButton") then
					Animations:Component(Button, true)
					Connect(Button.MouseButton1Click, CloseList)
				end
			end

			local Repaint = {}

			local Sample = Examples["DropdownButtonExample"]
			local Rows = {} --// { Frame, Name, Divider } used by the search bar

			--// WindUI: SearchBarEnabled = true
			if Settings.SearchBarEnabled or Settings.Search then
				local Box = Instance.new("TextBox")
				SetProperty(Box, {
					Name = "!Search",
					LayoutOrder = -1,
					Size = UDim2.new(Sample.Size.X.Scale, Sample.Size.X.Offset, 0, 30),
					BackgroundColor3 = Theme.Interactables,
					BorderSizePixel = 0,
					ClearTextOnFocus = false,
					PlaceholderText = "Search...",
					PlaceholderColor3 = Theme.Description,
					Text = "",
					TextColor3 = Theme.Title,
					FontFace = Sample.Labels.Title.FontFace,
					TextSize = Sample.Labels.Title.TextSize,
					TextXAlignment = Enum.TextXAlignment.Left,
					Parent = Example.ScrollingFrame,
				})

				local Round = Instance.new("UICorner")
				Round.CornerRadius = UDim.new(0, 6)
				Round.Parent = Box

				local Pad = Instance.new("UIPadding")
				Pad.PaddingLeft = UDim.new(0, 12)
				Pad.Parent = Box

				Connect(Box:GetPropertyChangedSignal("Text"), function()
					local Query = Box.Text:lower()

					for _, Row in ipairs(Rows) do
						if Query == "" then
							Row.Frame.Visible = true
						elseif Row.Divider then
							Row.Frame.Visible = false
						else
							Row.Frame.Visible = Row.Name:lower():find(Query, 1, true) ~= nil
						end
					end
				end)
			end

			for Index, Entry in ipairs(Entries) do
				if Entry.Divider then
					local Line = Instance.new("Frame")
					SetProperty(Line, {
						Name = "Underline",
						LayoutOrder = Index,
						Size = UDim2.new(Sample.Size.X.Scale, Sample.Size.X.Offset, 0, 1),
						BackgroundColor3 = Theme.Outline,
						BorderSizePixel = 0,
						Parent = Example.ScrollingFrame,
					})
					table.insert(Rows, { Frame = Line, Divider = true })
					continue
				end

				local Name = Entry.Name
				local Button = Clone(Examples["DropdownButtonExample"]);
				local ItemTitle, ItemDescription = Options:GetLabels(Button);

				SetProperty(ItemTitle, { Text = Name });
				SetProperty(Button, { Parent = Example.ScrollingFrame, Visible = true, LayoutOrder = Index });
				table.insert(Rows, { Frame = Button, Name = Name })

				if Entry.Desc then
					SetProperty(ItemDescription, { Text = tostring(Entry.Desc) });
				else
					Destroy(ItemDescription);
				end

				if Entry.Icon and Entry.Icon ~= "" then
					local Pic = Instance.new("ImageLabel")
					SetProperty(Pic, {
						Name = "EntryIcon",
						AnchorPoint = Vector2.new(1, .5),
						Position = UDim2.new(1, -38, .5, 0),
						Size = UDim2.fromOffset(16, 16),
						BackgroundTransparency = 1,
						Image = Entry.Icon,
						ImageColor3 = Theme.Icon,
						Parent = Button,
					})
				end

				--// check mark on the right side of selected items
				local Mark = Instance.new("TextLabel")
				SetProperty(Mark, {
					Name = "Check",
					AnchorPoint = Vector2.new(1, .5),
					Position = UDim2.new(1, -12, .5, 0),
					Size = UDim2.fromOffset(18, 18),
					BackgroundTransparency = 1,
					Text = "✓",
					Font = Enum.Font.GothamBold,
					TextSize = 16,
					TextColor3 = Accent,
					Visible = false,
					Parent = Button,
				})

				--// accent bar on the left edge of the selected row (the "light" that shows what is chosen)
				local Bar = Instance.new("Frame")
				SetProperty(Bar, {
					Name = "SelectBar",
					AnchorPoint = Vector2.new(0, .5),
					Position = UDim2.new(0, 4, .5, 0),
					Size = UDim2.new(0, 3, .55, 0),
					BackgroundColor3 = Accent,
					BorderSizePixel = 0,
					Visible = false,
					Parent = Button,
				})

				local BarRound = Instance.new("UICorner")
				BarRound.CornerRadius = UDim.new(1, 0)
				BarRound.Parent = Bar

				--// the row's own transparency is the "off" state (the template rows may be fully transparent,
				--// in which case a colour change alone would never be visible)
				local OffAlpha = Button.BackgroundTransparency
				local Hovering = false

				local function Paint()
					local On = Chosen[Name] == true
					Mark.Visible = On
					Bar.Visible = On
					Mark.TextColor3 = Accent
					Bar.BackgroundColor3 = Accent

					if On then
						--// selected row: tinted with the accent colour
						Tween(Button, .2, { BackgroundColor3 = Accent, BackgroundTransparency = .8 });
					elseif Hovering then
						Tween(Button, .2, { BackgroundColor3 = Color(Theme.Component, 5, Setup.ThemeMode), BackgroundTransparency = math.min(OffAlpha, .85) });
					else
						Tween(Button, .2, { BackgroundColor3 = Theme.Component, BackgroundTransparency = OffAlpha });
					end
				end

				table.insert(Repaint, Paint)
				Paint()

				Connect(Button.InputBegan, function(Input)
					if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
						Hovering = true
						Paint()
					end
				end)

				Connect(Button.InputEnded, function(Input)
					if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
						Hovering = false
						Paint()
					end
				end)

				OnTap(Button, function()
					if Entry.Locked then return end --// locked items can't be changed

					if Multi then
						if Chosen[Name] then
							if not AllowNone and #Selected() <= 1 then return end
							Chosen[Name] = nil
						else
							Chosen[Name] = true
						end

						for _, Update in ipairs(Repaint) do Update() end
						Refresh()
						Fire()
						if Entry.Callback and Chosen[Name] then task.spawn(Entry.Callback, Entry.Value) end
					else
						if Chosen[Name] then
							if not AllowNone then CloseList() return end
							Chosen = {} --// tap again = select nothing
						else
							Chosen = { [Name] = true }
						end

						for _, Update in ipairs(Repaint) do Update() end
						Refresh()
						Fire()
						if Entry.Callback and Chosen[Name] then task.spawn(Entry.Callback, Entry.Value) end
						CloseList()
					end
				end)
			end
		end)

		Animations:Component(Dropdown);
		SetProperty(Title, { Text = Settings.Title });
		SetProperty(Description, { Text = Settings.Description });
		SetProperty(Dropdown, {
			Name = Settings.Title,
			Parent = Settings.Tab,
			Visible = true,
		})

		local Object = { Instance = Dropdown }

		function Object:Get()
			if Multi then return Values() end

			local Entry = Selected()[1]
			return Entry and Entry.Value
		end

		function Object:Set(Value, Silent)
			Apply(Value)
			if not Silent then Fire() end
		end

		function Object:Clear(Silent) Object:Set(nil, Silent) end

		function Object:Save()
			local Names = {}
			for _, Entry in ipairs(Selected()) do table.insert(Names, Entry.Name) end

			if Multi then return Names end
			return Names[1] or false
		end

		function Object:Load(Data) Object:Set(Data) end
		function Object:Select(Value, Silent) Object:Set(Value, Silent) end

		--// WindUI: Dropdown:Refresh(NewList)  (Keep = true keeps the current selection when it still exists)
		function Object:Refresh(List, Keep)
			local Old = Chosen

			Build(List or {})
			Chosen = {}

			if Keep then
				for _, Entry in ipairs(Entries) do
					if Old[Entry.Name] then Chosen[Entry.Name] = true end
				end
			end

			Refresh()
		end

		return Object
	end

