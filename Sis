	--// ------------------------------------------------------------------
	--// Image   (rbxassetid or http(s) url when the executor supports it)
	--// ------------------------------------------------------------------
	function Options:AddImage(Settings: { Image: string, AspectRatio: string?, Height: number?, Radius: number?, Tab: Instance })
		local Source = Settings.Image

		if type(Source) == "string" and Source:find("^https?://") and writefile and getcustomasset then
			local Ok, Result = pcall(function()
				local Hash = 0
				for Index = 1, #Source do
					Hash = (Hash * 31 + Source:byte(Index)) % 1000000007
				end

				local File = "uilib_img_" .. Hash .. ".png"
				if not (isfile and isfile(File)) then
					writefile(File, game:HttpGet(Source))
				end

				return getcustomasset(File)
			end)

			if Ok then Source = Result end
		end

		local Picture = Instance.new("ImageLabel")
		SetProperty(Picture, {
			Name = "Outline", --// harmless name: stops SetTheme from recolouring the picture
			Image = Source or "",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScaleType = Enum.ScaleType.Crop,
			Size = UDim2.new(RowWidth.Scale, RowWidth.Offset, 0, Settings.Height or 140),
			Parent = Settings.Tab,
		})
		Corner(Picture, Settings.Radius or 8)

		local Width, Height = (Settings.AspectRatio or ""):match("(%d+):(%d+)")
		if Width and Height then
			Picture.Size = UDim2.new(RowWidth.Scale, RowWidth.Offset, 0, 0)

			local Ratio = Instance.new("UIAspectRatioConstraint")
			Ratio.AspectRatio = tonumber(Width) / tonumber(Height)
			Ratio.DominantAxis = Enum.DominantAxis.Width
			Ratio.Parent = Picture
		end

		return Picture
	end

	--// ------------------------------------------------------------------
	--// Popup / Dialog
	--// Options:Popup({ Title, Content, Buttons = { { Title, Variant = "Primary"|"Tertiary", Callback } } })
	--// Multi-choice: Options:Popup({ Multi = true, Buttons = { { Title = "A", Selected = true }, { Title = "B" }, { Title = "OK", Variant = "Primary", Callback = function(Chosen) end } } })
	--// ------------------------------------------------------------------
	function Options:Popup(Settings: { Title: string, Content: string, Buttons: {} })
		Settings = Settings or {}

		local Sink = NewSink()
		local Panel = Instance.new("Frame")
		SetProperty(Panel, {
			Name = "PopupPanel",
			Active = true,
			AnchorPoint = Vector2.new(.5, .5),
			Position = UDim2.fromScale(.5, .5),
			Size = UDim2.fromOffset(300, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = Theme.Secondary,
			BorderSizePixel = 0,
			Parent = Sink,
		})
		Corner(Panel, 8)
		Stroke(Panel)

		local Pad = Instance.new("UIPadding")
		Pad.PaddingLeft, Pad.PaddingRight, Pad.PaddingTop, Pad.PaddingBottom = UDim.new(0, 14), UDim.new(0, 14), UDim.new(0, 14), UDim.new(0, 14)
		Pad.Parent = Panel

		local List = Instance.new("UIListLayout")
		List.SortOrder = Enum.SortOrder.LayoutOrder
		List.Padding = UDim.new(0, 8)
		List.Parent = Panel

		local PopupTitle = Label(Panel, "Title", Settings.Title or "", TitleRef, Theme.Title)
		SetProperty(PopupTitle, { Size = UDim2.new(1, 0, 0, 20), TextSize = TitleRef.TextSize + 2, LayoutOrder = 1 })

		local Content = Label(Panel, "Description", Settings.Content or Settings.Description or "", DescRef, Theme.Description)
		SetProperty(Content, {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			TextTruncate = Enum.TextTruncate.None,
			TextYAlignment = Enum.TextYAlignment.Top,
			LayoutOrder = 2,
		})

		local Object = {}
		function Object:Close() Destroy(Sink) end

		--// Multi-choice popup:
		--//   Options:Popup({ Title, Content, Multi = true, Buttons = {
		--//       { Title = "A", Selected = true, Callback = function(IsOn, Chosen) end },   --// option: toggles, popup stays open
		--//       { Title = "B" },
		--//       { Title = "OK", Variant = "Primary", Callback = function(Chosen) end },     --// Primary = confirm, closes
		--//   } })
		--//   Per button:  Select = true/false forces option / plain button,  Close = false keeps the popup open.
		--//   Object:GetSelected() -> { "A", "B" }
		local Choices = {} --// Choices[Index] = true when that option is on
		local Order = {}   --// { Index, Title } of every option, in order
		local Refreshers = {}

		function Object:GetSelected()
			local List = {}
			for _, Item in ipairs(Order) do
				if Choices[Item.Index] then table.insert(List, Item.Title) end
			end
			return List
		end

		for Index, Info in ipairs(Settings.Buttons or {}) do
			local Primary = Info.Variant == "Primary"
			local IsOption = Info.Select
			if IsOption == nil then IsOption = (Settings.Multi == true) and not Primary end

			local Button = Instance.new("TextButton")
			SetProperty(Button, {
				Name = Info.Title or "Button",
				LayoutOrder = 2 + Index,
				Size = UDim2.new(1, 0, 0, 32),
				BackgroundColor3 = (Primary and Accent) or Theme.Interactables,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = Info.Title or "",
				FontFace = TitleRef.FontFace,
				TextSize = 13,
				TextColor3 = (Primary and Color3.new(1, 1, 1)) or Theme.Title,
				Parent = Panel,
			})
			Corner(Button, 5)
			Animations:Press(Button, 0.95)

			if IsOption then
				Choices[Index] = Info.Selected == true
				table.insert(Order, { Index = Index, Title = Info.Title or "" })

				local Ring = Instance.new("UIStroke")
				SetProperty(Ring, { Name = "SelectRing", Color = Accent, Thickness = 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Enabled = false, Parent = Button })

				local Mark = Instance.new("TextLabel")
				SetProperty(Mark, {
					Name = "Check",
					AnchorPoint = Vector2.new(1, .5),
					Position = UDim2.new(1, -10, .5, 0),
					Size = UDim2.fromOffset(18, 18),
					BackgroundTransparency = 1,
					Text = "✓",
					Font = Enum.Font.GothamBold,
					TextSize = 16,
					TextColor3 = Accent,
					Visible = false,
					Parent = Button,
				})

				--// the light: the chosen option gets the accent colour + ring + check mark, the others stay plain
				local function Paint()
					local On = Choices[Index] == true
					Ring.Enabled = On
					Mark.Visible = On
					Tween(Button, .2, { BackgroundColor3 = On and Accent:Lerp(Theme.Interactables, .6) or Theme.Interactables })
				end

				table.insert(Refreshers, Paint)
				Paint()

				Connect(Button.MouseButton1Click, function()
					Choices[Index] = not Choices[Index]
					Paint()

					if Info.Callback then task.spawn(Info.Callback, Choices[Index], Object:GetSelected()) end
					if Info.Close == true then Object:Close() end
				end)
			else
				Connect(Button.MouseButton1Click, function()
					if Info.Callback then
						if Settings.Multi == true then Info.Callback(Object:GetSelected()) else Info.Callback() end
					end

					if Info.Close == false then return end

					--// let the press light be seen on the button that was chosen before the popup goes away
					task.delay(.12, function() Object:Close() end)
				end)
			end
		end

		Elevate(Sink, 99)
		Tween(Sink, .2, { BackgroundTransparency = .55 })

		return Object
	end


