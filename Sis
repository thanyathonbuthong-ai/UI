			return true
		end

		--// switch follows the window state, exactly like a Toggle (on = Theme.Toggle, white knob)
		local function Paint(Animate)
			local TrackColour = (Opened and Theme.Toggle) or Theme.Interactables
			local KnobColour = (Opened and Color3.fromRGB(255, 255, 255)) or Theme.Primary
			local KnobPosition = (Opened and UDim2.new(1, -17, .5, 0)) or UDim2.new(0, 3, .5, 0)

			if Animate then
				Tween(Switch, .2, { BackgroundColor3 = TrackColour })
				Tween(Knob, .2, { BackgroundColor3 = KnobColour, Position = KnobPosition })
			else
				Switch.BackgroundColor3 = TrackColour
				Knob.BackgroundColor3 = KnobColour
				Knob.Position = KnobPosition
			end
		end

		--// show / hide with the same pop animation as the window
		local Shown = false
		local function Refresh()
			local Want = Config.Enabled and (not Config.OnlyMobile or IsMobile()) and not (Config.HideWhenOpen and Opened)

			if Want and not Shown then
				Shown = true
				Root.Visible = true
				Scaler.Scale = Config.Scale * .9
				Tween(Root, .25, { GroupTransparency = 0 })
				Tween(Scaler, .25, { Scale = Config.Scale })
			elseif not Want and Shown then
				Shown = false
				Tween(Root, .2, { GroupTransparency = 1 })
				Tween(Scaler, .2, { Scale = Config.Scale * .9 })

				task.delay(.22, function()
					if not Shown then Root.Visible = false end
				end)
			end
		end

		--// keep the button inside the screen after a drag.
		--// The top limit reaches the real top edge of the screen (over the Roblox top bar area), so it can be dragged higher.
		local function Clamp()
			local View = Screen.AbsoluteSize
			local Size, Place = Root.AbsoluteSize, Root.AbsolutePosition
			local Inset = (Screen.IgnoreGuiInset and 0) or GuiService:GetGuiInset().Y
			local MinY = -Inset + 4
			local X = math.clamp(Place.X, 0, math.max(View.X - Size.X, 0))
			local Y = math.clamp(Place.Y, MinY, math.max(View.Y - Size.Y, MinY))

			if math.abs(X - Place.X) > .5 or math.abs(Y - Place.Y) > .5 then
				local Now = Root.Position
				Tween(Root, .2, { Position = UDim2.new(Now.X.Scale, Now.X.Offset + (X - Place.X), Now.Y.Scale, Now.Y.Offset + (Y - Place.Y)) })
			end
		end

		--// tap = toggle window, move finger / mouse = drag
		local Busy = false
		local function Press()
			if Busy then return end
			Busy = true
			task.delay(.4, function() Busy = false end)
			task.spawn(Close)
		end

		local Tracked, StartInput, StartPosition, Dragged

		Connect(Hit.InputBegan, function(Input)
			if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
				Tracked, StartInput, StartPosition, Dragged = Input, Input.Position, Root.Position, false
				Tween(Scaler, .1, { Scale = Config.Scale * .96 })

				local Ender
				Ender = Connect(Input.Changed, function()
					if Input.UserInputState == Enum.UserInputState.End then
						Ender:Disconnect()

						if Tracked == Input then
							Tracked = nil
							Tween(Scaler, .12, { Scale = Config.Scale })

							if Dragged then Clamp() else Press() end
						end
					end
				end)
			end
		end)

		Connect(Services.Input.InputChanged, function(Input)
			if not Tracked or not Config.Draggable then return end

			if Input == Tracked or Input.UserInputType == Enum.UserInputType.MouseMovement then
				local Delta = Vector2.new(Input.Position.X - StartInput.X, Input.Position.Y - StartInput.Y)

				if not Dragged and Delta.Magnitude < 8 then return end

				Dragged = true
				Root.Position = UDim2.new(StartPosition.X.Scale, StartPosition.X.Offset + Delta.X, StartPosition.Y.Scale, StartPosition.Y.Offset + Delta.Y)
			end
		end)

