		--// icon: Lucide name or image id.  Returns true when an icon is shown
		local function ApplyIcon()
			local Image, Themed = ResolveIcon(Config.Icon)

			if not Image then
				IconImage.Visible = false
				return false
			end

			if Config.IconThemed ~= nil then Themed = Config.IconThemed end

			IconImage.Image = Image
			IconImage:SetAttribute("NoTheme", not Themed)
			IconImage.ImageColor3 = (Themed and Theme.Icon) or Color3.new(1, 1, 1)
