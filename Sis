	  Keybind   : CanChange = false
	  Slider    : :SetMin(n) / :SetMax(n)
	  Paragraph : Buttons = { { Title, Icon, Color, Callback }, ... }
	  Section   : Title alias, TextXAlignment, returns object (:SetTitle / :Destroy)

