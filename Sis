	--// ------------------------------------------------------------------
	function Options:AddThemeEditor(Settings)
		Settings = Settings or {}

		local Tab = Settings.Tab
		assert(Tab, "[UI LIB]: AddThemeEditor needs a Tab")

		local Keys = {
			{ "Accent", "สีหลักของเมนู" },
			{ "Background", "พื้นหลังหน้าต่าง" },
			{ "Dialog", "พื้นหลังช่อง / กล่อง" },
			{ "Text", "สีข้อความ" },
			{ "Placeholder", "สีข้อความรอง" },
			{ "Button", "สีปุ่ม" },
			{ "Icon", "สีไอคอน" },
			{ "Toggle", "สีสวิตช์ Toggle" },
			{ "Slider", "สีแถบ Slider" },
			{ "Checkbox", "สีช่องติ๊ก" },
