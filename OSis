		BorderSizePixel = 0,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Position = UDim2.new(1, -24, 0, 8),
		Size = UDim2.new(0, 14, 0, 94),
		Parent = panel,
	})
	local keys = {}
	for i = 0, 6 do
		table.insert(keys, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 1, 1)))
	end
	Create("UIGradient", { Rotation = 90, Color = ColorSequence.new(keys), Parent = hue })
	local hueKnob = Create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.new(1, 0, 0, 3),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = hue,
	})
	Create("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1, Parent = hueKnob })

