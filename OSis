		txt.TextColor3 = on and Theme.Dark or Theme.SubText
		txt.Position = on and UDim2.new(0, 6, 0, 0) or UDim2.new(0, 22, 0, 0)
	end

	function Toggle:Set(v, silent)
		Toggle.Value = v and true or false
