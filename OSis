-- Paragraph
function Controls:AddParagraph(o)
	o = o or {}
	local Paragraph = {}
	local row = MakeRow(self.Container, 40)
	row.AutomaticSize = Enum.AutomaticSize.Y
	row.Size = UDim2.new(1, 0, 0, 40)
	NextOrder(self, row)
	local body = Create("Frame", {
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0),
		ZIndex = 2,
		Parent = row,
	})
	ListLayout(body, 3)
	Pad(body, 22, 8, 12, 8)
	local title = Text(body, {
		Text = o.Title or "Paragraph",
		Font = Enum.Font.GothamBold,
		TextSize = Metrics.Font,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 14),
		TextWrapped = true,
		LayoutOrder = 1,
	})
	local content = Text(body, {
		Text = o.Content or "",
		Font = Enum.Font.Gotham,
		TextSize = Metrics.Small,
		TextColor3 = Theme.SubText,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 12),
		TextWrapped = true,
		LayoutOrder = 2,
	})
	function Paragraph:Set(t, c)
		if t then title.Text = t end
		if c then content.Text = c end
	end
	return Paragraph
end

-- Button
function Controls:AddButton(o)
	o = o or {}
	-- ปุ่มสไตล์อื่น (Primary / Outline / Danger / Success / Warning / Ghost) เต็มความกว้าง
	if o.Style and o.Style ~= "Default" then
		local Button = {}
		local B = MakeButton(self.Container, { Text = o.Name or "Button", Style = o.Style, Icon = o.Icon })
		NextOrder(self, B.Button)
		B.Button.MouseButton1Click:Connect(function()
			SafeCall(o.Callback)
		end)
		function Button:SetText(t)
			B.Label.Text = t
		end
		function Button:Fire()
			SafeCall(o.Callback)
		end
		return Button
	end
	local Button = {}
	local hasDesc = o.Description ~= nil and o.Description ~= ""
	local row, hit = MakeRow(self.Container, hasDesc and (Metrics.Row + 12) or Metrics.Row)
	NextOrder(self, row)
	local lbl = Text(row, {
		Text = o.Name or "Button",
		Position = UDim2.new(0, 22, 0, hasDesc and 5 or 0),
		Size = hasDesc and UDim2.new(1, -60, 0, 16) or UDim2.new(1, -60, 1, 0),
		ZIndex = 2,
	})
	if hasDesc then
		Text(row, {
			Text = o.Description,
			Font = Enum.Font.Gotham,
			TextSize = Metrics.Tiny,
			TextColor3 = Theme.SubText,
			Position = UDim2.new(0, 22, 0, 23),
			Size = UDim2.new(1, -60, 0, 12),
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 2,
		})
	end
	local chev = BuildIcon(row, "chevron_right", Theme.SubText, 14)
	chev.Frame.AnchorPoint = Vector2.new(1, 0.5)
	chev.Frame.Position = UDim2.new(1, -14, 0.5, 0)
	chev.Frame.ZIndex = 2
	hit.MouseButton1Click:Connect(function()
		Tween(row, 0.08, { BackgroundColor3 = Color3.fromRGB(55, 55, 55) })
		task.delay(0.1, function()
			Tween(row, 0.2, { BackgroundColor3 = Theme.RowHover })
		end)
		SafeCall(o.Callback)
	end)
	function Button:SetText(t)
		lbl.Text = t
	end
	function Button:Fire()
		SafeCall(o.Callback)
	end
	return Button
end

-- Toggle
function Controls:AddToggle(o)
	o = o or {}
	local Toggle = { Value = o.Default == true }
	local row, hit = MakeRow(self.Container, Metrics.Row)
	NextOrder(self, row)
	Text(row, {
		Text = o.Name or "Toggle",
		Position = UDim2.new(0, 22, 0, 0),
		Size = UDim2.new(1, -90, 1, 0),
		ZIndex = 2,
	})
	local sw = Create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.new(0, 50, 0, 20),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = row,
	})
	local txt = Text(sw, {
		Text = "OFF",
		Font = Enum.Font.Code,
		TextSize = Metrics.Tiny,
		TextColor3 = Theme.SubText,
		Size = UDim2.new(0, 26, 1, 0),
		Position = UDim2.new(0, 22, 0, 0),
		ZIndex = 3,
	})
	local knob = Create("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.new(0, 14, 0, 14),
		BackgroundColor3 = Color3.fromRGB(170, 170, 170),
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = sw,
	})

	local function render()
		local on = Toggle.Value
		Tween(sw, 0.15, { BackgroundTransparency = on and 0 or 1 })
		Tween(knob, 0.15, {
