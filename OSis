	end
	SetFlag(o, Seg.Value)
	paint()
	return Seg
end

-- Stepper (ปุ่ม - / + ปรับตัวเลข)
function Controls:AddStepper(o)
	o = o or {}
	local min, max, step = o.Min or 0, o.Max or 100, o.Step or 1
	local dec = Decimals(step)
	local Stepper = { Value = math.clamp(o.Default or min, min, max) }
	local row = MakeRow(self.Container, Metrics.Row)
	NextOrder(self, row)
	Text(row, {
		Text = o.Name or "Stepper",
		Position = UDim2.new(0, 22, 0, 0),
		Size = UDim2.new(1, -140, 1, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 2,
	})
	local holder = Create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(100, 22),
		BackgroundColor3 = Theme.Input,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = row,
	})
	local valLabel = Text(holder, {
		Font = Enum.Font.Code,
		TextSize = Metrics.Small,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.new(0, 26, 0, 0),
		Size = UDim2.new(1, -52, 1, 0),
		ZIndex = 3,
	})
	local function StepBtn(iconName, side)
		local b = Create("TextButton", {
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = Theme.TabActive,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = side == "L" and UDim2.new(0, 0, 0, 0) or UDim2.new(1, -26, 0, 0),
			Size = UDim2.new(0, 26, 1, 0),
			ZIndex = 3,
			Parent = holder,
		})
		local ic = BuildIcon(b, iconName, Theme.SubText, 10)
		ic.Frame.Position = UDim2.new(0.5, -5, 0.5, -5)
		b.MouseEnter:Connect(function()
			Tween(b, 0.1, { BackgroundTransparency = 0 })
			ic.SetColor(Theme.Accent)
		end)
		b.MouseLeave:Connect(function()
			Tween(b, 0.1, { BackgroundTransparency = 1 })
			ic.SetColor(Theme.SubText)
		end)
		return b
	end
	local minus, plus = StepBtn("minus", "L"), StepBtn("plus", "R")

	local function render()
		valLabel.Text = string.format("%." .. dec .. "f", Stepper.Value) .. (o.Suffix or "")
	end
	function Stepper:Set(v, silent)
		v = math.clamp(v, min, max)
		v = tonumber(string.format("%." .. dec .. "f", math.floor(v / step + 0.5) * step))
		local changed = v ~= Stepper.Value
		Stepper.Value = v
		SetFlag(o, v)
		render()
		if changed and not silent then
			SafeCall(o.Callback, v)
		end
	end
	function Stepper:Get()
		return Stepper.Value
	end
	minus.MouseButton1Click:Connect(function()
		Stepper:Set(Stepper.Value - step)
	end)
	plus.MouseButton1Click:Connect(function()
		Stepper:Set(Stepper.Value + step)
	end)
	SetFlag(o, Stepper.Value)
	render()
	return Stepper
end

-- Progress bar (แสดงความคืบหน้า)
function Controls:AddProgress(o)
	o = o or {}
	local min, max = o.Min or 0, o.Max or 100
	local Progress = { Value = math.clamp(o.Default or min, min, max) }
	local row = MakeRow(self.Container, Metrics.Row + 8)
	NextOrder(self, row)
	Text(row, {
		Text = o.Name or "Progress",
		Position = UDim2.new(0, 22, 0, 2),
		Size = UDim2.new(0.6, -22, 0, Metrics.Row - 6),
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 2,
	})
	local valLabel = Text(row, {
		Font = Enum.Font.Code,
		TextSize = Metrics.Small,
		TextColor3 = Theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 2),
		Size = UDim2.new(0.4, 0, 0, Metrics.Row - 6),
		ZIndex = 2,
	})
	local track = Create("Frame", {
		BackgroundColor3 = Theme.Input,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 22, 1, -12),
		Size = UDim2.new(1, -36, 0, 4),
		ZIndex = 2,
		Parent = row,
	})
	local fill = Create("Frame", {
		BackgroundColor3 = o.Color or Theme.Accent,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 0, 1, 0),
		ZIndex = 3,
		Parent = track,
	})
	local function render(animate)
		local a = (Progress.Value - min) / math.max(max - min, 1e-9)
		a = math.clamp(a, 0, 1)
		if animate then
			Tween(fill, 0.25, { Size = UDim2.new(a, 0, 1, 0) })
		else
			fill.Size = UDim2.new(a, 0, 1, 0)
		end
		valLabel.Text = o.Format and o.Format(Progress.Value) or (tostring(math.floor(a * 100 + 0.5)) .. "%")
	end
	function Progress:Set(v)
		Progress.Value = math.clamp(v, min, max)
		SetFlag(o, Progress.Value)
		render(true)
	end
	function Progress:Get()
		return Progress.Value
	end
	SetFlag(o, Progress.Value)
	render(false)
	return Progress
end

