	local listening = false

	local row, hit = MakeRow(self.Container, Metrics.Row)
	NextOrder(self, row)
	Text(row, {
		Text = o.Name or "Keybind",
		Position = UDim2.new(0, 22, 0, 0),
		Size = UDim2.new(1, -130, 1, 0),
		ZIndex = 2,
	})
	local box = Create("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Input,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.new(0, 86, 0, 22),
		Font = Enum.Font.Code,
		TextSize = Metrics.Small,
		TextColor3 = Theme.Text,
		Text = "",
		ZIndex = 3,
		Parent = row,
	})

	local function render()
		box.Text = listening and "..." or (Keybind.Value and Keybind.Value.Name or "None")
	end

	function Keybind:Set(key, silent)
		Keybind.Value = key
		SetFlag(o, key)
		if o.UIToggle and window then
			window.ToggleKey = key
		end
		render()
		if not silent then
			SafeCall(o.ChangedCallback, key)
		end
	end
	function Keybind:Get()
		return Keybind.Value
	end

	local function startListen()
		listening = true
		render()
	end
	box.MouseButton1Click:Connect(startListen)
	hit.MouseButton1Click:Connect(startListen)

	local conn = UserInputService.InputBegan:Connect(function(input, gp)
		if listening then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				listening = false
				if input.KeyCode == Enum.KeyCode.Escape then
					Keybind:Set(nil)
				else
					Keybind:Set(input.KeyCode)
				end
			end
			return
		end
		if gp or o.UIToggle then
			return
		end
		if Keybind.Value and input.KeyCode == Keybind.Value then
			SafeCall(o.Callback, Keybind.Value)
		end
	end)
	if window then
		table.insert(window._conns, conn)
	end

	if o.UIToggle and window and o.Default then
		window.ToggleKey = o.Default
	end
	SetFlag(o, Keybind.Value)
	render()
	return Keybind
end

