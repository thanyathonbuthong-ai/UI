			ZIndex = 3,
			Parent = box,
		})
		b.MouseButton1Click:Connect(function()
			Seg:Set(opt)
		end)
		buttons[opt] = b
	end
	function Seg:Set(v, silent)
		Seg.Value = v
		SetFlag(o, v)
		paint()
		if not silent then
			SafeCall(o.Callback, v)
		end
	end
	function Seg:Get()
