		h, s, v = Color3.toHSV(color)
		render()
		ColorPicker.Value = color
		SetFlag(o, color)
		if not silent then
			SafeCall(o.Callback, color)
		end
	end
	function ColorPicker:Get()
		return ColorPicker.Value
	end
	ColorPicker.Value = Color3.fromHSV(h, s, v)
	SetFlag(o, ColorPicker.Value)
	render()
	return ColorPicker
end

-- Dialog (หน้าต่างยืนยัน/ป็อปอัป)
-- Library:Dialog({ Title=, Content=, Buttons = { {Text="OK", Primary=true, Callback=fn}, {Text="Cancel"} } })
function Library:Dialog(o)
	o = o or {}
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local gui = Create("ScreenGui", {
		Name = "SKT_Dialog",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 1001,
		Parent = GetParent(),
	})
	local dim = Create("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, 0),
		Parent = gui,
	})
	Tween(dim, 0.2, { BackgroundTransparency = 0.45 })
	local box = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0, math.min(300, vp.X - 40), 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Background,
		BorderSizePixel = 0,
		Parent = dim,
	})
	Create("UIStroke", { Color = Theme.Border, Thickness = 1, Parent = box })
	ListLayout(box, 8)
	Pad(box, 14, 12, 14, 14)
	Text(box, {
		Text = o.Title or "Dialog",
		Font = Enum.Font.GothamBold,
		TextSize = Metrics.Head,
		TextWrapped = true,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 18),
		LayoutOrder = 1,
	})
	if o.Content and o.Content ~= "" then
		Text(box, {
			Text = o.Content,
			Font = Enum.Font.Gotham,
			TextColor3 = Theme.SubText,
			TextWrapped = true,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(1, 0, 0, 14),
			LayoutOrder = 2,
		})
	end
	local btnRow = Create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 28),
		LayoutOrder = 3,
		Parent = box,
	})

	local Dialog = {}
	function Dialog:Close()
		if not gui.Parent then
			return
		end
		local t = Tween(dim, 0.15, { BackgroundTransparency = 1 })
		box.Visible = false
		t.Completed:Connect(function()
			gui:Destroy()
		end)
	end

	local buttons = o.Buttons or { { Text = "OK", Primary = true } }
	local n = #buttons
	for i, b in ipairs(buttons) do
		local primary = b.Primary == true
		local btn = Create("TextButton", {
			Text = b.Text or "OK",
			AutoButtonColor = false,
			Font = Enum.Font.GothamMedium,
			TextSize = Metrics.Font,
			TextColor3 = primary and Theme.Dark or Theme.Text,
			BackgroundColor3 = primary and Theme.Accent or Theme.Row,
			BorderSizePixel = 0,
			Position = UDim2.new((i - 1) / n, i > 1 and 3 or 0, 0, 0),
			Size = UDim2.new(1 / n, i == 1 and -3 or (i == n and -3 or -6), 1, 0),
			Parent = btnRow,
		})
		if not primary then
			-- สไตล์เดียวกับแถวของ UI: แถบซ้าย + เส้นขาวสไลด์ตอน hover
			Create("Frame", {
				BackgroundColor3 = Theme.Edge,
				BorderSizePixel = 0,
				Size = UDim2.new(0, 2, 1, 0),
				Parent = btn,
			})
			local ul = Create("Frame", {
				BackgroundColor3 = Theme.Accent,
				BorderSizePixel = 0,
				AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.new(0, 0, 1, 0),
				Size = UDim2.new(0, 0, 0, 1),
				Parent = btn,
			})
			btn.MouseEnter:Connect(function()
				Tween(btn, 0.15, { BackgroundColor3 = Theme.RowHover })
				Tween(ul, 0.3, { Size = UDim2.new(1, 0, 0, 1) })
			end)
			btn.MouseLeave:Connect(function()
				Tween(btn, 0.15, { BackgroundColor3 = Theme.Row })
				Tween(ul, 0.2, { Size = UDim2.new(0, 0, 0, 1) })
			end)
		else
			btn.MouseEnter:Connect(function()
				Tween(btn, 0.15, { BackgroundColor3 = Color3.fromRGB(215, 215, 215) })
			end)
			btn.MouseLeave:Connect(function()
				Tween(btn, 0.15, { BackgroundColor3 = Theme.Accent })
			end)
		end
		btn.MouseButton1Click:Connect(function()
			Dialog:Close()
			SafeCall(b.Callback)
		end)
	end
	return Dialog
end

