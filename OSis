-- Dropdown
function Controls:AddDropdown(o)
	o = o or {}
	local Dropdown = { Options = o.Options or {}, Multi = o.Multi == true }
	local selected = {}
	local buttons = {}

	local outer = Create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = self.Container,
	})
	ListLayout(outer, 2)
	NextOrder(self, outer)

	local row, hit = MakeRow(outer, Metrics.Row)
	row.LayoutOrder = 1
	Text(row, {
		Text = o.Name or "Dropdown",
		Size = UDim2.new(0.4, -22, 1, 0),
		Position = UDim2.new(0, 22, 0, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 2,
	})
	local box = Create("Frame", {
		BackgroundColor3 = Theme.Input,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0.42, 0, 0.5, 0),
		Size = UDim2.new(0.58, -10, 1, -10),
		ZIndex = 2,
		Parent = row,
	})
	local valueLabel = Text(box, {
		Font = Enum.Font.Code,
		TextSize = Metrics.Small,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.new(0, 12, 0, 0),
		Size = UDim2.new(1, -24, 1, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 3,
	})

	local holder = Create("Frame", {
		BackgroundColor3 = Theme.Input,
		BorderSizePixel = 0,
		Visible = false,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 2,
		Parent = outer,
	})
	ListLayout(holder, 0)

	local function list()
		local out = {}
		for _, opt in ipairs(Dropdown.Options) do
			if selected[opt] then
				table.insert(out, opt)
			end
		end
		return out
	end

	local function paint()
		for opt, b in pairs(buttons) do
			local on = selected[opt]
			b.TextColor3 = on and Theme.Accent or Theme.SubText
			b.BackgroundTransparency = on and 0 or 1
		end
		if Dropdown.Multi then
			local l = list()
			local names = {}
			for _, v in ipairs(l) do
				table.insert(names, tostring(v))
			end
			valueLabel.Text = #names > 0 and table.concat(names, ", ") or "None"
		else
			local l = list()
			valueLabel.Text = l[1] ~= nil and tostring(l[1]) or "None"
		end
	end

	local function fire()
		local v
		if Dropdown.Multi then
			v = list()
		else
			v = list()[1]
		end
		Dropdown.Value = v
		SetFlag(o, v)
		SafeCall(o.Callback, v)
	end

	local function build()
		for _, b in pairs(buttons) do
			b:Destroy()
		end
		table.clear(buttons)
		for i, opt in ipairs(Dropdown.Options) do
			local b = Create("TextButton", {
				Text = tostring(opt),
				AutoButtonColor = false,
				Font = Enum.Font.Code,
				TextSize = Metrics.Small,
				TextColor3 = Theme.SubText,
				BackgroundColor3 = Theme.TabActive,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, Metrics.Opt),
				LayoutOrder = i,
				Parent = holder,
			})
			b.MouseButton1Click:Connect(function()
				if Dropdown.Multi then
					selected[opt] = not selected[opt] or nil
				else
					selected = { [opt] = true }
					holder.Visible = false
				end
				paint()
				fire()
			end)
			buttons[opt] = b
		end
		paint()
	end

	function Dropdown:Set(v, silent)
		selected = {}
		if Dropdown.Multi then
			for _, x in ipairs(type(v) == "table" and v or { v }) do
				selected[x] = true
			end
		elseif v ~= nil then
			selected[v] = true
		end
		paint()
		if not silent then
			fire()
		else
			SetFlag(o, Dropdown.Multi and list() or list()[1])
		end
	end
	function Dropdown:Get()
		return Dropdown.Multi and list() or list()[1]
	end
	function Dropdown:Refresh(options, keep)
		Dropdown.Options = options or {}
		if not keep then
			selected = {}
		end
		build()
	end

	hit.MouseButton1Click:Connect(function()
		holder.Visible = not holder.Visible
	end)

	if o.Default ~= nil then
		if Dropdown.Multi then
			for _, x in ipairs(type(o.Default) == "table" and o.Default or { o.Default }) do
				selected[x] = true
			end
		else
			selected[o.Default] = true
		end
	elseif not Dropdown.Multi and Dropdown.Options[1] ~= nil then
		selected[Dropdown.Options[1]] = true
	end
	build()
	Dropdown.Value = Dropdown:Get()
	SetFlag(o, Dropdown.Value)
	return Dropdown
end

-- Slider
function Controls:AddSlider(o)
	o = o or {}
	local min, max, step = o.Min or 0, o.Max or 100, o.Step or 1
	local suffix = o.Suffix or ""
	local decimals = tostring(step):match("%.(%d+)")
	decimals = decimals and #decimals or 0
	local Slider = { Value = math.clamp(o.Default or min, min, max) }

	local row = MakeRow(self.Container, Metrics.Row)
	NextOrder(self, row)
	local valLabel = Text(row, {
		Font = Enum.Font.Code,
		TextSize = Metrics.Small,
		TextColor3 = Theme.SubText,
		Position = UDim2.new(0, 14, 0, 0),
		Size = UDim2.new(0, Metrics.ValW, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 2,
	})
	Text(row, {
		Text = o.Name or "Slider",
		Position = UDim2.new(0, Metrics.NameX, 0, 0),
		Size = UDim2.new(1 - Metrics.Track, -(Metrics.NameX + 18), 1, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 2,
	})
	local track = Create("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.new(Metrics.Track, 0, 0, 20),
		BackgroundColor3 = Theme.Input,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = row,
	})
	local fill = Create("Frame", {
		BackgroundColor3 = Theme.Accent,
		BackgroundTransparency = 0.88,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 0, 1, 0),
		ZIndex = 2,
		Parent = track,
	})
	for i = 0, 16 do
		Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(i / 16, 0, 0.5, 0),
			Size = UDim2.new(0, 1, 0, 6),
			BackgroundColor3 = Color3.fromRGB(70, 70, 70),
			BorderSizePixel = 0,
			ZIndex = 3,
			Parent = track,
		})
	end
	local thumb = Create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.new(0, 3, 1, 0),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		ZIndex = 4,
		Parent = track,
	})

	local function render()
		local a = (Slider.Value - min) / (max - min)
		a = math.clamp(a, 0, 1)
		thumb.Position = UDim2.new(a, 0, 0, 0)
		fill.Size = UDim2.new(a, 0, 1, 0)
		valLabel.Text = tostring(Slider.Value) .. suffix
	end

	function Slider:Set(v, silent)
		v = math.clamp(v, min, max)
		v = math.floor(v / step + 0.5) * step
		v = tonumber(string.format("%." .. decimals .. "f", v))
		v = math.clamp(v, min, max)
		local changed = v ~= Slider.Value
		Slider.Value = v
		SetFlag(o, v)
		render()
		if changed and not silent then
			SafeCall(o.Callback, v)
		end
	end
	function Slider:Get()
		return Slider.Value
	end

	local sliding = false
	local lockedSf
	local function update(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		Slider:Set(min + (max - min) * a)
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			lockedSf = track:FindFirstAncestorOfClass("ScrollingFrame")
			if lockedSf then
				lockedSf.ScrollingEnabled = false
			end
			update(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = false
			if lockedSf then
				lockedSf.ScrollingEnabled = true
				lockedSf = nil
			end
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			update(input.Position.X)
		end
	end)

	SetFlag(o, Slider.Value)
	render()
	return Slider
end

