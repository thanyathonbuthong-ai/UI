---------------------------------------------------------------------
local function IsPointer(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end
local function IsMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
end

-- ลากบน frame แล้วส่งตำแหน่งเมาส์/นิ้ว (ล็อกการเลื่อนหน้าไว้ระหว่างลาก)
local function MakeDrag(frame, onMove)
	local active, lockedSf = false, nil
	frame.InputBegan:Connect(function(input)
		if IsPointer(input) then
			active = true
			lockedSf = frame:FindFirstAncestorOfClass("ScrollingFrame")
			if lockedSf then
				lockedSf.ScrollingEnabled = false
			end
			onMove(input.Position.X, input.Position.Y)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if active and IsPointer(input) then
			active = false
			if lockedSf then
				lockedSf.ScrollingEnabled = true
				lockedSf = nil
			end
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if active and IsMove(input) then
			onMove(input.Position.X, input.Position.Y)
		end
	end)
end

local function Decimals(step)
	local d = tostring(step):match("%.(%d+)")
	return d and #d or 0
end

