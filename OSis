			b.BackgroundTransparency = on and 0 or 1
			b.TextColor3 = on and Theme.Dark or Theme.SubText
		end
	end
	for i, opt in ipairs(Seg.Options) do
		local b = Create("TextButton", {
			Text = tostring(opt),
			AutoButtonColor = false,
			Font = Enum.Font.Code,
