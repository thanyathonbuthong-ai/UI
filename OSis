-- ToggleButton (ปุ่มกดค้าง เปิด/ปิด)
function Controls:AddToggleButton(o)
	o = o or {}
	local Toggle = { Value = o.Default == true }
	local B = MakeButton(self.Container, { Text = o.Name or "Toggle", Style = "Default", Icon = o.Icon })
	NextOrder(self, B.Button)
	B.Label.TextXAlignment = Enum.TextXAlignment.Left
	B.Label.Position = UDim2.new(0, o.Icon and 30 or 22, 0, 0)
	B.Label.Size = UDim2.new(1, -90, 1, 0)
	local state = Text(B.Button, {
		Font = Enum.Font.Code,
		TextSize = Metrics.Tiny,
		TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 0),
		Size = UDim2.new(0, 40, 1, 0),
		ZIndex = 4,
	})
	local function render()
		local on = Toggle.Value
		B.Lock = on
		Tween(B.Button, 0.15, { BackgroundColor3 = on and Theme.Accent or Theme.Row })
		local c = on and Theme.Dark or Theme.Text
		B.Label.TextColor3 = c
		state.TextColor3 = on and Theme.Dark or Theme.SubText
		state.Text = on and "ON" or "OFF"
		if B.Icon then
			B.Icon.SetColor(c)
		end
		B.Edge.Visible = not on
		B.Underline.Size = UDim2.new(0, 0, 0, 1)
	end
	function Toggle:Set(v, silent)
		Toggle.Value = v and true or false
		SetFlag(o, Toggle.Value)
		render()
		if not silent then
			SafeCall(o.Callback, Toggle.Value)
		end
	end
	function Toggle:Get()
		return Toggle.Value
	end
	B.Button.MouseButton1Click:Connect(function()
		Toggle:Set(not Toggle.Value)
	end)
	SetFlag(o, Toggle.Value)
	render()
	return Toggle
end

-- ConfirmButton (กดครั้งแรกให้ยืนยัน กดซ้ำอีกครั้งเพื่อทำงานจริง)
function Controls:AddConfirmButton(o)
	o = o or {}
	local name = o.Name or "Confirm"
	local B = MakeButton(self.Container, { Text = name, Style = o.Style or "Danger", Icon = o.Icon })
	NextOrder(self, B.Button)
	local timeout = o.Timeout or 3
	local armed, token = false, 0
	local function reset()
		armed = false
		token += 1
		B.Fill.Size = UDim2.new(0, 0, 1, 0)
		B.Label.Text = name
	end
	B.Button.MouseButton1Click:Connect(function()
		if not armed then
			armed = true
			token += 1
			local my = token
			B.Label.Text = o.ConfirmText or "Tap again to confirm"
			B.Fill.Size = UDim2.new(1, 0, 1, 0)
			TweenService:Create(B.Fill, TweenInfo.new(timeout, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 1, 0) }):Play()
			task.delay(timeout, function()
				if armed and token == my then
					reset()
				end
			end)
		else
			reset()
			SafeCall(o.Callback)
		end
	end)
	return { SetText = function(_, t) name = t B.Label.Text = t end }
end

-- HoldButton (กดค้างจนเต็มถึงจะทำงาน)
function Controls:AddHoldButton(o)
	o = o or {}
	local dur = o.Duration or 1
	local B = MakeButton(self.Container, { Text = o.Name or "Hold", Style = o.Style or "Danger", Icon = o.Icon })
	NextOrder(self, B.Button)
	local holding, tw, id = false, nil, 0
	B.Button.InputBegan:Connect(function(input)
		if IsPointer(input) and not holding then
			holding = true
			id += 1
			local my = id
			B.Fill.Size = UDim2.new(0, 0, 1, 0)
			tw = TweenService:Create(B.Fill, TweenInfo.new(dur, Enum.EasingStyle.Linear), { Size = UDim2.new(1, 0, 1, 0) })
			tw.Completed:Connect(function(playbackState)
				if playbackState == Enum.PlaybackState.Completed and holding and id == my then
					holding = false
					B.Fill.Size = UDim2.new(0, 0, 1, 0)
					SafeCall(o.Callback)
				end
			end)
			tw:Play()
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if holding and IsPointer(input) then
			holding = false
			id += 1
			if tw then
				tw:Cancel()
			end
			Tween(B.Fill, 0.15, { Size = UDim2.new(0, 0, 1, 0) })
		end
	end)
	return {}
end

-- CooldownButton (กดแล้วต้องรอคูลดาวน์ก่อนกดซ้ำได้)
function Controls:AddCooldownButton(o)
	o = o or {}
	local name = o.Name or "Cooldown"
	local cd = o.Cooldown or 5
	local B = MakeButton(self.Container, { Text = name, Style = o.Style or "Default", Icon = o.Icon })
	NextOrder(self, B.Button)
	local busy = false
	B.Button.MouseButton1Click:Connect(function()
		if busy then
			return
		end
		busy = true
		B.Lock = true
		SafeCall(o.Callback)
		B.Fill.Size = UDim2.new(1, 0, 1, 0)
		TweenService:Create(B.Fill, TweenInfo.new(cd, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 1, 0) }):Play()
		B.Label.TextColor3 = Theme.SubText
		task.spawn(function()
			local t0 = os.clock()
			while true do
				local left = cd - (os.clock() - t0)
				if left <= 0 then
					break
				end
				B.Label.Text = string.format("%s (%ds)", name, math.ceil(left))
				task.wait(0.1)
			end
			B.Label.Text = name
			B.Label.TextColor3 = B.Style.Text
			B.Lock = false
			busy = false
			Tween(B.Button, 0.15, { BackgroundColor3 = B.Style.Bg or B.Style.Hover })
		end)
	end)
	return {}
end

local function Mixin(obj)
	for k, v in pairs(Controls) do
		obj[k] = v
	end
end

