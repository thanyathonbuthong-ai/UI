		TextWrapped = true,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 14),
		LayoutOrder = 1,
	})
	if o.Content and o.Content ~= "" then
		Text(body, {
			Text = o.Content,
			Font = Enum.Font.Gotham,
			TextSize = Metrics.Font,
			TextColor3 = Theme.SubText,
			TextWrapped = true,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(1, 0, 0, 12),
			LayoutOrder = 2,
		})
	end
	local bar = Create("Frame", {
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 2),
		ZIndex = 2,
		Parent = inner,
	})

	Tween(inner, 0.3, { Position = UDim2.new(0, 0, 0, 0) })
	TweenService:Create(bar, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 2) }):Play()

	task.delay(duration, function()
		if inner.Parent then
			local t = Tween(inner, 0.3, { Position = UDim2.new(1, 320, 0, 0) })
			t.Completed:Wait()
			wrapper:Destroy()
		end
	end)
end

