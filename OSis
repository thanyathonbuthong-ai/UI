-- ไอคอนระบบ (ปุ่ม Close / Minimize / ลูกศร) วาดด้วย Frame
-- primitives:  {"L",x1,y1,x2,y2} เส้น | {"C",cx,cy,r} วงกลมเส้นขอบ
--              {"R",x,y,w,h,corner} สี่เหลี่ยมเส้นขอบ | {"D",cx,cy,r} จุดทึบ
-- พิกัดอยู่บนกริด 16x16
---------------------------------------------------------------------
local function Poly(points, closed)
	local out = {}
	for i = 1, #points - 1 do
		table.insert(out, { "L", points[i][1], points[i][2], points[i + 1][1], points[i + 1][2] })
	end
	if closed then
		local a, b = points[#points], points[1]
		table.insert(out, { "L", a[1], a[2], b[1], b[2] })
	end
	return out
end

