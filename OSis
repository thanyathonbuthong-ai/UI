-- Button styles (ปุ่มหลายสไตล์ ในโทนของ UI)
-- Style: Default | Primary | Outline | Danger | Success | Warning | Ghost
---------------------------------------------------------------------
local ButtonStyles = {
	Default = { Bg = Theme.Row, Hover = Theme.RowHover, Text = Theme.Text, Edge = Theme.Edge, Underline = true },
	Primary = { Bg = Theme.Accent, Hover = Color3.fromRGB(215, 215, 215), Text = Theme.Dark },
	Outline = { Bg = Theme.Background, Hover = Theme.RowHover, Text = Theme.Text, Stroke = Color3.fromRGB(110, 110, 110) },
	Danger = { Bg = Theme.Row, Hover = Color3.fromRGB(36, 16, 16), Text = Theme.Error, Edge = Theme.Error },
	Success = { Bg = Theme.Row, Hover = Color3.fromRGB(14, 32, 20), Text = Theme.Success, Edge = Theme.Success },
	Warning = { Bg = Theme.Row, Hover = Color3.fromRGB(36, 28, 10), Text = Theme.Warning, Edge = Theme.Warning },
	Ghost = { Hover = Theme.Row, Text = Theme.SubText, HoverText = Theme.Accent },
}
Library.ButtonStyles = ButtonStyles

local function MakeButton(parent, o)
	local st = ButtonStyles[o.Style or "Default"] or ButtonStyles.Default
	local B = { Style = st, Lock = false }
	local btn = Create("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = st.Bg or st.Hover,
		BackgroundTransparency = st.Bg and 0 or 1,
		BorderSizePixel = 0,
		Size = o.Size or UDim2.new(1, 0, 0, Metrics.Row),
		Parent = parent,
	})
	B.Button = btn
	B.Fill = Create("Frame", {
		BackgroundColor3 = st.Text,
		BackgroundTransparency = 0.85,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 0, 1, 0),
		ZIndex = 2,
		Parent = btn,
	})
	if st.Edge then
		B.Edge = Create("Frame", {
			BackgroundColor3 = st.Edge,
			BorderSizePixel = 0,
			Size = UDim2.new(0, 2, 1, 0),
			ZIndex = 3,
			Parent = btn,
		})
	end
	if st.Stroke then
		Create("UIStroke", { Color = st.Stroke, Thickness = 1, Parent = btn })
	end
	if st.Underline then
		B.Underline = Create("Frame", {
			BackgroundColor3 = Theme.Accent,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, 0),
			Size = UDim2.new(0, 0, 0, 1),
			ZIndex = 3,
			Parent = btn,
		})
	end
	B.Label = Text(btn, {
		Text = o.Text or "Button",
		Font = Enum.Font.GothamMedium,
		TextColor3 = st.Text,
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.new(0, 14, 0, 0),
		Size = UDim2.new(1, -28, 1, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 4,
	})
	if o.Icon then
		B.Icon = BuildIcon(btn, o.Icon, st.Text, 12)
		B.Icon.Frame.Position = UDim2.new(0, 12, 0.5, -6)
		B.Icon.Frame.ZIndex = 4
	end

	btn.MouseEnter:Connect(function()
		if B.Lock then
			return
		end
		Tween(btn, 0.15, { BackgroundTransparency = 0, BackgroundColor3 = st.Hover })
		if st.HoverText then
			Tween(B.Label, 0.15, { TextColor3 = st.HoverText })
		end
		if B.Underline then
			Tween(B.Underline, 0.3, { Size = UDim2.new(1, 0, 0, 1) })
		end
	end)
	btn.MouseLeave:Connect(function()
		if B.Lock then
			return
		end
		Tween(btn, 0.15, { BackgroundTransparency = st.Bg and 0 or 1, BackgroundColor3 = st.Bg or st.Hover })
		if st.HoverText then
			Tween(B.Label, 0.15, { TextColor3 = st.Text })
		end
		if B.Underline then
			Tween(B.Underline, 0.2, { Size = UDim2.new(0, 0, 0, 1) })
		end
	end)
	return B
end

local Controls = {}

-- Divider  "— Yen Transfer —"
function Controls:AddDivider(text)
	local lbl = Text(self.Container, {
		Text = text and ("— " .. text .. " —") or "",
		TextSize = Metrics.Small,
		TextColor3 = Theme.SubText,
		Size = UDim2.new(1, 0, 0, 30),
	})
	NextOrder(self, lbl)
	return lbl
end

-- Label
function Controls:AddLabel(text)
	local Label = {}
	local lbl = Text(self.Container, {
		Text = text or "Label",
		TextSize = Metrics.Font,
		TextColor3 = Theme.SubText,
		TextWrapped = true,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 22),
	})
	Pad(lbl, 8, 0, 0, 0)
	NextOrder(self, lbl)
	function Label:SetText(t)
		lbl.Text = t
	end
	return Label
