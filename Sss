--[[
    NOSSX HUB UI Library
    สำหรับสร้าง UI Hub ใน Roblox ตามรูปแบบของ NOSSX HUB
    ใช้ได้กับ LocalScript หรือ Script ที่อยู่ใน StarterPlayer > StarterCharacterScripts
]]

local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local NossxUI = {}
NossxUI.__index = NossxUI

-- สีที่ใช้ในการสร้าง UI
local COLORS = {
    DarkRed = Color3.fromRGB(57, 12, 12),
    BrightRed = Color3.fromRGB(255, 50, 50),
    White = Color3.fromRGB(255, 255, 255),
    DarkGray = Color3.fromRGB(50, 50, 50),
    Green = Color3.fromRGB(34, 200, 100),
    Black = Color3.fromRGB(0, 0, 0),
    Gold = Color3.fromRGB(255, 215, 0),
}

-- ฟังก์ชันสร้าง Hub UI
function NossxUI.new(title, version)
    local self = setmetatable({}, NossxUI)
    
    self.title = title or "NOSSX HUB"
    self.version = version or "v2.8"
    self.isOpen = true
    self.isDragging = false
    self.dragStart = Vector2.new(0, 0)
    self.toggleOptions = {}
    self.menuButtons = {}
    self.currentSelectedMenu = nil
    
    self:CreateMainUI()
    
    return self
end

-- สร้าง Main UI Container
function NossxUI:CreateMainUI()
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")
    
    -- Main Screen GUI
    self.ScreenGui = Instance.new("ScreenGui")
    self.ScreenGui.Name = "NossxHubUI"
    self.ScreenGui.ResetOnSpawn = false
    self.ScreenGui.Parent = playerGui
    
    -- Main Frame
    self.MainFrame = Instance.new("Frame")
    self.MainFrame.Name = "MainFrame"
    self.MainFrame.Size = UDim2.new(0, 600, 0, 500)
    self.MainFrame.Position = UDim2.new(0.5, -300, 0.5, -250)
    self.MainFrame.BackgroundColor3 = COLORS.DarkRed
    self.MainFrame.BorderSizePixel = 0
    self.MainFrame.Parent = self.ScreenGui
    
    -- Corner Radius
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = self.MainFrame
    
    -- Title Bar
    self:CreateTitleBar()
    
    -- Left Sidebar
    self:CreateLeftSidebar()
    
    -- Right Settings Panel
    self:CreateSettingsPanel()
    
    -- Close button
    self:CreateCloseButton()
    
    -- Make draggable
    self:MakeDraggable()
end

-- สร้าง Title Bar
function NossxUI:CreateTitleBar()
    local titleBar = Instance.new("Frame")
    titleBar.Name = "TitleBar"
    titleBar.Size = UDim2.new(1, 0, 0, 50)
    titleBar.BackgroundColor3 = COLORS.DarkRed
    titleBar.BorderSizePixel = 0
    titleBar.Parent = self.MainFrame
    
    -- Title Text
    local titleText = Instance.new("TextLabel")
    titleText.Name = "TitleText"
    titleText.Size = UDim2.new(0, 200, 1, 0)
    titleText.Position = UDim2.new(0, 10, 0, 0)
    titleText.BackgroundTransparency = 1
    titleText.TextColor3 = COLORS.BrightRed
    titleText.TextSize = 24
    titleText.Font = Enum.Font.GothamBold
    titleText.Text = self.title
    titleText.TextXAlignment = Enum.TextXAlignment.Left
    titleText.Parent = titleBar
    
    -- Version Text
    local versionText = Instance.new("TextLabel")
    versionText.Name = "VersionText"
    versionText.Size = UDim2.new(0, 60, 1, 0)
    versionText.Position = UDim2.new(0, 10, 0, 25)
    versionText.BackgroundTransparency = 1
    versionText.TextColor3 = COLORS.BrightRed
    versionText.TextSize = 12
    versionText.Font = Enum.Font.Gotham
    versionText.Text = self.version
    versionText.TextXAlignment = Enum.TextXAlignment.Left
    versionText.Parent = titleBar
    
    -- Info Panel (Ping, FPS)
    local infoFrame = Instance.new("Frame")
    infoFrame.Name = "InfoPanel"
    infoFrame.Size = UDim2.new(0, 150, 1, 0)
    infoFrame.Position = UDim2.new(1, -160, 0, 0)
    infoFrame.BackgroundTransparency = 1
    infoFrame.Parent = titleBar
    
    local pingText = Instance.new("TextLabel")
    pingText.Name = "PingText"
    pingText.Size = UDim2.new(0.5, 0, 1, 0)
    pingText.Position = UDim2.new(0, 0, 0, 0)
    pingText.BackgroundTransparency = 1
    pingText.TextColor3 = COLORS.White
    pingText.TextSize = 12
    pingText.Font = Enum.Font.Gotham
    pingText.Text = "Ping: 81ms"
    pingText.Parent = infoFrame
    
    local fpsText = Instance.new("TextLabel")
    fpsText.Name = "FpsText"
    fpsText.Size = UDim2.new(0.5, 0, 1, 0)
    fpsText.Position = UDim2.new(0.5, 0, 0, 0)
    fpsText.BackgroundTransparency = 1
    fpsText.TextColor3 = COLORS.White
    fpsText.TextSize = 12
    fpsText.Font = Enum.Font.Gotham
    fpsText.Text = "FPS: 41"
    fpsText.Parent = infoFrame
    
    -- Update FPS every frame
    local lastUpdate = tick()
    local frameCount = 0
    RunService.RenderStepped:Connect(function()
        frameCount = frameCount + 1
        local currentTime = tick()
        if currentTime - lastUpdate >= 1 then
            local fps = frameCount
            fpsText.Text = "FPS: " .. fps
            frameCount = 0
            lastUpdate = currentTime
        end
    end)
    
    self.TitleBar = titleBar
end

-- สร้าง Left Sidebar
function NossxUI:CreateLeftSidebar()
    local sidebar = Instance.new("Frame")
    sidebar.Name = "Sidebar"
    sidebar.Size = UDim2.new(0, 120, 1, -50)
    sidebar.Position = UDim2.new(0, 0, 0, 50)
    sidebar.BackgroundColor3 = COLORS.DarkRed
    sidebar.BorderSizePixel = 1
    sidebar.BorderColor3 = COLORS.BrightRed
    sidebar.Parent = self.MainFrame
    
    -- Menu Items
    local menuItems = {
        {icon = "●", name = "Info", color = COLORS.BrightRed},
        {icon = "⚡", name = "Main", color = COLORS.BrightRed},
        {icon = "📍", name = "Teleport", color = COLORS.BrightRed},
        {icon = "🎁", name = "Bonus", color = COLORS.BrightRed},
    }
    
    for i, item in ipairs(menuItems) do
        self:CreateMenuButton(sidebar, item.name, item.icon, (i-1) * 50, i)
    end
    
    -- User Profile
    self:CreateUserProfile(sidebar)
    
    self.Sidebar = sidebar
end

-- สร้าง Menu Button
function NossxUI:CreateMenuButton(parent, name, icon, offsetY, index)
    local button = Instance.new("TextButton")
    button.Name = name .. "Button"
    button.Size = UDim2.new(1, -2, 0, 45)
    button.Position = UDim2.new(0, 1, 0, offsetY + 10)
    button.BackgroundColor3 = COLORS.DarkRed
    button.BackgroundTransparency = 0.3
    button.TextColor3 = COLORS.BrightRed
    button.TextSize = 12
    button.Font = Enum.Font.Gotham
    button.Text = icon .. " " .. name
    button.BorderSizePixel = 0
    button.Parent = parent
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 5)
    corner.Parent = button
    
    button.MouseButton1Click:Connect(function()
        self.currentSelectedMenu = name
        -- ส่ง callback ไปว่าเลือกเมนูไหน
        if self.onMenuSelected then
            self.onMenuSelected(name)
        end
    end)
    
    button.MouseEnter:Connect(function()
        button.BackgroundTransparency = 0.1
    end)
    
    button.MouseLeave:Connect(function()
        button.BackgroundTransparency = 0.3
    end)
    
    table.insert(self.menuButtons, {button = button, name = name})
end

