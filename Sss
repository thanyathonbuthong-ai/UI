-- สร้าง Settings Panel
function NossxUI:CreateSettingsPanel()
    local settingsPanel = Instance.new("ScrollingFrame")
    settingsPanel.Name = "SettingsPanel"
    settingsPanel.Size = UDim2.new(1, -130, 1, -50)
    settingsPanel.Position = UDim2.new(0, 125, 0, 50)
    settingsPanel.BackgroundColor3 = COLORS.DarkRed
    settingsPanel.BorderSizePixel = 0
    settingsPanel.ScrollBarThickness = 8
    settingsPanel.ScrollBarImageColor3 = COLORS.BrightRed
    settingsPanel.CanvasSize = UDim2.new(1, 0, 0, 0)
    settingsPanel.Parent = self.MainFrame
    
    -- List Layout
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 5)
    layout.Parent = settingsPanel
    
    -- Update canvas size
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        settingsPanel.CanvasSize = UDim2.new(1, 0, 0, layout.AbsoluteContentSize.Y + 10)
    end)
    
    self.SettingsPanel = settingsPanel
    self.SettingsLayout = layout
end

-- Add Toggle Option
function NossxUI:AddToggle(name, defaultState, callback)
    local toggleOption = Instance.new("Frame")
    toggleOption.Name = name .. "Toggle"
    toggleOption.Size = UDim2.new(1, 0, 0, 40)
    toggleOption.BackgroundTransparency = 1
    toggleOption.Parent = self.SettingsPanel
    
    -- Label
    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.Size = UDim2.new(0.7, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = COLORS.White
    label.TextSize = 14
    label.Font = Enum.Font.Gotham
    label.Text = name
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = toggleOption
    
    -- Toggle Button
    local toggleButton = Instance.new("TextButton")
    toggleButton.Name = "ToggleButton"
    toggleButton.Size = UDim2.new(0, 40, 0, 20)
    toggleButton.Position = UDim2.new(1, -45, 0.5, -10)
    toggleButton.BackgroundColor3 = defaultState and COLORS.Green or COLORS.DarkGray
    toggleButton.TextTransparency = 1
    toggleButton.BorderSizePixel = 0
    toggleButton.Parent = toggleOption
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = toggleButton
    
    -- Circle indicator
    local circle = Instance.new("Frame")
    circle.Name = "Circle"
    circle.Size = UDim2.new(0, 16, 0, 16)
    circle.Position = defaultState and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)
    circle.BackgroundColor3 = COLORS.White
    circle.BorderSizePixel = 0
    circle.Parent = toggleButton
    
    local circleCorner = Instance.new("UICorner")
    circleCorner.CornerRadius = UDim.new(0, 8)
    circleCorner.Parent = circle
    
    local state = defaultState
    
    toggleButton.MouseButton1Click:Connect(function()
        state = not state
        
        -- Animate
        toggleButton.BackgroundColor3 = state and COLORS.Green or COLORS.DarkGray
        
        local tweenInfo = TweenInfo.new(0.2)
        local tween = game:GetService("TweenService"):Create(
            circle,
            tweenInfo,
            {Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8)}
        )
        tween:Play()
        
        if callback then
            callback(state)
        end
    end)
    
    table.insert(self.toggleOptions, {name = name, button = toggleButton, state = state})
    
    return toggleButton
end

-- Make GUI draggable
function NossxUI:MakeDraggable()
    local dragging = false
    local dragInput = nil
    local dragStart = nil
    local startPos = nil
    
    self.TitleBar.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = self.MainFrame.Position
            dragInput = input
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input, gameProcessed)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            self.MainFrame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input, gameProcessed)
        if input == dragInput then
            dragging = false
        end
    end)
end

-- Create Close Button
function NossxUI:CreateCloseButton()
    local closeButton = Instance.new("TextButton")
    closeButton.Name = "CloseButton"
    closeButton.Size = UDim2.new(0, 25, 0, 25)
    closeButton.Position = UDim2.new(1, -30, 0, 5)
    closeButton.BackgroundColor3 = COLORS.BrightRed
    closeButton.TextColor3 = COLORS.White
    closeButton.TextSize = 16
    closeButton.Font = Enum.Font.GothamBold
    closeButton.Text = "×"
    closeButton.BorderSizePixel = 0
    closeButton.Parent = self.MainFrame
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 5)
    corner.Parent = closeButton
    
    closeButton.MouseButton1Click:Connect(function()
        self:Close()
    end)
end

-- Close the UI
function NossxUI:Close()
    self.ScreenGui:Destroy()
end

-- Toggle visibility
function NossxUI:ToggleVisibility()
    self.MainFrame.Visible = not self.MainFrame.Visible
end

-- Get toggle state
function NossxUI:GetToggleState(name)
    for _, toggle in ipairs(self.toggleOptions) do
        if toggle.name == name then
            return toggle.state
        end
    end
    return nil
end

-- Set menu selected callback
function NossxUI:OnMenuSelected(callback)
    self.onMenuSelected = callback
end

return NossxUI
