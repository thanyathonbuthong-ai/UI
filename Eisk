        TextSize = textsize.Normal,
        Size = UDim2.new(1, -(boxW + s.PadX * 2 + 6), 0, s.NameH),
        ZIndex = 1,
        Parent = frame
    })

    -- แตะที่ไหนของแถวก็เปิด/ปิดรายการได้
    local rowBtn = CreateInstance("TextButton", {
        Name = "RowButton",
        Text = "",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        ZIndex = 1,
        Parent = frame
    })

    local selectedDisplay = CreateInstance("Frame", {
        Name = "SelectedDisplay",
        BackgroundColor3 = c.Secondary,
        BackgroundTransparency = 0.04,
        Position = UDim2.new(1, boxX, 0, dd.BoxY),
        BorderSizePixel = 0,
        Size = UDim2.new(0, boxW, 0, dd.BoxH),
        ZIndex = 2,
        Parent = frame
    })
