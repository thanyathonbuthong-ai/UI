function Library:SetTheme(presetName)
    local theme = ThemePresets[presetName]
    if not theme then
        self:Notify({ Title = "Error", Description = "Unknown theme: " .. tostring(presetName), Duration = 2 })
        return
    end
    
    for key, value in pairs(theme) do
        c[key] = value
    end
    
    -- Recursively recolor every element in the GUI
    local function recolor(parent)
        for _, child in ipairs(parent:GetChildren()) do
            if child:IsA("Frame") then
                if child.Name == "Container" then
                    CreateTween(child, { BackgroundColor3 = c.Background }, animationspeed.Normal)
                elseif child.Name == "Header" or child.Name == "Separator" or child.Name == "Line" or child.Name == "LineLeft" or child.Name == "LineRight" then
                    child.BackgroundColor3 = c.Border
                elseif child.Name == "Dot" then
                    -- skip dots, they have custom colors
                elseif child.BackgroundTransparency < 0.5 and child.BackgroundColor3 ~= Color3.new(0,0,0) then
                    CreateTween(child, { BackgroundColor3 = c.Secondary }, animationspeed.Normal)
                end
            elseif child:IsA("TextLabel") then
                if child.Name == "TabText" or child.Name == "Label" or child.Name == "DividerText" then
                    CreateTween(child, { TextColor3 = c.TextDark }, animationspeed.Normal)
                elseif child.Name == "Name" or child.Name == "Title" then
                    CreateTween(child, { TextColor3 = c.Text }, animationspeed.Normal)
                elseif child.Name == "Value" or child.Name == "Description" or child.Name == "Content" then
                    -- skip custom-colored values
                end
            elseif child:IsA("TextBox") then
                CreateTween(child, { TextColor3 = c.Text, PlaceholderColor3 = c.TextDark }, animationspeed.Normal)
            elseif child:IsA("ImageLabel") or child:IsA("ImageButton") then
                if child.Name == "Icon" or child.Name == "Arrow" or child.Name == "Hamburger" then
                    CreateTween(child, { ImageColor3 = c.TextDark }, animationspeed.Normal)
                end
            elseif child:IsA("UIStroke") then
                child.Color = c.Border
            elseif child:IsA("ScrollingFrame") then
                -- recurse into scrolling frames
            end
            recolor(child)
        end
    end
    
    if self.screenGui then
        recolor(self.screenGui)
    end
    
    -- Update title specifically
    if self.titleLabel then
        CreateTween(self.titleLabel, { TextColor3 = c.Text }, animationspeed.Normal)
    end
    
    -- Update current tab highlight
    if self.currentTab and self.currentTab.textLabel then
        self.currentTab.textLabel.TextColor3 = c.Text
    end
    if self.currentTab and self.currentTab.icon then
        self.currentTab.icon.ImageColor3 = c.Text
    end
    
    self:Notify({
        Title = "Theme Applied",
        Description = presetName,
        Duration = 2
    })
end

function Library:GetThemeNames()
    local names = {}
    for name in pairs(ThemePresets) do
        table.insert(names, name)
    end
    table.sort(names)
    return names
end

function Library:SetBackgroundImage(imageId, transparency)
    transparency = transparency or 0.3
    
    if self._bgImage then
        self._bgImage:Destroy()
        self._bgImage = nil
    end
    
    if not imageId or imageId == "" then
        -- Restore original container opacity
        if self.container then
            CreateTween(self.container, { BackgroundTransparency = 0.05 }, animationspeed.Normal)
        end
        self._bgImageUrl = nil
        return
    end
    
    -- Resolve the image source
    local resolvedImage = imageId
    
    -- If it's a web URL (not rbxassetid), download and convert via executor asset system
    if imageId:match("^https?://") then
        local success, result = pcall(function()
            -- Download image data
            local imageData = game:HttpGet(imageId)
            
            -- Generate a unique temp filename
            local fileName = "AcrylicBG_" .. tostring(math.random(100000, 999999)) .. ".png"
            
            -- Save to filesystem
            if writefile then
                writefile(fileName, imageData)
            end
            
            -- Convert to usable asset via executor functions
            if getcustomasset then
                return getcustomasset(fileName)
            elseif getsynasset then
                return getsynasset(fileName)
            else
                return imageId
            end
        end)
        
        if success and result then
            resolvedImage = result
        else
            resolvedImage = imageId
        end
    end
    
    -- Make container background more transparent so image shows through
    if self.container then
        CreateTween(self.container, { BackgroundTransparency = 0.6 }, animationspeed.Normal)
    end
    
    self._bgImage = CreateInstance("ImageLabel", {
        Name = "BackgroundImage",
        Image = resolvedImage,
        ImageTransparency = transparency,
        ScaleType = Enum.ScaleType.Crop,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Position = UDim2.new(0, 0, 0, 0),
        ZIndex = 0,
        Parent = self.container
    })
    CreateCorner(self._bgImage, 5)
    
    -- Store the original URL for opacity changes
    self._bgImageUrl = imageId
end

function Library:_SetupMobileSupport()
    local size = IS_MOBILE and 40 or 50
    local mobileButton = CreateInstance("ImageButton", {
        Name = "MobileToggle",
        Image = "rbxassetid://112235310154264",
        ImageColor3 = c.Text,
        BackgroundColor3 = c.Background,
        BackgroundTransparency = IS_MOBILE and 0.25 or 0.1,
        Position = UDim2.new(0, 10, 0.5, -size / 2),
        Size = UDim2.new(0, size, 0, size),
        AnchorPoint = Vector2.new(0, 0),
        Visible = false,
        ZIndex = 999,
        Parent = self.screenGui
    })
    CreateCorner(mobileButton, size / 2)
    CreateStroke(mobileButton)

    local dragging = false
    local moved = false
    local dragStart, startPos

    mobileButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = mobileButton.Position
        end
    end)

    -- ปล่อยนิ้วที่ไหนก็ได้ ถ้าไม่ได้ลาก = แตะ -> เปิด/ซ่อนหน้าต่าง
    Connections["mobile_toggle_ended"] = ui.InputEnded:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) then
            dragging = false
            if not moved then
                self:Toggle()
            end
        end
    end)

    Connections["mobile_toggle_changed"] = ui.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
            local delta = input.Position - dragStart
            if delta.Magnitude >= 10 then
                moved = true
            end
            if moved then
                local nx = startPos.X.Offset + delta.X
                local ny = startPos.Y.Offset + delta.Y
                local cam = workspace.CurrentCamera
                if cam then
                    -- กันปุ่มหลุดนอกจอ
                    local vp = cam.ViewportSize
                    local sz = mobileButton.AbsoluteSize
                    local baseX = startPos.X.Scale * vp.X
                    local baseY = startPos.Y.Scale * vp.Y
                    nx = math.clamp(nx, -baseX, math.max(vp.X - sz.X - baseX, -baseX))
                    ny = math.clamp(ny, -baseY, math.max(vp.Y - sz.Y - baseY, -baseY))
                end
                mobileButton.Position = UDim2.new(startPos.X.Scale, nx, startPos.Y.Scale, ny)
            end
        end
    end)

    self._mobileToggle = mobileButton

    if IsMobileDevice() then
        mobileButton.Visible = true
    else
        mobileButton.Visible = not self._visible
    end
end

