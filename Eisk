    local arrow = CreateInstance("ImageLabel", {
        Name = "Arrow",
        Image = "rbxassetid://105558791071013",
        ImageColor3 = c.TextDark,
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -(arrowSize + s.PadX), 0.5, -arrowSize / 2),
        Size = UDim2.new(0, arrowSize, 0, arrowSize),
        Rotation = 0,
        ZIndex = 2,
        Parent = selectedDisplay
    })

    local maxVisibleOptions = IS_MOBILE and 4 or 5
    local function GetFullHeight()
        return math.min(#options * dd.OptionHeight, maxVisibleOptions * dd.OptionHeight)
    end

    local optionsContainer = CreateInstance("Frame", {
        Name = "OptionsContainer",
        BackgroundColor3 = c.Secondary,
        BackgroundTransparency = 0.04,
        Position = UDim2.new(1, boxX, 0, dd.OptY),
        BorderSizePixel = 0,
        Size = UDim2.new(0, boxW, 0, GetFullHeight()),
        Visible = false,
        ZIndex = 100,
        ClipsDescendants = true,
        Parent = frame
    })
    CreateCorner(optionsContainer, 5)
    CreateStroke(optionsContainer)

    local optionsScroll = CreateInstance("ScrollingFrame", {
        Name = "OptionsScroll",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        CanvasSize = UDim2.new(0, 0, 0, #options * dd.OptionHeight),
        ScrollBarThickness = IS_MOBILE and 2 or 3,
        ScrollBarImageColor3 = Color3.fromRGB(60, 60, 60),
        ZIndex = 100,
        Parent = optionsContainer
    })
    CreateListLayout(optionsScroll, 0, Enum.SortOrder.LayoutOrder)

    local optionButtons = {}

    local function IsSelected(option)
        if multiSelect then
            return table.find(selected, option) ~= nil
        end
        return selected == option
    end

    -- มือถือไม่มี hover จึงไฮไลต์ตัวเลือกที่เลือกอยู่แทน
    local function RefreshHighlights()
        if not IS_MOBILE then return end
        for opt, btn in pairs(optionButtons) do
            btn.BackgroundTransparency = IsSelected(opt) and 0.6 or 1
        end
    end

    local function UpdateSelectedText()
        if multiSelect then
            selectedLabel.Text = #selected > 0 and table.concat(selected, ", ") or "None"
        else
            selectedLabel.Text = tostring(selected)
        end
        RefreshHighlights()
    end

    -- จัดตำแหน่งรายการ: ถ้าด้านล่างไม่พอ (ขอบกรอบเนื้อหา) ให้เปิดขึ้นด้านบน/ลดความสูงลง
    local function PlaceOptions()
        local full = GetFullHeight()
        local h = full
        local openUp = false
        local scroller = tab._library and tab._library.contentContainer
        if scroller then
            local top = scroller.AbsolutePosition.Y
            local bottom = top + scroller.AbsoluteSize.Y
            local rowY = frame.AbsolutePosition.Y
            local spaceBelow = bottom - (rowY + dd.OptY) - 4
            local spaceAbove = rowY - top - 4
            if spaceBelow < full then
                if spaceAbove > spaceBelow then
                    openUp = true
                    h = math.min(full, spaceAbove)
                else
                    h = spaceBelow
                end
            end
        end
        h = math.max(h, math.min(dd.OptionHeight, math.max(full, 1)))
        optionsContainer.Size = UDim2.new(0, boxW, 0, h)
        if openUp then
            optionsContainer.Position = UDim2.new(1, boxX, 0, -h - 2)
        else
            optionsContainer.Position = UDim2.new(1, boxX, 0, dd.OptY)
        end
    end

    local function SetExpanded(state)
        expanded = state
        if expanded then
            PlaceOptions()
        end
        optionsContainer.Visible = expanded
        CreateTween(arrow, {Rotation = expanded and 180 or 0}, animationspeed.Normal)
        frame.ZIndex = expanded and 10 or 1
    end

    local function CreateOptionButton(option)
        local optionBtn = CreateInstance("TextButton", {
            Name = option,
            FontFace = f.Regular,
            TextColor3 = c.Text,
            Text = option,
            BackgroundColor3 = Color3.fromRGB(30, 30, 30),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            TextSize = textsize.Small,
            Size = UDim2.new(1, 0, 0, dd.OptionHeight),
            ZIndex = 100,
            Parent = optionsScroll
        })
        optionButtons[option] = optionBtn

        if not IS_MOBILE then
            optionBtn.MouseEnter:Connect(function()
                CreateTween(optionBtn, {BackgroundTransparency = 0.5}, animationspeed.Fast)
            end)

            optionBtn.MouseLeave:Connect(function()
                CreateTween(optionBtn, {BackgroundTransparency = 1}, animationspeed.Fast)
            end)
        end

        optionBtn.Activated:Connect(function()
            if multiSelect then
                local index = table.find(selected, option)
                if index then
                    table.remove(selected, index)
                else
                    table.insert(selected, option)
                end
                UpdateSelectedText()
                callback(selected)
            else
                selected = option
                UpdateSelectedText()
                callback(selected)
                SetExpanded(false)
            end
        end)

        return optionBtn
    end

    for _, option in ipairs(options) do
        CreateOptionButton(option)
    end
    RefreshHighlights()

    local toggleBtn = CreateInstance("TextButton", {
        Name = "ToggleBtn",
        Text = "",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        ZIndex = 3,
        Parent = selectedDisplay
    })

    toggleBtn.Activated:Connect(function()
        SetExpanded(not expanded)
    end)
    rowBtn.Activated:Connect(function()
        SetExpanded(not expanded)
    end)

    local methods = {
        SetValue = function(_, value)
            if multiSelect and type(value) == "table" then
                selected = value
            elseif not multiSelect then
                selected = value
            end
            UpdateSelectedText()
            callback(selected)
        end,
        GetValue = function()
            return selected
        end,
        Refresh = function(_, newOptions)
            options = newOptions
            optionButtons = {}
            for _, child in ipairs(optionsScroll:GetChildren()) do
                if child:IsA("TextButton") then
                    child:Destroy()
                end
            end
            for _, option in ipairs(options) do
                CreateOptionButton(option)
            end
            optionsScroll.CanvasSize = UDim2.new(0, 0, 0, #options * dd.OptionHeight)
            optionsContainer.Size = UDim2.new(0, boxW, 0, GetFullHeight())
            RefreshHighlights()
            if expanded then
                PlaceOptions()
            end
        end
    }

    if flag and tab._library then
        tab._library:_RegisterConfigElement(flag, "Dropdown", 
            function() return selected end,
            function(value) methods:SetValue(value) end
        )
    end

    return methods
end

