    local IconImg = Library:Asset(A.Icon)
    local off = 0
    if IconImg ~= "" then
        local I = Library:Create("ImageLabel", {
            Parent = Head, BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.new(0, 20, 0, 20), Image = IconImg, ImageColor3 = A.IconThemed and THEME.PRIMARY or Color3.fromRGB(255, 255, 255),
        })
        off = 28
    end
    local T = Library:Create("TextLabel", {
        Parent = Head, BackgroundTransparency = 1, Position = UDim2.new(0, off, 0, 0), Size = UDim2.new(1, -off, 1, 0),
        Font = Enum.Font.GothamBold, TextSize = 15, TextColor3 = THEME.PRIMARY, Text = tostring(A.Title or "Dialog"),
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    Library:Create("UIGradient", { Parent = T, Color = GradientTitle(), Rotation = 90 })

