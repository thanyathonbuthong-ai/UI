                Parent = Head, BackgroundTransparency = 1, Size = UDim2.new(1, -60, 1, 0), Font = Enum.Font.GothamSemibold, TextSize = 12,
                TextColor3 = Color3.fromRGB(235, 238, 245), Text = tostring(A.Title or "Code"), TextXAlignment = Enum.TextXAlignment.Left,
            })
            local CopyBtn = Library:Create("TextButton", {
                Parent = Head, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 52, 0, 20),
                BackgroundColor3 = THEME.PRIMARY, BorderSizePixel = 0, AutoButtonColor = false, Font = Enum.Font.GothamBold, TextSize = 10,
                TextColor3 = Color3.fromRGB(0, 20, 30), Text = "Copy",
            })
            Library:Corner(CopyBtn, 8)
            Library:Create("UIGradient", { Parent = CopyBtn, Color = GradientHot(), Rotation = 45 })
            local CodeLabel = Library:Create("TextLabel", {
                Parent = Body, BackgroundTransparency = 1, LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                Font = Enum.Font.Code, TextSize = 11, TextColor3 = Color3.fromRGB(170, 200, 255), TextWrapped = true, RichText = false,
                TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Text = tostring(A.Code or ""),
            })
            local Data = { Title = A.Title, Code = A.Code or "", Instance = Frame, Locked = A.Locked or false }
            CopyBtn.MouseButton1Click:Connect(function()
                if setclipboard then pcall(setclipboard, Data.Code) elseif toclipboard then pcall(toclipboard, Data.Code) end
                CopyBtn.Text = "Copied!"
                task.delay(1.2, function() if CopyBtn.Parent then CopyBtn.Text = "Copy" end end)
                if A.OnCopy then A.OnCopy() end
            end)
            local SetLock = Library:Lockable(Frame, A.Locked)
            local S = Library:Common(Data, Frame, TL, nil, SetLock)
            S.Code = function(v) CodeLabel.Text = tostring(v) end
            function Data:SetCode(c) Data.Code = c; CodeLabel.Text = tostring(c) end
            return Library:Proxy(Data, S)
        end
    end

    -- ═══════════ TAB / PAGE ═══════════
    local TopOrder = 0
    local function NextTop() TopOrder += 1000; return TopOrder end

    local function MakePage(PArgs, Order)
        PArgs = PArgs or {}
        local PTitle = PArgs.Title or "Unknown"
        local PDesc = PArgs.Desc or "Description"
        local PIcon = PArgs.Icon or 127194456372995

        local Tab = Library:Create("Frame", {
            Name = "NewTabs", Parent = MainTabs, BackgroundColor3 = THEME.BG_PANEL, BorderSizePixel = 0,
            Size = UDim2.new(0, 230, 0, 55), LayoutOrder = Order,
        })
        local TabClick = Library:Button(Tab)
        Library:Corner(Tab, 12)
        Library:Stroke(Tab, THEME.GLOW, 1.5, 0.35)
        local Banner = Library:Create("ImageLabel", {
            Name = "Banner", Parent = Tab, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0),
            Image = "rbxassetid://125411502674016", ImageColor3 = THEME.PRIMARY, ImageTransparency = 0.3, ScaleType = Enum.ScaleType.Crop,
        })
        Library:Corner(Banner, 10)
        Library:Create("UIGradient", { Parent = Banner, Color = GradientHot(), Transparency = NumberSequence.new{
            NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0.8) } })
        local TabInfo = Library:Create("Frame", { Name = "Info", Parent = Tab, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0) })
        Library:Create("UIListLayout", { Parent = TabInfo, Padding = UDim.new(0, 10), FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center })
        Library:Create("UIPadding", { Parent = TabInfo, PaddingLeft = UDim.new(0, 15) })
        local TabIcon = Library:Create("ImageLabel", {
            Name = "Icon", Parent = TabInfo, BackgroundTransparency = 1, BorderSizePixel = 0, LayoutOrder = -1,
            Size = UDim2.new(0, 25, 0, 25), Image = Library:Asset(PIcon), ImageColor3 = THEME.PRIMARY,
        })
        Library:Create("UIGradient", { Parent = TabIcon, Color = GradientTitle(), Rotation = 90 })
        local TabText = Library:Create("Frame", { Name = "Text", Parent = TabInfo, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(0, 150, 0, 32) })
        Library:Create("UIListLayout", { Parent = TabText, Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center })
        local TabTitle = Library:Create("TextLabel", {
            Name = "Title", Parent = TabText, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(0, 150, 0, 14),
            Font = Enum.Font.GothamBold, RichText = true, Text = PTitle, TextColor3 = THEME.PRIMARY, TextSize = 15,
            TextStrokeTransparency = 0.4, TextXAlignment = Enum.TextXAlignment.Left,
        })
        Library:Create("UIGradient", { Parent = TabTitle, Color = GradientTitle(), Rotation = 90 })
        Library:Create("TextLabel", {
            Name = "Desc", Parent = TabText, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(0.9, 0, 0, 10),
            Font = Enum.Font.GothamMedium, RichText = true, Text = PDesc, TextColor3 = THEME.TEXT_DIM, TextSize = 10,
            TextStrokeTransparency = 0.5, TextTransparency = 0.2, TextXAlignment = Enum.TextXAlignment.Left,
        })

        local NewPage = Library:Create("Frame", { Name = "NewPage", Parent = Scale, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0) })
        local Scroll = Library:Create("ScrollingFrame", {
            Name = "PageScrolling", Parent = NewPage, Active = true, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0),
            ClipsDescendants = true, ScrollBarThickness = 0, ScrollingDirection = Enum.ScrollingDirection.XY,
        })
        Library:Create("UIPadding", { Parent = Scroll, PaddingBottom = UDim.new(0, 1), PaddingLeft = UDim.new(0, 15), PaddingRight = UDim.new(0, 15), PaddingTop = UDim.new(0, 1) })
        local SL = Library:Create("UIListLayout", { Parent = Scroll, Padding = UDim.new(0, 5), FillDirection = Enum.FillDirection.Vertical, SortOrder = Enum.SortOrder.LayoutOrder })
        SL:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() Scroll.CanvasSize = UDim2.new(0, 0, 0, SL.AbsoluteContentSize.Y + 15) end)

        TabClick.MouseEnter:Connect(function() TweenService:Create(Tab, TweenInfo.new(0.18), { BackgroundColor3 = THEME.BG_HOVER }):Play() end)
        TabClick.MouseLeave:Connect(function() TweenService:Create(Tab, TweenInfo.new(0.18), { BackgroundColor3 = THEME.BG_PANEL }):Play() end)
        local function Open()
            Library:Tween({ v = HeadScale, t = 0.2, s = "Exponential", d = "Out", g = { Size = UDim2.new(1, -30, 1, 0) } }):Play()
            ReturnIcon.Visible = true
            PageService:JumpTo(NewPage)
        end
        TabClick.MouseButton1Click:Connect(Open)

        local Page = { Instance = NewPage }
        function Page:Select() Open() end
        function Page:Destroy() Tab:Destroy(); NewPage:Destroy() end
        AttachElements(Page, Scroll, Scroll)
        return Page
    end

    function Window:NewPage(PArgs) return MakePage(PArgs, NextTop()) end
    Window.Tab = Window.NewPage

    -- กลุ่มแท็บ (Tab Section)
    function Window:TabSection(A)
        local Title = type(A) == "table" and (A.Title or "Section") or tostring(A)
        local Base = NextTop()
        local Hdr = Library:Create("TextLabel", {
            Name = "TabSection", Parent = MainTabs, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = Base,
            Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = THEME.TEXT_DIM, Text = " " .. Title, TextXAlignment = Enum.TextXAlignment.Left,
        })
        local n = 0
        local Sec = { Instance = Hdr }
        function Sec:NewPage(PArgs) n += 1; return MakePage(PArgs, Base + n) end
        Sec.Tab = Sec.NewPage
        function Sec:SetTitle(t) Hdr.Text = " " .. tostring(t) end
        return Sec
    end
    Window.Section = Window.TabSection

    function Window:Divider()
        local D = Library:Create("Frame", { Parent = MainTabs, BackgroundColor3 = THEME.PRIMARY, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 1), LayoutOrder = NextTop() })
        Library:Create("UIGradient", { Parent = D, Transparency = NumberSequence.new{
            NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.2), NumberSequenceKeypoint.new(1, 1) } })
        return D
    end

    function Window:Tag(A)
        A = A or {}
        local Frame = Library:Create("Frame", {
            Parent = TagsHolder, BackgroundColor3 = A.Color or THEME.PRIMARY, BackgroundTransparency = 0.25,
            BorderSizePixel = 0, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X,
        })
        Library:Corner(Frame, 8)
        Library:Create("UIPadding", { Parent = Frame, PaddingLeft = UDim.new(0, 7), PaddingRight = UDim.new(0, 7) })
        local L = Library:Create("TextLabel", {
            Parent = Frame, BackgroundTransparency = 1, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X,
            Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = Color3.fromRGB(255, 255, 255), Text = tostring(A.Title or "Tag"),
        })
        local T = {}
        function T:SetTitle(t) L.Text = tostring(t) end
        function T:SetColor(c) Frame.BackgroundColor3 = c end
        function T:Destroy() Frame:Destroy() end
        return T
    end

    function Window:Dialog(A) return Library:_Dialog(WindowScale, A) end
    function Window:Notify(A) return Library:Notify(A) end
    function Window:SetToggleKey(k) ToggleKey = k end
    function Window:SetTitle(t) TitleLabel.Text = tostring(t) end
    function Window:SetSubTitle(t) SubLabel.Text = tostring(t) end

    -- ═══════════ PILLOW (ปุ่มลอย) ═══════════
    local ToggleGui = Library:Create("ScreenGui", {
        Name = "PremiumLibToggle", Parent = Library:Parent(), ZIndexBehavior = Enum.ZIndexBehavior.Global, IgnoreGuiInset = true,
    })
    local Pillow = Library:Create("TextButton", {
        Name = "Pillow", Parent = ToggleGui, BackgroundColor3 = THEME.BG_PANEL, BorderSizePixel = 0,
        Position = UDim2.new(0.06, 0, 0.15, 0), Size = UDim2.new(0, 50, 0, 50), Text = "",
    })
    Library:Corner(Pillow, 999)
    local PillowStroke = Library:Stroke(Pillow, THEME.PRIMARY, 2, 0.2)
    local Logo = Library:Create("ImageLabel", {
        Name = "Logo", Parent = Pillow, AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
        Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0.5, 0, 0.5, 0), Image = Library:Asset(LogoImage), ImageColor3 = THEME.PRIMARY,
    })
    local Ring = Library:Create("ImageLabel", {
        Parent = Pillow, AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(1.3, 0, 1.3, 0), Image = "rbxassetid://7948482113", ImageColor3 = THEME.PRIMARY, ImageTransparency = 0.65, ZIndex = 0,
    })
    local PillowDrag = Library:Draggable(Pillow, Pillow, Connect)
    local Snd1 = Library:Create("Sound", { Parent = Pillow, SoundId = "rbxassetid://6895079853", Volume = 0.6 })
    local Snd2 = Library:Create("Sound", { Parent = Pillow, SoundId = "rbxassetid://4612375233", Volume = 0.5 })

    local Busy = false
    local function ToggleMenu()
        if Busy then return end
        Busy = true
        pcall(function() Snd1:Play() end)
        task.delay(0.08, function() pcall(function() Snd2:Play() end) end)
        TweenService:Create(Logo, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Rotation = Logo.Rotation + 360 }):Play()
        local pulse = TweenService:Create(Pillow, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(0, 44, 0, 44) })
        pulse:Play()
        pulse.Completed:Once(function()
            TweenService:Create(Pillow, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.new(0, 50, 0, 50) }):Play()
        end)
        TweenService:Create(PillowStroke, TweenInfo.new(0.15), { Thickness = 4, Transparency = 0 }):Play()
        task.delay(0.15, function() TweenService:Create(PillowStroke, TweenInfo.new(0.4), { Thickness = 2, Transparency = 0.2 }):Play() end)
        Background.Visible = not Background.Visible
        task.delay(0.6, function() Busy = false end)
    end
    Pillow.MouseButton1Click:Connect(function()
        if PillowDrag.Moved then return end
        ToggleMenu()
    end)
    Connect(RunService.Heartbeat, function(dt) Ring.Rotation = (Ring.Rotation + dt * 45) % 360 end)
    Connect(UserInputService.InputBegan, function(Input, Processed)
        if Processed or Listening then return end
        if Input.KeyCode == ToggleKey then ToggleMenu() end
    end)

    Library:Draggable(Header, Background, Connect)

    local ReturnButton = Library:Button(ReturnIcon)
    ReturnButton.MouseButton1Click:Connect(function()
        ReturnIcon.Visible = false
        Library:Tween({ v = HeadScale, t = 0.3, s = "Exponential", d = "Out", g = { Size = UDim2.new(1, 0, 1, 0) } }):Play()
        PageService:JumpTo(Home)
    end)

    function Window:SetTimeValue(Value) TimeLabel.Text = tostring(Value) end
    function Library:SetTimeValue(Value) TimeLabel.Text = tostring(Value) end
    function Window:Toggle() ToggleMenu() end
    function Window:SetVisible(v) Background.Visible = v end
    function Window:Destroy()
        for _, c in ipairs(Connections) do c:Disconnect() end
        table.clear(Connections)
        Gui:Destroy()
        ToggleGui:Destroy()
    end

    return Window
end

return Library
