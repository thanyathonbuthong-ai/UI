        Library:Create("TextLabel", {
            Parent = Card, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = Color3.fromRGB(180, 188, 205), RichText = true,
            TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
            Text = tostring(A.Content), LayoutOrder = 2,
        })
    end

    local Obj = {}
    local Closed = false
    function Obj:Close()
        if Closed then return end
        Closed = true
        TweenService:Create(Overlay, TweenInfo.new(0.2), { BackgroundTransparency = 1 }):Play()
        TweenService:Create(CardScale, TweenInfo.new(0.2), { Scale = 0.9 }):Play()
        task.delay(0.22, function() Gui:Destroy() end)
    end
    function Obj:Show()
        Gui.Enabled = true
        TweenService:Create(Overlay, TweenInfo.new(0.2), { BackgroundTransparency = 0.45 }):Play()
        TweenService:Create(CardScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
    end

    if A.Buttons and #A.Buttons > 0 then
        local Row = Library:Create("Frame", { Parent = Card, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 3 })
        Library:Create("UIListLayout", {
            Parent = Row, FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right,
            Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center,
        })
        for i, b in ipairs(A.Buttons) do
            local Variant = b.Variant or "Primary"
            local Btn = Library:Create("TextButton", {
                Parent = Row, LayoutOrder = i, Size = UDim2.new(0, 0, 0, 28), AutomaticSize = Enum.AutomaticSize.X,
                BackgroundColor3 = Variant == "Primary" and THEME.PRIMARY or THEME.BG_ROW,
                BackgroundTransparency = Variant == "Tertiary" and 1 or 0, BorderSizePixel = 0, AutoButtonColor = false,
                Font = Enum.Font.GothamBold, TextSize = 12, Text = tostring(b.Title or "Button"),
                TextColor3 = Variant == "Primary" and Color3.fromRGB(0, 20, 30) or THEME.TEXT_BRIGHT,
            })
            Library:Create("UIPadding", { Parent = Btn, PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14) })
            Library:Corner(Btn, 10)
            if Variant == "Primary" then
                Library:Create("UIGradient", { Parent = Btn, Color = GradientHot(), Rotation = 45 })
            elseif Variant == "Secondary" then
                Library:Stroke(Btn, THEME.STROKE_DARK, 1, 0.4)
            end
            Btn.MouseButton1Click:Connect(function()
                if b.Callback then task.spawn(b.Callback) end
                Obj:Close()
            end)
        end
    end

    Obj.Gui = Gui
    Obj:Show()
    return Obj
end

