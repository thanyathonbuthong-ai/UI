    PRIMARY     = Color3.fromRGB(122, 92, 255),
    SECONDARY   = Color3.fromRGB(24, 200, 255),
    GLOW        = Color3.fromRGB(120, 110, 255),
    BG_DEEP     = Color3.fromRGB(11, 13, 18),
    BG_PANEL    = Color3.fromRGB(15, 17, 23),
