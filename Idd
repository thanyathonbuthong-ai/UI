}
Library.Theme = THEME

local function GradientHot()
    return ColorSequence.new{
        ColorSequenceKeypoint.new(0, THEME.PRIMARY),
        ColorSequenceKeypoint.new(1, THEME.SECONDARY),
    }
end
local function GradientTitle()
    return ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(245, 248, 255)),
        ColorSequenceKeypoint.new(0.6, THEME.PRIMARY),
        ColorSequenceKeypoint.new(1, THEME.SECONDARY),
    }
end

-- ═════════ HELPERS ═════════
function Library:Parent()
    if not RunService:IsStudio() then
        return (gethui and gethui()) or CoreGui
    end
    return PlayerGui
end

function Library:Create(Class, Properties)
    local Inst = Instance.new(Class)
    for prop, value in pairs(Properties) do Inst[prop] = value end
    return Inst
end

function Library:Corner(Parent, Radius)
    return Library:Create("UICorner", { Parent = Parent, CornerRadius = UDim.new(0, Radius) })
end

function Library:Stroke(Parent, Color, Thickness, Transparency)
    return Library:Create("UIStroke", { Parent = Parent, Color = Color, Thickness = Thickness, Transparency = Transparency })
end

function Library:Asset(rbx)
    if typeof(rbx) == "number" then return "rbxassetid://" .. rbx end
    if typeof(rbx) == "string" then
        if Library.Icons[rbx] then return Library:Asset(Library.Icons[rbx]) end
        if rbx:find("rbxasset") or rbx:find("http") then return rbx end
    end
    return ""
end

function Library:Button(Parent)
    return Library:Create("TextButton", {
        Name = "Click", Parent = Parent, BackgroundTransparency = 1, BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0), Font = Enum.Font.SourceSans, Text = "", TextSize = 14,
        ZIndex = Parent.ZIndex + 3,
    })
end

function Library:Tween(info)
    return TweenService:Create(info.v, TweenInfo.new(info.t, Enum.EasingStyle[info.s], Enum.EasingDirection[info.d]), info.g)
end

function Library.Effect(c, p)
    p.ClipsDescendants = true
    local Mouse = LocalPlayer:GetMouse()
    local rx = Mouse.X - c.AbsolutePosition.X
    local ry = Mouse.Y - c.AbsolutePosition.Y
    if rx < 0 or ry < 0 or rx > c.AbsoluteSize.X or ry > c.AbsoluteSize.Y then return end
    local ripple = Library:Create("Frame", {
        Parent = p, BackgroundColor3 = THEME.PRIMARY, BackgroundTransparency = 0.5, BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, rx, 0, ry), Size = UDim2.new(0, 0, 0, 0), ZIndex = p.ZIndex,
    })
    Library:Corner(ripple, 999)
    local tw = TweenService:Create(ripple, TweenInfo.new(1.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, c.AbsoluteSize.X * 1.5, 0, c.AbsoluteSize.X * 1.5), BackgroundTransparency = 1,
    })
    tw.Completed:Once(function() ripple:Destroy() end)
    tw:Play()
end

function Library:Draggable(Handle, Target, Connect)
    Target = Target or Handle
    Connect = Connect or function(signal, fn) return signal:Connect(fn) end
    local State = { Moved = false }
    local Dragging, DragInput, DragStart, StartPosition
    Handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            Dragging = true; State.Moved = false
            DragStart = input.Position; StartPosition = Target.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then Dragging = false end
            end)
        end
    end)
    Handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            DragInput = input
        end
    end)
    Connect(UserInputService.InputChanged, function(input)
        if input == DragInput and Dragging then
            local Delta = input.Position - DragStart
            if Delta.Magnitude > 5 then State.Moved = true end
            TweenService:Create(Target, TweenInfo.new(0.1), {
                Position = UDim2.new(StartPosition.X.Scale, StartPosition.X.Offset + Delta.X, StartPosition.Y.Scale, StartPosition.Y.Offset + Delta.Y),
            }):Play()
        end
    end)
    return State
end

-- Proxy: ให้ใช้ obj.Value = x / obj.Title = x ได้ และเรียก obj:Set() ได้
function Library:Proxy(Data, Setters)
    return setmetatable({}, {
        __index = Data,
        __newindex = function(_, k, v)
            rawset(Data, k, v)
            local s = Setters and Setters[k]
            if s then s(v) end
        end,
    })
end

-- ลูกศร (วาดด้วย Frame ไม่พึ่งฟอนต์) Rotation 0 = ชี้ลง, -90 = ชี้ขวา
function Library:Chevron(Parent, Position, Color, Rotation)
    local Holder = Library:Create("Frame", {
        Name = "Chevron", Parent = Parent, BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5),
        Position = Position, Size = UDim2.new(0, 14, 0, 14), Rotation = Rotation or 0,
    })
    for _, side in ipairs({ -1, 1 }) do
        local Arm = Library:Create("Frame", {
            Parent = Holder, BackgroundColor3 = Color, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, side * 2.5, 0.5, 0), Size = UDim2.new(0, 2, 0, 8), Rotation = side * 45,
        })
        Library:Corner(Arm, 1)
    end
    return Holder
end

-- ปิดกั้น (Lock) แถว
function Library:Lockable(Rows, Locked)
    local Overlay = Library:Create("TextButton", {
        Name = "Lock", Parent = Rows, BackgroundColor3 = Color3.fromRGB(0, 0, 0), BackgroundTransparency = 0.45,
        BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), Text = "", AutoButtonColor = false,
        Visible = false, ZIndex = Rows.ZIndex + 30,
    })
    Library:Corner(Overlay, 10)
    local function Set(v) Overlay.Visible = v and true or false end
    Set(Locked)
    return Set
end

function Library:Common(Data, Frame, TitleLabel, DescLabel, SetLock, OnDestroy)
    function Data:SetTitle(t) Data.Title = t; TitleLabel.Text = tostring(t) end
    function Data:SetDesc(t)
        Data.Desc = t
        if DescLabel then DescLabel.Text = tostring(t or ""); DescLabel.Visible = t ~= nil and t ~= "" end
    end
    function Data:Lock() Data.Locked = true; SetLock(true) end
    function Data:Unlock() Data.Locked = false; SetLock(false) end
    function Data:Destroy() if OnDestroy then OnDestroy() end; Frame:Destroy() end
    return {
        Title = function(v) TitleLabel.Text = tostring(v) end,
        Desc = function(v)
            if DescLabel then DescLabel.Text = tostring(v or ""); DescLabel.Visible = v ~= nil and v ~= "" end
        end,
        Locked = function(v) SetLock(v) end,
    }
end

