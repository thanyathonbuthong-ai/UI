}

local function ResolveIcon(Name)
    if type(Name) == "number" then return "rbxassetid://" .. tostring(Name) end
    if type(Name) ~= "string" or Name == "" then return nil end
    if string.find(Name, "rbxassetid://", 1, true) or string.find(Name, "rbxasset://", 1, true) then
        return Name
    end
    if tonumber(Name) then return "rbxassetid://" .. Name end
    return IconRegistry[string.lower(Name)]
end

-- Web images need executor functions (request + writefile + getcustomasset). Without them the image stays empty.
local function ResolveRemoteImage(Src, Callback)
    if type(Src) ~= "string" or Src == "" then return end
    if string.sub(Src, 1, 4) ~= "http" then
        Callback(ResolveIcon(Src) or Src)
        return
    end
    task.spawn(function()
        local Ok, Asset = pcall(function()
            local Req = (syn and syn.request) or http_request or request
            local GetAsset = getcustomasset or getsynasset
            if not (Req and writefile and GetAsset) then return nil end
            local Res = Req({Url = Src, Method = "GET"})
            if not Res or not Res.Body then return nil end
            local Sum = 0
            for I = 1, #Src do Sum = (Sum * 31 + string.byte(Src, I)) % 1000000007 end
            local FileName = "uilib_img_" .. tostring(Sum) .. ".png"
            writefile(FileName, Res.Body)
            return GetAsset(FileName)
        end)
        if Ok and Asset then Callback(Asset) end
    end)
end

