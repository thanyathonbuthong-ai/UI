                TransparencyLabel.TextColor3 = Theme.TextSecondary
                PickerFrame.BackgroundColor3 = Theme.Main
                PickerStroke.Color = Theme.Border

                HueSlider.Bar.BackgroundColor3 = Theme.Search
                HueSlider.Fill.BackgroundColor3 = Theme.Accent
                HueSlider.Label.TextColor3 = Theme.TextPrimary
                HueSlider.Title.TextColor3 = Theme.TextSecondary

                AlphaSlider.Bar.BackgroundColor3 = Theme.Search
                AlphaSlider.Fill.BackgroundColor3 = Theme.Accent
                AlphaSlider.Label.TextColor3 = Theme.TextPrimary
                AlphaSlider.Title.TextColor3 = Theme.TextSecondary
            end)

            local function UpdateVisuals(TriggerCallback)
                ColorBtn.BackgroundColor3 = CurrentColor
                HexBox.Text = CurrentColor:ToHex():upper()
                TransparencyLabel.Text = tostring(math.floor(CurrentAlpha * 100)) .. "%"
                ColorMap.BackgroundColor3 = Color3.fromHSV(HSV[1], 1, 1)

                TweenService:Create(MapMarker, TweenInfo.new(0.05), {Position = UDim2.new(HSV[2], 0, 1 - HSV[3], 0)}):Play()

                local HuePct = HSV[1]
                TweenService:Create(HueSlider.Fill, TweenInfo.new(0.05), {Size = UDim2.new(HuePct, 0, 1, 0)}):Play()
                HueSlider.Label.Text = tostring(math.floor(HSV[1] * 360))

                local AlphaPct = CurrentAlpha
                TweenService:Create(AlphaSlider.Fill, TweenInfo.new(0.05), {Size = UDim2.new(AlphaPct, 0, 1, 0)}):Play()
                AlphaSlider.Label.Text = tostring(math.floor(CurrentAlpha * 100)) .. "%"
                
                if TriggerCallback then
                    CPCallback(CurrentColor, CurrentAlpha)
                end
            end

            HexBox.FocusLost:Connect(function()
                local success, ParsedColor = pcall(function() return Color3.fromHex(HexBox.Text) end)
                if success then
                    CurrentColor = ParsedColor
                    HSV = {Color3.toHSV(CurrentColor)}
                    UpdateVisuals(true)
                else
                    HexBox.Text = CurrentColor:ToHex():upper()
                end
            end)

            local function HandleInput(GuiObj, Type, Input)
                local function Update(InputPos)
                    local MaxX = GuiObj.AbsoluteSize.X
                    local MaxY = GuiObj.AbsoluteSize.Y
                    local Px = math.clamp(InputPos.X - GuiObj.AbsolutePosition.X, 0, MaxX)
                    local Py = math.clamp(InputPos.Y - GuiObj.AbsolutePosition.Y, 0, MaxY)
                    local X = Px / MaxX
                    local Y = Py / MaxY

                    if Type == "Map" then
                        HSV[2] = X
                        HSV[3] = 1 - Y
                    elseif Type == "Hue" then
                        HSV[1] = X
                    elseif Type == "Alpha" then
                        CurrentAlpha = X
                    end
                    CurrentColor = Color3.fromHSV(HSV[1], HSV[2], HSV[3])
                    UpdateVisuals(true)
                end

                Update(Input.Position)
                local MoveConn = UserInputService.InputChanged:Connect(function(Mv)
                    if Mv == Input or Mv.UserInputType == Enum.UserInputType.MouseMovement then
                        Update(Mv.Position)
                    end
                end)
                local EndConn
                EndConn = UserInputService.InputEnded:Connect(function(End)
                    if End == Input or IsPointerDown(End) then
                        MoveConn:Disconnect()
                        EndConn:Disconnect()
                    end
                end)
            end

            ColorMap.InputBegan:Connect(function(Input) if IsPointerDown(Input) then HandleInput(ColorMap, "Map", Input) end end)
            HueSlider.Track.InputBegan:Connect(function(Input) if IsPointerDown(Input) then HandleInput(HueSlider.Track, "Hue", Input) end end)
            AlphaSlider.Track.InputBegan:Connect(function(Input) if IsPointerDown(Input) then HandleInput(AlphaSlider.Track, "Alpha", Input) end end)

            local function ClosePicker()
                local tw = TweenService:Create(PickerFrame, TweenSmooth, {Size = UDim2.new(0, M.PickerW, 0, 0)})
                tw:Play()
                tw.Completed:Connect(function()
                    if PickerFrame.Size.Y.Offset == 0 then
                        PickerFrame.Visible = false
                    end
                end)
            end
            table.insert(WindowObj.Popups, {Close = ClosePicker})

            local function TogglePicker()
                if PickerFrame.Visible then
                    ClosePicker()
                else
                    local BtnPos = ColorBtn.AbsolutePosition
                    local BtnSize = ColorBtn.AbsoluteSize
                    local ScreenSize = ScreenGui.AbsoluteSize
                    local X, Y

                    if M.Mobile then
                        -- Open to the left of the swatch and keep the whole picker on screen
                        X = BtnPos.X - M.PickerW - 8
                        if X < 6 then X = BtnPos.X + BtnSize.X + 8 end
                        X = math.clamp(X, 6, math.max(ScreenSize.X - M.PickerW - 6, 6))
                        Y = math.clamp(BtnPos.Y - 10, 6, math.max(ScreenSize.Y - M.PickerH - 6, 6))
                    else
                        X = BtnPos.X - 230
                        Y = BtnPos.Y + 25
                        if X < 0 then X = BtnPos.X + 35 end
                        if Y + 225 > ScreenSize.Y then Y = ScreenSize.Y - 230 end
                    end

                    PickerFrame.Position = UDim2.new(0, X, 0, Y)
                    PickerFrame.Visible = true
                    TweenService:Create(PickerFrame, TweenSmooth, {Size = UDim2.new(0, M.PickerW, 0, M.PickerH)}):Play()
                end
            end

            ColorBtn.Activated:Connect(TogglePicker)

            -- Tap outside the picker to close it (mouse click or finger tap)
            UserInputService.InputBegan:Connect(function(Input)
                if IsPointerDown(Input) and PickerFrame.Visible then
                    local Pos = Input.Position
                    local InPicker = IsInside(Pos, PickerFrame)
                    local InBtn = IsInside(Pos, ColorBtn) or (TapZone ~= nil and IsInside(Pos, TapZone))

                    if not InPicker and not InBtn then
                        ClosePicker()
                    end
                end
            end)

            UpdateVisuals(false)
            
            local CPObj = {}
            function CPObj:GetComponentType() return "Colorpicker" end
            function CPObj:GetValue() return CurrentColor end
            function CPObj:GetTransparency() return CurrentAlpha * 100 end
            function CPObj:SetValue(color)
                CurrentColor = color
                HSV = {Color3.toHSV(CurrentColor)}
                UpdateVisuals(true)
            end
            function CPObj:SetTransparency(trans)
                CurrentAlpha = math.clamp(trans, 0, 100) / 100
                UpdateVisuals(true)
            end
            Library.Flags[FlagName] = CPObj
            return CPObj, TogglePicker
        end

        -- Builds every element method onto Obj (a Tab, Section, Group or VStack).
        -- ParentFrame holds the rows. Mode = "tab" | "section" | "group" (group = narrow side-by-side cells)
        local function InstallElements(Obj, ParentFrame, Mode)
            local M = (Mode == "group") and MakeGroupMetrics(M) or M
            Obj.LayoutOrder = Obj.LayoutOrder or 0
            Obj.Elements = Obj.Elements or {}

            local function AddSearchEntry(Outer, Text)
                if Mode ~= "group" then
                    table.insert(WindowObj.AllRows, {Row = Outer, OriginalParent = ParentFrame, Title = Text or ""})
                end
            end

            -- Lets a Group lay its cells out side by side
            local function RegisterOuter(Outer, IsSpace)
                if Obj.OnRowAdded then
                    Obj.OnRowAdded(Outer, IsSpace)
                end
            end

            -- A fixed-height row. Returns the Body frame (put the controls in it);
            -- Body.Parent is the Outer frame that holds the separator, lock overlay, etc.
            local function CreateRow(ComponentTitle, Height)
                Obj.LayoutOrder = Obj.LayoutOrder + 1
                local H = Height or M.RowH

                local Outer = Create("Frame", {Size = UDim2.new(1, 0, 0, H), BackgroundTransparency = 1, LayoutOrder = Obj.LayoutOrder, Parent = ParentFrame})
                local Body = Create("Frame", {Name = "Body", Size = UDim2.new(1, 0, 0, H), BackgroundTransparency = 1, Parent = Outer})

                if Mode ~= "group" then
                    local RowSep = Create("Frame", {Size = UDim2.new(1, -M.Indent, 0, 1), Position = UDim2.new(0, M.Indent, 1, -1), BackgroundColor3 = Theme.Border, BorderSizePixel = 0, Parent = Outer})
                    ThemeUpdate(function()
                        RowSep.BackgroundColor3 = Theme.Border
                    end)
                end

                AddSearchEntry(Outer, ComponentTitle)
                RegisterOuter(Outer, false)
                return Body
            end

            -- A row whose height follows its content (Paragraph, Code, Section...)
            local function CreateAutoOuter()
                Obj.LayoutOrder = Obj.LayoutOrder + 1
                local Outer = Create("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = Obj.LayoutOrder, Parent = ParentFrame})
                RegisterOuter(Outer, false)
                return Outer
            end

            -- Adds the WindUI-style common features to any element:
            -- Desc, Locked / LockedTitle, SetTitle, SetDesc, Lock, Unlock, Highlight, Destroy, Set
            local function Decorate(Element, Body, TitleLabel, Opts)
                Opts = Opts or {}
                local Outer = Body.Parent
                local BaseH = Body.Size.Y.Offset
                local Locked = false
                local LockOverlay, LockText, DescLabel, HighlightFrame, TitleBasePos

                local Inline = TitleLabel ~= nil and TitleLabel.Size.Y.Scale == 1 and TitleLabel.Size.Y.Offset == 0

                Element.Row = Body
                Element._Outer = Outer

                local function EnsureDesc(Text)
                    if not TitleLabel then return end

                    if Text == nil or Text == "" then
                        if DescLabel then DescLabel.Visible = false end
                        if Inline and TitleBasePos then TitleLabel.Position = TitleBasePos end
                        return
                    end

                    if not DescLabel then
                        local P, S = TitleLabel.Position, TitleLabel.Size
                        if Inline then
                            -- Title moves up a little and the description sits right under it
                            TitleBasePos = P
                            DescLabel = Create("TextLabel", {Name = "Desc", Size = UDim2.new(S.X.Scale, S.X.Offset, 0, M.DescH), Position = UDim2.new(P.X.Scale, P.X.Offset, 0.5, 1), BackgroundTransparency = 1, Text = "", TextColor3 = Theme.TextSecondary, Font = Theme.Font, TextSize = M.DescSize, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = TitleLabel.Parent})
                        else
                            -- Two-line rows (slider, textarea...): the description goes under the whole row
                            Outer.Size = UDim2.new(Outer.Size.X.Scale, Outer.Size.X.Offset, 0, BaseH + M.DescH)
                            DescLabel = Create("TextLabel", {Name = "Desc", Size = UDim2.new(1, -M.Indent, 0, M.DescH), Position = UDim2.new(0, M.Indent, 0, BaseH - 6), BackgroundTransparency = 1, Text = "", TextColor3 = Theme.TextSecondary, Font = Theme.Font, TextSize = M.DescSize, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Outer})
                        end
                        ThemeUpdate(function()
                            DescLabel.TextColor3 = Theme.TextSecondary
                        end)
                    end

                    if Inline and TitleBasePos then
                        TitleLabel.Position = UDim2.new(TitleBasePos.X.Scale, TitleBasePos.X.Offset, TitleBasePos.Y.Scale, TitleBasePos.Y.Offset - math.floor(M.DescH / 2) - 1)
                    end
                    DescLabel.Visible = true
                    DescLabel.Text = Text
                end

                local function SetLocked(State)
                    Locked = State
                    if State then
                        if not LockOverlay then
                            LockOverlay = Create("TextButton", {Name = "Lock", Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Theme.Main, BackgroundTransparency = 0.3, Text = "", AutoButtonColor = false, Active = true, ZIndex = 20, Parent = Outer})
                            LockText = Create("TextLabel", {Size = UDim2.new(1, -16, 1, 0), Position = UDim2.new(0, 8, 0, 0), BackgroundTransparency = 1, Text = "", TextColor3 = Theme.TextSecondary, Font = Theme.Font, TextSize = M.ControlTextSize, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 21, Parent = LockOverlay})
                            ThemeUpdate(function()
                                LockOverlay.BackgroundColor3 = Theme.Main
                                LockText.TextColor3 = Theme.TextSecondary
                            end)
                        end
                        LockText.Text = Opts.LockedTitle or "Locked"
                        LockOverlay.Visible = true
                    elseif LockOverlay then
                        LockOverlay.Visible = false
                    end
                end

                function Element:SetTitle(Text)
                    if TitleLabel then TitleLabel.Text = Text end
                    for _, Entry in WindowObj.AllRows do
                        if Entry.Row == Outer then Entry.Title = Text end
                    end
                end

                function Element:SetDesc(Text)
                    EnsureDesc(Text)
                end

                function Element:Lock() SetLocked(true) end
                function Element:Unlock() SetLocked(false) end
                function Element:IsLocked() return Locked end

                function Element:Highlight()
                    if not HighlightFrame then
                        HighlightFrame = Create("Frame", {Name = "Highlight", Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Theme.Accent, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 15, Parent = Outer})
                        Create("UICorner", {CornerRadius = UDim.new(0, 8), Parent = HighlightFrame})
                    end
                    HighlightFrame.BackgroundColor3 = Theme.Accent
                    HighlightFrame.BackgroundTransparency = 0.7
                    TweenService:Create(HighlightFrame, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 1}):Play()
                end

                function Element:Destroy()
                    for I = #WindowObj.AllRows, 1, -1 do
                        if WindowObj.AllRows[I].Row == Outer then
                            table.remove(WindowObj.AllRows, I)
                        end
                    end
                    local Idx = table.find(Obj.Elements, Element)
                    if Idx then table.remove(Obj.Elements, Idx) end
                    Outer:Destroy()
                    if Obj.OnRowRemoved then Obj.OnRowRemoved(Outer) end
                end

                -- WindUI calls it :Set(value); callbacks are skipped while locked
                if Element.Set == nil and Element.SetValue ~= nil then
                    function Element:Set(...)
                        if Locked then return end
                        return Element:SetValue(...)
                    end
                end

                if Opts.Desc then EnsureDesc(Opts.Desc) end
                if Opts.Locked then SetLocked(true) end

                table.insert(Obj.Elements, Element)
                return Element
            end

            -- Toggle: Type = "Checkbox" (default, our style) or "Toggle" (sliding pill, same as Switch)
            function Obj:Toggle(TOpts)
                if TOpts.Type == "Toggle" then
                    local Copy = table.clone(TOpts)
                    Copy.Flag = Copy.Flag or string.format("%s/Toggle/%s", Obj.FlagPrefix, Copy.Title or "Toggle")
                    return Obj:Switch(Copy)
                end

                local Title = TOpts.Title or "Toggle"
                local Default = TOpts.Default
                if Default == nil then Default = TOpts.Value end
                Default = Default or false
                local Callback = TOpts.Callback or function() end
            
                local FlagName = TOpts.Flag or string.format("%s/Toggle/%s", Obj.FlagPrefix, Title)

                local Row = CreateRow(Title)
                local RowHit = M.Mobile and CreateRowHit(Row) or nil
                local TextX = M.CheckIndent

                local Checkbox = Create("TextButton", {Size = UDim2.new(0, M.Checkbox, 0, M.Checkbox), Position = UDim2.new(0, 0, 0.5, -math.floor(M.Checkbox / 2)), BackgroundColor3 = Default and Theme.Accent or Theme.Main, Text = "", AutoButtonColor = false, Parent = Row})
                local CBStroke = Create("UIStroke", {Color = Default and Theme.Accent or Theme.Border, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = Checkbox})
                Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = Checkbox})

                local CheckSize = UDim2.new(0, M.CheckIcon, 0, M.CheckIcon)
                local CheckIcon = Create("ImageLabel", {Size = Default and CheckSize or UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Image = Icons.Checkmark, ImageColor3 = Theme.Main, Visible = Default, Parent = Checkbox})

                local TitleLabel = Create("TextLabel", {Size = UDim2.new(1, -(TextX + 4), 1, 0), Position = UDim2.new(0, TextX, 0, 0), BackgroundTransparency = 1, Text = Title, TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = M.TitleSize, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Row})

                local State = Default
            
                ThemeUpdate(function()
                    Checkbox.BackgroundColor3 = State and Theme.Accent or Theme.Main
                    CBStroke.Color = State and Theme.Accent or Theme.Border
                    CheckIcon.ImageColor3 = Theme.Main
                    TitleLabel.TextColor3 = Theme.TextPrimary
                end)
            
                local function SetState(newState, triggerCallback)
                    State = newState
                    TweenService:Create(Checkbox, TweenFast, {BackgroundColor3 = State and Theme.Accent or Theme.Main}):Play()
                    TweenService:Create(CBStroke, TweenFast, {Color = State and Theme.Accent or Theme.Border}):Play()

                    if State then
                        CheckIcon.Visible = true
                        TweenService:Create(CheckIcon, TweenSmooth, {Size = CheckSize}):Play()
                    else
                        local shrink = TweenService:Create(CheckIcon, TweenSmooth, {Size = UDim2.new(0, 0, 0, 0)})
                        shrink:Play()
                        shrink.Completed:Once(function()
                            if not State then CheckIcon.Visible = false end
                        end)
                    end
                
                    if triggerCallback then Callback(State) end
                end

                Checkbox.Activated:Connect(function() SetState(not State, true) end)
                -- Mobile: tapping anywhere on the row toggles it
                if RowHit then
                    RowHit.Activated:Connect(function() SetState(not State, true) end)
                end

                local ToggleObj = {}
                function ToggleObj:GetComponentType() return "Toggle" end
                function ToggleObj:GetValue() return State end
                function ToggleObj:SetValue(val) SetState(val, true) end
            
                function ToggleObj:Colorpicker(ColorProps)
                    AttachColorPicker(Row, Title, ColorProps, nil, Mode == "group")
                    TitleLabel.Size = UDim2.new(1, -(TextX + M.CPWidth + 8), 1, 0)
                    return self
                end
            
                Decorate(ToggleObj, Row, TitleLabel, TOpts)
                Library.Flags[FlagName] = ToggleObj
                return ToggleObj
            end

            -- Input: Type = "Input" (one line, default) or "Textarea" (multi-line box under the title)
            function Obj:Input(IOpts)
                local Title = IOpts.Title or "Input"
                local Default = IOpts.Default
                if Default == nil then Default = IOpts.Value end
                Default = Default or ""
                local Placeholder = IOpts.Placeholder or "Type here"
                local Callback = IOpts.Callback or function() end
                local IsArea = IOpts.Type == "Textarea"
                local InputIcon = ResolveIcon(IOpts.InputIcon)
                local RowIcon = ResolveIcon(IOpts.Icon)
            
                local FlagName = IOpts.Flag or string.format("%s/Input/%s", Obj.FlagPrefix, Title)

                local Row = CreateRow(Title, IsArea and M.AreaH or nil)

                local TitleLabel
                if IsArea then
                    TitleLabel = Create("TextLabel", {Size = UDim2.new(1, -M.Indent, 0, 26), Position = UDim2.new(0, M.Indent, 0, 4), BackgroundTransparency = 1, Text = Title, TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = M.TitleSize, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Row})
                else
                    TitleLabel = Create("TextLabel", {Size = UDim2.new(1, -M.TitleRes.Input, 1, 0), Position = UDim2.new(0, M.Indent, 0, 0), BackgroundTransparency = 1, Text = Title, TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = M.TitleSize, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Row})
                end

                if RowIcon then
                    Create("ImageLabel", {Size = UDim2.new(0, 18, 0, 18), Position = IsArea and UDim2.new(0, 4, 0, 8) or UDim2.new(0, 4, 0.5, -9), BackgroundTransparency = 1, Image = RowIcon, ImageColor3 = Theme.TextSecondary, Parent = Row})
                end

                local PadL = InputIcon and 28 or 10
                local InputBox
                if IsArea then
                    InputBox = Create("TextBox", {
                        Size = UDim2.new(1, -M.Indent, 1, -38),
                        Position = UDim2.new(0, M.Indent, 0, 32),
                        BackgroundColor3 = Theme.Search,
                        Text = Default,
                        PlaceholderText = Placeholder,
                        TextColor3 = Theme.TextPrimary,
                        PlaceholderColor3 = Theme.TextSecondary,
                        Font = Enum.Font.Code,
                        TextSize = M.ControlTextSize,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        TextYAlignment = Enum.TextYAlignment.Top,
                        MultiLine = true,
                        TextWrapped = true,
                        ClearTextOnFocus = IOpts.ClearTextOnFocus == true,
                        ClipsDescendants = true,
                        Parent = Row
                    })
                    Create("UIPadding", {PaddingLeft = UDim.new(0, PadL), PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), Parent = InputBox})
                else
                    InputBox = Create("TextBox", {
                        Size = UDim2.new(0, M.InputW, 0, M.InputH),
                        Position = UDim2.new(1, 0, 0.5, 0),
                        AnchorPoint = Vector2.new(1, 0.5),
                        BackgroundColor3 = Theme.Search,
                        Text = Default,
                        PlaceholderText = Placeholder,
                        TextColor3 = Theme.TextPrimary,
                        PlaceholderColor3 = Theme.TextSecondary,
                        Font = Enum.Font.Code,
                        TextSize = M.ControlTextSize,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        AutomaticSize = Enum.AutomaticSize.X,
                        ClearTextOnFocus = IOpts.ClearTextOnFocus == true,
                        ClipsDescendants = true,
                        Parent = Row
                    })
                    Create("UIPadding", {PaddingLeft = UDim.new(0, PadL), PaddingRight = UDim.new(0, 10), Parent = InputBox})
                    Create("UISizeConstraint", {MinSize = Vector2.new(M.InputW, M.InputH), MaxSize = Vector2.new(M.InputMaxW, M.InputH), Parent = InputBox})
                end

                Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = InputBox})
                local Stroke = Create("UIStroke", {Color = Theme.Border, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = InputBox})

                -- Icon inside the left edge of the field (not clipped: it sits in the padding area)
                if InputIcon then
                    -- Children of a padded box are placed inside the padding, so the holder is moved back to the left edge
                    local Holder = Create("Frame", {Size = UDim2.new(0, PadL, IsArea and 0 or 1, IsArea and 30 or 0), Position = UDim2.new(0, -PadL, 0, IsArea and -8 or 0), BackgroundTransparency = 1, Parent = InputBox})
                    Create("ImageLabel", {Size = UDim2.new(0, 14, 0, 14), Position = IsArea and UDim2.new(0, 8, 0, 9) or UDim2.new(0, 8, 0.5, -7), BackgroundTransparency = 1, Image = InputIcon, ImageColor3 = Theme.TextSecondary, Parent = Holder})
                end

                ThemeUpdate(function()
                    TitleLabel.TextColor3 = Theme.TextPrimary
                    InputBox.BackgroundColor3 = Theme.Search
                    InputBox.TextColor3 = Theme.TextPrimary
                    InputBox.PlaceholderColor3 = Theme.TextSecondary
                    Stroke.Color = Theme.Border
                end)

                local CurrentValue = Default

                local function SetValue(val, triggerCallback)
                    CurrentValue = tostring(val)
                    InputBox.Text = CurrentValue
                    if triggerCallback then Callback(CurrentValue) end
                end

                InputBox.FocusLost:Connect(function()
                    SetValue(InputBox.Text, true)
                    TweenService:Create(Stroke, TweenFast, {Color = Theme.Border}):Play()
                end)
            
                InputBox.Focused:Connect(function()
                    TweenService:Create(Stroke, TweenFast, {Color = Theme.Accent}):Play()
                end)

                local InputObj = {}
                function InputObj:GetComponentType() return "Input" end
                function InputObj:GetValue() return CurrentValue end
                function InputObj:SetValue(val) SetValue(val, true) end

                Decorate(InputObj, Row, TitleLabel, IOpts)
                Library.Flags[FlagName] = InputObj
                return InputObj
            end

            -- Old name kept for existing scripts
            function Obj:Textbox(TOpts)
                local Copy = table.clone(TOpts)
                Copy.Flag = Copy.Flag or string.format("%s/Textbox/%s", Obj.FlagPrefix, Copy.Title or "Textbox")
                return Obj:Input(Copy)
            end

            -- Button
            --   With Action = "Text": title on the left + small action button on the right (our classic style)
            --   Without Action:      the whole row is one button (WindUI style) - Icon, IconAlign, Justify, Color supported
            -- Style: "Default" | "Accent" | "Danger"
            function Obj:Button(BOpts)
                local Title = BOpts.Title or "Button"
                local Callback = BOpts.Callback or function() end
            
                local FlagName = BOpts.Flag or string.format("%s/Button/%s", Obj.FlagPrefix, Title)

                local Row = CreateRow(Title)
                local TitleLabel

                if BOpts.Action ~= nil then
                    TitleLabel = Create("TextLabel", {Size = UDim2.new(1, -M.TitleRes.Button, 1, 0), Position = UDim2.new(0, M.Indent, 0, 0), BackgroundTransparency = 1, Text = Title, TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = M.TitleSize, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Row})

                    CreateStyledButton(Row, {
                        Text = BOpts.Action,
                        Style = BOpts.Style,
                        Size = UDim2.new(0, 0, 0, M.BtnH),
                        Position = UDim2.new(1, 0, 0.5, 0),
                        AnchorPoint = Vector2.new(1, 0.5),
                        AutomaticSize = Enum.AutomaticSize.X,
                        Callback = Callback
                    })
                else
                    local Style = BOpts.Style or "Default"
                    local Justify = BOpts.Justify or "Between"
                    local IconAlign = BOpts.IconAlign or "Right"
                    local IconImage = ResolveIcon(BOpts.Icon)
                    local CustomColor = BOpts.Color

                    local function Colors()
                        if CustomColor then
                            return CustomColor, Color3.fromRGB(255, 255, 255), CustomColor
                        end
                        return ButtonColors(Style)
                    end

                    local Bg, Tx, Br = Colors()
                    local Btn = Create("TextButton", {Size = UDim2.new(1, 0, 1, -10), Position = UDim2.new(0, 0, 0, 5), BackgroundColor3 = Bg, Text = "", AutoButtonColor = false, Parent = Row})
                    Create("UICorner", {CornerRadius = UDim.new(0, 8), Parent = Btn})
                    local Stroke = Create("UIStroke", {Color = Br, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = Btn})

                    local IconSize = M.Mobile and 16 or 18
                    local Pad = 12
                    local LeftIcon = (IconAlign == "Left")
                    local IconLabel
                    if IconImage then
                        IconLabel = Create("ImageLabel", {Size = UDim2.new(0, IconSize, 0, IconSize), AnchorPoint = Vector2.new(LeftIcon and 0 or 1, 0.5), Position = UDim2.new(LeftIcon and 0 or 1, LeftIcon and Pad or -Pad, 0.5, 0), BackgroundTransparency = 1, Image = IconImage, ImageColor3 = BOpts.IconColor or Tx, Parent = Btn})
                    end

                    local LeftPad = Pad + ((IconLabel and LeftIcon) and (IconSize + 8) or 0)
                    local RightPad = Pad + ((IconLabel and not LeftIcon) and (IconSize + 8) or 0)

                    TitleLabel = Create("TextLabel", {Size = UDim2.new(1, -(LeftPad + RightPad), 1, 0), Position = UDim2.new(0, LeftPad, 0, 0), BackgroundTransparency = 1, Text = Title, TextColor3 = Tx, Font = Theme.Font, TextSize = M.TitleSize, TextXAlignment = (Justify == "Center") and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Btn})

                    ThemeUpdate(function()
                        local B, T, S = Colors()
                        Btn.BackgroundColor3 = B
                        Stroke.Color = S
                        TitleLabel.TextColor3 = T
                        if IconLabel and not BOpts.IconColor then IconLabel.ImageColor3 = T end
                    end)

                    Btn.Activated:Connect(function()
                        PressFlash(Btn, Stroke, CustomColor and "Accent" or Style)
                        Callback()
                    end)
                end

                if BOpts.Action ~= nil then
                    ThemeUpdate(function()
                        TitleLabel.TextColor3 = Theme.TextPrimary
                    end)
                end

                local ButtonObj = {}
                function ButtonObj:GetComponentType() return "Button" end
                function ButtonObj:Fire() Callback() end

                Decorate(ButtonObj, Row, TitleLabel, BOpts)
                Library.Flags[FlagName] = ButtonObj
                return ButtonObj
            end

            function Obj:Colorpicker(CPOpts)
                local Title = CPOpts.Title or "Colorpicker"
                local Row = CreateRow(Title)
                local RowHit = M.Mobile and CreateRowHit(Row) or nil

                local TitleLabel = Create("TextLabel", {Size = UDim2.new(1, -M.TitleRes.Color, 1, 0), Position = UDim2.new(0, M.Indent, 0, 0), BackgroundTransparency = 1, Text = Title, TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = M.TitleSize, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Row})
            
                ThemeUpdate(function()
                    TitleLabel.TextColor3 = Theme.TextPrimary
                end)

                local CPObj, TogglePicker = AttachColorPicker(Row, Title, CPOpts, RowHit and Row or nil, Mode == "group")
                function CPObj:Set(Color, Transparency)
                    if Color then CPObj:SetValue(Color) end
                    if Transparency then CPObj:SetTransparency(Transparency) end
                end
                Decorate(CPObj, Row, TitleLabel, CPOpts)

                -- Mobile: tapping anywhere on the row opens the picker
                if RowHit then
                    RowHit.Activated:Connect(TogglePicker)
                end
                return CPObj
            end

            function Obj:Keybind(KOpts)
                local Title = KOpts.Title or "Keybind"
                local Default = KOpts.Default
                if Default == nil then Default = KOpts.Value end
                -- WindUI gives the key as text, e.g. Value = "F"
                if type(Default) == "string" then
                    local Found, KeyEnum = pcall(function() return Enum.KeyCode[Default] end)
                    Default = Found and KeyEnum or nil
                end
                local Callback = KOpts.Callback or function() end
            
                local FlagName = KOpts.Flag or string.format("%s/Keybind/%s", Obj.FlagPrefix, Title)
            
                local CurrentKey = Default

                local Row = CreateRow(Title)

                local TitleLabel = Create("TextLabel", {Size = UDim2.new(1, -M.TitleRes.Keybind, 1, 0), Position = UDim2.new(0, M.Indent, 0, 0), BackgroundTransparency = 1, Text = Title, TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = M.TitleSize, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Row})

                -- On mobile the button covers the whole row (bigger tap area)
                local KeyContainer = Create("TextButton", {Size = M.Mobile and UDim2.new(1, 0, 1, 0) or UDim2.new(0, M.KeyW, 1, 0), Position = M.Mobile and UDim2.new(0, 0, 0, 0) or UDim2.new(1, -M.KeyW, 0, 0), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = Row})
                Create("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, M.KeyGap), Parent = KeyContainer})

                local function KeyLabel(KeyEnum)
                    local Name = FormatKeyName(KeyEnum)
                    if Name == "" and M.Mobile then return "Tap" end
                    return Name
                end

                local KeyText = Create("TextLabel", {Size = UDim2.new(0, 0, 0, 20), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, Text = KeyLabel(Default), TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = M.ControlTextSize, TextXAlignment = Enum.TextXAlignment.Right, LayoutOrder = 2, Parent = KeyContainer})

                local KeyIconContainer = Create("Frame", {Size = UDim2.new(0, M.KeyIconW, 0, M.KeyIconH), BackgroundTransparency = 1, LayoutOrder = 1, Parent = KeyContainer})
                local KeyboardIcon = Create("ImageLabel", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Image = Icons.Keyboard, ImageColor3 = Theme.TextPrimary, Parent = KeyIconContainer})

                local BindConnection
            
                ThemeUpdate(function()
                    TitleLabel.TextColor3 = Theme.TextPrimary
                    if BindConnection then
                        KeyText.TextColor3 = Theme.Accent
                        KeyboardIcon.ImageColor3 = Theme.Accent
                    else
                        KeyText.TextColor3 = Theme.TextPrimary
                        KeyboardIcon.ImageColor3 = Theme.TextPrimary
                    end
                end)
            
                local function SetValue(keyEnum, triggerCallback)
                    CurrentKey = keyEnum
                    KeyText.Text = KeyLabel(keyEnum)
                    TweenService:Create(KeyText, TweenFast, {TextColor3 = Theme.TextPrimary}):Play()
                    TweenService:Create(KeyboardIcon, TweenFast, {ImageColor3 = Theme.TextPrimary}):Play()
                
                    if triggerCallback then Callback(CurrentKey) end
                end

                KeyContainer.Activated:Connect(function()
                    -- Mobile has no physical keys: tapping the row triggers the action directly
                    if M.Mobile then
                        TweenService:Create(KeyText, TweenFast, {TextColor3 = Theme.Accent}):Play()
                        TweenService:Create(KeyboardIcon, TweenFast, {ImageColor3 = Theme.Accent}):Play()
                        task.delay(0.15, function()
                            TweenService:Create(KeyText, TweenFast, {TextColor3 = Theme.TextPrimary}):Play()
                            TweenService:Create(KeyboardIcon, TweenFast, {ImageColor3 = Theme.TextPrimary}):Play()
                        end)
                        Callback(CurrentKey)
                        return
                    end

                    if KOpts.CanChange == false then return end
                    KeyText.Text = "..."
                    TweenService:Create(KeyText, TweenFast, {TextColor3 = Theme.Accent}):Play()
                    TweenService:Create(KeyboardIcon, TweenFast, {ImageColor3 = Theme.Accent}):Play()

                    if BindConnection then BindConnection:Disconnect() end
                
                    BindConnection = UserInputService.InputBegan:Connect(function(Input)
                        if Input.UserInputType == Enum.UserInputType.Keyboard or string.find(Input.UserInputType.Name, "MouseButton") then
                            local ValidKey = (Input.KeyCode.Name ~= "Unknown") and Input.KeyCode or Input.UserInputType
                        
                            BindConnection:Disconnect()
                            BindConnection = nil
                        
                            SetValue(ValidKey, true)
                        end
                    end)
                end)
            
                UserInputService.InputBegan:Connect(function(Input, Processed)
                    if Processed then return end
                    if CurrentKey and CurrentKey.Name ~= "Unknown" then
                        if Input.KeyCode == CurrentKey or Input.UserInputType == CurrentKey then
                            Callback(CurrentKey)
                        end
                    end
                end)
            
                local KeybindObj = {}
                function KeybindObj:GetComponentType() return "Keybind" end
                function KeybindObj:GetValue() return CurrentKey end
                function KeybindObj:SetValue(val) SetValue(val, true) end
                Decorate(KeybindObj, Row, TitleLabel, KOpts)
                Library.Flags[FlagName] = KeybindObj
                return KeybindObj
            end

            -- Slider (WindUI parameters: Value = {Min, Max, Default}, Step, Width, IsTooltip, IsTextbox)
            -- Our extra options still work: Min / Max / Default / Decimal / Dual / ZeroNumber / Prefix / Suffix
            function Obj:Slider(SOpts)
                local HasTitle = SOpts.Title ~= nil
                local Title = SOpts.Title or "Slider"

                local Min, Max, DefaultValue = SOpts.Min, SOpts.Max, SOpts.Default
                if type(SOpts.Value) == "table" then
                    Min = SOpts.Value.Min or Min
                    Max = SOpts.Value.Max or Max
                    if SOpts.Value.Default ~= nil then DefaultValue = SOpts.Value.Default end
                elseif type(SOpts.Value) == "number" then
                    DefaultValue = SOpts.Value
                end
                Min = Min or 0
                Max = Max or 100

                local Step = SOpts.Step
                local Decimal = SOpts.Decimal
                if Decimal == nil then
                    local Frac = Step and string.match(tostring(Step), "%.(%d+)")
                    Decimal = Frac and #Frac or 0
                end

                local Prefix = SOpts.Prefix or ""
                local Suffix = SOpts.Suffix or ""
                local Dual = SOpts.Dual or false
                local ZeroNumber = SOpts.ZeroNumber or Min
                local Callback = SOpts.Callback or function() end
                local IsTextbox = (SOpts.IsTextbox == true) and (not Dual) and HasTitle
                local IsTooltip = SOpts.IsTooltip == true
                local TrackW = SOpts.Width or M.SliderTrackW

                local FlagName = SOpts.Flag or string.format("%s/Slider/%s", Obj.FlagPrefix, Title)

                local CurrentValue
                if Dual then
                    if type(DefaultValue) == "table" then
                        CurrentValue = {math.clamp(DefaultValue[1] or Min, Min, Max), math.clamp(DefaultValue[2] or Max, Min, Max)}
                    else
                        CurrentValue = {Min, Max}
                    end
                else
                    CurrentValue = math.clamp(DefaultValue or Min, Min, Max)
                end

                local function Snap(Raw)
                    if Step and Step > 0 then
                        Raw = Min + math.round((Raw - Min) / Step) * Step
                    end
                    local Mult = 10 ^ Decimal
                    return math.clamp(math.round(Raw * Mult) / Mult, Min, Max)
                end

                local Row = CreateRow(Title, HasTitle and M.SliderRowH or M.RowH)

                local TitleLabel, ValueLabel, TrackBtn
                if not HasTitle then
                    -- No title: the track fills the whole row
                    ValueLabel = Create("TextLabel", {Size = UDim2.new(0, 10, 0, 10), BackgroundTransparency = 1, Text = "", Visible = false, Parent = Row})
                    TrackBtn = Create("TextButton", {Size = UDim2.new(1, -M.Indent, 0, M.SliderTrackH), Position = UDim2.new(0, M.Indent, 0.5, -math.floor(M.SliderTrackH / 2)), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = Row})
                elseif M.Mobile then
                    -- Two-line layout: title + value on top, full-width track underneath
                    local ValW = IsTextbox and 72 or 100
                    TitleLabel = Create("TextLabel", {Size = UDim2.new(1, -(M.Indent + ValW), 0, 26), Position = UDim2.new(0, M.Indent, 0, 4), BackgroundTransparency = 1, Text = Title, TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = M.TitleSize, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Row})
                    if IsTextbox then
                        ValueLabel = Create("TextBox", {Size = UDim2.new(0, ValW, 0, 24), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 5), BackgroundColor3 = Theme.Search, Text = "", TextColor3 = Theme.TextPrimary, Font = Enum.Font.Code, TextSize = M.ValueSize, ClearTextOnFocus = false, Parent = Row})
                    else
                        ValueLabel = Create("TextLabel", {Size = UDim2.new(0, ValW, 0, 26), Position = UDim2.new(1, -ValW, 0, 4), BackgroundTransparency = 1, Text = "", TextColor3 = Theme.TextPrimary, Font = Enum.Font.Code, TextSize = M.ValueSize, TextXAlignment = Enum.TextXAlignment.Right, Parent = Row})
                    end
                    TrackBtn = Create("TextButton", {Size = UDim2.new(1, -M.Indent, 0, M.SliderTrackH), Position = UDim2.new(0, M.Indent, 0, 32), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = Row})
                else
                    TitleLabel = Create("TextLabel", {Size = UDim2.new(0, 200, 1, 0), Position = UDim2.new(0, M.Indent, 0, 0), BackgroundTransparency = 1, Text = Title, TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = M.TitleSize, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Row})
                    if IsTextbox then
                        ValueLabel = Create("TextBox", {Size = UDim2.new(0, 64, 0, 26), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -(TrackW + 10), 0.5, 0), BackgroundColor3 = Theme.Search, Text = "", TextColor3 = Theme.TextPrimary, Font = Enum.Font.Code, TextSize = M.ValueSize, ClearTextOnFocus = false, Parent = Row})
                    else
                        ValueLabel = Create("TextLabel", {Size = UDim2.new(0, 150, 1, 0), Position = UDim2.new(1, -(TrackW + 10 + 150), 0, 0), BackgroundTransparency = 1, Text = "", TextColor3 = Theme.TextPrimary, Font = Enum.Font.Code, TextSize = M.ValueSize, TextXAlignment = Enum.TextXAlignment.Right, Parent = Row})
                    end
                    TrackBtn = Create("TextButton", {Size = UDim2.new(0, TrackW, 0, M.SliderTrackH), Position = UDim2.new(1, -TrackW, 0.5, -math.floor(M.SliderTrackH / 2)), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = Row})
                end

                local ValueBoxStroke
                if IsTextbox then
                    Create("UICorner", {CornerRadius = UDim.new(0, 5), Parent = ValueLabel})
                    ValueBoxStroke = Create("UIStroke", {Color = Theme.Border, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = ValueLabel})
                end

                local Track = Create("Frame", {Size = UDim2.new(1, 0, 0, M.SliderBar), Position = UDim2.new(0, 0, 0.5, -math.floor(M.SliderBar / 2)), BackgroundColor3 = Theme.Border, Parent = TrackBtn})
                Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Track})

                local Fill = Create("Frame", {Size = UDim2.new(0, 0, 1, 0), Position = UDim2.new(0, 0, 0, 0), BackgroundColor3 = Theme.Accent, Parent = Track})
                Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Fill})

                -- Bubble with the current value, shown above the track while dragging
                local TipFrame, TipLabel
                if IsTooltip then
                    TipFrame = Create("Frame", {Size = UDim2.new(0, 0, 0, 22), AutomaticSize = Enum.AutomaticSize.X, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0, 0, 0, -8), BackgroundColor3 = Theme.Sidebar, Visible = false, ZIndex = 30, Parent = Track})
                    Create("UICorner", {CornerRadius = UDim.new(0, 5), Parent = TipFrame})
                    Create("UIStroke", {Color = Theme.Border, Thickness = 1, Parent = TipFrame})
                    TipLabel = Create("TextLabel", {Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, Text = "", TextColor3 = Theme.TextPrimary, Font = Enum.Font.Code, TextSize = 12, ZIndex = 31, Parent = TipFrame})
                    Create("UIPadding", {PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = TipLabel})
                end

                ThemeUpdate(function()
                    if TitleLabel then TitleLabel.TextColor3 = Theme.TextPrimary end
                    ValueLabel.TextColor3 = Theme.TextPrimary
                    if IsTextbox then
                        ValueLabel.BackgroundColor3 = Theme.Search
                        ValueBoxStroke.Color = Theme.Border
                    end
                    Track.BackgroundColor3 = Theme.Border
                    Fill.BackgroundColor3 = Theme.Accent
                    if TipFrame then
                        TipFrame.BackgroundColor3 = Theme.Sidebar
                        TipLabel.TextColor3 = Theme.TextPrimary
                    end
                end)

                local function FormatValue(val)
                    local str = string.format("%." .. tostring(Decimal) .. "f", val)
                    return string.format("%s%s%s", Prefix, str, Suffix)
                end

                local function PlainValue(val)
                    return string.format("%." .. tostring(Decimal) .. "f", val)
                end

                local ZeroAlpha = math.clamp((ZeroNumber - Min) / (Max - Min), 0, 1)

                local Val1, Val2
                if Dual then
                    Val1 = Create("NumberValue", {Value = CurrentValue[1], Parent = Row})
                    Val2 = Create("NumberValue", {Value = CurrentValue[2], Parent = Row})
                    local function updateText()
                        ValueLabel.Text = FormatValue(Val1.Value) .. " - " .. FormatValue(Val2.Value)
                    end
                    Val1.Changed:Connect(updateText)
                    Val2.Changed:Connect(updateText)
                    updateText() 
                else
                    Val1 = Create("NumberValue", {Value = CurrentValue, Parent = Row})
                    Val1.Changed:Connect(function()
                        ValueLabel.Text = IsTextbox and PlainValue(Val1.Value) or FormatValue(Val1.Value)
                    end)
                    ValueLabel.Text = IsTextbox and PlainValue(Val1.Value) or FormatValue(Val1.Value)
                end

                local ActiveHandle = 1

                local function UpdateTip(val)
                    if not TipFrame then return end
                    local shown = Dual and val[ActiveHandle] or val
                    local a = (shown - Min) / (Max - Min)
                    TipFrame.Position = UDim2.new(a, 0, 0, -8)
                    TipLabel.Text = FormatValue(shown)
                end

                local function UpdateVisuals(val)
                    if Dual then
                        local a1 = (val[1] - Min) / (Max - Min)
                        local a2 = (val[2] - Min) / (Max - Min)
                        TweenService:Create(Fill, TweenSmooth, {
                            Position = UDim2.new(a1, 0, 0, 0),
                            Size = UDim2.new(a2 - a1, 0, 1, 0)
                        }):Play()
                        TweenService:Create(Val1, TweenSmooth, {Value = val[1]}):Play()
                        TweenService:Create(Val2, TweenSmooth, {Value = val[2]}):Play()
                    else
                        local a = (val - Min) / (Max - Min)
                        local startA = math.min(a, ZeroAlpha)
                        local sizeA = math.abs(a - ZeroAlpha)
                        TweenService:Create(Fill, TweenSmooth, {
                            Position = UDim2.new(startA, 0, 0, 0),
                            Size = UDim2.new(sizeA, 0, 1, 0)
                        }):Play()
                        TweenService:Create(Val1, TweenSmooth, {Value = val}):Play()
                    end
                    UpdateTip(val)
                end

                local function SetValue(Value, triggerCallback)
                    if Dual then
                        if type(Value) == "table" then
                            CurrentValue = {Snap(Value[1]), Snap(Value[2])}
                        else
                            CurrentValue = {Min, Max}
                        end
                    else
                        CurrentValue = Snap(Value)
                    end
                
                    UpdateVisuals(CurrentValue)
                    if triggerCallback then Callback(CurrentValue) end
                end

                local IsDragging = false
                local LockedScroller = nil

                local function HandleDrag(Input)
                    local Alpha = math.clamp((Input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                    local Value = Snap(Min + ((Max - Min) * Alpha))

                    if Dual then
                        local newValue = {CurrentValue[1], CurrentValue[2]}
                        newValue[ActiveHandle] = Value
                    
                        if ActiveHandle == 1 and newValue[1] > newValue[2] then
                            newValue[1] = newValue[2]
                        elseif ActiveHandle == 2 and newValue[2] < newValue[1] then
                            newValue[2] = newValue[1]
                        end
                        SetValue(newValue, true)
                    else
                        SetValue(Value, true)
                    end
                end

                TrackBtn.InputBegan:Connect(function(Input)
                    if IsPointerDown(Input) then
                        IsDragging = true

                        -- Stop the list from scrolling while the slider is being dragged with a finger
                        LockedScroller = Row:FindFirstAncestorWhichIsA("ScrollingFrame")
                        if LockedScroller then LockedScroller.ScrollingEnabled = false end
                    
                        if Dual then
                            local Alpha = math.clamp((Input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                            local a1 = (CurrentValue[1] - Min) / (Max - Min)
                            local a2 = (CurrentValue[2] - Min) / (Max - Min)
                        
                            local dist1 = math.abs(Alpha - a1)
                            local dist2 = math.abs(Alpha - a2)

                            if dist1 == dist2 then
                                ActiveHandle = (Alpha > a1) and 2 or 1
                            else
                                ActiveHandle = (dist1 < dist2) and 1 or 2
                            end
                        end

                        if TipFrame then TipFrame.Visible = true end
                        HandleDrag(Input)
                    end
                end)

                UserInputService.InputEnded:Connect(function(Input)
                    if IsPointerDown(Input) then
                        IsDragging = false
                        if TipFrame then TipFrame.Visible = false end
                        if LockedScroller then
                            LockedScroller.ScrollingEnabled = true
                            LockedScroller = nil
                        end
                    end
                end)

                UserInputService.InputChanged:Connect(function(Input)
                    if IsDragging and IsPointerMove(Input) then
                        HandleDrag(Input)
                    end
                end)

                -- Typing a value directly
                if IsTextbox then
                    ValueLabel.FocusLost:Connect(function()
                        local Num = tonumber(ValueLabel.Text)
                        if Num then
                            SetValue(Num, true)
                        end
                        ValueLabel.Text = PlainValue(CurrentValue)
                    end)
                end
            
                UpdateVisuals(CurrentValue)
            
                local SliderObj = {}
                function SliderObj:GetComponentType() return "Slider" end
                function SliderObj:GetValue() return CurrentValue end
                function SliderObj:SetValue(val) SetValue(val, true) end
                function SliderObj:SetRange(NewMin, NewMax)
                    Min, Max = NewMin, NewMax
                    ZeroAlpha = math.clamp((ZeroNumber - Min) / (Max - Min), 0, 1)
                    SetValue(CurrentValue, false)
                end

                Decorate(SliderObj, Row, TitleLabel, SOpts)
                Library.Flags[FlagName] = SliderObj
                return SliderObj
            end

            -- Dropdown (WindUI parameters: Values, Value, Multi, AllowNone, SearchBarEnabled, Desc, Locked, Callback)
            -- Old names still work: Options / Default
            function Obj:Dropdown(DOpts)
                local Title = DOpts.Title or "Dropdown"
                local Multi = DOpts.Multi or false
                local AllowNone = DOpts.AllowNone or false
                local SearchEnabled = DOpts.SearchBarEnabled == true
                local Callback = DOpts.Callback or function() end
            
                local FlagName = DOpts.Flag or string.format("%s/Dropdown/%s", Obj.FlagPrefix, Title)

                local OptionsList = {}
                for _, V in (DOpts.Values or DOpts.Options or {}) do
                    table.insert(OptionsList, tostring(V))
                end

                -- Accepts a string, an index, or a table of those
                local function Normalize(Value)
                    local Out = {}
                    if type(Value) == "table" then
                        for _, V in Value do
                            if type(V) == "number" and OptionsList[V] then
                                table.insert(Out, OptionsList[V])
                            elseif V ~= nil then
                                table.insert(Out, tostring(V))
                            end
                        end
                    elseif type(Value) == "number" then
                        if OptionsList[Value] then table.insert(Out, OptionsList[Value]) end
                    elseif type(Value) == "string" and Value ~= "" then
                        table.insert(Out, Value)
                    end
                    if not Multi and #Out > 1 then Out = {Out[1]} end
                    return Out
                end

                local Initial = DOpts.Value
                if Initial == nil then Initial = DOpts.Default end
                local SelectedItems = Normalize(Initial)
            
                local Row = CreateRow(Title)

                local TitleLabel = Create("TextLabel", {Size = UDim2.new(1, -M.TitleRes.Dropdown, 1, 0), Position = UDim2.new(0, M.Indent, 0, 0), BackgroundTransparency = 1, Text = Title, TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = M.TitleSize, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Row})

                -- On mobile the button covers the whole row (bigger tap area)
                local DropBtn = Create("TextButton", {Size = M.Mobile and UDim2.new(1, 0, 1, 0) or UDim2.new(0, M.DropBtnW, 1, 0), Position = M.Mobile and UDim2.new(0, 0, 0, 0) or UDim2.new(1, -M.DropBtnW, 0, 0), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = Row})
                Create("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, M.DropGap), Parent = DropBtn})

                local DropdownText = Create("TextLabel", {Size = UDim2.new(0, 0, 0, 20), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, Text = "", TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = M.ControlTextSize, TextXAlignment = Enum.TextXAlignment.Right, LayoutOrder = 2, Parent = DropBtn})
                local Chevron = Create("ImageLabel", {Size = UDim2.new(0, M.DropChevron, 0, M.DropChevron), BackgroundTransparency = 1, Image = Icons.ChevronDown, ImageColor3 = Theme.TextPrimary, LayoutOrder = 1, Parent = DropBtn})

                local function UpdateDropdownText()
                    local Str = ""
                    for I, V in SelectedItems do
                        Str = Str .. V .. (I < #SelectedItems and ", " or "")
                    end
                    if string.len(Str) > M.DropTextMax then
                        Str = string.sub(Str, 1, M.DropTextMax - 3) .. "..."
                    end
                    if Str == "" then Str = "None" end
                    DropdownText.Text = Str
                end

                -- The menu: outer frame (background, border) + optional search box + scrolling option list
                local SearchTop = SearchEnabled and (M.OptionH + 4) or 0

                local DropdownMenu = Create("Frame", {
                    Size = UDim2.new(0, M.DropMenuW, 0, 0), 
                    BackgroundColor3 = Theme.Main, 
                    Visible = false, 
                    ClipsDescendants = true, 
                    ZIndex = 10, 
                    BorderSizePixel = 0,
                    Parent = ScreenGui
                })
                Create("UICorner", {CornerRadius = UDim.new(0, 8), Parent = DropdownMenu})
                local DropStroke = Create("UIStroke", {Color = Theme.Border, Thickness = 1, Parent = DropdownMenu})

                local SearchBox
                if SearchEnabled then
                    SearchBox = Create("TextBox", {Size = UDim2.new(1, -16, 0, M.OptionH - 6), Position = UDim2.new(0, 8, 0, 8), BackgroundColor3 = Theme.Search, Text = "", PlaceholderText = "Search", TextColor3 = Theme.TextPrimary, PlaceholderColor3 = Theme.TextSecondary, Font = Theme.Font, TextSize = M.ControlTextSize, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, ZIndex = 11, Parent = DropdownMenu})
                    Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = SearchBox})
                    Create("UIPadding", {PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = SearchBox})
                end

                local OptionList = Create("ScrollingFrame", {
                    Size = UDim2.new(1, 0, 1, -SearchTop),
                    Position = UDim2.new(0, 0, 0, SearchTop),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    ScrollBarThickness = M.ScrollBar,
                    ScrollBarImageColor3 = Theme.Border,
                    ScrollingDirection = Enum.ScrollingDirection.Y,
                    CanvasSize = UDim2.new(0, 0, 0, 0),
                    AutomaticCanvasSize = Enum.AutomaticSize.Y,
                    ZIndex = 10,
                    Parent = DropdownMenu
                })
                Create("UIPadding", {PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), Parent = OptionList})
                local MenuLayout = Create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Parent = OptionList})

                local OptionButtons = {}
                local OptionChecks = {}
                local OptionSeps = {}
                local Separators = {}

                local IsOpen = false
                local RenderConnection
                local OpenAbove = false

                -- Menu height (and, on mobile, whether it opens above or below the row so it stays on screen)
                local function ComputeMenuHeight()
                    local Content = MenuLayout.AbsoluteContentSize.Y + 16 + SearchTop
                    local Limit = M.DropMenuMaxH + SearchTop

                    if M.Mobile then
                        local Screen = ScreenGui.AbsoluteSize
                        local BtnPos, BtnSize = DropBtn.AbsolutePosition, DropBtn.AbsoluteSize
                        local Below = Screen.Y - (BtnPos.Y + BtnSize.Y) - 8
                        local Above = BtnPos.Y - 8
                        OpenAbove = (Content > Below) and (Above > Below)
                        Limit = math.min(Limit, math.max(OpenAbove and Above or Below, 60 + SearchTop))
                    end

                    return math.min(Content, Limit)
                end

                local function PlaceMenu()
                    if M.Mobile then
                        local BtnPos, BtnSize = DropBtn.AbsolutePosition, DropBtn.AbsoluteSize
                        local Screen = ScreenGui.AbsoluteSize
                        local MinX = M.DropMenuW + 6
                        local X = math.clamp(BtnPos.X + BtnSize.X, MinX, math.max(Screen.X - 6, MinX))

                        if OpenAbove then
                            DropdownMenu.AnchorPoint = Vector2.new(1, 1)
                            DropdownMenu.Position = UDim2.fromOffset(X, BtnPos.Y - 2)
                        else
                            DropdownMenu.AnchorPoint = Vector2.new(1, 0)
                            DropdownMenu.Position = UDim2.fromOffset(X, BtnPos.Y + BtnSize.Y + 2)
                        end
                    else
                        DropdownMenu.Position = UDim2.fromOffset(MainFrame.AbsolutePosition.X + MainFrame.AbsoluteSize.X + 15, DropBtn.AbsolutePosition.Y)
                    end
                end
            
                local function CloseDropdown()
                    IsOpen = false
                    TweenService:Create(Chevron, TweenSmooth, {Rotation = 0}):Play()
                    local tw = TweenService:Create(DropdownMenu, TweenSmooth, {Size = UDim2.new(0, M.DropMenuW, 0, 0)})
                    tw:Play()
                    tw.Completed:Connect(function()
                        if not IsOpen then
                            DropdownMenu.Visible = false
                            if RenderConnection then
                                RenderConnection:Disconnect()
                                RenderConnection = nil
                            end
                        end
                    end)
                end
                table.insert(WindowObj.Popups, {Close = CloseDropdown})

                local function RefreshSelection(Animate)
                    for Option, OptBtn in OptionButtons do
                        local On = table.find(SelectedItems, Option) ~= nil
                        OptionChecks[Option].Visible = On
                        if Animate then
                            TweenService:Create(OptBtn, TweenFast, {TextColor3 = On and Theme.Accent or Theme.TextSecondary}):Play()
                        else
                            OptBtn.TextColor3 = On and Theme.Accent or Theme.TextSecondary
                        end
                    end
                end

                local function ApplySelection(NewList, TriggerCallback)
                    SelectedItems = NewList
                    RefreshSelection(true)
                    UpdateDropdownText()
                    if TriggerCallback then
                        Callback(Multi and SelectedItems or SelectedItems[1])
                    end
                end

                local function SetValue(val, triggerCallback)
                    local List = {}
                    for _, Item in Normalize(val) do
                        if table.find(OptionsList, Item) then table.insert(List, Item) end
                    end
                    ApplySelection(List, triggerCallback)
                end

                local function OnOptionPressed(Option)
                    local Idx = table.find(SelectedItems, Option)
                    if Multi then
                        local NewItems = table.clone(SelectedItems)
                        if Idx then
                            if #NewItems <= 1 and not AllowNone then return end
                            table.remove(NewItems, Idx)
                        else
                            table.insert(NewItems, Option)
                        end
                        ApplySelection(NewItems, true)
                    else
                        if Idx then
                            if AllowNone then ApplySelection({}, true) end
                        else
                            ApplySelection({Option}, true)
                        end
                        CloseDropdown()
                    end
                end

                local function ResizeOpenMenu()
                    if not IsOpen then return end
                    task.defer(function()
                        if IsOpen then
                            TweenService:Create(DropdownMenu, TweenSmooth, {Size = UDim2.new(0, M.DropMenuW, 0, ComputeMenuHeight())}):Play()
                        end
                    end)
                end

                local function SetOptionsList(newOptions)
                    OptionsList = {}
                    for _, V in (type(newOptions) == "table" and newOptions or {}) do
                        table.insert(OptionsList, tostring(V))
                    end

                    for _, btn in OptionButtons do btn:Destroy() end
                    for _, sep in Separators do sep:Destroy() end
                
                    table.clear(OptionButtons)
                    table.clear(OptionChecks)
                    table.clear(OptionSeps)
                    table.clear(Separators)

                    local newSelected = {}
                    for _, item in SelectedItems do
                        if table.find(OptionsList, item) then
                            table.insert(newSelected, item)
                        end
                    end
                    SelectedItems = newSelected

                    for Index, Option in OptionsList do
                        local OptBtn = Create("TextButton", {Size = UDim2.new(1, 0, 0, M.OptionH), BackgroundTransparency = 1, Text = Option, TextColor3 = Theme.TextSecondary, Font = Theme.Font, TextSize = M.ControlTextSize, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, AutoButtonColor = false, ZIndex = 11, LayoutOrder = Index * 2 - 1, Parent = OptionList})
                        Create("UIPadding", {PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 32), Parent = OptBtn})
                        -- Check mark for selected items (children of a padded button sit inside the padding)
                        local Check = Create("ImageLabel", {Size = UDim2.new(0, 14, 0, 14), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 22, 0.5, 0), BackgroundTransparency = 1, Image = Icons.Checkmark, ImageColor3 = Theme.Accent, Visible = false, ZIndex = 12, Parent = OptBtn})
                        OptionButtons[Option] = OptBtn
                        OptionChecks[Option] = Check

                        OptBtn.Activated:Connect(function()
                            OnOptionPressed(Option)
                        end)

                        if Index < #OptionsList then
                            local sep = Create("Frame", {Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = Theme.Border, BorderSizePixel = 0, ZIndex = 11, LayoutOrder = Index * 2, Parent = OptionList})
                            table.insert(Separators, sep)
                            OptionSeps[Option] = sep
                        end
                    end
                
                    RefreshSelection(false)
                    UpdateDropdownText()
                    ResizeOpenMenu()
                end

                -- Search bar: hide options that do not contain the typed text
                if SearchBox then
                    SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
                        local Query = string.lower(SearchBox.Text)
                        for Option, OptBtn in OptionButtons do
                            local Match = (Query == "") or (string.find(string.lower(Option), Query, 1, true) ~= nil)
                            OptBtn.Visible = Match
                            if OptionSeps[Option] then OptionSeps[Option].Visible = Match end
                        end
                        ResizeOpenMenu()
                    end)
                end
            
                SetOptionsList(OptionsList)
            
                ThemeUpdate(function()
                    TitleLabel.TextColor3 = Theme.TextPrimary
                    DropdownText.TextColor3 = Theme.TextPrimary
                    Chevron.ImageColor3 = Theme.TextPrimary
                    DropdownMenu.BackgroundColor3 = Theme.Main
                    OptionList.ScrollBarImageColor3 = Theme.Border
                    DropStroke.Color = Theme.Border
                    if SearchBox then
                        SearchBox.BackgroundColor3 = Theme.Search
                        SearchBox.TextColor3 = Theme.TextPrimary
                        SearchBox.PlaceholderColor3 = Theme.TextSecondary
                    end
                
                    for _, Check in OptionChecks do
                        Check.ImageColor3 = Theme.Accent
                    end
                    RefreshSelection(false)
                
                    for _, sep in Separators do
                        sep.BackgroundColor3 = Theme.Border
                    end
                end)

                DropBtn.Activated:Connect(function()
                    IsOpen = not IsOpen
                
                    if IsOpen then
                        DropdownMenu.Visible = true
                        TweenService:Create(Chevron, TweenSmooth, {Rotation = 180}):Play()
                    
                        local TargetHeight = ComputeMenuHeight()
                        PlaceMenu()
                    
                        TweenService:Create(DropdownMenu, TweenSmooth, {Size = UDim2.new(0, M.DropMenuW, 0, TargetHeight)}):Play()
                    
                        if RenderConnection then RenderConnection:Disconnect() end
                        RenderConnection = RunService.RenderStepped:Connect(function()
                            if not DropdownMenu.Visible then return end
                            PlaceMenu()
                        end)
                    else
                        CloseDropdown()
                    end
                end)

                -- Tap/click outside the menu closes it
                UserInputService.InputBegan:Connect(function(Input)
                    if IsPointerDown(Input) and DropdownMenu.Visible then
                        local Pos = Input.Position
                        local InMenu = IsInside(Pos, DropdownMenu)
                        local InBtn = IsInside(Pos, DropBtn)

                        if not InMenu and not InBtn then
                            CloseDropdown()
                        end
                    end
                end)
            
                local DropdownObj = {}
                function DropdownObj:GetComponentType() return "Dropdown" end
                function DropdownObj:GetValue() return Multi and SelectedItems or SelectedItems[1] end
                function DropdownObj:SetValue(val) SetValue(val, true) end
                function DropdownObj:Select(val) SetValue(val, true) end
            
                function DropdownObj:SetOptions(newOptions) SetOptionsList(newOptions) end
                function DropdownObj:Refresh(newOptions) SetOptionsList(newOptions) end
                function DropdownObj:GetOptions() return OptionsList end

                Decorate(DropdownObj, Row, TitleLabel, DOpts)
                Library.Flags[FlagName] = DropdownObj
                return DropdownObj
            end

            -- Switch: pill-style on/off switch (same API as Toggle)
            function Obj:Switch(SOpts)
                local Title = SOpts.Title or "Switch"
                local Default = SOpts.Default
                if Default == nil then Default = SOpts.Value end
                Default = Default or false
                local Callback = SOpts.Callback or function() end

                local FlagName = SOpts.Flag or string.format("%s/Switch/%s", Obj.FlagPrefix, Title)

                local Row = CreateRow(Title)
                local RowHit = M.Mobile and CreateRowHit(Row) or nil

                local TitleLabel = Create("TextLabel", {Size = UDim2.new(1, -(M.Indent + M.SwitchW + 8), 1, 0), Position = UDim2.new(0, M.Indent, 0, 0), BackgroundTransparency = 1, Text = Title, TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = M.TitleSize, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Row})

                local State = Default and true or false
                local KnobPad = 3
