    table.insert(ThemeConnections, func)
end

local Library = {
    ToggleKey = nil,
    Flags = {}
}

function Library:SetWindowKeybind(KeyEnum)
    self.ToggleKey = KeyEnum
end

function Library:GetTheme()
    return Theme
end

function Library:SetTheme(NewTheme)
    for Key, Value in NewTheme do
        if Theme[Key] then
            Theme[Key] = Value
        end
    end
    for _, Func in ThemeConnections do
        task.spawn(Func)
    end
end

function Library:AddIcons(Map)
    for Name, Asset in Map do
        IconRegistry[string.lower(Name)] = Asset
    end
end

-- Library:Notify / Library:Popup use the most recently created window
function Library:Notify(Cfg)
    if self.ActiveWindow then return self.ActiveWindow:Notify(Cfg) end
end

function Library:Popup(Cfg)
    if self.ActiveWindow then return self.ActiveWindow:Popup(Cfg) end
end

