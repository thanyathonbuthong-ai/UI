                local OnPos = UDim2.new(1, -(M.SwitchKnob + KnobPad), 0.5, 0)

                local Track = Create("TextButton", {Size = UDim2.new(0, M.SwitchW, 0, M.SwitchH), Position = UDim2.new(1, 0, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), BackgroundColor3 = State and Theme.Accent or Theme.Search, Text = "", AutoButtonColor = false, Parent = Row})
                Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Track})
                local TrackStroke = Create("UIStroke", {Color = State and Theme.Accent or Theme.Border, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = Track})
                local Knob = Create("Frame", {Size = UDim2.new(0, M.SwitchKnob, 0, M.SwitchKnob), AnchorPoint = Vector2.new(0, 0.5), Position = State and OnPos or OffPos, BackgroundColor3 = State and Theme.Main or Theme.TextSecondary, BorderSizePixel = 0, Parent = Track})
                Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Knob})

                ThemeUpdate(function()
                    TitleLabel.TextColor3 = Theme.TextPrimary
                    Track.BackgroundColor3 = State and Theme.Accent or Theme.Search
                    TrackStroke.Color = State and Theme.Accent or Theme.Border
                    Knob.BackgroundColor3 = State and Theme.Main or Theme.TextSecondary
                end)

                local function SetState(NewState, TriggerCallback)
                    State = NewState and true or false
                    TweenService:Create(Track, TweenFast, {BackgroundColor3 = State and Theme.Accent or Theme.Search}):Play()
                    TweenService:Create(TrackStroke, TweenFast, {Color = State and Theme.Accent or Theme.Border}):Play()
                    TweenService:Create(Knob, TweenSmooth, {Position = State and OnPos or OffPos, BackgroundColor3 = State and Theme.Main or Theme.TextSecondary}):Play()
                    if TriggerCallback then Callback(State) end
                end

                Track.Activated:Connect(function() SetState(not State, true) end)
                if RowHit then
                    RowHit.Activated:Connect(function() SetState(not State, true) end)
                end

                local SwitchObj = {Row = Row}
                function SwitchObj:GetComponentType() return "Switch" end
                function SwitchObj:GetValue() return State end
                function SwitchObj:SetValue(val) SetState(val, true) end

                Decorate(SwitchObj, Row, TitleLabel, SOpts)
                Library.Flags[FlagName] = SwitchObj
                return SwitchObj
            end

            -- Stepper: [-] value [+]  (tap once, or hold to repeat)
            function Obj:Stepper(SOpts)
                local Title = SOpts.Title or "Stepper"
                local Min = SOpts.Min or 0
                local Max = SOpts.Max or 100
                local Step = SOpts.Step or 1
                local Prefix = SOpts.Prefix or ""
                local Suffix = SOpts.Suffix or ""
                local Callback = SOpts.Callback or function() end

                local FlagName = SOpts.Flag or string.format("%s/Stepper/%s", Obj.FlagPrefix, Title)

                local Decimal = SOpts.Decimal
                if Decimal == nil then
                    local Frac = string.match(tostring(Step), "%.(%d+)")
                    Decimal = Frac and #Frac or 0
                end

                local function Snap(Value)
                    local Mult = 10 ^ Decimal
                    return math.clamp(math.round(Value * Mult) / Mult, Min, Max)
                end

                local Current = Snap(SOpts.Default or Min)

                local Row = CreateRow(Title)
                local ContW = M.StepBtn * 2 + M.StepValW + 12

                local TitleLabel = Create("TextLabel", {Size = UDim2.new(1, -(M.Indent + ContW + 8), 1, 0), Position = UDim2.new(0, M.Indent, 0, 0), BackgroundTransparency = 1, Text = Title, TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = M.TitleSize, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Row})

                local Holder = Create("Frame", {Size = UDim2.new(0, ContW, 0, M.StepBtn), Position = UDim2.new(1, 0, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), BackgroundTransparency = 1, Parent = Row})
                Create("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), Parent = Holder})

                local function MakeStepBtn(Text, Order)
                    local B = Create("TextButton", {Size = UDim2.new(0, M.StepBtn, 0, M.StepBtn), BackgroundColor3 = Theme.Search, Text = Text, TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = M.ControlTextSize + 4, AutoButtonColor = false, LayoutOrder = Order, Parent = Holder})
                    Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = B})
                    local St = Create("UIStroke", {Color = Theme.Border, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = B})
                    return B, St
                end

                local MinusBtn, MinusStroke = MakeStepBtn("-", 1)
                local ValueLabel = Create("TextLabel", {Size = UDim2.new(0, M.StepValW, 1, 0), BackgroundTransparency = 1, Text = "", TextColor3 = Theme.TextPrimary, Font = Enum.Font.Code, TextSize = M.ValueSize, TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 2, Parent = Holder})
                local PlusBtn, PlusStroke = MakeStepBtn("+", 3)

                local function FormatValue(Value)
                    return Prefix .. string.format("%." .. tostring(Decimal) .. "f", Value) .. Suffix
                end

                local function UpdateVisuals()
                    ValueLabel.Text = FormatValue(Current)
                    MinusBtn.TextColor3 = (Current <= Min) and Theme.TextSecondary or Theme.TextPrimary
                    PlusBtn.TextColor3 = (Current >= Max) and Theme.TextSecondary or Theme.TextPrimary
                end

                local function SetValue(Value, TriggerCallback)
                    Current = Snap(Value)
                    UpdateVisuals()
                    if TriggerCallback then Callback(Current) end
                end

                local function ApplyStep(Direction)
                    local New = Snap(Current + Direction * Step)
                    if New ~= Current then
                        SetValue(New, true)
                    end
                end

                local function BindHold(Btn, Stroke, Direction)
                    Btn.InputBegan:Connect(function(Input)
                        if not IsPointerDown(Input) then return end

                        local Holding = true
                        -- Keep the list from scrolling while a finger is held on the button
                        local Scroller = Row:FindFirstAncestorWhichIsA("ScrollingFrame")
                        if Scroller then Scroller.ScrollingEnabled = false end
                        TweenService:Create(Stroke, TweenFast, {Color = Theme.Accent}):Play()

                        local Conn
                        Conn = Input.Changed:Connect(function()
                            if Input.UserInputState == Enum.UserInputState.End then
                                Holding = false
                                Conn:Disconnect()
                                if Scroller then Scroller.ScrollingEnabled = true end
                                TweenService:Create(Stroke, TweenFast, {Color = Theme.Border}):Play()
                            end
                        end)

                        ApplyStep(Direction)
                        task.spawn(function()
                            task.wait(0.4)
                            while Holding do
                                ApplyStep(Direction)
                                task.wait(0.07)
                            end
                        end)
                    end)
                end

                BindHold(MinusBtn, MinusStroke, -1)
                BindHold(PlusBtn, PlusStroke, 1)

                ThemeUpdate(function()
                    TitleLabel.TextColor3 = Theme.TextPrimary
                    ValueLabel.TextColor3 = Theme.TextPrimary
                    MinusBtn.BackgroundColor3 = Theme.Search
                    PlusBtn.BackgroundColor3 = Theme.Search
                    MinusStroke.Color = Theme.Border
                    PlusStroke.Color = Theme.Border
                    UpdateVisuals()
                end)

                UpdateVisuals()

                local StepperObj = {Row = Row}
                function StepperObj:GetComponentType() return "Stepper" end
                function StepperObj:GetValue() return Current end
                function StepperObj:SetValue(val) SetValue(val, true) end

                Decorate(StepperObj, Row, TitleLabel, SOpts)
                Library.Flags[FlagName] = StepperObj
                return StepperObj
            end

            -- Segmented: a row of buttons where exactly one is selected
            function Obj:Segmented(SOpts)
                local Title = SOpts.Title or "Segmented"
                local OptionsList = SOpts.Options or {}
                local Callback = SOpts.Callback or function() end

                local FlagName = SOpts.Flag or string.format("%s/Segmented/%s", Obj.FlagPrefix, Title)

                local Selected = SOpts.Default
                if Selected == nil or not table.find(OptionsList, Selected) then
                    Selected = OptionsList[1]
                end

                local Count = math.max(#OptionsList, 1)
                local Gap = 4
                local OnTextColor = Color3.fromRGB(17, 17, 17)

                local Row = CreateRow(Title, M.SegRowH)

                local TitleLabel, Holder, BtnSize
                if M.Mobile then
                    -- Two-line layout: title on top, full-width segments underneath
                    TitleLabel = Create("TextLabel", {Size = UDim2.new(1, -M.Indent, 0, 24), Position = UDim2.new(0, M.Indent, 0, 4), BackgroundTransparency = 1, Text = Title, TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = M.TitleSize, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Row})
                    Holder = Create("Frame", {Size = UDim2.new(1, -M.Indent, 0, M.SegH), Position = UDim2.new(0, M.Indent, 0, 30), BackgroundColor3 = Theme.Search, Parent = Row})
                    BtnSize = UDim2.new(1 / Count, -math.ceil(Gap * (Count - 1) / Count), 1, 0)
                else
                    local BtnW = math.min(M.SegBtnW, math.floor((M.SegMaxW - 6 - (Count - 1) * Gap) / Count))
                    local ContW = Count * BtnW + (Count - 1) * Gap + 6
                    TitleLabel = Create("TextLabel", {Size = UDim2.new(1, -(M.Indent + ContW + 8), 1, 0), Position = UDim2.new(0, M.Indent, 0, 0), BackgroundTransparency = 1, Text = Title, TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = M.TitleSize, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Row})
                    Holder = Create("Frame", {Size = UDim2.new(0, ContW, 0, M.SegH), Position = UDim2.new(1, 0, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), BackgroundColor3 = Theme.Search, Parent = Row})
                    BtnSize = UDim2.new(0, BtnW, 1, 0)
                end

                Create("UICorner", {CornerRadius = UDim.new(0, 8), Parent = Holder})
                local HolderStroke = Create("UIStroke", {Color = Theme.Border, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = Holder})
                Create("UIPadding", {PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 3), PaddingTop = UDim.new(0, 3), PaddingBottom = UDim.new(0, 3), Parent = Holder})
                Create("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, Gap), Parent = Holder})

                local Buttons = {}

                local function Refresh()
                    for Option, B in Buttons do
                        local On = (Option == Selected)
                        TweenService:Create(B, TweenFast, {
                            BackgroundTransparency = On and 0 or 1,
                            TextColor3 = On and OnTextColor or Theme.TextSecondary
                        }):Play()
                    end
                end

                local function SetValue(Value, TriggerCallback)
                    if not table.find(OptionsList, Value) then return end
                    Selected = Value
                    Refresh()
                    if TriggerCallback then Callback(Selected) end
                end

                for Index, Option in OptionsList do
                    local On = (Option == Selected)
                    local B = Create("TextButton", {Size = BtnSize, BackgroundColor3 = Theme.Accent, BackgroundTransparency = On and 0 or 1, Text = Option, TextColor3 = On and OnTextColor or Theme.TextSecondary, Font = Theme.Font, TextSize = M.ControlTextSize, TextTruncate = Enum.TextTruncate.AtEnd, AutoButtonColor = false, LayoutOrder = Index, Parent = Holder})
                    Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = B})
                    Buttons[Option] = B
                    B.Activated:Connect(function() SetValue(Option, true) end)
                end

                ThemeUpdate(function()
                    TitleLabel.TextColor3 = Theme.TextPrimary
                    Holder.BackgroundColor3 = Theme.Search
                    HolderStroke.Color = Theme.Border
                    for _, B in Buttons do
                        B.BackgroundColor3 = Theme.Accent
                    end
                    Refresh()
                end)

                local SegmentedObj = {Row = Row}
                function SegmentedObj:GetComponentType() return "Segmented" end
                function SegmentedObj:GetValue() return Selected end
                function SegmentedObj:SetValue(val) SetValue(val, true) end

                Decorate(SegmentedObj, Row, TitleLabel, SOpts)
                Library.Flags[FlagName] = SegmentedObj
                return SegmentedObj
            end

            -- ButtonRow: several buttons side by side, e.g.
