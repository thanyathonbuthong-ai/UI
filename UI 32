                local Track = Create("TextButton", {Parent = SliderFrame, BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, 0, 0, M.PickerTrackY), Size = UDim2.new(1, 0, 0, M.PickerTrackHit), Text = "", AutoButtonColor = false, ZIndex = 3001})
                local Bar = Create("Frame", {Parent = Track, BackgroundColor3 = Theme.Search, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(1, 0, 0, M.PickerBar), ZIndex = 3001})
