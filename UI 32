            -- Space: empty gap. Columns = how many gap units (a horizontal gap inside a Group)
            function Obj:Space(SpOpts)
                Obj.LayoutOrder = Obj.LayoutOrder + 1
                local Columns = (SpOpts and SpOpts.Columns) or 1
                local Size = Columns * (M.Mobile and 6 or 8)

                local Outer
                if Mode == "group" then
                    Outer = Create("Frame", {Size = UDim2.new(0, Size, 0, 1), BackgroundTransparency = 1, LayoutOrder = Obj.LayoutOrder, Parent = ParentFrame})
                    Outer:SetAttribute("FixedW", Size)
                else
                    Outer = Create("Frame", {Size = UDim2.new(1, 0, 0, Size), BackgroundTransparency = 1, LayoutOrder = Obj.LayoutOrder, Parent = ParentFrame})
                end
                RegisterOuter(Outer, true)

                local SpaceObj = {}
                function SpaceObj:GetComponentType() return "Space" end
                function SpaceObj:Destroy()
                    Outer:Destroy()
                    if Obj.OnRowRemoved then Obj.OnRowRemoved(Outer) end
                end
                return SpaceObj
            end

            -- Image: Image (asset id, or a web URL when the executor can download files), AspectRatio (16/9 or "16:9"), Radius
            function Obj:Image(IOpts)
                local function ParseRatio(R)
                    if type(R) == "number" and R > 0 then return R end
                    if type(R) == "string" then
                        local A, B = string.match(R, "^%s*(%d+%.?%d*)%s*[:/]%s*(%d+%.?%d*)%s*$")
                        if A and tonumber(B) and tonumber(B) > 0 then return tonumber(A) / tonumber(B) end
                    end
                    return 16 / 9
                end
                local Ratio = ParseRatio(IOpts.AspectRatio)

                Obj.LayoutOrder = Obj.LayoutOrder + 1
                local Outer = Create("Frame", {Size = UDim2.new(1, 0, 0, 120), BackgroundTransparency = 1, LayoutOrder = Obj.LayoutOrder, Parent = ParentFrame})
                RegisterOuter(Outer, false)
                Create("UIPadding", {PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), Parent = Outer})

                local Img = Create("ImageLabel", {Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Theme.Search, ScaleType = Enum.ScaleType.Crop, Image = "", Parent = Outer})
                Create("UICorner", {CornerRadius = UDim.new(0, IOpts.Radius or 8), Parent = Img})

                -- keep the picture's shape when the window width changes
                local function Resize()
                    local W = Outer.AbsoluteSize.X
                    if W > 0 then
                        Outer.Size = UDim2.new(Outer.Size.X.Scale, Outer.Size.X.Offset, 0, math.floor(W / Ratio) + 8)
                    end
                end
                Outer:GetPropertyChangedSignal("AbsoluteSize"):Connect(Resize)
                task.defer(Resize)

                ThemeUpdate(function()
                    Img.BackgroundColor3 = Theme.Search
                end)

                if IOpts.Image then
                    ResolveRemoteImage(IOpts.Image, function(Asset) Img.Image = Asset end)
                end

                local ImageObj = {}
                function ImageObj:GetComponentType() return "Image" end
                function ImageObj:SetImage(Src)
                    ResolveRemoteImage(Src, function(Asset) Img.Image = Asset end)
                end

                Decorate(ImageObj, Img, nil, IOpts)
                return ImageObj
            end

            -- ProgressBar: Title, Desc, Value (default 0), Min / Max (default 0 / 100), Suffix (default "%")
            function Obj:ProgressBar(PBOpts)
                local Title = PBOpts.Title or "Progress"
                local Min = PBOpts.Min or 0
                local Max = PBOpts.Max or 100
                local Suffix = PBOpts.Suffix or "%"
                local Current = math.clamp(PBOpts.Value or PBOpts.Default or Min, Min, Max)

                local FlagName = PBOpts.Flag or string.format("%s/ProgressBar/%s", Obj.FlagPrefix, Title)

                local Row = CreateRow(Title, M.SliderRowH)

                local TitleLabel = Create("TextLabel", {Size = UDim2.new(1, -(M.Indent + 80), 0, 26), Position = UDim2.new(0, M.Indent, 0, 4), BackgroundTransparency = 1, Text = Title, TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = M.TitleSize, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Row})
                local ValueLabel = Create("TextLabel", {Size = UDim2.new(0, 80, 0, 26), Position = UDim2.new(1, -80, 0, 4), BackgroundTransparency = 1, Text = "", TextColor3 = Theme.TextPrimary, Font = Enum.Font.Code, TextSize = M.ValueSize, TextXAlignment = Enum.TextXAlignment.Right, Parent = Row})

                local Bar = Create("Frame", {Size = UDim2.new(1, -M.Indent, 0, M.SliderBar), Position = UDim2.new(0, M.Indent, 0, 40), BackgroundColor3 = Theme.Border, BorderSizePixel = 0, Parent = Row})
                Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Bar})
                local Fill = Create("Frame", {Size = UDim2.new((Current - Min) / (Max - Min), 0, 1, 0), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Parent = Bar})
                Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = Fill})

                local function Format(Value)
                    local Text = tostring(math.floor(Value * 10 + 0.5) / 10)
                    return Text .. Suffix
                end
                ValueLabel.Text = Format(Current)

                ThemeUpdate(function()
                    TitleLabel.TextColor3 = Theme.TextPrimary
                    ValueLabel.TextColor3 = Theme.TextPrimary
                    Bar.BackgroundColor3 = Theme.Border
                    Fill.BackgroundColor3 = Theme.Accent
                end)

                local function SetValue(Value)
                    Current = math.clamp(Value, Min, Max)
                    ValueLabel.Text = Format(Current)
                    TweenService:Create(Fill, TweenSmooth, {Size = UDim2.new((Current - Min) / (Max - Min), 0, 1, 0)}):Play()
                end

                local PBObj = {}
                function PBObj:GetComponentType() return "ProgressBar" end
                function PBObj:GetValue() return Current end
                function PBObj:SetValue(Value) SetValue(Value) end

                Decorate(PBObj, Row, TitleLabel, PBOpts)
                Library.Flags[FlagName] = PBObj
                return PBObj
            end

            -- Section: a heading. When elements are added to it, it becomes collapsible (tap the heading).
            -- Config: Title, Desc, TextSize, TextTransparency, Box, BoxBorder, Opened, Icon, Locked
            function Obj:Section(SOpts)
                SOpts = SOpts or {}
                local Title = SOpts.Title or "Section"
                local Opened = SOpts.Opened or false
                local Box = SOpts.Box or false
                local IconImage = ResolveIcon(SOpts.Icon)
                local TextSize = SOpts.TextSize or (M.Mobile and 15 or 18)
                local HeadH = (M.Mobile and 34 or 40) + ((SOpts.Desc and SOpts.Desc ~= "") and M.DescH or 0)

                local Outer = CreateAutoOuter()
                Create("UIPadding", {PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), Parent = Outer})

                local Container = Create("Frame", {Name = "SectionBox", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.Search, BackgroundTransparency = Box and 0.4 or 1, BorderSizePixel = 0, Parent = Outer})
                local BoxStroke
                if Box then
                    Create("UICorner", {CornerRadius = UDim.new(0, 10), Parent = Container})
                    Create("UIPadding", {PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 4), Parent = Container})
                    if SOpts.BoxBorder then
                        BoxStroke = Create("UIStroke", {Color = Theme.Border, Thickness = 1, Parent = Container})
                    end
                end
                Create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Parent = Container})

                local Header = Create("TextButton", {Size = UDim2.new(1, 0, 0, HeadH), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = 0, Parent = Container})

                local TextX = (Box and 4 or 0)
                if IconImage then
                    Create("ImageLabel", {Size = UDim2.new(0, TextSize, 0, TextSize), Position = UDim2.new(0, TextX, 0.5, -math.floor(TextSize / 2)), BackgroundTransparency = 1, Image = IconImage, ImageColor3 = Theme.TextPrimary, Parent = Header})
                    TextX = TextX + TextSize + 8
                end

                local Chevron = Create("ImageLabel", {Size = UDim2.new(0, 16, 0, 16), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -4, 0.5, 0), BackgroundTransparency = 1, Image = Icons.ChevronDown, ImageColor3 = Theme.TextSecondary, Rotation = Opened and 180 or 0, Visible = false, Parent = Header})

                local TitleLabel = Create("TextLabel", {Size = UDim2.new(1, -(TextX + 24), 1, 0), Position = UDim2.new(0, TextX, 0, 0), BackgroundTransparency = 1, Text = Title, TextColor3 = Theme.TextPrimary, TextTransparency = SOpts.TextTransparency or 0.05, Font = Theme.Font, TextSize = TextSize, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Header})

                local DescLabel
                local function EnsureDesc(Text)
                    if Text == nil or Text == "" then
                        if DescLabel then DescLabel.Visible = false end
                        return
                    end
                    if not DescLabel then
                        TitleLabel.Position = UDim2.new(0, TextX, 0, -math.floor(M.DescH / 2) - 1)
                        DescLabel = Create("TextLabel", {Size = UDim2.new(1, -(TextX + 24), 0, M.DescH), Position = UDim2.new(0, TextX, 0.5, 1), BackgroundTransparency = 1, Text = "", TextColor3 = Theme.TextSecondary, Font = Theme.Font, TextSize = M.DescSize, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Header})
                    end
                    DescLabel.Visible = true
                    DescLabel.Text = Text
                end

                local Body = Create("Frame", {Name = "SectionBody", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Visible = Opened, LayoutOrder = 1, Parent = Container})
                Create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Parent = Body})

                local HasChildren = false
                local SectionObj = {FlagPrefix = Obj.FlagPrefix, Elements = {}, LayoutOrder = 0}
                SectionObj.OnRowAdded = function()
                    if not HasChildren then
                        HasChildren = true
                        Chevron.Visible = true
                    end
                end

                local function SetOpened(State)
                    if not HasChildren then return end
                    Opened = State
                    Body.Visible = State
                    TweenService:Create(Chevron, TweenSmooth, {Rotation = State and 180 or 0}):Play()
                end

                Header.Activated:Connect(function()
                    SetOpened(not Opened)
                end)

                ThemeUpdate(function()
                    Container.BackgroundColor3 = Theme.Search
                    if BoxStroke then BoxStroke.Color = Theme.Border end
                    TitleLabel.TextColor3 = Theme.TextPrimary
                    Chevron.ImageColor3 = Theme.TextSecondary
                    if DescLabel then DescLabel.TextColor3 = Theme.TextSecondary end
                end)

                InstallElements(SectionObj, Body, (Mode == "group") and "group" or "section")

                function SectionObj:GetComponentType() return "Section" end
                Decorate(SectionObj, Container, nil, SOpts)

                function SectionObj:Open() SetOpened(true) end
                function SectionObj:Close() SetOpened(false) end
                function SectionObj:SetTitle(Text) TitleLabel.Text = Text end
                function SectionObj:SetDesc(Text) EnsureDesc(Text) end

                EnsureDesc(SOpts.Desc)
                return SectionObj
            end

            -- Group: puts its elements side by side, sharing the width equally.
            -- Space() between them is a fixed gap.   (HStack is the same thing)
            function Obj:Group(GOpts)
                local Outer = CreateAutoOuter()

                local Holder = Create("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = Outer})
                Create("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Top, SortOrder = Enum.SortOrder.LayoutOrder, Parent = Holder})

                local GroupObj = {FlagPrefix = Obj.FlagPrefix, Elements = {}, LayoutOrder = 0}
                local Cells = {}

                local function Relayout()
                    local Count, Fixed = 0, 0
                    for _, Cell in Cells do
                        local W = Cell:GetAttribute("FixedW")
                        if W then Fixed = Fixed + W else Count = Count + 1 end
                    end
                    if Count == 0 then return end

                    local Share = -math.ceil(Fixed / Count)
                    for _, Cell in Cells do
                        local W = Cell:GetAttribute("FixedW")
                        if W then
                            Cell.Size = UDim2.new(0, W, 0, Cell.Size.Y.Offset)
                        else
                            Cell.Size = UDim2.new(1 / Count, Share, 0, Cell.Size.Y.Offset)
                        end
                    end
                end

                GroupObj.OnRowAdded = function(Cell)
                    table.insert(Cells, Cell)
                    Relayout()
                end
                GroupObj.OnRowRemoved = function(Cell)
                    local Idx = table.find(Cells, Cell)
                    if Idx then table.remove(Cells, Idx) end
                    Relayout()
                end

                InstallElements(GroupObj, Holder, "group")

                function GroupObj:GetComponentType() return "Group" end
                function GroupObj:Destroy()
                    Outer:Destroy()
                    if Obj.OnRowRemoved then Obj.OnRowRemoved(Outer) end
                end
                return GroupObj
            end

            function Obj:HStack(GOpts)
                return Obj:Group(GOpts)
            end

            -- VStack: an invisible vertical container (useful inside a Group)
            function Obj:VStack(VOpts)
                local Outer = CreateAutoOuter()

                local Holder = Create("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = Outer})
                Create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Parent = Holder})

                local StackObj = {FlagPrefix = Obj.FlagPrefix, Elements = {}, LayoutOrder = 0}
                InstallElements(StackObj, Holder, (Mode == "group") and "group" or "section")

                function StackObj:GetComponentType() return "VStack" end
                function StackObj:Destroy()
                    Outer:Destroy()
                    if Obj.OnRowRemoved then Obj.OnRowRemoved(Outer) end
                end
                return StackObj
            end

        end

        TabObj.FlagPrefix = TabObj.Title
        TabObj.Elements = {}
        InstallElements(TabObj, TabContent, "tab")

        function TabObj:Select()
            ActivateTab()
        end

        function TabObj:LockAll()
            for _, Element in TabObj.Elements do
                if Element.Lock then Element:Lock() end
            end
        end

        function TabObj:UnlockAll()
            for _, Element in TabObj.Elements do
                if Element.Unlock then Element:Unlock() end
            end
        end

        function TabObj:GetLocked()
            local List = {}
            for _, Element in TabObj.Elements do
                if Element.IsLocked and Element:IsLocked() then table.insert(List, Element) end
            end
            return List
        end

        function TabObj:GetUnlocked()
            local List = {}
            for _, Element in TabObj.Elements do
                if Element.IsLocked and not Element:IsLocked() then table.insert(List, Element) end
            end
            return List
        end

        -- Scrolls the page so the Nth element is in view, then flashes it
        function TabObj:ScrollToTheElement(Index)
            local Element = TabObj.Elements[Index]
            if Element and Element._Outer then
                local Y = Element._Outer.AbsolutePosition.Y - TabContent.AbsolutePosition.Y + TabContent.CanvasPosition.Y
                TabContent.CanvasPosition = Vector2.new(0, math.max(Y - 8, 0))
                Element:Highlight()
            end
        end

        return TabObj
    end

    -- ===================== Window-level features (WindUI style) =====================

    local function VariantColors(Variant)
        if Variant == "Primary" then
            return Theme.Accent, Color3.fromRGB(17, 17, 17), Theme.Accent
        elseif Variant == "Tertiary" then
            return Theme.Main, Theme.TextSecondary, Theme.Border
        end
        return Theme.Search, Theme.TextPrimary, Theme.Border
    end

    -- Buttons used by Notify / Dialog / Popup. Info = {Title, Icon, Variant = "Primary" | "Secondary" | "Tertiary", Callback}
    local function MakeVariantButton(Parent, Info, OnDone, Order)
        local Variant = Info.Variant or "Secondary"
        local Bg, Tx, Br = VariantColors(Variant)
        local IconImage = ResolveIcon(Info.Icon)

        local Btn = Create("TextButton", {Size = UDim2.new(0, 0, 0, M.BtnH), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = Bg, BackgroundTransparency = (Variant == "Tertiary") and 1 or 0, Text = Info.Title or "Button", TextColor3 = Tx, Font = Theme.Font, TextSize = M.ControlTextSize, AutoButtonColor = false, LayoutOrder = Order or 0, Parent = Parent})
        Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = Btn})
        Create("UIStroke", {Color = Br, Thickness = 1, Transparency = (Variant == "Tertiary") and 1 or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = Btn})
        Create("UIPadding", {PaddingLeft = UDim.new(0, IconImage and 30 or 14), PaddingRight = UDim.new(0, 14), Parent = Btn})
        if IconImage then
            Create("ImageLabel", {Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(0, -22, 0.5, -7), BackgroundTransparency = 1, Image = IconImage, ImageColor3 = Tx, Parent = Btn})
        end

        Btn.Activated:Connect(function()
            if Info.Callback then
                local Ok, Err = pcall(Info.Callback)
                if not Ok then warn(Err) end
            end
            if OnDone then OnDone() end
        end)
        return Btn
    end

    -- ---- Notifications ----
    local NotifyHolder = Create("Frame", {Name = "Notifications", Size = UDim2.new(0, M.NotifW, 1, -20), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12), BackgroundTransparency = 1, ZIndex = 7000, Parent = ScreenGui})
    Create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8), VerticalAlignment = Enum.VerticalAlignment.Top, Parent = NotifyHolder})
    local NotifyCount = 0

    -- WindUI: WindUI:Notify({Title, Content, Icon, Duration, CanClose, Buttons})
    function WindowObj:Notify(Cfg)
        Cfg = Cfg or {}
        NotifyCount = NotifyCount + 1
        local Duration = Cfg.Duration or 5
        local CanClose = Cfg.CanClose ~= false
        local IconImage = ResolveIcon(Cfg.Icon)

        local Wrapper = Create("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = NotifyCount, Parent = NotifyHolder})
        local Card = Create("CanvasGroup", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(0, 40, 0, 0), BackgroundColor3 = Theme.Main, GroupTransparency = 1, Parent = Wrapper})
        Create("UICorner", {CornerRadius = UDim.new(0, 8), Parent = Card})
        Create("UIStroke", {Color = Theme.Border, Thickness = 1, Parent = Card})

        local Content = Create("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = Card})
        Create("UIPadding", {PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 13), Parent = Content})
        Create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), Parent = Content})

        local Head = Create("Frame", {Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, LayoutOrder = 1, Parent = Content})
        local TextX = 0
        if IconImage then
            Create("ImageLabel", {Size = UDim2.new(0, 18, 0, 18), Position = UDim2.new(0, 0, 0.5, -9), BackgroundTransparency = 1, Image = IconImage, ImageColor3 = Cfg.IconThemed and Theme.TextPrimary or Theme.Accent, Parent = Head})
            TextX = 26
        end
        Create("TextLabel", {Size = UDim2.new(1, -(TextX + (CanClose and 26 or 0)), 1, 0), Position = UDim2.new(0, TextX, 0, 0), BackgroundTransparency = 1, Text = Cfg.Title or "Notification", TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = M.TitleSize, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Head})

        local NotifObj = {}
        local Closed = false
        function NotifObj:Close()
            if Closed then return end
            Closed = true
            local Tw = TweenService:Create(Card, TweenSmooth, {Position = UDim2.new(0, 40, 0, 0), GroupTransparency = 1})
            Tw:Play()
            Tw.Completed:Once(function()
                Wrapper:Destroy()
            end)
        end

        if CanClose then
            local CloseBtn = Create("TextButton", {Size = UDim2.new(0, 24, 0, 24), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), BackgroundTransparency = 1, Text = "×", TextColor3 = Theme.TextSecondary, Font = Theme.Font, TextSize = 20, AutoButtonColor = false, Parent = Head})
            CloseBtn.Activated:Connect(function() NotifObj:Close() end)
        end

        if Cfg.Content and Cfg.Content ~= "" then
            Create("TextLabel", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Text = Cfg.Content, TextColor3 = Theme.TextSecondary, Font = Theme.Font, TextSize = M.ControlTextSize, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, RichText = true, LayoutOrder = 2, Parent = Content})
        end

        if Cfg.Buttons and #Cfg.Buttons > 0 then
            local BtnRow = Create("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 3, Parent = Content})
            Create("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Wraps = true, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), Parent = BtnRow})
            for Index, Info in Cfg.Buttons do
                MakeVariantButton(BtnRow, Info, function() NotifObj:Close() end, Index)
            end
        end

        -- Thin bar at the bottom counts down the remaining time
        local Bar = Create("Frame", {Size = UDim2.new(1, 0, 0, 3), Position = UDim2.new(0, 0, 1, -3), BackgroundColor3 = Theme.Border, BorderSizePixel = 0, ZIndex = 2, Parent = Card})
        local BarFill = Create("Frame", {Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, ZIndex = 3, Parent = Bar})

        TweenService:Create(Card, TweenSmooth, {Position = UDim2.new(0, 0, 0, 0), GroupTransparency = 0}):Play()
        if Duration > 0 and Duration < math.huge then
            TweenService:Create(BarFill, TweenInfo.new(Duration, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 1, 0)}):Play()
            task.delay(Duration, function() NotifObj:Close() end)
        else
            Bar.Visible = false
        end

        return NotifObj
    end

    -- On phones the floating button sits near the notifications; this moves them down a bit
    function WindowObj:SetNotificationLower(State)
        NotifyHolder.Position = State and UDim2.new(1, -12, 0, 70) or UDim2.new(1, -12, 0, 12)
    end

    -- ---- Dialog: modal panel over the window ----
    -- WindUI: Window:Dialog({Title, Content, Icon, Width, Buttons = {{Title, Icon, Variant, Callback}}})
    function WindowObj:Dialog(Cfg)
        Cfg = Cfg or {}
        local DialogObj = {}

        local Overlay = Create("TextButton", {Name = "DialogOverlay", Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Active = true, ZIndex = 500, Parent = MainFrame})

        local Width = math.clamp(Cfg.Width or 320, 180, 400)
        local MaxW = MainFrame.AbsoluteSize.X - 24
        if MaxW > 100 then Width = math.min(Width, MaxW) end

        local Panel = Create("Frame", {Size = UDim2.new(0, Width, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), BackgroundColor3 = Theme.Sidebar, BorderSizePixel = 0, ZIndex = 501, Parent = Overlay})
        Create("UICorner", {CornerRadius = UDim.new(0, 10), Parent = Panel})
        Create("UIStroke", {Color = Theme.Border, Thickness = 1, Parent = Panel})
        Create("UIPadding", {PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 14), Parent = Panel})
        Create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10), Parent = Panel})

        local IconImage = ResolveIcon(Cfg.Icon)
        local Head = Create("Frame", {Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, LayoutOrder = 1, Parent = Panel})
        local TextX = 0
        if IconImage then
            Create("ImageLabel", {Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(0, 0, 0.5, -10), BackgroundTransparency = 1, Image = IconImage, ImageColor3 = Cfg.IconThemed and Theme.TextPrimary or Theme.Accent, Parent = Head})
            TextX = 28
        end
        Create("TextLabel", {Size = UDim2.new(1, -TextX, 1, 0), Position = UDim2.new(0, TextX, 0, 0), BackgroundTransparency = 1, Text = Cfg.Title or "Dialog", TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = M.TitleSize + 2, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Head})

        if Cfg.Content and Cfg.Content ~= "" then
            Create("TextLabel", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Text = Cfg.Content, TextColor3 = Theme.TextSecondary, Font = Theme.Font, TextSize = M.ControlTextSize, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, RichText = true, LayoutOrder = 2, Parent = Panel})
        end

        local Closed = false
        function DialogObj:Close()
            if Closed then return end
            Closed = true
            local Tw = TweenService:Create(Overlay, TweenFast, {BackgroundTransparency = 1})
            Tw:Play()
            Panel.Visible = false
            Tw.Completed:Once(function()
                Overlay:Destroy()
            end)
        end

        if Cfg.Buttons and #Cfg.Buttons > 0 then
            local BtnRow = Create("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 3, Parent = Panel})
            Create("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, Wraps = true, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8), Parent = BtnRow})
            for Index, Info in Cfg.Buttons do
                MakeVariantButton(BtnRow, Info, function() DialogObj:Close() end, Index)
            end
        end

        TweenService:Create(Overlay, TweenFast, {BackgroundTransparency = 0.45}):Play()
        return DialogObj
    end

    -- ---- Popup: floating panel that does not block the window ----
    -- WindUI: WindUI:Popup({Title, Content, Icon, Thumbnail = {Image, Title}, Buttons})
    function WindowObj:Popup(Cfg)
        Cfg = Cfg or {}
        local PopupObj = {}
        local Thumb = Cfg.Thumbnail

        local Width = Thumb and 340 or 300
        local ScreenW = ScreenGui.AbsoluteSize.X
        if ScreenW > 100 then Width = math.min(Width, ScreenW - 24) end

        local Panel = Create("Frame", {Name = "Popup", Size = UDim2.new(0, Width, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), BackgroundColor3 = Theme.Sidebar, BorderSizePixel = 0, ZIndex = 6500, Parent = ScreenGui})
        Create("UICorner", {CornerRadius = UDim.new(0, 10), Parent = Panel})
        Create("UIStroke", {Color = Theme.Border, Thickness = 1, Parent = Panel})
        Create("UIPadding", {PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 14), Parent = Panel})
        Create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10), Parent = Panel})

        if Thumb and Thumb.Image then
            local ThumbImg = Create("ImageLabel", {Size = UDim2.new(1, 0, 0, 110), BackgroundColor3 = Theme.Main, ScaleType = Enum.ScaleType.Crop, Image = "", LayoutOrder = 1, ZIndex = 6501, Parent = Panel})
            Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = ThumbImg})
            ResolveRemoteImage(Thumb.Image, function(Asset) ThumbImg.Image = Asset end)
            if Thumb.Title then
                Create("TextLabel", {Size = UDim2.new(1, -16, 0, 22), Position = UDim2.new(0, 8, 1, -28), BackgroundTransparency = 1, Text = Thumb.Title, TextColor3 = Color3.fromRGB(255, 255, 255), Font = Theme.Font, TextSize = M.ControlTextSize, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 6502, Parent = ThumbImg})
            end
        end

        local IconImage = ResolveIcon(Cfg.Icon)
        local Head = Create("Frame", {Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, LayoutOrder = 2, ZIndex = 6501, Parent = Panel})
        local TextX = 0
        if IconImage then
            Create("ImageLabel", {Size = UDim2.new(0, 20, 0, 20), Position = UDim2.new(0, 0, 0.5, -10), BackgroundTransparency = 1, Image = IconImage, ImageColor3 = Cfg.IconThemed and Theme.TextPrimary or Theme.Accent, ZIndex = 6502, Parent = Head})
            TextX = 28
        end
        Create("TextLabel", {Size = UDim2.new(1, -TextX, 1, 0), Position = UDim2.new(0, TextX, 0, 0), BackgroundTransparency = 1, Text = Cfg.Title or "Popup", TextColor3 = Theme.TextPrimary, Font = Theme.Font, TextSize = M.TitleSize + 2, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 6502, Parent = Head})

        if Cfg.Content and Cfg.Content ~= "" then
            Create("TextLabel", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Text = Cfg.Content, TextColor3 = Theme.TextSecondary, Font = Theme.Font, TextSize = M.ControlTextSize, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, RichText = true, LayoutOrder = 3, ZIndex = 6501, Parent = Panel})
        end

        local Closed = false
        function PopupObj:Close()
            if Closed then return end
            Closed = true
            Panel:Destroy()
        end

        if Cfg.Buttons and #Cfg.Buttons > 0 then
            local BtnRow = Create("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 4, ZIndex = 6501, Parent = Panel})
            Create("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, Wraps = true, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8), Parent = BtnRow})
            for Index, Info in Cfg.Buttons do
                local Btn = MakeVariantButton(BtnRow, Info, function() PopupObj:Close() end, Index)
                Btn.ZIndex = 6502
            end
        end

        return PopupObj
    end

    -- ---- Tags: small chips shown in the header next to the tab title ----
    local TagBar, TagLayout

    local function UpdateTagBar()
        if not TagBar then return end
        local X = M.HeaderTitleX + HeaderTitle.TextBounds.X + 10
        TagBar.Position = UDim2.new(0, X, 0.5, 0)
        -- hide the tags when they would run into the search bar
        TagBar.Visible = (X + TagLayout.AbsoluteContentSize.X) <= (Header.AbsoluteSize.X - M.ActionsW)
    end

    -- WindUI: Window:Tag({Title, Icon, Color, Radius})
    function WindowObj:Tag(Cfg)
        Cfg = Cfg or {}
        if not TagBar then
            TagBar = Create("Frame", {Name = "Tags", Size = UDim2.new(0, 0, 0, 22), AutomaticSize = Enum.AutomaticSize.X, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), BackgroundTransparency = 1, Parent = Header})
            TagLayout = Create("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), Parent = TagBar})
            HeaderTitle:GetPropertyChangedSignal("TextBounds"):Connect(UpdateTagBar)
            Header:GetPropertyChangedSignal("AbsoluteSize"):Connect(UpdateTagBar)
            TagLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(UpdateTagBar)
        end

        local Chip = Create("Frame", {Size = UDim2.new(0, 0, 0, 22), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = Cfg.Color or Theme.Search, BorderSizePixel = 0, Parent = TagBar})
        Create("UICorner", {CornerRadius = UDim.new(0, Cfg.Radius or 6), Parent = Chip})
        Create("UIPadding", {PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = Chip})
        Create("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4), Parent = Chip})

        local TextColor = Cfg.Color and Color3.fromRGB(255, 255, 255) or Theme.TextPrimary
        local IconImage = ResolveIcon(Cfg.Icon)
        if IconImage then
            Create("ImageLabel", {Size = UDim2.new(0, 12, 0, 12), BackgroundTransparency = 1, Image = IconImage, ImageColor3 = TextColor, LayoutOrder = 1, Parent = Chip})
        end
        local Label = Create("TextLabel", {Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, Text = Cfg.Title or "Tag", TextColor3 = TextColor, Font = Theme.Font, TextSize = 12, LayoutOrder = 2, Parent = Chip})

        ThemeUpdate(function()
            if not Cfg.Color then
                Chip.BackgroundColor3 = Theme.Search
                Label.TextColor3 = Theme.TextPrimary
            end
        end)

        local TagObj = {}
        function TagObj:SetTitle(Text) Label.Text = Text end
        function TagObj:SetColor(Color)
            Cfg.Color = Color
            Chip.BackgroundColor3 = Color
            Label.TextColor3 = Color3.fromRGB(255, 255, 255)
        end
        function TagObj:Destroy() Chip:Destroy() end
        task.defer(UpdateTagBar)
        return TagObj
    end

    -- ---- Sidebar: Divider and Section ----
    function WindowObj:Divider()
        local Line = Create("Frame", {Size = UDim2.new(0, M.SidebarW - 28, 0, 1), BackgroundColor3 = Theme.Border, BorderSizePixel = 0, Parent = Sidebar})
        ThemeUpdate(function()
            Line.BackgroundColor3 = Theme.Border
        end)
        local DividerObj = {}
        function DividerObj:Destroy() Line:Destroy() end
        return DividerObj
    end

    -- WindUI: Window:Section({Title, Opened}) then Section:Tab({...}). The sidebar here only has icons,
    -- so the section shows as a small caption that opens / closes the tabs under it.
    function WindowObj:Section(Cfg)
        Cfg = Cfg or {}
        local Title = Cfg.Title or "Section"
        local Opened = Cfg.Opened or false

        local Holder = Create("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = Sidebar})
        Create("UIListLayout", {HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, M.SidebarPad), Parent = Holder})

        local Head = Create("TextButton", {Size = UDim2.new(1, -6, 0, 20), BackgroundTransparency = 1, Text = string.upper(Title), TextColor3 = Opened and Theme.Accent or Theme.TextSecondary, Font = Theme.Font, TextSize = 9, TextTruncate = Enum.TextTruncate.AtEnd, AutoButtonColor = false, LayoutOrder = 0, Parent = Holder})

        local TabsFrame = Create("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Visible = Opened, LayoutOrder = 1, Parent = Holder})
        Create("UIListLayout", {HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, M.SidebarPad), Parent = TabsFrame})

        local HasTabs = false
        local SecObj = {}

        local function SetOpened(State)
            if not HasTabs then return end
            Opened = State
            TabsFrame.Visible = State
            Head.TextColor3 = State and Theme.Accent or Theme.TextSecondary
        end

        Head.Activated:Connect(function()
            SetOpened(not Opened)
        end)

        ThemeUpdate(function()
            Head.TextColor3 = Opened and Theme.Accent or Theme.TextSecondary
        end)

        function SecObj:Tab(TabCfg)
            local Copy = table.clone(TabCfg or {})
            Copy.SidebarParent = TabsFrame
            HasTabs = true
            local NewTab = WindowObj:Tab(Copy)
            -- the first tab is selected automatically, so its section opens too
            if WindowObj.CurrentTab == NewTab then SetOpened(true) end
            return NewTab
        end
        function SecObj:Open() SetOpened(true) end
        function SecObj:Close() SetOpened(false) end
        function SecObj:Destroy() Holder:Destroy() end

        return SecObj
    end

    Library.ActiveWindow = WindowObj

    WindowObj.ConfigTab = WindowObj:Tab({Title = "Configuration", Icon = Icons.Save, IsConfig = true})
    SaveBtn.Activated:Connect(function()
        WindowObj.ConfigTab:Activate()
    end)

    return WindowObj
end

return Library
