                        task.delay(1.2, function()
                            if CopyBtn.Parent then CopyBtn.Text = "Copy" end
                        end)
                    end
                })

                local TextSize = M.ControlTextSize - 1
                local function BoxHeight()
                    local _, Newlines = string.gsub(CodeText, "\n", "\n")
                    return math.min((Newlines + 1) * (TextSize + 3) + 16, M.CodeMaxH)
                end

                local Scroll = Create("ScrollingFrame", {Size = UDim2.new(1, 0, 0, BoxHeight()), BackgroundColor3 = Theme.Main, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Border, ScrollingDirection = Enum.ScrollingDirection.XY, CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.XY, LayoutOrder = 2, Parent = Card})
                Create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = Scroll})
                Create("UIPadding", {PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), Parent = Scroll})
                local CodeLabel = Create("TextLabel", {Size = UDim2.new(0, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.XY, BackgroundTransparency = 1, Text = CodeText, TextColor3 = Theme.TextPrimary, Font = Enum.Font.Code, TextSize = TextSize, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = false, Parent = Scroll})

                ThemeUpdate(function()
                    Card.BackgroundColor3 = Theme.Search
                    CardStroke.Color = Theme.Border
                    TitleLabel.TextColor3 = Theme.TextPrimary
                    Scroll.BackgroundColor3 = Theme.Main
                    Scroll.ScrollBarImageColor3 = Theme.Border
                    CodeLabel.TextColor3 = Theme.TextPrimary
                end)

                local CodeObj = {}
                function CodeObj:GetComponentType() return "Code" end
                function CodeObj:GetValue() return CodeText end
                function CodeObj:SetCode(Text)
                    CodeText = Text or ""
                    CodeLabel.Text = CodeText
                    Scroll.Size = UDim2.new(1, 0, 0, BoxHeight())
                end

                Decorate(CodeObj, Card, nil, COpts)
                function CodeObj:SetTitle(Text) TitleLabel.Text = Text end
                return CodeObj
            end

            -- Divider: a thin line (vertical when it is inside a Group)
            function Obj:Divider()
                Obj.LayoutOrder = Obj.LayoutOrder + 1
                local InGroup = (Mode == "group")
                local Outer = Create("Frame", {Size = UDim2.new(1, 0, 0, 12), BackgroundTransparency = 1, LayoutOrder = Obj.LayoutOrder, Parent = ParentFrame})
                local Line
                if InGroup then
                    Outer:SetAttribute("FixedW", 12)
                    Line = Create("Frame", {Size = UDim2.new(0, 1, 1, 0), Position = UDim2.new(0.5, 0, 0, 0), BackgroundColor3 = Theme.Border, BorderSizePixel = 0, Parent = Outer})
                else
                    Line = Create("Frame", {Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = Theme.Border, BorderSizePixel = 0, Parent = Outer})
                end
                ThemeUpdate(function()
                    Line.BackgroundColor3 = Theme.Border
                end)
                RegisterOuter(Outer, true)

                local DividerObj = {}
                function DividerObj:GetComponentType() return "Divider" end
                function DividerObj:Destroy()
