local function Create(Class, Properties)
    local Inst = Instance.new(Class)
    for Key, Value in Properties do
        Inst[Key] = Value
    end
    return Inst
end

local function FormatKeyName(KeyEnum)
    if not KeyEnum then return "" end
    local KeyName = KeyEnum.Name
    if KeyName == "MouseButton1" then return "MB1" end
    if KeyName == "MouseButton2" then return "MB2" end
    if KeyName == "MouseButton3" then return "MB3" end
    return KeyName
end

-- ===================== Input helpers (mouse + touch) =====================

local function IsPointerDown(Input)
    return Input.UserInputType == Enum.UserInputType.MouseButton1
        or Input.UserInputType == Enum.UserInputType.Touch
end

local function IsPointerMove(Input)
    return Input.UserInputType == Enum.UserInputType.MouseMovement
        or Input.UserInputType == Enum.UserInputType.Touch
end

local function IsInside(Pos, Obj)
    local P, S = Obj.AbsolutePosition, Obj.AbsoluteSize
    return Pos.X >= P.X and Pos.X <= P.X + S.X and Pos.Y >= P.Y and Pos.Y <= P.Y + S.Y
end

-- Button looks: "Default" | "Accent" | "Danger"
local function ButtonColors(Style)
    if Style == "Accent" then
        return Theme.Accent, Color3.fromRGB(17, 17, 17), Theme.Accent
    elseif Style == "Danger" then
        return Theme.Danger, Color3.fromRGB(255, 255, 255), Theme.Danger
    end
    return Theme.Search, Theme.TextPrimary, Theme.Border
end

local function PressFlash(Btn, Stroke, Style)
    if Style == "Accent" or Style == "Danger" then
        Btn.BackgroundTransparency = 0.35
        TweenService:Create(Btn, TweenFast, {BackgroundTransparency = 0}):Play()
    else
        TweenService:Create(Stroke, TweenFast, {Color = Theme.Accent}):Play()
        task.delay(0.15, function()
            TweenService:Create(Stroke, TweenFast, {Color = Theme.Border}):Play()
        end)
    end
end

-- Keeps a draggable object on screen (Keep = minimum visible size in pixels)
local function ClampToScreen(Gui, ScreenSize, Pos, Keep)
    local Size = Gui.AbsoluteSize
    local Anchor = Gui.AnchorPoint
    local X = Pos.X.Scale * ScreenSize.X + Pos.X.Offset - Anchor.X * Size.X
    local Y = Pos.Y.Scale * ScreenSize.Y + Pos.Y.Offset - Anchor.Y * Size.Y

    local MinX = Keep.X - Size.X
    local MaxX = math.max(ScreenSize.X - Keep.X, MinX)
    local MaxY = math.max(ScreenSize.Y - Keep.Y, 0)

    local NX = math.clamp(X, MinX, MaxX)
    local NY = math.clamp(Y, 0, MaxY)

    return UDim2.new(Pos.X.Scale, Pos.X.Offset + (NX - X), Pos.Y.Scale, Pos.Y.Offset + (NY - Y))
end

-- Touch/mouse drag for Target using Handle. OnTap fires when released without moving.
local function MakeDraggable(Handle, Target, ScreenGui, Keep, OnTap)
    local ActiveInput, StartPointer, StartPos, Moved

    Handle.InputBegan:Connect(function(Input)
        if ActiveInput or not IsPointerDown(Input) then return end
        ActiveInput = Input
        StartPointer = Vector2.new(Input.Position.X, Input.Position.Y)
        StartPos = Target.Position
        Moved = false

        local Conn
        Conn = Input.Changed:Connect(function()
            if Input.UserInputState == Enum.UserInputState.End then
                Conn:Disconnect()
                ActiveInput = nil
                if not Moved and OnTap then OnTap() end
            end
        end)
    end)

    UserInputService.InputChanged:Connect(function(Input)
        if not ActiveInput then return end
        if Input ~= ActiveInput and Input.UserInputType ~= Enum.UserInputType.MouseMovement then return end

        local Delta = Vector2.new(Input.Position.X, Input.Position.Y) - StartPointer
        if not Moved then
            if Delta.Magnitude < 8 then return end
            Moved = true
        end

        local NewPos = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + Delta.X, StartPos.Y.Scale, StartPos.Y.Offset + Delta.Y)
        Target.Position = ClampToScreen(Target, ScreenGui.AbsoluteSize, NewPos, Keep)
    end)
end

