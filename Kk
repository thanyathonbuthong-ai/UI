local prevCamLook = Camera.CFrame.LookVector
local prevCamPos = Camera.CFrame.Position
local currentMotionBlurSize = 0
local currentOcclusionFactor = 0

RunService.RenderStepped:Connect(function(dt)
    if not Camera then return end
    local vp = Camera.ViewportSize
    local camPos = Camera.CFrame.Position
    local camLook = Camera.CFrame.LookVector
    local dtClamp = math.clamp(dt, 0.001, 0.1)

    if ShadersState.MotionBlurEnabled then
        local lookDelta = (camLook - prevCamLook).Magnitude / dtClamp
        local posDelta = (camPos - prevCamPos).Magnitude / dtClamp
        local motionEnergy = math.clamp((lookDelta * 1.6) + (posDelta * 0.04), 0, 1)
        local targetBlur = motionEnergy * (ShadersState.MotionBlurScale * 22)
        currentMotionBlurSize = currentMotionBlurSize + (targetBlur - currentMotionBlurSize) * math.clamp(dt * 12, 0, 1)

        local base = ShadersState.FXAAGodraysEnabled and ShadersState.FXAABlurSize or 0
        local finalSize = math.clamp(math.round(base + currentMotionBlurSize), 0, 56)
        FXAABlur.Size = finalSize
        FXAABlur.Enabled = finalSize > 0
    end
    prevCamLook = camLook
    prevCamPos = camPos

    if ShadersState.SSAOEnabled then
        Lighting.ShadowSoftness = 0.02
        local rayParams = RaycastParams.new()
        pcall(function() rayParams.FilterType = RaycastExcludeType end)
        local filterList = {RainFolder}
        if LocalPlayer.Character then table.insert(filterList, LocalPlayer.Character) end
        rayParams.FilterDescendantsInstances = filterList

        local offsets = {
            Vector3.new(0, -5, 0),
            Vector3.new(-4, -3, 0),
            Vector3.new(4, -3, 0),
            Vector3.new(0, 4, 0),
            Vector3.new(0, 0, -5)
        }
        local hits = 0
        for _, off in ipairs(offsets) do
            local dir = Camera.CFrame:VectorToWorldSpace(off)
            if workspace:Raycast(camPos, dir, rayParams) then
                hits = hits + 1
            end
        end

        local occRatio = (hits / #offsets) * ShadersState.SSAOIntensity
        currentOcclusionFactor = currentOcclusionFactor + (occRatio - currentOcclusionFactor) * math.clamp(dt * 6, 0, 1)
        local baseDiffuse = ShadersState.OriginalLighting.EnvironmentDiffuseScale or 1
        Lighting.EnvironmentDiffuseScale = math.clamp(baseDiffuse * (1 - currentOcclusionFactor * 0.65), 0.1, 1)
    end

    if ShadersState.FilmGrainEnabled then
        FilmGrainFrame.ImageTransparency = math.clamp(1 - (ShadersState.GrainOpacity * 0.32), 0, 1)
        FilmGrainFrame.Position = UDim2.new(0, math.random(-4, 4) - 12, 0, math.random(-4, 4) - 12)
    else
        FilmGrainFrame.ImageTransparency = 1
    end

    if ShadersState.LetterboxEnabled then
        LetterboxTop.Visible = true
        LetterboxBottom.Visible = true
        local targetH = math.max(0, math.floor((vp.Y - (vp.X / 2.39)) * 0.5))
        if targetH < 10 then targetH = math.floor(vp.Y * 0.1) end
        LetterboxTop.Size = LetterboxTop.Size:Lerp(UDim2.new(1, 0, 0, targetH), math.clamp(dt * 10, 0, 1))
        LetterboxBottom.Size = LetterboxBottom.Size:Lerp(UDim2.new(1, 0, 0, targetH), math.clamp(dt * 10, 0, 1))
    else
        LetterboxTop.Size = UDim2.new(1, 0, 0, 0)
        LetterboxBottom.Size = UDim2.new(1, 0, 0, 0)
        LetterboxTop.Visible = false
        LetterboxBottom.Visible = false
    end

    if ShadersState.AberrationEnabled then
        AberrationFrame.Visible = true
        local trans = math.clamp(1 - (ShadersState.AberrationStrength * 0.55), 0, 1)
        AberrationRedStroke.Transparency = trans
        AberrationCyanStroke.Transparency = trans
        local off = math.clamp(math.round(ShadersState.AberrationStrength * 3.5), 1, 5)
        AberrationRed.Position = UDim2.new(0, -off, 0, 0)
        AberrationCyan.Position = UDim2.new(0, off, 0, 0)
    else
        AberrationFrame.Visible = false
    end
end)

