local AllTabs = {}
local function maakTab(name)
    local targetVTabName = ShaderTabMap[name] or name
    local vTab = getOrCreateShaderTab(targetVTabName)

    local dummyPage = Instance.new("Frame")
    dummyPage.Name = name .. "Page"
    dummyPage.Size = UDim2.new(0, 0, 0, 0)
    dummyPage.Visible = false
    dummyPage.BackgroundTransparency = 1
    dummyPage.Parent = ScreenGui

    local tabObj = {
        Name = name,
        TargetTabName = targetVTabName,
        VTab = vTab,
        Page = dummyPage,
        CurrentSection = nil,
        CurrentSide = "left",
        LeftCount = 0,
        RightCount = 0
    }

    function tabObj:VoegSectieToe(label)
        local side = "left"
        if tabObj.LeftCount > tabObj.RightCount then
            side = "right"
        end
        local sectionTitle = label
        if name ~= targetVTabName and not string.find(string.lower(label), string.lower(name)) then
            sectionTitle = name .. ": " .. label
        end
        local sec = vTab:Section{
            name = sectionTitle,
            side = side
        }
        tabObj.CurrentSection = sec
        tabObj.CurrentSide = side
        return sec
    end
    tabObj.AddSection = tabObj.VoegSectieToe

    function tabObj:VoegKnopToe(label, cb)
        if not tabObj.CurrentSection then
            tabObj:VoegSectieToe("Main")
        end
        if tabObj.CurrentSide == "left" then
            tabObj.LeftCount = tabObj.LeftCount + 1
        else
            tabObj.RightCount = tabObj.RightCount + 1
        end
        return tabObj.CurrentSection:Button{
            name = label,
            callback = function()
                if cb then task.spawn(cb) end
            end
        }
    end
    tabObj.AddButton = tabObj.VoegKnopToe

    function tabObj:VoegSchakelaarToe(label, default, cb)
        if not tabObj.CurrentSection then
            tabObj:VoegSectieToe("Main")
        end
        if tabObj.CurrentSide == "left" then
            tabObj.LeftCount = tabObj.LeftCount + 1
        else
            tabObj.RightCount = tabObj.RightCount + 1
        end
        local state = default or false
        local vToggle = tabObj.CurrentSection:Toggle{
            name = label,
            default = state,
            callback = function(val)
                if cb then task.spawn(cb, val) end
            end
        }
        local function setToggle(val)
            if vToggle and vToggle.Toggle then
                vToggle:Toggle(val)
            end
        end
        return setToggle
    end
    tabObj.AddToggle = tabObj.VoegSchakelaarToe

    function tabObj:VoegSchuifToe(label, minV, maxV, defaultV, cb)
        if not tabObj.CurrentSection then
            tabObj:VoegSectieToe("Main")
        end
        if tabObj.CurrentSide == "left" then
            tabObj.LeftCount = tabObj.LeftCount + 1.4
        else
            tabObj.RightCount = tabObj.RightCount + 1.4
        end
        local val = defaultV or minV
        minV = minV or 0
        maxV = maxV or 100
        return tabObj.CurrentSection:Slider{
            name = label,
            min = minV,
            max = maxV,
            default = val,
            float = 1,
            callback = function(v)
                if cb then task.spawn(cb, v) end
            end
        }
    end
    tabObj.AddSlider = tabObj.VoegSchuifToe

    function tabObj:VoegInvoerToe(placeholder, btnTxt, cb)
        if not tabObj.CurrentSection then
            tabObj:VoegSectieToe("Input")
        end
        if tabObj.CurrentSide == "left" then
            tabObj.LeftCount = tabObj.LeftCount + 1.5
        else
            tabObj.RightCount = tabObj.RightCount + 1.5
        end
        local textVal = ""
        tabObj.CurrentSection:Box{
            name = btnTxt or "Input",
            default = "",
            placeholder = placeholder or "",
            callback = function(str)
                textVal = str
            end
        }
        tabObj.CurrentSection:Button{
            name = "Submit: " .. (btnTxt or "Load"),
            callback = function()
                if cb then task.spawn(cb, textVal) end
            end
        }
    end
    tabObj.AddInput = tabObj.VoegInvoerToe

    function tabObj:VoegLabelToe(text)
        if not tabObj.CurrentSection then
            tabObj:VoegSectieToe("Main")
        end
        return tabObj.CurrentSection:Label(text)
    end
    tabObj.AddLabel = tabObj.VoegLabelToe

    table.insert(AllTabs, tabObj)
    return tabObj
end

