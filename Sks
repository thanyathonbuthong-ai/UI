							currentKey = (input.UserInputType == Enum.UserInputType.Keyboard) and input.KeyCode or input.UserInputType
						end
						keyBtn.Text = keyName(currentKey); listening = false; conn:Disconnect()
						if o.Callback then task.delay(0, function() pcall(o.Callback, currentKey) end) end
					end
				end)
			end)
			local el = { Set = function(_, k) currentKey = k; keyBtn.Text = keyName(currentKey) end, Get = function() return keyName(currentKey) end, Instance = row }
			RegisterFlag(o.Flag, function(v) el:Set(v) end, function() return el:Get() end)
			return el
		end

		function C:Label(text)
			local lbl = Create("TextLabel", { Size = UDim2.new(1,0,0,18), BackgroundTransparency = 1, Text = tostring(text), Font = CurrentFont, TextSize = 12, TextColor3 = Theme.TextDim, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 200, Parent = parent }); lbl:SetAttribute("Role","dim")
			return { Set = function(_, t) lbl.Text = tostring(t) end, Instance = lbl }
		end

		function C:Paragraph(o)
			o = o or {}
			local holder = Create("Frame", { Size = UDim2.new(1,0,0,0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ZIndex = 200, Parent = parent })
			if o.Title then
				local t = Create("TextLabel", { Size = UDim2.new(1,0,0,16), BackgroundTransparency = 1, Text = o.Title, Font = CurrentFontBold, TextSize = 13, TextColor3 = Theme.TextColor, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 201, Parent = holder }); t:SetAttribute("Role","text"); t:SetAttribute("Bold", true)
			end
			local c = Create("TextLabel", { Size = UDim2.new(1,0,0,0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(0,0,0, o.Title and 18 or 0), BackgroundTransparency = 1, Text = o.Content or "", Font = CurrentFont, TextSize = 11, TextColor3 = Theme.TextDim, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, ZIndex = 201, Parent = holder }); c:SetAttribute("Role","dim")
			return { Instance = holder }
		end

		function C:Space()
			return Create("Frame", { Size = UDim2.new(1,0,0,6), BackgroundTransparency = 1, Parent = parent })
		end

		function C:Divider()
			local f = Create("Frame", { Size = UDim2.new(1,-10,0,1), Position = UDim2.new(0,5,0,0), BackgroundColor3 = Theme.Outline, BackgroundTransparency = 0.5, BorderSizePixel = 0, Parent = parent })
			f:SetAttribute("Role", "stroke")
			return f
		end

		function C:Section(o)
			o = o or {}
			local sec = Create("Frame", { Size = UDim2.new(1,0,0,0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ZIndex = 200, Parent = parent })
			if o.Title then
				local h = Create("TextLabel", { Size = UDim2.new(1,0,0,16), BackgroundTransparency = 1, Text = o.Title, Font = CurrentFontBold, TextSize = 12, TextColor3 = Theme.TextColor, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 201, Parent = sec }); h:SetAttribute("Role","text"); h:SetAttribute("Bold", true)
			end
			local inner = Create("Frame", { Size = UDim2.new(1,0,0,0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(0,0,0, o.Title and 20 or 0), BackgroundTransparency = 1, Parent = sec })
			Create("UIListLayout", { Padding = UDim.new(0,4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = inner })
			return BuildElementContainer(inner)
		end

		return C
	end

	local tabOrder = 0
	function self:Tab(cfg)
		cfg = cfg or {}
		tabOrder = tabOrder + 1
		local btn = Create("TextButton", { Size = UDim2.new(1,0,0,24), BackgroundTransparency = 1, Text = cfg.Title or "Tab", Font = CurrentFont, TextSize = 12, TextColor3 = Theme.TextDim, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = tabOrder, ZIndex = 32, Parent = TabsFrame })
		btn:SetAttribute("Role","tab"); btn:SetAttribute("Selected", tabOrder == 1)
		self.TabButtons[cfg.Title or tabOrder] = btn
		local page = Create("Frame", { Size = UDim2.new(1,0,0,0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Visible = (tabOrder==1), ZIndex = 31, Parent = Content })
		Create("UIListLayout", { Padding = UDim.new(0,4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = page })
		self.Pages[cfg.Title or tabOrder] = page
		if tabOrder == 1 then btn.TextColor3 = Theme.TextColor end
		btn.MouseButton1Click:Connect(function()
			for _, b in pairs(self.TabButtons) do b.TextColor3 = Theme.TextDim; b:SetAttribute("Selected", false) end
			btn.TextColor3 = Theme.TextColor; btn:SetAttribute("Selected", true)
			for _, p in pairs(self.Pages) do p.Visible = false end
			page.Visible = true
			pcall(function() Content.CanvasPosition = Vector2.new(0,0) end)
			CloseAllDropdowns()
		end)
		return BuildElementContainer(page)
	end

	return self
end

return Library
