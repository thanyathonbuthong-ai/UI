-- ConfigManager (แบบ Wind UI: Flag + Save/Load JSON) ---------------------------
local function CreateConfigManager(window, folder)
	local basePath = "SupremacyUI/" .. (folder or "default") .. "/config/"
	pcall(function() if isfolder and not isfolder(basePath) then makefolder(basePath) end end)
	local CM = {}
	CM.PendingFlags = window.PendingFlags
	function CM:AllConfigs()
		local list = {}
		pcall(function()
			if listfiles then
				for _, f in ipairs(listfiles(basePath)) do
					local name = f:match("([^/\\]+)%.json$")
					if name then table.insert(list, name) end
				end
			end
		end)
		return list
	end
	local function ConfigModule(name)
		local self2 = {}
		self2.Name = name
		self2.CustomData = {}
		local path = basePath .. name .. ".json"
		function self2:Save()
			local data = { Flags = {}, Custom = self2.CustomData }
			for flag, reg in pairs(CM.PendingFlags) do
				local ok, val = pcall(function() return reg.Get() end)
				if ok then data.Flags[flag] = val end
			end
			local ok, err = pcall(function() writefile(path, HttpService:JSONEncode(data)) end)
			return ok, err
		end
		function self2:Load()
			local ok, raw = pcall(function() return readfile(path) end)
			if not ok or not raw then return false, "file not found" end
			local ok2, data = pcall(function() return HttpService:JSONDecode(raw) end)
			if not ok2 or type(data) ~= "table" then return false, "bad json" end
			if type(data.Flags) == "table" then
				for flag, val in pairs(data.Flags) do
					local reg = CM.PendingFlags[flag]
					if reg then pcall(function() reg.Set(val) end) end
				end
			end
			if type(data.Custom) == "table" then self2.CustomData = data.Custom end
			return true
		end
		function self2:Delete()
			return pcall(function() delfile(path) end)
		end
		function self2:Set(key, value) self2.CustomData[key] = value end
		function self2:Get(key) return self2.CustomData[key] end
		return self2
	end
	function CM:Config(name) return ConfigModule(name) end
	function CM:CreateConfig(name) return ConfigModule(name) end
	function CM:DeleteConfig(name) return pcall(function() delfile(basePath .. name .. ".json") end) end
	return CM
end

