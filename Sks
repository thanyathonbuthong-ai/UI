				HexBox.Name = "Hex"
				HexBox.Parent = Panel
				HexBox.BackgroundColor3 = Theme.Row
				HexBox.BorderSizePixel = 0
				HexBox.Position = UDim2.new(0, 10, 0, 118)
				HexBox.Size = UDim2.new(0, 100, 0, 24)
				HexBox.Font = Enum.Font.Gotham
				HexBox.Text = ""
				HexBox.TextColor3 = Theme.Text
				HexBox.TextSize = 13
				HexBox.ClearTextOnFocus = false
				Corner(HexBox, 4)
				Stroke(HexBox, Theme.Off, 1)
			
				local RBBtn = Instance.new("TextButton")
				RBBtn.Name = "Rainbow"
				RBBtn.Parent = Panel
				RBBtn.AnchorPoint = Vector2.new(1, 0)
				RBBtn.BackgroundColor3 = Theme.Row
				RBBtn.BorderSizePixel = 0
				RBBtn.Position = UDim2.new(1, -10, 0, 118)
				RBBtn.Size = UDim2.new(0, 90, 0, 24)
				RBBtn.AutoButtonColor = false
				RBBtn.Font = Enum.Font.GothamSemibold
				RBBtn.Text = "Rainbow"
				RBBtn.TextColor3 = Theme.Text
				RBBtn.TextSize = 12
				Corner(RBBtn, 4)
			
				local function Render(fire)
					color = Color3.fromHSV(hue, sat, val)
					Swatch.BackgroundColor3 = color
					Swatch.BackgroundTransparency = alpha
					SV.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
					SVSel.Position = UDim2.new(sat, 0, 1 - val, 0)
					HueSel.Position = UDim2.new(0.5, 0, hue, 0)
					if AlphaFill then
						AlphaFill.BackgroundColor3 = color
						AlphaSel.Position = UDim2.new(0.5, 0, alpha, 0)
					end
					if not HexBox:IsFocused() then
						HexBox.Text = "#" .. string.upper(color:ToHex())
					end
					if fire then
						task.spawn(cb, color, alpha)
					end
				end
			
				local function Rel(gui, pos)
					local inset = GuiService:GetGuiInset()
					local x = math.clamp((pos.X - gui.AbsolutePosition.X) / math.max(gui.AbsoluteSize.X, 1), 0, 1)
					local y = math.clamp((pos.Y - inset.Y - gui.AbsolutePosition.Y) / math.max(gui.AbsoluteSize.Y, 1), 0, 1)
					return x, y
				end
			
				local function BindDrag(gui, onMove, blockOnRainbow)
					local active = nil
					gui.InputBegan:Connect(function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
							if locked or (blockOnRainbow and rainbow) then
								return
							end
							active = input
							InputLock = true
							NewPages.ScrollingEnabled = false
							onMove(Rel(gui, input.Position))
						end
					end)
					UserInputService.InputChanged:Connect(function(input)
						if not active then
							return
						end
						if (input.UserInputType == Enum.UserInputType.MouseMovement and active.UserInputType == Enum.UserInputType.MouseButton1)
							or (input.UserInputType == Enum.UserInputType.Touch and input == active) then
							onMove(Rel(gui, input.Position))
						end
					end)
					UserInputService.InputEnded:Connect(function(input)
						if active and (input == active or (input.UserInputType == Enum.UserInputType.MouseButton1 and active.UserInputType == Enum.UserInputType.MouseButton1)) then
							active = nil
							InputLock = false
							NewPages.ScrollingEnabled = true
						end
					end)
				end
			
				BindDrag(SV, function(x, y)
					sat = x
					val = 1 - y
					Render(true)
				end)
				BindDrag(Hue, function(_, y)
					hue = y
					Render(true)
				end, true)
				if AlphaBar then
					BindDrag(AlphaBar, function(_, y)
						alpha = y
						Render(true)
					end)
				end
			
				HexBox.FocusLost:Connect(function()
					local txt = HexBox.Text:gsub("#", "")
					local ok, col = pcall(Color3.fromHex, txt)
					if ok and col and #txt == 6 then
						hue, sat, val = Color3.toHSV(col)
						Render(true)
					else
						Render(false)
					end
				end)
			
				local function SetRainbow(on)
					rainbow = on
					Tween(RBBtn, {BackgroundColor3 = on and Theme.Accent or Theme.Row}, .2)
					if rbConn then
						rbConn:Disconnect()
						rbConn = nil
					end
					if on then
						sat, val = 1, 1
						rbConn = RunService.Heartbeat:Connect(function(dt)
							if not Row:IsDescendantOf(game) then
								SetRainbow(false)
								return
							end
							hue = (hue + dt * 0.25) % 1
							Render(true)
						end)
					end
				end
				RBBtn.MouseButton1Click:Connect(function()
					if locked then
						return
					end
					SetRainbow(not rainbow)
				end)
			
				local function SetOpen(state)
					if state and locked then
						return
					end
					open = state
					if open then
						Panel.Visible = true
						Panel:TweenSize(Wd(HP, PANEL_H), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, .25, true)
					else
						Panel:TweenSize(Wd(HP, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, .25, true)
						task.delay(.27, function()
							if not open then
								Panel.Visible = false
							end
						end)
					end
				end
				Row.MouseButton1Click:Connect(function()
					if locked then
						LockedNotice(opts.LockedTitle)
						return
					end
					SetOpen(not open)
				end)
			
				Render(false)
			
				local obj = {Type = "Colorpicker"}
				function obj:Get()
					return color
				end
				function obj:GetTransparency()
					return alpha
				end
				function obj:Set(col, silent, t)
					if typeof(col) == "Color3" then
						hue, sat, val = Color3.toHSV(col)
					end
					if t ~= nil then
						alpha = math.clamp(tonumber(t) or 0, 0, 1)
					end
					Render(not silent)
				end
				function obj:SetTransparency(t, silent)
					alpha = math.clamp(tonumber(t) or 0, 0, 1)
					Render(not silent)
				end
				function obj:SetTitle(t)
					T.Text = tostring(t)
				end
				function obj:Lock()
					locked = true
					SetLockedVisual(T, D, true)
					SetOpen(false)
				end
				function obj:Unlock()
					locked = false
					SetLockedVisual(T, D, false)
				end
				return RegisterFlag(opts.Flag, obj)
			end
			return ElementHandler
		end

		return MakeElements(NewPages)

	end
	
