--[[
================================================================================
  Supremacy UI Library  v3  (โครงสร้าง API เหมือน Wind UI ครบถ้วน + เอกลักษณ์ Supremacy)
--------------------------------------------------------------------------------
  - โครงสร้างเหมือน Wind UI: CreateWindow({Title, Icon, Author, Theme, Folder, ToggleKey})
    Window:Tab({Title, Icon}) -> Tab:Toggle/Button/Slider/Dropdown/Input/Colorpicker/Keybind
    Tab:Section({Title}), Tab:Space(), Tab:Paragraph({Title, Content}), Tab:Divider()
  - ระบบธีม 16 ธีมแบบ Wind UI (SetTheme/AddTheme/GetThemes/OnThemeChange) เปลี่ยนตอนรันได้
  - ConfigManager จริง (Flag, Save/Load/Delete, AllConfigs) ใช้ writefile/readfile + JSON
  - Notification แบบ toast stack (Title/Content/Icon/Duration/CanClose + progress bar)
    Library:SetNotificationLower(true) หลบปุ่ม Jump มือถือ
  - SetFont ทุก Enum.Font, Dialog modal, Keybind รองรับทั้ง Keyboard/Mouse
  - ยังคงเอกลักษณ์: Open button ลากได้, header ลากได้, สไตล์มืด, ชื่อ Supremacy
================================================================================
  วิธีใช้:
    local Supremacy = loadstring(game:HttpGet("URL"))()
    local Window = Supremacy:CreateWindow({ Title = "My Hub", Theme = "Dark", Folder = "MyHub", ToggleKey = Enum.KeyCode.RightShift })
    local Tab = Window:Tab({ Title = "Main" })
    Tab:Toggle({ Title = "Silent Aim", Value = false, Flag = "silentaim", Callback = function(v) end })
    Tab:Slider({ Title = "FOV", Value = { Min = 0, Max = 100, Default = 50 }, Flag = "fov", Callback = function(v) end })
    Tab:Dropdown({ Title = "Aim Part", Values = {"Head","Torso"}, Value = "Head", Callback = function(v) end })
    Tab:Input({ Title = "Prefix", Placeholder = "Enter...", Callback = function(v) end })
    Tab:Colorpicker({ Title = "ESP Color", Default = Color3.fromHex("#ff0000"), Callback = function(c) end })
    Tab:Keybind({ Title = "Aim Key", Value = "X", Callback = function(k) end })
    Supremacy:Notify({ Title = "Loaded", Content = "Welcome!", Duration = 5 })
    Window.ConfigManager:Config("default"):Save()  -- บันทึกทุก element ที่มี Flag
================================================================================
]]

