				Stroke(SVSel, Color3.new(1, 1, 1), 2)
			
				local Hue = Instance.new("Frame")
				Hue.Name = "Hue"
				Hue.Parent = Panel
				Hue.AnchorPoint = Vector2.new(1, 0)
				Hue.BackgroundColor3 = Color3.new(1, 1, 1)
				Hue.BorderSizePixel = 0
				Hue.Position = UDim2.new(1, -(10 + (useAlpha and 26 or 0)), 0, 10)
				Hue.Size = UDim2.new(0, 20, 0, 100)
				Corner(Hue, 4)
				local HG = Instance.new("UIGradient")
				HG.Rotation = 90
				HG.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
					ColorSequenceKeypoint.new(1 / 6, Color3.fromHSV(1 / 6, 1, 1)),
					ColorSequenceKeypoint.new(2 / 6, Color3.fromHSV(2 / 6, 1, 1)),
					ColorSequenceKeypoint.new(3 / 6, Color3.fromHSV(3 / 6, 1, 1)),
					ColorSequenceKeypoint.new(4 / 6, Color3.fromHSV(4 / 6, 1, 1)),
					ColorSequenceKeypoint.new(5 / 6, Color3.fromHSV(5 / 6, 1, 1)),
					ColorSequenceKeypoint.new(1, Color3.fromHSV(0, 1, 1))
				})
				HG.Parent = Hue
			
				local function MakeBarSel(parent)
					local Sel = Instance.new("Frame")
					Sel.Name = "Selector"
					Sel.Parent = parent
					Sel.AnchorPoint = Vector2.new(0.5, 0.5)
					Sel.BackgroundColor3 = Color3.new(1, 1, 1)
					Sel.BorderSizePixel = 0
					Sel.Size = UDim2.new(1, 6, 0, 4)
					Sel.ZIndex = 3
					Corner(Sel, 2)
					Stroke(Sel, Color3.new(0, 0, 0), 1)
					return Sel
				end
				local HueSel = MakeBarSel(Hue)
			
				local AlphaBar, AlphaFill, AlphaSel
				if useAlpha then
					AlphaBar = Instance.new("Frame")
					AlphaBar.Name = "Alpha"
					AlphaBar.Parent = Panel
					AlphaBar.AnchorPoint = Vector2.new(1, 0)
					AlphaBar.BackgroundColor3 = Theme.Off
					AlphaBar.BorderSizePixel = 0
					AlphaBar.Position = UDim2.new(1, -10, 0, 10)
					AlphaBar.Size = UDim2.new(0, 20, 0, 100)
					Corner(AlphaBar, 4)
					AlphaFill = Instance.new("Frame")
					AlphaFill.Name = "Fill"
					AlphaFill.Parent = AlphaBar
					AlphaFill.BackgroundColor3 = color
					AlphaFill.BorderSizePixel = 0
					AlphaFill.Size = UDim2.new(1, 0, 1, 0)
					Corner(AlphaFill, 4)
					local AG = Instance.new("UIGradient")
					AG.Rotation = 90
					AG.Transparency = NumberSequence.new(0, 1)
					AG.Parent = AlphaFill
					AlphaSel = MakeBarSel(AlphaBar)
				end
			
