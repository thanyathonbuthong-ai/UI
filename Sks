			local row = Create("TextButton", { Size = UDim2.new(1,0,0,22), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 200, Parent = parent })
			local lbl = Create("TextLabel", { Size = UDim2.new(1,-80,1,0), BackgroundTransparency = 1, Text = o.Title or "Select", Font = CurrentFont, TextSize = 12, TextColor3 = Theme.TextColor, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 201, Parent = row }); lbl:SetAttribute("Role","text")
			local w = o.Width or 70
			local selectLabel = Create("TextButton", { Size = UDim2.new(0,w,0,14), Position = UDim2.new(1,-w-8,0.5,-7), BackgroundColor3 = Theme.ButtonBg, BorderSizePixel = 0, Text = tostring(selected), Font = CurrentFontBold, TextSize = 11, TextColor3 = Theme.WhiteOnButton and Color3.fromRGB(255,255,255) or Color3.fromRGB(20,20,20), AutoButtonColor = false, ZIndex = 202, Parent = row }); selectLabel:SetAttribute("Role","buttonBg"); selectLabel:SetAttribute("Bold", true)
			local dd = Create("ScrollingFrame", { Size = UDim2.new(0,w,0,0), BackgroundColor3 = Theme.DialogBg, BorderSizePixel = 0, Visible = false, ScrollBarThickness = 4, CanvasSize = UDim2.new(0,0,0,0), AutomaticCanvasSize = Enum.AutomaticSize.Y, ClipsDescendants = true, ZIndex = 60, Parent = Main }); dd:SetAttribute("Role","dialog")
			Create("UIListLayout", { Padding = UDim.new(0,2), Parent = dd })
			local optButtons = {}
			local function refresh()
				for nm, b in pairs(optButtons) do local sel = tostring(nm)==tostring(selected); b.BackgroundColor3 = sel and Theme.OptionSelected or Theme.OptionNormal; b:SetAttribute("Selected", sel) end
			end
			local function buildOptions()
				for _, b in pairs(optButtons) do b:Destroy() end
				optButtons = {}
				for _, nm in ipairs(options) do
					local b = Create("TextButton", { Size = UDim2.new(1,0,0,20), BackgroundColor3 = (tostring(nm)==tostring(selected)) and Theme.OptionSelected or Theme.OptionNormal, Text = tostring(nm), TextColor3 = Color3.fromRGB(255,255,255), TextSize = 10, Font = CurrentFontBold, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 61, BorderSizePixel = 0, AutoButtonColor = false, Parent = dd })
					b:SetAttribute("Role","option"); b:SetAttribute("Selected", tostring(nm)==tostring(selected)); b:SetAttribute("Bold", true)
					b.MouseButton1Click:Connect(function() selected = nm; selectLabel.Text = tostring(nm); refresh(); dd.Visible = false; table.clear(self.OpenDropdowns); if o.Callback then task.delay(0, function() pcall(o.Callback, nm) end) end end)
					optButtons[nm] = b
				end
			end
			buildOptions()
			local function toggle()
				if dd.Visible then dd.Visible = false; self.OpenDropdowns[dd] = nil; return end
				CloseAllDropdowns()
				local absPos, absSize = selectLabel.AbsolutePosition, selectLabel.AbsoluteSize
				local mainAbs, mainSize = Main.AbsolutePosition, Main.AbsoluteSize
				local h = #options*20 + (#options-1)*2
				local y = absPos.Y - mainAbs.Y + absSize.Y + 2
				if y + h > mainSize.Y - 8 then y = math.max(8, mainSize.Y - h - 8) end
				dd.Size = UDim2.new(0, math.floor(absSize.X), 0, math.min(h, 120)); dd.Position = UDim2.new(0, absPos.X - mainAbs.X, 0, y)
				dd.Visible = true; self.OpenDropdowns[dd] = dd; self._dropIgnoreUntil = tick() + 0.25; refresh()
			end
			row.MouseButton1Click:Connect(toggle); selectLabel.MouseButton1Click:Connect(toggle)
			local el = {
				Set = function(_, v) selected = v; selectLabel.Text = tostring(v); refresh(); if o.Callback then pcall(o.Callback, v) end end,
				Get = function() return selected end,
				Refresh = function(_, newValues) if newValues then options = newValues; buildOptions() end end,
				Instance = row,
			}
			RegisterFlag(o.Flag, function(v) el:Set(v) end, function() return el:Get() end)
			return el
		end

