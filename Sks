local function OnTheme(fn)
	table.insert(ThemeHooks, fn)
end

local function ApplyTheme(def)
	local list = {}
	for _, k in ipairs(ThemeKeys) do
		if def[k] and Theme[k] ~= def[k] then
			table.insert(list, {Theme[k], def[k]})
		end
	end
	local function map(c)
		for _, p in ipairs(list) do
			if c == p[1] then
				return p[2]
			end
		end
		return c
	end
	for _, lib in ipairs(Libraries) do
		if lib and lib.Parent then
			for _, d in ipairs(lib:GetDescendants()) do
				pcall(function()
					if d:IsA("GuiObject") then
						d.BackgroundColor3 = map(d.BackgroundColor3)
					end
					if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
						d.TextColor3 = map(d.TextColor3)
						if d:IsA("TextBox") then
							d.PlaceholderColor3 = map(d.PlaceholderColor3)
						end
					end
					if d:IsA("ImageLabel") or d:IsA("ImageButton") then
						d.ImageColor3 = map(d.ImageColor3)
					end
					if d:IsA("ScrollingFrame") then
						d.ScrollBarImageColor3 = map(d.ScrollBarImageColor3)
					end
					if d:IsA("UIStroke") then
						d.Color = map(d.Color)
					end
					if d:IsA("UIGradient") then
						local kps = {}
						for _, kp in ipairs(d.Color.Keypoints) do
							table.insert(kps, ColorSequenceKeypoint.new(kp.Time, map(kp.Value)))
						end
						d.Color = ColorSequence.new(kps)
					end
				end)
			end
		end
	end
	for _, k in ipairs(ThemeKeys) do
		if def[k] then
			Theme[k] = def[k]
		end
	end
	Theme.Muted = Theme.On
	for _, fn in ipairs(ThemeHooks) do
		pcall(fn)
	end
end
local IconRegistry = {}
local NotifyRef = nil
local LucideLib = nil
local LucideTried = false

-- โหลดชุดไอคอน Lucide (latte-soft/lucide-roblox) ครั้งแรกที่ใช้ชื่อไอคอน เช่น Icon = "bird" หรือ "lucide:bird"
local function LoadLucide()
	if LucideTried then
		return LucideLib ~= nil
	end
	LucideTried = true
	local ok, lib = pcall(function()
		return loadstring(game:HttpGet("https://github.com/latte-soft/lucide-roblox/releases/latest/download/lucide-roblox.luau"))()
	end)
	if ok and type(lib) == "table" and lib.GetAsset then
		LucideLib = lib
	end
	return LucideLib ~= nil
end

-- คืนค่า: id, rectOffset, rectSize
local function ResolveIcon(icon)
	if icon == nil or icon == "" then
		return nil
	end
	if type(icon) == "number" then
		return "rbxassetid://" .. tostring(icon)
	end
	if type(icon) ~= "string" then
		return nil
	end
	if icon:find("^rbxassetid://") or icon:find("^rbxasset://") or icon:find("^rbxthumb://") then
		return icon
	end
	if tonumber(icon) then
		return "rbxassetid://" .. icon
	end
	local reg = IconRegistry[icon] or IconRegistry[icon:lower()]
	if reg then
		if type(reg) == "number" then
			return "rbxassetid://" .. tostring(reg)
		end
		return reg
	end
	local name = (icon:lower():gsub("^lucide:", ""))
	if name:find(":") then
		return nil -- solar:/geist:/sfsymbols: ยังไม่รองรับ
	end
	if not LucideTried then
		LoadLucide()
	end
	if LucideLib then
		local ok, asset = pcall(LucideLib.GetAsset, name, 48)
		if ok and asset then
			return asset.Url, asset.ImageRectOffset, asset.ImageRectSize
		end
	end
	return nil
end

local function MakeIcon(parent, icon, size, color)
	local id, off, rsize = ResolveIcon(icon)
	if not id then
		return nil
	end
	local I = Instance.new("ImageLabel")
	I.Name = "Icon"
	I.Parent = parent
	I.BackgroundTransparency = 1
	I.BorderSizePixel = 0
	I.Size = UDim2.new(0, size or 16, 0, size or 16)
	I.Image = id
	if off and rsize then
		I.ImageRectOffset = off
		I.ImageRectSize = rsize
	end
	I.ImageColor3 = color or Theme.Text
	return I
end

local function ParseRatio(v, default)
	if type(v) == "string" then
		local w, h = v:match("^(%d+%.?%d*):(%d+%.?%d*)$")
		if w and h and tonumber(h) > 0 then
			return tonumber(w) / tonumber(h)
		end
	elseif type(v) == "number" and v > 0 then
		return v
	end
	return default or (16 / 9)
end
