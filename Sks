		function C:Slider(o)
			o = o or {}
			local v = o.Value or {}
			local minV, maxV = v.Min or 0, v.Max or 100
			local defV = math.clamp(v.Default or minV, minV, maxV)
			local container = Create("Frame", { Size = UDim2.new(1,0,0,42), BackgroundTransparency = 1, ZIndex = 200, Parent = parent })
			local topRow = Create("Frame", { Size = UDim2.new(1,0,0,18), BackgroundTransparency = 1, ZIndex = 200, Parent = container })
			local lbl = Create("TextLabel", { Size = UDim2.new(1,-60,1,0), BackgroundTransparency = 1, Text = o.Title or "Slider", Font = CurrentFont, TextSize = 12, TextColor3 = Theme.TextColor, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 201, Parent = topRow }); lbl:SetAttribute("Role","text")
			local valueBox = Create("TextBox", { Size = UDim2.new(0,52,0,14), Position = UDim2.new(1,-58,0,2), BackgroundColor3 = Theme.ButtonBg, BorderSizePixel = 0, Text = FormatNum(defV), Font = CurrentFontBold, TextSize = 10, TextColor3 = Theme.WhiteOnButton and Color3.fromRGB(255,255,255) or Color3.fromRGB(20,20,20), TextXAlignment = Enum.TextXAlignment.Center, ClearTextOnFocus = true, ZIndex = 201, Parent = topRow }); valueBox:SetAttribute("Role","buttonBg"); valueBox:SetAttribute("Bold", true)
			local bar = Create("Frame", { Size = UDim2.new(1,-8,0,8), Position = UDim2.new(0,0,0,26), BackgroundColor3 = Theme.BarOff, BorderSizePixel = 0, ZIndex = 201, Parent = container }); bar:SetAttribute("Role","sliderBar")
			Create("UICorner", { CornerRadius = UDim.new(1,0), Parent = bar })
			local pct0 = (maxV > minV) and ((defV - minV)/(maxV-minV)) or 0
			local thumb = Create("Frame", { Size = UDim2.new(0,10,0,10), Position = UDim2.new(pct0, -5, 0.5, -5), BackgroundColor3 = Theme.SliderThumb, BorderSizePixel = 0, ZIndex = 202, Parent = bar }); thumb:SetAttribute("Role","sliderThumb")
			Create("UICorner", { CornerRadius = UDim.new(1,0), Parent = thumb })
			local currentValue = defV; local dragging = false; local lastCb, pending = 0, nil
			local step = o.Step or 1
			local function Update(value, forceCb)
				value = math.clamp(math.floor(value / step + 0.5) * step, minV, maxV)
				currentValue = value
				local p = (maxV > minV) and ((value-minV)/(maxV-minV)) or 0
				thumb.Position = UDim2.new(p, -5, 0.5, -5); valueBox.Text = FormatNum(value)
				if not o.Callback then return end
				local now = tick()
				if forceCb or (now - lastCb) >= 0.12 then lastCb = now; pending = nil; local v2 = value; task.delay(0, function() pcall(o.Callback, v2) end) else pending = value end
			end
			valueBox.FocusLost:Connect(function() local num = tonumber(valueBox.Text:gsub("[,%s]","")); if num then Update(num, true) else valueBox.Text = FormatNum(currentValue) end end)
			bar.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; local pos = (UserInputService:GetMouseLocation().X - bar.AbsolutePosition.X)/bar.AbsoluteSize.X; Update(minV + pos*(maxV-minV), false) end end)
			UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false; if pending ~= nil then local v2 = pending; pending = nil; if o.Callback then task.delay(0, function() pcall(o.Callback, v2) end) end end end end)
			UserInputService.InputChanged:Connect(function(input) if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then local pos = (input.Position.X - bar.AbsolutePosition.X)/bar.AbsoluteSize.X; Update(minV + pos*(maxV-minV), false) end end)
			local el = { Set = function(_, val) Update(tonumber(val) or defV, true) end, Get = function() return currentValue end, Instance = container }
			RegisterFlag(o.Flag, function(v) el:Set(v) end, function() return el:Get() end)
			return el
		end

		function C:Dropdown(o)
			o = o or {}
