		local function MakeElements(Container)
			local ElementHandler = {}

			-- ===================== Button =====================
			function ElementHandler:Button(a, b)
				local opts = type(a) == "table" and a or {Title = a, Callback = b}
				local title = opts.Title or "Text Button"
				local desc = opts.Desc
				local cb = opts.Callback or function() end
				local locked = opts.Locked == true
				local base = opts.Color or Theme.Row
				local hover = base:Lerp(Color3.new(1, 1, 1), 0.06)
				if not opts.Color then
					OnTheme(function()
						base = Theme.Row
						hover = base:Lerp(Color3.new(1, 1, 1), 0.06)
					end)
				end

				local Btn = MakeRow(Container, "TextButton", desc and 46 or 32)
				Btn.Name = "Button"
				Btn.BackgroundColor3 = base

				local align = (opts.Justify == "Left") and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center
				local T = Instance.new("TextLabel")
				T.Name = "ButtonTitle"
				T.Parent = Btn
				T.BackgroundTransparency = 1
				T.Position = UDim2.new(0, 14, 0, desc and 6 or 0)
				T.Size = UDim2.new(1, -28, 0, desc and 18 or 32)
				T.Font = Enum.Font.Gotham
				T.Text = tostring(title)
				T.TextColor3 = Theme.Text
				T.TextSize = 14
				T.TextXAlignment = align
				T.TextTruncate = Enum.TextTruncate.AtEnd

				local D = nil
				if desc then
					D = Instance.new("TextLabel")
					D.Name = "ButtonDesc"
					D.Parent = Btn
					D.BackgroundTransparency = 1
					D.Position = UDim2.new(0, 14, 0, 24)
					D.Size = UDim2.new(1, -28, 0, 16)
					D.Font = Enum.Font.Gotham
					D.Text = tostring(desc)
					D.TextColor3 = Theme.SubText
					D.TextSize = 12
					D.TextXAlignment = align
					D.TextTruncate = Enum.TextTruncate.AtEnd
				end
				-- Icon (IconAlign = "Left" | "Right")
				local BIcon = MakeIcon(Btn, opts.Icon, 16)
				if BIcon then
					local right = opts.IconAlign == "Right"
					BIcon.AnchorPoint = Vector2.new(right and 1 or 0, 0.5)
					BIcon.Position = UDim2.new(right and 1 or 0, right and -14 or 14, 0, desc and 23 or 16)
					local tx = right and 14 or 38
					T.Position = UDim2.new(0, tx, 0, desc and 6 or 0)
					T.Size = UDim2.new(1, -52, 0, desc and 18 or 32)
					if D then
						D.Position = UDim2.new(0, tx, 0, 24)
						D.Size = UDim2.new(1, -52, 0, 16)
					end
				end
				SetLockedVisual(T, D, locked)
				
				Btn.MouseEnter:Connect(function()

					if not locked then
						Tween(Btn, {BackgroundColor3 = hover})
					end
				end)
				Btn.MouseLeave:Connect(function()
					Tween(Btn, {BackgroundColor3 = base})
				end)

				local function Flash()
					Tween(Btn, {BackgroundColor3 = Theme.Accent}, .15)
					Tween(T, {TextSize = 12}, .15)
					task.delay(.2, function()
						Tween(Btn, {BackgroundColor3 = base}, .2)
						Tween(T, {TextSize = 14}, .2)
					end)
				end

				Btn.MouseButton1Click:Connect(function()
					if locked then
						LockedNotice(opts.LockedTitle)
						return
					end
					Flash()
					task.spawn(cb)
				end)

				local obj = {Type = "Button"}
				function obj:Highlight()
					Flash()
				end
				function obj:SetTitle(t)
					T.Text = tostring(t)
				end
				function obj:SetDesc(t)
					if D then
						D.Text = tostring(t)
					end
				end
				function obj:Lock()
					locked = true
					SetLockedVisual(T, D, true)
				end
				function obj:Unlock()
					locked = false
					SetLockedVisual(T, D, false)
				end
				function obj:Destroy()
					Btn:Destroy()
				end
				return obj
			end

			-- ===================== Toggle (Box / Switch / Checkbox) =====================
			function ElementHandler:Toggle(a, b)
				local opts = type(a) == "table" and a or {Title = a, Callback = b}
				local desc = opts.Desc
				local cb = opts.Callback or function() end
