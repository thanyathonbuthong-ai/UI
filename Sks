			-- ===================== Dropdown (เลือกอันเดียว / เลือกหลายอัน + Icon / Desc / Search / Divider) =====================
			function ElementHandler:Dropdown(a, b, c)
				local opts = type(a) == "table" and a or {Title = a, Values = b, Callback = c}
				local title = opts.Title or "Dropdown"
				local desc = opts.Desc
				local multi = opts.Multi == true
				local allowNone = opts.AllowNone
				if allowNone == nil then
					allowNone = multi
				end
				local cb = opts.Callback or function() end
				local locked = opts.Locked == true
				local searchable = opts.SearchBarEnabled == true or opts.Search == true
				local open = false
				local items = {}
				local selected = {}
				local MAXH = opts.MaxHeight or 170
				local query = ""
				local SearchBox = nil
			
				local function Normalize(list)
					local out = {}
					for _, v in ipairs(list or {}) do
						if type(v) == "table" then
							if v.Type == "Divider" then
								table.insert(out, {Type = "Divider"})
							else
								table.insert(out, {
									Title = tostring(v.Title or v.Name or ""),
									Desc = v.Desc,
									Icon = v.Icon,
									Callback = v.Callback,
									Locked = v.Locked
								})
							end
						else
							table.insert(out, {Title = tostring(v)})
						end
					end
					return out
				end
				items = Normalize(opts.Values)
			
				local Header = MakeRow(Container, "TextButton", desc and 46 or 32)
				Header.Name = "Dropdown"
				HoverRow(Header)
				local T, D = RowTitle(Header, title, desc, 200)
				SetLockedVisual(T, D, locked)
			
				local Current = Instance.new("TextLabel")
				Current.Name = "CurrentSelection"
				Current.Parent = Header
				Current.AnchorPoint = Vector2.new(1, 0)
				Current.BackgroundTransparency = 1
				Current.Position = UDim2.new(1, -38, 0, desc and 6 or 0)
