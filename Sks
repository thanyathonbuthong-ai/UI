-- ความกว้างของแถว: ปกติ 375px / ถ้าอยู่ใน Section ที่ Fill ให้เต็มความกว้างของกล่อง
local function Wd(parent, h)
	if parent and parent:GetAttribute("Fill") then
		return UDim2.new(1, 0, 0, h)
	end
	return UDim2.new(0, 375, 0, h)
end

-- ใช้กับ Group: แบ่งความกว้างเท่า ๆ กัน (UIFlexItem)
local function FlexFill(gui)
	local ok, f = pcall(function()
		local x = Instance.new("UIFlexItem")
		x.FlexMode = Enum.UIFlexMode.Fill
		return x
	end)
	if ok and f then
		f.Parent = gui
		return true
	end
	return false
end
local function MakeRow(parent, className, height)
	local R = Instance.new(className)
	R.Name = "Row"
	R.Parent = parent
	R.BackgroundColor3 = Theme.Row
	R.BorderSizePixel = 0
	if parent:GetAttribute("InGroup") then
		R.Size = UDim2.new(0, 0, 0, height)
		if not FlexFill(R) then
			R.Size = UDim2.new(0.5, -3, 0, height)
		end
	else
		R.Size = Wd(parent, height)
	end
	if className == "TextButton" then
		R.AutoButtonColor = false
		R.Text = ""
	end
	return R
end

local function HoverRow(row)
	row.MouseEnter:Connect(function()
		Tween(row, {BackgroundColor3 = Theme.RowHover})
	end)
	row.MouseLeave:Connect(function()
		Tween(row, {BackgroundColor3 = Theme.Row})
	end)
end

