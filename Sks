					if open then
						Holder.Visible = true
						Holder:TweenSize(Wd(HP, ContentHeight()), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, .25, true)
					else
						Holder:TweenSize(Wd(HP, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, .25, true)
						task.delay(.27, function()
							if not open then
								Holder.Visible = false
							end
						end)
					end
				end
			
				Header.MouseButton1Click:Connect(function()
					if locked then
						LockedNotice(opts.LockedTitle)
						return
					end
					SetOpen(not open)
				end)
			
				local function SetSelection(v)
					selected = {}
					if type(v) == "table" then
						for _, x in ipairs(v) do
							local name = type(x) == "table" and x.Title or x
							if name ~= nil then
								selected[tostring(name)] = true
							end
							if not multi then
								break
							end
						end
					elseif type(v) == "number" then
						local it = items[v]
						if it and it.Title then
							selected[it.Title] = true
						end
					elseif v ~= nil then
						selected[tostring(v)] = true
					end
				end
			
				SetSelection(opts.Value or opts.Default)
				Build()
				Update(false)
			
				local obj = {Type = "Dropdown"}
				function obj:Get()
					return GetValue()
				end
				function obj:Set(v, silent)
					SetSelection(v)
					Update(not silent)
				end
				function obj:Select(v, silent)
					SetSelection(v)
					Update(not silent)
				end
				function obj:Refresh(list)
					items = Normalize(list)
					local names = {}
					for _, it in ipairs(items) do
						if it.Title then
							names[it.Title] = true
						end
					end
					for k in pairs(selected) do
						if not names[k] then
							selected[k] = nil
						end
					end
					Build()
					Update(false)
					if open then
						Holder.Size = Wd(HP, ContentHeight())
					end
				end
				obj.SetOptions = obj.Refresh
				function obj:SetTitle(t)
					T.Text = tostring(t)
				end
				function obj:Open()
					SetOpen(true)
				end
				function obj:Close()
					SetOpen(false)
				end
				function obj:Lock()
					locked = true
					SetLockedVisual(T, D, true)
					SetOpen(false)
				end
				function obj:Unlock()
					locked = false
					SetLockedVisual(T, D, false)
				end
				return RegisterFlag(opts.Flag, obj)
			end
