		BT.TextSize = 13
		BT.ZIndex = 51
	
		local dragging, moved, startMouse, startPos = false, false, nil, nil
		if opts.Draggable ~= false then
			B.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					moved = false
					startMouse = input.Position
					startPos = B.Position
					input.Changed:Connect(function()
						if input.UserInputState == Enum.UserInputState.End then
							dragging = false
						end
					end)
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					local d = input.Position - startMouse
					if d.Magnitude > 5 then
						moved = true
					end
					if moved then
						B.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
					end
				end
			end)
		end
		B.MouseButton1Click:Connect(function()
			if not moved then
				task.spawn(ToggleUI)
			end
		end)
	
		local obj = {Type = "OpenButton"}
		function obj:SetTitle(t)
			BT.Text = tostring(t)
		end
		function obj:Destroy()
			B:Destroy()
		end
		return obj
	end
	
