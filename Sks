			local lbl = Create("TextLabel", { Size = UDim2.new(1,-80,1,0), BackgroundTransparency = 1, Text = o.Title or "Keybind", Font = CurrentFont, TextSize = 12, TextColor3 = Theme.TextColor, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 201, Parent = row }); lbl:SetAttribute("Role","text")
			local keyBtn = Create("TextButton", { Size = UDim2.new(0,70,0,14), Position = UDim2.new(1,-78,0.5,-7), BackgroundColor3 = Theme.ButtonBg, BorderSizePixel = 0, Text = keyName(currentKey), Font = CurrentFontBold, TextSize = 10, TextColor3 = Theme.WhiteOnButton and Color3.fromRGB(255,255,255) or Color3.fromRGB(20,20,20), AutoButtonColor = false, ZIndex = 202, Parent = row }); keyBtn:SetAttribute("Role","buttonBg"); keyBtn:SetAttribute("Bold", true)
			local listening, conn = false, nil
