function Library:Notify(cfg)
	cfg = cfg or {}
	local n = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.DialogBg, BorderSizePixel = 0, BackgroundTransparency = 0.05,
		ZIndex = 10001, Parent = NotifyHolder,
	})
	n:SetAttribute("Role", "notifyBg")
	Create("UICorner", { CornerRadius = UDim.new(0, 8), Parent = n })
	Create("UIStroke", { Color = Theme.Outline, Thickness = 1, Transparency = 0.4, Parent = n })
	Create("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), Parent = n })
	local inner = Create("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = n })
	local titleLbl = Create("TextLabel", {
		Size = UDim2.new(1, -24, 0, 18), BackgroundTransparency = 1, Text = cfg.Title or "Notification",
		Font = CurrentFontBold, TextSize = 14, TextColor3 = Theme.TextColor,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 10002, Parent = inner,
	})
	titleLbl:SetAttribute("Role", "text"); titleLbl:SetAttribute("Bold", true)
	local contentLbl = Create("TextLabel", {
		Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(0, 0, 0, 20),
		BackgroundTransparency = 1, Text = cfg.Content or "", Font = CurrentFont, TextSize = 12,
		TextColor3 = Theme.TextDim, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
		ZIndex = 10002, Parent = inner,
	})
	contentLbl:SetAttribute("Role", "dim")
	local closeBtn
	if cfg.CanClose ~= false then
		closeBtn = Create("TextButton", {
			Size = UDim2.new(0, 18, 0, 18), Position = UDim2.new(1, -18, 0, 0),
			BackgroundTransparency = 1, Text = "x", Font = CurrentFontBold, TextSize = 14,
			TextColor3 = Theme.Red, ZIndex = 10003, Parent = inner,
		})
		closeBtn:SetAttribute("Bold", true)
	end
	local duration = cfg.Duration or 5
	local progress = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 1, 2),
		BackgroundColor3 = Theme.SliderThumb, BorderSizePixel = 0, ZIndex = 10002, Parent = n,
	})
	progress:SetAttribute("Role", "sliderThumb")
	local closed = false
	local function Close()
		if closed then return end
		closed = true
		TweenService:Create(n, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
		task.delay(0.3, function() pcall(function() n:Destroy() end) end)
	end
	if closeBtn then closeBtn.MouseButton1Click:Connect(Close) end
	n.BackgroundTransparency = 1
	TweenService:Create(n, TWEEN_NOTIFY, { BackgroundTransparency = 0.05 }):Play()
	TweenService:Create(progress, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 2) }):Play()
	task.delay(duration, Close)
	return { Close = Close }
end

