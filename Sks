				local function Show()
					KeyBtn.Text = listening and "..." or (current and current.Name or "None")
				end
				Show()

				KeyBtn.MouseButton1Click:Connect(function()
					if locked then
						LockedNotice(opts.LockedTitle)
						return
					end
					listening = true
					Show()
					Tween(KStroke, {Color = Theme.Accent})
				end)

				UserInputService.InputBegan:Connect(function(input)
					if input.UserInputType ~= Enum.UserInputType.Keyboard then
						return
					end
					if listening then
						listening = false
						Tween(KStroke, {Color = Theme.Off})
						if input.KeyCode ~= Enum.KeyCode.Escape then
							current = input.KeyCode
							task.spawn(cb, current.Name)
						end
						Show()
					elseif current and input.KeyCode == current and not UserInputService:GetFocusedTextBox() then
						if onPress then
							task.spawn(onPress)
						end
					end
				end)

				local obj = {Type = "Keybind"}
				function obj:Set(v, silent)
					current = ResolveKey(v)
					Show()
					if not silent and current then
						task.spawn(cb, current.Name)
					end
				end
				function obj:Get()
					return current and current.Name or nil
				end
				function obj:Lock()
					locked = true
					SetLockedVisual(T, D, true)
				end
				function obj:Unlock()
					locked = false
					SetLockedVisual(T, D, false)
				end
				return RegisterFlag(opts.Flag, obj)
			end

