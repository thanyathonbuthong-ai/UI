local function ApplyThemeToGui(screenGui)
	if not screenGui then return end
	for _, obj in ipairs(screenGui:GetDescendants()) do
		local role = obj:GetAttribute("Role")
		if role then
			pcall(function()
				if role == "bg" then obj.BackgroundColor3 = Theme.WindowBg
				elseif role == "stroke" then obj.Color = Theme.Outline
				elseif role == "text" then obj.TextColor3 = Theme.TextColor
				elseif role == "dim" then obj.TextColor3 = Theme.TextDim
				elseif role == "tab" then obj.TextColor3 = (obj:GetAttribute("Selected") == true) and Theme.TextColor or Theme.TextDim
				elseif role == "toggleBall" then obj.BackgroundColor3 = (obj:GetAttribute("On") == true) and Theme.ToggleOn or Theme.BallOff
				elseif role == "toggleTrack" then obj.BackgroundColor3 = Theme.ToggleOffBg
				elseif role == "sliderThumb" then obj.BackgroundColor3 = Theme.SliderThumb
				elseif role == "sliderBar" then obj.BackgroundColor3 = Theme.BarOff
				elseif role == "buttonBg" then obj.BackgroundColor3 = Theme.ButtonBg
				elseif role == "dialog" then obj.BackgroundColor3 = Theme.DialogBg
				elseif role == "option" then
					obj.BackgroundColor3 = (obj:GetAttribute("Selected") == true) and Theme.OptionSelected or Theme.OptionNormal
					obj.TextColor3 = Color3.fromRGB(255, 255, 255)
				elseif role == "notifyBg" then obj.BackgroundColor3 = Theme.DialogBg
				end
			end)
		end
	end
end

local CurrentFont = Enum.Font.Gotham
local CurrentFontBold = Enum.Font.GothamBold
local function ApplyFontToGui(screenGui)
	if not screenGui then return end
	for _, obj in ipairs(screenGui:GetDescendants()) do
		if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
			obj.Font = (obj:GetAttribute("Bold") == true) and CurrentFontBold or CurrentFont
		end
	end
end

-- API ระดับ Library ------------------------------------------------------------
function Library:GetThemes() return Themes end
function Library:GetCurrentTheme() return CurrentThemeName end
function Library:OnThemeChange(cb) table.insert(ThemeChangeCallbacks, cb) end
function Library:AddTheme(raw)
	if not raw or not raw.Name then warn("[SupremacyUI] AddTheme: ต้องมี Name") return nil end
	Themes[raw.Name] = ResolveTheme(raw); return Themes[raw.Name]
end
function Library:SetTheme(name)
	local t = Themes[name]
	if not t then warn("[SupremacyUI] Theme ไม่มี: " .. tostring(name)); return nil end
	CurrentThemeName = name; Theme = t
	for _, w in ipairs(Windows) do ApplyThemeToGui(w.ScreenGui) end
	for _, cb in ipairs(ThemeChangeCallbacks) do pcall(cb, name) end
	return t
end
function Library:SetFont(regular, bold)
	CurrentFont = regular or Enum.Font.Gotham
	CurrentFontBold = bold or regular or CurrentFont
	for _, w in ipairs(Windows) do ApplyFontToGui(w.ScreenGui) end
end

