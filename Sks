function Library:CreateWindow(opts)
	opts = opts or {}
	if opts.Theme and Themes[opts.Theme] then CurrentThemeName = opts.Theme; Theme = Themes[opts.Theme] end
	if opts.Font then CurrentFont = opts.Font end
	if opts.FontBold then CurrentFontBold = opts.FontBold elseif opts.Font then CurrentFontBold = opts.Font end

	local self = setmetatable({}, Library)
	self.OpenDropdowns = {}
	self.PendingFlags = {}

	local ScreenGui = Create("ScreenGui", { Name = (opts.Title or "Hub") .. "UI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true, DisplayOrder = 50 })
	ProtectGui(ScreenGui)
