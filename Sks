			-- ===================== Image =====================
			function ElementHandler:Image(a)
				local opts = type(a) == "table" and a or {Image = a}
				local ratio = 16 / 9
				if type(opts.AspectRatio) == "string" then
					local w, h = opts.AspectRatio:match("^(%d+%.?%d*):(%d+%.?%d*)$")
					if w and h and tonumber(h) > 0 then
						ratio = tonumber(w) / tonumber(h)
					end
				elseif type(opts.AspectRatio) == "number" and opts.AspectRatio > 0 then
					ratio = opts.AspectRatio
				end
			
				local Img = Instance.new("ImageLabel")
				Img.Name = "Image"
				Img.Parent = Container
				Img.BackgroundColor3 = Theme.Row
				Img.BorderSizePixel = 0
				Img.Size = Wd(Container, math.floor(375 / ratio))
				Img.Image = ResolveIcon(opts.Image) or ""
				Img.ScaleType = Enum.ScaleType.Crop
				Corner(Img, opts.Radius or 6)
			
				local AR = Instance.new("UIAspectRatioConstraint")
				AR.AspectRatio = ratio
				AR.DominantAxis = Enum.DominantAxis.Width
				AR.Parent = Img
			
				local obj = {Type = "Image"}
				function obj:SetImage(v)
					Img.Image = ResolveIcon(v) or ""
				end
				function obj:Destroy()
					Img:Destroy()
				end
				return obj
			end
			-- ===================== Video =====================
			function ElementHandler:Video(a)
				local opts = type(a) == "table" and a or {Video = a}
				local ratio = ParseRatio(opts.AspectRatio, 16 / 9)
				local src = opts.Video
				if type(src) == "number" then
					src = "rbxassetid://" .. tostring(src)
				elseif type(src) == "string" and not src:find("^rbx") and getcustomasset and isfile then
					local okf, exists = pcall(isfile, src)
					if okf and exists then
						local okc, asset = pcall(getcustomasset, src)
						if okc then
							src = asset
						end
					end
				end
			
				local VF
				local ok = pcall(function()
					VF = Instance.new("VideoFrame")
					VF.Name = "Video"
					VF.Parent = Container
					VF.BackgroundColor3 = Color3.new(0, 0, 0)
					VF.BorderSizePixel = 0
					VF.Size = Wd(Container, math.floor(375 / ratio))
					VF.Video = src or ""
					VF.Looped = opts.Looped == true
					VF.Volume = opts.Volume or 1
				end)
				if not ok or not VF then
					return {Type = "Video"}
				end
				Corner(VF, opts.Radius or 6)
				local AR = Instance.new("UIAspectRatioConstraint")
				AR.AspectRatio = ratio
				AR.DominantAxis = Enum.DominantAxis.Width
				AR.Parent = VF
			
				local Hit = Instance.new("TextButton")
				Hit.Name = "PlayPause"
				Hit.Parent = VF
				Hit.BackgroundTransparency = 1
				Hit.Size = UDim2.new(1, 0, 1, 0)
				Hit.Text = ""
				Hit.ZIndex = 2
			
				local Chip = Instance.new("TextLabel")
				Chip.Name = "State"
				Chip.Parent = VF
				Chip.AnchorPoint = Vector2.new(0, 1)
				Chip.BackgroundColor3 = Theme.Main
				Chip.BackgroundTransparency = 0.3
				Chip.BorderSizePixel = 0
				Chip.Position = UDim2.new(0, 8, 1, -8)
				Chip.Size = UDim2.new(0, 0, 0, 20)
				Chip.AutomaticSize = Enum.AutomaticSize.X
				Chip.Font = Enum.Font.GothamSemibold
				Chip.TextColor3 = Theme.Text
				Chip.TextSize = 11
				Chip.ZIndex = 3
				Corner(Chip, 4)
				local CP = Instance.new("UIPadding")
				CP.PaddingLeft = UDim.new(0, 8)
				CP.PaddingRight = UDim.new(0, 8)
				CP.Parent = Chip
			
				local function Sync()
					Chip.Text = VF.Playing and "Pause" or "Play"
				end
				Hit.MouseButton1Click:Connect(function()
					if VF.Playing then
						VF:Pause()
					else
						VF:Play()
					end
					Sync()
				end)
				if opts.Autoplay or opts.Playing then
					VF:Play()
				end
				Sync()
			
				local obj = {Type = "Video"}
				function obj:Play()
					VF:Play()
					Sync()
				end
				function obj:Pause()
					VF:Pause()
					Sync()
				end
				function obj:SetVideo(v)
					VF.Video = type(v) == "number" and ("rbxassetid://" .. v) or tostring(v)
				end
				function obj:Destroy()
					VF:Destroy()
				end
				return obj
			end
			
