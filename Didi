--[[
    ValkyrieUI - Roblox UI Library (ลอกสไตล์ Valkyrie Hub)
    - Sidebar (Search / Category / Tabs / Profile)
    - Content 2 คอลัมน์ + Section (ไอคอน + ชื่อ)
    - Toggle / Dropdown / Button / Label
    - ลากหน้าต่างได้, กด RightShift เพื่อซ่อน/แสดง
]]

local Players          = game:GetService("Players")
local TweenService     = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer      = Players.LocalPlayer

local Theme = {
    Window     = Color3.fromRGB(17, 17, 21),
    Sidebar    = Color3.fromRGB(20, 20, 25),
    Section    = Color3.fromRGB(24, 24, 30),
    Stroke     = Color3.fromRGB(40, 40, 50),
    Item       = Color3.fromRGB(32, 32, 40),
    Accent     = Color3.fromRGB(70, 95, 225),
    Text       = Color3.fromRGB(235, 235, 240),
    SubText    = Color3.fromRGB(125, 125, 140),
    Off        = Color3.fromRGB(48, 48, 58),
    Font       = Enum.Font.GothamMedium,
    FontBold   = Enum.Font.GothamBold,
}

local Library = {}
Library.__index = Library

--------------------------------------------------------------------- helpers
local function Create(class, props, children)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    for _, c in ipairs(children or {}) do c.Parent = o end
    return o
end

local function Corner(r) return Create("UICorner", {CornerRadius = UDim.new(0, r)}) end
local function Stroke(c, t) return Create("UIStroke", {Color = c or Theme.Stroke, Thickness = t or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}) end
local function Pad(l, t, r, b)
    return Create("UIPadding", {PaddingLeft = UDim.new(0, l), PaddingTop = UDim.new(0, t), PaddingRight = UDim.new(0, r), PaddingBottom = UDim.new(0, b)})
end
local function List(p, order)
    return Create("UIListLayout", {Padding = UDim.new(0, p or 0), SortOrder = order or Enum.SortOrder.LayoutOrder})
end
local function Tween(o, props, t)
    TweenService:Create(o, TweenInfo.new(t or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function Icon(parent, icon, size, color, pos)
    local isImg = type(icon) == "string" and icon:find("rbxassetid")
    local o = Create(isImg and "ImageLabel" or "TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.fromOffset(size, size),
        Position = pos or UDim2.new(), Parent = parent,
    })
    if isImg then
        o.Image = icon; o.ImageColor3 = color
    else
        o.Text = icon or "•"; o.TextColor3 = color; o.Font = Theme.FontBold
        o.TextSize = size - 2
    end
    return o
end

local function MakeDraggable(handle, target)
    local dragging, start, startPos
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging, start, startPos = true, i.Position, target.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - start
            target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

--------------------------------------------------------------------- window
function Library:CreateWindow(cfg)
    cfg = cfg or {}
    local Title    = cfg.Title or "Valkyrie Hub"
    local Footer   = cfg.Footer or "Anime Zero"
    local Handle   = cfg.Handle or "@velkyriehub"
    local UserName = cfg.UserName or "Hidden"
    local Logo     = cfg.Logo -- rbxassetid://...

    local gui = Create("ScreenGui", {Name = "ValkyrieUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true})
    pcall(function() gui.Parent = (gethui and gethui()) or game:GetService("CoreGui") end)
    if not gui.Parent then gui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

    local Main = Create("Frame", {
        Size = UDim2.fromOffset(780, 470), Position = UDim2.new(0.5, -390, 0.5, -235),
        BackgroundColor3 = Theme.Window, Parent = gui,
    }, {Corner(10), Stroke()})

    local Window = setmetatable({Gui = gui, Main = Main, Tabs = {}, Current = nil}, Library)

    ------------------------------------------------ sidebar
    local Sidebar = Create("Frame", {Size = UDim2.new(0, 215, 1, -26), BackgroundTransparency = 1, Parent = Main})

    local TitleLbl = Create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 56), BackgroundTransparency = 1, Parent = Sidebar,
        Font = Theme.FontBold, TextSize = 19, TextColor3 = Theme.Text, RichText = true,
        Text = (function()
            local a, b = Title:match("^(%S+)%s*(.*)$")
            return string.format('<u><font color="rgb(120,150,255)">%s</font></u> %s', a or Title, b or "")
        end)(),
    })
    MakeDraggable(TitleLbl, Main)

    local SearchBox = Create("Frame", {
        Size = UDim2.new(1, -24, 0, 32), Position = UDim2.fromOffset(12, 58),
        BackgroundColor3 = Theme.Sidebar, Parent = Sidebar,
    }, {Corner(7), Stroke()})
    Create("TextLabel", {Size = UDim2.fromOffset(28, 32), BackgroundTransparency = 1, Text = "⌕", TextSize = 18, Font = Theme.FontBold, TextColor3 = Theme.SubText, Parent = SearchBox})
    local SearchInput = Create("TextBox", {
        Size = UDim2.new(1, -34, 1, 0), Position = UDim2.fromOffset(30, 0), BackgroundTransparency = 1,
        PlaceholderText = "Search...", PlaceholderColor3 = Theme.SubText, Text = "", ClearTextOnFocus = false,
        TextColor3 = Theme.Text, Font = Theme.Font, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = SearchBox,
    })

    local TabList = Create("ScrollingFrame", {
        Size = UDim2.new(1, -16, 1, -190), Position = UDim2.fromOffset(8, 98), BackgroundTransparency = 1,
        BorderSizePixel = 0, ScrollBarThickness = 0, AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(), Parent = Sidebar,
    }, {List(2)})

    -- profile
    local Profile = Create("Frame", {Size = UDim2.new(1, -16, 0, 50), Position = UDim2.new(0, 8, 1, -54), BackgroundTransparency = 1, Parent = Sidebar})
    local Avatar = Create("ImageLabel", {
        Size = UDim2.fromOffset(40, 40), Position = UDim2.fromOffset(4, 5), BackgroundColor3 = Theme.Item, Parent = Profile,
        Image = "rbxthumb://type=AvatarHeadShot&id=" .. LocalPlayer.UserId .. "&w=100&h=100",
    }, {Create("UICorner", {CornerRadius = UDim.new(1, 0)})})
    Create("TextLabel", {Size = UDim2.new(1, -54, 0, 18), Position = UDim2.fromOffset(52, 8), BackgroundTransparency = 1, Text = UserName, Font = Theme.FontBold, TextSize = 13, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, Parent = Profile})
    Create("TextLabel", {Size = UDim2.new(1, -54, 0, 14), Position = UDim2.fromOffset(52, 26), BackgroundTransparency = 1, Text = Handle, Font = Theme.Font, TextSize = 11, TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left, Parent = Profile})

    -- divider
    Create("Frame", {Size = UDim2.new(0, 1, 1, -26), Position = UDim2.fromOffset(215, 0), BackgroundColor3 = Theme.Stroke, BorderSizePixel = 0, Parent = Main})

    ------------------------------------------------ content
    local PageTitle = Create("TextLabel", {
        Size = UDim2.new(1, -240, 0, 40), Position = UDim2.fromOffset(228, 0), BackgroundTransparency = 1,
        Text = "", Font = Theme.FontBold, TextSize = 13, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, Parent = Main,
    })
    MakeDraggable(PageTitle, Main)

    local Pages = Create("Frame", {Size = UDim2.new(1, -228, 1, -72), Position = UDim2.fromOffset(222, 40), BackgroundTransparency = 1, ClipsDescendants = true, Parent = Main})

    -- logo กลางจอ (จางๆ เหมือนในภาพ)
    if Logo then
        Create("ImageLabel", {Size = UDim2.fromOffset(64, 64), AnchorPoint = Vector2.new(.5, .5), Position = UDim2.new(0.5, 107, 0.5, -20),
            BackgroundTransparency = 1, Image = Logo, ImageTransparency = 0.6, ZIndex = 5, Parent = Main})
    end

    -- footer
    local FooterBar = Create("Frame", {Size = UDim2.new(1, 0, 0, 26), Position = UDim2.new(0, 0, 1, -26), BackgroundColor3 = Theme.Sidebar, Parent = Main}, {Corner(10)})
    Create("Frame", {Size = UDim2.new(1, 0, 0, 10), BackgroundColor3 = Theme.Sidebar, BorderSizePixel = 0, Parent = FooterBar})
    Create("TextLabel", {Size = UDim2.new(0.5, -12, 1, 0), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1, Text = Footer, Font = Theme.Font, TextSize = 10, TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left, Parent = FooterBar})
    Create("TextLabel", {Size = UDim2.new(0.5, -12, 1, 0), Position = UDim2.new(0.5, 0, 0, 0), BackgroundTransparency = 1, Text = Handle, Font = Theme.Font, TextSize = 10, TextColor3 = Theme.Accent, TextXAlignment = Enum.TextXAlignment.Right, Parent = FooterBar})

    -- toggle UI
    UserInputService.InputBegan:Connect(function(i, gp)
        if not gp and i.KeyCode == (cfg.ToggleKey or Enum.KeyCode.RightShift) then gui.Enabled = not gui.Enabled end
    end)

    -- search filter
    SearchInput:GetPropertyChangedSignal("Text"):Connect(function()
        local q = SearchInput.Text:lower()
        for _, t in ipairs(Window.Tabs) do
            t.Button.Visible = (q == "") or t.Name:lower():find(q, 1, true) ~= nil
        end
    end)

    Window._TabList, Window._Pages, Window._PageTitle = TabList, Pages, PageTitle
    Window._Order = 0

    function Window:Destroy() gui:Destroy() end
    return Window
end

--------------------------------------------------------------------- category
function Library:AddCategory(name)
    self._Order += 1
    Create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, LayoutOrder = self._Order, Parent = self._TabList,
        Text = name, Font = Theme.FontBold, TextSize = 11, TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left,
    }, {Pad(8, 6, 0, 0)})
end

--------------------------------------------------------------------- tab
function Library:AddTab(name, icon)
    local Window = self
    self._Order += 1

    local Btn = Create("TextButton", {
        Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = Theme.Item, BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false, LayoutOrder = self._Order, Parent = self._TabList,
    }, {Corner(7)})
    local Ic  = Icon(Btn, icon or "•", 16, Theme.SubText, UDim2.fromOffset(12, 9))
    local Lbl = Create("TextLabel", {
        Size = UDim2.new(1, -44, 1, 0), Position = UDim2.fromOffset(38, 0), BackgroundTransparency = 1,
        Text = name, Font = Theme.Font, TextSize = 12, TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left, Parent = Btn,
    })

    local Page = Create("Frame", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Visible = false, Parent = self._Pages})
    local function Column(side)
        local col = Create("ScrollingFrame", {
            Size = UDim2.new(0.5, -12, 1, 0),
            Position = side == "Left" and UDim2.fromOffset(6, 0) or UDim2.new(0.5, 6, 0, 0),
            BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 0,
            AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = Page,
        }, {List(10), Pad(0, 4, 0, 8)})
        return col
    end
    local Left, Right = Column("Left"), Column("Right")

    local Tab = {Name = name, Button = Btn, Page = Page}

    local function Select()
        for _, t in ipairs(Window.Tabs) do
            t.Page.Visible = false
            Tween(t.Button, {BackgroundTransparency = 1})
            t._Lbl.TextColor3 = Theme.SubText
            if t._Ic:IsA("TextLabel") then t._Ic.TextColor3 = Theme.SubText else t._Ic.ImageColor3 = Theme.SubText end
        end
        Page.Visible = true
        Window._PageTitle.Text = name
        Tween(Btn, {BackgroundTransparency = 0})
        Lbl.TextColor3 = Theme.Text
        if Ic:IsA("TextLabel") then Ic.TextColor3 = Theme.Text else Ic.ImageColor3 = Theme.Text end
        Window.Current = Tab
    end
    Tab._Lbl, Tab._Ic = Lbl, Ic
    Btn.MouseButton1Click:Connect(Select)
    table.insert(self.Tabs, Tab)
    if #self.Tabs == 1 then Select() end

    ---------------------------------------------------------------- section
    function Tab:AddSection(title, icon, side)
        local col = (side == "Right") and Right or Left
        local Sec = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundColor3 = Theme.Section, Parent = col,
        }, {Corner(8), Stroke(), List(0)})

        local Head = Create("Frame", {Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1, LayoutOrder = 0, Parent = Sec})
        Icon(Head, icon or "◆", 16, Theme.Accent, UDim2.fromOffset(12, 10))
        Create("TextLabel", {Size = UDim2.new(1, -40, 1, 0), Position = UDim2.fromOffset(36, 0), BackgroundTransparency = 1, Text = title, Font = Theme.FontBold, TextSize = 12, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, Parent = Head})
        Create("Frame", {Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1), BackgroundColor3 = Theme.Stroke, BorderSizePixel = 0, Parent = Head})

        local Body = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 1, Parent = Sec,
        }, {List(0), Pad(12, 4, 12, 4)})

        local Section = {}
        local count = 0

        -- แถวพื้นฐาน: ชื่อ + คำอธิบาย + (control ด้านขวา)
        local function Row(name, desc, rightWidth)
            count += 1
            local Wrap = Create("Frame", {
                Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1, LayoutOrder = count, Parent = Body,
            }, {List(0)})
            if count > 1 then
                Create("Frame", {Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = Theme.Stroke, BackgroundTransparency = 0.5, BorderSizePixel = 0, LayoutOrder = 0, Parent = Wrap})
            end
            local Top = Create("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 1, Parent = Wrap}, {Pad(0, 9, 0, 9)})
            local Text = Create("Frame", {Size = UDim2.new(1, -(rightWidth + 10), 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = Top}, {List(3)})
            Create("TextLabel", {Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, Text = name, Font = Theme.FontBold, TextSize = 12, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1, Parent = Text})
            if desc and desc ~= "" then
                Create("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
                    Text = desc, Font = Theme.Font, TextSize = 11, TextColor3 = Theme.SubText, TextWrapped = true,
                    TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 2, Parent = Text,
                })
            end
            return Wrap, Top
        end

        ------------------------------------------------ Toggle
        function Section:AddToggle(o)
            o = o or {}
            local state = o.Default or false
            local _, Top = Row(o.Name or "Toggle", o.Description, 46)
            local Sw = Create("TextButton", {
                Size = UDim2.fromOffset(42, 22), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 9),
                BackgroundColor3 = state and Theme.Accent or Theme.Off, Text = "", AutoButtonColor = false, Parent = Top,
            }, {Create("UICorner", {CornerRadius = UDim.new(1, 0)})})
            local Knob = Create("Frame", {
                Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(0, 0.5),
                Position = state and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
                BackgroundColor3 = Color3.new(1, 1, 1), Parent = Sw,
            }, {Create("UICorner", {CornerRadius = UDim.new(1, 0)})})

            local T = {}
            function T:Set(v, silent)
                state = v and true or false
                Tween(Sw, {BackgroundColor3 = state and Theme.Accent or Theme.Off})
                Tween(Knob, {Position = state and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)})
                if not silent and o.Callback then task.spawn(o.Callback, state) end
            end
            function T:Get() return state end
            Sw.MouseButton1Click:Connect(function() T:Set(not state) end)
            if state and o.Callback then task.spawn(o.Callback, state) end
            return T
        end

        ------------------------------------------------ Dropdown
        function Section:AddDropdown(o)
            o = o or {}
            local options  = o.Options or {}
            local multi    = o.Multi or false
            local selected = multi and {} or (o.Default or options[1])
            if multi and type(o.Default) == "table" then for _, v in ipairs(o.Default) do selected[v] = true end end

            local Wrap, Top = Row(o.Name or "Dropdown", o.Description, 150)

            local Box = Create("TextButton", {
                Size = UDim2.fromOffset(140, 24), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 9),
                BackgroundColor3 = Theme.Item, Text = "", AutoButtonColor = false, Parent = Top,
            }, {Corner(6), Stroke()})
            local ValLbl = Create("TextLabel", {
                Size = UDim2.new(1, -28, 1, 0), Position = UDim2.fromOffset(8, 0), BackgroundTransparency = 1, Font = Theme.Font,
                TextSize = 11, TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = Box,
            })
            Create("TextLabel", {Size = UDim2.fromOffset(20, 24), Position = UDim2.new(1, -22, 0, 0), BackgroundTransparency = 1, Text = "▾", Font = Theme.FontBold, TextSize = 12, TextColor3 = Theme.SubText, Parent = Box})

            local ListF = Create("Frame", {
                Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
                Visible = false, LayoutOrder = 2, Parent = Wrap,
            }, {List(3), Pad(0, 0, 0, 8)})

            local D, buttons = {}, {}
            local function Refresh()
                if multi then
                    local t = {}
                    for _, v in ipairs(options) do if selected[v] then table.insert(t, v) end end
                    ValLbl.Text = #t > 0 and table.concat(t, ", ") or "None"
                else
                    ValLbl.Text = tostring(selected or "None")
                end
                for v, b in pairs(buttons) do
                    local on = multi and selected[v] or (selected == v)
                    b.TextColor3 = on and Theme.Text or Theme.SubText
                    b.BackgroundColor3 = on and Theme.Accent or Theme.Item
                end
            end
            local function Build()
                for _, b in pairs(buttons) do b:Destroy() end
                buttons = {}
                for i, v in ipairs(options) do
                    local b = Create("TextButton", {
                        Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = Theme.Item, Text = v, Font = Theme.Font, TextSize = 11,
                        TextColor3 = Theme.SubText, AutoButtonColor = false, LayoutOrder = i, Parent = ListF,
                    }, {Corner(6)})
                    b.MouseButton1Click:Connect(function()
                        if multi then selected[v] = not selected[v] or nil else selected = v end
                        Refresh()
                        if o.Callback then task.spawn(o.Callback, selected) end
                    end)
                    buttons[v] = b
                end
                Refresh()
            end
            Build()
            Box.MouseButton1Click:Connect(function() ListF.Visible = not ListF.Visible end)

            function D:Set(v) selected = v; Refresh() end
            function D:Get() return selected end
            function D:SetOptions(t) options = t; Build() end
            return D
        end

        ------------------------------------------------ Button
        function Section:AddButton(o)
            o = o or {}
            local _, Top = Row(o.Name or "Button", o.Description, 90)
            local B = Create("TextButton", {
                Size = UDim2.fromOffset(80, 24), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 9),
                BackgroundColor3 = Theme.Accent, Text = o.ButtonText or "Click", Font = Theme.FontBold, TextSize = 11,
                TextColor3 = Color3.new(1, 1, 1), AutoButtonColor = true, Parent = Top,
            }, {Corner(6)})
            B.MouseButton1Click:Connect(function() if o.Callback then task.spawn(o.Callback) end end)
        end

        ------------------------------------------------ Label
        function Section:AddLabel(text)
            local _, _ = nil, nil
            count += 1
            local L = Create("TextLabel", {
                Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Text = text,
                Font = Theme.FontBold, TextSize = 12, TextColor3 = Theme.Text, TextWrapped = true,
                TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = count, Parent = Body,
            }, {Pad(0, 9, 0, 9)})
            return {Set = function(_, t) L.Text = t end}
        end

        return Section
    end

    return Tab
end

return Library

