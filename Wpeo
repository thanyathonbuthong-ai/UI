			elseif #Now <= 2 then
				Text.Text, Text.TextColor3 = table.concat(Now, ", "), T.Text
			else
				Text.Text, Text.TextColor3 = #Now .. " selected", T.Text
			end
		end

		function Object:Set(List, Silent)
			Selected = {}
			for _, Name in ipairs(List or {}) do Selected[Name] = true end
			Draw()
			if not Silent then Safe(Cfg.Callback, Object:Get()) end
		end

		Button.MouseButton1Click:Connect(function()
			OpenList(Win, Button, Options, function(Name) return Selected[Name] == true end, function(Name)
				Selected[Name] = not Selected[Name] or nil
				Draw()
				Safe(Cfg.Callback, Object:Get())
			end, { Multi = true, Search = Cfg.Search or #Options > 8, Align = "Right" })
