		{ Title = "Delete", Style = "Danger", Confirm = true, Callback = function() Win:DeleteConfig(NameBox:Get() ~= "" and NameBox:Get() or Win.CurrentConfig) end },
	} })
	ConfigSec:AddButton({ Title = "Reset everything to default", Style = "Outline", Callback = function() Win:ResetConfig() Win:Notify({ Title = "Reset", Type = "Warning" }) end })

	local Interface = ConfigTab:AddSection("Interface")
	Interface:AddKeybind({ Title = "Menu key", Default = Enum.KeyCode.RightShift, Callback = function(Key) Win:SetToggleKey(Key) end })
	Interface:AddButton({ Title = "Unload UI", Style = "Danger", Confirm = true, Callback = function() Win:Destroy() end })

	Win:Notify({ Title = "Headshot loaded", Content = "Press RightShift or tap the round button to hide / show.", Type = "Success" })
end

return Library
