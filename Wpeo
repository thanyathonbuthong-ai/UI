		AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -111, .5, 1), Size = UDim2.fromOffset(40, 22),
	}, Footer)
	Reset.MouseEnter:Connect(function() Reset.TextColor3 = T.Text end)
	Reset.MouseLeave:Connect(function() Reset.TextColor3 = T.Dim end)
	Reset.MouseButton1Click:Connect(function()
		Win:ResetConfig()
		Safe(Cfg.OnReset, Win.CurrentConfig)
