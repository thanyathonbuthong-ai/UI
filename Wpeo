	local ConfigButton = New("TextButton", {
		Text = "", AutoButtonColor = false, AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -161, .5, 1),
		Size = UDim2.fromOffset(133, 22), BackgroundColor3 = T.Bar, BackgroundTransparency = .1, BorderSizePixel = 0,
