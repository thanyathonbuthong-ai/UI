		Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 60,
	}, Dock)

	do
		local Tracking, Start, Origin, Moved = false, nil, nil, false

		DockHit.InputBegan:Connect(function(Input)
			if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
				Tracking, Moved, Start, Origin = true, false, Input.Position, Dock.Position
			end
		end)

		Win:Bind(UIS.InputChanged, function(Input)
			if Tracking and (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then
				local Delta = Input.Position - Start
				if not Moved and Delta.Magnitude < 8 then return end
				Moved = true
				Dock.Position = UDim2.new(Origin.X.Scale, Origin.X.Offset + Delta.X, Origin.Y.Scale, Origin.Y.Offset + Delta.Y)
			end
		end)

		Win:Bind(UIS.InputEnded, function(Input)
			if Tracking and (Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch) then
				Tracking = false

				if Moved then
					--// keep it on screen
					local View, Size, Place = Gui.AbsoluteSize, Dock.AbsoluteSize, Dock.AbsolutePosition
					local X = math.clamp(Place.X, 0, math.max(View.X - Size.X, 0)) - Place.X
					local Y = math.clamp(Place.Y, 0, math.max(View.Y - Size.Y, 0)) - Place.Y
					if math.abs(X) > .5 or math.abs(Y) > .5 then
						local Now = Dock.Position
						Tw(Dock, .2, { Position = UDim2.new(Now.X.Scale, Now.X.Offset + X, Now.Y.Scale, Now.Y.Offset + Y) })
					end
				else
					Win:Toggle()
				end
			end
		end)
	end

	do
		local Frames, Last = 0, os.clock()
		Win:Bind(RS.RenderStepped, function()
			Frames = Frames + 1
			local Now = os.clock()
			if Now - Last >= 1 then
				FpsLabel.Text = Frames .. " fps"
				TimeLabel.Text = os.date("%H:%M")
