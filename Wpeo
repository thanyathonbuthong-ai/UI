	Round(ConfigButton, 6)
	local ConfigText = Label(ConfigButton, "default", 9, T.Text, FM, { Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -30, 1, 0) })
	New("ImageLabel", { Image = Icons.chevron, ImageColor3 = T.Dim, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -7, .5, 0), Size = UDim2.fromOffset(11, 11) }, ConfigButton)

	local ConfigList = New("Frame", {
		Visible = false, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -161, 1, -50), Size = UDim2.fromOffset(133, 30),
		BackgroundColor3 = T.Panel, BorderSizePixel = 0, ZIndex = 30,
