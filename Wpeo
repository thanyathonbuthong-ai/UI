	function Win:AddTab(Name)
		local Tab = { Name = Name, Subs = {}, Active = nil, DescText = "" }

		Tab.Button = New("TextButton", {
			Text = Name, Font = FM, TextSize = 11, TextColor3 = T.Dim, BackgroundTransparency = 1, AutoButtonColor = false,
			Size = UDim2.fromOffset(80, 44), LayoutOrder = #Win.Tabs + 1,
		}, TabsHolder)
		Tab.Line = New("Frame", { AnchorPoint = Vector2.new(.5, 1), Position = UDim2.new(.5, 0, 1, -4), Size = UDim2.fromOffset(0, 2), BackgroundColor3 = T.Accent, BorderSizePixel = 0 }, Tab.Button)
		Round(Tab.Line, 1)

		Tab.Page = New("Frame", { Name = Name, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false }, Pages)
		Label(Tab.Page, Name, 18, T.Text, FB, { Position = UDim2.fromOffset(20, 8), Size = UDim2.fromOffset(100, 26) })
		Tab.Desc = Label(Tab.Page, "", 9, T.Dim, FM, { Position = UDim2.fromOffset(20, 45), Size = UDim2.new(1, -40, 0, 16) })

		Tab.SubBar = New("Frame", { Position = UDim2.fromOffset(123, 13), Size = UDim2.fromOffset(463, 27), BackgroundColor3 = T.Bar, BackgroundTransparency = .1, BorderSizePixel = 0, Visible = false }, Tab.Page)
		Round(Tab.SubBar, 8)

		function Tab:SelectSub(Sub)
			Tab.Active = Sub
			Win:ClosePopup()
			for _, Other in ipairs(Tab.Subs) do
				local On = Other == Sub
				Other.Scroll.Visible = On
				Other.Button.TextColor3 = On and T.Text or T.Dim
				Other.Button.Font = On and FB or FM
				Tw(Other.Line, .2, { Size = UDim2.fromOffset(On and 24 or 0, 2) })
			end
			Tab.Desc.Text = (Sub.Name == "_") and Tab.DescText or Sub.Desc
		end

		function Tab:SetDescription(Text)
			Tab.DescText = Text or ""
			if Tab.Active and Tab.Active.Name == "_" then Tab.Desc.Text = Tab.DescText end
		end

		function Tab:AddSubTab(SubName, Description)
			local Sub = { Name = SubName, Desc = Description or "" }

			Sub.Button = New("TextButton", { Text = SubName, Font = FM, TextSize = 9, TextColor3 = T.Dim, BackgroundTransparency = 1, AutoButtonColor = false }, Tab.SubBar)
			Sub.Line = New("Frame", { AnchorPoint = Vector2.new(.5, 1), Position = UDim2.new(.5, 0, 1, 0), Size = UDim2.fromOffset(0, 2), BackgroundColor3 = T.Accent, BorderSizePixel = 0 }, Sub.Button)
			Round(Sub.Line, 1)

			Sub.Scroll = New("ScrollingFrame", {
				Position = UDim2.fromOffset(20, 83), Size = UDim2.new(1, -38, 1, -93), BackgroundTransparency = 1, BorderSizePixel = 0,
				ScrollBarThickness = 2, ScrollBarImageColor3 = T.Accent, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollingDirection = Enum.ScrollingDirection.Y, Visible = false,
			}, Tab.Page)
			Pad(Sub.Scroll, 0, 0, 19, 0)
			List(Sub.Scroll, 10)

			local SectionCount = 0
			function Sub:AddSection(Title)
				SectionCount = SectionCount + 1
				local Card = New("Frame", {
					Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.Panel,
					BackgroundTransparency = .2, BorderSizePixel = 0, LayoutOrder = SectionCount,
				}, Sub.Scroll)
				Round(Card, 10)
				Pad(Card, 16, 14, 16, 16)
				List(Card, 10)

				if Title and Title ~= "" then
					Label(Card, string.upper(Title), 8, T.Dim, FM, { Size = UDim2.new(1, 0, 0, 12), LayoutOrder = 0 })
				end

				return Builder(Card, Win, false)
			end

			table.insert(Tab.Subs, Sub)

			--// equal width buttons
			local Count = #Tab.Subs
			for Index, Other in ipairs(Tab.Subs) do
				Other.Button.Size = UDim2.new(1 / Count, 0, 1, 0)
				Other.Button.Position = UDim2.new((Index - 1) / Count, 0, 0, 0)
			end

			Tab.SubBar.Visible = not Tab.Implicit
			Sub.Button.MouseButton1Click:Connect(function() Tab:SelectSub(Sub) end)
			if Count == 1 then Tab:SelectSub(Sub) end

			return Sub
		end

		--// tab without sub tabs
		function Tab:AddSection(Title)
			if not Tab.Implicit then
				Tab.Implicit = true
				Tab.ImplicitSub = Tab:AddSubTab("_", "")
				Tab.SubBar.Visible = false
			end
			return Tab.ImplicitSub:AddSection(Title)
		end

		Tab.Button.MouseButton1Click:Connect(function() Win:SelectTab(Tab) end)

		table.insert(Win.Tabs, Tab)
		if #Win.Tabs == 1 then Win:SelectTab(Tab) end

		return Tab
	end

	task.defer(Fit)
	return Win
end

