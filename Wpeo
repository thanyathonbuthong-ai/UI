			Text = "", AutoButtonColor = false, AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, 0, .5, 0),
			Size = UDim2.fromOffset(40, 20), BackgroundColor3 = Cfg.Default or Color3.new(1, 1, 1), BorderSizePixel = 0,
		}, Row)
		Round(Swatch, 6)
		Stroke(Swatch, T.Line, 1, .2)

		local H, S, V = (Cfg.Default or Color3.new(1, 1, 1)):ToHSV()
		local Color = Color3.fromHSV(H, S, V)
		local Live
		local Object = {}

		local function Apply(Silent)
			Color = Color3.fromHSV(H, S, V)
			Swatch.BackgroundColor3 = Color
			if Live then Live() end
			if not Silent then Safe(Cfg.Callback, Color) end
		end

		function Object:Set(NewColor, Silent)
			if typeof(NewColor) ~= "Color3" then return end
			H, S, V = NewColor:ToHSV()
			Apply(Silent)
		end

		function Object:Get() return Color end

		Swatch.MouseButton1Click:Connect(function()
			local Popup = Win:ShowPopup(Swatch, 200, 182, "Right")
			Pad(Popup, 8, 8, 8, 8)

			local SV = New("TextButton", {
				Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 110), BackgroundColor3 = Color3.fromHSV(H, 1, 1),
				BorderSizePixel = 0, ZIndex = 3,
			}, Popup)
			Round(SV, 6)

			local White = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 4 }, SV)
			Round(White, 6)
			New("UIGradient", { Transparency = NumberSequence.new(0, 1) }, White)

			local Black = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, ZIndex = 5 }, SV)
			Round(Black, 6)
			New("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0) }, Black)

			local Cursor = New("Frame", {
				AnchorPoint = Vector2.new(.5, .5), Size = UDim2.fromOffset(10, 10), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 6,
			}, SV)
			Round(Cursor, 5)
			Stroke(Cursor, Color3.new(1, 1, 1), 2, 0)

			local Hue = New("TextButton", {
				Text = "", AutoButtonColor = false, Position = UDim2.fromOffset(0, 118), Size = UDim2.new(1, 0, 0, 12),
				BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 3,
			}, Popup)
			Round(Hue, 6)
			New("UIGradient", {
				Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
					ColorSequenceKeypoint.new(1 / 6, Color3.fromRGB(255, 255, 0)),
					ColorSequenceKeypoint.new(2 / 6, Color3.fromRGB(0, 255, 0)),
					ColorSequenceKeypoint.new(3 / 6, Color3.fromRGB(0, 255, 255)),
					ColorSequenceKeypoint.new(4 / 6, Color3.fromRGB(0, 0, 255)),
					ColorSequenceKeypoint.new(5 / 6, Color3.fromRGB(255, 0, 255)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
				}),
			}, Hue)

			local HueCursor = New("Frame", {
				AnchorPoint = Vector2.new(.5, .5), Size = UDim2.fromOffset(4, 16), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 5,
			}, Hue)
			Round(HueCursor, 2)
			Stroke(HueCursor, Color3.new(0, 0, 0), 1, .5)

			local Preview = New("Frame", { Position = UDim2.fromOffset(0, 138), Size = UDim2.fromOffset(24, 24), BackgroundColor3 = Color, BorderSizePixel = 0, ZIndex = 3 }, Popup)
			Round(Preview, 6)

			local Hex = New("TextBox", {
				Position = UDim2.fromOffset(32, 138), Size = UDim2.new(1, -32, 0, 24), BackgroundColor3 = T.Bar, BorderSizePixel = 0, Text = "",
				TextColor3 = T.Text, Font = FM, TextSize = 10, ClearTextOnFocus = false, TextXAlignment = Left, ZIndex = 3,
			}, Popup)
			Round(Hex, 6)
			Pad(Hex, 8, 0, 8, 0)

			local function Refresh()
				SV.BackgroundColor3 = Color3.fromHSV(H, 1, 1)
				Cursor.Position = UDim2.fromScale(S, 1 - V)
				HueCursor.Position = UDim2.new(H, 0, .5, 0)
				Preview.BackgroundColor3 = Color
				if not Hex:IsFocused() then Hex.Text = "#" .. Color:ToHex() end
			end

			Live = Refresh
			Refresh()
			Popup.Destroying:Connect(function() if Live == Refresh then Live = nil end end)

			Hex.FocusLost:Connect(function()
				local Code = string.gsub(Hex.Text, "#", "")
				if #Code == 6 and string.match(Code, "^%x+$") then
					local Ok, Parsed = pcall(Color3.fromHex, Code)
					if Ok then Object:Set(Parsed) end
				end
				Refresh()
			end)

			local Mode
			local function Drag(Input)
				local Point = GuiPoint(Input)
				if Mode == "sv" then
					S = math.clamp((Point.X - SV.AbsolutePosition.X) / math.max(SV.AbsoluteSize.X, 1), 0, 1)
					V = 1 - math.clamp((Point.Y - SV.AbsolutePosition.Y) / math.max(SV.AbsoluteSize.Y, 1), 0, 1)
				elseif Mode == "hue" then
					H = math.clamp((Point.X - Hue.AbsolutePosition.X) / math.max(Hue.AbsoluteSize.X, 1), 0, 1)
				else
					return
				end
				Apply()
			end

			local function IsPress(Input) return Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch end

			SV.InputBegan:Connect(function(Input) if IsPress(Input) then Mode = "sv" Drag(Input) end end)
			Hue.InputBegan:Connect(function(Input) if IsPress(Input) then Mode = "hue" Drag(Input) end end)

			Win:PopupBind(UIS.InputChanged, function(Input)
				if Mode and (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then Drag(Input) end
			end)
			Win:PopupBind(UIS.InputEnded, function(Input) if IsPress(Input) then Mode = nil end end)
		end)

		Apply(true)
		return Reg(Cfg, Object)
	end

	function B:AddStepper(Cfg)
		local Min, Max, Step = Cfg.Min or 0, Cfg.Max or 100, Cfg.Step or 1
		local Row = New("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, LayoutOrder = Next() }, Container)
		Label(Row, Cfg.Title or "Stepper", 12, T.Text, FM, { Size = UDim2.new(1, -120, 1, 0) })

		local Holder = New("Frame", {
			AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, 0, .5, 0), Size = UDim2.fromOffset(110, 26), BackgroundColor3 = T.Bar, BorderSizePixel = 0,
		}, Row)
		Round(Holder, 7)

		local ValueLabel = Label(Holder, "", 11, T.Text, FB, { Position = UDim2.fromOffset(26, 0), Size = UDim2.new(1, -52, 1, 0), TextXAlignment = Center })

		local Value = Min
		local Object = {}

		function Object:Set(New_, Silent)
			New_ = math.clamp(tonumber(New_) or Min, Min, Max)
			New_ = math.floor((New_ - Min) / Step + .5) * Step + Min
			New_ = math.floor(New_ * 1e4 + .5) / 1e4
			Value = New_
			ValueLabel.Text = tostring(Value)
			if not Silent then Safe(Cfg.Callback, Value) end
		end

		function Object:Get() return Value end

		local Id = 0
		local function Make(Text, Side, Delta)
			local Button = New("TextButton", {
				Text = Text, Font = FB, TextSize = 14, TextColor3 = T.Text, AutoButtonColor = false, BackgroundTransparency = 1,
				AnchorPoint = Vector2.new(Side, 0), Position = UDim2.new(Side, 0, 0, 0), Size = UDim2.fromOffset(26, 26),
			}, Holder)

			Button.MouseButton1Down:Connect(function()
				Id = Id + 1
				local Mine = Id
				Object:Set(Value + Delta * Step)
				task.delay(.4, function()
					while Id == Mine and Button.Parent do
						Object:Set(Value + Delta * Step)
						task.wait(.06)
					end
				end)
			end)
			Button.MouseButton1Up:Connect(function() Id = Id + 1 end)
			Button.MouseLeave:Connect(function() Id = Id + 1 end)
		end

		Make("-", 0, -1)
		Make("+", 1, 1)

		Object:Set(Cfg.Default or Min, true)
		return Reg(Cfg, Object)
	end

	function B:AddProgress(Cfg)
		local Max = Cfg.Max or 100
		local Row = New("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, LayoutOrder = Next() }, Container)
		Label(Row, Cfg.Title or "Progress", 12, T.Text, FM, { Size = UDim2.new(1, -60, 0, 18) })
		local ValueLabel = Label(Row, "", 11, T.Dim, FM, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(60, 18), TextXAlignment = Right })

		local Track = New("Frame", { Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = T.Track, BorderSizePixel = 0 }, Row)
		Round(Track, 3)
		local Fill = New("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Cfg.Color or T.Accent, BorderSizePixel = 0 }, Track)
		Round(Fill, 3)

		local Value = 0
		local Object = {}

		function Object:Set(New_)
			Value = math.clamp(tonumber(New_) or 0, 0, Max)
			Tw(Fill, .15, { Size = UDim2.new(Value / Max, 0, 1, 0) })
			ValueLabel.Text = string.format("%d%%", math.floor(Value / Max * 100 + .5))
		end

		function Object:Get() return Value end

		Object:Set(Cfg.Default or 0)
		return Object
	end

	function B:AddDivider(Text)
		local Holder = New("Frame", { Size = UDim2.new(1, 0, 0, Text and 20 or 8), BackgroundTransparency = 1, LayoutOrder = Next() }, Container)
		if Text then Label(Holder, string.upper(Text), 8, T.Dim, FM, { Size = UDim2.new(1, 0, 0, 12) }) end
		New("Frame", {
			AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, Text and 1 or .5, Text and 0 or 1), Size = UDim2.new(1, 0, 0, 1),
			BackgroundColor3 = T.Line, BackgroundTransparency = .3, BorderSizePixel = 0,
		}, Holder)
	end

	function B:AddParagraph(Cfg)
		local Holder = New("Frame", {
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.Bar, BackgroundTransparency = .5,
			BorderSizePixel = 0, LayoutOrder = Next(),
		}, Container)
		Round(Holder, 8)
		Pad(Holder, 12, 10, 12, 10)
		List(Holder, 4)

		local Title = Label(Holder, Cfg.Title or "", 11, T.Text, FB, { Size = UDim2.new(1, 0, 0, 14), LayoutOrder = 1, Visible = (Cfg.Title or "") ~= "" })
		local Body = Label(Holder, Cfg.Content or "", 10, T.Dim, FM, {
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 2,
		})

		return {
			Set = function(_, NewTitle, NewContent)
				Title.Text, Title.Visible = NewTitle or "", (NewTitle or "") ~= ""
				Body.Text = NewContent or ""
			end,
		}
	end

	return B
end

--// ------------------------------------------------------------------ library
local Library = {}

function Library:CreateWindow(Cfg)
	Cfg = Cfg or {}

	local Win = { Tabs = {}, Active = nil, Connections = {}, Configs = {}, CurrentConfig = nil, Flags = {}, Memory = {}, ToggleKey = Cfg.ToggleKey or Enum.KeyCode.RightShift }

	function Win:Bind(Signal, Callback)
		local Connection = Signal:Connect(Callback)
		table.insert(Win.Connections, Connection)
		return Connection
	end

	--// re-running the script replaces the old window
	pcall(function()
		local Old = ((gethui and gethui()) or game:GetService("CoreGui")):FindFirstChild("HeadshotUI")
		if Old then Old:Destroy() end
	end)

	local Gui = New("ScreenGui", { Name = "HeadshotUI", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 100 })
	Mount(Gui)

	local Frame = New("Frame", {
		Name = "Window", AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5),
		Size = Cfg.Size or UDim2.fromOffset(760, 480), BackgroundColor3 = T.Window, BackgroundTransparency = .08, BorderSizePixel = 0,
	}, Gui)
	Round(Frame, 12)
	Stroke(Frame, T.Line, 1, .5)

	--// always fits the screen (phones included)
	local Scale = New("UIScale", {}, Frame)
	local DockScale, NotifScale
	local function Fit()
		local View = Gui.AbsoluteSize
		if View.X <= 0 or View.Y <= 0 then return end
		Scale.Scale = math.clamp(math.min(View.X * .96 / 760, View.Y * .94 / 480), .4, 1)
		if DockScale then DockScale.Scale = Scale.Scale end
		if NotifScale then NotifScale.Scale = Scale.Scale end
	end
	Gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(Fit)

	--// ---- popup layer (dropdowns, color picker) + notifications + dialogs
	Win.Scale = Scale

	local Overlay = New("Frame", { Name = "Overlay", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 50 }, Frame)
	local Catcher = New("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ZIndex = 1 }, Overlay)

	local Popup, PopupConns = nil, {}

	function Win:ClosePopup()
		for _, Connection in ipairs(PopupConns) do pcall(function() Connection:Disconnect() end) end
		PopupConns = {}
		if Popup then
			local Old = Popup
			Popup = nil
			Old:Destroy()
		end
		Catcher.Visible = false
	end

	--// connections that live only while the popup is open
	function Win:PopupBind(Signal, Callback)
		local Connection = Signal:Connect(Callback)
		table.insert(PopupConns, Connection)
		return Connection
	end

	Catcher.MouseButton1Click:Connect(function() Win:ClosePopup() end)

	--// Anchor = the button that opens it. Width / Height are in window units. Align = "Left" | "Right"
	function Win:ShowPopup(Anchor, Width, Height, Align)
		Win:ClosePopup()

		local S = math.max(Scale.Scale, .01)
		local Origin, Place, Size = Frame.AbsolutePosition, Anchor.AbsolutePosition, Anchor.AbsoluteSize
		local Window = Frame.AbsoluteSize / S

		local X = (Place.X - Origin.X) / S
		local Y = (Place.Y + Size.Y - Origin.Y) / S + 4
		if Align == "Right" then X = X + Size.X / S - Width end

		X = math.clamp(X, 8, math.max(Window.X - Width - 8, 8))
		if Y + Height > Window.Y - 8 then Y = (Place.Y - Origin.Y) / S - Height - 4 end
		Y = math.max(Y, 8)

		Popup = New("Frame", {
			Position = UDim2.fromOffset(X, Y), Size = UDim2.fromOffset(Width, Height), BackgroundColor3 = T.Panel,
			BorderSizePixel = 0, ZIndex = 2, ClipsDescendants = true,
		}, Overlay)
		Round(Popup, 8)
		Stroke(Popup, T.Line, 1, .3)

		Catcher.Visible = true
		return Popup
	end

	--// notifications (top right)
	local NotifHolder = New("Frame", {
		Name = "Notifications", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 16), Size = UDim2.fromOffset(270, 0),
		AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ZIndex = 80,
	}, Gui)
	NotifScale = New("UIScale", {}, NotifHolder)
	New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Right }, NotifHolder)

	local NotifKinds = { Info = T.Accent, Success = T.Green, Warning = Color3.fromRGB(255, 196, 61), Error = Color3.fromRGB(235, 72, 84) }
	local NotifOrder = 0

	--// Win:Notify({ Title, Content, Type = "Info" | "Success" | "Warning" | "Error", Duration = 4 })
	function Win:Notify(Info)
		if type(Info) == "string" then Info = { Content = Info } end
		NotifOrder = NotifOrder + 1

		local Color = NotifKinds[Info.Type or "Info"] or T.Accent
		local Duration = Info.Duration or 4

		local Card = New("CanvasGroup", {
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.Window, BorderSizePixel = 0,
			GroupTransparency = 1, LayoutOrder = NotifOrder,
		}, NotifHolder)
		Round(Card, 10)

		New("Frame", { Size = UDim2.new(0, 3, 1, 0), BackgroundColor3 = Color, BorderSizePixel = 0 }, Card)

		local Body = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 }, Card)
		Pad(Body, 16, 10, 12, 14)
		List(Body, 3)

		Label(Body, Info.Title or "Notification", 12, T.Text, FB, { Size = UDim2.new(1, 0, 0, 16), LayoutOrder = 1 })
		if Info.Content and Info.Content ~= "" then
			Label(Body, Info.Content, 10, T.Dim, FM, {
				Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 2,
			})
		end

		local Timer = New("Frame", {
			AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 2),
			BackgroundColor3 = Color, BackgroundTransparency = .4, BorderSizePixel = 0,
		}, Card)

		local Click = New("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 5 }, Card)

		local Closed = false
		local function Close()
			if Closed then return end
			Closed = true
			Tw(Card, .25, { GroupTransparency = 1 })
			task.delay(.3, function() Card:Destroy() end)
		end

		Click.MouseButton1Click:Connect(Close)
		Tw(Card, .25, { GroupTransparency = 0 })
		TS:Create(Timer, TweenInfo.new(Duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 2) }):Play()
		task.delay(Duration, Close)

		return { Close = Close }
	end

	--// Win:Dialog({ Title, Content, Buttons = { { Title, Style, Callback }, ... } })
	function Win:Dialog(Info)
