			Item.MouseButton1Click:Connect(function()
				Win.CurrentConfig = Name
				ConfigText.Text = Name
				ConfigList.Visible = false
				Win:LoadConfigFile(Name, true)
				Safe(Cfg.OnConfig, Name)
			end)
		end

		ConfigList.Size = UDim2.fromOffset(133, #Win.Configs * 24 + 8)
		Win.CurrentConfig = Selected or Win.Configs[1] or "default"
		ConfigText.Text = Win.CurrentConfig
	end

	--// ---- config system (every element that has a Flag is saved)
	local FolderName = Cfg.Folder or "HeadshotUI"

	local function HasFS()
		return type(writefile) == "function" and type(readfile) == "function" and type(isfolder) == "function"
			and type(makefolder) == "function" and type(isfile) == "function"
	end

	function Win:GetConfig()
		local Data = {}
		for Flag, Object in pairs(Win.Flags) do
			if Object.Get then Data[Flag] = Encode(Object:Get()) end
		end
		return Data
	end

	function Win:LoadConfig(Data)
		for Flag, Value in pairs(Data or {}) do
			local Object = Win.Flags[Flag]
			if Object and Object.Set then pcall(Object.Set, Object, Decode(Value)) end
		end
