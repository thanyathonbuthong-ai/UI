--// one button factory used by AddButton / AddButtonGroup / Dialog
local function MakeButton(Parent, Cfg, Size, Order)
	local S = Styles[Cfg.Style or (Cfg.Accent and "Accent") or "Default"] or Styles.Default
	local Title = Cfg.Title or "Button"
	local Disabled = Cfg.Disabled == true
	local Armed = false

	local Button = New("TextButton", {
		Text = Title, Font = FB, TextSize = 11, AutoButtonColor = false, BorderSizePixel = 0,
		TextColor3 = S.Text, BackgroundColor3 = S.Bg, BackgroundTransparency = S.Alpha,
		Size = Size, LayoutOrder = Order or 0,
	}, Parent)
	Round(Button, 8)
	if S.Stroke then Stroke(Button, S.Stroke, 1, .15) end

	if Cfg.Icon then
		Pad(Button, 26, 0, 10, 0)
		New("ImageLabel", {
			Image = Cfg.Icon, ImageColor3 = S.Text, BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, -18, .5, 0), Size = UDim2.fromOffset(14, 14),
		}, Button)
	end

	local Object = { Instance = Button }

	Button.MouseEnter:Connect(function()
		if not Disabled then Tw(Button, .15, { BackgroundTransparency = S.Alpha == 1 and .85 or .2 }) end
	end)
	Button.MouseLeave:Connect(function() Tw(Button, .15, { BackgroundTransparency = S.Alpha }) end)

	function Object:Fire()
		if Disabled then return end
		if Cfg.Confirm and not Armed then
			Armed = true
			Button.Text = Cfg.ConfirmText or "Click again to confirm"
			task.delay(2, function()
				if Armed then Armed = false Button.Text = Title end
			end)
			return
		end
		Armed = false
		Button.Text = Title
		Safe(Cfg.Callback)
	end

	function Object:SetTitle(Text) Title = Text Button.Text = Text end

	function Object:SetDisabled(State)
		Disabled = State and true or false
		Button.TextTransparency = Disabled and .55 or 0
	end

	Button.MouseButton1Click:Connect(function() Object:Fire() end)
	Object:SetDisabled(Disabled)
	return Object
end

--// dropdown popup list (single + multi). Pick(name) is called on click; Multi keeps the popup open
local function OpenList(Win, Anchor, Options, IsOn, Pick, Opt)
	Opt = Opt or {}
	local Rows = math.clamp(#Options, 1, 6)
	local SearchH = Opt.Search and 30 or 0
	local Width = Opt.Width or math.max(Anchor.AbsoluteSize.X / math.max(Win.Scale.Scale, .01), 130)
	local Popup = Win:ShowPopup(Anchor, Width, Rows * 24 + 8 + SearchH, Opt.Align)
	Pad(Popup, 4, 4, 4, 4)

	local Box
	if Opt.Search then
		Box = New("TextBox", {
			Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = T.Bar, BorderSizePixel = 0, Text = "", PlaceholderText = "Search...",
			PlaceholderColor3 = T.Dim, TextColor3 = T.Text, Font = FM, TextSize = 10, ClearTextOnFocus = false, TextXAlignment = Left, ZIndex = 3,
		}, Popup)
		Round(Box, 6)
		Pad(Box, 8, 0, 8, 0)
	end

	local Scroll = New("ScrollingFrame", {
		Position = UDim2.fromOffset(0, SearchH), Size = UDim2.new(1, 0, 1, -SearchH), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 2, ScrollBarImageColor3 = T.Accent, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 3,
	}, Popup)
	List(Scroll, 2)

	local Items = {}
	local function Refresh()
		for Name, Item in pairs(Items) do
			local On = IsOn(Name)
			Item.Dot.Visible = On
			Item.Button.TextColor3 = On and T.Text or T.Dim
		end
	end

	for Index, Name in ipairs(Options) do
		local Button = New("TextButton", {
			Text = tostring(Name), Font = FM, TextSize = 10, TextColor3 = T.Dim, TextXAlignment = Left, AutoButtonColor = false,
			BackgroundColor3 = T.Bar, BackgroundTransparency = 1, Size = UDim2.new(1, -4, 0, 22), LayoutOrder = Index, BorderSizePixel = 0, ZIndex = 4,
		}, Scroll)
		Round(Button, 5)
		Pad(Button, 8, 0, 22, 0)

		local Dot = New("Frame", {
			AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, 14, .5, 0), Size = UDim2.fromOffset(6, 6),
			BackgroundColor3 = T.Accent, BorderSizePixel = 0, ZIndex = 5,
		}, Button)
		Round(Dot, 3)

		Button.MouseEnter:Connect(function() Button.BackgroundTransparency = .3 end)
		Button.MouseLeave:Connect(function() Button.BackgroundTransparency = 1 end)
		Button.MouseButton1Click:Connect(function()
			Pick(Name)
			if Opt.Multi then Refresh() else Win:ClosePopup() end
		end)

		Items[Name] = { Button = Button, Dot = Dot }
	end

	Refresh()

	if Box then
		Box:GetPropertyChangedSignal("Text"):Connect(function()
			local Query = string.lower(Box.Text)
			for Name, Item in pairs(Items) do
				Item.Button.Visible = Query == "" or string.find(string.lower(tostring(Name)), Query, 1, true) ~= nil
			end
		end)
	end

	return Popup
end

--// config (de)serialising
local function Encode(Value)
	local Kind = typeof(Value)
	if Value == nil then return { __nil = true } end
	if Kind == "Color3" then return { __c = { Value.R, Value.G, Value.B } } end
	if Kind == "EnumItem" then return { __k = Value.Name } end
	return Value
end

local function Decode(Value)
	if type(Value) == "table" then
		if Value.__nil then return nil end
		if Value.__c then return Color3.new(Value.__c[1], Value.__c[2], Value.__c[3]) end
		if Value.__k then
			local Ok, Key = pcall(function() return Enum.KeyCode[Value.__k] end)
			return Ok and Key or nil
		end
	end
	return Value
end

--// mouse / touch position in ScreenGui space (IgnoreGuiInset = true)
local function GuiPoint(Input)
	return Vector2.new(Input.Position.X, Input.Position.Y + GuiService:GetGuiInset().Y)
end

--// ------------------------------------------------------------------ element builder (used by sections and rows)
local function Builder(Container, Win, IsRow)
	local B = {}
	local Order = 0
	local function Next() Order = Order + 1 return Order end

	--// registers the element in the config system (Flag) and remembers its default for Reset
	local function Reg(Cfg, Object)
		if Object.Get then Object.Default = Object:Get() end
		if Cfg and Cfg.Flag and Win.Flags then Win.Flags[Cfg.Flag] = Object end
		return Object
	end

	function B:AddRow(Cfg)
		Cfg = Cfg or {}
		local Row = New("Frame", { Size = UDim2.new(1, 0, 0, Cfg.Height or 30), BackgroundTransparency = 1, LayoutOrder = Next() }, Container)
		New("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, Cfg.Gap or 8), VerticalAlignment = Enum.VerticalAlignment.Center,
		}, Row)
		return Builder(Row, Win, true)
	end

	function B:AddLabel(Text)
		local Object = Label(Container, Text, 11, T.Dim, FM, { Size = UDim2.new(1, 0, 0, 16), LayoutOrder = Next(), TextWrapped = true })
		return { Set = function(_, NewText) Object.Text = NewText end }
	end

	function B:AddToggle(Cfg)
		local Row = New("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, LayoutOrder = Next() }, Container)
		Label(Row, Cfg.Title or "Toggle", 12, T.Text, FM, { Size = UDim2.new(1, -50, 1, 0) })

		local Switch = New("TextButton", {
			Text = "", AutoButtonColor = false, AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, 0, .5, 0),
			Size = UDim2.fromOffset(34, 18), BackgroundColor3 = T.Track, BorderSizePixel = 0,
		}, Row)
		Round(Switch, 9)

		local Knob = New("Frame", {
			AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 2, .5, 0), Size = UDim2.fromOffset(14, 14),
			BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
		}, Switch)
		Round(Knob, 7)

		local State = false
		local Object = {}

		function Object:Set(Value, Silent)
			State = Value and true or false
			Tw(Switch, .15, { BackgroundColor3 = State and T.Accent or T.Track })
			Tw(Knob, .15, { Position = State and UDim2.new(1, -16, .5, 0) or UDim2.new(0, 2, .5, 0) })
			if not Silent then Safe(Cfg.Callback, State) end
		end

		function Object:Get() return State end

		Switch.MouseButton1Click:Connect(function() Object:Set(not State) end)
		Object:Set(Cfg.Default, true)
		return Reg(Cfg, Object)
	end

	function B:AddSlider(Cfg)
		local Min, Max, Step = Cfg.Min or 0, Cfg.Max or 100, Cfg.Step or 1
		local Row = New("Frame", { Size = UDim2.new(1, 0, 0, 42), BackgroundTransparency = 1, LayoutOrder = Next() }, Container)

		Label(Row, Cfg.Title or "Slider", 12, T.Text, FM, { Size = UDim2.new(1, -60, 0, 18) })
		local ValueLabel = Label(Row, "", 11, T.Dim, FM, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(60, 18), TextXAlignment = Right })

		local Track = New("Frame", { Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = T.Track, BorderSizePixel = 0 }, Row)
		Round(Track, 3)
		local Fill = New("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = T.Accent, BorderSizePixel = 0 }, Track)
		Round(Fill, 3)

		local Hit = New("TextButton", { Text = "", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 22) }, Row)

		local Value = Min
		local Object = {}

		function Object:Set(New_, Silent)
			New_ = math.clamp(tonumber(New_) or Min, Min, Max)
			New_ = math.floor((New_ - Min) / Step + .5) * Step + Min
			New_ = math.floor(New_ * 1e4 + .5) / 1e4
			Value = New_
			Fill.Size = UDim2.new((Value - Min) / math.max(Max - Min, 1e-9), 0, 1, 0)
			ValueLabel.Text = tostring(Value)
			if not Silent then Safe(Cfg.Callback, Value) end
		end

		function Object:Get() return Value end

		local Dragging = false
		local function FromX(X)
			Object:Set(Min + (Max - Min) * math.clamp((X - Track.AbsolutePosition.X) / math.max(Track.AbsoluteSize.X, 1), 0, 1))
		end

		Hit.InputBegan:Connect(function(Input)
			if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
				Dragging = true
				FromX(Input.Position.X)
			end
		end)

		Win:Bind(UIS.InputChanged, function(Input)
			if Dragging and (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then
				FromX(Input.Position.X)
			end
		end)

		Win:Bind(UIS.InputEnded, function(Input)
			if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then Dragging = false end
		end)

		Object:Set(Cfg.Default or Min, true)
		return Reg(Cfg, Object)
	end

	--// Guns | Knives   (rounded bar with an orange pill that slides)
	function B:AddSegmented(Cfg)
		local Options = Cfg.Options or {}
		local Count = math.max(#Options, 1)
		local Holder = New("Frame", {
			Size = UDim2.fromOffset(Cfg.Width or 140, 28), BackgroundColor3 = T.Bar, BorderSizePixel = 0, LayoutOrder = Next(),
		}, Container)
		Round(Holder, 14)

		local Inner = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, Holder)
		Pad(Inner, 3, 3, 3, 3)

		local Pill = New("Frame", { Size = UDim2.new(1 / Count, 0, 1, 0), BackgroundColor3 = T.Accent, BorderSizePixel = 0 }, Inner)
		Round(Pill, 11)

		local Buttons, Current = {}, nil
		local Object = {}

		function Object:Set(Name, Silent)
			for Index, Option in ipairs(Options) do
				local Active = Option == Name
				if Active then
					Current = Option
					Tw(Pill, .2, { Position = UDim2.new((Index - 1) / Count, 0, 0, 0) })
				end
				Buttons[Index].TextColor3 = Active and Color3.new(1, 1, 1) or T.Dim
			end
			if not Silent then Safe(Cfg.Callback, Current) end
		end

		function Object:Get() return Current end

		for Index, Option in ipairs(Options) do
			local Button = New("TextButton", {
				Text = Option, Font = FB, TextSize = 10, BackgroundTransparency = 1, AutoButtonColor = false,
				Size = UDim2.new(1 / Count, 0, 1, 0), Position = UDim2.new((Index - 1) / Count, 0, 0, 0), ZIndex = 2,
			}, Inner)
			Buttons[Index] = Button
			Button.MouseButton1Click:Connect(function() Object:Set(Option) end)
		end

		Object:Set(Cfg.Default or Options[1], true)
		return Reg(Cfg, Object)
	end

	function B:AddSearch(Cfg)
		local Box = New("Frame", {
			Size = UDim2.fromOffset(Cfg.Width or 300, 28), BackgroundColor3 = T.Bar, BackgroundTransparency = .1,
			BorderSizePixel = 0, LayoutOrder = Next(),
		}, Container)
		Round(Box, 14)

		New("ImageLabel", {
			Image = Icons.search, ImageColor3 = T.Text, BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 7), Size = UDim2.fromOffset(14, 14),
		}, Box)

		local Input = New("TextBox", {
			Position = UDim2.fromOffset(34, 0), Size = UDim2.new(1, -44, 1, 0), BackgroundTransparency = 1,
			Text = Cfg.Default or "", PlaceholderText = Cfg.Placeholder or "Search...", PlaceholderColor3 = T.Dim,
			TextColor3 = T.Text, Font = FM, TextSize = 11, TextXAlignment = Left, ClearTextOnFocus = false,
		}, Box)

		--// fills the rest of the row (UIFlexItem); falls back to the fixed width when it isn't available
		if IsRow then
			pcall(function()
				local Flex = Instance.new("UIFlexItem")
				Flex.FlexMode = Enum.UIFlexMode.Fill
				Flex.Parent = Box
			end)
		end

		Input:GetPropertyChangedSignal("Text"):Connect(function() Safe(Cfg.Callback, Input.Text) end)

		return Reg(Cfg, { Instance = Box, Get = function() return Input.Text end, Set = function(_, Text) Input.Text = Text end })
	end

	function B:AddCounter(Text, Width)
		local Object = Label(Container, Text or "", 10, T.Dim, FM, {
			Size = UDim2.fromOffset(Width or 110, 28), TextXAlignment = Right, LayoutOrder = Next(),
		})
		return { Set = function(_, NewText) Object.Text = NewText end }
	end

	--// All | Common | ...  (text takes the colour of its rarity, the selected chip turns orange)
	function B:AddChips(Cfg)
		local Holder = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = Next() }, Container)
		New("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal, Wraps = true, SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
		}, Holder)

		local Chips, Current = {}, nil
		local Object = {}

		function Object:Set(Name, Silent)
			Current = Name
			for Key, Chip in pairs(Chips) do
				local Active = Key == Name
				Tw(Chip.Button, .15, { BackgroundColor3 = Active and T.Accent or T.Bar })
				Chip.Button.TextColor3 = Active and Color3.new(1, 1, 1) or Chip.Color
			end
			if not Silent then Safe(Cfg.Callback, Name) end
		end

		function Object:Get() return Current end

		for Index, Option in ipairs(Cfg.Options or {}) do
			local Name = type(Option) == "table" and Option.Name or tostring(Option)
			local Color = (type(Option) == "table" and Option.Color) or Rarity[Name] or T.Text

			local Button = New("TextButton", {
				Text = Name, Font = FM, TextSize = 10, TextColor3 = Color, AutoButtonColor = false,
				AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 24), BackgroundColor3 = T.Bar,
				BorderSizePixel = 0, LayoutOrder = Index,
			}, Holder)
			Round(Button, 12)
			Pad(Button, 14, 0, 14, 0)

			Chips[Name] = { Button = Button, Color = Color }
			Button.MouseButton1Click:Connect(function() Object:Set(Name) end)
		end

		Object:Set(Cfg.Default or (Cfg.Options and (type(Cfg.Options[1]) == "table" and Cfg.Options[1].Name or Cfg.Options[1])), true)
		return Reg(Cfg, Object)
	end

	--// skin cards: round tinted icon, name, rarity
	function B:AddGrid(Cfg)
		Cfg = Cfg or {}
		local Grid = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = Next() }, Container)
		New("UIGridLayout", {
			CellSize = Cfg.CellSize or UDim2.fromOffset(106, 114), CellPadding = UDim2.fromOffset(6, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}, Grid)

		local Object = { Items = {}, Selected = nil }

		function Object:AddItem(Info)
			local Item = { Info = Info }
			local RarityColor = Info.RarityColor or Rarity[Info.Rarity or ""] or T.Dim

			local Card = New("TextButton", {
				Text = "", AutoButtonColor = false, BackgroundColor3 = T.Card, BackgroundTransparency = .2,
				BorderSizePixel = 0, LayoutOrder = #Object.Items + 1,
			}, Grid)
			Round(Card, 8)
			local Edge = Stroke(Card, Color3.new(1, 1, 1), 1, 1)

			local Circle = New("Frame", {
				AnchorPoint = Vector2.new(.5, 0), Position = UDim2.new(.5, 0, 0, 8), Size = UDim2.fromOffset(70, 70),
				BackgroundColor3 = Info.Tint or Color3.fromRGB(110, 50, 120), BackgroundTransparency = .15, BorderSizePixel = 0,
			}, Card)
			Round(Circle, 35)

			New("ImageLabel", {
				AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromScale(.92, .92),
				BackgroundTransparency = 1, Image = Info.Image or "", ScaleType = Enum.ScaleType.Fit,
			}, Circle)

			Label(Card, Info.Name or "Item", 9, T.Text, FB, { Position = UDim2.fromOffset(0, 84), Size = UDim2.new(1, 0, 0, 14), TextXAlignment = Center, TextTruncate = Enum.TextTruncate.AtEnd })
			Label(Card, Info.Rarity or "", 8, RarityColor, FM, { Position = UDim2.fromOffset(0, 97), Size = UDim2.new(1, 0, 0, 12), TextXAlignment = Center })

			Item.Card = Card
			Card.MouseEnter:Connect(function() if Object.Selected ~= Item then Tw(Card, .15, { BackgroundTransparency = .05 }) end end)
			Card.MouseLeave:Connect(function() if Object.Selected ~= Item then Tw(Card, .15, { BackgroundTransparency = .2 }) end end)

			function Item:Select(Silent)
				local Old = Object.Selected
				if Old and Old.Card.Parent then
					Tw(Old.Card, .15, { BackgroundTransparency = .2 })
					Tw(Old.Edge, .15, { Transparency = 1 })
				end
				Object.Selected = Item
				Tw(Card, .15, { BackgroundTransparency = .05 })
				Tw(Edge, .15, { Transparency = .45 })
				if not Silent then Safe(Info.Callback, Info) Safe(Cfg.Callback, Info) end
			end

			Item.Edge = Edge
			Card.MouseButton1Click:Connect(function() Item:Select() end)

			table.insert(Object.Items, Item)
			return Item
		end

		--// Grid:Filter(function(info) return true end) -> number of visible cards
		function Object:Filter(Check)
			local Shown = 0
			for _, Item in ipairs(Object.Items) do
				local Ok = Check == nil or Check(Item.Info)
				Item.Card.Visible = Ok and true or false
				if Ok then Shown = Shown + 1 end
			end
			return Shown
		end

		function Object:Clear()
			for _, Item in ipairs(Object.Items) do Item.Card:Destroy() end
			Object.Items, Object.Selected = {}, nil
		end

		return Object
	end


