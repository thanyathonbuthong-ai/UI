	--// Mode: "Press" (default) | "Toggle" | "Hold".   Callback(key) = rebound, Pressed(state) = key used
	function B:AddKeybind(Cfg)
		local Mode = Cfg.Mode or "Press"
		local Row = New("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, LayoutOrder = Next() }, Container)
		Label(Row, Cfg.Title or "Keybind", 12, T.Text, FM, { Size = UDim2.new(1, -100, 1, 0) })

		local Button = New("TextButton", {
			Text = "", AutoButtonColor = false, AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, 0, .5, 0),
			Size = UDim2.fromOffset(88, 24), BackgroundColor3 = T.Bar, BorderSizePixel = 0,
		}, Row)
		Round(Button, 7)
		local Text = Label(Button, "", 10, T.Text, FB, { Size = UDim2.fromScale(1, 1), TextXAlignment = Center })

		local Key, Listening, State = nil, false, false
		local Object = {}

		local function Draw()
			Text.Text = Listening and "..." or (Key and Key.Name or "None")
			Text.TextColor3 = Listening and T.Accent or (Key and T.Text or T.Dim)
			Tw(Button, .15, { BackgroundColor3 = Listening and T.Track or T.Bar })
		end

		function Object:Set(NewKey, Silent)
			if type(NewKey) == "string" then
				local Ok, Found = pcall(function() return Enum.KeyCode[NewKey] end)
				NewKey = Ok and Found or nil
			end
			Key, Listening = NewKey, false
			Draw()
			if not Silent then Safe(Cfg.Callback, Key) end
		end

		function Object:Get() return Key end
		function Object:GetState() return State end

		Button.MouseButton1Click:Connect(function() Listening = true Draw() end)

		Win:Bind(UIS.InputBegan, function(Input, Processed)
			if Listening then
				if Input.UserInputType == Enum.UserInputType.Keyboard then
					if Input.KeyCode == Enum.KeyCode.Escape then Object:Set(nil) else Object:Set(Input.KeyCode) end
				elseif Input.UserInputType == Enum.UserInputType.MouseButton1 then
					Listening = false
					Draw()
				end
				return
			end

			if Processed or not Key or Input.KeyCode ~= Key then return end
			if Mode == "Toggle" then State = not State elseif Mode == "Hold" then State = true end
			Safe(Cfg.Pressed, Mode == "Press" or State)
		end)

		Win:Bind(UIS.InputEnded, function(Input)
			if Mode == "Hold" and State and Key and Input.KeyCode == Key then
				State = false
				Safe(Cfg.Pressed, false)
			end
		end)

		Object:Set(Cfg.Default, true)
		return Reg(Cfg, Object)
	end

	function B:AddColorPicker(Cfg)
