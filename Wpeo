			end
		end)
		Win:Bind(UIS.InputChanged, function(Input)
			if Dragging and (Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch) then
				local Delta = (Input.Position - Start) / math.max(Scale.Scale, .01)
				Frame.Position = UDim2.new(Origin.X.Scale, Origin.X.Offset + Delta.X * Scale.Scale, Origin.Y.Scale, Origin.Y.Offset + Delta.Y * Scale.Scale)
			end
		end)
		Win:Bind(UIS.InputEnded, function(Input)
			if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then Dragging = false end
		end)
	end

	--// top tabs
	local TabsHolder = New("Frame", { Position = UDim2.fromOffset(166, 0), Size = UDim2.new(0, 400, 1, 0), BackgroundTransparency = 1 }, Header)
