	Round(Dot, 3)
	local StatusLabel = Label(Footer, Cfg.Status or "Connected", 9, T.Dim, FM, { AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 31, .5, 1), Size = UDim2.fromOffset(80, 14) })
	local GameLabel = Label(Footer, Cfg.Game or "", 9, T.Dim, FM, { AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 118, .5, 1), Size = UDim2.fromOffset(120, 14) })

	local Save = New("TextButton", {
		Text = "Save config", Font = FB, TextSize = 10, TextColor3 = Color3.new(1, 1, 1), AutoButtonColor = false,
