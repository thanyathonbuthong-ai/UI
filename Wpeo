	function Win:ListConfigs()
		local Names, Seen = { "default" }, { default = true }

		if HasFS() and type(listfiles) == "function" and isfolder(FolderName) then
			pcall(function()
				for _, Path in ipairs(listfiles(FolderName)) do
					local Name = string.match(Path, "([^/\\]+)%.json$")
					if Name and not Seen[Name] then
						Seen[Name] = true
						table.insert(Names, Name)
					end
				end
			end)
		end

		for Name in pairs(Win.Memory) do
			if not Seen[Name] then
				Seen[Name] = true
				table.insert(Names, Name)
			end
		end

		return Names
	end

	--// writes <folder>/<name>.json (falls back to memory when the executor has no file functions)
	function Win:SaveConfig(Name, Silent)
		Name = (Name and Name ~= "") and Name or Win.CurrentConfig or "default"
		Name = (string.gsub(Name, "[^%w_%- ]", ""))
		if Name == "" then Name = "default" end

		local Data = Win:GetConfig()
		local Saved = false

		if HasFS() then
			Saved = pcall(function()
				if not isfolder(FolderName) then makefolder(FolderName) end
				writefile(FolderName .. "/" .. Name .. ".json", HttpService:JSONEncode(Data))
			end)
		end

		if not Saved then Win.Memory[Name] = Data end

		Win:SetConfigs(Win:ListConfigs(), Name)
		if not Silent then
			Win:Notify({ Title = "Config saved", Content = Name .. (Saved and "" or "  (memory only)"), Type = "Success", Duration = 2.5 })
		end
		return Saved
	end

	function Win:LoadConfigFile(Name, Silent)
		local Data

		if HasFS() then
			pcall(function()
				local Path = FolderName .. "/" .. Name .. ".json"
				if isfile(Path) then Data = HttpService:JSONDecode(readfile(Path)) end
			end)
		end

		Data = Data or Win.Memory[Name]
		if not Data then return false end

		Win:LoadConfig(Data)
		if not Silent then
			Win:Notify({ Title = "Config loaded", Content = Name, Type = "Info", Duration = 2.5 })
		end
		return true
	end

	function Win:DeleteConfig(Name)
		if Name == nil or Name == "default" then return false end
		Win.Memory[Name] = nil
		if HasFS() and type(delfile) == "function" then
			pcall(function()
				local Path = FolderName .. "/" .. Name .. ".json"
				if isfile(Path) then delfile(Path) end
			end)
		end
		Win:SetConfigs(Win:ListConfigs(), "default")
		Win:Notify({ Title = "Config deleted", Content = Name, Type = "Warning", Duration = 2.5 })
		return true
	end

