--[[
================================================================================
  GlassUI — Roblox UI Library
  Style : Glassmorphism + Dark Theme + Multi-Palette Gradient + Neon Glow
  Support : Desktop (Mouse/Keyboard) + Mobile (Touch) — fully responsive
  Usage : local GlassUI = require(path.to.GlassUI)
          local Window = GlassUI.CreateWindow({ Title = "My Hub", Theme = GlassUI.Themes.PurpleBlue })
================================================================================
]]

local GlassUI = {}

--// Services
local TweenService      = game:GetService("TweenService")
local UserInputService  = game:GetService("UserInputService")
local RunService        = game:GetService("RunService")
local Players           = game:GetService("Players")

--// Device detection
local IS_MOBILE = UserInputService.TouchEnabled and not UserInputService.MouseEnabled

--// Tween presets
local QUICK  = TweenInfo.new(0.18, Enum.EasingStyle.Quad,  Enum.EasingDirection.Out)
local SMOOTH = TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local SPRING = TweenInfo.new(0.5,  Enum.EasingStyle.Back,  Enum.EasingDirection.Out)

--// Responsive metrics
local SIDE_W   = IS_MOBILE and 64  or 150
local PAD      = IS_MOBILE and 12  or 16
local BTN_H    = IS_MOBILE and 46  or 36
local ROW_GAP  = IS_MOBILE and 10  or 8
local FONT     = Enum.Font.Gotham
local FONT_B   = Enum.Font.GothamBold

--// Rainbow sequence (for sliders / progress bars)
local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0.00, Color3.fromHex("#FF2D55")),
	ColorSequenceKeypoint.new(0.20, Color3.fromHex("#FF9500")),
	ColorSequenceKeypoint.new(0.40, Color3.fromHex("#FFCC00")),
	ColorSequenceKeypoint.new(0.60, Color3.fromHex("#34D399")),
	ColorSequenceKeypoint.new(0.80, Color3.fromHex("#00C2FF")),
	ColorSequenceKeypoint.new(1.00, Color3.fromHex("#C44DFF")),
})

--// 5+ gradient palettes (C1 -> C2)
GlassUI.Themes = {
	PurpleBlue   = { Name = "PurpleBlue",   C1 = Color3.fromHex("#8B5CF6"), C2 = Color3.fromHex("#3B82F6"), Glow = Color3.fromHex("#6366F1") },
	PinkGold     = { Name = "PinkGold",     C1 = Color3.fromHex("#EC4899"), C2 = Color3.fromHex("#F59E0B"), Glow = Color3.fromHex("#F472B6") },
	MintCyan     = { Name = "MintCyan",     C1 = Color3.fromHex("#34D399"), C2 = Color3.fromHex("#22D3EE"), Glow = Color3.fromHex("#2DD4BF") },
	BlueLavender = { Name = "BlueLavender", C1 = Color3.fromHex("#2563EB"), C2 = Color3.fromHex("#A78BFA"), Glow = Color3.fromHex("#60A5FA") },
	RoseLavender = { Name = "RoseLavender", C1 = Color3.fromHex("#BE185D"), C2 = Color3.fromHex("#C084FC"), Glow = Color3.fromHex("#E879F9") },
	Gold         = { Name = "Gold",         C1 = Color3.fromHex("#FBBF24"), C2 = Color3.fromHex("#F97316"), Glow = Color3.fromHex("#FCD34D") },
}

--================================================================================
--// Basic helpers
--================================================================================
local function corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
	return c
end

local function stroke(parent, color, thickness, trans)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	s.Transparency = trans or 0.5
	s.LineJoinMode = Enum.LineJoinMode.Round
	s.Parent = parent
	return s
end

local function gradient(parent, c1, c2, rotation, trans)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(c1, c2)
	g.Rotation = rotation or 90
	g.Transparency = NumberSequence.new(trans or 0)
	g.Parent = parent
	return g
end

local function tween(obj, info, props)
	local t = TweenService:Create(obj, info, props)
	t:Play()
	return t
end

-- Soft glow built from 3 stacked, oversized, semi-transparent rounded frames
-- (asset-free, works everywhere). Parent = container behind the element.
local function addGlow(container, color, radius, baseTrans)
	local layers = {}
	for i = 1, 3 do
		local f = Instance.new("Frame")
		f.Name = "GlowLayer" .. i
		f.BackgroundColor3 = color
		f.BackgroundTransparency = (baseTrans or 0.85) + (i - 1) * 0.06
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromScale(0.5, 0.5)
		f.Size = UDim2.fromScale(1 + (i - 1) * 0.22, 1 + (i - 1) * 0.22)
		f.ZIndex = 1
		corner(f, radius + (i - 1) * 8)
		f.Parent = container
		layers[i] = f
	end
	return layers
end

local function setGlow(layers, trans)
	for _, l in ipairs(layers) do
		tween(l, QUICK, { BackgroundTransparency = trans })
	end
end

-- A "slot" is a transparent row container that holds [glow layers + element].
-- It lets glow spill outside the element while the slot stays layout-friendly.
local function slot(page, height)
	local s = Instance.new("Frame")
	s.BackgroundTransparency = 1
	s.Size = UDim2.new(1, 0, 0, height)
	s.Parent = page
	return s
end

-- Hover / press feedback (hover skipped on touch devices)
local function bindFeedback(btn, scaleObj, glowLayers)
	local function enter()
		tween(scaleObj, QUICK, { Scale = 1.06 })
		setGlow(glowLayers, 0.65)
	end
	local function leave()
		tween(scaleObj, QUICK, { Scale = 1 })
		setGlow(glowLayers, 0.85)
	end
	if not IS_MOBILE then
		btn.MouseEnter:Connect(enter)
		btn.MouseLeave:Connect(leave)
	end
	btn.MouseButton1Down:Connect(function() tween(scaleObj, QUICK, { Scale = 0.94 }) end)
	btn.MouseButton1Up:Connect(function()   tween(scaleObj, QUICK, { Scale = 1.06 }) end)
end

--================================================================================
--// Window
--================================================================================
function GlassUI.CreateWindow(options)
	options = options or {}
	local theme      = options.Theme or GlassUI.Themes.PurpleBlue
	local titleText  = options.Title or "Glass UI"
	local subText    = options.Subtitle or "Premium UI Library"
	local player     = Players.LocalPlayer

	--// ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = options.Name or "GlassUI"
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.IgnoreGuiInset = true
	gui.Parent = player:WaitForChild("PlayerGui")

	--// Ambient background blobs (purple / blue / pink / gold / green)
	local blobColors = { Color3.fromHex("#7C3AED"), Color3.fromHex("#2563EB"), Color3.fromHex("#DB2777"), Color3.fromHex("#F59E0B"), Color3.fromHex("#10B981") }
	local blobPos = {
		UDim2.fromScale(-0.05, -0.08), UDim2.fromScale(0.75, -0.1), UDim2.fromScale(-0.1, 0.7),
		UDim2.fromScale(0.8, 0.75), UDim2.fromScale(0.45, 0.5),
	}
	for i, col in ipairs(blobColors) do
		local b = Instance.new("Frame")
		b.BackgroundColor3 = col
		b.BackgroundTransparency = 0.9
		b.Size = UDim2.fromOffset(340, 340)
		b.Position = blobPos[i]
		corner(b, 200)
		b.Parent = gui
		tween(b, TweenInfo.new(5 + i, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ Position = blobPos[i] + UDim2.fromOffset(60, -50) })
	end

	--// Main window frame
	local main = Instance.new("Frame")
	main.Name = "MainWindow"
	main.BackgroundColor3 = Color3.fromHex("#120B24")
	main.BackgroundTransparency = 0.22
	main.AnchorPoint = Vector2.new(0.5, 0.5)
	main.Position = UDim2.fromScale(0.5, 0.5)
	main.Size = IS_MOBILE and UDim2.fromScale(0.94, 0.86) or UDim2.fromOffset(760, 500)
	main.ClipsDescendants = true
	corner(main, 24)
	stroke(main, Color3.new(1, 1, 1), 1.5, 0.82)
	main.Parent = gui

	-- Gradient wash over window
	local wash = Instance.new("Frame")
	wash.BackgroundColor3 = Color3.new(1, 1, 1)
	wash.BackgroundTransparency = 0.9
	wash.Size = UDim2.fromScale(1, 1)
	gradient(wash, theme.C1, theme.C2, 120, 0.85)
	corner(wash, 24)
	wash.Parent = main

	-- Thin accent line at top
	local accent = Instance.new("Frame")
	accent.Size = UDim2.new(1, 0, 0, 2)
	accent.BackgroundColor3 = Color3.new(1, 1, 1)
	gradient(accent, theme.C1, theme.C2, 0)
	accent.Parent = main

	--// Top bar (draggable)
	local topBar = Instance.new("Frame")
	topBar.Name = "TopBar"
	topBar.BackgroundTransparency = 1
	topBar.Size = UDim2.new(1, 0, 0, 48)
	topBar.Parent = main

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Font = FONT_B
	title.TextSize = IS_MOBILE and 16 or 18
	title.TextColor3 = Color3.new(1, 1, 1)
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Text = "  " .. titleText
	title.Size = UDim2.new(1, -60, 1, 0)
	title.Position = UDim2.fromOffset(SIDE_W + 6, 0)
	title.Parent = topBar

	local subtitle = Instance.new("TextLabel")
	subtitle.BackgroundTransparency = 1
	subtitle.Font = FONT
	subtitle.TextSize = 11
	subtitle.TextColor3 = Color3.fromHex("#9CA3AF")
	subtitle.TextXAlignment = Enum.TextXAlignment.Left
	subtitle.Text = "   " .. subText
	subtitle.Size = UDim2.new(1, -60, 0, 14)
	subtitle.Position = UDim2.fromOffset(SIDE_W + 6, 26)
	subtitle.Parent = topBar

	-- Close button (top-right)
	local closeBtn = Instance.new("TextButton")
	closeBtn.Name = "CloseBtn"
	closeBtn.BackgroundColor3 = Color3.fromHex("#EF4444")
	closeBtn.BackgroundTransparency = 0.3
	closeBtn.Text = "✕"
	closeBtn.Font = FONT_B
	closeBtn.TextSize = 14
	closeBtn.TextColor3 = Color3.new(1, 1, 1)
	closeBtn.Size = UDim2.fromOffset(28, 28)
	closeBtn.Position = UDim2.new(1, -38, 0.5, -14)
	corner(closeBtn, 8)
	stroke(closeBtn, Color3.new(1,1,1), 1, 0.7)
	closeBtn.Parent = topBar
	closeBtn.Activated:Connect(function()
		tween(main, SMOOTH, { Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1 })
		task.wait(0.35)
		main.Visible = false
	end)

	--// Drag logic (mouse + touch)
	local dragging, dragStart, startPos = false, nil, nil
	topBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = main.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	--// Sidebar
	local sidebar = Instance.new("Frame")
	sidebar.Name = "Sidebar"
	sidebar.BackgroundColor3 = Color3.fromHex("#0A0618")
	sidebar.BackgroundTransparency = 0.35
	sidebar.Position = UDim2.fromOffset(0, 48)
	sidebar.Size = UDim2.new(0, SIDE_W, 1, -48)
	stroke(sidebar, Color3.new(1,1,1), 1, 0.9)
	sidebar.Parent = main

	local sideList = Instance.new("UIListLayout")
	sideList.Padding = UDim.new(0, 6)
	sideList.SortOrder = Enum.SortOrder.LayoutOrder
	sideList.Parent = sidebar

	local sidePad = Instance.new("UIPadding")
	sidePad.PaddingTop = UDim.new(0, 10)
	sidePad.PaddingLeft = UDim.new(0, 8)
	sidePad.PaddingRight = UDim.new(0, 8)
	sidePad.Parent = sidebar

	--// Content area
	local content = Instance.new("Frame")
	content.Name = "Content"
	content.BackgroundTransparency = 1
	content.Position = UDim2.fromOffset(SIDE_W, 48)
	content.Size = UDim2.new(1, -SIDE_W, 1, -48)
	content.Parent = main

	local contentPad = Instance.new("UIPadding")
	contentPad.PaddingTop = UDim.new(0, PAD)
	contentPad.PaddingBottom = UDim.new(0, PAD)
	contentPad.PaddingLeft = UDim.new(0, PAD)
	contentPad.PaddingRight = UDim.new(0, PAD)
	contentPad.Parent = content

	local pages = {}
	local sideItems = {}
	local selectedTab = nil

	local Window = {}
	Window.Main = main
	Window.Gui = gui
	Window.Theme = theme

	--================================================================================
	--// Tab (page) + sidebar item
	--================================================================================
	function Window:AddTab(icon, label)
		-- Page
		local page = Instance.new("ScrollingFrame")
		page.Name = label .. "Page"
		page.BackgroundTransparency = 1
		page.BorderSizePixel = 0
		page.ScrollBarThickness = 3
		page.ScrollBarImageColor3 = theme.Glow
		page.ScrollBarImageTransparency = 0.5
		page.CanvasSize = UDim2.new(0, 0, 0, 0)
		page.AutomaticCanvasSize = Enum.AutomaticSize.Y
		page.Size = UDim2.fromScale(1, 1)
		page.Visible = false
		page.Parent = content

		local list = Instance.new("UIListLayout")
		list.Padding = UDim.new(0, ROW_GAP)
		list.SortOrder = Enum.SortOrder.LayoutOrder
		list.HorizontalAlignment = Enum.HorizontalAlignment.Center
		list.Parent = page

		-- Sidebar button
		local item = Instance.new("TextButton")
		item.Name = label .. "Item"
		item.BackgroundColor3 = Color3.new(1, 1, 1)
		item.BackgroundTransparency = 1
		item.Text = ""
		item.Size = UDim2.new(1, 0, 0, IS_MOBILE and 48 or 40)
		item.AutoButtonColor = false
		corner(item, 12)
		item.Parent = sidebar

		local itemScale = Instance.new("UIScale")
		itemScale.Parent = item

		local iconLbl = Instance.new("TextLabel")
		iconLbl.BackgroundTransparency = 1
		iconLbl.Font = FONT_B
		iconLbl.TextSize = IS_MOBILE and 20 or 18
		iconLbl.Text = icon
		iconLbl.TextColor3 = Color3.fromHex("#9CA3AF")
		iconLbl.Size = UDim2.fromOffset(IS_MOBILE and 48 or 32, 1, 0)
		iconLbl.Position = UDim2.fromOffset(0, 0)
		iconLbl.Parent = item

		local labelLbl = Instance.new("TextLabel")
		labelLbl.BackgroundTransparency = 1
		labelLbl.Font = FONT
		labelLbl.TextSize = 13
		labelLbl.Text = IS_MOBILE and "" or label
		labelLbl.TextColor3 = Color3.fromHex("#D1D5DB")
		labelLbl.TextXAlignment = Enum.TextXAlignment.Left
		labelLbl.Position = UDim2.fromOffset(36, 0)
		labelLbl.Size = UDim2.new(1, -40, 1, 0)
		labelLbl.Parent = item

		-- Selected accent bar (left)
		local accentBar = Instance.new("Frame")
		accentBar.BackgroundColor3 = Color3.new(1,1,1)
		gradient(accentBar, theme.C1, theme.C2, 90)
		accentBar.Size = UDim2.new(0, 3, 0.6, 0)
		accentBar.Position = UDim2.fromScale(0, 0.2)
		accentBar.BackgroundTransparency = 1
		corner(accentBar, 2)
		accentBar.Parent = item

		local function select()
			if selectedTab then
				selectedTab.Page.Visible = false
				tween(selectedTab.Item, QUICK, { BackgroundTransparency = 1 })
				selectedTab.IconLbl.TextColor3 = Color3.fromHex("#9CA3AF")
				selectedTab.LabelLbl.TextColor3 = Color3.fromHex("#D1D5DB")
				tween(selectedTab.AccentBar, QUICK, { BackgroundTransparency = 1 })
			end
			selectedTab = { Page = page, Item = item, IconLbl = iconLbl, LabelLbl = labelLbl, AccentBar = accentBar }
			page.Visible = true
			tween(item, QUICK, { BackgroundTransparency = 0.82 })
			iconLbl.TextColor3 = theme.C1:Lerp(theme.C2, 0.5)
			labelLbl.TextColor3 = Color3.new(1, 1, 1)
			tween(accentBar, QUICK, { BackgroundTransparency = 0 })
			tween(itemScale, SPRING, { Scale = 1.03 })
			task.wait(0.15)
			tween(itemScale, QUICK, { Scale = 1 })
		end

		item.Activated:Connect(select)
		if not IS_MOBILE then
			item.MouseEnter:Connect(function() tween(itemScale, QUICK, { Scale = 1.05 }) end)
			item.MouseLeave:Connect(function() tween(itemScale, QUICK, { Scale = 1 }) end)
		end

		if #pages == 0 then task.defer(select) end
		table.insert(pages, page)

		--================================================================================
		--// Tab component API
		--================================================================================
		local Tab = {}
		Tab.Page = page

		-- Generic button builder for 3 main styles
		local function buildButton(text, style, callback, height)
			height = height or BTN_H
			local s = slot(page, height + 14) -- extra room for glow
			local padInner = Instance.new("UIPadding")
			padInner.PaddingTop = UDim.new(0, 7); padInner.PaddingBottom = UDim.new(0, 7)
			padInner.Parent = s

			local glowLayers = addGlow(s, theme.Glow, 14, 0.9)
			local btn = Instance.new("TextButton")
			btn.Text = text
			btn.Font = FONT_B
			btn.TextSize = IS_MOBILE and 15 or 14
			btn.TextColor3 = Color3.new(1, 1, 1)
			btn.AutoButtonColor = false
			btn.Size = UDim2.new(1, 0, 1, 0)
			btn.ZIndex = 2
			btn.Parent = s
			corner(btn, 14)

			local sc = Instance.new("UIScale"); sc.Parent = btn

			if style == "Primary" then
				btn.BackgroundColor3 = Color3.new(1,1,1)
				gradient(btn, theme.C1, theme.C2, 90)
				stroke(btn, Color3.new(1,1,1), 1, 0.5)
			elseif style == "Outline" then
				btn.BackgroundTransparency = 0.85
				btn.BackgroundColor3 = Color3.fromHex("#1A1030")
				local st = stroke(btn, Color3.new(1,1,1), 1.5, 0.4)
				gradient(st, theme.C1, theme.C2, 0) -- gradient stroke via UIGradient child of UIStroke
			else -- Glass
				btn.BackgroundColor3 = Color3.fromHex("#FFFFFF")
				btn.BackgroundTransparency = 0.88
				stroke(btn, Color3.new(1,1,1), 1, 0.75)
			end

			bindFeedback(btn, sc, glowLayers)
			btn.Activated:Connect(function()
				if callback then callback() end
			end)
			return btn
		end

		-- 1) Primary button
		function Tab:AddButton(text, callback) return buildButton(text, "Primary", callback) end
		-- 2) Outline button
		function Tab:AddOutlineButton(text, callback) return buildButton(text, "Outline", callback) end
		-- 3) Glass button
		function Tab:AddGlassButton(text, callback) return buildButton(text, "Glass", callback) end

		-- 4) Tab / segmented pill buttons
		function Tab:AddSegmented(options, defaultIndex, callback)
			defaultIndex = defaultIndex or 1
			local s = slot(page, BTN_H + 14)
			local padInner = Instance.new("UIPadding")
			padInner.PaddingTop = UDim.new(0, 7); padInner.PaddingBottom = UDim.new(0, 7)
			padInner.Parent = s

			local holder = Instance.new("Frame")
			holder.BackgroundTransparency = 1
			holder.Size = UDim2.new(1, 0, 1, 0)
			holder.ZIndex = 2
			holder.Parent = s
			local hl = Instance.new("UIListLayout")
			hl.FillDirection = Enum.FillDirection.Horizontal
			hl.HorizontalAlignment = Enum.HorizontalAlignment.Center
			hl.Padding = UDim.new(0, 6)
			hl.Parent = holder

			local pills = {}
			local selectedPill = nil

			for i, opt in ipairs(options) do
				local pill = Instance.new("TextButton")
				pill.Text = opt
				pill.Font = FONT_B
				pill.TextSize = 13
				pill.TextColor3 = Color3.fromHex("#D1D5DB")
				pill.AutoButtonColor = false
				pill.BackgroundColor3 = Color3.fromHex("#FFFFFF")
				pill.BackgroundTransparency = 0.9
				pill.Size = UDim2.new(1 / #options, -6, 1, 0)
				corner(pill, 16)
				stroke(pill, Color3.new(1,1,1), 1, 0.8)
				pill.Parent = holder
				local psc = Instance.new("UIScale"); psc.Parent = pill
				if not IS_MOBILE then
					pill.MouseEnter:Connect(function() tween(psc, QUICK, {Scale=1.05}) end)
					pill.MouseLeave:Connect(function() tween(psc, QUICK, {Scale=1}) end)
				end

				local function selectPill()
					if selectedPill then
						selectedPill.BackgroundTransparency = 0.9
						selectedPill.TextColor3 = Color3.fromHex("#D1D5DB")
						for _, child in ipairs(selectedPill:GetChildren()) do
							if child:IsA("UIGradient") then child:Destroy() end
						end
					end
					selectedPill = pill
					pill.BackgroundTransparency = 0
					pill.BackgroundColor3 = Color3.new(1,1,1)
					gradient(pill, theme.C1, theme.C2, 90)
					pill.TextColor3 = Color3.new(1,1,1)
					tween(psc, SPRING, {Scale = 1.06})
					task.wait(0.12); tween(psc, QUICK, {Scale=1})
					if callback then callback(opt, i) end
				end

				pill.Activated:Connect(selectPill)
				pills[i] = pill
				if i == defaultIndex then task.defer(selectPill) end
			end
			return pills
		end

		-- 5) Icon buttons (row of circular gradient icon buttons)
		function Tab:AddIconButtons(icons)
			local s = slot(page, 56)
			local padInner = Instance.new("UIPadding")
			padInner.PaddingTop = UDim.new(0, 6); padInner.PaddingBottom = UDim.new(0, 6)
			padInner.Parent = s
			local holder = Instance.new("Frame")
			holder.BackgroundTransparency = 1
			holder.Size = UDim2.new(1, 0, 1, 0)
			holder.ZIndex = 2
			holder.Parent = s
			local hl = Instance.new("UIListLayout")
			hl.FillDirection = Enum.FillDirection.Horizontal
			hl.HorizontalAlignment = Enum.HorizontalAlignment.Center
			hl.Padding = UDim.new(0, 10)
			hl.Parent = holder

			local themeKeys = { "PurpleBlue", "PinkGold", "MintCyan", "BlueLavender", "RoseLavender", "Gold" }
			local btns = {}
			for i, entry in ipairs(icons) do
				local ic = type(entry) == "table" and entry.Icon or entry
				local cb = type(entry) == "table" and entry.Callback or nil
				local th = GlassUI.Themes[themeKeys[((i-1) % #themeKeys) + 1]]

				local wrap = Instance.new("Frame")
				wrap.BackgroundTransparency = 1
				wrap.Size = UDim2.fromOffset(44, 44)
				wrap.Parent = holder
				local glowLayers = addGlow(wrap, th.Glow, 22, 0.88)

				local b = Instance.new("TextButton")
				b.Text = ic
				b.Font = FONT_B
				b.TextSize = 18
				b.TextColor3 = Color3.new(1,1,1)
				b.AutoButtonColor = false
				b.BackgroundColor3 = Color3.new(1,1,1)
				b.Size = UDim2.fromScale(1,1)
				b.ZIndex = 2
				corner(b, 22)
				gradient(b, th.C1, th.C2, 90)
				stroke(b, Color3.new(1,1,1), 1, 0.6)
				b.Parent = wrap
				local sc = Instance.new("UIScale"); sc.Parent = b
				bindFeedback(b, sc, glowLayers)
				b.Activated:Connect(function() if cb then cb() end end)
				btns[i] = b
			end
			return btns
		end

		-- 6) Floating action button (gold, bottom-right of screen, big shadow)
		function Window:AddFloatingButton(icon, callback)
			local th = GlassUI.Themes.Gold
			local wrap = Instance.new("Frame")
			wrap.BackgroundTransparency = 1
			wrap.Size = UDim2.fromOffset(64, 64)
			wrap.AnchorPoint = Vector2.new(1, 1)
			wrap.Position = UDim2.new(1, -24, 1, -24)
			wrap.Parent = gui
			local glowLayers = addGlow(wrap, th.Glow, 32, 0.7) -- big glow

			local fab = Instance.new("TextButton")
			fab.Text = icon or "+"
			fab.Font = FONT_B
			fab.TextSize = 26
			fab.TextColor3 = Color3.new(1,1,1)
			fab.AutoButtonColor = false
			fab.BackgroundColor3 = Color3.new(1,1,1)
			fab.Size = UDim2.fromScale(1,1)
			fab.ZIndex = 2
			corner(fab, 32)
			gradient(fab, th.C1, th.C2, 135)
			stroke(fab, Color3.new(1,1,1), 1.5, 0.5)
			fab.Parent = wrap
			local sc = Instance.new("UIScale"); sc.Parent = fab

			bindFeedback(fab, sc, glowLayers)
			fab.Activated:Connect(function()
				if callback then callback()
				else
					-- default: toggle window visibility
					main.Visible = not main.Visible
					if main.Visible then
						main.Size = UDim2.fromOffset(0,0)
						tween(main, SMOOTH, { Size = IS_MOBILE and UDim2.fromScale(0.94,0.86) or UDim2.fromOffset(760,500), BackgroundTransparency = 0.22 })
					end
				end
			end)
			return fab
		end

		-- 7) Toggle switch
		function Tab:AddToggle(text, default, callback)
			default = default or false
			local s = slot(page, BTN_H + 14)
			local padInner = Instance.new("UIPadding")
			padInner.PaddingTop = UDim.new(0, 7); padInner.PaddingBottom = UDim.new(0, 7)
			padInner.Parent = s

			local glowLayers = addGlow(s, theme.Glow, 14, 0.92)

			local row = Instance.new("TextButton")
			row.Text = ""
			row.AutoButtonColor = false
			row.BackgroundColor3 = Color3.fromHex("#FFFFFF")
			row.BackgroundTransparency = 0.9
			row.Size = UDim2.new(1, 0, 1, 0)
			row.ZIndex = 2
			corner(row, 14)
			stroke(row, Color3.new(1,1,1), 1, 0.8)
			row.Parent = s

			local lbl = Instance.new("TextLabel")
			lbl.BackgroundTransparency = 1
			lbl.Font = FONT
			lbl.TextSize = 14
			lbl.Text = text
			lbl.TextColor3 = Color3.fromHex("#E5E7EB")
			lbl.TextXAlignment = Enum.TextXAlignment.Left
			lbl.Position = UDim2.fromOffset(14, 0)
			lbl.Size = UDim2.new(1, -80, 1, 0)
			lbl.Parent = row

			local switch = Instance.new("Frame")
			switch.BackgroundColor3 = Color3.fromHex("#374151")
			switch.BackgroundTransparency = 0.2
			switch.AnchorPoint = Vector2.new(1, 0.5)
			switch.Position = UDim2.new(1, -14, 0.5, 0)
			switch.Size = UDim2.fromOffset(48, 24)
			corner(switch, 12)
			stroke(switch, Color3.new(1,1,1), 1, 0.7)
			switch.Parent = row

			local knob = Instance.new("Frame")
			knob.BackgroundColor3 = Color3.new(1,1,1)
			knob.AnchorPoint = Vector2.new(0, 0.5)
			knob.Position = UDim2.new(0, 3, 0.5, 0)
			knob.Size = UDim2.fromOffset(18, 18)
			corner(knob, 9)
			knob.Parent = switch

			local state = default
			local function apply(animate)
				if state then
					switch.BackgroundColor3 = Color3.new(1,1,1)
					gradient(switch, theme.C1, theme.C2, 90)
					switch.BackgroundTransparency = 0
					tween(knob, SMOOTH, { Position = UDim2.new(1, -21, 0.5, 0) })
					setGlow(glowLayers, 0.7)
				else
					for _, c in ipairs(switch:GetChildren()) do if c:IsA("UIGradient") then c:Destroy() end end
					switch.BackgroundColor3 = Color3.fromHex("#374151")
					switch.BackgroundTransparency = 0.2
					tween(knob, SMOOTH, { Position = UDim2.new(0, 3, 0.5, 0) })
					setGlow(glowLayers, 0.92)
				end
			end
			apply(false)

			local sc = Instance.new("UIScale"); sc.Parent = row
			bindFeedback(row, sc, glowLayers)
			row.Activated:Connect(function()
				state = not state
				apply(true)
				if callback then callback(state) end
			end)
			return { Set = function(v) state = v; apply(true) end, Get = function() return state end }
		end

		-- Slider / progress bar (rainbow fill)
		function Tab:AddSlider(text, min, max, default, callback)
			min = min or 0; max = max or 100; default = default or min
			local s = slot(page, 58)
			local padInner = Instance.new("UIPadding")
			padInner.PaddingTop = UDim.new(0, 6); padInner.PaddingBottom = UDim.new(0, 6)
			padInner.Parent = s

			local row = Instance.new("Frame")
			row.BackgroundTransparency = 1
			row.Size = UDim2.new(1, 0, 1, 0)
			row.ZIndex = 2
			row.Parent = s

			local topLbl = Instance.new("TextLabel")
			topLbl.BackgroundTransparency = 1
			topLbl.Font = FONT
			topLbl.TextSize = 13
			topLbl.Text = text
			topLbl.TextColor3 = Color3.fromHex("#E5E7EB")
			topLbl.TextXAlignment = Enum.TextXAlignment.Left
			topLbl.Size = UDim2.new(1, -50, 0, 18)
			topLbl.Parent = row

			local valLbl = Instance.new("TextLabel")
			valLbl.BackgroundTransparency = 1
			valLbl.Font = FONT_B
			valLbl.TextSize = 13
			valLbl.TextColor3 = theme.Glow
			valLbl.TextXAlignment = Enum.TextXAlignment.Right
			valLbl.AnchorPoint = Vector2.new(1, 0)
			valLbl.Position = UDim2.new(1, 0, 0, 0)
			valLbl.Size = UDim2.fromOffset(50, 18)
			valLbl.Text = tostring(math.floor(default))
			valLbl.Parent = row

			local track = Instance.new("TextButton")
			track.Text = ""
			track.AutoButtonColor = false
			track.BackgroundColor3 = Color3.fromHex("#1F2937")
			track.BackgroundTransparency = 0.3
			track.Position = UDim2.fromOffset(0, 26)
			track.Size = UDim2.new(1, 0, 0, 10)
			corner(track, 5)
			stroke(track, Color3.new(1,1,1), 1, 0.85)
			track.Parent = row

			local fill = Instance.new("Frame")
			fill.BackgroundColor3 = Color3.new(1,1,1)
			fill.Size = UDim2.new(0, 0, 1, 0)
			corner(fill, 5)
			fill.ClipsDescendants = true
			fill.Parent = track
			local rg = Instance.new("UIGradient")
			rg.Color = RAINBOW
			rg.Parent = fill
			-- animate rainbow
			RunService.RenderStepped:Connect(function()
				rg.Offset = Vector2.new((tick() * 0.25) % 1, 0)
			end)

			local knob = Instance.new("Frame")
			knob.BackgroundColor3 = Color3.new(1,1,1)
			knob.AnchorPoint = Vector2.new(0.5, 0.5)
			knob.Size = UDim2.fromOffset(18, 18)
			corner(knob, 9)
			stroke(knob, theme.Glow, 2, 0.2)
			knob.Parent = track

			local value = default
			local function setValue(v)
				value = math.clamp(v, min, max)
				local pct = (value - min) / (max - min)
				tween(fill, QUICK, { Size = UDim2.new(pct, 0, 1, 0) })
				tween(knob, QUICK, { Position = UDim2.new(pct, 0, 0.5, 0) })
				valLbl.Text = tostring(math.floor(value))
				if callback then callback(value) end
			end
			setValue(default)

			local dragging = false
			local function updateFromInput(input)
				local rel = input.Position.X - track.AbsolutePosition.X
				local pct = math.clamp(rel / track.AbsoluteSize.X, 0, 1)
				setValue(min + pct * (max - min))
			end
			track.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					updateFromInput(input)
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
					updateFromInput(input)
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
					dragging = false
				end
			end)

			return { Set = setValue, Get = function() return value end }
		end

		-- Card (rounded 16-24, light glow border) — returns container you can add labels to
		function Tab:AddCard(titleText, height)
			height = height or 90
			local s = slot(page, height)
			local glowLayers = addGlow(s, theme.Glow, 20, 0.93)
			local card = Instance.new("Frame")
			card.BackgroundColor3 = Color3.fromHex("#FFFFFF")
			card.BackgroundTransparency = 0.9
			card.Size = UDim2.new(1, 0, 1, 0)
			card.ZIndex = 2
			corner(card, 18)
			stroke(card, Color3.new(1,1,1), 1, 0.78)
			card.Parent = s
			local cp = Instance.new("UIPadding")
			cp.PaddingTop = UDim.new(0,10); cp.PaddingBottom = UDim.new(0,10)
			cp.PaddingLeft = UDim.new(0,14); cp.PaddingRight = UDim.new(0,14)
			card.Parent = s

			local titleLbl = Instance.new("TextLabel")
			titleLbl.BackgroundTransparency = 1
			titleLbl.Font = FONT_B
			titleLbl.TextSize = 14
			titleLbl.Text = titleText or ""
			titleLbl.TextColor3 = Color3.new(1,1,1)
			titleLbl.TextXAlignment = Enum.TextXAlignment.Left
			titleLbl.Size = UDim2.new(1, 0, 0, 20)
			titleLbl.Parent = card

			local body = Instance.new("Frame")
			body.BackgroundTransparency = 1
			body.Position = UDim2.fromOffset(0, 26)
			body.Size = UDim2.new(1, 0, 1, -26)
			body.Parent = card
			local bl = Instance.new("UIListLayout")
			bl.Padding = UDim.new(0, 4)
			bl.Parent = body

			local Card = {}
			function Card:AddLabel(text, size)
				local l = Instance.new("TextLabel")
				l.BackgroundTransparency = 1
				l.Font = FONT
				l.TextSize = size or 12
				l.Text = text
				l.TextColor3 = Color3.fromHex("#D1D5DB")
				l.TextXAlignment = Enum.TextXAlignment.Left
				l.TextWrapped = true
				l.AutomaticSize = Enum.AutomaticSize.Y
				l.Size = UDim2.new(1, 0, 0, 16)
				l.Parent = body
				return l
			end
			return Card
		end

		function Tab:AddLabel(text, size)
			local s = slot(page, (size or 14) + 10)
			local l = Instance.new("TextLabel")
			l.BackgroundTransparency = 1
			l.Font = FONT
			l.TextSize = size or 14
			l.Text = text
			l.TextColor3 = Color3.fromHex("#E5E7EB")
			l.TextXAlignment = Enum.TextXAlignment.Left
			l.TextWrapped = true
			l.Size = UDim2.new(1, 0, 1, 0)
			l.Parent = s
			return l
		end

		function Tab:AddDivider()
			local s = slot(page, 12)
			local d = Instance.new("Frame")
			d.BackgroundColor3 = Color3.new(1,1,1)
			d.BackgroundTransparency = 0.9
			d.Size = UDim2.new(1, -20, 0, 1)
			d.Position = UDim2.fromScale(0.5, 0.5)
			d.AnchorPoint = Vector2.new(0.5, 0.5)
			d.Parent = s
			return d
		end

		return Tab
	end

	return Window
end

return GlassUI
