			Arrow.Size = UDim2.new(0, 14, 1, 0)
			Arrow.Font = Enum.Font.GothamBold
			Arrow.Text = "v"
			Arrow.TextColor3 = Theme.Muted
			Arrow.TextSize = 10
			Arrow.ZIndex = 7

			-- Dropdown container (overlay อยู่ใน Library เพื่อไม่ให้ถูก ClipsDescendants ตัด)
			local DropFrame = Instance.new("Frame")
			DropFrame.Name = "DropFrame"
			DropFrame.Parent = Library
			DropFrame.BackgroundColor3 = Theme.Field
			DropFrame.BorderSizePixel = 0
			DropFrame.Size = UDim2.new(0, 96, 0, 0)
			DropFrame.Visible = false
			DropFrame.ZIndex = 20
			Corner(DropFrame, 4)
			Stroke(DropFrame, Theme.Border, 1)
			local DropLayout = ListLayout(DropFrame, 2, Enum.SortOrder.LayoutOrder)
			Padding(DropFrame, 3, 3, 3, 3)

			local open = false
			local function UpdateDisplay()
				local keys = {}
				for k in pairs(selected) do table.insert(keys, k) end
				if #keys == 0 then
					HeaderText.Text = "Select..."
				elseif multi then
					HeaderText.Text = #keys .. " selected"
				else
					HeaderText.Text = keys[1]
				end
			end

			local function Build()
				for _, child in ipairs(DropFrame:GetChildren()) do
					if child:IsA("TextButton") then child:Destroy() end
				end
				local order = 0
				for _, item in ipairs(list) do
					local name = type(item) == "table" and (item.Title or item.Name or item.Value) or tostring(item)
					local val = type(item) == "table" and (item.Value or name) or name
					order = order + 1
					local Opt = Instance.new("TextButton")
					Opt.Parent = DropFrame
					Opt.BackgroundColor3 = selected[val] and Theme.Accent or Theme.Field
					Opt.BackgroundTransparency = selected[val] and 0 or 1
					Opt.Size = UDim2.new(1, 0, 0, 22)
					Opt.AutoButtonColor = false
					Opt.Font = Enum.Font.Gotham
					Opt.Text = "  " .. name
					Opt.TextColor3 = selected[val] and Theme.Text or Theme.SubText
					Opt.TextSize = 12
					Opt.TextXAlignment = Enum.TextXAlignment.Left
					Opt.LayoutOrder = order
					Opt.ZIndex = 21
					Corner(Opt, 3)
					Opt.MouseEnter:Connect(function()
						if not selected[val] then Opt.BackgroundTransparency = 0; Tween(Opt, {BackgroundColor3 = Theme.RowHover}, .1) end
					end)
					Opt.MouseLeave:Connect(function()
						if not selected[val] then Tween(Opt, {BackgroundTransparency = 1}, .15) end
					end)
					Opt.MouseButton1Click:Connect(function()
						if Row:GetAttribute("Locked") then return end
						if multi then
							selected[val] = not selected[val] or nil
						else
							selected = {[val] = true}
						end
						Build()
						UpdateDisplay()
						local out = multi and {} or val
						if multi then for k in pairs(selected) do table.insert(out, k) end end
						task.spawn(function() cb(out) end)
						if not multi then
							task.delay(.1, function()
								open = false
								DropFrame.Visible = false
								Tween(Arrow, {Rotation = 0}, .15)
							end)
						end
					end)
				end
				-- ปรับขนาด DropFrame
				local h = math.min(#list * 24 + 10, 150)
				Tween(DropFrame, {Size = UDim2.new(0, 96, 0, h)}, .2)
			end

			local function SetOpen(state)
				if Row:GetAttribute("Locked") then return end
				open = state
				if open then
					-- จัดตำแหน่ง DropFrame ใต้ Header (absolute เพราะอยู่ใน Library)
					local pos = Header.AbsolutePosition + Vector2.new(Header.AbsoluteSize.X - 96, Header.AbsoluteSize.Y + 4)
					DropFrame.Position = UDim2.new(0, pos.X, 0, pos.Y)
					DropFrame.Visible = true
					Build()
					Tween(Arrow, {Rotation = 180}, .15)
				else
					Tween(DropFrame, {Size = UDim2.new(0, 96, 0, 0)}, .2)
					Tween(Arrow, {Rotation = 0}, .15)
					task.delay(.2, function() DropFrame.Visible = false end)
				end
			end

			Header.MouseButton1Click:Connect(function() SetOpen(not open) end)
			UpdateDisplay()

			local obj = {}
			function obj:Get()
				if multi then local out = {}; for k in pairs(selected) do table.insert(out, k) end; return out end
				return next(selected)
			end
			function obj:Set(v, silent)
				if multi then selected = {}; if type(v) == "table" then for _, x in ipairs(v) do selected[x] = true end end
				else selected = {[tostring(v)] = true} end
				UpdateDisplay(); Build()
				if not silent then task.spawn(function() cb(obj:Get()) end) end
			end
			function obj:Select(v, silent) obj:Set(v, silent) end
			function obj:Refresh(newList) list = newList or {}; if open then Build() end end
			function obj:Open() SetOpen(true) end
			function obj:Close() SetOpen(false) end
			function obj:Lock() Row:SetAttribute("Locked", true); SetLockedVisual(T, D, true) end
			function obj:Unlock() Row:SetAttribute("Locked", false); SetLockedVisual(T, D, false) end
			function obj:Destroy() Row:Destroy(); DropFrame:Destroy() end
			return RegisterFlag(opts.Flag, obj)
		end

