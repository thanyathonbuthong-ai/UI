function WindowTable:Notify(title, text, duration, ntype)
	if type(title) == "table" then
		local o = title
		title = o.Title
		text = o.Content or o.Desc
		duration = o.Duration
		ntype = o.Type
	end
	title = tostring(title or "Notification")
	text = tostring(text or "")
	duration = tonumber(duration) or 4
	local accent = NotifyColors[ntype] or NotifyColors.Info
	local TextService = game:GetService("TextService")

	if not (NotifyGui and NotifyGui.Parent) then
		NotifyGui = Instance.new("ScreenGui")
		NotifyGui.Name = "LibraryNotify"
		NotifyGui.Parent = game.CoreGui
		NotifyGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		NotifyGui.ResetOnSpawn = false
		NotifyGui.IgnoreGuiInset = false
		NotifyGui.DisplayOrder = 10

		NotifyHolder = Instance.new("Frame")
		NotifyHolder.Name = "NotifyHolder"
		NotifyHolder.Parent = NotifyGui
		NotifyHolder.AnchorPoint = Vector2.new(1, 1)
		NotifyHolder.BackgroundTransparency = 1
		NotifyHolder.BorderSizePixel = 0
		NotifyHolder.Position = UDim2.new(1, -12, 1, -12)
		NotifyHolder.Size = UDim2.new(0, NotifyWidth, 1, -24)

		local HolderList = Instance.new("UIListLayout")
		HolderList.Parent = NotifyHolder
		HolderList.SortOrder = Enum.SortOrder.LayoutOrder
		HolderList.HorizontalAlignment = Enum.HorizontalAlignment.Right
		HolderList.VerticalAlignment = Enum.VerticalAlignment.Bottom
		HolderList.Padding = UDim.new(0, 8)
	end

	-- คำนวณความสูงตามข้อความ
	local textH = 0
	if text ~= "" then
		textH = TextService:GetTextSize(text, 13, Enum.Font.Gotham, Vector2.new(NotifyWidth - 48, 10000)).Y
	end
	local height = math.max(46, 28 + textH + 14)

