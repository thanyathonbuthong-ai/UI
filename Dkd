			local function UpdateColor()
				currentColor = HSBToColor3(h, s, v)
				ColorBtn.BackgroundColor3 = currentColor
				SV.BackgroundColor3 = HSBToColor3(h, 1, 1)
				SVCursor.Position = UDim2.new(s, 0, 1 - v, 0)
				HueCursor.Position = UDim2.new(0.5, 0, h, 0)
				Rbox.Text = tostring(math.floor(currentColor.R * 255))
				Gbox.Text = tostring(math.floor(currentColor.G * 255))
				Bbox.Text = tostring(math.floor(currentColor.B * 255))
				HEXbox.Text = string.format("%02X%02X%02X", math.floor(currentColor.R*255), math.floor(currentColor.G*255), math.floor(currentColor.B*255))
				task.spawn(function() cb(currentColor) end)
			end

			local function BindDrag(gui, onMove)
				local dragging = false
				gui.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then
						dragging = true
						onMove(input)
					end
				end)
				UserInputService.InputChanged:Connect(function(input)
					if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
						onMove(input)
					end
				end)
				UserInputService.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
				end)
			end

			BindDrag(SV, function(input)
				local rel = Vector2.new(
					math.clamp((input.Position.X - SV.AbsolutePosition.X) / SV.AbsoluteSize.X, 0, 1),
					math.clamp((input.Position.Y - SV.AbsolutePosition.Y) / SV.AbsoluteSize.Y, 0, 1)
				)
				s = rel.X; v = 1 - rel.Y
				UpdateColor()
			end)

			BindDrag(Hue, function(input)
				h = math.clamp((input.Position.Y - Hue.AbsolutePosition.Y) / Hue.AbsoluteSize.Y, 0, 1)
				UpdateColor()
			end)

			local function FromRGB()
				local r = tonumber(Rbox.Text) or 0
				local g = tonumber(Gbox.Text) or 0
				local b = tonumber(Bbox.Text) or 0
				currentColor = Color3.fromRGB(math.clamp(r,0,255), math.clamp(g,0,255), math.clamp(b,0,255))
				h, s, v = Color3ToHSB(currentColor)
				UpdateColor()
			end
			Rbox.FocusLost:Connect(FromRGB); Gbox.FocusLost:Connect(FromRGB); Bbox.FocusLost:Connect(FromRGB)
			HEXbox.FocusLost:Connect(function()
				local hex = HEXbox.Text:gsub("#", "")
				if #hex == 6 then
					local r = tonumber(hex:sub(1,2), 16) or 0
					local g = tonumber(hex:sub(3,4), 16) or 0
					local b = tonumber(hex:sub(5,6), 16) or 0
					currentColor = Color3.fromRGB(r, g, b)
					h, s, v = Color3ToHSB(currentColor)
					UpdateColor()
				end
			end)

			RainbowToggle.MouseButton1Click:Connect(function()
				rainbow = not rainbow
				RainbowToggle.BackgroundColor3 = rainbow and Theme.Accent or Theme.Field
			end)

			-- Rainbow loop สำหรับ colorpicker นี้
			local rainbowConn
			if rainbow then
				rainbowConn = RunService.Heartbeat:Connect(function()
					if rainbow and open then
						h = WindowTable.RainbowColorValue
						UpdateColor()
					end
				end)
			end

			local function OpenPicker()
				if Row:GetAttribute("Locked") then return end
				open = true
				-- จัดตำแหน่งใกล้ ColorBtn
				local pos = ColorBtn.AbsolutePosition
				Picker.Position = UDim2.new(0, math.clamp(pos.X - 100, 10, workspace.CurrentCamera.ViewportSize.X - 240), 0, math.clamp(pos.Y + 30, 10, workspace.CurrentCamera.ViewportSize.Y - 230))
				Picker.Visible = true
				UpdateColor()
			end
			local function ClosePicker()
				open = false
				Picker.Visible = false
			end

			ColorBtn.MouseButton1Click:Connect(function()
				if open then ClosePicker() else OpenPicker() end
			end)
			DoneBtn.MouseButton1Click:Connect(ClosePicker)

			UpdateColor()

			local obj = {}
			function obj:Get() return currentColor end
			function obj:Set(c, silent)
				currentColor = c
				h, s, v = Color3ToHSB(c)
				UpdateColor()
				if silent then -- ห้าม fire ซ้ำ
				end
			end
			function obj:SetRainbow(state) rainbow = state == true; RainbowToggle.BackgroundColor3 = rainbow and Theme.Accent or Theme.Field end
			function obj:GetRainbow() return rainbow end
			function obj:Lock() Row:SetAttribute("Locked", true); SetLockedVisual(T, D, true) end
			function obj:Unlock() Row:SetAttribute("Locked", false); SetLockedVisual(T, D, false) end
			function obj:Destroy() Row:Destroy(); Picker:Destroy(); if rainbowConn then rainbowConn:Disconnect() end end
			return RegisterFlag(opts.Flag, obj)
		end

		-- ปิด ElementHandler — คืนออกไป
		return ElementHandler
	end -- end Tabs:Tab


