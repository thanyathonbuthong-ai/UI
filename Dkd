		-- --------------------------------------------------------
		--  Helper: parse args (รองรับทั้ง positional เก่า และ opts table แบบ Wind UI)
		-- --------------------------------------------------------
		local function parseArgs(...)
			local args = {...}
			local opts = {}
			if type(args[1]) == "table" then
				opts = args[1]
			else
				opts.Title = args[1]
				if type(args[2]) == "table" then
					for k, v in pairs(args[2]) do opts[k] = v end
				else
					opts.Default = args[2]
				end
				if #args >= 3 then opts.Min = args[2]; opts.Max = args[3] end
				if #args >= 4 then opts.Default = args[4] end
				if #args >= 5 and type(args[5]) == "table" then
					for k, v in pairs(args[5]) do opts[k] = v end
				end
			end
			return opts
		end

