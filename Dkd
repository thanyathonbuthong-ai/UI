			-- ===================== Dropdown (เลือกอันเดียว / เลือกหลายอัน) =====================
			function ElementHandler:Dropdown(a, b, c)
				local opts = type(a) == "table" and a or {Title = a, Values = b, Callback = c}
				local title = opts.Title or "Dropdown"
				local desc = opts.Desc
				local multi = opts.Multi == true
				local allowNone = opts.AllowNone
				if allowNone == nil then
					allowNone = multi
				end
				local cb = opts.Callback or function() end
				local locked = opts.Locked == true
				local open = false
				local items = {}
				local selected = {}
				local MAXH = 150

				local function Normalize(list)
					local out = {}
					for _, v in ipairs(list or {}) do
						if type(v) == "table" then
							if v.Type == "Divider" then
								table.insert(out, {Type = "Divider"})
							else
								table.insert(out, {Title = tostring(v.Title or v.Name or ""), Callback = v.Callback, Locked = v.Locked})
							end
						else
							table.insert(out, {Title = tostring(v)})
						end
					end
					return out
				end
				items = Normalize(opts.Values)

				local Header = MakeRow(Container, "TextButton", desc and 46 or 32)
				Header.Name = "Dropdown"
				HoverRow(Header)
				local T, D = RowTitle(Header, title, desc, 200)
				SetLockedVisual(T, D, locked)

				local Current = Instance.new("TextLabel")
				Current.Name = "CurrentSelection"
				Current.Parent = Header
				Current.AnchorPoint = Vector2.new(1, 0)
				Current.BackgroundTransparency = 1
				Current.Position = UDim2.new(1, -38, 0, desc and 6 or 0)
				Current.Size = UDim2.new(0, 150, 0, desc and 18 or 32)
				Current.Font = Enum.Font.Gotham
				Current.Text = ""
				Current.TextColor3 = Theme.Muted
				Current.TextSize = 13
				Current.TextXAlignment = Enum.TextXAlignment.Right
				Current.TextTruncate = Enum.TextTruncate.AtEnd

				local Arrow = Instance.new("ImageLabel")
				Arrow.Name = "DropToggle"
				Arrow.Parent = Header
				Arrow.AnchorPoint = Vector2.new(1, 0.5)
				Arrow.BackgroundTransparency = 1
				Arrow.Position = UDim2.new(1, -8, 0.5, 0)
				Arrow.Size = UDim2.new(0, 23, 0, 23)
				Arrow.Rotation = 90
				Arrow.Image = "rbxassetid://5844057859"
				Arrow.ImageColor3 = Theme.Text

				local Holder = Instance.new("ScrollingFrame")
				Holder.Name = "DropItemHolder"
				Holder.Parent = Container
				Holder.Active = true
				Holder.BackgroundColor3 = Theme.Field
				Holder.BorderSizePixel = 0
				Holder.Size = UDim2.new(0, 375, 0, 0)
				Holder.Visible = false
				Holder.ClipsDescendants = true
				Holder.ScrollBarThickness = 2
				Holder.ScrollBarImageColor3 = Theme.On
				Holder.AutomaticCanvasSize = Enum.AutomaticSize.Y
				Holder.CanvasSize = UDim2.new(0, 0, 0, 0)

				local HL = Instance.new("UIListLayout")
				HL.Parent = Holder
				HL.SortOrder = Enum.SortOrder.LayoutOrder
				HL.HorizontalAlignment = Enum.HorizontalAlignment.Center

				local function CountSel()
					local n = 0
					for _ in pairs(selected) do
						n = n + 1
					end
					return n
				end

				local function GetValue()
					if multi then
						local out = {}
						for _, it in ipairs(items) do
							if it.Title and selected[it.Title] then
								table.insert(out, it.Title)
							end
						end
						return out
					end
					for _, it in ipairs(items) do
						if it.Title and selected[it.Title] then
							return it.Title
						end
					end
					return nil
				end

				local function ContentHeight()
					local h = 0
					for _, it in ipairs(items) do
						h = h + (it.Type == "Divider" and 9 or 30)
					end
					return math.min(h, MAXH)
				end

				local function UpdateDisplay()
					local v = GetValue()
					local placeholder = opts.Placeholder or ""
					if multi then
						Current.Text = (#v > 0) and table.concat(v, ", ") or placeholder
					else
						Current.Text = v or placeholder
					end
				end

				local function RefreshItems()
					for _, it in ipairs(items) do
						if it.Button then
							local on = selected[it.Title] == true
							Tween(it.Label, {TextColor3 = on and Theme.Text or Theme.SubText}, .2)
							if it.Mark then
								Tween(it.Mark, {BackgroundColor3 = on and Theme.On or Theme.Off}, .2)
							end
							if it.Bar then
								Tween(it.Bar, {BackgroundTransparency = on and 0 or 1}, .2)
							end
						end
					end
				end

				local function Update(fire)
					UpdateDisplay()
					RefreshItems()
					if fire then
						task.spawn(cb, GetValue())
					end
				end

				local SetOpen

				local function Build()
					for _, ch in ipairs(Holder:GetChildren()) do
						if ch:IsA("GuiObject") then
							ch:Destroy()
						end
					end
					for _, it in ipairs(items) do
						it.Button, it.Label, it.Mark, it.Bar = nil, nil, nil, nil
						if it.Type == "Divider" then
							local Wrap = Instance.new("Frame")
							Wrap.Name = "DividerWrap"
							Wrap.Parent = Holder
							Wrap.BackgroundTransparency = 1
							Wrap.BorderSizePixel = 0
							Wrap.Size = UDim2.new(1, 0, 0, 9)
							local Ln = Instance.new("Frame")
							Ln.Parent = Wrap
							Ln.BackgroundColor3 = Theme.Off
							Ln.BorderSizePixel = 0
							Ln.Position = UDim2.new(0, 12, 0, 4)
							Ln.Size = UDim2.new(1, -24, 0, 1)
						else
							local Opt = Instance.new("TextButton")
							Opt.Name = "Option"
							Opt.Parent = Holder
							Opt.BackgroundColor3 = Theme.Field
							Opt.BorderSizePixel = 0
							Opt.Size = UDim2.new(1, 0, 0, 30)
							Opt.AutoButtonColor = false
							Opt.Text = ""

							local Lbl = Instance.new("TextLabel")
							Lbl.Name = "OptionTitle"
							Lbl.Parent = Opt
							Lbl.BackgroundTransparency = 1
							Lbl.Position = UDim2.new(0, 14, 0, 0)
							Lbl.Size = UDim2.new(1, -50, 1, 0)
							Lbl.Font = Enum.Font.Gotham
							Lbl.Text = it.Title
							Lbl.TextColor3 = Theme.SubText
							Lbl.TextSize = 13
							Lbl.TextXAlignment = Enum.TextXAlignment.Left
							Lbl.TextTruncate = Enum.TextTruncate.AtEnd
							if it.Locked then
								Lbl.TextTransparency = 0.5
							end

							if multi then
								local Mark = Instance.new("Frame")
								Mark.Name = "Mark"
								Mark.Parent = Opt
								Mark.AnchorPoint = Vector2.new(1, 0.5)
								Mark.BackgroundColor3 = Theme.Off
								Mark.BorderSizePixel = 0
								Mark.Position = UDim2.new(1, -12, 0.5, 0)
								Mark.Size = UDim2.new(0, 16, 0, 16)
								Corner(Mark, 4)
								it.Mark = Mark
							else
								local Bar = Instance.new("Frame")
								Bar.Name = "SelectedBar"
								Bar.Parent = Opt
								Bar.BackgroundColor3 = Theme.On
								Bar.BackgroundTransparency = 1
								Bar.BorderSizePixel = 0
								Bar.Position = UDim2.new(0, 0, 0, 6)
								Bar.Size = UDim2.new(0, 3, 1, -12)
								Corner(Bar, 2)
								it.Bar = Bar
							end

							Opt.MouseEnter:Connect(function()
								Tween(Opt, {BackgroundColor3 = Theme.RowHover})
							end)
							Opt.MouseLeave:Connect(function()
								Tween(Opt, {BackgroundColor3 = Theme.Field})
							end)

							Opt.MouseButton1Click:Connect(function()
								if it.Locked then
									return
								end
								local was = selected[it.Title] == true
								if multi then
									if was then
										if not allowNone and CountSel() <= 1 then
											return
										end
										selected[it.Title] = nil
									else
										selected[it.Title] = true
									end
								else
									if was then
										if not allowNone then
											SetOpen(false)
											return
										end
										selected = {}
									else
										selected = {[it.Title] = true}
									end
									SetOpen(false)
								end
								Update(true)
								if (not was) and it.Callback then
									task.spawn(it.Callback)
								end
							end)

							it.Button, it.Label = Opt, Lbl
						end
					end
				end

				SetOpen = function(state)
					if locked and state then
						return
					end
					open = state
					Tween(Arrow, {Rotation = open and 0 or 90}, .3)
					if open then
						Holder.Visible = true
						Holder:TweenSize(UDim2.new(0, 375, 0, ContentHeight()), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, .25, true)
					else
						Holder:TweenSize(UDim2.new(0, 375, 0, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, .25, true)
						task.delay(.27, function()
							if not open then
								Holder.Visible = false
							end
						end)
					end
				end

				Header.MouseButton1Click:Connect(function()
					SetOpen(not open)
				end)

				local function SetSelection(v)
					selected = {}
					if type(v) == "table" then
						for _, x in ipairs(v) do
							local name = type(x) == "table" and x.Title or x
							if name ~= nil then
								selected[tostring(name)] = true
							end
							if not multi then
								break
							end
						end
					elseif type(v) == "number" then
						local it = items[v]
						if it and it.Title then
							selected[it.Title] = true
						end
					elseif v ~= nil then
						selected[tostring(v)] = true
					end
				end

				SetSelection(opts.Value or opts.Default)
				Build()
				Update(false)

				local obj = {Type = "Dropdown"}
				function obj:Get()
					return GetValue()
				end
				function obj:Set(v, silent)
					SetSelection(v)
					Update(not silent)
				end
				function obj:Select(v, silent)
					SetSelection(v)
					Update(not silent)
				end
				function obj:Refresh(list)
					items = Normalize(list)
					local names = {}
					for _, it in ipairs(items) do
						if it.Title then
							names[it.Title] = true
						end
					end
					for k in pairs(selected) do
						if not names[k] then
							selected[k] = nil
						end
					end
					Build()
					Update(false)
					if open then
						Holder.Size = UDim2.new(0, 375, 0, ContentHeight())
					end
				end
				obj.SetOptions = obj.Refresh
				function obj:Open()
					SetOpen(true)
				end
				function obj:Close()
					SetOpen(false)
				end
				function obj:Lock()
					locked = true
					SetLockedVisual(T, D, true)
					SetOpen(false)
				end
				function obj:Unlock()
					locked = false
					SetLockedVisual(T, D, false)
				end
				return RegisterFlag(opts.Flag, obj)
			end

