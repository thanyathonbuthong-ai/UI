-- ============================================================
--  WindowTable:Notify (Notification system — จาก Wind UI)
-- ============================================================
function WindowTable:Notify(title, text, duration, ntype)
	duration = duration or 5
	ntype = ntype or "info"
	local colors = {
		info = Theme.Accent,
		success = Color3.fromRGB(60, 160, 80),
		warning = Color3.fromRGB(220, 160, 40),
		error = Color3.fromRGB(200, 60, 60),
	}
	local accent = colors[ntype] or Theme.Accent

	-- หา ScreenGui ตัวแรกสุดสำหรับแสดง notification
	local gui = AllWindows[#AllWindows]
	if not gui then
		gui = Instance.new("ScreenGui")
		gui.Name = "WindifiedUI_Notifications"
		gui.Parent = CoreGui
		gui.ResetOnSpawn = false
		table.insert(AllWindows, gui)
	end

	local Container
	for _, c in ipairs(gui:GetChildren()) do
		if c.Name == "NotificationContainer" then Container = c; break end
	end
	if not Container then
		Container = Instance.new("Frame")
		Container.Name = "NotificationContainer"
		Container.Parent = gui
		Container.BackgroundTransparency = 1
		Container.Position = UDim2.new(1, -10, 1, -10)
		Container.AnchorPoint = Vector2.new(1, 1)
		Container.Size = UDim2.new(0, 300, 1, -20)
		Container.ZIndex = 500
		local layout = ListLayout(Container, 6, Enum.SortOrder.LayoutOrder)
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
		layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	end

	local Card = Instance.new("Frame")
	Card.Parent = Container
	Card.BackgroundColor3 = Theme.Background
	Card.Size = UDim2.new(0, 280, 0, 0)
	Card.AutomaticSize = Enum.AutomaticSize.Y
	Card.ZIndex = 501
	Corner(Card, 6)
	Stroke(Card, accent, 1.5)
	Padding(Card, 10, 10, 10, 10)

	local AccentBar = Instance.new("Frame")
	AccentBar.Parent = Card
	AccentBar.BackgroundColor3 = accent
	AccentBar.Position = UDim2.new(0, -10, 0, 0)
	AccentBar.Size = UDim2.new(0, 3, 1, 0)
	AccentBar.ZIndex = 502

	local TitleLbl = Instance.new("TextLabel")
	TitleLbl.Parent = Card
	TitleLbl.BackgroundTransparency = 1
	TitleLbl.Size = UDim2.new(1, 0, 0, 18)
	TitleLbl.Font = Enum.Font.GothamBold
	TitleLbl.Text = tostring(title or "Notification")
	TitleLbl.TextColor3 = Theme.Text
	TitleLbl.TextSize = 13
	TitleLbl.TextXAlignment = Enum.TextXAlignment.Left
	TitleLbl.LayoutOrder = 1
	TitleLbl.ZIndex = 502

	local TextLbl = Instance.new("TextLabel")
	TextLbl.Parent = Card
	TextLbl.BackgroundTransparency = 1
	TextLbl.Size = UDim2.new(1, 0, 0, 0)
	TextLbl.AutomaticSize = Enum.AutomaticSize.Y
	TextLbl.Font = Enum.Font.Gotham
	TextLbl.Text = tostring(text or "")
	TextLbl.TextColor3 = Theme.SubText
	TextLbl.TextSize = 12
	TextLbl.TextXAlignment = Enum.TextXAlignment.Left
	TextLbl.TextWrapped = true
	TextLbl.LayoutOrder = 2
	TextLbl.ZIndex = 502

	Card.MouseEnter:Connect(function() Tween(Card, {BackgroundColor3 = Theme.RowHover}, .15) end)
	Card.MouseLeave:Connect(function() Tween(Card, {BackgroundColor3 = Theme.Background}, .15) end)

	local function dismiss()
		Tween(Card, {Size = UDim2.new(0, 0, 0, Card.AbsoluteSize.Y), BackgroundTransparency = 1}, .25)
		Tween(TitleLbl, {TextTransparency = 1}, .2)
		Tween(TextLbl, {TextTransparency = 1}, .2)
		task.delay(.3, function() Card:Destroy() end)
	end

	Card.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then dismiss() end
	end)

	-- Animate in
	Tween(Card, {Size = UDim2.new(0, 280, 0, Card.AbsoluteSize.Y)}, .3)
	if duration > 0 then
		task.delay(duration, dismiss)
	end

	return {Close = dismiss}
end

