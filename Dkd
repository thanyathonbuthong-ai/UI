			local function BindPickerDrag(gui, onMove)
				local activeInput = nil

				gui.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						if RainbowColorPicker then
							return
						end
						activeInput = input
						InputLock = true
						NewPages.ScrollingEnabled = false
						onMove(input.Position)
					end
				end)

				UserInputService.InputChanged:Connect(function(input)
					if not activeInput then return end
					if (input.UserInputType == Enum.UserInputType.MouseMovement and activeInput.UserInputType == Enum.UserInputType.MouseButton1)
						or (input.UserInputType == Enum.UserInputType.Touch and input == activeInput) then
						onMove(input.Position)
					end
				end)

				UserInputService.InputEnded:Connect(function(input)
					if activeInput and (input == activeInput
						or (input.UserInputType == Enum.UserInputType.MouseButton1 and activeInput.UserInputType == Enum.UserInputType.MouseButton1)) then
						activeInput = nil
						InputLock = false
						NewPages.ScrollingEnabled = true
					end
				end)
			end

