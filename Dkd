-- ============================================================
--  Config System (Save/Load — จาก Wind UI รองรับทุก element)
-- ============================================================
local function configPath(name)
	return ConfigFolder .. "/" .. tostring(name) .. ".json"
end

function WindowTable:SaveConfig(name)
	name = name or "default"
	local data = {}
	for flag, obj in pairs(Flags) do
		local ok, val = pcall(function() return obj:Get() end)
		if ok then
			if typeof(val) == "Color3" then
				data[flag] = {__type = "Color3", r = val.R, g = val.G, b = val.B}
			elseif typeof(val) == "EnumItem" then
				data[flag] = {__type = "Enum", enum = tostring(val.EnumType), name = val.Name}
			elseif type(val) == "table" then
				data[flag] = {__type = "table", value = val}
			else
				data[flag] = val
			end
		end
	end
	local json = HttpService:JSONEncode(data)
	local ok = pcall(function()
		if not isfolder(ConfigFolder) then makefolder(ConfigFolder) end
		writefile(configPath(name), json)
	end)
	return ok
end

function WindowTable:LoadConfig(name)
	name = name or "default"
	local ok, data = pcall(function()
		local raw = readfile(configPath(name))
		return HttpService:JSONDecode(raw)
	end)
	if not ok or type(data) ~= "table" then return false end
	for flag, val in pairs(data) do
		local obj = Flags[flag]
		if obj and obj.Set then
			local realVal = val
			if type(val) == "table" and val.__type then
				if val.__type == "Color3" then
					realVal = Color3.new(val.r, val.g, val.b)
				elseif val.__type == "Enum" then
					local ok2, enum = pcall(function() return Enum[val.enum][val.name] end)
					if ok2 then realVal = enum else realVal = nil end
				elseif val.__type == "table" then
					realVal = val.value
				end
			end
			if realVal ~= nil then
				pcall(function() obj:Set(realVal, true) end)
			end
		end
	end
	return true
end

function WindowTable:DeleteConfig(name)
	name = name or "default"
	return pcall(function() delfile(configPath(name)) end)
end

function WindowTable:ListConfigs()
	local list = {}
	local ok = pcall(function()
		for _, f in ipairs(listfiles(ConfigFolder)) do
			if f:match("%.json$") then
				table.insert(list, f:match("([^/]+)%.json$"))
			end
		end
	end)
	return list
end

-- ============================================================
--  Theme / Accent / Rainbow (จาก Wind UI)
-- ============================================================
function WindowTable:SetAccent(color)
	Theme.Accent = color
	Theme.AccentDark = Color3.new(color.R * 0.7, color.G * 0.7, color.B * 0.7)
end

function WindowTable:SetRainbow(state)
	Theme.Rainbow = state == true
end

function WindowTable:SetTheme(newTheme)
	for k, v in pairs(newTheme or {}) do
		if Theme[k] ~= nil then
			Theme[k] = v
		end
	end
end

function WindowTable:GetTheme()
	return Theme
end

-- ============================================================
--  Unload (ทำลาย UI ทั้งหมด — จาก Wind UI)
-- ============================================================
function WindowTable:Unload()
	for _, gui in ipairs(AllWindows) do
		pcall(function() gui:Destroy() end)
	end
	AllWindows = {}
	Flags = {}
end

function WindowTable:Destroy()
	WindowTable:Unload()
end

-- ============================================================
--  Toggle UI เปิด/ปิดด้วยโปรแกรม
-- ============================================================
function WindowTable:Toggle()
	-- จะทำงานกับ window ล่าสุด
	local gui = AllWindows[#AllWindows]
	if not gui then return end
	local glow = gui:FindFirstChild("MainFrameGlow")
	if glow then
		local mf = glow:FindFirstChild("MainFrame")
		if mf then
			local hidden = mf.Size.X.Offset < 100
			if hidden then
				Tween(mf, {Size = UDim2.new(0, 448, 0, 331)}, .3)
				Tween(glow, {Size = UDim2.new(0, 448, 0, 331)}, .3)
			else
				Tween(mf, {Size = UDim2.new(0, 0, 0, 0)}, .3)
				Tween(glow, {Size = UDim2.new(0, 0, 0, 0)}, .3)
			end
		end
	end
end

return WindowTable
