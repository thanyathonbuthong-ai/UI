			HoverRow(Row)

			local function Render(animate)
				local t = animate and .2 or 0
				Tween(ToggleBg, {BackgroundColor3 = state and Theme.Accent or Theme.Off}, t)
				Tween(Knob, {Position = state and UDim2.new(1, -4, 0.5, 0) or UDim2.new(0, 4, 0.5, 0)}, t)
			end

			local function Fire() task.spawn(function() cb(state) end) end

			Row.MouseButton1Click:Connect(function()
				if Row:GetAttribute("Locked") then return end
				state = not state
				Render(true)
				Fire()
			end)

			local obj = {}
			function obj:Set(v, silent) state = (v == true); Render(true); if not silent then Fire() end end
			function obj:Get() return state end
			function obj:SetTitle(t) T.Text = tostring(t) end
			function obj:SetDesc(t) if D then D.Text = tostring(t) end end
			function obj:Lock() Row:SetAttribute("Locked", true); SetLockedVisual(T, D, true) end
			function obj:Unlock() Row:SetAttribute("Locked", false); SetLockedVisual(T, D, false) end
			function obj:Highlight() Tween(Row, {BackgroundColor3 = Theme.AccentDark}, .2); task.delay(.4, function() Tween(Row, {BackgroundColor3 = Theme.Row}, .3) end) end
			function obj:Destroy() Row:Destroy() end
			return RegisterFlag(opts.Flag, obj)
		end

		-- --------------------------------------------------------
		--  Slider
		-- --------------------------------------------------------
		function ElementHandler:Slider(a, b, c, d, e)
			local opts
			if type(a) == "table" then
				opts = a
			else
				opts = {Title = a, Min = tonumber(b), Max = tonumber(c), Default = tonumber(d)}
				if type(e) == "table" then for k, v in pairs(e) do opts[k] = v end end
			end
			local min = opts.Min or 0
			local max = opts.Max or 100
			local value = opts.Default or min
			local rounding = opts.Rounding or 0
			local cb = opts.Callback or function() end
			local suffix = opts.Suffix or ""
			local height = opts.Desc and 52 or 42
			local Row = MakeRow(Page, "Frame", height)
			Row.LayoutOrder = nextOrder()
			registerElement(Row, opts.Title)
			local T, D = RowTitle(Row, opts.Title, opts.Desc, 80)

			local ValueBox = Instance.new("TextBox")
			ValueBox.Name = "ValueBox"
			ValueBox.Parent = Row
			ValueBox.BackgroundColor3 = Theme.Field
			ValueBox.Position = UDim2.new(1, -70, 0, 6)
			ValueBox.Size = UDim2.new(0, 56, 0, 20)
			ValueBox.Font = Enum.Font.GothamSemibold
			ValueBox.Text = tostring(value) .. suffix
			ValueBox.TextColor3 = Theme.Text
			ValueBox.TextSize = 12
			ValueBox.ClearTextOnFocus = false
			ValueBox.ZIndex = 5
			Corner(ValueBox, 4)

			local Track = Instance.new("Frame")
			Track.Name = "Track"
			Track.Parent = Row
			Track.BackgroundColor3 = Theme.Field
			Track.Position = UDim2.new(0, 14, 1, -12)
			Track.Size = UDim2.new(1, -28, 0, 4)
			Corner(Track, 2)

			local Fill = Instance.new("Frame")
			Fill.Name = "Fill"
			Fill.Parent = Track
			Fill.BackgroundColor3 = Theme.Accent
			Fill.Size = UDim2.new(0, 0, 1, 0)
			Corner(Fill, 2)

			local Knob = Instance.new("Frame")
			Knob.Name = "Knob"
			Knob.Parent = Track
			Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			Knob.AnchorPoint = Vector2.new(0.5, 0.5)
			Knob.Position = UDim2.new(0, 0, 0.5, 0)
			Knob.Size = UDim2.new(0, 12, 0, 12)
			Corner(Knob, 6)

			local Hit = Instance.new("TextButton")
			Hit.Name = "Hit"
			Hit.Parent = Track
			Hit.BackgroundTransparency = 1
			Hit.Size = UDim2.new(1, 0, 3, 0)
			Hit.Position = UDim2.new(0, 0, -1, 0)
			Hit.Text = ""
			Hit.AutoButtonColor = false
			Hit.ZIndex = 6

			local function Snap(v)
				v = math.clamp(v, min, max)
				if rounding > 0 then
					local mult = 10 ^ rounding
					v = math.floor(v * mult + 0.5) / mult
				else
					v = math.floor(v + 0.5)
				end
				return v
			end

			local function Visual()
				local ratio = (value - min) / (max - min)
				Tween(Fill, {Size = UDim2.new(ratio, 0, 1, 0)}, .1)
				Tween(Knob, {Position = UDim2.new(ratio, 0, 0.5, 0)}, .1)
				ValueBox.Text = tostring(value) .. suffix
			end

			local function Apply(v, fire, onlyIfChanged)
				v = Snap(v)
				if onlyIfChanged and v == value then return end
				value = v
				Visual()
				if fire then task.spawn(function() cb(value) end) end
			end

			Apply(value, false)

			local dragging = false
			local function Move(input)
				local ratio = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
				Apply(min + ratio * (max - min), true, true)
			end

			Hit.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 and not Row:GetAttribute("Locked") then
					dragging = true
					InputLock = true
					Move(input)
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
					Move(input)
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 and dragging then
					dragging = false
					InputLock = false
				end
			end)

			ValueBox.FocusLost:Connect(function(enter)
				local num = tonumber(ValueBox.Text:gsub("[^%d%-%+%.]", ""))
				if num then
					Apply(num, true)
				else
					ValueBox.Text = tostring(value) .. suffix
				end
			end)

			local obj = {}
			function obj:Set(v, silent) Apply(v, not silent) end
			function obj:Change(v) Apply(v, true) end
			function obj:Get() return value end
			function obj:SetRange(mi, ma) min = mi; max = ma; Apply(value, false) end
			function obj:Lock() Row:SetAttribute("Locked", true); SetLockedVisual(T, D, true) end
			function obj:Unlock() Row:SetAttribute("Locked", false); SetLockedVisual(T, D, false) end
			function obj:Destroy() Row:Destroy() end
			return RegisterFlag(opts.Flag, obj)
		end

