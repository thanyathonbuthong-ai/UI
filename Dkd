			Content.Visible = opened
			Content.LayoutOrder = 1
			Content.ClipsDescendants = true
			local contentLayout = ListLayout(Content, 5, Enum.SortOrder.LayoutOrder)
			Padding(Content, 6, 0, 0, 0)

			contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
				if opened then
					Tween(Content, {Size = UDim2.new(1, 0, 0, contentLayout.AbsoluteContentSize.Y)}, .2)
				end
			end)

			local function SetOpened(state)
				opened = state
				Content.Visible = true
				Arrow.Rotation = opened and 0 or 270
				if opened then
					Tween(Content, {Size = UDim2.new(1, 0, 0, contentLayout.AbsoluteContentSize.Y)}, .25)
				else
					Tween(Content, {Size = UDim2.new(1, 0, 0, 0)}, .25)
					task.delay(.25, function() if not opened then Content.Visible = false end end)
				end
			end

			Header.MouseEnter:Connect(function() Tween(Header, {BackgroundColor3 = Theme.RowHover}, .15) end)
			Header.MouseLeave:Connect(function() Tween(Header, {BackgroundColor3 = Theme.Field}, .15) end)
