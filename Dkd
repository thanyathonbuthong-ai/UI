local Flags = {} -- เก็บ Element ที่ตั้ง Flag ไว้ (ใช้กับ SaveConfig / LoadConfig)

local function RegisterFlag(flag, obj)
	if flag ~= nil then
		Flags[flag] = obj
	end
	return obj
end

local function Tween(obj, props, t)
	TweenService:Create(obj, TweenInfo.new(t or .3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props):Play()
end

local function Corner(parent, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 4)
	c.Parent = parent
	return c
end

local function Stroke(parent, color, thickness)
	local s = Instance.new("UIStroke")
	s.Color = color or Theme.Off
	s.Thickness = thickness or 1
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

local function MakeRow(parent, className, height)
	local R = Instance.new(className)
	R.Name = "Row"
	R.Parent = parent
	R.BackgroundColor3 = Theme.Row
	R.BorderSizePixel = 0
	R.Size = UDim2.new(0, 375, 0, height)
	if className == "TextButton" then
		R.AutoButtonColor = false
		R.Text = ""
	end
	return R
end

local function HoverRow(row)
	row.MouseEnter:Connect(function()
		Tween(row, {BackgroundColor3 = Theme.RowHover})
	end)
	row.MouseLeave:Connect(function()
		Tween(row, {BackgroundColor3 = Theme.Row})
	end)
end

local function RowTitle(parent, title, desc, rightPad)
	rightPad = rightPad or 14
	local T = Instance.new("TextLabel")
	T.Name = "Title"
	T.Parent = parent
	T.BackgroundTransparency = 1
	T.Position = UDim2.new(0, 14, 0, desc and 6 or 0)
	T.Size = UDim2.new(1, -(14 + rightPad), 0, desc and 18 or 32)
	T.Font = Enum.Font.Gotham
	T.Text = tostring(title or "")
	T.TextColor3 = Theme.Text
	T.TextSize = 14
	T.TextXAlignment = Enum.TextXAlignment.Left
	T.TextTruncate = Enum.TextTruncate.AtEnd
	local D = nil
	if desc then
		D = Instance.new("TextLabel")
		D.Name = "Desc"
		D.Parent = parent
		D.BackgroundTransparency = 1
		D.Position = UDim2.new(0, 14, 0, 24)
		D.Size = UDim2.new(1, -(14 + rightPad), 0, 16)
		D.Font = Enum.Font.Gotham
		D.Text = tostring(desc)
		D.TextColor3 = Theme.Muted
		D.TextSize = 12
		D.TextXAlignment = Enum.TextXAlignment.Left
		D.TextTruncate = Enum.TextTruncate.AtEnd
	end
	return T, D
end

local function SetLockedVisual(T, D, locked)
	T.TextTransparency = locked and 0.5 or 0
	if D then
		D.TextTransparency = locked and 0.5 or 0
	end
end

local function ResolveKey(v)
	if typeof(v) == "EnumItem" then
		return v
	end
	if type(v) == "string" then
		local ok, kc = pcall(function()
			return Enum.KeyCode[v]
		end)
		if ok then
			return kc
		end
	end
	return nil
end

