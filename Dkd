				local Knob, Inner, IStroke
				if kind == "Switch" then
					Indicator.Size = UDim2.new(0, 40, 0, 20)
					Indicator.BackgroundColor3 = Theme.Off
					Corner(Indicator, 10)
					Knob = Instance.new("Frame")
					Knob.Name = "Knob"
					Knob.Parent = Indicator
					Knob.AnchorPoint = Vector2.new(0, 0.5)
					Knob.BackgroundColor3 = Theme.Text
					Knob.BorderSizePixel = 0
					Knob.Position = UDim2.new(0, 3, 0.5, 0)
					Knob.Size = UDim2.new(0, 14, 0, 14)
					Corner(Knob, 7)
				elseif kind == "Checkbox" then
					Indicator.Size = UDim2.new(0, 21, 0, 21)
					Indicator.BackgroundColor3 = Theme.Field
					Corner(Indicator, 6)
					IStroke = Stroke(Indicator, Theme.Off, 1.5)
					Inner = Instance.new("Frame")
					Inner.Name = "Check"
					Inner.Parent = Indicator
					Inner.AnchorPoint = Vector2.new(0.5, 0.5)
					Inner.BackgroundColor3 = Theme.On
					Inner.BorderSizePixel = 0
					Inner.Position = UDim2.new(0.5, 0, 0.5, 0)
					Inner.Size = UDim2.new(0, 0, 0, 0)
					Corner(Inner, 3)
				else
					Indicator.Size = UDim2.new(0, 21, 0, 21)
					Indicator.BackgroundColor3 = Theme.Off
					Corner(Indicator, 6)
				end

				local function Render(animate)
					local t = animate and 0.25 or 0
					if kind == "Switch" then
						Tween(Indicator, {BackgroundColor3 = state and Theme.On or Theme.Off}, t)
						Tween(Knob, {Position = state and UDim2.new(0, 23, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)}, t)
					elseif kind == "Checkbox" then
						Tween(IStroke, {Color = state and Theme.On or Theme.Off}, t)
						Tween(Inner, {Size = state and UDim2.new(0, 11, 0, 11) or UDim2.new(0, 0, 0, 0)}, t)
					else
						Tween(Indicator, {BackgroundColor3 = state and Theme.On or Theme.Off}, t)
					end
				end
				Render(false)

				local function Fire()
					task.spawn(cb, state)
				end

				Row.MouseButton1Click:Connect(function()
					if locked then
						return
					end
					state = not state
					Render(true)
					Fire()
				end)

				local obj = {Type = "Toggle"}
				function obj:Set(v, silent)
					state = v and true or false
					Render(true)
					if not silent then
						Fire()
					end
				end
				function obj:Get()
					return state
				end
				function obj:SetTitle(t)
					T.Text = tostring(t)
				end
				function obj:Lock()
					locked = true
					SetLockedVisual(T, D, true)
				end
				function obj:Unlock()
					locked = false
					SetLockedVisual(T, D, false)
				end
				return RegisterFlag(opts.Flag, obj)
			end

			-- ===================== Slider (เมาส์ + สัมผัส) =====================
			function ElementHandler:Slider(a, b, c, d, e)
				local title, desc, min, max, default, step, cb, locked, flag
				if type(a) == "table" then
					local v = type(a.Value) == "table" and a.Value or {}
					title = a.Title
					desc = a.Desc
					min = v.Min or a.Min or 0
					max = v.Max or a.Max or 100
					default = v.Default or a.Default or (type(a.Value) == "number" and a.Value) or min
					step = a.Step or 1
					cb = a.Callback
					locked = a.Locked == true
					flag = a.Flag
				else
					title = a
					min = b or 0
					max = c or 100
					default = d or min
					step = 1
					cb = e
					locked = false
				end
				cb = cb or function() end
				if max <= min then
					max = min + 1
				end
				if step <= 0 then
					step = 1
				end

				local H = desc and 65 or 51
				local Row = MakeRow(Container, "Frame", H)
				Row.Name = "Slider"
				HoverRow(Row)
				local T, D = RowTitle(Row, title or "", desc, 80)
				T.Position = UDim2.new(0, 14, 0, 6)
