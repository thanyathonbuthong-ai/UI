				return CurrentColor.BackgroundColor3
			end
			function obj:Set(c, silent)
				local h, s, v = Color3.toHSV(c)
				ColorH, ColorS, ColorV = h, s, v
				CurrentColor.BackgroundColor3 = c
				Color.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
				HueSelection.Position = UDim2.new(0.48, 0, 1 - h, 0)
				ColorSelection.Position = UDim2.new(s, 0, 1 - v, 0)
				if not silent then
					pcall(callback, c)
				end
			end
			return obj
		end

			function ElementHandler:Colorpicker(a, b, c)
				local opts = type(a) == "table" and a or {Title = a, Default = b, Callback = c}
				local default = opts.Default or opts.Value or Color3.fromRGB(255, 255, 255)
				local obj = LegacyColorpicker(opts.Title or "Colorpicker", default, opts.Callback or function() end)
				obj.Type = "Colorpicker"
				obj:Set(default, true)
				return RegisterFlag(opts.Flag, obj)
			end

			return ElementHandler
		end

		return MakeElements(NewPages)

	end
	
