		-- --------------------------------------------------------
		--  Keybind (รองรับ Mode: Hold/Toggle/Always — จาก Wind UI)
		-- --------------------------------------------------------
		function ElementHandler:Keybind(a)
			local opts = type(a) == "table" and a or {Title = a}
			local cb = opts.Callback or function() end
			local mode = opts.Mode or "Toggle" -- Hold, Toggle, Always
			local currentKey = ResolveKey(opts.Default) or Enum.KeyCode.Unknown
			local listening = false
			local height = opts.Desc and 44 or 32
			local Row = MakeRow(Page, "Frame", height)
			Row.LayoutOrder = nextOrder()
			registerElement(Row, opts.Title)
			local T, D = RowTitle(Row, opts.Title, opts.Desc, 110)

			local KeyBtn = Instance.new("TextButton")
			KeyBtn.Name = "KeyBtn"
			KeyBtn.Parent = Row
			KeyBtn.BackgroundColor3 = Theme.Field
			KeyBtn.Position = UDim2.new(1, -100, 0.5, -11)
			KeyBtn.Size = UDim2.new(0, 86, 0, 22)
			KeyBtn.AutoButtonColor = false
			KeyBtn.Font = Enum.Font.GothamSemibold
			KeyBtn.Text = currentKey.Name
			KeyBtn.TextColor3 = Theme.Text
			KeyBtn.TextSize = 12
			KeyBtn.ZIndex = 5
			Corner(KeyBtn, 4)

			local function Show()
				KeyBtn.Text = listening and "..." or (currentKey.Name or "None")
				Tween(KeyBtn, {BackgroundColor3 = listening and Theme.Accent or Theme.Field}, .15)
			end

			KeyBtn.MouseButton1Click:Connect(function()
				if Row:GetAttribute("Locked") then return end
				listening = true
				Show()
			end)

			UserInputService.InputBegan:Connect(function(input, gpe)
				if listening and input.UserInputType == Enum.UserInputType.Keyboard then
					currentKey = input.KeyCode
					listening = false
					Show()
					task.spawn(function() cb(currentKey) end)
				elseif listening and input.UserInputType == Enum.UserInputType.MouseButton1 then
					-- ใช้ปุ่มเมาส์ได้ด้วย (แปลงเป็น KeyCode ผ่าน Mouse)
					currentKey = Enum.KeyCode.Unknown -- จำกัดแค่ keyboard
					listening = false
					Show()
				end
			end)

			-- จำลอง Hold/Toggle mode
			local held = false
			UserInputService.InputBegan:Connect(function(input, gpe)
				if gpe or listening then return end
				if input.KeyCode == currentKey and currentKey ~= Enum.KeyCode.Unknown then
					if mode == "Hold" then
						held = true
						task.spawn(function() cb(true) end)
					elseif mode == "Toggle" then
						held = not held
						task.spawn(function() cb(held) end)
					elseif mode == "Always" then
						task.spawn(function() cb(true) end)
					end
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if mode == "Hold" and input.KeyCode == currentKey then
					held = false
					task.spawn(function() cb(false) end)
				end
			end)

			Show()

			local obj = {}
			function obj:Set(v, silent) currentKey = ResolveKey(v) or Enum.KeyCode.Unknown; Show(); if not silent then task.spawn(function() cb(currentKey) end) end end
			function obj:Get() return currentKey end
			function obj:Lock() Row:SetAttribute("Locked", true); SetLockedVisual(T, D, true) end
			function obj:Unlock() Row:SetAttribute("Locked", false); SetLockedVisual(T, D, false) end
			function obj:Destroy() Row:Destroy() end
			return RegisterFlag(opts.Flag, obj)
		end


