			function ElementHandler:Toggle(a, b)
				local opts = type(a) == "table" and a or {Title = a, Callback = b}
				local desc = opts.Desc
				local cb = opts.Callback or function() end
				local locked = opts.Locked == true
				local kind = opts.Type or "Box"
				local state = (opts.Value == true) or (opts.Default == true)

				local Row = MakeRow(Container, "TextButton", desc and 46 or 32)
