			if opened then
				Content.Size = UDim2.new(1, 0, 0, 0)
			end

			-- สร้าง ElementHandler ย่อยสำหรับใส่ element ใน Section
			local secHandler = {}
			local secElementOrder = 0
			local function secNextOrder() secElementOrder = secElementOrder + 1; return secElementOrder end

			-- Proxy: สร้าง element ใน Content แทน Page
			local origPage = Page
			Page = Content -- สลับไป Content ชั่วคราว
			local origNextOrder = nextOrder
			nextOrder = secNextOrder

			-- คัดลอก methods ทั้งหมดจาก ElementHandler ไปยัง secHandler (สร้างใน Content)
			for name, fn in pairs(ElementHandler) do
				if type(fn) == "function" and name ~= "__index" then
					secHandler[name] = function(self, ...)
						local oldPage = Page
						local oldNext = nextOrder
						Page = Content
						nextOrder = secNextOrder
						local result = fn(ElementHandler, ...)
						Page = oldPage
						nextOrder = oldNext
						return result
					end
				end
			end

			Page = origPage -- คืนค่า
			nextOrder = origNextOrder

			local sec = {}
			sec.Container = secHandler
			function sec:SetTitle(t) HeaderText.Text = tostring(t) end
			function sec:Open() SetOpened(true) end
			function sec:Close() SetOpened(false) end
			function sec:Destroy() Holder:Destroy() end
			return sec
		end


