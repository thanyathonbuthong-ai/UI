	end)
	Card.MouseLeave:Connect(function()
		TweenService:Create(Card, TweenInfo.new(.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
			{BackgroundColor3 = Color3.fromRGB(29, 26, 53)}):Play()
	end)

	local closed = false
	local function dismiss()
		if closed then return end
		closed = true
		for i, f in ipairs(NotifyList) do
			if f == dismiss then
				table.remove(NotifyList, i)
				break
			end
		end
		TweenService:Create(Slide, TweenInfo.new(.35, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
			{Position = UDim2.new(1, 24, 0, 0)}):Play()
		TweenService:Create(Glow, TweenInfo.new(.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
			{ImageTransparency = 1}):Play()
		wait(.35)
		TweenService:Create(Wrapper, TweenInfo.new(.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
			{Size = UDim2.new(0, NotifyWidth, 0, 0)}):Play()
		wait(.2)
		Wrapper:Destroy()
	end

	Card.MouseButton1Click:Connect(dismiss)

	table.insert(NotifyList, dismiss)
	if #NotifyList > NotifyMax then
		coroutine.wrap(NotifyList[1])()
	end

	coroutine.wrap(function()
		TweenService:Create(Slide, TweenInfo.new(.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
			{Position = UDim2.new(0, 0, 0, 0)}):Play()
		TweenService:Create(Glow, TweenInfo.new(.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
			{ImageTransparency = 0}):Play()
		TweenService:Create(Fill, TweenInfo.new(duration, Enum.EasingStyle.Linear),
			{Size = UDim2.new(0, 0, 1, 0)}):Play()
		local t0 = os.clock()
		while not closed and os.clock() - t0 < duration do
			wait(.1)
		end
		dismiss()
	end)()

	return {Close = dismiss}
end

-- ============================================================
--  Config: บันทึก/โหลดค่าของ Element ที่ตั้ง Flag ไว้
--  WindowTable:SaveConfig("ชื่อ")  /  WindowTable:LoadConfig("ชื่อ")
-- ============================================================
function WindowTable:GetFlag(flag)
	return Flags[flag]
end

function WindowTable:SaveConfig(name)
	if not writefile then
		return false
	end
	local data = {}
	for flag, obj in pairs(Flags) do
		local ok, v = pcall(function()
			return obj:Get()
		end)
		if ok and v ~= nil then
			if obj.Type == "Colorpicker" then
				v = {r = v.R, g = v.G, b = v.B}
			end
			data[flag] = v
		end
	end
	if makefolder and isfolder and not isfolder("UIConfigs") then
		makefolder("UIConfigs")
	end
	local ok = pcall(function()
		writefile("UIConfigs/" .. tostring(name or "default") .. ".json", HttpService:JSONEncode(data))
	end)
	return ok
end

function WindowTable:LoadConfig(name)
	if not (readfile and isfile) then
		return false
	end
	local path = "UIConfigs/" .. tostring(name or "default") .. ".json"
	if not isfile(path) then
		return false
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(readfile(path))
	end)
	if not ok or type(data) ~= "table" then
		return false
	end
	for flag, v in pairs(data) do
		local obj = Flags[flag]
		if obj then
			if obj.Type == "Colorpicker" and type(v) == "table" then
				v = Color3.new(v.r or 0, v.g or 0, v.b or 0)
			end
			pcall(function()
				obj:Set(v)
			end)
		end
	end
	return true
end

return WindowTable
