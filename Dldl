-- CONFIG MANAGER (บันทึก/โหลดค่า element ที่ใส่ Flag)
------------------------------------------------------------------
local fsOK = (writefile and readfile and isfile and isfolder and makefolder) and true or false

local function newConfigManager(win)
	local cm = {Configs = {}, _mem = {}}
	local base = "UILibrary/" .. tostring(win.Folder or "Default")
	cm.Path = base .. "/config/"
	if fsOK then
		pcall(function()
			for _, p in ipairs({"UILibrary", base, base .. "/config"}) do
				if not isfolder(p) then makefolder(p) end
			end
		end)
	end

	local function gather(cfg)
		local all = {}
		for flag, el in pairs(win.Flags) do all[flag] = el end
		for flag, el in pairs(cfg.Elements) do all[flag] = el end
		return all
	end

	local function serEl(el)
		if el.__type == "Colorpicker" then
			local c = el:Get()
			return {__t = "Color3", r = c.R, g = c.G, b = c.B, a = el.Transparency}
		end
		return el:Get()
	end

	function cm:CreateConfig(name, autoload)
		if not name or name == "" then
			return false, "No config name"
		end
		local cfg = {Name = name, Elements = {}, CustomData = {}, AutoLoad = autoload or false}
		local path = cm.Path .. name .. ".json"

		function cfg:Register(flag, el) self.Elements[flag] = el return el end
		function cfg:Set(k, v) self.CustomData[k] = v end
		function cfg:Get(k) return self.CustomData[k] end
		function cfg:SetAsCurrent() win.CurrentConfig = self end

		function cfg:Save()
			local data = {Version = 1, Elements = {}, CustomData = self.CustomData}
			for flag, el in pairs(gather(self)) do
				local ok, v = pcall(serEl, el)
				if ok and v ~= nil then
					data.Elements[flag] = v
				end
			end
			local ok, json = pcall(HttpService.JSONEncode, HttpService, data)
			if not ok then return false, "encode error" end
			if fsOK then
				local wok, werr = pcall(writefile, path, json)
				if not wok then return false, werr end
			else
				cm._mem[name] = json
			end
			return true, data
		end

		function cfg:Load()
			local json
			if fsOK then
				if isfile(path) then json = readfile(path) end
			else
				json = cm._mem[name]
			end
			if not json then return false, "ไม่พบ config" end
			local ok, data = pcall(HttpService.JSONDecode, HttpService, json)
			if not ok or type(data) ~= "table" then return false, "config เสียหาย" end
			local all = gather(self)
			for flag, val in pairs(data.Elements or {}) do
				local el = all[flag]
				if el then
					if type(val) == "table" and val.__t == "Color3" then
						pcall(el.Set, el, Color3.new(val.r, val.g, val.b), val.a)
					else
						pcall(el.Set, el, val)
					end
				end
			end
			self.CustomData = data.CustomData or {}
			return true, data
		end

		function cfg:Delete()
			if fsOK then
				if delfile and isfile(path) then pcall(delfile, path) end
			else
				cm._mem[name] = nil
			end
			cm.Configs[name] = nil
			return true
		end

		function cfg:SetAutoLoad(v)
			self.AutoLoad = v and true or false
			if fsOK then
				local ap = cm.Path .. "_autoload.txt"
				if self.AutoLoad then
					pcall(writefile, ap, name)
				elseif isfile(ap) and delfile and readfile(ap) == name then
					pcall(delfile, ap)
				end
			else
				cm._mem._autoload = self.AutoLoad and name or nil
			end
		end

		function cfg:GetData()
			local d = {}
			for flag, el in pairs(gather(self)) do
				local ok, v = pcall(serEl, el)
				if ok then d[flag] = v end
			end
			return d
		end

		cm.Configs[name] = cfg
		if cfg.AutoLoad then cfg:SetAutoLoad(true) end
		return cfg
	end

	function cm:Config(name, autoload)
		return cm.Configs[name] or cm:CreateConfig(name, autoload)
	end
	function cm:GetConfig(name) return cm.Configs[name] end
	function cm:DeleteConfig(name)
		local c = cm.Configs[name] or cm:CreateConfig(name)
		if c then return c:Delete() end
	end
	function cm:AllConfigs()
		local out = {}
		if fsOK and listfiles then
			local ok, files = pcall(listfiles, cm.Path)
			if ok then
				for _, f in ipairs(files) do
					local n = tostring(f):match("([^/\\]+)%.json$")
					if n then out[#out + 1] = n end
				end
			end
		else
			for n in pairs(cm._mem) do
				if n ~= "_autoload" then out[#out + 1] = n end
			end
		end
		return out
	end
	-- เรียกหลังสร้าง UI เสร็จ เพื่อโหลด config ที่ตั้ง AutoLoad ไว้
	function cm:AutoLoad()
		local name
		if fsOK then
			local ap = cm.Path .. "_autoload.txt"
			if isfile(ap) then name = readfile(ap) end
		else
			name = cm._mem._autoload
		end
		if name and name ~= "" then
			local cfg = cm:Config(name)
			cfg:SetAsCurrent()
			return cfg:Load()
		end
		return false, "ไม่มี AutoLoad config"
	end
	return cm
end

