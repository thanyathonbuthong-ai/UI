local function keyGate(o)
	local ks = o.KeySystem
	local folder = "UILibrary/" .. tostring(o.Folder or "Default")
	local keyFile = folder .. "/key.txt"

	local function clean(k)
		return (tostring(k or ""):gsub("^%s+", ""):gsub("%s+$", ""))
	end
	local function valid(k)
		k = clean(k)
		if k == "" then return false end
		if ks.KeyValidator then
			local ok, r = pcall(ks.KeyValidator, k)
			return (ok and r) and true or false
		end
		if type(ks.Key) == "table" then
			return table.find(ks.Key, k) ~= nil
		end
		return tostring(ks.Key) == k
	end

	if ks.SaveKey and fsOK then
		local ok, saved = pcall(function()
			if isfile(keyFile) then return readfile(keyFile) end
		end)
		if ok and saved and valid(saved) then return true end
	end

	local g = newScreenGui("UILIB_KeyGate", 50)
	local dim = new("Frame", {Name = "UILIB", BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.4, Size = UDim2.new(1, 0, 1, 0), BorderSizePixel = 0, Active = true}, g)
	local panel = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0, 320, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BorderSizePixel = 0}, dim)
	reg(panel, "BackgroundColor3", "Background")
	round(panel, 10)
	pad(panel, 16, 16, 16, 16)
	list(panel, "V", 10)
	if library.mobile then
		new("UIScale", {Scale = library.mobilescale}, panel)
	end

	local t = label(panel, ks.Title or o.Title or "Key System", 20, "Text", F_BOLD)
	t.LayoutOrder = 1
	local n = label(panel, ks.Note or "กรุณาใส่คีย์เพื่อใช้งาน", 15, "SubText", F_BODY)
	n.LayoutOrder = 2

	local boxF = new("Frame", {Size = UDim2.new(1, 0, 0, 38), BorderSizePixel = 0, LayoutOrder = 3}, panel)
	reg(boxF, "BackgroundColor3", "Input")
	round(boxF, 6)
	local tb = new("TextBox", {BackgroundTransparency = 1, Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -20, 1, 0), Font = F_BODY, TextSize = 17, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, PlaceholderText = "Enter key...", Text = ""}, boxF)
	reg(tb, "TextColor3", "Text")
	reg(tb, "PlaceholderColor3", "SubText")

	local err = label(panel, "", 14, "Danger", F_BODY)
	err.LayoutOrder = 4
	err.Visible = false

	local row = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 38), LayoutOrder = 5}, panel)
	list(row, "H", 8)

	local result = nil
	local function mkBtn(text, colorKey, order, widthScale, cb)
		local b = new("TextButton", {Text = "", AutoButtonColor = false, BorderSizePixel = 0, Size = UDim2.new(widthScale, -4, 1, 0), LayoutOrder = order}, row)
		reg(b, "BackgroundColor3", colorKey)
		round(b, 6)
		local l = new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Font = F_BOLD, TextSize = 16, Text = text, TextColor3 = colorKey == "Accent" and Color3.new(1, 1, 1) or nil}, b)
		if colorKey ~= "Accent" then reg(l, "TextColor3", "Text") end
		tap(b, cb)
		return b
	end

	local hasUrl = ks.URL ~= nil
	if hasUrl then
		mkBtn("Get Key", "Input", 1, 0.34, function()
			if setclipboard then
				setclipboard(tostring(ks.URL))
				err.Text = "คัดลอกลิงก์แล้ว"
			else
				err.Text = tostring(ks.URL)
			end
			err.Visible = true
		end)
	end
	mkBtn("Cancel", "Input", 2, hasUrl and 0.33 or 0.4, function() result = false end)
	mkBtn("Submit", "Accent", 3, hasUrl and 0.33 or 0.6, function()
		if valid(tb.Text) then
			if ks.SaveKey and fsOK then
				pcall(function()
					for _, pth in ipairs({"UILibrary", folder}) do
						if not isfolder(pth) then makefolder(pth) end
					end
					writefile(keyFile, clean(tb.Text))
				end)
			end
			result = true
		else
			err.Text = "คีย์ไม่ถูกต้อง"
			err.Visible = true
		end
	end)

	while result == nil and g.Parent do
		task.wait(0.1)
	end
	pcall(function() g:Destroy() end)
	return result == true
end

