	local hl = new("TextLabel", {BackgroundTransparency = 1, Position = UDim2.new(0, ic and 24 or 2, 0, 0), Size = UDim2.new(1, -(ic and 54 or 30), 1, 0), Font = F_BOLD, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left}, head)
	reg(hl, "TextColor3", "Accent")
