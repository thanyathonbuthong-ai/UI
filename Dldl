	attach(sec, {win = ctx.win, tab = ctx.tab, parent = content, order = {n = 0}})
	if ctx.group then ctx.group:_relayout() end
	return sec
end

local ElementNames = {"Button", "Toggle", "Checkbox", "Slider", "ProgressBar", "Keybind", "Input", "Dropdown", "Colorpicker", "Paragraph", "Code", "Divider", "Space", "Image", "Group", "Section"}

attach = function(obj, ctx)
	for _, name in ipairs(ElementNames) do
		obj[name] = function(self, opts)
			return Elements[name](ctx, opts or {})
		end
	end
end

