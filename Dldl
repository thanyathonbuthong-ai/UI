function library:CreateWindow(o)
	o = o or {}
	if o.KeySystem and not keyGate(o) then
		return nil
	end

	local touch = library.mobile
	local scale = o.UIScale or (touch and library.mobilescale or 1)

	local win = {
		__type = "Window",
		Title = o.Title or "UI Library",
		Author = o.Author,
		Folder = o.Folder,
		Connections = {}, Flags = {}, AllElements = {}, Tabs = {},
		TabCount = 0, Closed = false, Destroyed = false, Fullscreen = false,
		Resizable = o.Resizable ~= false,
		ToggleKey = o.ToggleKey or Enum.KeyCode.RightShift,
		CurrentTab = nil, CurrentConfig = nil,
		_order = 0, _userSized = false,
		_onOpen = nil, _onClose = nil, _onDestroy = nil,
		_sidebarShown = true,
	}
	library.Windows[#library.Windows + 1] = win
	library.Window = win

	local gui = newScreenGui(HttpService:GenerateGUID(false), 5)
	win.Gui = gui

	local function viewport()
		local a = gui.AbsoluteSize
		if a.X < 1 or a.Y < 1 then a = camera.ViewportSize end
		return a
	end

	-- ขนาดหน้าต่าง (หน่วย px จริงบนหน้าจอ)
	local minSize = o.MinSize or Vector2.new(560, 350)
	local maxSize = o.MaxSize or Vector2.new(850, 560)
	local reqSize = o.Size or UDim2.new(0, 580, 0, 460)
	win.Size = UDim2.new(0, math.clamp(reqSize.X.Offset, minSize.X, maxSize.X), 0, math.clamp(reqSize.Y.Offset, minSize.Y, maxSize.Y))

	local main = new("Frame", {Name = "UILIB", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), BorderSizePixel = 0, Active = true}, gui)
	reg(main, "BackgroundColor3", "Background")
	main.BackgroundTransparency = o.Transparent and 0.15 or 0
	round(main, 10)
	win.Main = main

	local shadow = new("ImageLabel", {
		Name = "Shadow", AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
		Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(1, 24, 1, 24), ZIndex = 0,
		ImageTransparency = 0.5, Image = "rbxassetid://1316045217", ImageColor3 = Color3.new(0, 0, 0),
		ScaleType = Enum.ScaleType.Slice, SliceCenter = Rect.new(10, 10, 118, 118),
	}, main)

	-- Root = พื้นที่ทำงานที่ถูกขยายด้วย UIScale (ขนาดจริงเท่ากับ main พอดี)
	local root = new("Frame", {Name = "Root", BackgroundTransparency = 1, Size = UDim2.new(1 / scale, 0, 1 / scale, 0)}, main)
	local uiscale = new("UIScale", {Scale = scale}, root)
	win.Root = root

	function win:_fit()
		if win.Fullscreen then return end
		local vp = viewport()
		if touch then
			if not win._userSized then
				local landscape = vp.X > vp.Y
				main.Size = UDim2.new(0, vp.X * (landscape and 0.74 or 0.97), 0, vp.Y * (landscape and 0.92 or 0.82))
			end
		else
			main.Size = win.Size
		end
	end
	win:_fit()
	C(win, gui:GetPropertyChangedSignal("AbsoluteSize"), function() win:_fit() end)

	------------------------------------------------ Topbar
	local topH = o.Author and 46 or 38
	local top = new("Frame", {Name = "Topbar", Size = UDim2.new(1, 0, 0, topH), BorderSizePixel = 0, Active = true}, root)
	reg(top, "BackgroundColor3", "Topbar")
	round(top, 10)

	local left = new("Frame", {BackgroundTransparency = 1, Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -150, 1, 0)}, top)
	local ll = list(left, "H", 8)
	ll.VerticalAlignment = Enum.VerticalAlignment.Center
	if o.Icon then
		local ic = icon(left, o.Icon, o.IconSize or 22, "Text")
		if ic then ic.LayoutOrder = 1 end
	end
	local titleBox = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = 2}, left)
	local tl = list(titleBox, "V", 0)
	tl.VerticalAlignment = Enum.VerticalAlignment.Center
	local titleLbl = new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(0, 0, 0, 20), AutomaticSize = Enum.AutomaticSize.X, Font = F_BOLD, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 1}, titleBox)
	reg(titleLbl, "TextColor3", "Text")
	bindText(titleLbl, win.Title)
	local authorLbl = new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(0, 0, 0, 16), AutomaticSize = Enum.AutomaticSize.X, Font = F_BODY, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 2, Visible = o.Author ~= nil}, titleBox)
	reg(authorLbl, "TextColor3", "SubText")
	bindText(authorLbl, o.Author or "")
	local tagsHolder = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(0, 0, 0, 20), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = 3}, left)
	list(tagsHolder, "H", 4).VerticalAlignment = Enum.VerticalAlignment.Center

	local btns = new("Frame", {BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), Size = UDim2.new(0, 0, 0, 30), AutomaticSize = Enum.AutomaticSize.X}, top)
	local bl = list(btns, "H", 2)
	bl.HorizontalAlignment = Enum.HorizontalAlignment.Right
	bl.VerticalAlignment = Enum.VerticalAlignment.Center

	local function topButton(glyph, order, cb)
		local b = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(0, 34, 0, 30), LayoutOrder = order}, btns)
		reg(b, "BackgroundColor3", "ElementHover")
		round(b, 6)
		local t
		if type(glyph) == "string" and (glyph:find("^rbx") or tonumber(glyph)) then
			t = icon(b, glyph, 16, "Text")
			t.AnchorPoint = Vector2.new(0.5, 0.5)
			t.Position = UDim2.new(0.5, 0, 0.5, 0)
		else
			t = new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Font = F_BOLD, TextSize = 20, Text = tostring(glyph)}, b)
			reg(t, "TextColor3", "Text")
		end
		if not touch then
			b.MouseEnter:Connect(function() tween(b, 0.1, {BackgroundTransparency = 0.5}) end)
			b.MouseLeave:Connect(function() tween(b, 0.1, {BackgroundTransparency = 1}) end)
		end
		tap(b, cb)
		return b
	end

	dragMove(win, top, main, function(x, y)
		local vp = viewport()
		return math.clamp(x, -vp.X / 2 + 60, vp.X / 2 - 60), math.clamp(y, -vp.Y / 2 + 20, vp.Y / 2 - 20)
	end, function() return not win.Fullscreen end)

	------------------------------------------------ Body (Sidebar + Content)
	local sbW = o.SideBarWidth
	if sbW == nil then sbW = touch and 130 or 170 end
	local hasSidebar = sbW > 0
	win.SideBarWidth = sbW

	local body = new("Frame", {Name = "Body", BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, topH), Size = UDim2.new(1, 0, 1, -topH), ClipsDescendants = true}, root)
	local sidebar = new("Frame", {Name = "Sidebar", Size = UDim2.new(0, sbW, 1, 0), BorderSizePixel = 0, Visible = hasSidebar}, body)
	reg(sidebar, "BackgroundColor3", "Sidebar")
	local sbScroll = new("ScrollingFrame", {
		BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0),
		CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 2, ScrollingDirection = Enum.ScrollingDirection.Y,
		TopImage = "rbxassetid://967852042", MidImage = "rbxassetid://967852042", BottomImage = "rbxassetid://967852042",
	}, sidebar)
	reg(sbScroll, "ScrollBarImageColor3", "Scrollbar")
	pad(sbScroll, 8, 6, 8, 6)
	list(sbScroll, "V", 4)

	local content = new("Frame", {Name = "Content", BackgroundTransparency = 1, Position = UDim2.new(0, sbW, 0, 0), Size = UDim2.new(1, -sbW, 1, 0)}, body)

	function win:SetSidebarVisible(v)
		if not hasSidebar then return end
		win._sidebarShown = v
		sidebar.Visible = v
		local w = v and sbW or 0
		content.Position = UDim2.new(0, w, 0, 0)
		content.Size = UDim2.new(1, -w, 1, 0)
	end

	-- ช่องค้นหา (เปิดด้วย HideSearchBar = false)
	local searchBox
	local searchH = 0
	if o.HideSearchBar == false then
		searchH = 40
		local sf = new("Frame", {Size = UDim2.new(1, -16, 0, 30), Position = UDim2.new(0, 8, 0, 6), BorderSizePixel = 0}, content)
		reg(sf, "BackgroundColor3", "Input")
		round(sf, 6)
		searchBox = new("TextBox", {BackgroundTransparency = 1, Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -20, 1, 0), Font = F_BOLD, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, PlaceholderText = "Search", Text = ""}, sf)
		reg(searchBox, "TextColor3", "Text")
		reg(searchBox, "PlaceholderColor3", "SubText")
	end
	local pages = new("Frame", {Name = "Pages", BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, searchH), Size = UDim2.new(1, 0, 1, -searchH)}, content)

	local function applySearch()
		local tab = win.CurrentTab
		if not tab then return end
		local q = (searchBox and searchBox.Text or ""):lower()
		for _, e in ipairs(tab.Elements) do
			if e.card.Parent then
				local hay = (e.title.Text .. " " .. (e.desc.Visible and e.desc.Text or "")):lower()
				e.card.Visible = (q == "") or (hay:find(q, 1, true) ~= nil)
			end
		end
	end
	if searchBox then
		searchBox:GetPropertyChangedSignal("Text"):Connect(applySearch)
	end

	------------------------------------------------ ปุ่มบน Topbar
	if hasSidebar then
		topButton("≡", 80, function() win:SetSidebarVisible(not win._sidebarShown) end)
	end
	local fsBtn = topButton("□", 90, function() win:ToggleFullscreen() end)
	topButton("–", 91, function() win:Close() end)
	topButton("×", 92, function()
		if o.IgnoreAlerts then
			win:Destroy()
		else
			win:Dialog({
				Title = "Close Window",
				Content = "ต้องการปิดหน้าต่างนี้หรือไม่?",
				Buttons = {
					{Title = "Cancel", Variant = "Secondary"},
					{Title = "Close", Variant = "Danger", Callback = function() win:Destroy() end},
				},
			})
		end
	end)

	function win:CreateTopbarButton(name, ic, cb, order)
		return topButton(ic or name or "•", order or 10, cb)
	end

	------------------------------------------------ Resize handle
	local grip = new("Frame", {Name = "ResizeGrip", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -2, 1, -2), Size = UDim2.new(0, 22, 0, 22), BackgroundTransparency = 1, ZIndex = 30, Active = true, Visible = win.Resizable}, root)
	local gl = new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Font = F_BOLD, TextSize = 16, Text = "◢", TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Bottom, ZIndex = 30}, grip)
	reg(gl, "TextColor3", "Bar")
	do
		local gInput, gStart, sSize
		grip.InputBegan:Connect(function(input)
			if isPointer(input) and not win.Fullscreen then
				gInput = input
				gStart = Vector2.new(input.Position.X, input.Position.Y)
				sSize = main.AbsoluteSize
			end
		end)
		C(win, UIS.InputChanged, function(input)
			if gInput and (input == gInput or (gInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)) then
				local d = Vector2.new(input.Position.X, input.Position.Y) - gStart
				local vp = viewport()
				local w, h
				if touch then
					w = math.clamp(sSize.X + d.X * 2, vp.X * 0.4, vp.X * 0.98)
					h = math.clamp(sSize.Y + d.Y * 2, vp.Y * 0.4, vp.Y * 0.95)
				else
					w = math.clamp(sSize.X + d.X * 2, minSize.X, maxSize.X)
					h = math.clamp(sSize.Y + d.Y * 2, minSize.Y, maxSize.Y)
					win.Size = UDim2.new(0, w, 0, h)
				end
				win._userSized = true
				main.Size = UDim2.new(0, w, 0, h)
			end
		end)
		C(win, UIS.InputEnded, function(input)
			if gInput and (input == gInput or (gInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)) then
				gInput = nil
			end
		end)
	end

	------------------------------------------------ OpenButton
	local ob = o.OpenButton or {}
	local obEnabled = ob.Enabled ~= false
	local openBtn = new("TextButton", {
		Name = "OpenButton", Text = "", AutoButtonColor = false, BorderSizePixel = 0, Visible = false,
		AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.new(0, 0, 0, touch and 44 or 36),
		Position = ob.Position or UDim2.new(0, 16, 0, 16), ZIndex = 10,
	}, gui)
	reg(openBtn, "BackgroundColor3", "Accent")
	round(openBtn, 18)
	pad(openBtn, 0, 16, 0, 16)
	local obLbl = new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Font = F_BOLD, TextSize = touch and 19 or 17, TextColor3 = Color3.new(1, 1, 1), ZIndex = 11}, openBtn)
	bindText(obLbl, ob.Title or win.Title)
	if ob.Color then openBtn.BackgroundColor3 = ob.Color end
	tap(openBtn, function() win:Open() end)
	if ob.Draggable ~= false then
		dragMove(win, openBtn, openBtn)
	end

	function win:EditOpenButton(e)
		e = e or {}
		if e.Title then bindText(obLbl, e.Title) end
		if e.Color then openBtn.BackgroundColor3 = e.Color end
		if e.Enabled ~= nil then obEnabled = e.Enabled end
		openBtn.Visible = obEnabled and win.Closed
	end

	------------------------------------------------ Window methods
	function win:Open()
		win.Closed = false
		main.Visible = true
		openBtn.Visible = false
		if win._onOpen then task.spawn(safe, win._onOpen) end
	end
	function win:Close()
		win.Closed = true
		main.Visible = false
		openBtn.Visible = obEnabled
		if win._onClose then task.spawn(safe, win._onClose) end
	end
	function win:Toggle()
		if win.Closed then win:Open() else win:Close() end
	end
	function win:Destroy()
		if win.Destroyed then return end
		win.Destroyed = true
		if win._onDestroy then task.spawn(safe, win._onDestroy) end
		for _, c in ipairs(win.Connections) do
			pcall(function() c:Disconnect() end)
		end
		pcall(function() gui:Destroy() end)
		for i, w in ipairs(library.Windows) do
			if w == win then table.remove(library.Windows, i) break end
		end
	end
	function win:OnOpen(fn) win._onOpen = fn end
	function win:OnClose(fn) win._onClose = fn end
	function win:OnDestroy(fn) win._onDestroy = fn end

	function win:SetTitle(t) win.Title = t bindText(titleLbl, t) end
	function win:SetAuthor(t) win.Author = t authorLbl.Visible = (t ~= nil and t ~= "") bindText(authorLbl, t or "") end
	function win:SetToggleKey(k) win.ToggleKey = k end
	function win:SetSize(s)
		if typeof(s) == "Vector2" then s = UDim2.new(0, s.X, 0, s.Y) end
		win.Size = s
		win._userSized = true
		main.Size = s
	end
	function win:SetToTheCenter() main.Position = UDim2.new(0.5, 0, 0.5, 0) end
	function win:GetUIScale() return scale end
	function win:SetUIScale(s)
		scale = s
		uiscale.Scale = s
		root.Size = UDim2.new(1 / s, 0, 1 / s, 0)
	end
	function win:SetBackgroundTransparency(t) main.BackgroundTransparency = t end
	function win:ToggleTransparency(v) main.BackgroundTransparency = v and 0.15 or 0 end
	function win:IsResizable() return win.Resizable end
	function win:ToggleFullscreen()
		win.Fullscreen = not win.Fullscreen
		if win.Fullscreen then
			win._prevSize, win._prevPos = main.Size, main.Position
			main.Position = UDim2.new(0.5, 0, 0.5, 0)
			main.Size = UDim2.new(1, 0, 1, 0)
		else
			main.Size, main.Position = win._prevSize, win._prevPos
		end
		grip.Visible = win.Resizable and not win.Fullscreen
	end

	function win:LockAll()
		for _, el in ipairs(win.AllElements) do
			if el.Frame and el.Frame.Parent and el.Lock then el:Lock() end
		end
	end
	function win:UnlockAll()
		for _, el in ipairs(win.AllElements) do
			if el.Frame and el.Frame.Parent and el.Unlock then el:Unlock() end
		end
	end
	function win:GetLocked()
		local r = {}
		for _, el in ipairs(win.AllElements) do
			if el.Frame and el.Frame.Parent and el.Locked then r[#r + 1] = el end
		end
		return r
	end
	function win:GetUnlocked()
		local r = {}
		for _, el in ipairs(win.AllElements) do
			if el.Frame and el.Frame.Parent and not el.Locked then r[#r + 1] = el end
		end
		return r
	end

	function win:Tag(t)
		t = t or {}
		local pill = new("Frame", {Size = UDim2.new(0, 0, 0, 18), AutomaticSize = Enum.AutomaticSize.X, BorderSizePixel = 0, BackgroundColor3 = t.Color or currentTheme.Accent}, tagsHolder)
		if not t.Color then reg(pill, "BackgroundColor3", "Accent") end
		round(pill, 9)
		pad(pill, 0, 7, 0, 7)
		local l = new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Font = F_BOLD, TextSize = 12, TextColor3 = Color3.new(1, 1, 1)}, pill)
		bindText(l, t.Title or "Tag")
		local tag = {Frame = pill}
		function tag:SetTitle(x) bindText(l, x) end
		function tag:SetColor(c) pill.BackgroundColor3 = c end
		function tag:Destroy() pill:Destroy() end
		return tag
	end

	function win:SetCurrentConfig(cfg) win.CurrentConfig = cfg end
	win.ConfigManager = newConfigManager(win)

	function win:Notify(n) return library:Notify(n) end

	------------------------------------------------ Dialog / Popup
	function win:Dialog(d)
		d = d or {}
		local overlay = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), ZIndex = 50, Active = true}, root)
		round(overlay, 10)
		tween(overlay, 0.15, {BackgroundTransparency = 0.45})
		local panel = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0.9, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BorderSizePixel = 0}, overlay)
		reg(panel, "BackgroundColor3", "Element")
		round(panel, 10)
		pad(panel, 14, 14, 14, 14)
		list(panel, "V", 10)
		new("UISizeConstraint", {MaxSize = Vector2.new(340, math.huge)}, panel)
		local dlg = {}
		local head = label(panel, d.Title or "Dialog", 19, "Text", F_BOLD)
		head.LayoutOrder = 1
		if d.Content and d.Content ~= "" then
			local c = label(panel, d.Content, 15, "SubText", F_BODY)
			c.LayoutOrder = 2
		end
		local row = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 38), LayoutOrder = 3}, panel)
		list(row, "H", 8)
		local buttons = d.Buttons
		if not buttons or #buttons == 0 then
			buttons = {{Title = "OK", Variant = "Primary"}}
		end
		function dlg:Close()
			if dlg._closed then return end
			dlg._closed = true
			tween(overlay, 0.12, {BackgroundTransparency = 1})
			task.delay(0.13, function() overlay:Destroy() end)
		end
		local n = #buttons
		for i, b in ipairs(buttons) do
			local variant = b.Variant or (i == n and "Primary" or "Secondary")
			local key = variant == "Primary" and "Accent" or (variant == "Danger" and "Danger" or "Input")
			local btn = new("TextButton", {Text = "", AutoButtonColor = false, BorderSizePixel = 0, Size = UDim2.new(1 / n, -(8 * (n - 1)) / n, 1, 0), LayoutOrder = i}, row)
			reg(btn, "BackgroundColor3", key)
			round(btn, 6)
			local l = new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Font = F_BOLD, TextSize = 16}, btn)
			if key == "Input" then
				reg(l, "TextColor3", "Text")
			else
				l.TextColor3 = Color3.new(1, 1, 1)
			end
			bindText(l, b.Title or "Button")
			tap(btn, function()
				if b.Callback then task.spawn(safe, b.Callback) end
				if not b.KeepOpen then dlg:Close() end
			end)
		end
		return dlg
	end

	------------------------------------------------ Tabs
	local function nextOrder()
		win._order = win._order + 1
		return win._order
	end

	local function createTab(to, parent)
		to = to or {}
		local tabH = touch and 42 or 36
		win.TabCount = win.TabCount + 1
		local tab = {__type = "Tab", Title = to.Title or "Tab", Index = win.TabCount, Elements = {}, Selected = false, Locked = to.Locked == true}
		win.Tabs[#win.Tabs + 1] = tab

		local btn = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, tabH), LayoutOrder = nextOrder()}, parent)
		reg(btn, "BackgroundColor3", "ElementHover")
		round(btn, 6)
		local bar = new("Frame", {AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(0, 3, 0.6, 0), BorderSizePixel = 0, Visible = false}, btn)
		reg(bar, "BackgroundColor3", "Accent")
		round(bar, 2)
		local ic = icon(btn, to.Icon, 18, "SubText")
		if ic then ic.AnchorPoint = Vector2.new(0, 0.5) ic.Position = UDim2.new(0, 10, 0.5, 0) end
		local lbl = new("TextLabel", {BackgroundTransparency = 1, Position = UDim2.new(0, ic and 34 or 12, 0, 0), Size = UDim2.new(1, -(ic and 40 or 18), 1, 0), Font = F_BOLD, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd}, btn)
		reg(lbl, "TextColor3", function(t) return tab.Selected and t.Text or t.SubText end)
		bindText(lbl, tab.Title)
		local lockMark = new("Frame", {Name = "Lock", BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.5, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), Visible = tab.Locked, Active = true, ZIndex = 5}, btn)
		round(lockMark, 6)

		local page = new("ScrollingFrame", {
			Name = tab.Title, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), Visible = false,
			CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = touch and 4 or 3, ScrollingDirection = Enum.ScrollingDirection.Y,
			TopImage = "rbxassetid://967852042", MidImage = "rbxassetid://967852042", BottomImage = "rbxassetid://967852042",
		}, pages)
		reg(page, "ScrollBarImageColor3", "Scrollbar")
		pad(page, 8, 10, 12, 10)
		list(page, "V", 6)
		tab.Page = page
		tab.Button = btn

		local ctx = {win = win, tab = tab, parent = page, order = {n = 0}}
		if to.ShowTabTitle then
			local hd = label(page, to.Title or "Tab", 20, "Text", F_BOLD)
			hd.LayoutOrder = 0
			hd.TextXAlignment = (to.TabTitleAlign == "Center") and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left
		end
		attach(tab, ctx)

		function tab:Select()
			if tab.Locked then return end
			for _, t in ipairs(win.Tabs) do
				if t ~= tab and t.Selected then
					t.Selected = false
					t.Page.Visible = false
					t.Bar.Visible = false
					tween(t.Button, 0.15, {BackgroundTransparency = 1})
					t.Label.TextColor3 = currentTheme.SubText
				end
			end
			tab.Selected = true
			page.Visible = true
			bar.Visible = true
			tween(btn, 0.15, {BackgroundTransparency = 0.6})
			lbl.TextColor3 = currentTheme.Text
			win.CurrentTab = tab
			applySearch()
		end
		function tab:Lock() tab.Locked = true lockMark.Visible = true end
		function tab:Unlock() tab.Locked = false lockMark.Visible = false end
		function tab:SetTitle(t) tab.Title = t bindText(lbl, t) end
		function tab:Destroy()
			btn:Destroy()
			page:Destroy()
			for i, t in ipairs(win.Tabs) do
				if t == tab then table.remove(win.Tabs, i) break end
			end
			if win.CurrentTab == tab then
				win.CurrentTab = nil
				if win.Tabs[1] then win.Tabs[1]:Select() end
			end
		end
		tab.Bar, tab.Label = bar, lbl

		tap(btn, function() tab:Select() end)
		if not win.CurrentTab and not tab.Locked then
			tab:Select()
		end
		-- มือถือ (จอแนวตั้ง): เลือกแท็บแล้วพับ sidebar ให้เห็นเนื้อหาเต็ม
		return tab
	end

	function win:Tab(to)
		return createTab(to, sbScroll)
	end

	function win:SelectTab(t)
		if type(t) == "number" then t = win.Tabs[t] end
		if t then t:Select() end
	end

	function win:Section(so)
		so = so or {}
		local holder = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = nextOrder()}, sbScroll)
		list(holder, "V", 4)
		local head = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 1}, holder)
		local hl = new("TextLabel", {BackgroundTransparency = 1, Position = UDim2.new(0, 6, 0, 0), Size = UDim2.new(1, -30, 1, 0), Font = F_BOLD, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left}, head)
		reg(hl, "TextColor3", "SubText")
		bindText(hl, so.Title or "Section")
		local chev = new("TextLabel", {BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 0), Size = UDim2.new(0, 20, 1, 0), Font = F_BOLD, TextSize = 13}, head)
		reg(chev, "TextColor3", "SubText")
		local cont = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2}, holder)
		list(cont, "V", 4)
		local opened = so.Opened ~= false
		local function render()
			cont.Visible = opened
			chev.Text = opened and "▾" or "▸"
		end
		render()
		tap(head, function() opened = not opened render() end)
		local sec = {}
		function sec:Tab(to) return createTab(to, cont) end
		function sec:Open() opened = true render() end
		function sec:Close() opened = false render() end
		return sec
	end

	function win:Divider()
		local f = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 8), LayoutOrder = nextOrder()}, sbScroll)
		local line = new("Frame", {AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 4, 0.5, 0), Size = UDim2.new(1, -8, 0, 1), BorderSizePixel = 0}, f)
		reg(line, "BackgroundColor3", "Divider")
		return f
	end

	-- กดปุ่มเปิด/ปิดด้วยคีย์บอร์ด (เดิมคือ RightShift)
	C(win, UIS.InputBegan, function(input, gp)
		if win.ToggleKey and input.KeyCode == win.ToggleKey and not UIS:GetFocusedTextBox() then
			win:Toggle()
		end
	end)

	if o.Theme and library.Themes[o.Theme] then
		library:SetTheme(o.Theme)
	end

	return win
end

------------------------------------------------------------------
-- POPUP (ทางลัด) + เข้ากันได้กับ API เดิม
------------------------------------------------------------------
function library:Popup(d)
	local w = library.Window
	if w and not w.Destroyed then
		return w:Dialog(d)
	end
end

-- API เดิม: library:Create(name, size) -> features:Divider/Button/Toggle/Dropdown/Slider
function library:Create(name, size)
	local win = library:CreateWindow({
		Title = name or "UILibrary",
		Size = size or UDim2.new(0, 400, 0, 450),
		SideBarWidth = 0,
		HideSearchBar = false,
		MinSize = Vector2.new(280, 240),
		MaxSize = Vector2.new(1000, 800),
		IgnoreAlerts = true,
	})
	if not win then return nil end
	local tab = win:Tab({Title = "Main"})

	local features = {Window = win, Tab = tab}

	function features:Divider(n)
		tab:Divider({Title = n or "Divider"})
	end
	function features:Button(n, description, callback)
		return tab:Button({Title = n or "Button", Desc = description or "Button's description", Callback = callback})
	end
	function features:Toggle(n, description, state, callback)
		return tab:Toggle({Title = n or "Toggle", Desc = description or "Toggle's description", Value = state or false, Callback = callback})
	end
	function features:Dropdown(n, description, options, callback)
		local el = tab:Dropdown({Title = n or "Dropdown", Desc = description or "", Values = options or {"#1", "#2", "#3"}, Callback = callback})
		-- เดิมแก้คำอธิบายด้วย dropdown.Description = "..."
		return setmetatable({}, {
			__index = el,
			__newindex = function(_, k, v)
				if k == "Description" then el:SetDesc(v) else el[k] = v end
			end,
		})
	end
	function features:Slider(n, description, min, max, default, callback)
		min = min or 0
		max = max or 100
		return tab:Slider({Title = n or "Slider", Desc = description or "", Step = 1, Value = {Min = min, Max = max, Default = default or max / 2}, Callback = callback})
	end
	return features
end

return library
