---------------------------------------------------------------- Dropdown
function Elements.Dropdown(ctx, o)
	local multi = (o.Multi == true)
	local allowNone = (o.AllowNone == true)
	local rowH = library.mobile and 36 or 28
	local maxVisible = 5

	local el, p = newCard(ctx, o, "Dropdown", {rightW = 160, rightH = 28})
	local values = {}
	local selSingle = nil
	local selMulti = {}

	local valLbl = new("TextLabel", {BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 0), Size = UDim2.new(1, -22, 1, 0), Font = F_BODY, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd}, p.right)
	reg(valLbl, "TextColor3", "SubText")
	local arrow = new("TextLabel", {BackgroundTransparency = 1, Position = UDim2.new(1, -20, 0, 0), Size = UDim2.new(0, 20, 1, 0), Font = F_BOLD, TextSize = 16, Text = "▾"}, p.right)
	reg(arrow, "TextColor3", "SubText")

	-- Body: ช่องค้นหา (ถ้าเปิด) + รายการเลื่อนได้
	local bodyList = list(p.body, "V", 6)
	local searchBox
	if o.SearchBarEnabled then
		local sf = new("Frame", {Size = UDim2.new(1, 0, 0, 30), BorderSizePixel = 0, LayoutOrder = 1}, p.body)
		reg(sf, "BackgroundColor3", "Input")
		round(sf, 5)
		searchBox = new("TextBox", {BackgroundTransparency = 1, Position = UDim2.new(0, 8, 0, 0), Size = UDim2.new(1, -16, 1, 0), Font = F_BODY, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, PlaceholderText = "Search", Text = ""}, sf)
		reg(searchBox, "TextColor3", "Text")
		reg(searchBox, "PlaceholderColor3", "SubText")
	end
	local listFrame = new("ScrollingFrame", {
		LayoutOrder = 2, Size = UDim2.new(1, 0, 0, rowH), BorderSizePixel = 0, BackgroundTransparency = 1,
		CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = library.mobile and 4 or 3, ScrollingDirection = Enum.ScrollingDirection.Y,
		TopImage = "rbxassetid://967852042", MidImage = "rbxassetid://967852042", BottomImage = "rbxassetid://967852042",
	}, p.body)
	reg(listFrame, "ScrollBarImageColor3", "Scrollbar")
	list(listFrame, "V", 0)

	local function isSel(it)
		if multi then return selMulti[it.Title] == true end
		return selSingle == it.Title
	end
	local function getValue()
		if multi then
			local out = {}
			for _, it in ipairs(values) do
				if selMulti[it.Title] then out[#out + 1] = it.Title end
			end
			return out
		end
		return selSingle
	end
	local function display()
		local ph = o.Placeholder or "None"
		if multi then
			local names = getValue()
			valLbl.Text = #names > 0 and table.concat(names, ", ") or ph
		else
			valLbl.Text = selSingle or ph
		end
	end
	local function paintRow(it)
		if not it._row then return end
		local sel = isSel(it)
		it._txt.TextColor3 = sel and currentTheme.Text or currentTheme.SubText
		it._chk.TextTransparency = sel and 0 or 1
		it._row.BackgroundTransparency = sel and 0.75 or 1
	end
	local function resize()
		local n = 0
		for _, it in ipairs(values) do
			if it._visible ~= false then n = n + 1 end
		end
		listFrame.Size = UDim2.new(1, 0, 0, math.max(math.min(n, maxVisible), 1) * rowH)
	end

	local open = false
	local function setOpen(v)
		open = v
		p.body.Visible = v
		arrow.Text = v and "▴" or "▾"
	end

	local function fire()
		task.spawn(safe, o.Callback, getValue())
	end

	local function choose(it)
		if el.Locked then return end
		if multi then
			if selMulti[it.Title] then
				local count = 0
				for _ in pairs(selMulti) do count = count + 1 end
				if count <= 1 and not allowNone then return end
				selMulti[it.Title] = nil
			else
				selMulti[it.Title] = true
			end
		else
			if selSingle == it.Title and allowNone then
				selSingle = nil
			else
				selSingle = it.Title
			end
		end
		for _, x in ipairs(values) do paintRow(x) end
		display()
		el.Value = getValue()
		if it.Callback then task.spawn(safe, it.Callback, it.Title) end
		fire()
		if not multi then setOpen(false) end
	end

	local function rebuild()
		for _, c in ipairs(listFrame:GetChildren()) do
			if c:IsA("TextButton") then c:Destroy() end
		end
		for i, it in ipairs(values) do
			local row = new("TextButton", {Text = "", AutoButtonColor = false, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, rowH), LayoutOrder = i, BackgroundTransparency = 1}, listFrame)
			reg(row, "BackgroundColor3", "ElementHover")
			round(row, 4)
			local txt = new("TextLabel", {BackgroundTransparency = 1, Position = UDim2.new(0, 8, 0, 0), Size = UDim2.new(1, -40, 1, 0), Font = F_BOLD, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = it.Title}, row)
			local chk = new("TextLabel", {BackgroundTransparency = 1, Position = UDim2.new(1, -28, 0, 0), Size = UDim2.new(0, 22, 1, 0), Font = F_BOLD, TextSize = 16, Text = "✓"}, row)
			reg(chk, "TextColor3", "Accent")
			it._row, it._txt, it._chk = row, txt, chk
			it._visible = true
			tap(row, function() choose(it) end)
			paintRow(it)
		end
		resize()
	end

	local function normalize(vals)
		local out = {}
		for _, v in ipairs(vals or {}) do
			if type(v) == "table" then
				out[#out + 1] = {Title = tostring(v.Title or v.Name or v[1] or "?"), Icon = v.Icon, Callback = v.Callback}
			else
				out[#out + 1] = {Title = tostring(v)}
			end
		end
		return out
	end

	local function exists(title)
		for _, it in ipairs(values) do
			if it.Title == title then return true end
		end
		return false
	end

	values = normalize(o.Values)
	if multi then
		for _, t in ipairs(type(o.Value) == "table" and o.Value or {}) do
			if exists(tostring(t)) then selMulti[tostring(t)] = true end
		end
	elseif o.Value ~= nil and exists(tostring(o.Value)) then
		selSingle = tostring(o.Value)
	end
	rebuild()
	display()
	el.Value = getValue()

	if searchBox then
		searchBox:GetPropertyChangedSignal("Text"):Connect(function()
			local q = searchBox.Text:lower()
			for _, it in ipairs(values) do
				it._visible = (q == "") or (it.Title:lower():find(q, 1, true) ~= nil)
				if it._row then it._row.Visible = it._visible end
			end
			resize()
		end)
	end

	-- แตะที่หัวการ์ดเพื่อเปิด/ปิด (ไม่ใช่ทั้งการ์ด เพื่อไม่ให้ชนกับการแตะในรายการ)
	tap(p.header, function()
		if not el.Locked then setOpen(not open) end
	end)

	function el:Open() setOpen(true) end
	function el:Close() setOpen(false) end
	function el:Get() return getValue() end
	function el:Set(v, silent)
		if multi then
			selMulti = {}
			for _, t in ipairs(type(v) == "table" and v or {v}) do
				if exists(tostring(t)) then selMulti[tostring(t)] = true end
			end
		else
			selSingle = (v ~= nil and exists(tostring(v))) and tostring(v) or nil
		end
		for _, x in ipairs(values) do paintRow(x) end
		display()
		el.Value = getValue()
		if not silent then fire() end
	end
	el.Select = el.Set
	function el:Refresh(newValues)
		values = normalize(newValues)
		for t in pairs(selMulti) do
			if not exists(t) then selMulti[t] = nil end
		end
		if selSingle and not exists(selSingle) then selSingle = nil end
		rebuild()
		display()
		el.Value = getValue()
	end
	return el
end

---------------------------------------------------------------- Colorpicker
function Elements.Colorpicker(ctx, o)
	local win = ctx.win
	local color = o.Default or o.Color or Color3.new(1, 1, 1)
	local alpha = o.Transparency -- ถ้าไม่ใส่ = ไม่มีแถบความโปร่งใส
	local h, s, v = color:ToHSV()

	local el, p = newCard(ctx, o, "Colorpicker", {rightW = 48, rightH = 24})
	local swatch = new("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 44, 0, 24), BorderSizePixel = 0}, p.right)
	round(swatch, 5)
	local sst = new("UIStroke", {Thickness = 1, Transparency = 0.5}, swatch)
	reg(sst, "Color", "Divider")

	local panel = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y}, p.body)
	list(panel, "V", 8)

	-- กล่อง Saturation/Value
	local sv = new("Frame", {Size = UDim2.new(1, 0, 0, 120), BorderSizePixel = 0, LayoutOrder = 1}, panel)
	round(sv, 5)
	local white = new("Frame", {Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0}, sv)
	round(white, 5)
	new("UIGradient", {Transparency = NumberSequence.new(0, 1)}, white)
	local black = new("Frame", {Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0}, sv)
	round(black, 5)
	new("UIGradient", {Rotation = 90, Transparency = NumberSequence.new(1, 0)}, black)
	local svCursor = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, 14, 0, 14), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5}, sv)
	round(svCursor, 7)
	new("UIStroke", {Thickness = 2, Color = Color3.new(1, 1, 1)}, svCursor)

	-- แถบ Hue
	local hue = new("Frame", {Size = UDim2.new(1, 0, 0, 18), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, LayoutOrder = 2}, panel)
	round(hue, 5)
	new("UIGradient", {Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, rgb(255, 0, 0)),
		ColorSequenceKeypoint.new(1 / 6, rgb(255, 255, 0)),
		ColorSequenceKeypoint.new(2 / 6, rgb(0, 255, 0)),
		ColorSequenceKeypoint.new(3 / 6, rgb(0, 255, 255)),
		ColorSequenceKeypoint.new(4 / 6, rgb(0, 0, 255)),
		ColorSequenceKeypoint.new(5 / 6, rgb(255, 0, 255)),
		ColorSequenceKeypoint.new(1, rgb(255, 0, 0)),
	})}, hue)
	local hueCursor = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(0, 6, 1, 6), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 5}, hue)
	round(hueCursor, 3)
	new("UIStroke", {Thickness = 1, Color = Color3.new(0, 0, 0), Transparency = 0.4}, hueCursor)

	-- แถบ Transparency (ถ้ามี)
	local alphaBar, alphaCursor
	if alpha ~= nil then
		alphaBar = new("Frame", {Size = UDim2.new(1, 0, 0, 18), BackgroundColor3 = color, BorderSizePixel = 0, LayoutOrder = 3}, panel)
		round(alphaBar, 5)
		new("UIGradient", {Transparency = NumberSequence.new(0, 0.95)}, alphaBar)
		alphaCursor = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(0, 6, 1, 6), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 5}, alphaBar)
		round(alphaCursor, 3)
		new("UIStroke", {Thickness = 1, Color = Color3.new(0, 0, 0), Transparency = 0.4}, alphaCursor)
	end

	-- ช่อง Hex
	local hexF = new("Frame", {Size = UDim2.new(1, 0, 0, 30), BorderSizePixel = 0, LayoutOrder = 4}, panel)
	reg(hexF, "BackgroundColor3", "Input")
	round(hexF, 5)
	local hexBox = new("TextBox", {BackgroundTransparency = 1, Position = UDim2.new(0, 8, 0, 0), Size = UDim2.new(1, -16, 1, 0), Font = F_BODY, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, Text = ""}, hexF)
	reg(hexBox, "TextColor3", "Text")

	local function toHex(c)
		return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
	end

	local function paint(fire)
		color = Color3.fromHSV(h, s, v)
		swatch.BackgroundColor3 = color
		swatch.BackgroundTransparency = alpha or 0
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
		hueCursor.Position = UDim2.new(h, 0, 0.5, 0)
		if alphaBar then
			alphaBar.BackgroundColor3 = color
			alphaCursor.Position = UDim2.new(alpha, 0, 0.5, 0)
		end
		hexBox.Text = toHex(color)
		el.Value = color
		el.Transparency = alpha
		if fire then task.spawn(safe, o.Callback, color, alpha) end
	end
	el.Transparency = alpha
	paint(false)

	makeDrag(win, sv, function(pos)
		if el.Locked then return end
		s = math.clamp((pos.X - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
		v = 1 - math.clamp((pos.Y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
		paint(true)
	end)
	makeDrag(win, hue, function(pos)
		if el.Locked then return end
		h = math.clamp((pos.X - hue.AbsolutePosition.X) / math.max(hue.AbsoluteSize.X, 1), 0, 0.999)
		paint(true)
	end)
	if alphaBar then
		makeDrag(win, alphaBar, function(pos)
			if el.Locked then return end
			alpha = math.clamp((pos.X - alphaBar.AbsolutePosition.X) / math.max(alphaBar.AbsoluteSize.X, 1), 0, 1)
			paint(true)
		end)
	end
	hexBox.FocusLost:Connect(function()
		local r, g, b = hexBox.Text:match("^#?(%x%x)(%x%x)(%x%x)$")
		if r then
			local c = Color3.fromRGB(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16))
			h, s, v = c:ToHSV()
			paint(true)
		else
			hexBox.Text = toHex(color)
		end
	end)

	local open = false
	tap(p.header, function()
		if el.Locked then return end
		open = not open
		p.body.Visible = open
	end)

	function el:Set(c, a, silent)
		if typeof(c) == "Color3" then h, s, v = c:ToHSV() end
		if a ~= nil and alphaBar then alpha = a end
		paint(not silent)
	end
	function el:Get() return color, alpha end
	return el
end

