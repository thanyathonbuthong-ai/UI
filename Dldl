local notifyGui, notifyHolder, tipFrame, tipLabel

local function getNotifyGui()
	if notifyGui and notifyGui.Parent then
		return notifyGui
	end
	notifyGui = newScreenGui("UILIB_Notify", 100)
	local touch = library.mobile
	notifyHolder = new("Frame", {
		Name = "Holder", BackgroundTransparency = 1,
		AnchorPoint = touch and Vector2.new(0.5, 0) or Vector2.new(1, 0),
		Position = touch and UDim2.new(0.5, 0, 0, 8) or UDim2.new(1, -14, 0, 14),
		Size = UDim2.new(0, 300, 1, -28),
	}, notifyGui)
	local l = list(notifyHolder, "V", 8)
	l.HorizontalAlignment = touch and Enum.HorizontalAlignment.Center or Enum.HorizontalAlignment.Right
	if touch then
		new("UIScale", {Scale = library.mobilescale}, notifyHolder)
	end
	-- tooltip
	tipFrame = new("Frame", {Name = "Tooltip", Visible = false, AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.new(0, 0, 0, 0), ZIndex = 200}, notifyGui)
	reg(tipFrame, "BackgroundColor3", "Topbar")
	round(tipFrame, 5)
	pad(tipFrame, 4, 8, 4, 8)
	tipLabel = new("TextLabel", {BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.new(0, 0, 0, 0), Font = F_BODY, TextSize = 15, ZIndex = 201}, tipFrame)
	reg(tipLabel, "TextColor3", "Text")
	return notifyGui
end

local notifyOrder = 0

-- library:Notify({Title, Content, Duration=4, Icon, Type="info|success|warn|error", Callback})
function library:Notify(o)
	o = o or {}
	getNotifyGui()
	notifyOrder = notifyOrder + 1
	local kind = o.Type or "info"
	local kcolor = {
		info = function(t) return t.Accent end,
		success = function(t) return t.ToggleOn end,
		warn = function(t) return rgb(240, 180, 60) end,
		error = function(t) return t.Danger end,
	}
	local wrap = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(0, 280, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = notifyOrder}, notifyHolder)
	local card = new("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(0, 0, 0, 0), BorderSizePixel = 0}, wrap)
	reg(card, "BackgroundColor3", "Element")
	round(card, 8)
	new("UIStroke", {Thickness = 1, Transparency = 0.6}, card)
	local stroke = card:FindFirstChildOfClass("UIStroke")
	reg(stroke, "Color", "Divider")
	local bar = new("Frame", {Size = UDim2.new(0, 4, 1, 0), BorderSizePixel = 0}, card)
	reg(bar, "BackgroundColor3", kcolor[kind] or kcolor.info)
	round(bar, 2)
	local inner = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y}, card)
	pad(inner, 10, 12, 12, 16)
	list(inner, "V", 3)
	local head = label(inner, o.Title or "Notification", 17, "Text", F_BOLD)
	head.LayoutOrder = 1
	if o.Content and o.Content ~= "" then
		local c = label(inner, o.Content, 15, "SubText", F_BODY)
		c.LayoutOrder = 2
	end
	local prog = new("Frame", {Size = UDim2.new(1, 0, 0, 3), Position = UDim2.new(0, 0, 1, -3), BorderSizePixel = 0, ZIndex = 3}, card)
	reg(prog, "BackgroundColor3", kcolor[kind] or kcolor.info)

	-- สไลด์เข้า
	card.Position = UDim2.new(1, 320, 0, 0)
	tween(card, 0.25, {Position = UDim2.new(0, 0, 0, 0)})

	local obj = {Closed = false}
	local dur = o.Duration or 4
	function obj:Close()
		if obj.Closed then return end
		obj.Closed = true
		tween(card, 0.2, {Position = UDim2.new(1, 320, 0, 0)})
		task.delay(0.22, function()
			if wrap then wrap:Destroy() end
		end)
	end

	if dur > 0 then
		tween(prog, dur, {Size = UDim2.new(0, 0, 0, 3)})
		task.delay(dur, function() obj:Close() end)
	end

	local hit = new("TextButton", {Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), ZIndex = 5}, card)
	tap(hit, function()
		if o.Callback then safe(o.Callback) end
		obj:Close()
	end)
	return obj
end

local tipToken = 0
local function showTip(text, pos, autoHide)
	if not tipFrame then getNotifyGui() end
	tipLabel.Text = tr(text)
	tipFrame.Position = UDim2.new(0, pos.X + 12, 0, pos.Y + 14)
	tipFrame.Visible = true
	tipToken = tipToken + 1
	local mine = tipToken
	if autoHide then
		task.delay(autoHide, function()
			if tipToken == mine then tipFrame.Visible = false end
		end)
	end
end
local function hideTip()
	tipToken = tipToken + 1
	if tipFrame then tipFrame.Visible = false end
end

local function attachTooltip(obj, text)
	if not text or text == "" then return end
	obj.MouseEnter:Connect(function()
		if not library.mobile then
			showTip(text, mousePos())
		end
	end)
	obj.MouseMoved:Connect(function()
		if not library.mobile and tipFrame and tipFrame.Visible then
			local p = mousePos()
			tipFrame.Position = UDim2.new(0, p.X + 12, 0, p.Y + 14)
		end
	end)
	obj.MouseLeave:Connect(hideTip)
	-- มือถือ: กดค้างเพื่อดู tooltip
	obj.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			local start = Vector2.new(input.Position.X, input.Position.Y)
			task.delay(0.6, function()
				if input.UserInputState ~= Enum.UserInputState.End then
					local cur = Vector2.new(input.Position.X, input.Position.Y)
					if (cur - start).Magnitude < 10 then
						showTip(text, cur, 2.5)
					end
				end
			end)
		end
	end)
end

