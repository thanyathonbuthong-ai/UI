-- สร้างการ์ดมาตรฐาน: Header (Title/Desc + ช่องขวา) และ Body (ส่วนล่าง)
local function newCard(ctx, opts, kind, cfg)
	cfg = cfg or {}
	local win = ctx.win
	local card
	if cfg.clickable then
		card = new("TextButton", {Text = "", AutoButtonColor = false})
	else
		card = new("Frame")
	end
	card.Name = kind
	card.BorderSizePixel = 0
	card.Size = UDim2.new(1, 0, 0, 0)
	card.AutomaticSize = Enum.AutomaticSize.Y
	reg(card, "BackgroundColor3", "Element")
	round(card, 6)
	ctx.order.n = ctx.order.n + 1
	card.LayoutOrder = ctx.order.n

	local inner = new("Frame", {Name = "Inner", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y}, card)
	pad(inner, 8, 10, 8, 10)
	list(inner, "V", 8)

	local header = new("Frame", {Name = "Header", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1}, inner)
	local hl = list(header, "H", 0)
	hl.VerticalAlignment = Enum.VerticalAlignment.Center
	new("UISizeConstraint", {MinSize = Vector2.new(0, 32)}, header)

	local rightW = cfg.rightW or 0
	local textBlock = new("Frame", {Name = "Text", BackgroundTransparency = 1, Size = UDim2.new(1, -rightW, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1}, header)
	list(textBlock, "V", 2)
	local title = label(textBlock, opts.Title or kind, 16, "Text", F_BOLD)
	title.LayoutOrder = 1
	local desc = label(textBlock, opts.Desc or "", 14, "SubText", F_BODY)
	desc.LayoutOrder = 2
	desc.Visible = (opts.Desc ~= nil and opts.Desc ~= "")

	local right
	if rightW > 0 then
		right = new("Frame", {Name = "Right", BackgroundTransparency = 1, Size = UDim2.new(0, rightW, 0, cfg.rightH or 24), LayoutOrder = 2}, header)
	end

	local body = new("Frame", {Name = "Body", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Visible = false}, inner)

	local lockOv = new("Frame", {Name = "Lock", BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.55, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), Visible = false, Active = true, ZIndex = 20}, card)
	round(lockOv, 6)
	local hlStroke = new("UIStroke", {Thickness = 2, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, card)
	reg(hlStroke, "Color", "Accent")

	local el = {__type = kind, Title = opts.Title or kind, Desc = opts.Desc, Frame = card, Body = body, Locked = false, Flag = opts.Flag}

	function el:SetTitle(t) self.Title = t bindText(title, t) end
	function el:SetDesc(t)
		self.Desc = t
		desc.Visible = (t ~= nil and t ~= "")
		bindText(desc, t or "")
	end
	function el:Lock() self.Locked = true lockOv.Visible = true end
	function el:Unlock() self.Locked = false lockOv.Visible = false end
	function el:Highlight()
		hlStroke.Transparency = 0
		tween(hlStroke, 1.2, {Transparency = 1})
	end
	function el:SetVisible(v) card.Visible = v end
	function el:Destroy()
		if self.Flag and win.Flags[self.Flag] == self then
			win.Flags[self.Flag] = nil
		end
		card:Destroy()
	end

	if opts.Locked then el:Lock() end

	card.Parent = ctx.parent
	if ctx.tab then
		ctx.tab.Elements[#ctx.tab.Elements + 1] = {card = card, title = title, desc = desc}
	end
	win.AllElements[#win.AllElements + 1] = el
	if opts.Flag then win.Flags[opts.Flag] = el end
	if opts.Tooltip then attachTooltip(card, opts.Tooltip) end

	if cfg.clickable then
		-- เอฟเฟกต์ตอนกด/โฮเวอร์
		if not library.mobile then
			card.MouseEnter:Connect(function()
				if not el.Locked then tween(card, 0.15, {BackgroundColor3 = currentTheme.ElementHover}) end
			end)
			card.MouseLeave:Connect(function()
				tween(card, 0.15, {BackgroundColor3 = currentTheme.Element})
			end)
		end
		card.InputBegan:Connect(function(input)
			if isPointer(input) and not el.Locked then
				tween(card, 0.08, {BackgroundColor3 = currentTheme.ElementHover})
				task.delay(0.18, function()
					if card.Parent then tween(card, 0.15, {BackgroundColor3 = currentTheme.Element}) end
				end)
			end
		end)
	end

	if ctx.group then ctx.group:_relayout() end
	return el, {card = card, title = title, desc = desc, right = right, body = body, inner = inner, header = header}
end

