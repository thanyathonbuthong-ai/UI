---------------------------------------------------------------- Divider / Space / Image
local function plainItem(ctx, name, height)
	ctx.order.n = ctx.order.n + 1
	local f = new("Frame", {Name = name, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, height), LayoutOrder = ctx.order.n}, ctx.parent)
	local el = {__type = name, Frame = f}
	function el:SetVisible(v) f.Visible = v end
	function el:Destroy() f:Destroy() end
	if ctx.group then ctx.group:_relayout() end
	return el, f
end

function Elements.Divider(ctx, o)
	o = o or {}
	if o.Title then
		local el, f = plainItem(ctx, "Divider", 22)
		f.BackgroundTransparency = 0
		reg(f, "BackgroundColor3", "Divider")
		local t = new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Font = F_BOLD, TextSize = 15}, f)
		reg(t, "TextColor3", "Text")
		bindText(t, o.Title)
		return el
	end
	local el, f = plainItem(ctx, "Divider", 10)
	local line = new("Frame", {AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(1, 0, 0, 1), BorderSizePixel = 0}, f)
	reg(line, "BackgroundColor3", "Divider")
	return el
end

function Elements.Space(ctx, o)
	local el = plainItem(ctx, "Space", (o and (o.Size or o.Height)) or 8)
	return el
end

function Elements.Image(ctx, o)
	local el, f = plainItem(ctx, "Image", 0)
	local src = o.Image or ""
	if tonumber(src) then src = "rbxassetid://" .. src end
	local img = new("ImageLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Image = src, ScaleType = Enum.ScaleType.Fit}, f)
	local ratio = o.AspectRatio
	if type(ratio) == "string" then
		local a, b = ratio:match("(%d+):(%d+)")
		ratio = (a and b) and (tonumber(a) / tonumber(b)) or nil
	end
	if ratio then
		f.Size = UDim2.new(1, 0, 0, 0)
		new("UIAspectRatioConstraint", {AspectRatio = ratio, DominantAxis = Enum.DominantAxis.Width}, f)
	else
		f.Size = UDim2.new(1, 0, 0, o.Height or 120)
	end
	if o.Radius then round(img, o.Radius) end
	function el:Set(i)
		if tonumber(i) then i = "rbxassetid://" .. i end
		img.Image = i
	end
	return el
end

---------------------------------------------------------------- Group (แถวแนวนอน)
function Elements.Group(ctx, o)
	ctx.order.n = ctx.order.n + 1
	local holder = new("Frame", {Name = "Group", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = ctx.order.n}, ctx.parent)
	local l = list(holder, "H", 6)
	l.VerticalAlignment = Enum.VerticalAlignment.Top
	local g = {__type = "Group", Frame = holder}
	local gctx = {win = ctx.win, tab = ctx.tab, parent = holder, order = {n = 0}, group = g}
	function g:_relayout()
		local items = {}
		for _, c in ipairs(holder:GetChildren()) do
			if c:IsA("GuiObject") then items[#items + 1] = c end
		end
		local n = #items
		for _, c in ipairs(items) do
			c.Size = UDim2.new(1 / n, -(6 * (n - 1)) / n, 0, 0)
		end
	end
	function g:Destroy() holder:Destroy() end
	attach(g, gctx)
	return g
end

