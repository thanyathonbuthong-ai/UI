-- LOCALIZATION
------------------------------------------------------------------
local loc = {Enabled = false, Prefix = "loc:", Lang = "en", Default = "en", Translations = {}}
local locBound = setmetatable({}, {__mode = "k"})

local function tr(s)
	s = tostring(s == nil and "" or s)
	if loc.Enabled and s:sub(1, #loc.Prefix) == loc.Prefix then
		local key = s:sub(#loc.Prefix + 1)
		local t = loc.Translations[loc.Lang]
		if t and t[key] then return t[key] end
		local d = loc.Translations[loc.Default]
		return (d and d[key]) or key
	end
	return s
end

local function bindText(lbl, raw)
	locBound[lbl] = raw
	lbl.Text = tr(raw)
end

-- library:Localization({Enabled=true, Prefix="loc:", DefaultLanguage="en", Translations={en={HELLO="Hello"}, th={HELLO="สวัสดี"}}})
function library:Localization(o)
	o = o or {}
	loc.Enabled = o.Enabled ~= false
	loc.Prefix = o.Prefix or "loc:"
	loc.Default = o.DefaultLanguage or "en"
	loc.Lang = loc.Default
	loc.Translations = o.Translations or {}
	library:SetLanguage(loc.Lang)
	return loc
end

function library:SetLanguage(lang)
	loc.Lang = lang
	for lbl, raw in pairs(locBound) do
		if lbl.Parent then
			lbl.Text = tr(raw)
		end
	end
	return true
end

