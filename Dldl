function Elements.Toggle(ctx, o)
	local checkbox = (o.Type == "Checkbox")
	local el, p = newCard(ctx, o, "Toggle", {clickable = true, rightW = checkbox and 30 or 48, rightH = 24})
	local value = (o.Value == true) or (o.Default == true)
	local track, knob, box, check

	if checkbox then
		box = new("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 24, 0, 24), BorderSizePixel = 0}, p.right)
		round(box, 5)
		reg(box, "BackgroundColor3", function(t) return value and t.ToggleOn or t.Bar end)
		check = new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Font = F_BOLD, TextSize = 18, Text = "✓", TextColor3 = Color3.new(1, 1, 1), TextTransparency = value and 0 or 1}, box)
	else
		track = new("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 44, 0, 24), BorderSizePixel = 0}, p.right)
		round(track, 12)
		reg(track, "BackgroundColor3", function(t) return value and t.ToggleOn or t.ToggleOff end)
		knob = new("Frame", {AnchorPoint = Vector2.new(0, 0.5), Position = value and UDim2.new(1, -22, 0.5, 0) or UDim2.new(0, 2, 0.5, 0), Size = UDim2.new(0, 20, 0, 20), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0}, track)
		round(knob, 10)
	end

	local function render(anim)
		local d = anim and 0.2 or 0
		if checkbox then
			tween(box, d, {BackgroundColor3 = value and currentTheme.ToggleOn or currentTheme.Bar})
			tween(check, d, {TextTransparency = value and 0 or 1})
		else
			tween(track, d, {BackgroundColor3 = value and currentTheme.ToggleOn or currentTheme.ToggleOff})
			tween(knob, d, {Position = value and UDim2.new(1, -22, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)})
		end
	end

	el.Value = value
	function el:Set(v, silent)
		value = v and true or false
		self.Value = value
		render(true)
		if not silent then task.spawn(safe, o.Callback, value) end
	end
	function el:Get() return value end
	tap(p.card, function()
		if not el.Locked then el:Set(not value) end
	end)
	return el
end

function Elements.Checkbox(ctx, o)
	o.Type = "Checkbox"
	return Elements.Toggle(ctx, o)
end

---------------------------------------------------------------- Slider
function Elements.Slider(ctx, o)
	local win = ctx.win
	local v = o.Value
	local min, max, def
	if type(v) == "table" then
		min, max, def = v.Min or 0, v.Max or 100, v.Default
	else
		min, max = o.Min or 0, o.Max or 100
		def = (type(v) == "number") and v or o.Default
	end
	def = def or min
	local step = o.Step or 1
	local decimals = 0
	do
		local d = tostring(step):match("%.(%d+)")
		decimals = d and #d or 0
	end
	local suffix = o.Suffix or ""

	local el, p = newCard(ctx, o, "Slider", {rightW = 80})
	local valLbl = new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Font = F_BOLD, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Right}, p.right)
	reg(valLbl, "TextColor3", "SubText")
	p.body.Visible = true

	local holder = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28)}, p.body)
	local bar = new("Frame", {AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(1, 0, 0, 6), BorderSizePixel = 0}, holder)
	reg(bar, "BackgroundColor3", "Bar")
	round(bar, 3)
	local fill = new("Frame", {Size = UDim2.new(0, 0, 1, 0), BorderSizePixel = 0}, bar)
	reg(fill, "BackgroundColor3", "Accent")
	round(fill, 3)
	local knob = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(0, 20, 0, 20), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0}, bar)
	round(knob, 10)

	local value
	local function snap(raw)
		local s = min + math.floor((raw - min) / step + 0.5) * step
		s = math.clamp(s, min, max)
		local m = 10 ^ decimals
		return math.floor(s * m + 0.5) / m
	end
	local function paint()
		local pct = (max == min) and 0 or (value - min) / (max - min)
		knob.Position = UDim2.new(pct, 0, 0.5, 0)
		fill.Size = UDim2.new(pct, 0, 1, 0)
		valLbl.Text = string.format("%." .. decimals .. "f", value) .. suffix
	end
	value = snap(def)
	paint()
	el.Value = value

	local function apply(nv, silent, force)
		nv = snap(nv)
		local changed = nv ~= value
		value = nv
		el.Value = value
		paint()
		if (changed or force) and not silent then
			task.spawn(safe, o.Callback, value)
		end
	end

	makeDrag(win, holder, function(pos)
		if el.Locked then return end
		local w = bar.AbsoluteSize.X
		if w <= 0 then return end
		local pct = math.clamp((pos.X - bar.AbsolutePosition.X) / w, 0, 1)
		apply(min + pct * (max - min))
	end)

	function el:Set(nv, silent) apply(nv, silent, true) end
	function el:Get() return value end
	function el:SetMin(n) min = n apply(value, true) end
	function el:SetMax(n) max = n apply(value, true) end
	return el
end

---------------------------------------------------------------- ProgressBar
function Elements.ProgressBar(ctx, o)
	local el, p = newCard(ctx, o, "ProgressBar", {rightW = 60})
	local maxV = o.Max or 100
	local value = o.Value or 0
	local valLbl = new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Font = F_BOLD, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Right}, p.right)
	reg(valLbl, "TextColor3", "SubText")
	p.body.Visible = true
	local bar = new("Frame", {Size = UDim2.new(1, 0, 0, 8), BorderSizePixel = 0}, p.body)
	reg(bar, "BackgroundColor3", "Bar")
	round(bar, 4)
	local fill = new("Frame", {Size = UDim2.new(0, 0, 1, 0), BorderSizePixel = 0}, bar)
	reg(fill, "BackgroundColor3", "Accent")
	round(fill, 4)
	local function paint()
		local pct = math.clamp(value / maxV, 0, 1)
		tween(fill, 0.2, {Size = UDim2.new(pct, 0, 1, 0)})
		valLbl.Text = string.format("%d%%", math.floor(pct * 100 + 0.5))
	end
	paint()
	function el:Set(v) value = v el.Value = v paint() end
	function el:Get() return value end
	return el
end

---------------------------------------------------------------- Keybind
function Elements.Keybind(ctx, o)
	local win = ctx.win
	local function toKey(v)
		if typeof(v) == "EnumItem" then return v end
		if type(v) == "string" then
			local ok, k = pcall(function() return Enum.KeyCode[v] end)
			if ok then return k end
		end
		return nil
	end
	local key = toKey(o.Value)
	local el, p = newCard(ctx, o, "Keybind", {clickable = true, rightW = 84, rightH = 28})
	local btn = new("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 80, 0, 28), BorderSizePixel = 0}, p.right)
	reg(btn, "BackgroundColor3", "Input")
	round(btn, 5)
	local txt = new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Font = F_BOLD, TextSize = 15, TextTruncate = Enum.TextTruncate.AtEnd}, btn)
	reg(txt, "TextColor3", "Text")
	local listening = false
	local function render()
		txt.Text = listening and "..." or (key and key.Name or "None")
	end
	render()

	tap(p.card, function()
		if el.Locked then return end
		if library.mobile then
			task.spawn(safe, o.Callback, key and key.Name) -- มือถือไม่มีคีย์บอร์ด: แตะ = สั่งงาน
			return
		end
		listening = true
		render()
	end)

	C(win, UIS.InputBegan, function(input, gp)
		if listening then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				listening = false
				if input.KeyCode == Enum.KeyCode.Backspace then
					key = nil
				elseif input.KeyCode ~= Enum.KeyCode.Escape then
					key = input.KeyCode
				end
				render()
				task.spawn(safe, o.OnChange, key and key.Name)
			end
		elseif key and not gp and not el.Locked and input.KeyCode == key then
			task.spawn(safe, o.Callback, key.Name)
		end
	end)

	function el:Set(v, silent)
		key = toKey(v)
		render()
		if not silent then task.spawn(safe, o.OnChange, key and key.Name) end
	end
	function el:Get() return key and key.Name or nil end
	el.Value = key and key.Name
	return el
end

