-- HELPERS
------------------------------------------------------------------
local function safe(cb, ...)
	if type(cb) ~= "function" then return end
	local ok, err = pcall(cb, ...)
	if not ok then
		warn("[UILib] callback error: " .. tostring(err))
	end
end

local function new(class, props, parent)
	local o = Instance.new(class)
	if props then
		for k, v in pairs(props) do
			o[k] = v
		end
	end
	if parent then
		o.Parent = parent
	end
	return o
end

local function round(o, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 6)
	c.Parent = o
	return c
end

local function pad(o, t, r, b, l)
	local p = Instance.new("UIPadding")
	p.PaddingTop = UDim.new(0, t or 0)
	p.PaddingRight = UDim.new(0, r or 0)
	p.PaddingBottom = UDim.new(0, b or 0)
	p.PaddingLeft = UDim.new(0, l or 0)
	p.Parent = o
	return p
end

local function list(o, dir, gap)
	local l = Instance.new("UIListLayout")
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Padding = UDim.new(0, gap or 0)
	if dir == "H" then
		l.FillDirection = Enum.FillDirection.Horizontal
	end
	l.Parent = o
	return l
end

local function tween(o, t, props)
	local tw = TweenService:Create(o, TweenInfo.new(t or 0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local F_BOLD = Enum.Font.SourceSansSemibold
local F_BODY = Enum.Font.SourceSans

local function label(parent, str, size, colorKey, font)
	local l = new("TextLabel", {
		BackgroundTransparency = 1,
		Font = font or F_BODY,
		TextSize = size or 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	}, parent)
	reg(l, "TextColor3", colorKey or "Text")
	bindText(l, str)
	return l
end

local function C(win, signal, fn)
	local c = signal:Connect(fn)
	if win then
		win.Connections[#win.Connections + 1] = c
	end
	return c
end

local function icon(parent, ic, size, colorKey)
	-- รองรับ: "rbxassetid://123" / ตัวเลข / ตัวอักษร-อีโมจิ / "lucide:xxx" (ใช้ library.IconMap)
	if ic == nil or ic == "" then return nil end
	if type(ic) == "string" and ic:find(":") and not ic:find("^rbxasset") then
		ic = library.IconMap and library.IconMap[ic:match(":(.+)$")] or nil
		if not ic then return nil end
	end
	local asNum = tonumber(ic)
	if asNum then
		ic = "rbxassetid://" .. tostring(asNum)
	end
	if type(ic) == "string" and ic:find("^rbx") then
		local im = new("ImageLabel", {BackgroundTransparency = 1, Size = UDim2.new(0, size or 18, 0, size or 18), Image = ic}, parent)
		reg(im, "ImageColor3", colorKey or "Text")
		return im
	end
	local t = new("TextLabel", {
		BackgroundTransparency = 1, Size = UDim2.new(0, size or 18, 0, size or 18),
		Font = F_BOLD, TextSize = (size or 18) - 2, Text = tostring(ic),
	}, parent)
	reg(t, "TextColor3", colorKey or "Text")
	return t
end
library.IconMap = {} -- ใส่เองได้ เช่น library.IconMap["home"] = "rbxassetid://123"

local function mousePos()
	return UIS:GetMouseLocation() - GuiService:GetGuiInset()
end

local function guiParent()
	local ok, h = pcall(function() return gethui and gethui() end)
	if ok and h then return h end
	return game:GetService("CoreGui")
end

local function newScreenGui(name, order)
	local g = Instance.new("ScreenGui")
	g.Name = name
	g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	g.ResetOnSpawn = false
	g.IgnoreGuiInset = false
	g.DisplayOrder = order or 10
	pcall(function()
		if protectgui then protectgui(g) elseif syn and syn.protect_gui then syn.protect_gui(g) end
	end)
	g.Parent = guiParent()
	return g
end

------------------------------------------------------------------
-- INPUT: แตะ (tap) และลาก (drag) ที่ทำงานทั้งเมาส์และจอสัมผัส
------------------------------------------------------------------
local TAP_SLOP = 14
local presses = {}

local function isPointer(input)
	local t = input.UserInputType
	return t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch
end

local function pressKey(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then return "mouse" end
	return input
end

-- แตะ = กดแล้วปล่อยโดยนิ้วไม่ได้ลากไปไกล (เลื่อนรายการจะไม่ถูกนับเป็นการกด)
local function tap(obj, fn)
	obj.InputBegan:Connect(function(input)
		if isPointer(input) then
			presses[pressKey(input)] = {pos = Vector2.new(input.Position.X, input.Position.Y), fn = fn}
		end
	end)
end

UIS.InputEnded:Connect(function(input)
	if not isPointer(input) then return end
	local k = pressKey(input)
	local p = presses[k]
	if p then
		presses[k] = nil
		local pos = Vector2.new(input.Position.X, input.Position.Y)
		if (pos - p.pos).Magnitude <= TAP_SLOP then
			task.spawn(safe, p.fn, input)
		end
	end
end)

-- ปิดการเลื่อนของ ScrollingFrame ทุกชั้นที่ครอบ obj ระหว่างลาก
local function lockScroll(obj)
	local locked = {}
	local p = obj.Parent
	while p do
		if p:IsA("ScrollingFrame") and p.ScrollingEnabled then
			p.ScrollingEnabled = false
			locked[#locked + 1] = p
		end
		p = p.Parent
	end
	return function()
		for _, s in ipairs(locked) do
			s.ScrollingEnabled = true
		end
	end
end

-- ลากบน obj: onUpdate(screenPos, began) ถูกเรียกตอนเริ่มและทุกครั้งที่ขยับ
local function makeDrag(win, obj, onUpdate, onEnd)
	local active, dragInput, unlock = false, nil, nil
	local function isSame(input)
		return input == dragInput or (dragInput and dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseButton1)
	end
	obj.InputBegan:Connect(function(input)
		if isPointer(input) and not active then
			active = true
			dragInput = input
			unlock = lockScroll(obj)
			onUpdate(Vector2.new(input.Position.X, input.Position.Y), true)
		end
	end)
	C(win, UIS.InputChanged, function(input)
		if active and (input == dragInput or (dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)) then
			onUpdate(Vector2.new(input.Position.X, input.Position.Y), false)
		end
	end)
	C(win, UIS.InputEnded, function(input)
		if active and isSame(input) then
			active = false
			dragInput = nil
			if unlock then unlock() unlock = nil end
			if onEnd then onEnd() end
		end
	end)
end

