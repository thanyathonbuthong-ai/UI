local currentTheme = library.Themes.Dark
local themed = {}
local themeChanged = nil

local function resolve(theme, key)
	if type(key) == "function" then
		return key(theme)
	end
	return theme[key]
end

-- ผูกคุณสมบัติของ object เข้ากับสีของธีม (key = ชื่อสี หรือ function(theme))
local function reg(obj, prop, key)
	themed[#themed + 1] = {obj = obj, prop = prop, key = key}
	obj[prop] = resolve(currentTheme, key)
	return obj
end

function library:AddTheme(theme)
	assert(type(theme) == "table" and theme.Name, "AddTheme: ต้องมี Name")
	for k, v in pairs(library.Themes.Dark) do
		if theme[k] == nil then
			theme[k] = v
		end
	end
	library.Themes[theme.Name] = theme
	return theme
end

function library:SetTheme(name)
	local th = library.Themes[name]
	if not th then
		return nil
	end
	currentTheme = th
	local keep = {}
	for _, e in ipairs(themed) do
		if e.obj.Parent ~= nil then
			keep[#keep + 1] = e
			TweenService:Create(e.obj, TweenInfo.new(0.2), {[e.prop] = resolve(th, e.key)}):Play()
		end
	end
	themed = keep
	if themeChanged then
		task.spawn(themeChanged, name)
	end
	return th
end

function library:GetThemes() return library.Themes end
function library:GetCurrentTheme() return currentTheme.Name end
function library:OnThemeChange(fn) themeChanged = fn end

