--!nocheck
-- ═════════════════════════════════════════════════════════════
--   UI LIBRARY  —  generic reusable window/tab/component kit
--   extracted purely from the visual layer (no remotes, no
--   automation, no game-specific logic of any kind)
-- ═════════════════════════════════════════════════════════════

local UserInputService = game:GetService("UserInputService")
local TweenService     = game:GetService("TweenService")
local Players          = game:GetService("Players")
local Player           = Players.LocalPlayer

local Library = {}
Library.__index = Library

-- ─────────────────────────────────────────────────────────────
--  DEFAULT THEME  (override by passing `theme` into Library.new)
-- ─────────────────────────────────────────────────────────────
local DefaultTheme = {
    Accent=Color3.fromRGB(230,30,40),  AccentHi=Color3.fromRGB(255,100,105),
    AccentDim=Color3.fromRGB(130,15,22), BgDeep=Color3.fromRGB(4,4,6),
    BgDark=Color3.fromRGB(8,8,11),     BgPanel=Color3.fromRGB(14,14,18),
    BgCard=Color3.fromRGB(20,20,25),   BgCardHi=Color3.fromRGB(30,16,22),
    BgInput=Color3.fromRGB(24,24,30),  Text=Color3.fromRGB(248,248,250),
    TextDim=Color3.fromRGB(150,148,158), TextFaint=Color3.fromRGB(90,88,96),
    Stroke=Color3.fromRGB(38,20,24),   StrokeHi=Color3.fromRGB(90,26,32),
    Success=Color3.fromRGB(80,210,130), Warning=Color3.fromRGB(255,180,60),
    Error=Color3.fromRGB(230,50,50),
    MacRed=Color3.fromRGB(255,95,87),  MacYellow=Color3.fromRGB(255,189,46),
    MacGreen=Color3.fromRGB(40,200,64),
}

-- ─────────────────────────────────────────────────────────────
--  HELPERS
-- ─────────────────────────────────────────────────────────────
local function guiParent()
    local ok, h = pcall(function() return gethui and gethui() end)
    if ok and h then return h end
    return game:GetService("CoreGui")
end
local function corner(p, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = (typeof(r) == "UDim") and r or UDim.new(0, r or 8)
    c.Parent = p
    return c
end
local function stroke(p, col, th, tr)
    local s = Instance.new("UIStroke")
    s.Color = col
    s.Thickness = th or 1
    s.Transparency = tr or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = p
    return s
end
local function vlist(p, gap)
    local l = Instance.new("UIListLayout")
    l.FillDirection = Enum.FillDirection.Vertical
    l.Padding = UDim.new(0, gap or 6)
    l.SortOrder = Enum.SortOrder.LayoutOrder
    l.Parent = p
    return l
end
local function tween(o, p, t, s, dir)
    local tw = TweenService:Create(o,
        TweenInfo.new(t or 0.18, s or Enum.EasingStyle.Quad,
            dir or Enum.EasingDirection.Out), p)
    tw:Play()
    return tw
end

-- ═════════════════════════════════════════════════════════════
--  Library.new(config) → window object
--  config = {
--      title       = "MY LIBRARY",
--      subtitle    = "v1.0",
--      brandLetter = "L",
--      size        = UDim2, optional fixed size (overrides compact default)
--      minSize     = Vector2, smallest the window may shrink to
--      maxSize     = Vector2, largest the window may grow to
--      theme       = <table, optional overrides of DefaultTheme>,
--      showProfile = true/false,   -- Roblox avatar + name card
--      compact     = true (default), -- small window + icon-only sidebar for phones
--      sidebarWidth= number, override the sidebar width in pixels
--  }
-- ═════════════════════════════════════════════════════════════
function Library.new(config)
    config = config or {}
    local T = setmetatable(config.theme or {}, {__index = DefaultTheme})
    for k, v in pairs(DefaultTheme) do
        if T[k] == nil then T[k] = v end
    end

    -- compact = true by default → small window, icon-only sidebar, bigger
    -- touch targets. Pass compact = false to get the old desktop layout.
    local compact = (config.compact ~= false)

    local self = setmetatable({}, Library)
    self.Theme = T
    self.Compact = compact
    self.Pages = {}
    self.TabButtons = {}

    -- Gui root
    local Gui = Instance.new("ScreenGui")
    Gui.Name = config.name or "CustomUILibrary"
    Gui.ResetOnSpawn = false
    Gui.IgnoreGuiInset = true
    Gui.DisplayOrder = 100
    Gui.Parent = guiParent()
    self.Gui = Gui

    -- Main window
    -- Compact default: scales with the screen (0.92 x 0.8) and is clamped
    -- between minSize/maxSize so it stays comfortable on a phone screen
    -- instead of the old fixed 820x580 desktop box.
    local size = config.size or (compact
        and UDim2.new(0.92, 0, 0.8, 0)
        or UDim2.fromOffset(820, 580))
    local Main = Instance.new("Frame")
    Main.Name = "Main"
    Main.AnchorPoint = Vector2.new(0.5, 0.5)
    Main.Position = UDim2.new(0.5, 0, 0.5, 0)
    Main.Size = size
    Main.BackgroundColor3 = T.BgDeep
    Main.BorderSizePixel = 0
    Main.ClipsDescendants = true
    Main.Active = true
    Main.BackgroundTransparency = 1
    Main.Parent = Gui
    corner(Main, 18)
    stroke(Main, T.StrokeHi, 1.5, 0.05)
    self.Main = Main

    local sizeConstraint = Instance.new("UISizeConstraint")
    sizeConstraint.MinSize = config.minSize or Vector2.new(300, 420)
    sizeConstraint.MaxSize = config.maxSize or (compact
        and Vector2.new(420, 640)
        or Vector2.new(1400, 900))
    sizeConstraint.Parent = Main

    local mainScale = Instance.new("UIScale")
    mainScale.Scale = 0.92
    mainScale.Parent = Main
    self.mainScale = mainScale

    local mainGrad = Instance.new("UIGradient")
    mainGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, T.BgDark),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(12, 4, 8)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(10, 3, 6)),
    })
    mainGrad.Rotation = 135
    mainGrad.Parent = Main

    -- Mac-style traffic light buttons (close / min / max)
    local macRow = Instance.new("Frame")
    macRow.Name = "MacLights"
    macRow.Size = UDim2.fromOffset(64, 14)
    macRow.Position = UDim2.new(0, 16, 0, 16)
    macRow.BackgroundTransparency = 1
    macRow.ZIndex = 10
    macRow.Parent = Main

    local macDots = {}
    local function macDot(x, col, label)
        local b = Instance.new("TextButton")
        b.Name = "Mac_" .. label
        b.Size = UDim2.fromOffset(12, 12)
        b.Position = UDim2.new(0, x, 0, 0)
        b.BackgroundColor3 = col
        b.BorderSizePixel = 0
        b.Text = ""
        b.AutoButtonColor = false
        b.ZIndex = 10
        b.Parent = macRow
        corner(b, UDim.new(1, 0))
        local ring = Instance.new("UIStroke")
        ring.Color = Color3.fromRGB(0,0,0)
        ring.Thickness = 1
        ring.Transparency = 0.7
        ring.Parent = b
        local sym = Instance.new("TextLabel")
        sym.BackgroundTransparency = 1
        sym.Size = UDim2.fromScale(1, 1)
        sym.Text = label == "close" and "×" or (label == "min" and "−" or "+")
        sym.TextColor3 = Color3.fromRGB(40,10,10)
        sym.Font = Enum.Font.GothamBlack
        sym.TextScaled = true
        sym.TextTransparency = 1
        sym.ZIndex = 11
        sym.Parent = b
        b.MouseEnter:Connect(function()
            tween(b, {BackgroundColor3 = col:Lerp(Color3.new(1,1,1), 0.25)}, 0.1)
            tween(sym, {TextTransparency = 0.15}, 0.1)
        end)
        b.MouseLeave:Connect(function()
            tween(b, {BackgroundColor3 = col}, 0.1)
            tween(sym, {TextTransparency = 1}, 0.1)
        end)
        macDots[label] = b
        return b
    end
    macDot(0,  T.MacRed,    "close")
    macDot(18, T.MacYellow, "min")
    macDot(36, T.MacGreen,  "max")

    -- Restore (floating) button shown when minimized
    local Restore = Instance.new("TextButton")
    Restore.Name = "Restore"
    Restore.Size = UDim2.fromOffset(64, 64)
    Restore.AnchorPoint = Vector2.new(1, 1)
    Restore.Position = UDim2.new(1, -20, 1, -20)
    Restore.BackgroundColor3 = T.Accent
    Restore.BorderSizePixel = 0
    Restore.Text = ""
    Restore.AutoButtonColor = false
    Restore.Visible = false
    Restore.Parent = Gui
    corner(Restore, UDim.new(1, 0))
    local rg = Instance.new("UIGradient")
    rg.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, T.AccentHi),
        ColorSequenceKeypoint.new(0.5, T.Accent),
        ColorSequenceKeypoint.new(1, T.AccentDim),
    })
    rg.Rotation = 45
    rg.Parent = Restore
    local rText = Instance.new("TextLabel")
    rText.BackgroundTransparency = 1
    rText.Size = UDim2.fromScale(1, 1)
    rText.Text = config.brandLetter or "UI"
    rText.TextColor3 = Color3.new(1, 1, 1)
    rText.Font = Enum.Font.GothamBlack
    rText.TextScaled = true
    rText.ZIndex = 3
    rText.Parent = Restore
    local restoreScale = Instance.new("UIScale")
    restoreScale.Scale = 0
    restoreScale.Parent = Restore

    local hovering = false
    Restore.MouseEnter:Connect(function()
        if hovering then return end
        hovering = true
        tween(Restore, {BackgroundColor3 = T.AccentHi}, 0.15)
    end)
    Restore.MouseLeave:Connect(function()
        hovering = false
        tween(Restore, {BackgroundColor3 = T.Accent}, 0.15)
    end)

    -- open / minimize / restore / close animations
    local function animateOpen()
        Main.Visible = true
        Main.BackgroundTransparency = 1
        mainScale.Scale = 0.9
        tween(mainScale, {Scale = 1}, 0.45, Enum.EasingStyle.Back)
        tween(Main, {BackgroundTransparency = 0}, 0.35)
    end
    local function animateMinimize()
        tween(mainScale, {Scale = 0.85}, 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        local o = tween(Main, {BackgroundTransparency = 1}, 0.25)
        o.Completed:Connect(function()
            Main.Visible = false
            Restore.Visible = true
            restoreScale.Scale = 0
            tween(restoreScale, {Scale = 1}, 0.55, Enum.EasingStyle.Back)
        end)
    end
    local function animateRestore()
        tween(restoreScale, {Scale = 0}, 0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        task.delay(0.2, function()
            Restore.Visible = false
            Main.Visible = true
            Main.BackgroundTransparency = 1
            mainScale.Scale = 0.85
            tween(mainScale, {Scale = 1}, 0.5, Enum.EasingStyle.Back)
            tween(Main, {BackgroundTransparency = 0}, 0.35)
        end)
    end
    local function animateClose()
        tween(mainScale, {Scale = 0.7}, 0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        local o = tween(Main, {BackgroundTransparency = 1}, 0.28)
        o.Completed:Connect(function() Gui:Destroy() end)
    end
    self.Open, self.Minimize, self.Restore, self.Close =
        animateOpen, animateMinimize, animateRestore, animateClose

    macDots.close.MouseButton1Click:Connect(animateClose)
    macDots.min.MouseButton1Click:Connect(animateMinimize)
    macDots.max.MouseButton1Click:Connect(function()
        tween(Main, {Position = UDim2.new(0.5, 0, 0.5, 0), Size = size}, 0.35, Enum.EasingStyle.Back)
    end)
    Restore.MouseButton1Click:Connect(function()
        tween(restoreScale, {Scale = 0.85}, 0.08)
        task.delay(0.08, function() tween(restoreScale, {Scale = 1}, 0.2, Enum.EasingStyle.Back) end)
        task.delay(0.15, animateRestore)
    end)

    local toggleKey = config.toggleKey or Enum.KeyCode.RightControl
    UserInputService.InputBegan:Connect(function(i, gp)
        if gp then return end
        if i.KeyCode == toggleKey then
            if Main.Visible then animateMinimize() else animateRestore() end
        end
    end)

    -- Drag support (top bar)
    local dragging, dragStart, startPos = false, nil, nil
    UserInputService.InputChanged:Connect(function(i)
        if not dragging then return end
        if i.UserInputType ~= Enum.UserInputType.MouseMovement
            and i.UserInputType ~= Enum.UserInputType.Touch then return end
        local d = i.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
            startPos.Y.Scale, startPos.Y.Offset + d.Y)
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    local dragBar = Instance.new("TextButton")
    dragBar.Size = UDim2.new(1, 0, 0, 44)
    dragBar.BackgroundTransparency = 1
    dragBar.Text = ""
    dragBar.AutoButtonColor = false
    dragBar.ZIndex = 5
    dragBar.Parent = Main
    dragBar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = i.Position; startPos = Main.Position
        end
    end)

    -- SIDEBAR
    -- Compact mode collapses the sidebar down to a narrow icon-only rail
    -- so it doesn't eat the screen on a phone; pass sidebarWidth to override.
    local sidebarWidth = config.sidebarWidth or (compact and 64 or 210)
    self.SidebarWidth = sidebarWidth
    local Sidebar = Instance.new("Frame")
    Sidebar.Size = UDim2.new(0, sidebarWidth, 1, -46)
    Sidebar.Position = UDim2.new(0, 12, 0, 44)
    Sidebar.BackgroundColor3 = T.BgPanel
    Sidebar.BackgroundTransparency = 0.1
    Sidebar.BorderSizePixel = 0
    Sidebar.Parent = Main
    corner(Sidebar, 14)
    stroke(Sidebar, T.Stroke, 1, 0.4)

    local brand = Instance.new("Frame")
    brand.Size = UDim2.new(1, -20, 0, 60)
    brand.Position = UDim2.new(0, 10, 0, 10)
    brand.BackgroundColor3 = T.BgCard
    brand.BorderSizePixel = 0
    brand.Parent = Sidebar
    corner(brand, 12)

    local logoBox = Instance.new("Frame")
    logoBox.Size = UDim2.fromOffset(36, 36)
    logoBox.Position = UDim2.new(0, 12, 0.5, 0)
    logoBox.AnchorPoint = Vector2.new(0, 0.5)
    logoBox.BackgroundColor3 = T.Accent
    logoBox.BorderSizePixel = 0
    logoBox.Parent = brand
    corner(logoBox, 10)
    local lg = Instance.new("UIGradient")
    lg.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, T.AccentHi),
        ColorSequenceKeypoint.new(1, T.AccentDim),
    })
    lg.Rotation = 45
    lg.Parent = logoBox
    local lt = Instance.new("TextLabel")
    lt.BackgroundTransparency = 1
    lt.Size = UDim2.fromScale(1, 1)
    lt.Text = config.brandLetter or "U"
    lt.TextColor3 = Color3.new(1,1,1)
    lt.Font = Enum.Font.GothamBlack
    lt.TextScaled = true
    lt.Parent = logoBox

    local bn = Instance.new("TextLabel")
    bn.BackgroundTransparency = 1
    bn.Size = UDim2.new(1, -60, 0, 18)
    bn.Position = UDim2.new(0, 58, 0, 14)
    bn.Text = config.title or "UI LIBRARY"
    bn.TextColor3 = T.Text
    bn.Font = Enum.Font.GothamBlack
    bn.TextSize = 13
    bn.TextXAlignment = Enum.TextXAlignment.Left
    bn.Parent = brand

    local bs = Instance.new("TextLabel")
    bs.BackgroundTransparency = 1
    bs.Size = UDim2.new(1, -60, 0, 14)
    bs.Position = UDim2.new(0, 58, 0, 32)
    bs.Text = config.subtitle or ""
    bs.TextColor3 = T.TextDim
    bs.Font = Enum.Font.Gotham
    bs.TextSize = 10
    bs.TextXAlignment = Enum.TextXAlignment.Left
    bs.Parent = brand

    if compact then
        -- narrow rail: just the logo, centered, no title text
        logoBox.Position = UDim2.new(0.5, 0, 0.5, 0)
        logoBox.AnchorPoint = Vector2.new(0.5, 0.5)
        bn.Visible = false
        bs.Visible = false
    end

    local showProfile = config.showProfile
    if showProfile == nil then showProfile = not compact end

    local tabHolderTop = 78
    if showProfile then
        local prof = Instance.new("Frame")
        prof.Size = UDim2.new(1, -20, 0, 52)
        prof.Position = UDim2.new(0, 10, 0, 78)
        prof.BackgroundColor3 = T.BgCard
        prof.BorderSizePixel = 0
        prof.Parent = Sidebar
        corner(prof, 12)

        local av = Instance.new("ImageLabel")
        av.Size = UDim2.fromOffset(34, 34)
        av.Position = UDim2.new(0, 9, 0.5, 0)
        av.AnchorPoint = Vector2.new(0, 0.5)
        av.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
        av.BorderSizePixel = 0
        av.Parent = prof
        corner(av, UDim.new(1, 0))
        pcall(function()
            av.Image = Players:GetUserThumbnailAsync(Player.UserId,
                Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
        end)

        local pn = Instance.new("TextLabel")
        pn.BackgroundTransparency = 1
        pn.Size = UDim2.new(1, -56, 0, 16)
        pn.Position = UDim2.new(0, 52, 0, 10)
        pn.Text = Player.DisplayName
        pn.TextColor3 = T.Text
        pn.Font = Enum.Font.GothamBold
        pn.TextSize = 12
        pn.TextXAlignment = Enum.TextXAlignment.Left
        pn.TextTruncate = Enum.TextTruncate.AtEnd
        pn.Parent = prof

        local ph = Instance.new("TextLabel")
        ph.BackgroundTransparency = 1
        ph.Size = UDim2.new(1, -56, 0, 12)
        ph.Position = UDim2.new(0, 52, 0, 27)
        ph.Text = "@" .. Player.Name
        ph.TextColor3 = T.TextDim
        ph.Font = Enum.Font.Gotham
        ph.TextSize = 10
        ph.TextXAlignment = Enum.TextXAlignment.Left
        ph.TextTruncate = Enum.TextTruncate.AtEnd
        ph.Parent = prof

        tabHolderTop = 140
    end

    local TabHolder = Instance.new("Frame")
    TabHolder.Size = UDim2.new(1, -20, 1, -tabHolderTop - 96)
    TabHolder.Position = UDim2.new(0, 10, 0, tabHolderTop)
    TabHolder.BackgroundTransparency = 1
    TabHolder.Parent = Sidebar
    vlist(TabHolder, 4)

    local foot = Instance.new("Frame")
    foot.Size = UDim2.new(1, -20, 0, 76)
    foot.Position = UDim2.new(0, 10, 1, -86)
    foot.BackgroundColor3 = T.BgCard
    foot.BorderSizePixel = 0
    foot.Parent = Sidebar
    corner(foot, 12)
    local dot = Instance.new("Frame")
    dot.Size = UDim2.fromOffset(8, 8)
    dot.Position = UDim2.new(0, 12, 0, 14)
    dot.BackgroundColor3 = T.Success
    dot.BorderSizePixel = 0
    dot.Parent = foot
    corner(dot, UDim.new(1, 0))
    local ftText = Instance.new("TextLabel")
    ftText.BackgroundTransparency = 1
    ftText.Size = UDim2.new(1, -30, 0, 14)
    ftText.Position = UDim2.new(0, 26, 0, 12)
    ftText.Text = config.statusLabel or "Ready"
    ftText.TextColor3 = T.Success
    ftText.Font = Enum.Font.GothamBold
    ftText.TextSize = 11
    ftText.TextXAlignment = Enum.TextXAlignment.Left
    ftText.Parent = foot
    local statusText = Instance.new("TextLabel")
    statusText.BackgroundTransparency = 1
    statusText.Size = UDim2.new(1, -24, 0, 12)
    statusText.Position = UDim2.new(0, 12, 0, 32)
    statusText.Text = ""
    statusText.TextColor3 = T.TextDim
    statusText.Font = Enum.Font.Gotham
    statusText.TextSize = 10
    statusText.TextXAlignment = Enum.TextXAlignment.Left
    statusText.Parent = foot
    local footLbl = Instance.new("TextLabel")
    footLbl.BackgroundTransparency = 1
    footLbl.Size = UDim2.new(1, -24, 0, 12)
    footLbl.Position = UDim2.new(0, 12, 0, 52)
    footLbl.Text = config.footerText or ""
    footLbl.TextColor3 = T.TextFaint
    footLbl.Font = Enum.Font.Gotham
    footLbl.TextSize = 10
    footLbl.TextXAlignment = Enum.TextXAlignment.Left
    footLbl.Parent = foot
    self.StatusText = statusText

    if compact then
        -- the icon-only rail has no room for the status text, collapse
        -- the footer card down to just the little "connected" dot
        foot.Size = UDim2.new(1, -20, 0, 36)
        ftText.Visible = false
        statusText.Visible = false
        footLbl.Visible = false
        dot.Position = UDim2.new(0.5, 0, 0.5, 0)
        dot.AnchorPoint = Vector2.new(0.5, 0.5)
    end

    -- Content area (offset by the sidebar's actual width so it always lines up)
    local contentX = sidebarWidth + 12
    local Content = Instance.new("Frame")
    Content.Size = UDim2.new(1, -(sidebarWidth + 24), 1, -56)
    Content.Position = UDim2.new(0, contentX, 0, 44)
    Content.BackgroundTransparency = 1
    Content.Parent = Main
    local Header = Instance.new("Frame")
    Header.Size = UDim2.new(1, 0, 0, 46)
    Header.BackgroundTransparency = 1
    Header.Parent = Content
    local HeaderTitle = Instance.new("TextLabel")
    HeaderTitle.BackgroundTransparency = 1
    HeaderTitle.Size = UDim2.new(1, -140, 0, 26)
    HeaderTitle.Text = ""
    HeaderTitle.TextColor3 = T.Text
    HeaderTitle.Font = Enum.Font.GothamBlack
    HeaderTitle.TextSize = compact and 18 or 22
    HeaderTitle.TextXAlignment = Enum.TextXAlignment.Left
    HeaderTitle.Parent = Header
    local HeaderSub = Instance.new("TextLabel")
    HeaderSub.BackgroundTransparency = 1
    HeaderSub.Size = UDim2.new(1, -140, 0, 14)
    HeaderSub.Position = UDim2.new(0, 0, 0, 28)
    HeaderSub.Text = config.headerSub or ""
    HeaderSub.TextColor3 = T.TextDim
    HeaderSub.Font = Enum.Font.Gotham
    HeaderSub.TextSize = 11
    HeaderSub.TextXAlignment = Enum.TextXAlignment.Left
    HeaderSub.Parent = Header

    local PageHolder = Instance.new("Frame")
    PageHolder.Size = UDim2.new(1, 0, 1, -56)
    PageHolder.Position = UDim2.new(0, 0, 0, 56)
    PageHolder.BackgroundTransparency = 1
    PageHolder.ClipsDescendants = true
    PageHolder.Parent = Content

    self._TabHolder, self._PageHolder = TabHolder, PageHolder
    self._HeaderTitle = HeaderTitle

    -- NOTIFICATIONS
    local NotifHolder = Instance.new("Frame")
    NotifHolder.Name = "NotifHolder"
    NotifHolder.BackgroundTransparency = 1
    local notifWidth = compact and 240 or 340
    NotifHolder.Size = UDim2.new(0, notifWidth, 1, 0)
    NotifHolder.Position = UDim2.new(1, -(notifWidth + 16), 0, 20)
    NotifHolder.Parent = Gui
    vlist(NotifHolder, 10)
    self.NotifHolder = NotifHolder

    animateOpen()
    return self
end

-- ─────────────────────────────────────────────────────────────
--  Notify(title, msg, kind)   kind = "info" | "success" | "warning" | "error"
-- ─────────────────────────────────────────────────────────────
function Library:Notify(title, msg, kind)
    local T = self.Theme
    local col = T.Accent
    if kind == "success" then col = T.Success
    elseif kind == "warning" then col = T.Warning
    elseif kind == "error" then col = T.Error end
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 64)
    f.BackgroundColor3 = T.BgPanel
    f.BackgroundTransparency = 0.02
    f.BorderSizePixel = 0
    f.Parent = self.NotifHolder
    corner(f, 12)
    stroke(f, col, 1.5, 0.25)
    local rail = Instance.new("Frame")
    rail.Size = UDim2.new(0, 4, 0, 44)
    rail.Position = UDim2.new(0, 8, 0.5, 0)
    rail.AnchorPoint = Vector2.new(0, 0.5)
    rail.BackgroundColor3 = col
    rail.BorderSizePixel = 0
    rail.Parent = f
    corner(rail, UDim.new(1, 0))
    local tl = Instance.new("TextLabel")
    tl.BackgroundTransparency = 1
    tl.Size = UDim2.new(1, -30, 0, 18)
    tl.Position = UDim2.new(0, 22, 0, 12)
    tl.Text = title
    tl.TextColor3 = col
    tl.Font = Enum.Font.GothamBold
    tl.TextSize = 13
    tl.TextXAlignment = Enum.TextXAlignment.Left
    tl.Parent = f
    local ml = Instance.new("TextLabel")
    ml.BackgroundTransparency = 1
    ml.Size = UDim2.new(1, -30, 0, 34)
    ml.Position = UDim2.new(0, 22, 0, 30)
    ml.Text = msg
    ml.TextColor3 = T.Text
    ml.Font = Enum.Font.Gotham
    ml.TextSize = 12
    ml.TextXAlignment = Enum.TextXAlignment.Left
    ml.TextYAlignment = Enum.TextYAlignment.Top
    ml.TextWrapped = true
    ml.Parent = f
    f.Position = UDim2.new(1, 80, 0, 0)
    tween(f, {Position = UDim2.new(0, 0, 0, 0)}, 0.4, Enum.EasingStyle.Quint)
    task.delay(4, function()
        if f and f.Parent then
            local o = tween(f, {Position = UDim2.new(1, 80, 0, 0), BackgroundTransparency = 1}, 0.3)
            o.Completed:Connect(function() if f then f:Destroy() end end)
        end
    end)
end

