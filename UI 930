-- items = { {title, desc, default, cb(state)}, ... }
function Library:ToggleGrid(page, items)
    local T = self.Theme
    local rows = math.ceil(#items / 2)
    local grid = Instance.new("Frame")
    grid.Size = UDim2.new(1, -10, 0, rows * 66)
    grid.BackgroundTransparency = 1
    grid.Parent = page
    local gl = Instance.new("UIGridLayout")
    gl.CellSize = UDim2.new(0.5, -4, 0, 62)
    gl.CellPadding = UDim2.new(0, 8, 0, 4)
    gl.Parent = grid
    for i, item in ipairs(items) do
        local c = Instance.new("Frame")
        c.BackgroundColor3 = T.BgCard
        c.BorderSizePixel = 0
        c.LayoutOrder = i
        c.Parent = grid
        corner(c, 10)
        stroke(c, T.Stroke, 1, 0.4)
        c.MouseEnter:Connect(function() tween(c, {BackgroundColor3 = T.BgCardHi}, 0.15) end)
        c.MouseLeave:Connect(function() tween(c, {BackgroundColor3 = T.BgCard}, 0.15) end)
        local lbl = Instance.new("TextLabel")
        lbl.BackgroundTransparency = 1
        lbl.Size = UDim2.new(1, -60, 0, 16)
        lbl.Position = UDim2.new(0, 12, 0, 12)
        lbl.Text = item.title
        lbl.TextColor3 = T.Text
        lbl.Font = Enum.Font.GothamMedium
        lbl.TextSize = 12
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = c
        if item.desc then
            local d = Instance.new("TextLabel")
            d.BackgroundTransparency = 1
            d.Size = UDim2.new(1, -20, 0, 12)
            d.Position = UDim2.new(0, 12, 0, 30)
            d.Text = item.desc
            d.TextColor3 = T.TextFaint
            d.Font = Enum.Font.Gotham
            d.TextSize = 9
            d.TextXAlignment = Enum.TextXAlignment.Left
            d.Parent = c
        end
        local state = item.default and true or false
        local off = Color3.fromRGB(48, 48, 54)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.fromOffset(46, 26)
        btn.Position = UDim2.new(1, -58, 0, 10)
        btn.BackgroundColor3 = state and T.Accent or off
        btn.BorderSizePixel = 0
        btn.Text = ""
        btn.AutoButtonColor = false
        btn.Parent = c
        corner(btn, UDim.new(1, 0))
        local kOn, kOff = UDim2.new(1, -23, 0.5, 0), UDim2.new(0, 3, 0.5, 0)
        local knob = Instance.new("Frame")
        knob.Size = UDim2.fromOffset(20, 20)
        knob.Position = state and kOn or kOff
        knob.AnchorPoint = Vector2.new(0, 0.5)
        knob.BackgroundColor3 = Color3.new(1, 1, 1)
        knob.BorderSizePixel = 0
        knob.Parent = btn
        corner(knob, UDim.new(1, 0))
        local function upd()
            tween(btn, {BackgroundColor3 = state and T.Accent or off}, 0.18)
            tween(knob, {Position = state and kOn or kOff}, 0.18, Enum.EasingStyle.Back)
        end
        btn.MouseButton1Click:Connect(function()
            state = not state; upd()
            if item.cb then pcall(item.cb, state) end
        end)
        upd()
    end
    return grid
end

