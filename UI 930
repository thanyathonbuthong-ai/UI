function Library:SliderRow(page, title, subtext, min, max, def, cb)
    local T = self.Theme
    local c = Instance.new("Frame")
    c.Size = UDim2.new(1, -10, 0, subtext and 68 or 56)
    c.BackgroundColor3 = T.BgCard
    c.BorderSizePixel = 0
    c.Parent = page
    corner(c, 10)
    stroke(c, T.Stroke, 1, 0.4)
    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, -110, 0, 16)
    lbl.Position = UDim2.new(0, 14, 0, 8)
    lbl.Text = title
    lbl.TextColor3 = T.Text
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = c
    if subtext then
        local d = Instance.new("TextLabel")
        d.BackgroundTransparency = 1
        d.Size = UDim2.new(1, -110, 0, 12)
        d.Position = UDim2.new(0, 14, 0, 24)
        d.Text = subtext
        d.TextColor3 = T.TextFaint
        d.Font = Enum.Font.Gotham
        d.TextSize = 9
        d.TextXAlignment = Enum.TextXAlignment.Left
        d.Parent = c
    end
    local vb = Instance.new("TextBox")
    vb.Size = UDim2.fromOffset(80, 22)
    vb.Position = UDim2.new(1, -94, 0, 8)
    vb.BackgroundColor3 = T.BgInput
    vb.BorderSizePixel = 0
    vb.Text = tostring(def)
    vb.TextColor3 = T.AccentHi
    vb.Font = Enum.Font.GothamBold
    vb.TextSize = 11
    vb.ClearTextOnFocus = false
    vb.Parent = c
    corner(vb, 6)
    local trackY = subtext and 44 or 38
    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -28, 0, 6)
    track.Position = UDim2.new(0, 14, 0, trackY)
    track.BackgroundColor3 = Color3.fromRGB(44, 44, 50)
    track.BorderSizePixel = 0
    track.Parent = c
    corner(track, UDim.new(1, 0))
    local range = max - min
    local function pct(v) if range == 0 then return 0 end return (v - min) / range end
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(pct(def), 0, 1, 0)
    fill.BackgroundColor3 = T.Accent
    fill.BorderSizePixel = 0
    fill.Parent = track
    corner(fill, UDim.new(1, 0))
    local hnd = Instance.new("Frame")
    hnd.Size = UDim2.fromOffset(20, 20)
    hnd.Position = UDim2.new(pct(def), 0, 0.5, 0)
    hnd.AnchorPoint = Vector2.new(0.5, 0.5)
    hnd.BackgroundColor3 = Color3.new(1, 1, 1)
    hnd.BorderSizePixel = 0
    hnd.Parent = track
    corner(hnd, UDim.new(1, 0))
    local drag = false
    local cur = def
    local function apply(v)
        cur = v
        tween(fill, {Size = UDim2.new(pct(v), 0, 1, 0)}, 0.1)
        tween(hnd, {Position = UDim2.new(pct(v), 0, 0.5, 0)}, 0.1)
        vb.Text = tostring(v)
        if cb then pcall(cb, v) end
    end
    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = true
            local ax, aw = track.AbsolutePosition.X, track.AbsoluteSize.X
            if aw > 0 then
                local t = math.clamp((i.Position.X - ax) / aw, 0, 1)
                apply(math.floor((min + range * t) * 100 + 0.5) / 100)
            end
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and i.UserInputType == Enum.UserInputType.MouseMovement then
            local ax, aw = track.AbsolutePosition.X, track.AbsoluteSize.X
            if aw > 0 then
                local t = math.clamp((i.Position.X - ax) / aw, 0, 1)
                apply(math.floor((min + range * t) * 100 + 0.5) / 100)
            end
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end
    end)
    vb.FocusLost:Connect(function()
        local v = tonumber(vb.Text)
        if v then apply(math.clamp(v, min, max)) else vb.Text = tostring(cur) end
    end)
    if cb then pcall(cb, def) end
    return c
end

