-- ─────────────────────────────────────────────────────────────
--  AddTab(name, icon) → page object (a ScrollingFrame + helpers)
-- ─────────────────────────────────────────────────────────────
function Library:AddTab(name, icon)
    local T = self.Theme
    local idx = #self.TabButtons + 1
    -- 44px minimum height keeps this a comfortable touch target on phones
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, self.Compact and 44 or 40)
    btn.BackgroundColor3 = T.BgCard
    btn.BackgroundTransparency = 1
    btn.BorderSizePixel = 0
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.LayoutOrder = idx
    btn.Parent = self._TabHolder
    corner(btn, 10)
    local il = Instance.new("TextLabel")
    il.BackgroundTransparency = 1
    il.Text = icon or ""
    il.TextColor3 = T.TextDim
    il.Font = Enum.Font.GothamBold
    il.Parent = btn
    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = T.TextDim
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = btn
    if self.Compact then
        -- icon-only rail: big centered icon, no label
        il.Size = UDim2.fromOffset(22, 22)
        il.Position = UDim2.new(0.5, 0, 0.5, 0)
        il.AnchorPoint = Vector2.new(0.5, 0.5)
        il.TextSize = 17
        lbl.Visible = false
    else
        il.Size = UDim2.fromOffset(20, 20)
        il.Position = UDim2.new(0, 12, 0.5, 0)
        il.AnchorPoint = Vector2.new(0, 0.5)
        il.TextSize = 15
        lbl.Size = UDim2.new(1, -46, 1, 0)
        lbl.Position = UDim2.new(0, 38, 0, 0)
        lbl.Text = name
    end
    btn.MouseEnter:Connect(function()
        if self.Pages[name] and self.Pages[name].Visible then return end
        tween(btn, {BackgroundTransparency = 0.7}, 0.12)
    end)
    btn.MouseLeave:Connect(function()
        if self.Pages[name] and self.Pages[name].Visible then return end
        tween(btn, {BackgroundTransparency = 1}, 0.12)
    end)
    btn.MouseButton1Click:Connect(function() self:SwitchTo(name) end)
    self.TabButtons[name] = {btn = btn, lbl = lbl, icon = il}

    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.CanvasSize = UDim2.new(0, 0, 0, 4000)
    page.ScrollBarThickness = 5
    page.ScrollBarImageColor3 = T.Accent
    page.ScrollingDirection = Enum.ScrollingDirection.Y
    page.Visible = false
    page.Parent = self._PageHolder
    vlist(page, 8)
    local pp = Instance.new("UIPadding")
    pp.PaddingRight = UDim.new(0, 10)
    pp.Parent = page
    self.Pages[name] = page

    -- first tab added becomes active by default
    if idx == 1 then
        page.Visible = true
        self._HeaderTitle.Text = name
        tween(btn, {BackgroundTransparency = 0, BackgroundColor3 = T.BgCardHi}, 0.001)
        lbl.TextColor3 = T.AccentHi
        il.TextColor3 = T.AccentHi
    end

    return page
end

function Library:SwitchTo(name)
    local T = self.Theme
    for n, p in pairs(self.Pages) do
        if n == name then
            p.Visible = true
            p.Position = UDim2.new(0, 24, 0, 0)
            tween(p, {Position = UDim2.new(0, 0, 0, 0)}, 0.28, Enum.EasingStyle.Quart)
        else
            p.Visible = false
        end
    end
    self._HeaderTitle.Text = name
    self._HeaderTitle.TextTransparency = 1
    tween(self._HeaderTitle, {TextTransparency = 0}, 0.25)
    for n, t in pairs(self.TabButtons) do
        if n == name then
            tween(t.btn, {BackgroundTransparency = 0, BackgroundColor3 = T.BgCardHi}, 0.15)
            t.lbl.TextColor3 = T.AccentHi
            t.icon.TextColor3 = T.AccentHi
        else
            tween(t.btn, {BackgroundTransparency = 1}, 0.15)
            t.lbl.TextColor3 = T.TextDim
            t.icon.TextColor3 = T.TextDim
        end
    end
end

