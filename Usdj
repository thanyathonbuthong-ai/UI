		-- Slider (พร้อม toggle ถ้าต้องการ + กล่องใส่ตัวเลข) -------------------------
		function Tab:Slider(o)
			o = o or {}
			local minV, maxV = o.Min or 0, o.Max or 100
			local defV = math.clamp(o.Default or minV, minV, maxV)
			local hasToggle = (o.Toggleable == true)

			local container = Create("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, ZIndex = 200, Parent = page })
			local topRow = Create("Frame", { Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, ZIndex = 200, Parent = container })
			Create("TextLabel", {
				Size = UDim2.new(1, -50, 1, 0), BackgroundTransparency = 1, Text = o.Name or "Slider",
				Font = Theme.Font, TextSize = 12, TextColor3 = Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 201, Parent = topRow,
			})

			local state = (o.ToggleDefault == true)
			local ball, toggleBtn
			if hasToggle then
				local toggle = Create("Frame", {
					Size = UDim2.new(0, 28, 0, 12), Position = UDim2.new(1, -44, 0.5, -6),
					BackgroundColor3 = Theme.ToggleBg, BorderSizePixel = 0, ZIndex = 202, Parent = topRow,
				})
				Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = toggle })
				ball = Create("Frame", {
					Size = UDim2.new(0, 8, 0, 8), Position = UDim2.new(0, 2, 0.5, -4),
					BackgroundColor3 = Theme.BallOff, BorderSizePixel = 0, ZIndex = 203, Parent = toggle,
				})
				Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = ball })
				local function UpdateToggle()
					if state then
						TweenService:Create(ball, TWEEN_TOGGLE, { Position = UDim2.new(0, 18, 0.5, -4), BackgroundColor3 = Theme.Accent }):Play()
					else
						TweenService:Create(ball, TWEEN_TOGGLE, { Position = UDim2.new(0, 2, 0.5, -4), BackgroundColor3 = Theme.BallOff }):Play()
					end
					if o.ToggleCallback then local s = state; task.delay(0, function() pcall(o.ToggleCallback, s) end) end
				end
				UpdateToggle()
				toggleBtn = Create("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", ZIndex = 204, Parent = toggle })
				toggleBtn.MouseButton1Click:Connect(function() state = not state; UpdateToggle() end)
				container._UpdateToggle = UpdateToggle
			end

			-- Bar + Thumb ------------------------------------------------------------
			local bar = Create("Frame", {
				Size = UDim2.new(1, -70, 0, 8), Position = UDim2.new(0, 0, 0, 24),
				BackgroundColor3 = Theme.ToggleBg, BorderSizePixel = 0, ZIndex = 201, Parent = container,
			})
			Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = bar })
			local pct0 = (maxV > minV) and ((defV - minV) / (maxV - minV)) or 0
			local thumb = Create("Frame", {
				Size = UDim2.new(0, 10, 0, 10), Position = UDim2.new(pct0, -5, 0.5, -5),
				BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, ZIndex = 202, Parent = bar,
			})
			Create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = thumb })
			local valueBox = Create("TextBox", {
				Size = UDim2.new(0, 52, 0, 14), Position = UDim2.new(1, -58, 0, 21),
				BackgroundColor3 = Theme.ValueBox, BorderSizePixel = 0, Text = FormatNum(defV),
				Font = Theme.FontBold, TextSize = 10, TextColor3 = Theme.White,
				TextXAlignment = Enum.TextXAlignment.Center, ClearTextOnFocus = true, ZIndex = 201, Parent = container,
			})

			local currentValue = defV
			local dragging = false
			local lastCb, pending = 0, nil
			local function Update(value, forceCb)
				value = math.clamp(math.floor(value + 0.5), minV, maxV)
				currentValue = value
				local p = (maxV > minV) and ((value - minV) / (maxV - minV)) or 0
				thumb.Position = UDim2.new(p, -5, 0.5, -5)
				valueBox.Text = FormatNum(value)
				if not o.Callback then return end
				local now = tick()
				if forceCb or (now - lastCb) >= 0.12 then
					lastCb = now; pending = nil
					local v = value; task.delay(0, function() pcall(o.Callback, v) end)
				else
					pending = value
				end
			end
			valueBox.FocusLost:Connect(function()
				local cleaned = valueBox.Text:gsub(",", ""):gsub("%s", "")
				local num = tonumber(cleaned)
				if num then Update(num, true) else valueBox.Text = FormatNum(currentValue) end
			end)
			bar.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					-- อัปเดตทันทีตอนกด
					local pos = (UserInputService:GetMouseLocation().X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X
					Update(minV + pos * (maxV - minV), false)
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = false
					if pending ~= nil then
						local v = pending; pending = nil
						if o.Callback then task.delay(0, function() pcall(o.Callback, v) end) end
					end
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					local pos = (input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X
					Update(minV + pos * (maxV - minV), false)
				end
			end)

			return {
				Set = function(_, v) Update(tonumber(v) or defV, true) end,
				Get = function() return currentValue end,
				SetState = function(_, v) if hasToggle then state = (v == true); container._UpdateToggle() end end,
				GetState = function() return state end,
				Instance = container,
			}
		end

		-- Dropdown (popup สีเข้มเหมือนเดิม) ----------------------------------------
		function Tab:Dropdown(o)
			o = o or {}
			local options = o.Options or {}
			local selected = o.Default or (options[1] or "")
			local row = Create("TextButton", {
				Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Text = "",
				AutoButtonColor = false, ZIndex = 200, Parent = page,
			})
			Create("TextLabel", {
				Size = UDim2.new(1, -50, 1, 0), BackgroundTransparency = 1, Text = o.Name or "Select",
				Font = Theme.Font, TextSize = 12, TextColor3 = Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 201, Parent = row,
			})
			local selectLabel = Create("TextButton", {
				Size = UDim2.new(0, o.Width or 70, 0, 14), Position = UDim2.new(1, -(o.Width or 70) - 8, 0.5, -7),
				BackgroundColor3 = Theme.ValueBox, BorderSizePixel = 0, Text = tostring(selected),
				Font = Theme.FontBold, TextSize = 11, TextColor3 = Theme.White,
				AutoButtonColor = false, ZIndex = 202, Parent = row,
			})
			-- Dropdown popup (สร้างครั้งเดียว แล้วซ่อน/แสดง)
			local dd = Create("ScrollingFrame", {
				Size = UDim2.new(0, o.Width or 70, 0, 0),
				BackgroundColor3 = Theme.DropdownBg, BorderSizePixel = 0, Visible = false,
				ScrollBarThickness = 4, CanvasSize = UDim2.new(0, 0, 0, 0),
				AutomaticCanvasSize = Enum.AutomaticSize.Y, ClipsDescendants = true,
				ZIndex = 60, Parent = Main,
			})
			Create("UIListLayout", { Padding = UDim.new(0, 2), Parent = dd })
			local optButtons = {}
			local function refresh()
				for _, b in pairs(optButtons) do
					b.BackgroundColor3 = (tostring(b.Text) == tostring(selected)) and Theme.OptionSelected or Theme.OptionNormal
				end
			end
			for _, name in ipairs(options) do
				local b = Create("TextButton", {
					Size = UDim2.new(1, 0, 0, 20),
					BackgroundColor3 = (tostring(name) == tostring(selected)) and Theme.OptionSelected or Theme.OptionNormal,
					Text = tostring(name), TextColor3 = Theme.White, TextSize = 10,
					Font = Theme.FontBold, TextXAlignment = Enum.TextXAlignment.Center,
					ZIndex = 61, BorderSizePixel = 0, AutoButtonColor = false, Parent = dd,
				})
				b.MouseButton1Click:Connect(function()
					selected = name
					selectLabel.Text = tostring(name)
					refresh()
					dd.Visible = false
					table.clear(self.OpenDropdowns)
					if o.Callback then task.delay(0, function() pcall(o.Callback, name) end) end
				end)
				optButtons[name] = b
			end
			local function toggle()
				if dd.Visible then
					dd.Visible = false
					self.OpenDropdowns[dd] = nil
					return
				end
				CloseAllDropdowns()
				local absPos, absSize = selectLabel.AbsolutePosition, selectLabel.AbsoluteSize
				local mainAbs, mainSize = Main.AbsolutePosition, Main.AbsoluteSize
				local h = #options * 20 + (#options - 1) * 2
				local y = absPos.Y - mainAbs.Y + absSize.Y + 2
				if y + h > mainSize.Y - 8 then y = math.max(8, mainSize.Y - h - 8) end
				dd.Size = UDim2.new(0, math.floor(absSize.X), 0, math.min(h, 120))
				dd.Position = UDim2.new(0, absPos.X - mainAbs.X, 0, y)
				dd.Visible = true
				self.OpenDropdowns[dd] = dd
				self._dropIgnoreUntil = tick() + 0.25 -- ป้องกัน handler คลิกข้างนอกปิดทันที
				refresh()
			end
			row.MouseButton1Click:Connect(toggle)
			selectLabel.MouseButton1Click:Connect(toggle)
			return {
				Set = function(_, v)
					selected = v
					selectLabel.Text = tostring(v)
					refresh()
					if o.Callback then pcall(o.Callback, v) end
				end,
				Get = function() return selected end,
				Instance = row,
			}
		end

