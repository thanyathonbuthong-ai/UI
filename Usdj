--[[
  Color Picker popup  (เหมือนเดิม: ขาว 230x185, 12 สี, Save/Cancel)
  parent = Main frame, anchor = จุดที่ให้ popup โผล่ (ไม่จำเป็น ตรงกลางเสมอ)
]]
local function OpenColorPicker(menuFrame, defaultColor, onSave)
	-- ลบ color menu เก่าถ้ามี
	for _, c in pairs(menuFrame:GetChildren()) do
		if c.Name == "ColorMenu" then c:Destroy() end
	end
	local selectedColor = defaultColor
	local frame = Create("Frame", {
		Name = "ColorMenu",
		Size = UDim2.new(0, 230, 0, 185),
		Position = UDim2.new(0.5, -115, 0.5, -92),
		BackgroundColor3 = Color3.fromRGB(28, 28, 32),
		BorderSizePixel = 0,
		ZIndex = 500,
		Parent = menuFrame,
	})
	Create("UIStroke", { Color = Color3.fromRGB(70, 70, 75), Thickness = 1, Parent = frame })
	Create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 28),
		BackgroundColor3 = Color3.fromRGB(22, 22, 25),
		BorderSizePixel = 0,
		Text = "Pick a Color",
		TextColor3 = Color3.fromRGB(235, 235, 235),
		Font = Theme.FontBold,
		TextSize = 15,
		ZIndex = 501,
		Parent = frame,
	})
	local colors = {
		Color3.fromRGB(255, 0, 0), Color3.fromRGB(255, 128, 0), Color3.fromRGB(255, 255, 0),
		Color3.fromRGB(0, 255, 0), Color3.fromHex("#00FAFF"), Color3.fromRGB(80, 160, 255),
		Color3.fromRGB(200, 80, 255), Color3.fromRGB(255, 255, 255), Color3.fromRGB(0, 0, 0),
		Color3.fromRGB(120, 120, 120), Color3.fromRGB(255, 105, 180), Color3.fromRGB(255, 20, 147),
	}
	local startX, startY, spacing = 19, 36, 34
	local selectedStroke
	for i, color in ipairs(colors) do
		local btn = Create("TextButton", {
			Size = UDim2.new(0, 30, 0, 30),
			Position = UDim2.new(0, startX + ((i - 1) % 6) * spacing, 0, startY + math.floor((i - 1) / 6) * 36),
			BackgroundColor3 = color,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 501,
			Parent = frame,
		})
		local stroke = Create("UIStroke", { Thickness = 2, Color = Color3.fromRGB(50, 50, 50), Parent = btn })
		if color == defaultColor then
			selectedStroke = stroke
			stroke.Color = Color3.fromRGB(30, 30, 30)
			stroke.Thickness = 3
		end
		btn.MouseButton1Click:Connect(function()
			selectedColor = color
			if selectedStroke then selectedStroke.Color = Color3.fromRGB(50, 50, 50); selectedStroke.Thickness = 2 end
			selectedStroke = stroke
			stroke.Color = Color3.fromRGB(30, 30, 30); stroke.Thickness = 3
		end)
	end
	local save = Create("TextButton", {
		Size = UDim2.new(0, 90, 0, 28),
		Position = UDim2.new(0, 20, 1, -38),
		Text = "Save",
		Font = Theme.FontBold,
		TextSize = 13,
		BackgroundColor3 = Color3.fromRGB(0, 120, 255),
		TextColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = false,
		ZIndex = 501,
		Parent = frame,
	})
	local cancel = Create("TextButton", {
		Size = UDim2.new(0, 90, 0, 28),
		Position = UDim2.new(1, -110, 1, -38),
		Text = "Cancel",
		Font = Theme.FontBold,
		TextSize = 13,
		BackgroundColor3 = Color3.fromRGB(55, 55, 60),
		TextColor3 = Color3.fromRGB(235, 235, 235),
		AutoButtonColor = false,
		ZIndex = 501,
		Parent = frame,
	})
	save.MouseButton1Click:Connect(function()
		if onSave then pcall(onSave, selectedColor) end
		frame:Destroy()
	end)
	cancel.MouseButton1Click:Connect(function() frame:Destroy() end)
	return frame
end

--[[
