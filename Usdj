			Size = UDim2.new(0, 22, 0, 22),
			Position = UDim2.new(1, -76, 0.5, -11),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Image = assets.Discord,
			ImageColor3 = Theme.White,
			ScaleType = Enum.ScaleType.Fit,
			AutoButtonColor = true,
			ZIndex = 40,
			Parent = Header,
		})
		dcBtn.MouseButton1Click:Connect(function()
			pcall(function()
				if setclipboard then setclipboard(opts.DiscordLink)
				elseif toclipboard then toclipboard(opts.DiscordLink)
				elseif Clipboard and Clipboard.set then Clipboard.set(opts.DiscordLink)
				end
			end)
			self:Notify("Discord link copied")
		end)
	end

	-- Min / Close ---------------------------------------------------------------
	local MinBtn = Create("TextButton", {
		Size = UDim2.new(0, 22, 0, 22),
		Position = UDim2.new(1, -46, 0.5, -11),
		BackgroundTransparency = 1,
		Text = "-",
		Font = Theme.FontBold,
		TextSize = 18,
		TextColor3 = Theme.Red,
		ZIndex = 31,
		Parent = Header,
	})
	local CloseBtn = Create("TextButton", {
		Size = UDim2.new(0, 22, 0, 22),
		Position = UDim2.new(1, -22, 0.5, -11),
		BackgroundTransparency = 1,
		Text = "x",
		Font = Theme.FontBold,
		TextSize = 18,
		TextColor3 = Theme.Red,
		ZIndex = 31,
		Parent = Header,
	})
	MinBtn.MouseButton1Click:Connect(function() Main.Visible = false end)
	CloseBtn.MouseButton1Click:Connect(function()
		ScreenGui:Destroy()
		if self.OnClose then pcall(self.OnClose) end
	end)

	-- เปิด/ปิดเมนูด้วย OpenBtn ---------------------------------------------------
	MakeDraggable(OpenBtn, function()
		Main.Visible = not Main.Visible
	end)

	-- พิมพ์ลัดเปิด/ปิด (optional) ------------------------------------------------
	if opts.ToggleKey then
		UserInputService.InputBegan:Connect(function(input, gpe)
			if gpe then return end
			if input.KeyCode == opts.ToggleKey then
				Main.Visible = not Main.Visible
			end
		end)
	end

	-- TabsFrame (คอลัมน์ซ้าย) ----------------------------------------------------
	local TabsFrame = Create("Frame", {
		Size = UDim2.new(0, 70, 1, -50),
		Position = UDim2.new(0, 18, 0, 40),
		BackgroundTransparency = 1,
		ZIndex = 30,
		Parent = Main,
	})
	Create("UIListLayout", {
		Padding = UDim.new(0, 5),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = TabsFrame,
	})
	self.TabsFrame = TabsFrame

	-- Content (แถบเลื่อนด้านขวา) -------------------------------------------------
	local Content = Create("ScrollingFrame", {
		Size = UDim2.new(0, 400, 1, -52),
		Position = UDim2.new(0, 90, 0, 40),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ClipsDescendants = true,
		ZIndex = 30,
		Parent = Main,
	})
	Create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = Content })
	Create("UIPadding", { PaddingRight = UDim.new(0, 16), PaddingBottom = UDim.new(0, 12), Parent = Content })
	self.Content = Content

	-- ปิด dropdown ตอนเลื่อน / เปลี่ยน tab ---------------------------------------
	local function CloseAllDropdowns()
		for _, dd in pairs(self.OpenDropdowns) do
			pcall(function() dd.Visible = false end)
		end
		table.clear(self.OpenDropdowns)
	end
	self.CloseAllDropdowns = CloseAllDropdowns
	Content:GetPropertyChangedSignal("CanvasPosition"):Connect(CloseAllDropdowns)

	-- ปิด dropdown ตอนคลิกข้างนอก ------------------------------------------------
	UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		task.delay(0.12, function()
			if self._dropIgnoreUntil and tick() < self._dropIgnoreUntil then return end
			local pos = input.Position
			local anyOpen = false
			for _, dd in pairs(self.OpenDropdowns) do if dd.Visible then anyOpen = true end end
			if not anyOpen then return end
			for _, dd in pairs(self.OpenDropdowns) do
				if PointInside(dd, pos.X, pos.Y) then return end
			end
			CloseAllDropdowns()
		end)
	end)

	-- สร้าง Tab ------------------------------------------------------------------
	local tabOrder = 0
	function self:Tab(name)
		tabOrder = tabOrder + 1
		local btn = Create("TextButton", {
			Size = UDim2.new(1, 0, 0, 20),
			BackgroundTransparency = 1,
			Text = name,
			Font = Theme.Font,
			TextSize = 12,
			TextColor3 = Theme.TextDim,
			TextXAlignment = Enum.TextXAlignment.Center,
			LayoutOrder = tabOrder,
			ZIndex = 32,
			Parent = TabsFrame,
		})
		self.TabButtons[name] = btn

		local page = Create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			Visible = (tabOrder == 1),
			ZIndex = 31,
			Parent = Content,
		})
		Create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = page })
		self.Pages[name] = page

		if tabOrder == 1 then btn.TextColor3 = Theme.TextSelected end

		btn.MouseButton1Click:Connect(function()
			for _, b in pairs(self.TabButtons) do b.TextColor3 = Theme.TextDim end
			btn.TextColor3 = Theme.TextSelected
			for n, p in pairs(self.Pages) do p.Visible = (n == name) end
			pcall(function() Content.CanvasPosition = Vector2.new(0, 0) end)
			CloseAllDropdowns()
		end)

		-- Object ของแต่ละ Tab ที่จะ return ออกไป (มี method สร้าง element) --------
		local Tab = {}
		Tab.Page = page
		Tab.Window = self

		-- Toggle (ธรรมดา) ---------------------------------------------------------
		function Tab:Toggle(o)
			o = o or {}
