	Create("UIStroke", { Color = Color3.fromRGB(60, 60, 65), Thickness = 1, Transparency = 0.3, Parent = bgFallback })

	-- Header (ลากหน้าต่างได้ + ชื่อ + Discord + Min + Close) --------------------
	local Header = Create("Frame", {
		Size = UDim2.new(1, -50, 0, 26),
		Position = UDim2.new(0, 32, 0, 8),
		BackgroundTransparency = 1,
		ZIndex = 30,
		Parent = Main,
	})
	MakeDraggable(Header) -- ลากหน้าต่างจาก header เท่านั้น (ป้องกันแย่งการคลิก slider/toggle)

	Create("TextLabel", {
		Size = UDim2.new(0, 160, 1, 0),
		BackgroundTransparency = 1,
		Text = opts.Name or "Hub",
		Font = Theme.FontBold,
		TextSize = 15,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 31,
		Parent = Header,
	})

	-- Notify label (ข้อความลอย เช่น "Discord link copied") ----------------------
	local NotifyLabel = Create("TextLabel", {
		Size = UDim2.new(0, 220, 0, 20),
		Position = UDim2.new(0.5, -110, 0, 8),
		BackgroundTransparency = 1,
		Text = "",
		Font = Theme.FontBold,
		TextSize = 13,
		TextColor3 = Theme.White,
		TextTransparency = 1,
		TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
		TextStrokeTransparency = 0,
		ZIndex = 900,
		Parent = ScreenGui,
	})
	function self:Notify(text, duration)
		NotifyLabel.Text = tostring(text)
		NotifyLabel.TextTransparency = 0
		TweenService:Create(NotifyLabel, TweenInfo.new(0.2), { TextTransparency = 0 }):Play()
		task.delay(duration or 2, function()
			if NotifyLabel then
				TweenService:Create(NotifyLabel, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
			end
		end)
	end

	-- Discord button (optional) -------------------------------------------------
	if opts.DiscordLink then
		local dcCircle = Create("Frame", {
			Size = UDim2.new(0, 26, 0, 26),
			Position = UDim2.new(1, -78, 0.5, -13),
			BackgroundColor3 = Color3.fromRGB(0, 0, 0),
			BackgroundTransparency = 0.35,
			BorderSizePixel = 0,
			ZIndex = 34,
			Parent = Header,
