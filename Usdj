	-- Main Frame ---------------------------------------------------------------
	local Main = Create("Frame", {
		Name = "Main",
		Size = opts.Size or UDim2.new(0, 500, 0, 295),
		Position = opts.Position or UDim2.new(0.5, -250, 0.5, -147),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = false,
		ClipsDescendants = true,
		ZIndex = 20,
		Parent = ScreenGui,
	})
	self.Main = Main

	-- พื้นหลัง: สีดำ (Dark Theme) — Frame มน + ขอบบาง (ไม่ใช้รูปภาพธีมสว่างเดิม)
