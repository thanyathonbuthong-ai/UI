		-- Keybind (คลิกแล้วรอปุ่มถัดไป) ---------------------------------------------
		function Tab:Keybind(o)
			o = o or {}
			local currentKey = o.Default -- Enum.KeyCode หรือ nil
			local function keyName(k)
				if not k then return "None" end
				return tostring(k):gsub("Enum%.KeyCode%.", "")
			end
			local row = Create("Frame", { Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, ZIndex = 200, Parent = page })
			Create("TextLabel", {
				Size = UDim2.new(1, -50, 1, 0), BackgroundTransparency = 1, Text = o.Name or "Keybind",
				Font = Theme.Font, TextSize = 12, TextColor3 = Theme.Text,
				TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 201, Parent = row,
			})
			local keyBtn = Create("TextButton", {
				Size = UDim2.new(0, 70, 0, 14), Position = UDim2.new(1, -78, 0.5, -7),
				BackgroundColor3 = Theme.ValueBox, BorderSizePixel = 0, Text = keyName(currentKey),
				Font = Theme.FontBold, TextSize = 10, TextColor3 = Theme.White,
				AutoButtonColor = false, ZIndex = 202, Parent = row,
			})
			local listening = false
			local conn
			keyBtn.MouseButton1Click:Connect(function()
				if listening then return end
				listening = true
				keyBtn.Text = "..."
				conn = UserInputService.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.Keyboard then
						if input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Escape then
							currentKey = nil
						else
							currentKey = input.KeyCode
						end
						keyBtn.Text = keyName(currentKey)
						listening = false
						conn:Disconnect()
						if o.Callback then task.delay(0, function() pcall(o.Callback, currentKey) end) end
					end
				end)
			end)
			return {
				Set = function(_, k) currentKey = k; keyBtn.Text = keyName(currentKey) end,
				Get = function() return currentKey end,
				Instance = row,
			}
		end

		-- Toggle (ซ่อน toggle pill ไว้สำหรับ slider ย่อย เหมือน Predict Y/X เดิม) --
		function Tab:HiddenToggleSlider(o)
			local el = self:Slider(o)
			pcall(function()
				for _, ch in pairs(el.Instance:GetDescendants()) do
					if ch:IsA("Frame") and ch.Size.X.Offset == 28 and ch.Size.Y.Offset == 12 then
						ch.Visible = false
					end
				end
			end)
			return el
		end

		self.Tabs[name] = Tab
		return Tab
	end

