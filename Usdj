    Name = "ชื่อหัวข้อ",
    Size = UDim2.new(0,500,0,295),        -- (ค่าเริ่มต้นเหมือนเดิม)
    Position = UDim2.new(0.5,-250,0.5,-147),
    Assets = { OpenButton=..., WindowBackground=..., Discord=... },
