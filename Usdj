--[[
================================================================================
  Supremacy UI Library  (สกัดและ Refactor จากสคริปต์ Supremacy Hub)
--------------------------------------------------------------------------------
  แยกส่วน UI ออกมาจากสคริปต์เดิม ให้กลายเป็น Library ที่เรียกใช้ซ้ำได้
  รักษาโครงสร้างเดิม แต่ปรับเป็น Dark Theme (พื้นหลังสีดำ):
    - หน้าต่างพื้นหลังสีดำ (Frame มน + ขอบบาง)
    - ตัวอักษรสีขาว/เทาอ่อน  Font Gotham
    - Toggle pill สีขาวตอน ON  (ลูกกลิ้งเลื่อนขวา)
    - Slider พร้อมกล่องใส่ตัวเลข  (คั่นหลักพันด้วย ,)
    - Dropdown popup สีเข้ม
    - Color Picker popup ธีมมืด 12 สี พร้อม Save/Cancel
    - Open Button (รูปภาพ) ลากได้  คลิกเปิด/ปิดเมนู
    - Minimize / Close  ปุ่มสีแดง  Discord (ปรับแต่งได้)
    - Header ลากหน้าต่างได้ (เพิ่มเติมจากของเดิม)

  วิธีใช้:
    local Library = loadstring(game:HttpGet("URL ของไฟล์นี้"))()
    local Window = Library:CreateWindow({ Name = "My Hub" })
    local Tab = Window:Tab("AimBot")
    Tab:Toggle({ Name = "Silent Aim", Default = false, Callback = function(v) end })
    Tab:Slider({ Name = "FOV Size", Min = 0, Max = 100, Default = 50, Callback = function(v) end })
    Tab:Dropdown({ Name = "Aim Part", Options = {"Head","Torso","Leg"}, Default = "Head", Callback = function(v) end })
    Tab:ToggleColor({ Name = "ESP Box", Default = false, DefaultColor = Color3.fromHex("#222222"), Callback = function(v) end, ColorCallback = function(c) end })
    Tab:Button({ Name = "Execute", Callback = function() end })
    Tab:Keybind({ Name = "Aim Key", Default = Enum.KeyCode.X, Callback = function(key) end })
    Tab:Label("ข้อความธรรมดา")
    Window:Notify("Hello!")
================================================================================
]]

