            Size = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1,
            LayoutOrder = 2
        }, {
            NewNotification.Title,
            New("UIListLayout", {
                Padding = UDim.new(0, 0),
                SortOrder = Enum.SortOrder.LayoutOrder
            }),
            New("UIPadding", {
                PaddingLeft = UDim.new(0, Pick(12, 10)),
                PaddingRight = UDim.new(0, 0),
                PaddingTop = UDim.new(0, Pick(16, 10)),
                PaddingBottom = UDim.new(0, 0)
            })
        })
    
        NewNotification.Indicator = New("Frame", {
            BackgroundColor3 = Config.Indicator.Color or Color3.fromRGB(42, 38, 9),
            BackgroundTransparency = 1,
            Size = UDim2.new(0, Pick(44, 36), 0, Pick(47, 36)),
            LayoutOrder = 1
        }, {
            New("UICorner", {
                TopLeftRadius = UDim.new(0, 6),
                BottomLeftRadius = UDim.new(0, 6),
                TopRightRadius = UDim.new(0, 0),
