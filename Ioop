        if Camera then
            AddSignal(Camera:GetPropertyChangedSignal("ViewportSize"), function()
                Window:UpdateLayout()
            end)
        end
    
        function Window:ToggleVisibility()
            self.State = not self.State
            if self.State then
                Tween.Plays(Window, {
