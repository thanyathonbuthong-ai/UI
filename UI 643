					task.delay(0.25, function() picker.Visible = false end)
				end
			end)
			local o = {}
			function o:Set(c) color = c; swatch.BackgroundColor3 = c; h, s, v = Color3.toHSV(c) end
			function o:Get() return color end
			function o:SetRainbow(on) setRainbow(on == true) end
			return o
		end

