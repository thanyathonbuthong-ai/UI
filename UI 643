		-- Wind UI style: Section header
		function api:CreateSection(title)
			local card = make("Frame", {
				LayoutOrder = #tab.components + 1,
				Size = UDim2.new(1, 0, 0, mobile and 30 or 26),
				BackgroundTransparency = 1, BorderSizePixel = 0,
			}, parentFrame)
			local l = text(card, tostring(title or ""), 4, 0, 1, card.Size.Y.Offset, mobile and 15 or 14, "accent")
			l.Size = UDim2.new(1, -8, 1, 0)
			l.FontFace = FONT_BOLD
			tab.components[#tab.components + 1] = card
			local o = {}
			function o:Set(v) l.Text = tostring(v) end
			return o
		end

		-- Wind UI style: Banner (inline alert)
		function api:CreateBanner(opts)
			opts = opts or {}
			local textStr = tostring(opts.Text or "Banner")
			local kind = opts.Type or "info"
			local color = kindColor(kind)
			local card = baseCard(mobile and 44 or 38)
			card.BackgroundColor3 = color
			card.BackgroundTransparency = 0.15
			local stripe = frame(card, 0, 0, 4, card.Size.Y.Offset, color, 0)
			local l = text(card, textStr, 14, 0, 1, card.Size.Y.Offset, mobile and 13 or 12, contrastOn(color))
			l.Size = UDim2.new(1, -24, 1, 0)
			l.TextWrapped = true
			local o = {}
			function o:Set(v) l.Text = tostring(v) end
			function o:SetType(t)
				color = kindColor(t)
				card.BackgroundColor3 = color
				stripe.BackgroundColor3 = color
				l.TextColor3 = contrastOn(color)
			end
			return o
		end

		-- Wind UI style: Folder (collapsible group)
		function api:CreateFolder(name)
			name = tostring(name or "Folder")
			local holder = make("Frame", {
				LayoutOrder = #tab.components + 1,
				Size = UDim2.new(1, 0, 0, BTN_H),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				AutomaticSize = Enum.AutomaticSize.Y,
			}, parentFrame)
			local headerCard = make("Frame", {
				Size = UDim2.new(1, 0, 0, BTN_H),
				BackgroundColor3 = "card", BackgroundTransparency = 0, BorderSizePixel = 0,
			}, holder)
			round(headerCard, 8, "stroke")
			local lbl = text(headerCard, name, 14, 0, 200, BTN_H, mobile and 14 or 13, "text")
			lbl.FontFace = FONT_BOLD
			local arrow = make("Frame", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -14, 0.5, 0),
				Size = UDim2.new(0, 10, 0, 10),
				BackgroundTransparency = 1, BorderSizePixel = 0, Rotation = 45,
			}, headerCard)
			make("Frame", { Position = UDim2.new(0,0,0,4), Size = UDim2.new(1,0,0,2), BackgroundColor3 = "muted", BorderSizePixel = 0 }, arrow)
			make("Frame", { Position = UDim2.new(0,4,0,0), Size = UDim2.new(0,2,1,0), BackgroundColor3 = "muted", BorderSizePixel = 0 }, arrow)
			local content = make("Frame", {
				Position = UDim2.new(0, 0, 0, BTN_H + 4),
				Size = UDim2.new(1, 0, 0, 0),
				BackgroundTransparency = 1, BorderSizePixel = 0,
				ClipsDescendants = true,
				AutomaticSize = Enum.AutomaticSize.Y,
			}, holder)
			make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }, content)
			local open = false
			local hit = make("TextButton", {
				Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
				BorderSizePixel = 0, AutoButtonColor = false, Text = "", ZIndex = 5,
			}, headerCard)
			hit.MouseButton1Click:Connect(function()
				open = not open
				if open then
					tween(arrow, 0.2, { Rotation = 225 })
					content.Visible = true
					task.wait(0.05)
					local h = content.UIListLayout.AbsoluteContentSize.Y
					tween(holder, 0.25, { Size = UDim2.new(1, 0, 0, BTN_H + 4 + h) })
				else
					tween(arrow, 0.2, { Rotation = 45 })
					tween(holder, 0.25, { Size = UDim2.new(1, 0, 0, BTN_H) })
					task.delay(0.25, function() content.Visible = false end)
				end
			end)
			tab.components[#tab.components + 1] = holder
			local folderTab = { components = {} }
			local folderApi = buildComponentAPI(folderTab, content)
			folderApi.Name = name
			return folderApi
		end

		return api
	end

	function Window:CreateTab(name, iconImage)
		name = tostring(name or "Tab")
		local order = #tabs + 1
		local isTop = tabStyle == "top"

		local btn = make("TextButton", {
			LayoutOrder = order,
			Size = isTop and UDim2.new(0, 0, 1, -8) or UDim2.new(1, 0, 0, BTN_H),
			AutomaticSize = isTop and Enum.AutomaticSize.X or Enum.AutomaticSize.None,
			BackgroundColor3 = "btn2",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
		}, tabContainer)
		round(btn, 8)
		if isTop then
			make("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14) }, btn)
		end
		if iconImage then
			make("ImageLabel", {
				Name = "TabIcon",
				Position = isTop and UDim2.new(0, 10, 0.5, 0) or UDim2.new(0, 12, 0.5, 0),
				AnchorPoint = Vector2.new(0, 0.5),
				Size = UDim2.new(0, 16, 0, 16),
				BackgroundTransparency = 1,
				Image = iconImage,
				ImageColor3 = "muted",
			}, btn)
		end
		local labelOffset = iconImage and (isTop and 32 or 36) or (isTop and 0 or 14)
		local btnLabel = make("TextLabel", {
			Position = UDim2.new(0, labelOffset, 0, 0),
			Size = isTop and UDim2.new(0, 0, 1, 0) or UDim2.new(0, 130, 0, BTN_H),
			AutomaticSize = isTop and Enum.AutomaticSize.X or Enum.AutomaticSize.None,
			BackgroundTransparency = 1, BorderSizePixel = 0,
			Text = name, TextSize = mobile and 14 or 13, TextColor3 = "muted",
			TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
			FontFace = FONT, TextTruncate = Enum.TextTruncate.AtEnd,
		}, btn)

		local page = make("ScrollingFrame", {
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1, BorderSizePixel = 0,
			ScrollBarThickness = mobile and 4 or 3,
			ScrollBarImageColor3 = C.muted,
			ScrollBarImageTransparency = 0.5,
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(0, 0, 0, 0),
			Visible = false,
		}, contentHolder)
		make("UIPadding", {
			PaddingTop = UDim.new(0, PAD), PaddingBottom = UDim.new(0, 20),
			PaddingLeft = UDim.new(0, PAD), PaddingRight = UDim.new(0, PAD),
		}, page)
		local layout = make("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
		}, page)

		local tab = { name = name, button = btn, btnLabel = btnLabel, page = page, layout = layout, order = order, components = {} }
		tabs[#tabs + 1] = tab

		local compApi = buildComponentAPI(tab, page)
		for k, v in pairs(compApi) do tab[k] = v end

		btn.MouseButton1Click:Connect(function() selectTab(tab) end)
		btn.MouseEnter:Connect(function()
			if currentTab ~= tab then tween(btn, 0.15, { BackgroundTransparency = 0.5 }) end
		end)
		btn.MouseLeave:Connect(function()
			if currentTab ~= tab then tween(btn, 0.15, { BackgroundTransparency = 1 }) end
		end)

		if #tabs == 1 then
			task.defer(function() selectTab(tab) end)
		end

		return tab
	end

	-- Header button actions
	local THEME_ANIM_TIME = 1.2
	themeBtn.MouseButton1Click:Connect(function()
		themeIndex = themeIndex % #THEME_ORDER + 1
		local name = THEME_ORDER[themeIndex]
		applyTheme(name, THEME_ANIM_TIME)
		Library:Notify("Theme: " .. name, "Theme applied.", "info", "moon", 3)
	end)

	local minimized = false
	minBtn.MouseButton1Click:Connect(function()
		minimized = not minimized
		if minimized then
			tween(main, 0.3, { Size = UDim2.new(0, WIN_W, 0, HEADER_H) }, Enum.EasingStyle.Quint)
			tween(body, 0.2, { Size = UDim2.new(1, 0, 0, 0) })
			task.delay(0.2, function() body.Visible = false end)
			tween(minBar, 0.2, { Rotation = 90 })
		else
			body.Visible = true
			tween(main, 0.3, { Size = UDim2.new(0, WIN_W, 0, WIN_H) }, Enum.EasingStyle.Quint)
			tween(body, 0.25, { Size = UDim2.new(1, 0, 1, -HEADER_H) })
			tween(minBar, 0.2, { Rotation = 0 })
		end
	end)

	closeBtn.MouseButton1Click:Connect(function() Window:Destroy() end)

	-- Intro animation
	canvas.BackgroundTransparency = 1
	decorGroup.GroupTransparency = 1
	shadow.ImageTransparency = 1
	main.Size = UDim2.new(0, 60, 0, 60)
	task.spawn(function()
		tween(main, 0.5, { Size = UDim2.new(0, WIN_W, 0, WIN_H) }, Enum.EasingStyle.Quint)
		tween(canvas, 0.4, { BackgroundTransparency = 0 })
		tween(decorGroup, 0.4, { GroupTransparency = 0 })
		tween(shadow, 0.4, { ImageTransparency = 0.6 })
	end)

	function Window:Destroy()
		Library:DismissNotifications()
		if Blur.effect then Blur.effect:Destroy(); Blur.effect = nil end
		root:Destroy()
	end
	function Window:Notify(...) return Library:Notify(...) end
	function Window:SetTheme(name)
		if THEMES[name] then
			themeIndex = table.find(THEME_ORDER, name) or themeIndex
			applyTheme(name, THEME_ANIM_TIME)
		end
	end
	function Window:Toggle()
		root.Enabled = not root.Enabled
	end
	function Window:Show() main.Visible = true; fabVisible = true end
	function Window:Hide() main.Visible = false; fabVisible = false end

	return Window
end

function Library:SetTheme(name)
	if THEMES[name] then applyTheme(name, 1.2) end
end

Library.Images = Images
Library.Themes = THEMES
Library.IsMobile = IS_TOUCH

return Library
