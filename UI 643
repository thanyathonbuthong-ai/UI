		local api = {}
		local function baseCard(height)
			local card = make("Frame", {
				LayoutOrder = #tab.components + 1,
				Size = UDim2.new(1, 0, 0, height),
				BackgroundColor3 = "card",
				BackgroundTransparency = 0,
				BorderSizePixel = 0,
			}, parentFrame)
			round(card, 8, "stroke")
			tab.components[#tab.components + 1] = card
			return card
		end

		function api:CreateButton(opts)
			opts = opts or {}
			local name = tostring(opts.Name or "Button")
			local cb = opts.Callback or function() end
			local btnIcon = opts.Icon
			local card = baseCard(BTN_H)
			local btn = make("TextButton", {
				Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
				BorderSizePixel = 0, AutoButtonColor = false, Text = "",
