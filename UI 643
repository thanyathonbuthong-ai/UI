					local rel = (Vector2.new(input.Position.X, input.Position.Y) - sat.AbsolutePosition) / sat.AbsoluteSize
					s = math.clamp(rel.X, 0, 1)
					v = 1 - math.clamp(rel.Y, 0, 1)
					updateColor()
				elseif draggingHue then
					local rel = (input.Position.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y
					h = 1 - math.clamp(rel, 0, 1)
					updateColor()
				end
			end)
