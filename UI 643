		function api:CreateKeybind(opts)
			opts = opts or {}
			local name = tostring(opts.Name or "Keybind")
			local cb = opts.Callback or function() end
			local key = opts.Default or Enum.KeyCode.Unknown
			local mode = opts.Mode or "Toggle" -- "Toggle" | "Hold" | "Always"
			local modes = { "Toggle", "Hold", "Always" }
			local listening = false
			local active = false
			local card = baseCard(BTN_H)
			text(card, name, 14, 0, 160, BTN_H, mobile and 14 or 13, "text")
			local modeLabel = make("TextLabel", {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -70, 0, 0),
				Size = UDim2.new(0, 50, 0, BTN_H),
				BackgroundTransparency = 1, BorderSizePixel = 0,
				Text = mode, TextSize = 10, TextColor3 = "muted",
				TextXAlignment = Enum.TextXAlignment.Center, FontFace = FONT,
			}, card)
			local keyLabel = make("TextLabel", {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -14, 0, 0),
				Size = UDim2.new(0, 60, 0, BTN_H),
				BackgroundTransparency = 1, BorderSizePixel = 0,
				Text = key.Name, TextSize = 12, TextColor3 = "accent",
				TextXAlignment = Enum.TextXAlignment.Right, FontFace = FONT_BOLD,
			}, card)
			local function fire(state)
				if mode == "Always" then
					if not active then active = true; task.spawn(cb, true) end
					return
				end
				task.spawn(cb, state)
			end
			local conn
			local hit = make("TextButton", {
				Size = UDim2.new(0.6, 0, 1, 0), BackgroundTransparency = 1,
				BorderSizePixel = 0, AutoButtonColor = false, Text = "", ZIndex = 5,
			}, card)
			hit.MouseButton1Click:Connect(function()
				if listening then return end
				listening = true
				keyLabel.Text = "..."
				conn = UserInputService.InputBegan:Connect(function(input, gpe)
					if input.UserInputType == Enum.UserInputType.Keyboard then
						key = input.KeyCode
						keyLabel.Text = key.Name
						listening = false
						conn:Disconnect()
					end
				end)
			end)
			local modeBtn = make("TextButton", {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -70, 0, 0),
				Size = UDim2.new(0, 50, 1, 0),
				BackgroundTransparency = 1, BorderSizePixel = 0,
				AutoButtonColor = false, Text = "", ZIndex = 6,
			}, card)
			modeBtn.MouseButton1Click:Connect(function()
				local idx = table.find(modes, mode) or 1
				mode = modes[idx % #modes + 1]
				modeLabel.Text = mode
				if mode == "Always" then fire(true) end
			end)
			UserInputService.InputBegan:Connect(function(input, gpe)
				if gpe or listening then return end
				if input.KeyCode == key and key ~= Enum.KeyCode.Unknown then
					if mode == "Toggle" then
						active = not active
						fire(active)
					elseif mode == "Hold" then
						fire(true)
					end
				end
			end)
			UserInputService.InputEnded:Connect(function(input, gpe)
				if mode == "Hold" and input.KeyCode == key then
					fire(false)
				end
			end)
			local o = {}
			function o:Set(v) key = v; keyLabel.Text = v.Name end
			function o:Get() return key end
			function o:SetMode(m) mode = m; modeLabel.Text = m end
			return o
		end

