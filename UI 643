				icon(btn, 14, (BTN_H - 16) / 2, "accent", btnIcon)
				lbl.Position = UDim2.new(0, 38, 0, 0)
			end
			icon(btn, -30, (BTN_H - 16) / 2, "accent", Images.SUBMIT)
			btn.MouseEnter:Connect(function() tween(card, 0.15, { BackgroundColor3 = C.btn2Hover }) end)
			btn.MouseLeave:Connect(function() tween(card, 0.15, { BackgroundColor3 = C.card }) end)
			btn.MouseButton1Click:Connect(function() task.spawn(cb) end)
			local o = {}
			function o:Set(v) lbl.Text = tostring(v) end
			return o
		end

		function api:CreateToggle(opts)
			opts = opts or {}
			local name = tostring(opts.Name or "Toggle")
			local cb = opts.Callback or function() end
			local state = opts.Default == true
			local card = baseCard(BTN_H)
