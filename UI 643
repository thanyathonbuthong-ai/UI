				rainbow = on
				rbLabel.Text = on and "Rainbow: ON" or "Rainbow: OFF"
				rbLabel.TextColor3 = on and C.accent or C.muted
				if on then
					if rainbowConn then rainbowConn:Disconnect() end
					rainbowConn = RunService.RenderStepped:Connect(function(dt)
						h = (h + dt * 0.15) % 1
						updateColor()
					end)
				elseif rainbowConn then
					rainbowConn:Disconnect()
					rainbowConn = nil
				end
			end
