		function api:CreateSlider(opts)
			opts = opts or {}
			local name = tostring(opts.Name or "Slider")
			local minV = tonumber(opts.Min) or 0
			local maxV = tonumber(opts.Max) or 100
			local inc = tonumber(opts.Increment) or 1
			local value = tonumber(opts.Default) or minV
			local cb = opts.Callback or function() end
			local card = baseCard(mobile and 58 or 52)
			text(card, name, 14, 6, 200, 16, mobile and 14 or 13, "text")
			local valLabel = make("TextLabel", {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -14, 0, 6),
				Size = UDim2.new(0, 60, 0, 16),
				BackgroundTransparency = 1, BorderSizePixel = 0,
				Text = tostring(value), TextSize = 13, TextColor3 = "muted",
				TextXAlignment = Enum.TextXAlignment.Right, FontFace = FONT,
			}, card)
			local track = make("Frame", {
				Position = UDim2.new(0, 14, 0, mobile and 38 or 32),
				Size = UDim2.new(1, -28, 0, 6),
				BackgroundColor3 = "btn2", BackgroundTransparency = 0, BorderSizePixel = 0,
			}, card)
			round(track, 3)
			local fill = make("Frame", {
				Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = "accent",
				BackgroundTransparency = 0, BorderSizePixel = 0,
			}, track)
			round(fill, 3)
			local function clamp(v) return math.clamp(v, minV, maxV) end
			local function snap(v)
				v = clamp(v)
				if inc > 0 then v = math.floor((v - minV) / inc + 0.5) * inc + minV end
				return clamp(v)
			end
			local function setValue(v, instant)
				value = snap(v)
				local pct = (value - minV) / (maxV - minV)
				if instant then fill.Size = UDim2.new(pct, 0, 1, 0)
				else tween(fill, 0.1, { Size = UDim2.new(pct, 0, 1, 0) }) end
				valLabel.Text = tostring(value)
			end
			setValue(value, true)
			local dragging = false
			local hit = make("TextButton", {
				Position = UDim2.new(0, 14, 0, mobile and 32 or 26),
				Size = UDim2.new(1, -28, 0, 18),
				BackgroundTransparency = 1, BorderSizePixel = 0,
				AutoButtonColor = false, Text = "", ZIndex = 5,
			}, card)
			local function updateFromInput(input)
				local rel = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
				setValue(minV + rel * (maxV - minV))
				task.spawn(cb, value)
			end
			hit.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					updateFromInput(input)
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = false
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					updateFromInput(input)
				end
			end)
			local o = {}
			function o:Set(v) setValue(tonumber(v) or value) end
			function o:Get() return value end
			return o
		end

