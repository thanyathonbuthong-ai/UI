	local function selectTab(tab)
		if switching or currentTab == tab then return end
		switching = true
		if currentTab then
			currentTab.page.Visible = false
			tween(currentTab.button, 0.15, { BackgroundTransparency = 1 })
			tween(currentTab.btnLabel, 0.15, { TextColor3 = C.muted })
			local ic = currentTab.button:FindFirstChild("TabIcon")
			if ic then tween(ic, 0.15, { ImageColor3 = C.muted }) end
		end
		currentTab = tab
		tab.page.Visible = true
		tween(tab.button, 0.15, { BackgroundTransparency = 0 })
		tween(tab.btnLabel, 0.15, { TextColor3 = C.text })
		local ic = tab.button:FindFirstChild("TabIcon")
		if ic then tween(ic, 0.15, { ImageColor3 = C.accent }) end
		task.wait(0.15)
		switching = false
