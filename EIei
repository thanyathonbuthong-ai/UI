-- ── Tween wrapper ──────────────────────────────────────────────────────
local Tween = {}
Tween.__index = Tween

-- Tween:Create(item, tweenInfo?, goal, isRawInstance?)
Tween.Create = function(self, Item, Info, Goal, IsRaw)
	local Instance_ = (IsRaw and Item) or Item.Instance
	Info = Info or TweenInfo.new(Library.Tween.Time, Library.Tween.Style, Library.Tween.Direction)

	local NewTween = {
		Tween = TweenService:Create(Instance_, Info, Goal),
		Info = Info,
		Goal = Goal,
		Item = Instance_,
	}
	NewTween.Tween:Play()
	setmetatable(NewTween, Tween)
	return NewTween
end

Tween.Get = function(self)
	if not self.Tween then
		return
	end
	return self.Tween, self.Info, self.Goal
end

Tween.Pause = function(self)
	if not self.Tween then
		return
	end
	self.Tween:Pause()
end

Tween.Play = function(self)
	if not self.Tween then
		return
	end
	self.Tween:Play()
end

Tween.Clean = function(self)
	if not self.Tween then
		return
	end
	Tween.Pause(self)
end

