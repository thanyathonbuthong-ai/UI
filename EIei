		SortOrder = Enum.SortOrder.LayoutOrder,
	})

	local Debounce = false

	-- SubPage:Turn(bool)
	SubPage.Turn = function(self, Bool)
		if Debounce then
			return
		end

		SubPage.Active = true
		Debounce = true

		if Bool then
			Items_.PageContent.Instance.Visible = true
			Items_.Inactive:ChangeItemTheme({ TextColor3 = "Text", BackgroundColor3 = "Accent" })
			Items_.UIStroke:ChangeItemTheme({ Color = "Light Accent" })
			Items_.Inactive:Tween(nil, { TextTransparency = 0, BackgroundColor3 = Library.Theme.Accent })
			Items_.Shadow:Tween(nil, { ImageTransparency = 0.6 })
			Items_.UIStroke:Tween(nil, { Color = Library.Theme["Light Accent"] })
		else
			Items_.Inactive:ChangeItemTheme({ TextColor3 = "Text", BackgroundColor3 = "Inline" })
			Items_.UIStroke:ChangeItemTheme({ Color = "Border" })
			Items_.Inactive:Tween(nil, { TextTransparency = 0.5, BackgroundColor3 = Library.Theme.Inline })
			Items_.Shadow:Tween(nil, { ImageTransparency = 1 })
			Items_.UIStroke:Tween(nil, { Color = Library.Theme.Border })
		end

		local Descendants = Items_.PageContent.Instance:GetDescendants()
		tinsert(Descendants, Items_.PageContent.Instance)

		local NewTween
		for _, Descendant in Descendants do
			local Properties = Library:GetTransparencyPropertyFromItem(Descendant)
			if Properties then
				if type(Properties) == "table" then
					for _, Property in Properties do
						NewTween = Library:FadeItem(Descendant, Property, Bool, SubPage.Window.FadeSpeed)
					end
				else
					NewTween = Library:FadeItem(Descendant, Properties, Bool, SubPage.Window.FadeSpeed)
				end
			end
		end

		Library:Connect(NewTween.Tween.Completed, function()
			Debounce = false
			Items_.PageContent.Instance.Visible = Bool
		end)
	end

	-- ค้นหา: ซ่อน/แสดง Section ตามข้อความที่พิมพ์ใน Search ของ Page
	if SubPage.Page.Search then
		local function ApplySearch()
			local Query = SubPage.Page.Items.Search.Instance.Text or ""
			local Matches = {}

			for _, SearchItem in pairs(SubPage.SearchItems) do
				local Text = SearchItem.Element.Instance.Text or ""
				if slower(Query) == "" or sfind(slower(Text), slower(Query), 1, true) ~= nil then
					Matches[SearchItem.Section] = true
				end
			end

			local Done = {}
			for _, SearchItem in pairs(SubPage.SearchItems) do
				local Section = SearchItem.Section
				if not Done[Section] then
					Done[Section] = true
					Section:SetVisibility(slower(Query) == "" or Matches[Section] == true)
				end
			end
		end

		Library:Connect(SubPage.Page.Items.Search.Instance:GetPropertyChangedSignal("Text"), ApplySearch)
		ApplySearch()
	end

	Items_.Inactive:Connect("MouseButton1Down", function()
		for _, OtherSubPage in pairs(SubPage.Window.SubPages) do
			OtherSubPage:Turn(OtherSubPage == SubPage)
		end
	end)

	if #SubPage.Window.Pages == 0 then
		SubPage:Turn(true)
	end

	SubPage.Items = Items_
	tinsert(SubPage.Window.SubPages, SubPage)

	return setmetatable(SubPage, Library.Pages)
end

