	end

	local Debounce = false

	Colorpicker.SetOpen = function(self, Bool)
		if Debounce then
			return
		end

		Colorpicker.IsOpen = Bool
		Debounce = true

		if Bool then
			Items_.ColorpickerWindow.Instance.Visible = true
			Items_.ColorpickerWindow.Instance.Position = UDim2new(
				0, Items_.ColorpickerButton.Instance.AbsolutePosition.X + 25,
				0, Items_.ColorpickerButton.Instance.AbsolutePosition.Y + 15
			)
		end

		local Descendants = Items_.ColorpickerWindow.Instance:GetDescendants()
		tinsert(Descendants, Items_.ColorpickerWindow.Instance)

		local NewTween
		for _, Descendant in Descendants do
			local Properties = Library:GetTransparencyPropertyFromItem(Descendant)
			if not Properties then
				continue
			end

			if Colorpicker.IsOpen then
				if not sfind(Descendant.ClassName, "UI") then
					Descendant.ZIndex = 1001
				end
			else
				if not sfind(Descendant.ClassName, "UI") then
					Descendant.ZIndex = 1
				end
			end

			if type(Properties) == "table" then
				for _, Property in Properties do
					NewTween = Library:FadeItem(Descendant, Property, Bool, Colorpicker.Window.FadeSpeed)
				end
			else
				NewTween = Library:FadeItem(Descendant, Properties, Bool, Colorpicker.Window.FadeSpeed)
			end
		end

		Library:Connect(NewTween.Tween.Completed, function()
			Debounce = false
			Items_.ColorpickerWindow.Instance.Visible = Bool
		end)
	end

	Items_.Palette:Connect("InputBegan", function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1 then
			SlidingPalette = true
			Colorpicker:SlidePalette(Input)

			Input.Changed:Connect(function()
				if Input.UserInputState == Enum.UserInputState.End then
					SlidingPalette = false
				end
			end)
		end
	end)

