	-- Dropdown:Set(value | {values}, silent?)
	Dropdown.Set = function(self, Value, Silent)
		if Data.Multi then
			if type(Value) ~= "table" then
				return
			end

			Dropdown.Value = Value
			Library.Flags[Dropdown.Flag] = Dropdown.Value

			for _, Name in Value do
				local Option = Dropdown.Options[Name]
				if not Option then
					return
				end
				Option.Selected = true
				Option:Toggle("Active")
			end

			Items_.Value.Instance.Text = tconcat(Value, ", ")
		else
			if not Dropdown.Options[Value] then
				return
			end

			Dropdown.Options[Value].Selected = true
			Dropdown.Options[Value]:Toggle("Active")
			Dropdown.Value = Dropdown.Options[Value].Name
			Library.Flags[Dropdown.Flag] = Dropdown.Value

			for _, Option in Dropdown.Options do
				if Option ~= Dropdown.Options[Value] then
					Option.Selected = false
					Option:Toggle("Inactive")
				end
			end

			Items_.Value.Instance.Text = Dropdown.Value
		end

		if Data.Callback and not Silent then
			Library:SafeCall(Data.Callback, Dropdown.Value)
		end
	end

	local Debounce = false

	Dropdown.SetOpen = function(self, Bool)
		if Debounce then
			return
		end

		Dropdown.IsOpen = Bool
		Debounce = true

		if Bool then
			Items_.OptionHolder.Instance.Visible = true
		end

		local Descendants = Items_.OptionHolder.Instance:GetDescendants()
		tinsert(Descendants, Items_.OptionHolder.Instance)

		local NewTween
		for _, Descendant in Descendants do
			local Properties = Library:GetTransparencyPropertyFromItem(Descendant)
			if Properties then
				if type(Properties) == "table" then
					for _, Property in Properties do
						NewTween = Library:FadeItem(Descendant, Property, Bool, Dropdown.Window.FadeSpeed)
					end
				else
					NewTween = Library:FadeItem(Descendant, Properties, Bool, Dropdown.Window.FadeSpeed)
				end
			end
		end

		Library:Connect(NewTween.Tween.Completed, function()
			Debounce = false
			Items_.OptionHolder.Instance.Visible = Bool
		end)
	end

	Dropdown.Remove = function(self, Name)
		if Dropdown.Options[Name] then
			Dropdown.Options[Name].Button:Clean()
		end
		Dropdown.Options[Name] = nil
	end

	Dropdown.Refresh = function(self, List)
		for _, Option in Dropdown.Options do
			Dropdown:Remove(Option.Name)
		end
		for _, Name in List do
			Dropdown:Add(Name)
		end
	end

	Dropdown.Add = function(self, Name)
		local Option = {
			Name = Name,
			Selected = false,
		}

		Option.Button = Items:Create("TextButton", {
			Parent = Items_.Holder.Instance,
			FontFace = Library.Font,
			TextColor3 = Color3fromRGB(245, 242, 238),
			TextTransparency = 0.5,
			Text = Name,
			Name = "\0",
			AutoButtonColor = false,
			BorderColor3 = Color3fromRGB(0, 0, 0),
			Size = UDim2new(1, -5, 0, 20),
			BackgroundTransparency = 1,
			TextXAlignment = Enum.TextXAlignment.Left,
			BorderSizePixel = 0,
			ZIndex = 25,
			TextSize = 14,
			BackgroundColor3 = Color3fromRGB(10, 9, 8),
		})
		Option.Button:AddToTheme({ TextColor3 = "Text", BackgroundColor3 = "Background" })

		Items:Create("UICorner", {
			Parent = Option.Button.Instance,
			CornerRadius = UDimnew(0, 4),
		})

		Option.Padding = Items:Create("UIPadding", {
			Parent = Option.Button.Instance,
			PaddingLeft = UDimnew(0, 7),
		})

		Option.Toggle = function(self, State)
			if State == "Active" then
				Option.Button:ChangeItemTheme({ TextColor3 = "Accent" })
				Option.Button:Tween(nil, { TextColor3 = Library.Theme.Accent, BackgroundTransparency = 0, TextTransparency = 0 })
				Option.Padding:Tween(nil, { PaddingLeft = UDimnew(0, 12) })
			else
				Option.Button:ChangeItemTheme({ TextColor3 = "Text" })
				Option.Button:Tween(nil, { TextColor3 = Library.Theme.Text, BackgroundTransparency = 1, TextTransparency = 0.5 })
				Option.Padding:Tween(nil, { PaddingLeft = UDimnew(0, 7) })
			end
		end

		Option.Set = function(self)
			Option.Selected = not Option.Selected

			if Dropdown.Multi then
				local Index = tfind(Dropdown.Value, Option.Name)
				if Index then
					tremove(Dropdown.Value, Index)
				else
					tinsert(Dropdown.Value, Option.Name)
				end

				Library.Flags[Dropdown.Flag] = Dropdown.Value
				Option:Toggle(Index and "Inactive" or "Active")

				Items_.Value.Instance.Text = (#Dropdown.Value > 0 and tconcat(Dropdown.Value, ", ")) or "--"
			else
				if Option.Selected then
					Dropdown.Value = Option.Name
					Option:Toggle("Active")
					Items_.Value.Instance.Text = Option.Name
					Library.Flags[Dropdown.Flag] = Dropdown.Value

					for _, Other in Dropdown.Options do
						if Other ~= Option then
							Other.Selected = false
							Other:Toggle("Inactive")
						end
					end
				else
					Dropdown.Value = nil
					Option:Toggle("Inactive")
					Items_.Value.Instance.Text = "--"
					Library.Flags[Dropdown.Flag] = Dropdown.Value
				end
			end

			if Data.Callback then
				Library:SafeCall(Data.Callback, Dropdown.Value)
			end
		end

		Option.Button:Connect("MouseButton1Down", function()
			Option:Set()
		end)

		Dropdown.Options[Name] = Option
		return Option
	end

	Dropdown.SetVisibility = function(self, Bool)
		Items_.Dropdown.Instance.Visible = Bool
	end

	tinsert(Dropdown.Page.SearchItems, { Name = Dropdown.Name, Element = Items_.Text, Section = Dropdown.Section })

	Items_.RealDropdown:Connect("MouseButton1Down", function()
		Dropdown:SetOpen(not Dropdown.IsOpen)
	end)

	Library:Connect(UserInputService.InputBegan, function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1 and Dropdown.IsOpen and not Debounce
			and not Library:IsMouseOverFrame(Items_.OptionHolder) then
			Dropdown:SetOpen(false)
		end
	end)

	for _, Name in Dropdown.Items do
		Dropdown:Add(Name)
	end

	if Dropdown.Default then
		Dropdown:Set(Dropdown.Default)
	end

	Library.SetFlags[Dropdown.Flag] = function(Value)
		Dropdown:Set(Value)
	end

	Dropdown.Items_ = Items_
	return Dropdown
end

