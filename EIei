	})
	Items_.Value:AddToTheme({ TextColor3 = "Text" })

	Keybind.Get = function()
		return Keybind.Toggled, Keybind.Key
	end

	Keybind.SetVisibility = function(self, Bool)
		Items_.Keybind.Instance.Visible = Bool
	end

	Keybind.Set = function(self, Value)
		if sfind(tostring(Value), "Enum") then
			Keybind.Key = tostring(Value)

			local Name = (Value.Name == "Backspace" and "None") or Value.Name
			local Display = KeyNames[Keybind.Key] or sgsub(Name, "Enum.", "")
			Display = sgsub(Display or "None", "KeyCode.", "")
			Display = sgsub(Display, "UserInputType.", "")
			Display = Display or "None"

			Keybind.Value = Display
			Items_.Value.Instance.Text = Display

			Library.Flags[Keybind.Flag] = { Mode = Keybind.Mode, Key = Keybind.Key, Toggled = Keybind.Toggled }

			if Keybind.Callback then
				Library:SafeCall(Keybind.Callback, Keybind.Toggled)
			end
		elseif tfind({ "Hold", "Toggle", "Always" }, Value) then
			Keybind.Mode = Value
			Keybind:SetMode(Keybind.Mode)

			if Keybind.Callback then
				Library:SafeCall(Keybind.Callback, Keybind.Toggled)
			end
		elseif type(Value) == "table" then
			local KeyValue = (Value.Key == "Backspace" and "None") or Value.Key
			Keybind.Key = tostring(Value.Key)

			if Value.Mode then
				Keybind.Mode = Value.Mode
				Keybind:SetMode(Value.Mode)
			else
				Keybind.Mode = "Toggle"
				Keybind:SetMode("Toggle")
			end

			local Display = KeyNames[Keybind.Key] or sgsub(tostring(KeyValue), "Enum.", "")
			Display = sgsub(Display, "KeyCode.", "")
			Display = sgsub(Display, "UserInputType.", "")

			Keybind.Value = Display
			Items_.Value.Instance.Text = Display

			if Keybind.Callback then
				Library:SafeCall(Keybind.Callback, Keybind.Toggled)
			end
		end

		Keybind.Picking = false
		Items_.Value:ChangeItemTheme({ TextColor3 = "Text" })
		Items_.Value:Tween(nil, { TextColor3 = Library.Theme.Text })
	end

	Keybind.SetMode = function(self, Mode)
		if Keybind.Mode == "Always" then
			Keybind.Toggled = true
		else
			Keybind.Toggled = false
		end

		Library.Flags[Keybind.Flag] = { Mode = Keybind.Mode, Key = Keybind.Key, Toggled = Keybind.Toggled }

		if Keybind.Callback then
			Library:SafeCall(Keybind.Callback, Keybind.Toggled)
		end
	end

	Keybind.Press = function(self, Bool)
		if Keybind.Mode == "Toggle" then
			Keybind.Toggled = not Keybind.Toggled
		elseif Keybind.Mode == "Hold" then
			Keybind.Toggled = Bool
		elseif Keybind.Mode == "Always" then
			Keybind.Toggled = true
		end

		Library.Flags[Keybind.Flag] = { Mode = Keybind.Mode, Key = Keybind.Key, Toggled = Keybind.Toggled }

		if Keybind.Callback then
			Library:SafeCall(Keybind.Callback, Keybind.Toggled)
		end
	end

	tinsert(Keybind.Page.SearchItems, { Name = Keybind.Name, Element = Items_.Text, Section = Keybind.Section })

	Items_.RealKeybind:Connect("MouseButton1Click", function()
		if Keybind.Picking then
			return
		end

		Keybind.Picking = true
		Items_.Value:ChangeItemTheme({ TextColor3 = "Accent" })
		Items_.Value:Tween(nil, { TextColor3 = Library.Theme.Accent })

		local Connection
		Connection = UserInputService.InputBegan:Connect(function(Input)
			if Input.UserInputType == Enum.UserInputType.Keyboard then
				Keybind:Set(Input.KeyCode)
			else
				Keybind:Set(Input.UserInputType)
			end

			Connection:Disconnect()
			Connection = nil
		end)
	end)

	Library:Connect(UserInputService.InputBegan, function(Input)
		if tostring(Input.KeyCode) == Keybind.Key or tostring(Input.UserInputType) == Keybind.Key then
			if Keybind.Value == "None" then
				return
			end

			if Keybind.Mode == "Toggle" then
				Keybind:Press()
			elseif Keybind.Mode == "Hold" then
				Keybind:Press(true)
			end
		end
	end)

	Library:Connect(UserInputService.InputEnded, function(Input)
		if tostring(Input.KeyCode) == Keybind.Key or tostring(Input.UserInputType) == Keybind.Key then
			if Keybind.Value == "None" then
				return
			end

			if Keybind.Mode == "Hold" then
				Keybind:Press(false)
			end
		end
	end)

	if Keybind.Default then
		Keybind:Set({ Key = Keybind.Default, Mode = Keybind.Mode or "Toggle" })
	end

	Library.SetFlags[Keybind.Flag] = function(Value)
		Keybind:Set(Value)
	end

	Keybind.Items = Items_
	return Keybind
end

