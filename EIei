			Name = KeyData.Name or KeyData.name or "Keybind",
			Flag = KeyData.Flag or KeyData.flag or Library:NextFlag(),
			Default = KeyData.Default or KeyData.default or Enum.KeyCode.RightShift,
			Mode = KeyData.Mode or KeyData.mode or "Toggle",
			Callback = KeyData.Callback or KeyData.callback or function() end,
			Key = nil,
			Picking = false,
			Value = "",
			Toggled = false,
		}

		Toggle.Count = Toggle.Count + 1
		Keybind.Count = Toggle.Count

		local KeyItems = {}

		KeyItems.KeyButton = Items:Create("TextButton", {
			Parent = Items_.Toggle.Instance,
