	-- Window:SetOpen(bool) — fade + scale 0.965 ↔ 1 (Quint, 0.34s เปิด / 0.26s ปิด)
	Window.SetOpen = function(self, Bool)
		if Debounce or Window.IsOpen == Bool then
			return
		end

		Window.IsOpen = Bool
		Debounce = true

		local OpenScale = Items_.OpenScale and Items_.OpenScale.Instance

		if not Bool then
			for _, Colorpicker in pairs(OpenColorpickers) do
				if Colorpicker and Colorpicker.IsOpen then
					pcall(function()
						Colorpicker:SetOpen(false)
					end)
				end
			end
		end

		local Time = (Bool and 0.34) or 0.26
		local Direction = (Bool and Enum.EasingDirection.Out) or Enum.EasingDirection.In

		if Bool then
			Items_.MainFrame.Instance.Visible = true
			Items_.MainFrame.Instance.GroupTransparency = 1
			if OpenScale then
				OpenScale.Scale = 0.965
			end

			local FadeTween = TweenService:Create(Items_.MainFrame.Instance, TweenInfo.new(Time, Enum.EasingStyle.Quint, Direction), { GroupTransparency = 0 })
			local ScaleTween = OpenScale and TweenService:Create(OpenScale, TweenInfo.new(Time, Enum.EasingStyle.Quint, Direction), { Scale = 1 }) or nil

			FadeTween:Play()
			if ScaleTween then
				ScaleTween:Play()
			end

			Library:Connect(FadeTween.Completed, function()
				if Window.IsOpen then
					Items_.MainFrame.Instance.GroupTransparency = 0
					if OpenScale then
						OpenScale.Scale = 1
					end
				end
				Debounce = false
			end)
		else
			Items_.MainFrame.Instance.GroupTransparency = 0

			local FadeTween = TweenService:Create(Items_.MainFrame.Instance, TweenInfo.new(Time, Enum.EasingStyle.Quint, Direction), { GroupTransparency = 1 })
			local ScaleTween = OpenScale and TweenService:Create(OpenScale, TweenInfo.new(Time, Enum.EasingStyle.Quint, Direction), { Scale = 0.965 }) or nil

			FadeTween:Play()
			if ScaleTween then
				ScaleTween:Play()
			end

			Library:Connect(FadeTween.Completed, function()
				if not Window.IsOpen then
					Items_.MainFrame.Instance.Visible = false
					Items_.MainFrame.Instance.GroupTransparency = 0
					if OpenScale then
						OpenScale.Scale = 1
					end
				end
				Debounce = false
			end)
		end
	end

	Library:Connect(UserInputService.InputBegan, function(Input, GameProcessedEvent)
		if GameProcessedEvent then
			return
		end
		if tostring(Input.KeyCode) == Library.MenuKeybind then
			Window:SetOpen(not Window.IsOpen)
		end
	end)

	Window.Items = Items_
	Window:SetOpen(true)

	return setmetatable(Window, Library)
end

