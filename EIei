-- Items:MakeDraggable()  — ลากหน้าต่างด้วย tween 0.2s Quart
Items.MakeDraggable = function(self)
	if not self.Instance then
		return
	end

	local StartMouse
	local StartPosition
	local Dragging = false

	self:Connect("InputBegan", function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
			Dragging = true
			StartMouse = Input.Position
			StartPosition = self.Instance.Position
			Input.Debounce = true
		end
	end)

	self:Connect("InputEnded", function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
			Dragging = false
			Input.Debounce = false
		end
	end)

	Library:Connect(UserInputService.InputChanged, function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseMovement or Input.UserInputType == Enum.UserInputType.Touch then
			if Dragging then
				Input.Debounce = true
				local Delta = Input.Position - StartMouse
				self:Tween(TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
					Position = UDim2new(StartPosition.X.Scale, StartPosition.X.Offset + Delta.X, StartPosition.Y.Scale, StartPosition.Y.Offset + Delta.Y),
				})
			end
		end
	end)

	return Dragging
end

-- Items:MakeResizeable(minSize: Vector2, maxSize: Vector2?)
Items.MakeResizeable = function(self, MinSize, MaxSize)
	if not self.Instance then
		return
	end

	local ResizeButton = Items:Create("TextButton", {
		Parent = self.Instance,
		AnchorPoint = Vector2new(1, 1),
		BorderColor3 = Color3fromRGB(0, 0, 0),
		Size = UDim2new(0, 8, 0, 8),
		Position = UDim2new(1, 0, 1, 0),
		Name = "\0",
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		ZIndex = 2000,
		Visible = true,
		Text = "",
	})

	local Resizing = false
	local Delta = UDim2new()

	ResizeButton:Connect("InputBegan", function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
			Resizing = true
			Delta = self.Instance.Size - UDim2new(0, Input.Position.X, 0, Input.Position.Y)
		end
	end)

	ResizeButton:Connect("InputEnded", function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.Touch then
			Resizing = false
		end
	end)

	local Max = self.Instance.Parent.AbsoluteSize - self.Instance.AbsoluteSize
	local NewSize = UDim2new()

	Library:Connect(UserInputService.InputChanged, function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseMovement and Resizing and not Input.Debounce then
			Max = MaxSize or (self.Instance.Parent.AbsoluteSize - self.Instance.AbsoluteSize)
			NewSize = Delta + UDim2new(0, Input.Position.X, 0, Input.Position.Y)
			NewSize = UDim2new(0, clamp(NewSize.X.Offset, MinSize.X, Max.X), 0, clamp(NewSize.Y.Offset, MinSize.Y, Max.Y))
			Tween:Create(self.Instance, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = NewSize }, true)
		end
	end)

	return Resizing
end

