-- ── Library helpers ────────────────────────────────────────────────────
Library.GetImage = function(self, Image)
	if not self.Images[Image] then
		return
	end
	return getcustomasset(self.Folders.Assets .. "/" .. self.Images[Image][1])
end

Library.Round = function(self, Number, Float)
	local Multiplier = 10 ^ math.max(0, floor(tonumber(Float) or 0))
	return floor(Number * Multiplier + 0.5) / Multiplier
end

Library.IsMouseOverFrame = function(self, Frame)
	Frame = Frame.Instance or Frame
	if Mouse.X >= Frame.AbsolutePosition.X and Mouse.X <= Frame.AbsolutePosition.X + Frame.AbsoluteSize.X
		and Mouse.Y >= Frame.AbsolutePosition.Y and Mouse.Y <= Frame.AbsolutePosition.Y + Frame.AbsoluteSize.Y then
		return true
	end
	return false
end

Library.Unload = function(self)
	for _, Connection in pairs(self.Connections) do
		Connection.Connection:Disconnect()
	end
	for _, Thread in pairs(self.Threads) do
		coroutine.close(Thread)
	end
	if self.Holder then
		self.Holder:Clean()
	end
	getgenv().Library = nil
	Library = nil
end

Library.Thread = function(self, Function)
	local NewThread = coroutine.create(Function)
	coroutine.wrap(function()
		coroutine.resume(NewThread)
	end)()
	tinsert(self.Threads, NewThread)
	return NewThread
end

Library.SafeCall = function(self, Function, ...)
	local Arguments = { ... }
	local Success, Result = pcall(Function, tunpack(Arguments))
	if not Success then
		Library:Notification("Error!", "Error caught in function, report this to the devs:\n" .. Result, 5)
		return false
	end
	return Success
end

Library.Connect = function(self, Event, Callback, Name)
	Name = Name or sformat("Connection_%s_%s", self.UnnamedConnections + 1, HttpService:GenerateGUID(false))

	local NewConnection = {
		Event = Event,
		Callback = Callback,
		Name = Name,
		Connection = nil,
	}

	Library:Thread(function()
		NewConnection.Connection = Event:Connect(Callback)
	end)

	tinsert(self.Connections, NewConnection)
	return NewConnection
end

Library.Disconnect = function(self, Name)
	for _, Connection in pairs(self.Connections) do
		if Connection.Name == Name then
			Connection.Connection:Disconnect()
			break
		end
	end
end

Library.NextFlag = function(self)
	self.UnnamedFlags = self.UnnamedFlags + 1
	return sformat("Flag Number %s %s", self.UnnamedFlags, HttpService:GenerateGUID(false))
end

-- ── Theme ──────────────────────────────────────────────────────────────
Library.AddToTheme = function(self, Item, Properties)
	Item = Item.Instance or Item

	local ThemeData = {
		Item = Item,
		Properties = Properties,
	}

	for Property, Value in pairs(ThemeData.Properties) do
		if type(Value) == "string" then
			Item[Property] = self.Theme[Value]
		else
			Item[Property] = Value()
		end
	end

	tinsert(self.ThemeItems, ThemeData)
	self.ThemeMap[Item] = ThemeData
end

Library.ChangeItemTheme = function(self, Item, Properties)
	Item = Item.Instance or Item
	if not self.ThemeMap[Item] then
		return
	end
	self.ThemeMap[Item].Properties = Properties
	self.ThemeMap[Item] = self.ThemeMap[Item]
end

Library.ChangeTheme = function(self, Theme, Color)
	self.Theme[Theme] = Color

	for _, Item in pairs(self.ThemeItems) do
		for Property, Value in pairs(Item.Properties) do
			if type(Value) == "string" and Value == Theme then
				Item.Item[Property] = Color
			elseif type(Value) == "function" then
				Item.Item[Property] = Value()
			end
		end
	end
end

Library.ApplyTheme = function(self, Name)
	self.Themes = self.Themes or Themes
	local Theme = self.Themes[Name] or self.Themes.Default or Themes.Default
	self.Theme = self.Theme or tclone(Theme)
	self.CurrentTheme = (self.Themes[Name] and Name) or "Default"

	for Key, Color in pairs(Theme) do
		self:ChangeTheme(Key, Color)
	end
end

Library.GetTransparencyPropertyFromItem = function(self, Item)
	if Item:IsA("Frame") then
		return { "BackgroundTransparency" }
	elseif Item:IsA("TextLabel") or Item:IsA("TextButton") then
		return { "TextTransparency", "BackgroundTransparency" }
	elseif Item:IsA("ImageLabel") or Item:IsA("ImageButton") then
		return { "BackgroundTransparency", "ImageTransparency" }
	elseif Item:IsA("ScrollingFrame") then
		return { "BackgroundTransparency", "ScrollBarImageTransparency" }
	elseif Item:IsA("TextBox") then
		return { "TextTransparency", "BackgroundTransparency" }
	elseif Item:IsA("UIStroke") then
		return { "Transparency" }
	end
end

-- Library:FadeItem(item, property, show: boolean, time?)
Library.FadeItem = function(self, Item, Property, Show, Time)
	local Original = Item[Property]
	Item[Property] = (Show and 1) or Original

	Time = Time or Library.Tween.Time
	local NewTween = Tween:Create(Item, TweenInfo.new(Time, Library.Tween.Style, Library.Tween.Direction), {
		[Property] = (Show and Original) or 1,
	}, true)

	Library:Connect(NewTween.Tween.Completed, function()
		if not Show then
			task.wait()
			Item[Property] = Original
		end
	end)

	return NewTween
end

-- ── Config ─────────────────────────────────────────────────────────────
Library.GetConfig = function(self)
	local Config = {}

	self:SafeCall(function()
		for Flag, Value in pairs(self.Flags) do
			if type(Value) == "table" and Value.Key then
				Config[Flag] = { Key = tostring(Value.Key), Mode = Value.Mode }
			elseif type(Value) == "table" and Value.Color then
				Config[Flag] = { Color = Value.HexValue, Alpha = Value.Alpha }
			else
				Config[Flag] = Value
			end
		end
	end)

	return HttpService:JSONEncode(Config)
end

Library.LoadConfig = function(self, Config)
	local Decoded = HttpService:JSONDecode(Config)

	self:SafeCall(function()
		for Flag, Value in pairs(Decoded) do
			if self.SetFlags[Flag] then
				if type(Value) == "table" and Value.Key then
					self.SetFlags[Flag](Value)
				elseif type(Value) == "table" and Value.Color then
					self.SetFlags[Flag](Value.Color, Value.Alpha)
				else
					self.SetFlags[Flag](Value)
				end
			end
		end
	end)
end

Library.DeleteConfig = function(self, Config)
	if isfile(self.Folders.Configs .. "/" .. Config) then
		delfile(self.Folders.Configs .. "/" .. Config)
		self:Notification("Success", "Deleted config " .. Config, 5)
	end
end

Library.SaveConfig = function(self, Config)
	if isfile(self.Folders.Configs .. "/" .. Config) then
		writefile(self.Folders.Configs .. "/" .. Config, self:GetConfig())
		self:Notification("Success", "Saved config " .. Config, 5)
	end
end

Library.RefreshConfigsList = function(self, Element)
	local CurrentList = {}
	local List = {}

	local Prefix = sgsub(self.Folders.Configs, self.Folders.Directory .. "/", "")
	for _, File in pairs(listfiles(self.Folders.Configs)) do
		local Name = sgsub(File, self.Folders.Directory .. "\\" .. Prefix .. "\\", "")
		tinsert(List, Name)
	end

	Element:Refresh(List)
end

