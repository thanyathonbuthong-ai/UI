function BlvckUI:CreateWindow(options)
    options = options or {}
    if options.Compact ~= nil then
        BlvckUI:SetCompact(options.Compact)
    end

    -- розмір вікна: не більший за екран (важливо для телефонів)
    local vp = getViewport()
    local baseW = options.Size and options.Size.X.Offset or M.WinW
    local baseH = options.Size and options.Size.Y.Offset or M.WinH
    local winW = math.floor(math.min(baseW, math.max(260, vp.X - M.Margin * 2)))
    local winH = math.floor(math.min(baseH, math.max(180, vp.Y - M.Margin * 2)))
    local size = UDim2.new(0, winW, 0, winH)
    local listWidth = M.ListWidth or math.floor(winW * M.ListFrac + 0.5)

    local self = setmetatable({}, Window)
    self._categories = {}
    self._size = size
    self.ListWidth = listWidth
    self._janitor = newJanitor()

    self.Main = self._janitor:add(new("Frame", {
        BackgroundColor3 = Theme.Background,
        Size = UDim2.new(size.X.Scale, 0, size.Y.Scale, 0),
        Position = UDim2.new(0.5, -winW / 2, 0.5, -winH / 2),
        ClipsDescendants = true,
        Parent = BlvckUI.ScreenGui,
