        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = CrumbBar,
    })

    ------------------------------------------------ Content (list | detail)
    local topH = M.HeaderH + M.CrumbH
    self.Content = new("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, topH), Size = UDim2.new(1, 0, 1, -topH - M.FooterH), Parent = self.Main })
    new("Frame", { BackgroundColor3 = Theme.Stroke, Position = UDim2.new(0, listWidth, 0, 0), Size = UDim2.new(0, 1, 1, 0), BorderSizePixel = 0, Parent = self.Content })

    ------------------------------------------------ Footer nav
    self.Footer = new("Frame", { BackgroundColor3 = Theme.Surface, Position = UDim2.new(0, 0, 1, -M.FooterH), Size = UDim2.new(1, 0, 0, M.FooterH), Parent = self.Main },
        { corner(UDim.new(0, M.Radius)) })
    new("Frame", { -- маска верхніх кутів (тільки низ заокруглений)
        BackgroundColor3 = Theme.Surface, Position = UDim2.new(0, 0, 0, 0), Size = UDim2.new(1, 0, 0, M.Radius),
        BorderSizePixel = 0, Parent = self.Footer,
    })
    self.FooterList = new("Frame", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = self.Footer,
    }, {
        new("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center,
            VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, M.FooterGap), SortOrder = Enum.SortOrder.LayoutOrder,
        }),
    })

    ------------------------------------------------ Floating toggle button (persists even if Main hidden)
    -- Стилізована під головне вікно: Surface + Stroke + акцентний бейдж з іконкою вікна (як у шапці).
    -- Відкрито = акцентна рамка/бейдж, закрито = приглушено. Можна перетягувати (щоб не закривала кнопки гри).
    local toggleSize = M.Toggle
    local badgeSize = toggleSize - 8
    local toggleStroke = stroke(Theme.Accent, 1)
    local toggleBtn = self._janitor:add(new("TextButton", {
        BackgroundColor3 = Theme.Surface, Position = UDim2.new(0, M.TogglePos, 0, M.TogglePos),
        Size = UDim2.new(0, toggleSize, 0, toggleSize),
        Text = "", AutoButtonColor = false, ZIndex = 50, Parent = BlvckUI.ScreenGui,
    }, { corner(UDim.new(0, M.RowCorner)), toggleStroke }))

    local toggleBadge = new("Frame", {
        BackgroundColor3 = Theme.Accent, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, badgeSize, 0, badgeSize), Parent = toggleBtn,
    }, { corner(UDim.new(0, math.max(4, M.RowCorner - 3))) })
    local toggleIcon = makeIcon(options.Icon or "sparkles", math.floor(badgeSize * 0.55), Color3.new(1, 1, 1))
    toggleIcon.AnchorPoint = Vector2.new(0.5, 0.5)
    toggleIcon.Position = UDim2.new(0.5, 0, 0.5, 0)
    toggleIcon.Parent = toggleBadge

    local function applyToggleVisual(open)
        tween(toggleStroke, EASE, { Color = open and Theme.Accent or Theme.Stroke })
        tween(toggleBadge, EASE, { BackgroundColor3 = open and Theme.Accent or Theme.SurfaceLight })
        setIconColor(toggleIcon, open and Color3.new(1, 1, 1) or Theme.SubText)
    end

    -- hover (на ПК)
    self._janitor:add(toggleBtn.MouseEnter:Connect(function()
        tween(toggleBtn, EASE, { BackgroundColor3 = Theme.SurfaceHover })
    end))
    self._janitor:add(toggleBtn.MouseLeave:Connect(function()
        tween(toggleBtn, EASE, { BackgroundColor3 = Theme.Surface })
    end))

    -- клік (перемикає вікно) + перетягування (якщо палець/миша зсунулись більше ніж на 6 px)
    local tDragging, tMoved, tStart, tStartX, tStartY = false, false, nil, 0, 0
    self._janitor:add(toggleBtn.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        tDragging, tMoved = true, false
        tStart = input.Position
        local rel = toggleBtn.AbsolutePosition - BlvckUI.ScreenGui.AbsolutePosition
        tStartX, tStartY = rel.X, rel.Y
        tween(toggleBadge, EASE, { Size = UDim2.new(0, badgeSize - 4, 0, badgeSize - 4) }) -- ефект натискання
    end))
    self._janitor:add(UserInputService.InputChanged:Connect(function(input)
        if not tDragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = input.Position - tStart
        if not tMoved and delta.Magnitude > 6 then tMoved = true end
        if tMoved then
            toggleBtn.Position = clampToViewport(tStartX + delta.X, tStartY + delta.Y, toggleBtn.AbsoluteSize, getViewport())
        end
    end))
    self._janitor:add(UserInputService.InputEnded:Connect(function(input)
        if not tDragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        tDragging = false
        tween(toggleBadge, EASE, { Size = UDim2.new(0, badgeSize, 0, badgeSize) })
        if not tMoved then
            self.Main.Visible = not self.Main.Visible
            applyToggleVisual(self.Main.Visible)
        end
    end))

    ------------------------------------------------ Drag (кламп по екрану, без витоку конектів)
    -- Працює через абсолютні координати: вікно більше не "стрибає" в кут при першому торканні
    local dragging, dragStart, startX, startY = false, nil, 0, 0
    self._janitor:add(Header.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        dragging = true
        dragStart = input.Position
        local rel = self.Main.AbsolutePosition - BlvckUI.ScreenGui.AbsolutePosition
        startX, startY = rel.X, rel.Y
    end))
    self._janitor:add(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
    self._janitor:add(UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = input.Position - dragStart
        self.Main.Position = clampToViewport(startX + delta.X, startY + delta.Y, self.Main.AbsoluteSize, getViewport())
    end))

    return self
end

function Window:_track(conn)
    self._janitor:add(conn)
    return conn
end

function Window:Destroy()
    tween(self.Main, EASE, { Size = UDim2.new(self._size.X.Scale, 0, self._size.Y.Scale, 0), BackgroundTransparency = 1 })
    task.delay(0.18, function()
        self._janitor:cleanup()
    end)
end

function Window:SetTitle(text)
    self.TitleLabel.Text = text
end

function Window:_selectCategory(category)
    if self._activeCategory == category then return end
    if self._activeCategory then self._activeCategory.ListFrame.Visible = false end
    self._activeCategory = category
    category.ListFrame.Visible = true
    self.LeftCrumb.Text = category.Name .. " \\ Modules"

    for _, cat in ipairs(self._categories) do
        local isActive = (cat == category)
        cat.Button.TextColor3 = isActive and Theme.Text or Theme.SubText
        if cat.Icon then setIconColor(cat.Icon, isActive and Theme.Text or Theme.SubText) end
    end

    if #category._modules > 0 then
        self:_selectModule(category._modules[1])
    else
        self.RightCrumb.Text = "Settings \\ —"
    end
end

function Window:_selectModule(module)
    if self._activeModule then
        self._activeModule.SettingsFrame.Visible = false
        if self._activeModule.GearIcon then setIconColor(self._activeModule.GearIcon, Theme.SubText) end
    end
    self._activeModule = module
    module.SettingsFrame.Visible = true
    if module.GearIcon then setIconColor(module.GearIcon, Theme.Accent) end
    self.RightCrumb.Text = "Settings \\ " .. (module.DetailTitle or module.Title)
end

