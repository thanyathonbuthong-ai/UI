        Font = Theme.Font, TextSize = M.Text, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd, Parent = holder,
    })

    local strokeInst = stroke(state and Theme.Accent or Theme.Stroke)
    local box = new("TextButton", {
        BackgroundColor3 = state and Theme.Accent or Theme.Surface,
        Position = UDim2.new(1, -M.Box, 0.5, -M.Box / 2), Size = UDim2.new(0, M.Box, 0, M.Box),
        Text = "", AutoButtonColor = false, Parent = holder,
    }, { corner(UDim.new(0, 5)), strokeInst })
    local checkIcon = makeIcon("check", M.BoxIcon, Color3.new(1, 1, 1))
