--==========================================================================
--  Signal / Janitor
--==========================================================================
local Signal = {}
Signal.__index = Signal

function Signal.new() return setmetatable({ _h = {} }, Signal) end

function Signal:Connect(fn)
    local node = { fn = fn, on = true }
    table.insert(self._h, node)
    local sig = self
    local conn = { Connected = true }
    function conn:Disconnect()
        if not node.on then return end
        node.on = false
        conn.Connected = false
        local i = table.find(sig._h, node)
        if i then table.remove(sig._h, i) end
    end
    return conn
end

function Signal:Once(fn)
    local c
    c = self:Connect(function(...) c:Disconnect() fn(...) end)
    return c
end

function Signal:Fire(...)
    for _, node in ipairs(table.clone(self._h)) do
        if node.on then task.spawn(node.fn, ...) end
    end
end

function Signal:FireSync(...)
    for _, node in ipairs(table.clone(self._h)) do
        if node.on then pcall(node.fn, ...) end
    end
end

function Signal:Destroy() table.clear(self._h) end

local function cleanItem(o)
    local t = typeof(o)
    if t == "RBXScriptConnection" then o:Disconnect()
    elseif t == "Instance" then o:Destroy()
    elseif t == "function" then o()
    elseif t == "thread" then pcall(task.cancel, o)
    elseif t == "table" then
        if o.Disconnect then o:Disconnect()
        elseif o.Destroy then o:Destroy() end
    end
end

local Janitor = {}
Janitor.__index = Janitor

function Janitor.new() return setmetatable({ _items = {} }, Janitor) end
function Janitor:Add(o) table.insert(self._items, o) return o end
function Janitor:Connect(sig, fn) return self:Add(sig:Connect(fn)) end
function Janitor:Extend() return self:Add(Janitor.new()) end

function Janitor:Clean()
    local items = self._items
    self._items = {}
    for i = #items, 1, -1 do pcall(cleanItem, items[i]) end
end
Janitor.Destroy = Janitor.Clean

