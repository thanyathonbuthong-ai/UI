local Theme = {
    Tokens = {
        Accent                    = Color3.fromRGB(197, 59, 59),
        Outline                   = Color3.fromRGB(24, 25, 24),
        Background                = Color3.fromRGB(0, 0, 0),
        ElementBackground         = Color3.fromRGB(6, 6, 6),
        TabButtonSelected         = Color3.fromRGB(51, 65, 70),
        Unselected                = Color3.fromRGB(75, 72, 72),
        TextColor                 = Color3.fromRGB(197, 197, 197),
        ToggleCircleUnselected    = Color3.fromRGB(70, 85, 87),
        ToggleBackgroundUnselected= Color3.fromRGB(12, 13, 13),
        GradientTop               = Color3.fromRGB(14, 16, 16),
        GradientMid               = Color3.fromRGB(6, 6, 6),
        GradientDark              = Color3.fromRGB(3, 3, 3),
        GradientDeep              = Color3.fromRGB(0, 0, 0),
        TabHighlight              = Color3.fromRGB(51, 65, 70),
        TabShadow                 = Color3.fromRGB(30, 51, 61),
    },
}

local boundProps     = {}
local boundGradients = setmetatable({}, { __mode = "k" })
local themeSignals   = {}

local function tokenSignal(token)
    local s = themeSignals[token]
    if not s then s = Signal.new() themeSignals[token] = s end
    return s
end

local function sequence(tokens, times)
    local n = #tokens
    if n == 1 then return ColorSequence.new(Theme.Tokens[tokens[1]]) end
    local pts = {}
    for i, tk in ipairs(tokens) do
        local t = times and times[i] or (i - 1) / (n - 1)
        pts[i] = ColorSequenceKeypoint.new(t, Theme.Tokens[tk])
    end
    return ColorSequence.new(pts)
end

function Theme.get(token) return Theme.Tokens[token] end

function Theme.bind(inst, prop, token)
    inst[prop] = Theme.Tokens[token]
    local reg = boundProps[token]
    if not reg then
        reg = setmetatable({}, { __mode = "k" })
        boundProps[token] = reg
    end
    local props = reg[inst]
    if not props then props = {} reg[inst] = props end
    props[prop] = true
end

function Theme.gradient(grad, tokens, times)
    grad.Color = sequence(tokens, times)
    boundGradients[grad] = { tokens = tokens, times = times }
end

function Theme.onChange(token, fn) return tokenSignal(token):Connect(fn) end

function Theme.set(token, color)
    if Theme.Tokens[token] == nil or Theme.Tokens[token] == color then return end
    Theme.Tokens[token] = color
    local reg = boundProps[token]
    if reg then
        for inst, props in pairs(reg) do
            for prop in pairs(props) do pcall(function() inst[prop] = color end) end
        end
    end
    for grad, info in pairs(boundGradients) do
        if table.find(info.tokens, token) then
            pcall(function() grad.Color = sequence(info.tokens, info.times) end)
        end
    end
    tokenSignal(token):FireSync(color)
end

