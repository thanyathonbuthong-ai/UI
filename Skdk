--==========================================================================
--  Instance helpers
--==========================================================================
local function create(class, props, children)
    local inst = Instance.new(class)
    if inst:IsA("GuiObject") then inst.BorderSizePixel = 0 end
    if inst:IsA("GuiButton") then inst.AutoButtonColor = false end
    if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
        inst.FontFace = Fonts.Medium
        inst.TextColor3 = Theme.Tokens.TextColor
        inst.TextSize = 14
        inst.Text = ""
        inst.BackgroundTransparency = 1
    elseif inst:IsA("ImageLabel") or inst:IsA("ImageButton") or inst:IsA("ScrollingFrame") or inst:IsA("CanvasGroup") then
        inst.BackgroundTransparency = 1
    end
    local parent
    if props then
        for k, v in pairs(props) do
            if k == "Parent" then parent = v else inst[k] = v end
        end
    end
    if children then for _, c in ipairs(children) do c.Parent = inst end end
    if parent then inst.Parent = parent end
    return inst
end

local function corner(parent, r)
    return create("UICorner", { CornerRadius = (type(r) == "number") and UDim.new(0, r) or r, Parent = parent })
end

local function stroke(parent, token, transparency)
    local s = create("UIStroke", {
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Transparency = transparency or 0, Thickness = 1, Parent = parent,
    })
    Theme.bind(s, "Color", token or "Outline")
    return s
end

local function pad(parent, t, r, b, l)
    return create("UIPadding", {
        PaddingTop = UDim.new(0, t or 0), PaddingRight = UDim.new(0, r or 0),
        PaddingBottom = UDim.new(0, b or 0), PaddingLeft = UDim.new(0, l or 0), Parent = parent,
    })
end

local function list(parent, dir, gap, ha, va)
    return create("UIListLayout", {
        FillDirection = dir or Enum.FillDirection.Vertical, Padding = UDim.new(0, gap or 0),
        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = ha or Enum.HorizontalAlignment.Left,
        VerticalAlignment = va or Enum.VerticalAlignment.Top, Parent = parent,
    })
end

local function flexFill(parent)
    return create("UIFlexItem", { FlexMode = Enum.UIFlexMode.Fill, Parent = parent })
end

local function fadeEnds(transparencyList)
    local pts = {}
    for i, p in ipairs(transparencyList) do pts[i] = NumberSequenceKeypoint.new(p[1], p[2]) end
    return NumberSequence.new(pts)
end

--  Generic press-drag helper (mouse + touch).
local function bindDrag(j, gui, onUpdate, onBegin, onEnd)
    local active, tracked = false, nil
    j:Add(gui.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        active, tracked = true, input
        if onBegin then onBegin() end
        onUpdate(input.Position)
        local con
        con = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                con:Disconnect()
                if active and tracked == input then
                    active, tracked = false, nil
                    if onEnd then onEnd() end
                end
            end
        end)
    end))
    j:Add(UserInputService.InputChanged:Connect(function(input)
        if not active then return end
        if input == tracked or input.UserInputType == Enum.UserInputType.MouseMovement then
            onUpdate(input.Position)
        end
    end))
end

