--[[
    SettingsTab UI Library
    ไลบรารีสำหรับสร้างแท็บใหม่ในเมนู Settings ของ Roblox (CoreGui)
    แยก UI ออกมาจากสคริปต์ Servers เดิม

    การใช้งานแบบย่อ:
        local Library = loadstring(readfile("UILibrary.lua"))()
        local hub = Library.new()
        local tab = hub:CreateTab({ Name = "Servers" })
        local banner = tab:AddBanner({ Title = "Hello", Subtitle = "World" })
        local row = tab:AddRow()
        row:AddButton({ Text = "Click", Callback = function() end })
        local list = tab:AddList()
        list:AddCard({ Text = "Item", ButtonText = "Join", Callback = function() end })
]]

local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Library = {}
Library.__index = Library

-- =========================
-- THEME
-- =========================
Library.Theme = {
	Surface = Color3.fromRGB(45, 45, 52),
	SurfaceTransparency = 0.4,
	Cooldown = Color3.fromRGB(60, 60, 70),
	Accent = Color3.fromRGB(60, 120, 255),
	AccentTransparency = 0.2,
	Highlight = Color3.fromRGB(60, 80, 120),
	HighlightTransparency = 0.35,
	Badge = Color3.fromRGB(100, 150, 255),
	Text = Color3.fromRGB(255, 255, 255),
	TextSoft = Color3.fromRGB(220, 220, 220),
	TextMuted = Color3.fromRGB(160, 160, 160),
	TabIdle = Color3.fromRGB(180, 180, 180),
	FontBold = Enum.Font.GothamBold,
	FontSemi = Enum.Font.GothamSemibold,
	FontRegular = Enum.Font.Gotham,
	CornerLarge = 14,
	CornerMedium = 10,
	CornerSmall = 8,
}

local function T()
	return Library.Theme
end

-- =========================
-- HELPERS
-- =========================
local function create(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		inst[k] = v
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function corner(parent, radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

local function tween(inst, props, time)
	TweenService:Create(inst, TweenInfo.new(time or 0.15), props):Play()
end

local function resolveRoblox()
	local gui = CoreGui:WaitForChild("RobloxGui")
	local shield = gui:WaitForChild("SettingsClippingShield"):WaitForChild("SettingsShield")
	local menu = shield:WaitForChild("MenuContainer")
	local page = menu:WaitForChild("Page")
	return {
		Shield = shield,
		Menu = menu,
		Page = page,
		HubBar = page:WaitForChild("HubBar"):WaitForChild("TabHeaderContainer"):WaitForChild("HubBarContainer"),
		Clipper = page:WaitForChild("PageViewClipper"),
	}
end

-- =========================
-- BUTTON
-- =========================
local Button = {}
Button.__index = Button

local function newButton(parent, opts)
	local theme = T()
	local inst = create("TextButton", {
		Size = UDim2.new(0, opts.Width or 110, 0, opts.Height or 36),
		BackgroundColor3 = opts.Color or theme.Surface,
		BackgroundTransparency = opts.Transparency or theme.SurfaceTransparency,
		Text = opts.Text or "Button",
		TextColor3 = theme.Text,
		Font = theme.FontBold,
		TextSize = opts.TextSize or 13,
		BorderSizePixel = 0,
		LayoutOrder = opts.Order or 0,
		AutoButtonColor = false,
	}, parent)
	corner(inst, opts.Corner or theme.CornerMedium)

	local self = setmetatable({
		Instance = inst,
		_text = opts.Text or "Button",
		_color = opts.Color or theme.Surface,
		_transparency = opts.Transparency or theme.SurfaceTransparency,
		_cooldownEnd = 0,
		_conn = nil,
	}, Button)

	if opts.Hover then
		inst.MouseEnter:Connect(function()
			if not self:IsCooling() then
				tween(inst, { BackgroundTransparency = 0 })
			end
		end)
		inst.MouseLeave:Connect(function()
			if not self:IsCooling() then
				tween(inst, { BackgroundTransparency = self._transparency })
			end
		end)
	end

	if opts.Callback then
		inst.MouseButton1Click:Connect(function()
			opts.Callback(self)
		end)
	end

	return self
end

function Button:SetText(text)
	self._text = text
	if not self:IsCooling() then
		self.Instance.Text = text
	end
end

function Button:IsCooling()
	return tick() < self._cooldownEnd
end

-- restore: string | function | nil  (nil = กลับไปใช้ข้อความล่าสุดที่ SetText)
function Button:StartCooldown(seconds, restore)
	if self:IsCooling() then
		return false
	end
	local inst = self.Instance
	self._cooldownEnd = tick() + seconds
	inst.BackgroundColor3 = T().Cooldown
	inst.BackgroundTransparency = 0
	inst.Text = seconds .. "s"

	if self._conn then
		self._conn:Disconnect()
	end
	self._conn = RunService.Heartbeat:Connect(function()
		local remaining = math.ceil(self._cooldownEnd - tick())
		if remaining <= 0 then
			local text = restore
			if type(restore) == "function" then
				text = restore()
			end
			inst.Text = text or self._text
			self._text = inst.Text
			inst.BackgroundColor3 = self._color
			inst.BackgroundTransparency = self._transparency
			self._conn:Disconnect()
			self._conn = nil
		else
			inst.Text = remaining .. "s"
		end
	end)
	return true
end

function Button:Destroy()
	if self._conn then
		self._conn:Disconnect()
	end
	self.Instance:Destroy()
end

-- =========================
-- BANNER
-- =========================
local Banner = {}
Banner.__index = Banner

function Banner:SetTitle(text)
	self.TitleLabel.Text = text
end

function Banner:SetSubtitle(text)
	self.SubtitleLabel.Text = text
end

function Banner:SetIcon(image)
	self.Icon.Image = image
end

function Banner:SetStats(text)
	self.StatsLabel.Text = text
end

-- =========================
-- LIST
-- =========================
local List = {}
List.__index = List

function List:SetLoading(visible, text)
	if text then
		self.LoadingLabel.Text = text
	end
	self.LoadingLabel.Visible = visible
end

function List:Clear()
	for _, child in ipairs(self.Instance:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
end

--[[
    opts:
        Text        : string  ข้อความหลัก
        Badge       : string? ป้ายด้านบน (ถ้ามีจะเป็นการ์ดแบบ highlight สูง 64)
        Highlight   : boolean? ใช้สีไฮไลต์
        Height      : number?
        Order       : number? LayoutOrder
        ButtonText  : string? ถ้าใส่จะมีปุ่มด้านขวา
        Callback    : function? เรียกเมื่อกดปุ่ม
]]
function List:AddCard(opts)
	local theme = T()
	local highlight = opts.Highlight or opts.Badge ~= nil
	local height = opts.Height or (highlight and 64 or 54)

	local card = create("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = highlight and theme.Highlight or theme.Surface,
		BackgroundTransparency = highlight and theme.HighlightTransparency or theme.SurfaceTransparency,
		BorderSizePixel = 0,
		LayoutOrder = opts.Order or 0,
	}, self.Instance)
	corner(card, theme.CornerLarge)

	local badge
	if opts.Badge then
		badge = create("TextLabel", {
			Size = UDim2.new(0, 100, 0, 22),
			Position = UDim2.new(0, 16, 0, 8),
			BackgroundColor3 = theme.Badge,
			BackgroundTransparency = 0.3,
			Text = opts.Badge,
			TextColor3 = theme.Text,
			Font = theme.FontBold,
			TextSize = 11,
		}, card)
		corner(badge, 6)
	end

	local rightPad = opts.ButtonText and 130 or 32
	local label = create("TextLabel", {
		Size = opts.Badge and UDim2.new(1, -32, 0, 22) or UDim2.new(1, -rightPad, 1, 0),
		Position = opts.Badge and UDim2.new(0, 16, 0, 34) or UDim2.new(0, 16, 0, 0),
		BackgroundTransparency = 1,
		Text = opts.Text or "",
		TextColor3 = opts.Badge and Color3.fromRGB(200, 200, 200) or theme.TextSoft,
		Font = theme.FontRegular,
		TextSize = opts.Badge and 13 or 14,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, card)

	local button
	if opts.ButtonText then
		button = newButton(card, {
			Text = opts.ButtonText,
			Width = 90,
			Height = 34,
			Color = theme.Accent,
			Transparency = theme.AccentTransparency,
			TextSize = 14,
			Hover = true,
			Callback = opts.Callback,
		})
		button.Instance.Position = UDim2.new(1, -106, 0.5, -17)
	end

	return { Instance = card, Label = label, Badge = badge, Button = button }
end

-- =========================
-- ROW
-- =========================
local Row = {}
Row.__index = Row

function Row:AddButton(opts)
	self._count += 1
	opts = opts or {}
	opts.Order = opts.Order or self._count
	return newButton(self.Instance, opts)
end

-- =========================
-- TAB
-- =========================
local Tab = {}
Tab.__index = Tab

function Tab:AddBanner(opts)
	opts = opts or {}
	local theme = T()
	local frame = create("Frame", {
		Name = "Banner",
		Size = UDim2.new(1, -32, 0, 64),
		Position = UDim2.new(0, 16, 0, self._y),
		BackgroundColor3 = theme.Surface,
		BackgroundTransparency = theme.SurfaceTransparency,
		BorderSizePixel = 0,
	}, self.Page)
	corner(frame, theme.CornerLarge)
	self._y += 72

	local icon = create("ImageLabel", {
		Size = UDim2.new(0, 44, 0, 44),
		Position = UDim2.new(0, 12, 0.5, -22),
		BackgroundTransparency = 1,
		Image = opts.Icon or "rbxasset://textures/ui/GuiImagePlaceholder.png",
	}, frame)
	corner(icon, theme.CornerSmall)

	local title = create("TextLabel", {
		Size = UDim2.new(1, -70, 0, 24),
		Position = UDim2.new(0, 68, 0, 10),
		BackgroundTransparency = 1,
		Text = opts.Title or "",
		TextColor3 = theme.Text,
		Font = theme.FontBold,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, frame)

	local subtitle = create("TextLabel", {
		Size = UDim2.new(1, -70, 0, 18),
		Position = UDim2.new(0, 68, 0, 36),
		BackgroundTransparency = 1,
		Text = opts.Subtitle or "",
		TextColor3 = theme.TextMuted,
		Font = theme.FontRegular,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, frame)

	local stats = create("TextLabel", {
		Size = UDim2.new(0, 180, 1, 0),
		Position = UDim2.new(1, -190, 0, 0),
		BackgroundTransparency = 1,
		Text = opts.Stats or "",
		TextColor3 = theme.TextMuted,
		Font = theme.FontRegular,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, frame)

	return setmetatable({
		Instance = frame,
		Icon = icon,
		TitleLabel = title,
		SubtitleLabel = subtitle,
		StatsLabel = stats,
	}, Banner)
end

function Tab:AddRow()
	local frame = create("Frame", {
		Name = "Row",
		Size = UDim2.new(1, -32, 0, 40),
		Position = UDim2.new(0, 16, 0, self._y),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}, self.Page)
	self._y += 48

	create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Center,
	}, frame)

	return setmetatable({ Instance = frame, _count = 0 }, Row)
end

-- List จะกินพื้นที่ที่เหลือทั้งหมดของหน้า (ควรเรียกเป็นตัวสุดท้าย)
function Tab:AddList(opts)
	opts = opts or {}
	local theme = T()
	local scroll = create("ScrollingFrame", {
		Name = "List",
		Size = UDim2.new(1, -32, 1, -(self._y + 12)),
		Position = UDim2.new(0, 16, 0, self._y),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = opts.ScrollBarThickness or 0,
		ScrollBarImageColor3 = Color3.fromRGB(100, 100, 120),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
	}, self.Page)

	create("UIListLayout", {
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, scroll)

	local loading = create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 60),
		BackgroundTransparency = 1,
		Text = opts.LoadingText or "Loading...",
		TextColor3 = theme.TextMuted,
		Font = theme.FontSemi,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Center,
	}, scroll)

	return setmetatable({ Instance = scroll, LoadingLabel = loading }, List)
end

function Tab:Select()
	self._hub:Select(self)
end

-- =========================
-- LIBRARY (HUB)
-- =========================
function Library.new()
	local r = resolveRoblox()
	local self = setmetatable({
		_r = r,
		_tabs = {},
		_conns = {},
		Active = nil,
	}, Library)

	-- ทำให้ HubBar เลื่อนได้
	self._origParent = r.HubBar.Parent
	self._scroll = create("ScrollingFrame", {
		Name = "HubScroll",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.new(0, 0, 0, 0),
	}, self._origParent)
	r.HubBar.Parent = self._scroll

	-- กดแท็บเดิมของ Roblox -> ออกจากแท็บเรา
	for _, btn in ipairs(r.HubBar:GetChildren()) do
		if btn:IsA("TextButton") then
			table.insert(self._conns, btn.MouseButton1Click:Connect(function()
				self:Deselect()
			end))
		end
	end

	-- ปิดเมนู -> รีเซ็ต
	table.insert(self._conns, r.Shield:GetPropertyChangedSignal("Visible"):Connect(function()
		if not r.Shield.Visible then
			self:Deselect()
		end
	end))

	return self
end

function Library:_setNativeSelection(visible)
	for _, btn in ipairs(self._r.HubBar:GetChildren()) do
		if btn:IsA("TextButton") and not btn:GetAttribute("CustomTab") then
			local sel = btn:FindFirstChild("TabSelection")
			if sel then
				sel.Visible = visible
			end
		end
	end
end

--[[
    opts:
        Name  : string  ข้อความบนแท็บ
        Width : number? ความกว้างปุ่มแท็บ (default 140)
        Order : number? LayoutOrder
]]
function Library:CreateTab(opts)
	opts = opts or {}
	local r = self._r
	local theme = T()

	local button = create("TextButton", {
		Name = (opts.Name or "Custom") .. "Tab",
		Size = UDim2.new(0, opts.Width or 140, 1, 0),
		BackgroundTransparency = 1,
		Text = opts.Name or "Custom",
		TextColor3 = theme.TabIdle,
		Font = theme.FontBold,
		TextSize = 14,
	}, r.HubBar)
	button:SetAttribute("CustomTab", true)

	if r.HubBar:FindFirstChildOfClass("UIListLayout") then
		button.LayoutOrder = opts.Order or #r.HubBar:GetChildren()
	end

	local underline
	local ref = r.HubBar:FindFirstChild("ReportAbuseTab")
	local refSel = ref and ref:FindFirstChild("TabSelection")
	if refSel then
		underline = refSel:Clone()
		underline.Visible = false
		underline.Parent = button
	end

	local page = create("Frame", {
		Name = (opts.Name or "Custom") .. "Page",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = false,
	}, r.Page)

	local function sync()
		page.Size = UDim2.fromOffset(r.Clipper.AbsoluteSize.X, r.Clipper.AbsoluteSize.Y)
		page.Position = UDim2.fromOffset(
			r.Clipper.AbsolutePosition.X - r.Page.AbsolutePosition.X,
			r.Clipper.AbsolutePosition.Y - r.Page.AbsolutePosition.Y
		)
	end
	task.defer(sync)
	table.insert(self._conns, r.Clipper:GetPropertyChangedSignal("AbsoluteSize"):Connect(sync))
	table.insert(self._conns, r.Clipper:GetPropertyChangedSignal("AbsolutePosition"):Connect(sync))

	local tab = setmetatable({
		Name = opts.Name,
		Button = button,
		Page = page,
		Underline = underline,
		_hub = self,
		_y = 12,
	}, Tab)

	button.MouseButton1Click:Connect(function()
		self:Select(tab)
	end)

	table.insert(self._tabs, tab)
	return tab
end

function Library:Select(tab)
	local r = self._r
	for _, t in ipairs(self._tabs) do
		local active = (t == tab)
		t.Page.Visible = active
		t.Button.TextColor3 = active and T().Text or T().TabIdle
		if t.Underline then
			t.Underline.Visible = active
		end
	end
	self:_setNativeSelection(false)
	r.Clipper.Visible = false
	self.Active = tab
end

function Library:Deselect()
	if not self.Active then
		return
	end
	for _, t in ipairs(self._tabs) do
		t.Page.Visible = false
		t.Button.TextColor3 = T().TabIdle
		if t.Underline then
			t.Underline.Visible = false
		end
	end
	self:_setNativeSelection(true)
	self._r.Clipper.Visible = true
	self.Active = nil
end

function Library:Destroy()
	self:Deselect()
	for _, c in ipairs(self._conns) do
		c:Disconnect()
	end
	for _, t in ipairs(self._tabs) do
		t.Page:Destroy()
		t.Button:Destroy()
	end
	self._r.HubBar.Parent = self._origParent
	self._scroll:Destroy()
end

return Library
