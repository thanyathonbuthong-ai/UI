    self.Title = opts.Title or "KiciaUI"
    self.Icon = opts.Icon or DEFAULT_LOGO
    self.Directory = opts.Directory or "KiciaUI"
    self.Keybind = opts.Keybind or Enum.KeyCode.RightShift
    self.Flags = {}
    self.Visible = false
    self.VisibilityChanged = j:Add(Signal.new())
    self.Unloading = Signal.new()
    self._keybinds, self._tabs = {}, {}
    self._onUnload = opts.OnUnload
    self._username = Players.LocalPlayer and Players.LocalPlayer.Name or "Player"
    self._showWatermark, self._showKeybindList = true, true
    self._notifSide, self._notifCounter, self._notifStack = "TopLeft", 0, {}

    local compact = opts.Compact
    if compact == nil then compact = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled end
    self.Metrics = compact and Metrics.Compact or Metrics.Desktop
    local m = self.Metrics

    ensureDir(self.Directory)
    ensureDir(self.Directory .. "/configs")
    self:_LoadState()
    local savedKey = deserializeKey(self._state.Keybind)
    if savedKey then self.Keybind = savedKey end

    --  GUIs ---------------------------------------------------------------
    local function newGui(name, order)
        local g = create("ScreenGui", {
            Name = name .. HttpService:GenerateGUID(false):sub(1, 6), DisplayOrder = order, IgnoreGuiInset = true,
            ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
