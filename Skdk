        local line = create("Frame", {
            AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -2, 1, i == 1 and -4 or -7), Size = UDim2.fromOffset(w, 2),
            Rotation = -45, ZIndex = 61, Parent = grip,
        })
        Theme.bind(line, "BackgroundColor3", i == 1 and "Outline" or "Accent")
    end
    local startSize
    bindDrag(j, grip, function(p)
        if not startMouse then startMouse, startSize = p, win.AbsoluteSize return end
        local d, v = p - startMouse, viewport()
        win.Size = UDim2.fromOffset(clamp(startSize.X + d.X, m.MinSize.X, v.X), clamp(startSize.Y + d.Y, m.MinSize.Y, v.Y))
    end, function() startMouse = nil end, function()
        startMouse = nil
        self._state.Size = { win.AbsoluteSize.X, win.AbsoluteSize.Y }
        self:_SaveState()
    end)

    --  Overlay: popups + tooltip ------------------------------------------------
    local root = create("Frame", { Name = "Root", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = self._overlay })
    self._overlayRoot = root
    local blocker = create("TextButton", { Name = "Blocker", Size = UDim2.fromScale(1, 1), ZIndex = 1, Visible = false, Parent = root })
    self._blocker = blocker
    j:Add(blocker.InputBegan:Connect(function(input)
        local t = input.UserInputType
        if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 or t == Enum.UserInputType.Touch then
            self:ClosePopup()
        end
    end))

    local tipFrame = create("Frame", { Name = "Tooltip", AutomaticSize = Enum.AutomaticSize.XY, Visible = false, ZIndex = 50, Parent = root })
    tipFrame.BackgroundTransparency = 0.05
    Theme.bind(tipFrame, "BackgroundColor3", "Background")
    corner(tipFrame, 4)
    stroke(tipFrame, "Outline")
    local tipLabel = create("TextLabel", {
        AutomaticSize = Enum.AutomaticSize.XY, TextSize = 13, TextWrapped = true, ZIndex = 51, Parent = tipFrame,
    })
    Theme.bind(tipLabel, "TextColor3", "TextColor")
    pad(tipLabel, 5, 8, 5, 8)
    create("UISizeConstraint", { MaxSize = Vector2.new(280, math.huge), Parent = tipLabel })
    self._tooltip = { Frame = tipFrame, Label = tipLabel }

    self:_BuildHud()
    self:_BindInput()

    --  Re-clamp when the viewport changes ----------------------------------------
    local cam = workspace.CurrentCamera
    if cam then
        j:Add(cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            local v, s = viewport(), win.AbsoluteSize
            local ns = Vector2.new(math.min(s.X, v.X), math.min(s.Y, v.Y))
            win.Size = UDim2.fromOffset(ns.X, ns.Y)
            local p = win.AbsolutePosition
            win.Position = UDim2.fromOffset(clamp(p.X, 0, math.max(0, v.X - ns.X)), clamp(p.Y, 0, math.max(0, v.Y - ns.Y)))
        end))
    end

    env.KiciaUI = self
    return self
end

--==========================================================================
--  State persistence
--==========================================================================
function Menu:_LoadState()
    self._state = {}
    if not (FS.read and FS.isfile) then return end
    local path = self.Directory .. "/state.json"
    pcall(function()
        if FS.isfile(path) then
            local data = HttpService:JSONDecode(FS.read(path))
            if type(data) == "table" then self._state = data end
        end
    end)
end

function Menu:_SaveState()
    if not FS.write or self._saveQueued then return end
    self._saveQueued = true
    task.delay(0.4, function()
        self._saveQueued = false
        self._state.Keybind = serializeKey(self.Keybind)
        pcall(function() FS.write(self.Directory .. "/state.json", HttpService:JSONEncode(self._state)) end)
    end)
end

--==========================================================================
--  Rail buttons / tab selection
--==========================================================================
function Menu:_NewRailButton(label, icon)
    local r = self.Metrics.Rail
    local rail = self._rail
    local index = #rail.Buttons + 1
    local btn = create("TextButton", {
        Name = label, Size = UDim2.fromOffset(r.TabSize, r.TabSize), LayoutOrder = index, Parent = rail.Holder,
    })
    local img = create("ImageLabel", {
        Image = icon, ImageColor3 = Theme.Tokens.Unselected,
        AnchorPoint = Vector2.new(0.5, r.ShowLabels and 0 or 0.5),
        Position = r.ShowLabels and UDim2.new(0.5, 0, 0, 10) or UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(r.TabIconSize, r.TabIconSize), Parent = btn,
    })
    local txt = create("TextLabel", {
        Visible = r.ShowLabels, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -6),
        Size = UDim2.new(1, -4, 0, 14), Text = label, TextSize = 10, FontFace = Fonts.Bold,
        TextTruncate = Enum.TextTruncate.AtEnd, TextColor3 = Theme.Tokens.Unselected, Parent = btn,
    })

    local obj = { Button = btn, Index = index, Selected = false, Clicked = self._j:Add(Signal.new()) }
    local function paint(instant)
        local c = obj.Selected and Theme.Tokens.Accent or Theme.Tokens.Unselected
        if instant then
            img.ImageColor3, txt.TextColor3 = c, c
        else
            tween(img, { ImageColor3 = c })
            tween(txt, { TextColor3 = c })
        end
    end
    function obj:SetSelected(s)
        if obj.Selected == s then return end
        obj.Selected = s
        paint(false)
    end
    self._j:Add(btn.MouseButton1Click:Connect(function() obj.Clicked:Fire() end))
    self._j:Add(btn.MouseEnter:Connect(function()
        if not obj.Selected then tween(img, { ImageColor3 = Theme.Tokens.TextColor }) end
    end))
    self._j:Add(btn.MouseLeave:Connect(function()
        if not obj.Selected then tween(img, { ImageColor3 = Theme.Tokens.Unselected }) end
    end))
    self._j:Add(Theme.onChange("Accent", function() if obj.Selected then paint(true) end end))
    self._j:Add(Theme.onChange("Unselected", function() if not obj.Selected then paint(true) end end))
    if not r.ShowLabels then self:AttachTooltip(self._j, btn, label) end
    rail.Buttons[index] = obj
    return obj
end

function Menu:_SelectTab(tab)
    local old = self._activeTab
    if old == tab then return end
    self:ClosePopup()
    if old then
        old._button:SetSelected(false)
        fadePage(old._page, false)
        old.Opened:Fire(false)
    end
    self._activeTab = tab
    tab._button:SetSelected(true)
    fadePage(tab._page, true)

    local r = self.Metrics.Rail
    local ind = self._rail.Indicator
    local y = (tab._button.Index - 1) * (r.TabSize + r.TabGap)
    local target = UDim2.new(0.5, 0, 0, y)
    if not ind.Visible then
        ind.Position = target
        ind.Visible = true
    else
        tween(ind, { Position = target })
    end
    tab.Opened:Fire(true)
end

function Menu:AddTab(opts) return Tab.new(self, opts or {}) end
function Menu:GetTab(label)
    for _, t in ipairs(self._tabs) do if t.Label == label then return t end end
end

