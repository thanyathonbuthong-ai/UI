function Grid.new(menu, parent)
    local m = menu.Metrics
    local n = m.IsCompact and 1 or 2
    local gap = m.Grid.Gap
    local self = setmetatable({ _menu = menu, _n = n, _cols = {}, _weights = {}, _count = 0 }, Grid)
    self.Frame = create("Frame", { Name = "Grid", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = parent })
    for i = 1, n do
        local sf = create("ScrollingFrame", {
            Name = "Column" .. i, Size = UDim2.new(1 / n, -gap * (n - 1) / n, 1, 0),
            Position = UDim2.new((i - 1) / n, (i - 1) * gap / n, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollBarThickness = 2,
            ScrollBarImageTransparency = 0.4, ScrollingDirection = Enum.ScrollingDirection.Y,
            ElasticBehavior = Enum.ElasticBehavior.Never, Parent = self.Frame,
        })
        Theme.bind(sf, "ScrollBarImageColor3", "Accent")
        pad(sf, 1, 6, 1, 1)
        list(sf, Enum.FillDirection.Vertical, m.Section.Gap)
        self._cols[i], self._weights[i] = sf, 0
    end
    return self
end

function Grid:AddSection(opts)
    opts = opts or {}
    local col = opts.Column
    if not col or col > self._n then
        col = 1
        for i = 2, self._n do
            if self._weights[i] < self._weights[col] then col = i end
        end
    end
    self._weights[col] = self._weights[col] + 3
    self._count = self._count + 1
    opts.Order = self._count
    return Section.new(self._menu, self._cols[col], opts, function() self._weights[col] = self._weights[col] + 1 end)
end

--==========================================================================
--  Environment helpers (file system, GUI parent)
--==========================================================================
local function ext(name)
    local ok, v = pcall(function() return getgenv()[name] end)
    if ok and type(v) == "function" then return v end
    ok, v = pcall(function() return getfenv(0)[name] end)
    return (ok and type(v) == "function") and v or nil
end

local FS = {
    read = ext("readfile"), write = ext("writefile"), list = ext("listfiles"), isfile = ext("isfile"),
    isfolder = ext("isfolder"), mkfolder = ext("makefolder"), del = ext("delfile"),
}

local function ensureDir(dir)
    if not (FS.isfolder and FS.mkfolder) then return end
    local acc
    for part in dir:gmatch("[^/]+") do
        acc = acc and (acc .. "/" .. part) or part
        pcall(function() if not FS.isfolder(acc) then FS.mkfolder(acc) end end)
    end
end

local function guiParent()
    local hui = ext("gethui")
    if hui then
        local ok, h = pcall(hui)
        if ok and h then return h end
    end
    local ok, core = pcall(service, "CoreGui")
    if ok and core then return core end
    return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local DEFAULT_TOKENS = table.clone(Theme.Tokens)

--==========================================================================
--  Page fade + Tab / SubTab
--==========================================================================
local fadeToken = setmetatable({}, { __mode = "k" })
local FADE_IN = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local FADE_OUT = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function fadePage(page, show)
    local tok = (fadeToken[page] or 0) + 1
    fadeToken[page] = tok
    if show then
        page.GroupTransparency = 1
        page.Visible = true
        tween(page, { GroupTransparency = 0 }, FADE_IN)
    else
        local tw = tween(page, { GroupTransparency = 1 }, FADE_OUT)
        tw.Completed:Once(function()
            if fadeToken[page] == tok then page.Visible = false end
        end)
    end
end

function Tab.new(menu, opts)
    local m = menu.Metrics
    local self = setmetatable({
        _menu = menu, _j = Janitor.new(), Label = opts.Label or "Tab",
        Description = opts.Description or "", _subtabs = {},
    }, Tab)
    self.Opened = self._j:Add(Signal.new())
    self._button = menu:_NewRailButton(self.Label, opts.Icon or DEFAULT_TAB_ICON)

    local inset = m.Page.OuterInset
    local left = m.Rail.Width + inset
    local page = create("CanvasGroup", {
        Name = self.Label, Position = UDim2.fromOffset(left, inset),
        Size = UDim2.new(1, -left - inset, 1, -inset * 2), Visible = false, Parent = menu._window,
    })
    self._page = page

    local hdr = 0
    if m.Page.HasTitleBlock then
        hdr = 50
        local title = create("TextLabel", {
            Name = "Title", Size = UDim2.new(1, 0, 0, 26), Text = self.Label, FontFace = Fonts.SemiBold,
            TextSize = m.Page.TitleTextSize, TextXAlignment = Enum.TextXAlignment.Left, Parent = page,
        })
        Theme.bind(title, "TextColor3", "TextColor")
        local desc = create("TextLabel", {
            Name = "Description", Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 18),
            Text = self.Description, TextSize = m.Page.DescriptionTextSize, TextXAlignment = Enum.TextXAlignment.Left,
            Parent = page,
        })
        Theme.bind(desc, "TextColor3", "Unselected")
    end
    self._hdr = hdr
    self._content = create("Frame", {
        Name = "Content", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, hdr),
        Size = UDim2.new(1, 0, 1, -hdr), Parent = page,
    })

    self._j:Connect(self._button.Clicked, function() menu:_SelectTab(self) end)
    table.insert(menu._tabs, self)
    if not menu._activeTab then menu:_SelectTab(self) end
    return self
end

function Tab:_Layout()
    local top = self._hdr + (self._bar and 42 or 0)
    self._content.Position = UDim2.fromOffset(0, top)
    self._content.Size = UDim2.new(1, 0, 1, -top)
end

function Tab:Open() self._menu:_SelectTab(self) end

function Tab:AddSection(opts)
    assert(#self._subtabs == 0, "Tab:AddSection cannot be used on a tab that has sub-tabs; use SubTab:AddSection")
    if not self._grid then self._grid = Grid.new(self._menu, self._content) end
    return self._grid:AddSection(opts)
end

function Tab:AddSubTab(opts)
    assert(self._grid == nil, "Tab:AddSubTab cannot be used on a tab that already has sections")
    local m = self._menu.Metrics
    if not self._bar then
        local bar = create("ScrollingFrame", {
            Name = "SubTabs", Position = UDim2.fromOffset(0, self._hdr), Size = UDim2.new(1, 0, 0, 34),
            AutomaticCanvasSize = Enum.AutomaticSize.X, CanvasSize = UDim2.new(), ScrollBarThickness = 0,
            ScrollingDirection = Enum.ScrollingDirection.X, Parent = self._page,
        })
        list(bar, Enum.FillDirection.Horizontal, m.Page.TabGap > 8 and 8 or m.Page.TabGap, nil, Enum.VerticalAlignment.Center)
        self._bar = bar
        self:_Layout()
    end
    local st = SubTab.new(self, opts or {})
    table.insert(self._subtabs, st)
    if #self._subtabs == 1 then self:_SelectSub(st) end
    return st
end

function Tab:_SelectSub(sel)
    for _, st in ipairs(self._subtabs) do
        local on = st == sel
        st._grid.Frame.Visible = on
        tween(st._button, { BackgroundTransparency = on and 0.35 or 1 })
        tween(st._button, { TextColor3 = on and Theme.Tokens.Accent or Theme.Tokens.Unselected })
        st._selected = on
    end
    self._activeSub = sel
    self._menu:ClosePopup()
end

function SubTab.new(tab, opts)
    local menu = tab._menu
    local m = menu.Metrics
    local self = setmetatable({ _tab = tab, Label = opts.Label or "Sub", _selected = false }, SubTab)
    local btn = create("TextButton", {
        Name = self.Label, Size = UDim2.fromOffset(0, 30), AutomaticSize = Enum.AutomaticSize.X, Text = self.Label,
        FontFace = Fonts.SemiBold, TextSize = m.Page.TabTextSize - 2, TextColor3 = Theme.Tokens.Unselected,
        Parent = tab._bar,
    })
    btn.BackgroundTransparency = 1
    Theme.bind(btn, "BackgroundColor3", "TabButtonSelected")
    corner(btn, 6)
    pad(btn, 0, m.Page.TabPaddingX, 0, m.Page.TabPaddingX)
    self._button = btn
    self._grid = Grid.new(menu, tab._content)
    self._grid.Frame.Visible = false
    tab._j:Add(btn.MouseButton1Click:Connect(function() tab:_SelectSub(self) end))
    tab._j:Add(Theme.onChange("Accent", function(c) if self._selected then btn.TextColor3 = c end end))
    tab._j:Add(Theme.onChange("Unselected", function(c) if not self._selected then btn.TextColor3 = c end end))
    return self
end

function SubTab:AddSection(opts) return self._grid:AddSection(opts) end
function SubTab:Open() self._tab:Open() self._tab:_SelectSub(self) end

