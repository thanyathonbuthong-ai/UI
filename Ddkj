function library:viewport(props)
	local cfg = {
		title      = props.title or props.name or "Viewport",
		desc       = props.desc or props.description,
		height     = props.height or 180,
		spin       = props.spin ~= false,
		spin_speed = props.spin_speed or 60,
		model      = props.model,
	}
	local card = self:element_card({ name = cfg.title, desc = cfg.desc })
	local vp_box = library:create("Frame", {
		Name = "viewport_box", Parent = card.holder,
		Size = UDim2.new(1, 0, 0, cfg.height),
		BackgroundColor3 = library.themes.preset.outline,
		BackgroundTransparency = 0.9, BorderSizePixel = 0,
		LayoutOrder = 3, ClipsDescendants = true,
	})
	library:create("UICorner", { Parent = vp_box, CornerRadius = UDim.new(0, 10) })
	library:create("UIStroke", { Parent = vp_box, Color = library.themes.preset.outline, Thickness = 1, Transparency = 0.92 })
	local viewport = library:create("ViewportFrame", {
		Name = "viewport", Parent = vp_box, Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1, BorderSizePixel = 0,
		Ambient = Color3.fromRGB(160, 160, 160),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(0.6, -1, 0.4), ZIndex = 2,
	})
	local world  = library:create("WorldModel", { Parent = viewport })
	local camera = library:create("Camera", {})
	viewport.CurrentCamera = camera
	local current_model = nil
	local spin_angle    = 0
	function cfg:set_model(new_model)
		for _, child in ipairs(world:GetChildren()) do child:Destroy() end
		current_model = nil
		if not new_model then return end
		local clone = new_model:Clone()
		local model
		if clone:IsA("Model") then model = clone
		else
			model = Instance.new("Model")
			clone.Parent = model
		end
		model.Parent = world
		local cf, size = model:GetBoundingBox()
		model:PivotTo(cf - cf.Position)
		local max_dim = math.max(size.X, size.Y, size.Z)
		local dist    = max_dim * 1.8 + 1
		camera.CFrame = CFrame.new(Vector3.new(0, size.Y * 0.15, dist), Vector3.new(0, 0, 0))
		current_model = model
	end
	if cfg.spin then
		library:connection(game:GetService("RunService").RenderStepped, function(dt)
			if current_model and current_model.Parent then
				spin_angle = spin_angle + math.rad(dt * cfg.spin_speed)
				current_model:PivotTo(CFrame.Angles(0, spin_angle, 0))
			end
		end)
	end
	function cfg:set_spin(enabled)      cfg.spin = enabled      end
	function cfg:set_speed(deg_per_sec) cfg.spin_speed = deg_per_sec end
	if cfg.model then cfg:set_model(cfg.model) end
	if self.elements then table.insert(self.elements, cfg) end
	return cfg
end

