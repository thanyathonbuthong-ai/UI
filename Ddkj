-- helper: ตั้งค่า toggle จากโค้ด (ลองหลาย API ใน pcall, ไม่ fire callback)
function UI.set_toggle(obj, flagName, value)
	local key = flagName or tostring(obj)
	if UI._lastToggle[key] == value then
		return
	end
	UI._lastToggle[key] = value
	if obj then
		pcall(function() if type(obj.Set) == "function" then obj:Set(value) end end)
		pcall(function() if type(obj.set) == "function" then obj:set(value) end end)
		pcall(function() if type(obj.SetValue) == "function" then obj:SetValue(value) end end)
	end
	pcall(function()
		local flags = library.flags or library.Flags
		if flags and flagName and flags[flagName] and type(flags[flagName].Set) == "function" then
			flags[flagName].Set(value)
		end
	end)
end

